@model IEnumerable<MVCCaseManagement.Models.Notification>
@{
    ViewData["Title"] = "Notification Center";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 fw-bold" style="color: #2E3B55;">
            <i class="bi bi-bell-fill me-2 text-primary"></i>Notification Center
        </h3>
        @if(Model.Any(m => !m.IsRead))
        {
            <form asp-action="MarkAllAsRead" asp-controller="Notification" method="post">
                <button type="submit" class="btn btn-outline-primary shadow-sm rounded-pill px-4">
                    <i class="bi bi-check2-all me-1"></i> Mark All as Read
                </button>
            </form>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center p-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <h5>No notifications found</h5>
                    <p>You're all caught up!</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush rounded-4">
                    @foreach (var note in Model)
                    {
                        <div class="list-group-item p-4 @(note.IsRead ? "bg-white" : "bg-light border-start border-4 border-primary")">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1 fw-bold @(note.IsRead ? "text-secondary" : "text-dark")">
                                        @if(note.RelatedCaseType == "MVC")
                                        {
                                            <i class="bi bi-car-front-fill me-2 text-danger"></i>
                                        }
                                        else if(note.RelatedCaseType == "Gratuity")
                                        {
                                            <i class="bi bi-cash-coin me-2 text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-briefcase-fill me-2 text-primary"></i>
                                        }
                                        @note.Title
                                    </h6>
                                    <p class="mb-1 @(note.IsRead ? "text-muted" : "text-dark")">@note.Message</p>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i> @note.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")</small>
                                </div>
                                <div class="text-end">
                                    @if(!string.IsNullOrEmpty(note.LinkUrl))
                                    {
                                        <a href="@note.LinkUrl" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">View Case</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
