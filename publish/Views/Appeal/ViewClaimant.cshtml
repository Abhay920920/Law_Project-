@model MVCCaseManagement.Models.AppealViewModel

@{
    ViewData["Title"] = "Claimant Appeal Details";
    ViewData["HidePageHeader"] = true;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0"><i class="bi bi-file-earmark-text me-2"></i>Claimant Appeal Details</h2>
            <p class="text-muted">Case: @Model.MVCNo / @Model.MVCYear | Division: @Model.DivisionName (MACT: @Model.MACTName)</p>
        </div>
        <div>
            <a asp-action="ManageClaimant" asp-route-id="@Model.CaseID" class="btn btn-primary shadow-sm me-2">
                <i class="bi bi-pencil-square me-1"></i> Edit Appeal
            </a>
            <a asp-action="ClaimantList" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Registry
            </a>
        </div>
    </div>

    <!-- MVC Case Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold text-dark text-uppercase" style="letter-spacing: 0.5px;">
                <i class="bi bi-card-list me-2 text-primary"></i>Associated MVC Case
            </h6>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold">MVC Number</label>
                    <div class="data-id-display">@Model.ClaimantMVCNumber / @Model.ClaimantMVCYear</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold">Division</label>
                    <div class="info-text">@Model.DivisionName</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold">MACT / Tribunal</label>
                    <div class="info-text">@Model.MACTName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ClaimantMVCCurrentStatus))
                {
                    <div class="col-md-4">
                        <label class="form-label small text-muted fw-bold">MVC Current Status</label>
                        <div><span class="badge badge-status badge-pending">@Model.ClaimantMVCCurrentStatus</span></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- High Court MFA Details -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold text-dark text-uppercase" style="letter-spacing: 0.5px;">
                <i class="bi bi-bank me-2 text-primary"></i>High Court Appeal (MFA)
            </h6>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">MFA Number</label>
                    <div class="data-id-display">@Model.ClaimantMFANumber</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">MFA Year</label>
                    <div class="info-text">@Model.ClaimantMFAYear</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">High Court Bench</label>
                    <div class="info-text">@(Model.HighCourtBench ?? "N/A")</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Status</label>
                    <div>
                        <span class="badge badge-status @(Model.ClaimantMFAStatus == "Pending" ? "badge-pending" : "badge-favor")">
                            @Model.ClaimantMFAStatus
                        </span>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold">Entrustment Number</label>
                    <div class="info-text">@(Model.ClaimantMFAEntrustmentNo ?? "N/A")</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold">Entrustment Date</label>
                    <div class="info-text">@(Model.ClaimantMFAEntrustmentDate?.ToString("dd-MMM-yyyy") ?? "N/A")</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold">Advocate Name</label>
                    <div class="info-text">@(Model.ClaimantMFAAdvocate ?? "N/A")</div>
                </div>
            </div>

            @if (Model.ClaimantMFAStatus == "Disposed")
            {
                <hr class="my-4" />
                <div class="bg-light p-3 rounded">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clipboard-check me-2"></i>Outcome & Decision</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted fw-bold">Nature of Decision</label>
                            <div class="info-text">@(Model.ClaimantMFADecision ?? "N/A")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted fw-bold">Action Taken</label>
                            <div class="info-text">@(Model.ClaimantActionTaken ?? "N/A")</div>
                        </div>
                        @if (Model.ClaimantActionTaken == "Close")
                        {
                            <div class="col-md-6">
                                <label class="form-label small text-muted fw-bold">Approval Outward Number</label>
                                <div class="info-text">@(Model.ClaimantApprovalNo ?? "N/A")</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted fw-bold">Approval Date</label>
                                <div class="info-text">@(Model.ClaimantApprovalDate?.ToString("dd-MMM-yyyy") ?? "N/A")</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Supreme Court Appeal (If Any) -->
    @if (Model.IsClaimantSCAppeal)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark text-uppercase" style="letter-spacing: 0.5px;">
                    <i class="bi bi-bank2 me-2 text-primary"></i>Supreme Court Appeal
                </h6>
            </div>
            <div class="card-body p-4">
                @if (Model.IsClaimantSCPending)
                {
                    <div class="alert alert-warning border-0 shadow-sm">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Pending for Filing</strong> - No SC Appeal Number yet
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small text-muted fw-bold">Diary Number</label>
                            <div class="info-text">@(Model.ClaimantSCDiaryNumber ?? "N/A")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted fw-bold">Diary Year</label>
                            <div class="info-text">@(Model.ClaimantSCYear?.ToString() ?? "N/A")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted fw-bold">SLP[C] Number</label>
                            <div class="data-id-display">@(Model.ClaimantSCNumber ?? "N/A")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted fw-bold">SLP[C] Year</label>
                            <div class="info-text">@(Model.ClaimantSLPYear?.ToString() ?? "N/A")</div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">Filed By</label>
                            <div class="info-text">@(Model.ClaimantSCFiledBy ?? "N/A")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">Entrustment Number</label>
                            <div class="info-text">@(Model.ClaimantSCEntrustmentNo ?? "N/A")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">Entrustment Date</label>
                            <div class="info-text">@(Model.ClaimantSCEntrustmentDate?.ToString("dd-MMM-yyyy") ?? "N/A")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">Advocate Name</label>
                            <div class="info-text">@(Model.ClaimantSCAdvocate ?? "N/A")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">Status</label>
                            <div>
                                <span class="badge badge-status @(Model.ClaimantSCStatus == "Pending" ? "badge-pending" : "badge-favor")">
                                    @Model.ClaimantSCStatus
                                </span>
                            </div>
                        </div>
                    </div>

                    @if (Model.ClaimantSCStatus == "Disposed")
                    {
                        <hr class="my-4" />
                        <div class="bg-light p-3 rounded">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clipboard-check me-2"></i>Supreme Court Outcome</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small text-muted fw-bold">Outcome</label>
                                    <div class="info-text">@(Model.ClaimantSCOutcome ?? "N/A")</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted fw-bold">Action Taken</label>
                                    <div class="info-text">@(Model.ClaimantSCActionTaken ?? "N/A")</div>
                                </div>
                                @if (Model.ClaimantSCActionTaken == "Close")
                                {
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted fw-bold">Closure Order No</label>
                                        <div class="info-text">@(Model.ClaimantSCClosureNo ?? "N/A")</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted fw-bold">Closure Date</label>
                                        <div class="info-text">@(Model.ClaimantSCClosureDate?.ToString("dd-MMM-yyyy") ?? "N/A")</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        :root {
            --gov-blue-dark: #0f172a;
            --gov-blue: #2563eb;
            --gov-bg-light: #f8fafc;
            --text-primary: #1e293b;
            --text-secondary: #475569;
            --border-color: #e2e8f0;
        }

        .container {
            background-color: #f8fafc;
            min-height: 100vh;
        }

        .card {
            border: 1px solid var(--border-color);
            border-radius: 6px;
        }

        .data-id-display {
            font-family: 'Roboto Mono', 'SF Mono', Consolas, monospace;
            font-weight: 600;
            color: var(--text-primary);
            font-size: 1rem;
            padding: 0.5rem 0.75rem;
            background-color: #f0f9ff;
            border-left: 3px solid var(--gov-blue);
            border-radius: 4px;
        }

        .info-text {
            font-size: 0.95rem;
            color: var(--text-secondary);
            padding: 0.5rem 0.75rem;
            background-color: #f9fafb;
            border-radius: 4px;
            min-height: 2.5rem;
            display: flex;
            align-items: center;
        }

        .form-label {
            margin-bottom: 0.5rem;
        }

        /* Status Badges */
        .badge-status {
            display: inline-flex;
            align-items: center;
            padding: 0.35rem 0.75rem;
            font-size: 0.75rem;
            font-weight: 700;
            line-height: 1;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .badge-favor { 
            background-color: #d1fae5; 
            color: #065f46; 
            border: 1px solid #a7f3d0; 
        }

        .badge-pending { 
            background-color: #fef3c7; 
            color: #92400e; 
            border: 1px solid #fde68a; 
        }
    </style>
}
