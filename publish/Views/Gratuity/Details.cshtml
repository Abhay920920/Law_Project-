@model MVCCaseManagement.Models.GratuityCase

@{
    ViewData["Title"] = "Gratuity Case Details - " + Model.PGANumber;
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userDiv = User.FindFirst("DivisionID")?.Value;
    bool isCO = string.IsNullOrEmpty(userDiv) || userDiv == "0" || userDiv == "5";
}

<div class="d-print-none">
<div class="container-fluid fade-in py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Gratuity")">Gratuity Module</a></li>
                    <li class="breadcrumb-item active">Case Details</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-cash-coin text-gratuity me-2"></i>@Model.PGANumber
            </h1>
            <small class="text-muted">Division: <strong>@ViewBag.DivisionName</strong> | Court: <strong>@Model.CourtType</strong></small>
        </div>
        <div class="d-flex gap-2">
            @if (ViewBag.IsCentralOffice == true || User.IsInRole("MD"))
            {
                var statusClean = (Model.ActionTaken ?? "").Trim().ToUpper();
                bool isPendingMD = statusClean == "PENDING BEFORE COMPETENT AUTHORITY" || statusClean == "PENDING AT CA";
                bool isApprovedOrRejected = statusClean == "APPROVED" || statusClean == "REJECTED" || statusClean == "CLOSED" || statusClean == "CLOSE";

                if (User.IsInRole("CLO"))
                {
                    if (!isPendingMD && !isApprovedOrRejected)
                    {
                        <a href="@Url.Action("CLOAction", "Gratuity", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill px-4">
                            <i class="bi bi-lightning-charge me-2"></i> ACTION
                        </a>
                    }
                    else if (isPendingMD)
                    {
                        <span class="badge bg-info text-dark p-2 px-3 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Pending at MD level</span>
                    }
                }
                else if (User.IsInRole("MD"))
                {
                    if (!isApprovedOrRejected)
                    {
                        <a href="@Url.Action("Action", "Gratuity", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill px-4 border border-white border-2">
                            <i class="bi bi-lightning-charge me-2"></i> TAKE MD ACTION
                        </a>
                    }
                }
                else
                {
                    @* Other CO roles can see the main action button if not already pending/finished *@
                    if (!isPendingMD && !isApprovedOrRejected)
                    {
                        <a href="@Url.Action("Action", "Gratuity", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill px-4">
                            <i class="bi bi-lightning-charge me-2"></i> ACTION
                        </a>
                    }
                }
            }
            @if (!isCO && Model.ForwardingStatus != "Sent to Central Office")
            {
                <a href="@Url.Action("Edit", "Gratuity", new { id = Model.CaseID })" class="btn btn-primary shadow-sm rounded-pill px-4">
                    <i class="bi bi-pencil-square me-2"></i> EDIT
                </a>
            }
            <button type="button" class="btn btn-outline-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#gratuityFullDetailsModal">
                <i class="bi bi-info-circle me-2"></i> View Full Details
            </button>
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
                <i class="bi bi-printer me-2"></i> Print
            </button>
        </div>
    </div>

    <!-- SUMMARY SECTION -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">Employee / Petitioner</small>
                    <div class="fw-bold text-truncate" title="@Model.ClaimantName">@Model.ClaimantName</div>
                    <div class="small">@Model.ClaimantDesignation</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 @(Model.DisposalResult == "Against" ? "bg-danger text-white" : (Model.CaseStatus == "Disposed" ? "bg-success text-white" : "bg-warning text-dark"))">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">Disposal Status</small>
                    <div class="fw-bold">@(!string.IsNullOrEmpty(Model.DisposalResult) ? Model.DisposalResult : "Pending")</div>
                    @if (Model.DisposalDate.HasValue) { <div class="small">Date: @Model.DisposalDate.Value.ToShortDateString()</div> }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">CO Tracking</small>
                    <div class="fw-bold">@(!string.IsNullOrEmpty(Model.ForwardingStatus) ? Model.ForwardingStatus : "Internal")</div>
                    <div class="small">Action: @(Model.ActionTaken ?? "None")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">CLAIM DETAILS</small>
                    <div class="fw-bold">@Model.AmountClaimed</div>
                    <div class="small">Ordered: ₹ @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Award Summary Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-gratuity"><i class="bi bi-calculator me-2"></i>Financial Assessment Summary</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <!-- Corporation Calculations -->
                        <div class="col-md-6 border-end">
                            <h6 class="text-uppercase small fw-bold text-primary mb-3"><i class="bi bi-building me-1"></i> Corporation Calculation</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">As per Act</small>
                                    <h5 class="fw-bold mb-0">₹ @(Model.GratuityAmount_Corp_Act?.ToString("N2") ?? "0.00")</h5>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">As per Regulation</small>
                                    <h5 class="fw-bold mb-0">₹ @(Model.GratuityAmount_Corp_Reg?.ToString("N2") ?? "0.00")</h5>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Controlling Authority Calculations -->
                        <div class="col-md-6">
                            <h6 class="text-uppercase small fw-bold text-danger mb-3"><i class="bi bi-bank me-1"></i> Controlling Authority</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">As per Act</small>
                                    <h5 class="fw-bold mb-0 text-danger">₹ @(Model.GratuityAmount_CA_Act?.ToString("N2") ?? "0.00")</h5>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">As per Regulation</small>
                                    <h5 class="fw-bold mb-0 text-danger">₹ @(Model.GratuityAmount_CA_Reg?.ToString("N2") ?? "0.00")</h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-white rounded border-start border-4 border-gratuity shadow-sm">
                        <div class="row align-items-center g-3">
                            <div class="col-md-auto border-end pe-4">
                                <small class="text-muted d-block text-uppercase fw-bold xs mb-1">Final Ordered Amount</small>
                                <h3 class="fw-bold text-gratuity mb-0">₹ @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")</h3>
                            </div>
                            <div class="col-md">
                                @if(!string.IsNullOrEmpty(Model.Remarks)) {
                                    <div class="p-2 px-3 bg-light rounded-3 border-start border-3 border-warning small">
                                        <div class="fw-bold text-dark mb-1 small text-uppercase ls-1"><i class="bi bi-info-circle-fill text-warning me-1"></i> Order Remarks & Interest:</div>
                                        <div class="text-muted italic" style="line-height: 1.4; font-size: 0.85rem;">
                                            @Model.Remarks
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Connected / Related Matters -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-intersect me-2"></i>Appeal Matter Information</h6>
                </div>
                <div class="card-body small">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="p-2 bg-light rounded mb-2">
                                <small class="text-muted d-block">Appeal Court / Number</small>
                                <strong>@Model.AppealCourt - @Model.AppealNumber / @Model.AppealYear</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2 bg-light rounded mb-2">
                                <small class="text-muted d-block">Compliance Status</small>
                                <span class="badge @(Model.ComplianceStatus == "Closed" ? "bg-success" : "bg-warning text-dark")">@Model.ComplianceStatus</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- CO Tracking Sidebar -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                     <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-building-check me-2"></i>CO Decision Tracking</h6>
                </div>
                <div class="card-body small">
                    <div class="mb-3 p-2 bg-light rounded">
                        <small class="text-muted d-block">Judgement Review:</small>
                        <div class="fw-bold">@Model.ActionTaken (@(Model.FeasibilityReceiptDate?.ToShortDateString() ?? "-"))</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Forwarding Status:</small>
                        <span class="badge bg-primary">@Model.ForwardingStatus</span>
                    </div>
                    @if(Model.ActionTaken == "Appeal") {
                        <div class="mt-3 p-2 border-top">
                            <small class="text-muted d-block">WP Details (Corp):</small>
                            <div class="fw-bold">@Model.CorpWPNumber / @Model.CorpWPYear</div>
                            <small class="text-primary">@Model.HighCourtBench</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FULL DETAILS MODAL FOR GRATUITY -->
<div class="modal fade" id="gratuityFullDetailsModal" tabindex="-1" aria-labelledby="gratuityFullDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="gratuityFullDetailsModalLabel">
                    <i class="bi bi-info-circle-fill me-2"></i>Comprehensive Gratuity Case Record: @Model.PGANumber
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="row g-4">
                    <!-- Column 1: Employee & Service -->
                    <div class="col-lg-6">
                         <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white py-2 fw-bold">Employee Service Profile</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-6 text-muted">Claimant Name:</div><div class="col-6 fw-bold">@Model.ClaimantName</div>
                                    <div class="col-6 text-muted">Designation:</div><div class="col-6 fw-bold">@Model.ClaimantDesignation</div>
                                    <div class="col-6 text-muted">Working Status:</div><div class="col-6 fw-bold">@Model.WorkingStatus</div>
                                    <div class="col-6 text-muted">DOB:</div><div class="col-6 fw-bold">@Model.DateOfBirth?.ToShortDateString()</div>
                                    <div class="col-6 text-muted">Retirement (Corp):</div><div class="col-6 fw-bold">@Model.RetirementDate?.ToShortDateString()</div>
                                    <div class="col-6 text-muted">Retirement (ALC):</div><div class="col-6 fw-bold">@Model.RetirementDate_CA?.ToShortDateString()</div>
                                    <div class="col-6 text-muted">Total Service:</div><div class="col-6 fw-bold text-primary">@Model.TotalServicePeriod</div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white py-2 fw-bold">Financial Assessment (Comparison)</div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-bordered mb-0 small">
                                    <thead class="table-light text-center">
                                        <tr><th>Factor</th><th>Corporation</th><th>Controlling Auth</th></tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>Qualifying Service</td><td>@Model.QualifyingService_Corp</td><td>@Model.QualifyingService_CA</td></tr>
                                        <tr><td>Basic/DA</td><td>₹ @Model.LastDrawnBasic / @Model.LastDrawnDA</td><td>₹ @Model.LastDrawnBasic_CA / @Model.LastDrawnDA_CA</td></tr>
                                        <tr class="table-info fw-bold"><td>Final Gratuity</td><td>₹ @Model.GratuityAmount_Corp_Act</td><td>₹ @Model.OrderedAmount_CA</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card shadow-sm border-0 mb-4 border-start border-4 border-info">
                            <div class="card-header bg-white py-2 fw-bold d-flex justify-content-between">
                                <span>Evidence Details</span>
                                <i class="bi bi-person-badge text-info"></i>
                            </div>
                            <div class="card-body small">
                                <div class="mb-2">
                                    <div class="text-muted mb-1 small uppercase ls-1">Witness / Official Details:</div>
                                    <div class="fw-bold">@(string.IsNullOrEmpty(Model.EvidenceWitnessName) ? "Not Recorded" : Model.EvidenceWitnessName + " (" + Model.EvidenceWitnessDesignation + ")")</div>
                                </div>
                                <hr class="my-2 opacity-25" />
                                <div class="text-muted mb-1 small uppercase ls-1">Evidence Remarks:</div>
                                <div class="bg-white border p-2 rounded">
                                    @(Model.EvidenceRemarks ?? "No evidence details recorded.")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Legal & CO Tracking -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 mb-4 bg-warning-subtle border-start border-4 border-warning">
                            <div class="card-header bg-white py-2 fw-bold">Legal & Entrustment Details</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-6 text-muted">Entrustment No:</div><div class="col-6 fw-bold">@Model.EntrustmentNo</div>
                                    <div class="col-6 text-muted">Entrustment Date:</div><div class="col-6 fw-bold">@Model.EntrustmentDate?.ToShortDateString()</div>
                                    <div class="col-6 text-muted">Advocate:</div><div class="col-6 fw-bold">@Model.AdvocateName</div>
                                    <div class="col-6 text-muted">Current Stage:</div><div class="col-6 fw-bold text-primary">@Model.CurrentStage</div>
                                    <div class="col-6 text-muted">Disposal Date:</div><div class="col-6 fw-bold">@Model.DisposalDate?.ToShortDateString()</div>
                                    <div class="col-6 text-muted">Result:</div><div class="col-6 fw-bold">@Model.DisposalResult</div>
                                </div>
                            </div>
                        </div>

                         <div class="card shadow-sm border-0 mb-4 bg-info-subtle border-start border-4 border-info">
                            <div class="card-header bg-white py-2 fw-bold">Opinions & Recommendations</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-6 text-muted">Opinion of Advocate:</div><div class="col-6 fw-bold">@Model.AdvocateOpinion</div>
                                    <div class="col-6 text-muted">Opinion of ALO/LO:</div><div class="col-6 fw-bold">@Model.LOOpinion</div>

                                    <div class="col-6 text-muted">Opinion of DC:</div><div class="col-6 fw-bold">@Model.DCOpinion</div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.AppealNumber))
                        {
                            <div class="card shadow-sm border-0 mb-4 border-start border-4 border-success">
                                <div class="card-header bg-white py-2 fw-bold text-success">Appellate Authority (AA) Details</div>
                                <div class="card-body small">
                                    <div class="row g-2">
                                        <div class="col-6 text-muted">Appeal No / Year:</div><div class="col-6 fw-bold">@Model.AppealNumber / @Model.AppealYear</div>
                                        <div class="col-6 text-muted">Arising from:</div><div class="col-6 fw-bold">@Model.AppealArisingNo / @Model.AppealArisingYear</div>
                                        <div class="col-6 text-muted">Court:</div><div class="col-6 fw-bold">@Model.AppealCourt</div>
                                        <div class="col-6 text-muted">Advocate:</div><div class="col-6 fw-bold">@Model.AppealAdvocate</div>
                                        <div class="col-6 text-muted">AA Disposal Date:</div><div class="col-6 fw-bold text-success">@Model.AppealDisposalDate?.ToShortDateString()</div>
                                        
                                        <div class="col-12 mt-1"><hr class="my-1 opacity-25"></div>
                                        
                                        <div class="col-6 text-muted small">Copy Applied:</div><div class="col-6 small">@Model.AppealCopyAppliedDate?.ToShortDateString()</div>
                                        <div class="col-6 text-muted small">Copy Ready:</div><div class="col-6 small">@Model.AppealCopyReadyDate?.ToShortDateString()</div>
                                        <div class="col-6 text-muted small">Copy Delivered:</div><div class="col-6 small">@Model.AppealCopyDeliveredDate?.ToShortDateString()</div>
                                        <div class="col-6 text-muted small">Copy Received:</div><div class="col-6 small">@Model.AppealCopyReceivedDate?.ToShortDateString()</div>
                                        
                                        @if(!string.IsNullOrEmpty(Model.AppealDelayRemarks)) {
                                            <div class="col-12 mt-1 text-muted small font-italic">Delay: @Model.AppealDelayRemarks</div>
                                        }

                                        <div class="col-12 mt-1"><hr class="my-1 opacity-25"></div>
                                        
                                        <div class="col-6 text-muted small">Advocate Opinion:</div><div class="col-6 fw-bold small">@Model.AppealAdvocateOpinion</div>
                                        <div class="col-6 text-muted small">ALO/LO Opinion:</div><div class="col-6 fw-bold small">@Model.AppealLOOpinion</div>
                                        <div class="col-6 text-muted small">DC Opinion:</div><div class="col-6 fw-bold small">@Model.AppealDCOpinion</div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white py-2 fw-bold">High Court WP (Corporation)</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-6 text-muted">WP Number:</div><div class="col-6 fw-bold">@Model.CorpWPNumber / @Model.CorpWPYear</div>
                                    <div class="col-6 text-muted">Bench:</div><div class="col-6 fw-bold">@Model.HighCourtBench</div>
                                    <div class="col-6 text-muted">Advocate:</div><div class="col-6 fw-bold">@Model.CorpWPAdvocate</div>
                                    <div class="col-6 text-muted">WP Status:</div><div class="col-6 fw-bold text-danger">@Model.CorpWPStatus</div>
                                    <div class="col-6 text-muted">Stay Granted:</div><div class="col-6 fw-bold">@(Model.StayGranted ? "Yes" : "No")</div>
                                    <div class="col-6 text-muted">Outcome:</div><div class="col-6 fw-bold">@Model.CorpWPOutcome</div>
                                </div>
                            </div>
                        </div>

                        @if (Model.IsClaimantSCAppeal)
                        {
                            <div class="card shadow-sm border-0 mb-4 border-start border-4 border-info">
                                <div class="card-header bg-white py-2 fw-bold text-info">Supreme Court Appeal (Claimant)</div>
                                <div class="card-body small">
                                    <div class="row g-2">
                                        <div class="col-6 text-muted">Diary No / Year:</div><div class="col-6 fw-bold">@Model.ClaimantSCDiaryNumber / @Model.ClaimantSCYear</div>
                                        <div class="col-6 text-muted">SC Case No:</div><div class="col-6 fw-bold">@Model.ClaimantSCNumber / @Model.ClaimantSLPYear</div>
                                        <div class="col-6 text-muted">Advocate:</div><div class="col-6 fw-bold">@Model.ClaimantSCAdvocate</div>
                                        <div class="col-6 text-muted">Current Status:</div><div class="col-6 fw-bold">@Model.ClaimantSCStatus</div>
                                        <div class="col-6 text-muted">Decision:</div><div class="col-6 fw-bold">@Model.ClaimantSCOutcome</div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.ClaimantWPNumber))
                        {
                            <div class="card shadow-sm border-0 mb-4 border-start border-4 border-primary">
                                <div class="card-header bg-white py-2 fw-bold text-primary">High Court WP (Claimant)</div>
                                <div class="card-body small">
                                    <div class="row g-2">
                                        <div class="col-6 text-muted">WP Number:</div><div class="col-6 fw-bold">@Model.ClaimantWPNumber / @Model.ClaimantWPYear</div>
                                        <div class="col-6 text-muted">Bench:</div><div class="col-6 fw-bold">@Model.ClaimantHighCourtBench</div>
                                        <div class="col-6 text-muted">Advocate:</div><div class="col-6 fw-bold">@Model.ClaimantWPAdvocate</div>
                                        <div class="col-6 text-muted">Decision:</div><div class="col-6 fw-bold">@Model.ClaimantWPDecision</div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white py-2 fw-bold">Action Documents</div>
                            <div class="list-group list-group-flush small">
                                @if (!string.IsNullOrEmpty(Model.AppealJudgmentPath)) {
                                    <a href="@Model.AppealJudgmentPath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Appeal Judgment Copy</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.AdverseJudgmentPath)) {
                                    <a href="@Model.AdverseJudgmentPath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-file-earmark-pdf text-primary me-2"></i>Judgment Copy</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.InitialActionPath1)) {
                                    var docTitle1 = "Noting Sheet 1";
                                    if (Model.ActionTaken == "Close" || Model.ActionTaken == "Closed") docTitle1 = "Approval Copy";
                                    else if (Model.ActionTaken == "Appeal") docTitle1 = "Appeal Copy";

                                    <a href="@Model.InitialActionPath1" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-file-earmark-check text-success me-2"></i>@docTitle1</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.InitialActionPath2)) {
                                    <a href="@Model.InitialActionPath2" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-file-earmark-check text-success me-2"></i>Noting Sheet 2</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.StayOrderPath1)) {
                                    <a href="@Model.StayOrderPath1" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-file-earmark-lock text-warning me-2"></i>Stay Order Document 1</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.StayOrderPath2)) {
                                    <a href="@Model.StayOrderPath2" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-file-earmark-lock text-warning me-2"></i>Stay Order Document 2</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4 mt-2 mb-3">
                    <div class="col-12">
                        <div class="card shadow-sm border-0 border-start border-4 border-gratuity">
                            <div class="card-header bg-white py-2 fw-bold small">CLAIM DETAILS</div>
                            <div class="card-body p-2 small">
                                @(string.IsNullOrEmpty(Model.AmountClaimed) ? "No claim details provided" : Model.AmountClaimed)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4 mt-1">
                    <div class="col-md-12">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white py-2 fw-bold d-flex justify-content-between">
                                <span>Actual Payments (Corporation)</span>
                                <span class="badge bg-success">₹ @(Model.Payments?.Sum(p => p.Amount ?? 0).ToString("N2") ?? "0.00")</span>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-striped mb-0 small text-center">
                                    <thead class="table-light">
                                        <tr><th>Amount</th><th>Cheque No</th><th>Date</th></tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Payments != null && Model.Payments.Any()) {
                                            foreach (var p in Model.Payments) {
                                                <tr><td>₹ @(p.Amount?.ToString("N2") ?? "0.00")</td><td>@p.ChequeNumber</td><td>@p.ChequeDate?.ToShortDateString()</td></tr>
                                            }
                                        } else {
                                            <tr><td colspan="3" class="text-muted italic py-3">No payments recorded</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-2">
                <button type="button" class="btn btn-secondary rounded-pill pe-4 ps-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
    </div>
</div>

<!-- PRINT ONLY SECTION -->
<div class="d-none d-print-block p-4" id="printSection">
    <div class="text-center mb-4">
        <div class="d-flex justify-content-center align-items-center mb-2 text-dark">
            <h4 class="fw-bold mb-0">ವಾಯವ್ಯ ಕರ್ನಾಟಕ ರಸ್ತೆ ಸಾರಿಗೆ ಸಂಸ್ಥೆ</h4>
        </div>
        <h5 class="fw-bold mb-1 text-dark">North Western Karnataka Road Transport Corporation</h5>
        <h6 class="mb-0 text-dark">ಕೇಂದ್ರ ಕಛೇರಿ : ಹುಬ್ಬಳ್ಳಿ / Central Office : Hubballi</h6>
        <div class="border-bottom border-2 border-dark mt-2 mb-3"></div>
        <h5 class="fw-bold text-decoration-underline text-dark text-uppercase">GRATUITY CASE DETAILS</h5>
    </div>

    <table class="table table-bordered border-dark align-middle print-table">
        <thead>
            <tr class="text-center bg-light text-dark">
                <th style="width: 8%;">SL NO.</th>
                <th style="width: 32%;">DETAILS OF THE INFORMATION</th>
                <th style="width: 60%;">DETAILS OF THE CASE</th>
            </tr>
        </thead>
        <tbody class="text-dark">
            <tr>
                <td class="text-center">1</td>
                <td>DIVISION</td>
                <td colspan="2">@ViewBag.DivisionName</td>
            </tr>
            <tr>
                <td class="text-center">2</td>
                <td>NAME & DESIGNATION</td>
                <td colspan="2">@Model.ClaimantName, @Model.ClaimantDesignation</td>
            </tr>
            <tr>
                <td class="text-center">3</td>
                <td>CLAIM DETAILS</td>
                <td colspan="2">@Model.AmountClaimed</td>
            </tr>
            <tr>
                <td class="text-center">4</td>
                <td>DATE OF BIRTH</td>
                <td colspan="2">@(Model.DateOfBirth?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">5</td>
                <td rowspan="2">DATE OF APPOINTMENT</td>
                <td colspan="2"><strong>AS PER CORPORATION:</strong> @(Model.AppointmentDate?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.AppointmentDate_CA?.ToShortDateString() ?? "-")</td>
            </tr>
            
            <tr>
                <td class="text-center" rowspan="2">6</td>
                <td rowspan="2">DATE OF RETIREMENT / DISMISSED / DEATH / VRS</td>
                <td colspan="2"><strong>AS PER CORPORATION:</strong> @(Model.RetirementDate?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.RetirementDate_CA?.ToShortDateString() ?? "-")</td>
            </tr>

            <tr>
                <td class="text-center" rowspan="2">7</td>
                <td rowspan="2">TOTAL PERIOD OF SERVICE</td>
                <td colspan="2"><strong>AS PER CORPORATION:</strong> @Model.TotalServicePeriod</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY:</strong> @Model.QualifyingService_CA</td>
            </tr>

            <tr>
                <td class="text-center" rowspan="2">8</td>
                <td rowspan="2">TOTAL PERIOD OF SPE / LWA / ABS</td>
                <td colspan="2"><strong>AS PER CORPORATION:</strong> @Model.Period_SPE_LWA_ABS</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY:</strong> @Model.Period_SPE_LWA_ABS_CA</td>
            </tr>

            <tr>
                <td class="text-center" rowspan="2">9</td>
                <td rowspan="2">CALCULATION OF QUALIFYING SERVICE</td>
                <td colspan="2"><strong>AS PER CORPORATION:</strong> @Model.QualifyingService_Corp</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY:</strong> @Model.QualifyingService_CA</td>
            </tr>

            <tr>
                <td class="text-center">10</td>
                <td>DETAILS IF ANY</td>
                <td colspan="2">
                    @if (!string.IsNullOrEmpty(Model.Remarks)) { <div><strong>Remarks:</strong> @Model.Remarks</div> }
                    @if (!string.IsNullOrEmpty(Model.AppealAwardDetails)) { <div class="@(!string.IsNullOrEmpty(Model.Remarks) ? "mt-1" : "")"><strong>Award Details:</strong> @Model.AppealAwardDetails</div> }
                    @if (string.IsNullOrEmpty(Model.Remarks) && string.IsNullOrEmpty(Model.AppealAwardDetails)) { <span>--</span> }
                </td>
            </tr>

            <tr>
                <td class="text-center" rowspan="3">11</td>
                <td rowspan="3">LAST DRAWN (SALARY DETAILS)</td>
                <td colspan="2"><strong>BASIC PAY:</strong> ₹ @Model.LastDrawnBasic</td>
            </tr>
            <tr>
                <td colspan="2"><strong>BDA:</strong> ₹ @Model.LastDrawnBDA</td>
            </tr>
            <tr>
                <td colspan="2"><strong>DA:</strong> ₹ @Model.LastDrawnDA</td>
            </tr>

            <tr>
                <td class="text-center" rowspan="4">12</td>
                <td rowspan="4">GRATUITY AMOUNT CALCULATED</td>
                <td colspan="2"><strong>AS PER CORPORATION (ACT):</strong> ₹ @Model.GratuityAmount_Corp_Act</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CORPORATION (REGULATION):</strong> ₹ @Model.GratuityAmount_Corp_Reg</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY (ACT):</strong> ₹ @Model.GratuityAmount_CA_Act</td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY (REGULATION):</strong> ₹ @Model.GratuityAmount_CA_Reg</td>
            </tr>

            <tr>
                <td class="text-center" rowspan="2">13</td>
                <td rowspan="2">DEDUCTIONS MADE FROM GRATUITY AMOUNT</td>
                <td colspan="2"><strong>AS PER CORPORATION:</strong> ₹ @(Model.DeductionAmount?.ToString("N2") ?? "0.00") <br/> <small>@Model.DeductionDetails</small></td>
            </tr>
            <tr>
                <td colspan="2"><strong>AS PER CONTROLLING AUTHORITY:</strong> ₹ @(Model.DeductionAmount_CA?.ToString("N2") ?? "0.00") <br/> <small>@Model.DeductionDetails_CA</small></td>
            </tr>

            <tr>
                <td class="text-center">14</td>
                <td>CONTROLLING AUTHORITY HELD DEDUCTION OF AMOUNT NOT PERMISSIBLE UNDER ACT.</td>
                <td colspan="2">@Model.InterestRemarks</td>
            </tr>

            <tr>
                <td class="text-center" rowspan="3">15</td>
                <td rowspan="3">ACTUAL AMOUNT PAID BY CORPORATION</td>
                <td colspan="2"><strong>AMOUNT:</strong> ₹ @(Model.ActualPaidAmount?.ToString("N2") ?? Model.Payments?.Sum(p => p.Amount ?? 0).ToString("N2") ?? "0.00")</td>
            </tr>
            <tr>
                <td colspan="2"><strong>CHQ NO:</strong> @(Model.ChequeNumber ?? Model.Payments?.OrderByDescending(p => p.ChequeDate).FirstOrDefault()?.ChequeNumber ?? "-")</td>
            </tr>
            <tr>
                <td colspan="2"><strong>DATE:</strong> @(Model.ChequeDate?.ToShortDateString() ?? Model.Payments?.OrderByDescending(p => p.ChequeDate).FirstOrDefault()?.ChequeDate?.ToShortDateString() ?? "-")</td>
            </tr>



            <tr>
                <td class="text-center">17</td>
                <td>DETAILS OF OBTAINING CERTIFIED COPY OF THE AWARD</td>
                <td colspan="2">
                    @(Model.CopyAppliedDate.HasValue ? "Applied: " + Model.CopyAppliedDate.Value.ToShortDateString() : "") 
                    @(Model.CopyReceivedDate.HasValue ? " | Received: " + Model.CopyReceivedDate.Value.ToShortDateString() : "")
                    @if (!Model.CopyAppliedDate.HasValue && !Model.CopyReceivedDate.HasValue) { <span>--</span> }
                </td>
            </tr>
            <tr>
                <td class="text-center">18</td>
                <td>OPINION OF ADVOCATE</td>
                <td colspan="2">@Model.AdvocateOpinion</td>
            </tr>
            <tr>
                <td class="text-center">19</td>
                <td>OPINION OF ALO / LO</td>
                <td colspan="2">@Model.LOOpinion</td>
            </tr>
            <tr>
                <td class="text-center">20</td>
                <td>OPINION OF DC</td>
                <td colspan="2">@Model.DCOpinion</td>
            </tr>
        </tbody>
    </table>


</div>

<style>
    .text-gratuity { color: #C2185B !important; }
    .bg-gratuity { background-color: #C2185B !important; }
    .border-gratuity { border-color: #C2185B !important; }
    .xs { font-size: 0.7rem; }
    .italic { font-style: italic; }
    .ls-1 { letter-spacing: 1px; }
    
    @@media print {
        .d-print-none { display: none !important; }
        .d-print-block { display: block !important; }
        .container-fluid { padding: 0 !important; }
        .card { border: 1px solid #dee2e6 !important; box-shadow: none !important; margin-bottom: 10px !important; }
        
        .print-table th, .print-table td {
            border: 1px solid #000 !important;
            padding: 8px !important;
            font-size: 11pt !important;
        }
        
        .print-container {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        
        @@page {
            size: auto;
            margin: 15mm;
        }
    }
</style>
