@model MVCCaseManagement.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="kn-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/cdn.css" rel="stylesheet" />
    <link href="~/css/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-portal">
        <div class="portal-body-official">
            @if (!ViewData.ModelState.IsValid || TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger py-2 small mb-4 border-start border-4 border-danger" style="font-size: 0.75rem;">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @Html.ValidationSummary(true, "")
                    @TempData["ErrorMessage"]
                </div>
            }
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 small mb-4 border-start border-4 border-success" style="font-size: 0.75rem;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            <form action="@Url.Action("Login", "Account")" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-4">
                    <label asp-for="Username" class="auth-label">Username</label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="Enter username" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="auth-label">Password</label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="login-extras">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label small text-muted" for="rememberMe">Remember</label>
                    </div>
                    <a href="@Url.Action("ForgotPassword", "Account")" class="fw-bold">Forgot?</a>
                </div>

                <button type="submit" class="btn btn-auth-primary w-100 shadow-sm">
                    Login/ಲಾಗಿನ್
                </button>
            </form>
            
            
        </div>
    </div>
</body>
</html>
