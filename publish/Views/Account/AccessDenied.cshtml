@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body p-5">
            <div class="mb-4">
                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-danger mb-3">Access Denied</h2>
            <p class="text-muted lead mb-4">
                You do not have permission to access this resource.
            </p>
            <p class="text-secondary mb-4">
                Starting new case registrations is restricted to <strong>Division Users</strong> only. 
                Central Office users can only view and manage appeals.
            </p>
            <a asp-controller="Case" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-arrow-left me-2"></i> Return to Case List
            </a>
        </div>
    </div>
</div>
