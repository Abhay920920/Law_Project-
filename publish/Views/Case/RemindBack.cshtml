@model IEnumerable<MVCCaseManagement.Models.MVCCaseViewModel>

@{
    ViewData["Title"] = "Remand Back Cases";
    ViewData["PageHeaderClass"] = "ep-header";
    ViewData["HidePageHeader"] = true;
}

<div class="container-fluid px-4 py-3">
    <!-- Header Line -->
    <div class="d-flex align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0 pe-3 border-end border-2 border-primary-subtle">Remand Back Cases</h4>
        <nav aria-label="breadcrumb" class="ms-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Case/Index" class="text-decoration-none">Cases</a></li>
                <li class="breadcrumb-item active">Remand Back</li>
            </ol>
        </nav>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card total ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Total Cases</span>
                    <h4 class="stat-value">@ViewBag.TotalCount</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-stack"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card pending ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Pending Action</span>
                    <h4 class="stat-value">@Model.Count(m => m.CurrentStage?.Contains("Evidence") == true || m.CurrentStage == "Pending")</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card hearings ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Hearings Scheduled</span>
                    <h4 class="stat-value">@Model.Count(m => m.NextHearingDate.HasValue)</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card disposed ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Disposed (RB)</span>
                    <h4 class="stat-value">0</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-check2-all"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="gov-card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="gov-card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <div class="header-title h6 mb-0 fw-bold text-dark">
                <i class="bi bi-collection-play-fill me-2 text-primary"></i>
                Active Remand Back Cases
            </div>
            <div>
                 <a href="@Url.Action("RemindBackEntry", "Case")" class="btn btn-primary btn-sm rounded-3 px-3">
                    <i class="bi bi-plus-circle me-1"></i> New Entry
                </a>
            </div>
        </div>
        <div class="gov-card-body p-3 border-top border-bottom bg-light-subtle">
             <div class="row align-items-center">
                <div class="col-md-5">
                    <form method="get" asp-action="RemindBack">
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Filter by MVC No / Petitioner...">
                            <button class="btn btn-primary px-3" type="submit">Filter</button>
                        </div>
                    </form>
                </div>
             </div>
        </div>
        <div class="gov-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 remand-table">
                    <thead>
                        <tr>
                            <th style="width: 15%">MVC Identification</th>
                            <th style="width: 18%">eCourts CNR</th>
                            <th style="width: 22%">Petitioner Details</th>
                            <th style="width: 15%">Legal Counsel</th>
                            <th style="width: 12%">Case Stage</th>
                            <th style="width: 10%">Hearing Date</th>
                            <th class="text-end" style="width: 8%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <i class="bi bi-cloud-slash fs-1 d-block mb-3 opacity-25"></i>
                                        <span class="fw-bold">No Records Found</span>
                                        <p class="small mb-0">Try adjusting your search criteria</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                int detailId = item.RemindBackID > 0 ? item.RemindBackID : item.CaseID;
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark">MVC @item.MVCNo</span>
                                            <span class="small text-muted text-uppercase tracking-wider">Year: @item.MVCYear</span>
                                            @if (!string.IsNullOrEmpty(item.MACTName))
                                            {
                                                <span class="small text-secondary text-truncate" style="max-width: 150px;" title="@item.MACTName">@item.MACTName</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CNRNumber))
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                <span class="font-monospace fw-bold text-primary small">
                                                    <i class="bi bi-shield-check me-1 text-success"></i>@item.CNRNumber
                                                </span>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem; width: fit-content;">
                                                    <i class="bi bi-broadcast me-1"></i>eCourts Linked
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border small">No CNR</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary-subtle text-primary rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                @(item.Petitioners.FirstOrDefault()?.PetitionerName?.Substring(0, 1) ?? "P")
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @(item.Petitioners.FirstOrDefault()?.PetitionerName ?? "N/A")
                                                </div>
                                                @if(item.Petitioners.Count > 1) {
                                                    <div class="small text-muted">+@(item.Petitioners.Count - 1) additional</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-secondary"><i class="bi bi-person-badge me-1"></i>@(item.AdvocateName ?? "Unassigned")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-2 px-2 py-1 small">
                                            @item.CurrentStage
                                        </span>
                                    </td>
                                     <td>
                                        @if(item.NextHearingDate.HasValue) {
                                            <div class="small text-dark fw-bold">
                                                <i class="bi bi-calendar3 me-1 text-primary"></i>
                                                @item.NextHearingDate.Value.ToString("dd-MMM-yyyy")
                                            </div>
                                        } else {
                                            <span class="badge bg-light text-muted border rounded-2 px-2 py-1 small">Not Scheduled</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("RemindBackDetails", "Case", new { id = detailId })" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="View Details & Live eCourts Dossier">
                                                <i class="bi bi-eye me-1"></i>View
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
             @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("RemindBack", new { page = ViewBag.CurrentPage - 1, search = ViewBag.CurrentSearch })">&laquo;</a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("RemindBack", new { page = i, search = ViewBag.CurrentSearch })">@i</a>
                                </li>
                            }
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("RemindBack", new { page = ViewBag.CurrentPage + 1, search = ViewBag.CurrentSearch })">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .stat-card.ultra-mini {
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        min-height: 80px;
        display: flex;
        align-items: center;
    }
    .stat-card.ultra-mini .stat-value {
        font-size: 1.5rem;
        margin: 0;
        font-weight: 800;
    }
    .stat-card.ultra-mini .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        opacity: 0.85;
    }
    .stat-card.ultra-mini .stat-icon-bg {
        font-size: 2rem;
        right: 8px;
        bottom: -2px;
        opacity: 0.12;
    }
    .stat-card.hearings {
        background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 10px 20px -5px rgba(14, 165, 233, 0.4);
    }
    
    /* Table Improvements */
    .remand-table thead th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1rem 0.75rem;
        border-bottom: 2px solid #e2e8f0;
    }
    .remand-table tbody tr {
        transition: all 0.2s;
    }
    .remand-table tbody tr:hover {
        background-color: #f1f5f9 !important;
        transform: scale(1.002);
    }
    .remand-table td {
        padding: 1rem 0.75rem;
        font-size: 0.9rem;
    }
</style>
