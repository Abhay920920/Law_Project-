@model IEnumerable<MVCCaseManagement.Models.MVCCaseViewModel>
@{
    ViewData["Title"] = "Third Party Cases";
    ViewData["HidePageHeader"] = true;
    int totalCount = ViewBag.TotalCount ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentSearch = ViewBag.CurrentSearch ?? "";
}

<div class="tp-list-wrapper">

    <!-- Page Hero Banner -->
    <div class="tp-hero mb-4">
        <div class="tp-hero-inner d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="tp-hero-icon">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div>
                    <h2 class="mb-0 fw-bold text-white">Third Party Cases</h2>
                    <p class="mb-0 text-white-50 small">
                        <i class="bi bi-layers me-1"></i>
                        @totalCount case@(totalCount != 1 ? "s" : "") registered
                    </p>
                </div>
            </div>
            @if (!User.IsInRole("ReadOnly") && User.FindFirst("DivisionID")?.Value != "0" && User.FindFirst("DivisionID")?.Value != "5" && !string.IsNullOrEmpty(User.FindFirst("DivisionID")?.Value))
            {
                <a href="/Case/RegisterThirdParty" class="btn btn-new-tp shadow-lg" id="btnNewThirdParty">
                    <i class="bi bi-plus-circle-fill me-2"></i>
                    New Third Party Registration
                </a>
            }
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="tp-stat-card">
                <div class="tp-stat-icon bg-info-subtle text-info">
                    <i class="bi bi-collection-fill"></i>
                </div>
                <div class="tp-stat-value">@totalCount</div>
                <div class="tp-stat-label">Total Cases</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tp-stat-card">
                <div class="tp-stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="tp-stat-value">@Model.Count(c => string.IsNullOrEmpty(c.DisposalStatus) || c.DisposalStatus == "Pending")</div>
                <div class="tp-stat-label">Pending</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tp-stat-card">
                <div class="tp-stat-icon bg-success-subtle text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="tp-stat-value">@Model.Count(c => c.DisposalResult == "Favor")</div>
                <div class="tp-stat-label">Favor</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tp-stat-card">
                <div class="tp-stat-icon bg-danger-subtle text-danger">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <div class="tp-stat-value">@Model.Count(c => c.DisposalResult == "Against")</div>
                <div class="tp-stat-label">Against</div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="tp-search-card mb-4">
        <form method="get" asp-action="ThirdPartyList" class="m-0">
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <div class="flex-grow-1">
                    <div class="input-group tp-search-group">
                        <span class="input-group-text">
                            <i class="bi bi-search text-info"></i>
                        </span>
                        <input type="text"
                               name="search"
                               id="tpSearch"
                               value="@currentSearch"
                               class="form-control tp-search-input"
                               placeholder="Search by MVC No, Vehicle No, Year, CNR, Advocate, Status..." />
                        <button class="btn btn-info text-white px-4 fw-semibold" type="submit" id="btnSearchTP">
                            Search
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a href="@Url.Action("ThirdPartyList")" class="btn btn-outline-secondary rounded-pill px-3" id="btnClearSearch">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 shadow-sm border-0 mb-4 animate__animated animate__fadeInDown" id="successAlert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Cases Table Card -->
    <div class="tp-table-card">
        @if (!Model.Any())
        {
            <div class="tp-empty-state">
                <div class="tp-empty-icon">
                    <i class="bi bi-person-x-fill"></i>
                </div>
                <h5 class="mt-3 text-muted fw-bold">
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <span>No results found for "@currentSearch"</span>
                    }
                    else
                    {
                        <span>No Third Party Cases Registered Yet</span>
                    }
                </h5>
                <p class="text-muted small">
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <span>Try a different search term.</span>
                    }
                    else
                    {
                        <span>Click <strong>New Third Party Registration</strong> above to add the first case.</span>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table tp-table mb-0" id="thirdPartyTable">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>MVC No / Year</th>
                            <th>Vehicle No</th>
                            <th>Respondent(s)</th>
                            <th>Advocate</th>
                            <th>Next Hearing</th>
                            <th>Case Type</th>
                            <th>Status</th>
                            <th>Registered On</th>
                            <th style="width:90px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int rowNum = ((currentPage - 1) * 10) + 1;}
                        @foreach (var item in Model)
                        {
                            string disposalStatus = item.DisposalStatus ?? "";
                            string disposalResult = item.DisposalResult ?? "";
                            string statusBadge = "badge-pending";
                            string statusLabel = "Pending";

                            if (!string.IsNullOrEmpty(disposalResult))
                            {
                                if (disposalResult == "Favor") { statusBadge = "badge-favor"; statusLabel = "Favor"; }
                                else if (disposalResult == "Against") { statusBadge = "badge-against"; statusLabel = "Against"; }
                            }
                            else if (!string.IsNullOrEmpty(disposalStatus))
                            {
                                statusBadge = "badge-disposed"; statusLabel = disposalStatus;
                            }

                            var respondentNames = string.Join(", ", item.Respondents.Select(r => r.RespondentName));

                            <tr class="tp-row" id="row-@item.CaseID">
                                <td class="text-muted small align-middle">@(rowNum++)</td>
                                <td class="align-middle">
                                    <a href="@Url.Action("Details", "Case", new { id = item.CaseID })" class="tp-mvc-link fw-bold">
                                        @item.MVCNo/@item.MVCYear
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.CNRNumber))
                                    {
                                        <div class="text-muted small font-monospace mt-1">
                                            <i class="bi bi-upc-scan me-1 text-info"></i>@item.CNRNumber
                                        </div>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (!string.IsNullOrEmpty(item.VehicleNo))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@item.VehicleNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.VehicleType))
                                    {
                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-truck me-1"></i>@item.VehicleType
                                        </div>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (!string.IsNullOrEmpty(respondentNames))
                                    {
                                        <span class="small text-dark">@respondentNames</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="small">@(item.AdvocateName ?? "—")</span>
                                </td>
                                <td class="align-middle">
                                    @if (item.NextHearingDate.HasValue)
                                    {
                                        bool isUpcoming = item.NextHearingDate.Value.Date >= DateTime.Today;
                                        <span class="badge @(isUpcoming ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary-subtle text-secondary border") font-monospace small">
                                            @item.NextHearingDate.Value.ToString("dd-MM-yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle small">@item.CaseType</span>
                                </td>
                                <td class="align-middle">
                                    <span class="tp-status-badge @statusBadge">@statusLabel</span>
                                </td>
                                <td class="align-middle text-muted small">
                                    @(item.CreatedAt != DateTime.MinValue ? item.CreatedAt.ToString("dd-MM-yyyy") : "—")
                                </td>
                                <td class="align-middle text-end">
                                    <a href="@Url.Action("Details", "Case", new { id = item.CaseID })"
                                       class="btn btn-sm btn-outline-info tp-view-btn"
                                       title="View Case Details">
                                        <i class="bi bi-eye-fill me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top">
                    <span class="text-muted small">
                        Page <strong>@currentPage</strong> of <strong>@totalPages</strong> &mdash; @totalCount total case@(totalCount != 1 ? "s" : "")
                    </span>
                    <nav aria-label="Third Party pagination">
                        <ul class="pagination pagination-sm mb-0 gap-1">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded" href="@Url.Action("ThirdPartyList", new { page = currentPage - 1, search = currentSearch })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link rounded" href="@Url.Action("ThirdPartyList", new { page = p, search = currentSearch })">@p</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link rounded" href="@Url.Action("ThirdPartyList", new { page = currentPage + 1, search = currentSearch })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<style>
    /* ===== Third Party List: Premium Design ===== */
    .tp-list-wrapper {
        padding: 1rem;
    }

    /* Hero Banner */
    .tp-hero {
        background: linear-gradient(135deg, #0891b2 0%, #0e7490 50%, #155e75 100%);
        border-radius: 1.2rem;
        padding: 1.6rem 2rem;
        box-shadow: 0 8px 32px rgba(8, 145, 178, 0.25);
    }
    .tp-hero-icon {
        width: 56px; height: 56px;
        background: rgba(255,255,255,0.18);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; color: #fff;
        backdrop-filter: blur(8px);
    }

    /* New Registration Button */
    .btn-new-tp {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        color: #0e7490;
        border: 2px solid rgba(255,255,255,0.6);
        border-radius: 50px;
        padding: 0.65rem 1.5rem;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.01em;
        transition: all 0.25s ease;
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        white-space: nowrap;
    }
    .btn-new-tp:hover {
        background: #fff;
        color: #0e7490;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    }
    .btn-new-tp i { font-size: 1rem; }

    /* Stat Cards */
    .tp-stat-card {
        background: #fff;
        border-radius: 1rem;
        padding: 1.2rem 1rem;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1px solid #f1f5f9;
        transition: transform 0.2s;
    }
    .tp-stat-card:hover { transform: translateY(-3px); box-shadow: 0 6px 24px rgba(0,0,0,0.11); }
    .tp-stat-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
        margin: 0 auto 0.5rem;
    }
    .tp-stat-value {
        font-size: 1.7rem; font-weight: 800; color: #1e293b; line-height: 1.1;
    }
    .tp-stat-label {
        font-size: 0.73rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-top: 2px;
    }

    /* Search Card */
    .tp-search-card {
        background: #fff;
        border-radius: 1rem;
        padding: 1.2rem 1.4rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1px solid #f1f5f9;
    }
    .tp-search-group .input-group-text {
        background: #f0f9ff; border-right: none; border-radius: 10px 0 0 10px;
    }
    .tp-search-input {
        border-left: none; border-radius: 0; font-size: 0.92rem;
        padding: 0.65rem 1rem;
    }
    .tp-search-input:focus { box-shadow: none; border-color: #0891b2; }
    .tp-search-group .btn { border-radius: 0 10px 10px 0; }

    /* Table Card */
    .tp-table-card {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 2px 16px rgba(0,0,0,0.08);
        border: 1px solid #f1f5f9;
        overflow: hidden;
    }

    /* Table */
    .tp-table thead th {
        background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
        color: #0e7490;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 700;
        padding: 0.85rem 1rem;
        border-bottom: 2px solid #bae6fd;
        white-space: nowrap;
    }
    .tp-table tbody td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        font-size: 0.88rem;
        border-color: #f1f5f9;
    }
    .tp-row { transition: background 0.15s; }
    .tp-row:hover { background: #f0f9ff !important; }

    .tp-mvc-link {
        color: #0e7490;
        text-decoration: none;
        font-size: 1rem;
        letter-spacing: 0.01em;
    }
    .tp-mvc-link:hover { color: #0891b2; text-decoration: underline; }

    /* Status Badges */
    .tp-status-badge {
        display: inline-block;
        padding: 0.3em 0.75em;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }
    .badge-pending { background: #fef9c3; color: #854d0e; border: 1px solid #fde68a; }
    .badge-favor   { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .badge-against { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .badge-disposed { background: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc; }

    .tp-view-btn {
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.3rem 0.75rem;
        white-space: nowrap;
    }

    /* Empty State */
    .tp-empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }
    .tp-empty-icon {
        font-size: 4rem;
        color: #bae6fd;
    }

    /* Pagination */
    .pagination .page-link {
        border: 1px solid #e2e8f0;
        color: #0e7490;
        padding: 0.4rem 0.7rem;
        font-size: 0.85rem;
        transition: all 0.15s;
    }
    .pagination .page-item.active .page-link {
        background: #0891b2; border-color: #0891b2; color: #fff;
    }
    .pagination .page-link:hover { background: #e0f2fe; color: #0e7490; }

    /* Animate */
    .animate__animated.animate__fadeInDown {
        animation: fadeInDown 0.4s ease both;
    }
    @@keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
