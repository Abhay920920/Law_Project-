                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Page no. / Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AdverseAward?.EnclosedDocuments != null && Model.AdverseAward.EnclosedDocuments.Any())
                {
                    int sno = 1;
                    foreach (var doc in Model.AdverseAward.EnclosedDocuments)
                    {
                        <tr>
                            <td class="text-center fw-bold">@sno</td>
                            <td>@doc.DocName</td>
                            <td class="text-center">@(doc.PageCount.HasValue ? $"Page: {doc.PageCount.Value}" : "Enclosed")</td>
