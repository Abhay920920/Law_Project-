    <!-- SECTION H – CONNECTED CASES, APPEALS AND EXECUTION PROCEEDINGS -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION H – CONNECTED CASES, APPEALS AND EXECUTION PROCEEDINGS</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Details of connected MVC / other cases: pending / disposed, case numbers and outcome</td>
                    <td>
                        @if (Model.ConnectedCases != null && Model.ConnectedCases.Any())
                        {
                            var uniqueCases = Model.ConnectedCases.GroupBy(c => new { c.ConnectedMVCNo, c.ConnectedYear }).Select(g => g.First());
                            foreach (var conn in uniqueCases)
                            {
                                <div><strong>@conn.ConnectedMVCNo/@conn.ConnectedYear</strong> @(!string.IsNullOrEmpty(conn.MACT) ? "- " + conn.MACT : "") (@(conn.Status ?? "Connected")) @(!string.IsNullOrEmpty(conn.Remarks) ? "- " + conn.Remarks : "")</div>
                            }
                        }
                        else
                        {
                            <span>No Connected Cases</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Whether appeal / cross-objection / review is filed by claimant or Corporation; case number and status</td>
                    <td>
                        @if (Model.LinkedAppeal != null)
                        {
                            if (!string.IsNullOrEmpty(Model.LinkedAppeal.CorpMFANumber))
                            {
                                <div><strong>Corp MFA:</strong> @Model.LinkedAppeal.CorpMFANumber/@Model.LinkedAppeal.CorpMFAYear (@Model.LinkedAppeal.CorpMFAStatus) &bull; @Model.LinkedAppeal.HighCourtBench</div>
                            }
                            if (!string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantMFANumber))
                            {
                                <div><strong>Claimant MFA:</strong> @Model.LinkedAppeal.ClaimantMFANumber/@Model.LinkedAppeal.ClaimantMFAYear (@Model.LinkedAppeal.ClaimantMFADecision)</div>
                            }
                        }
                        else
                        {
                            <span>Under Feasibility Review / No Appeal Filed Yet</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">Whether appeal approval was sought / granted; reference number and date</td>
                    <td>
                        @if (Model.LinkedAppeal != null && !string.IsNullOrEmpty(Model.LinkedAppeal.ApprovalOutwardNo))
                        {
                            <div><strong>Approval Ref:</strong> @Model.LinkedAppeal.ApprovalOutwardNo (@(Model.LinkedAppeal.ApprovalDate?.ToString("dd-MM-yyyy") ?? ""))</div>
                        }
                        else
                        {
                            <span>@(Model.LinkedAppeal?.InitialAction ?? "Pending Proposal")</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
                    <td class="fw-semibold">Whether execution petition (EP) is filed; EP number, date and present stage</td>
                    <td>
                        @if (Model.AdverseAward?.IsEPFiled == true)
                        {
                            <div><strong>EP Filed:</strong> Yes</div>
                            <div><strong>EP No:</strong> @(string.IsNullOrEmpty(Model.AdverseAward.EPNumber) ? "—" : Model.AdverseAward.EPNumber)</div>
                            <div><strong>Court:</strong> @(string.IsNullOrEmpty(Model.AdverseAward.EPCourt) ? "—" : Model.AdverseAward.EPCourt)</div>
                            <div><strong>Stage:</strong> @(string.IsNullOrEmpty(Model.AdverseAward.EPStage) ? "—" : Model.AdverseAward.EPStage)</div>
                        }
                        else
                        {
                            <span>EP Filed: No</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Whether attachment warrant / recovery proceedings are issued</td>
                    <td>@(Model.AdverseAward?.IsEPFiled == true && Model.AdverseAward?.IsAmountDepositedInEP == true ? "Warrant / Recovery initiated" : "No Attachment Warrant Issued")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">6</td>
                    <td class="fw-semibold">Whether any amount is deposited pursuant to EP / attachment; date and amount</td>
                    <td>
                        @(Model.AdverseAward?.IsAmountDepositedInEP == true && Model.AdverseAward.EPDepositedAmount.HasValue
                            ? $"Yes — Rs. {Model.AdverseAward.EPDepositedAmount.Value:N2} Deposited"
                            : "Nil / No Amount Deposited in EP")
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">7</td>
                    <td class="fw-semibold">Whether any amount has been paid / deposited earlier; furnish details and proof</td>
                    <td>
                        @if (Model.AdverseAward?.Payments != null && Model.AdverseAward.Payments.Any())
                        {
                            @for (int p = 0; p < Model.AdverseAward.Payments.Count; p++)
                            {
                                var pay = Model.AdverseAward.Payments[p];
                                <div>@(p + 1)) Rs. @pay.Amount.ToString("N2") (@(pay.PaymentType ?? "Payment")) dt. @(pay.ChequeDate?.ToString("dd-MM-yyyy") ?? pay.CreatedDate.ToString("dd-MM-yyyy"))</div>
                            }
                        }
                        else if (Model.LinkedAppeal?.AmountDeposited.HasValue == true)
                        {
                            <span>Rs. @Model.LinkedAppeal.AmountDeposited.Value.ToString("N2") Deposited in Appeal</span>
                        }
                        else
                        {
                            <span>Nil</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

