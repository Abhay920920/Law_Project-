                    <tr>
                        <td class="fw-semibold">Loss of amenities</td>
                        <td class="text-end font-monospace">@(Model.AdverseAward?.LossOfAmenities.HasValue == true ? Model.AdverseAward.LossOfAmenities.Value.ToString("N2") : "0.00")</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Future medical expenses</td>
                        <td class="text-end font-monospace">@(Model.AdverseAward?.FutureMedicalExpenses.HasValue == true ? Model.AdverseAward.FutureMedicalExpenses.Value.ToString("N2") : "0.00")</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Other heads</td>
                        <td class="text-end font-monospace">@(Model.AdverseAward?.InjuryOtherExpense.HasValue == true ? Model.AdverseAward.InjuryOtherExpense.Value.ToString("N2") : "0.00")</td>
                    </tr>
                    <tr class="fw-bold" style="background-color: #f8f9fa;">
                        <td>Total compensation awarded</td>
                        <td class="text-end font-monospace fs-6">Rs. @(Model.AdverseAward?.AwardAmount?.ToString("N2") ?? "0.00")</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">NWKRTC liability / apportioned share</td>
                        <td class="text-end font-monospace">
                            @(Model.AdverseAward?.LiabilityPercentage != null ? Model.AdverseAward.LiabilityPercentage + "%" : "100%") 
                            @(Model.AdverseAward?.LiableAmount.HasValue == true ? "(Rs. " + Model.AdverseAward.LiableAmount.Value.ToString("N2") + ")" : "")
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Interest rate (%)</td>
                        <td class="text-end">@(Model.AdverseAward?.InterestRate != null ? Model.AdverseAward.InterestRate + "% p.a." : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- SECTION L – LIST OF DOCUMENTS ENCLOSED -->
    <div class="print-section mb-4">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 63%;" />
                <col style="width: 30%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION L – LIST OF DOCUMENTS ENCLOSED</th>
                </tr>
