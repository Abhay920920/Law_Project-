                    <tr>
                        <td class="fw-semibold">Loss of future income / earning capacity</td>
                        <td class="text-end font-monospace">@(Model.AdverseAward?.LossOfFutureIncome.HasValue == true ? Model.AdverseAward.LossOfFutureIncome.Value.ToString("N2") : "0.00")</td>
