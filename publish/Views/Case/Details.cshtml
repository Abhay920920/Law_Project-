                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Whether medical bills are verified (injury cases); whether bills tally with amount awarded</td>
                    <td>@(Model.AdverseAward?.IsMedicalBillsVerified == true ? "Yes, Medical Bills Verified & Tallied" : "No / Not Applicable")</td>
