@model MVCCaseManagement.Models.MVCCaseViewModel

@{
    ViewData["Title"] = "Case Details - " + Model.MVCNo;
    ViewData["HidePageHeader"] = true;
}

<!-- ========================================== -->
<!-- OFFICIAL FEASIBILITY REPORT PRINT VIEW    -->
<!-- ========================================== -->
<div id="print-view" class="d-none d-print-block" style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; color: #000;">
    
    <!-- Corporation Header -->
    <div class="text-center mb-3">
        <h5 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 13pt;">NORTH WESTERN KARNATAKA ROAD TRANSPORT CORPORATION</h5>
        <h6 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 11pt;">LAW DEPARTMENT – CENTRAL OFFICE, HUBBALLI</h6>
        <div class="fw-bold text-decoration-underline mt-2" style="font-size: 11.5pt;">CONSOLIDATED MVC CASE FEASIBILITY REPORT</div>
        <div class="fst-italic mt-1" style="font-size: 9.5pt;">(Common format for Death and Injury Claims) &bull; Division: <strong>@Model.DivisionName</strong></div>
    </div>

    <!-- SECTION A – BASIC CASE DETAILS -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION A – BASIC CASE DETAILS</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Name of Division</td>
                    <td>@Model.DivisionName</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Name of MACT / Court and place &amp; 16-Digit CNR No.</td>
                    <td>
                        <div><strong>Court:</strong> @(string.IsNullOrEmpty(Model.MACTName) ? "—" : Model.MACTName)</div>
                        @if (!string.IsNullOrEmpty(Model.CNRNumber))
                        {
                            <div class="mt-1"><strong>CNR:</strong> <span class="font-monospace fw-bold">@Model.CNRNumber</span></div>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">MVC No. and year</td>
                    <td><strong>MVC @Model.MVCNo / @Model.MVCYear</strong></td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
                    <td class="fw-semibold">Nature of claim: Death / Injury</td>
                    <td><span class="fw-bold">@(string.IsNullOrEmpty(Model.CaseType) ? (Model.AdverseAward?.InjuryType ?? "—") : Model.CaseType)</span></td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Name(s) of claimant(s) / petitioner(s) &amp; Relationship</td>
                    <td>
                        @if (Model.Petitioners != null && Model.Petitioners.Any())
                        {
                            @for (int i = 0; i < Model.Petitioners.Count; i++)
                            {
                                <div>@(i + 1)) @Model.Petitioners[i].PetitionerName (@(Model.Petitioners[i].Relationship == "Others" ? Model.Petitioners[i].RelationshipOthers : Model.Petitioners[i].Relationship))</div>
                            }
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">6</td>
                    <td class="fw-semibold">Name of deceased / injured person</td>
                    <td>
                        @{
                            var primaryVictim = Model.Petitioners?.FirstOrDefault()?.PetitionerName;
                        }
                        @(string.IsNullOrEmpty(primaryVictim) ? "—" : primaryVictim)
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">7</td>
                    <td class="fw-semibold">Date of accident</td>
                    <td>@(Model.AccidentDate?.ToString("dd-MM-yyyy") ?? "—")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">8</td>
                    <td class="fw-semibold">Date of filing of claim petition</td>
                    <td>@(Model.AdverseAward?.ClaimPetitionDate?.ToString("dd-MM-yyyy") ?? Model.ClaimPetitionDate?.ToString("dd-MM-yyyy") ?? "—")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">9</td>
                    <td class="fw-semibold">Date of judgment / award</td>
                    <td><strong>@(Model.AdverseAward?.AwardDate?.ToString("dd-MM-yyyy") ?? "—")</strong></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- SECTION B – ACCIDENT AND VEHICLE DETAILS -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION B – ACCIDENT AND VEHICLE DETAILS</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Registration number(s) of vehicle(s) involved &amp; Vehicle Type</td>
                    <td>
                        <div><strong>Vehicle No:</strong> @(string.IsNullOrEmpty(Model.VehicleNo) ? "—" : Model.VehicleNo)</div>
                        <div><strong>Vehicle Type:</strong> @(string.IsNullOrEmpty(Model.VehicleType) ? "Corporation" : Model.VehicleType)</div>
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Whether the NWKRTC vehicle is self-insured / insured with an insurance company; if yes details to be furnished</td>
                    <td>
                        @(Model.AdverseAward?.IsBusInsured == true 
                            ? "Insured with Insurance Company: " + (Model.AdverseAward.BusInsuranceDetails ?? "Details furnished in records") 
                            : "Self-Insured by Corporation")
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">Whether the deceased / injured was a passenger in the ST bus</td>
                    <td><strong>@(Model.IsSTPassenger ? "Yes" : "No")</strong></td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
                    <td class="fw-semibold">Manner of accident as stated in the claim petition</td>
                    <td>@(string.IsNullOrEmpty(Model.AdverseAward?.MannerOfAccident) ? "—" : Model.AdverseAward.MannerOfAccident)</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Manner of accident as per departmental records / RO report</td>
                    <td>@(string.IsNullOrEmpty(Model.AdverseAward?.MannerOfAccidentRO) ? "—" : Model.AdverseAward.MannerOfAccidentRO)</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">6</td>
                    <td class="fw-semibold">Whether one or more vehicles were involved; furnish details of other vehicles</td>
                    <td>
                        @if (Model.OppositeVehicleNumbers != null && Model.OppositeVehicleNumbers.Any())
                        {
                            <div><strong>Opposite Vehicle(s):</strong> @string.Join(", ", Model.OppositeVehicleNumbers)</div>
                        }
                        @if (Model.Respondents != null && Model.Respondents.Any())
                        {
                            <div class="mt-1">
                                <strong>Other Respondents:</strong>
                                @for (int r = 0; r < Model.Respondents.Count; r++)
                                {
                                    <div>@(r + 1)) @Model.Respondents[r].RespondentName @(!string.IsNullOrEmpty(Model.Respondents[r].Remarks) ? "— " + Model.Respondents[r].Remarks : "")</div>
                                }
                            </div>
                        }
                        @if ((Model.OppositeVehicleNumbers == null || !Model.OppositeVehicleNumbers.Any()) && (Model.Respondents == null || !Model.Respondents.Any()))
                        {
                            <span>Single Vehicle Involved (ST Bus)</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">7</td>
                    <td class="fw-semibold">Whether the deceased / injured was a pillion rider / inmate of another vehicle</td>
                    <td>@(Model.IsOppositeVehicleInmate ? "Yes" : "No")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- SECTION C – DEPARTMENTAL RECORDS, TR-18 AND ACTION AGAINST CREW -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION C – DEPARTMENTAL RECORDS, TR-18 AND ACTION AGAINST CREW</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Whether the name of the deceased / injured is recorded in TR-18</td>
                    <td>@(Model.AdverseAward?.IsDeceasedInTR18 == true ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Remarks / findings of Unit Head on TR-18</td>
                    <td>@(string.IsNullOrEmpty(Model.AdverseAward?.TR18Remarks) ? "—" : Model.AdverseAward.TR18Remarks)</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">Whether complete accident records, RO report and TR-18 are enclosed</td>
                    <td>@(!string.IsNullOrEmpty(Model.AdverseAward?.TR18UploadPath) ? "Yes, Enclosed" : "Accident Records on File")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
                    <td class="fw-semibold">Whether FIR is registered against the ST driver; furnish crime number</td>
                    <td>@(Model.AdverseAward?.IsFIRFiled == true ? "Yes, FIR Registered against ST Driver" : "No FIR registered against ST Driver")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Whether charge sheet is filed against the ST driver; furnish details</td>
                    <td>@(Model.AdverseAward?.IsChargeSheetFiled == true ? "Yes, Chargesheet filed against ST Driver" : "No")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">6</td>
                    <td class="fw-semibold">Whether departmental enquiry is initiated / pending / concluded</td>
                    <td>@(string.IsNullOrEmpty(Model.AdverseAward?.DriverPunishmentStatus) ? "—" : Model.AdverseAward.DriverPunishmentStatus)</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">7</td>
                    <td class="fw-semibold">Punishment imposed by Disciplinary Authority, if any; mention whether DE is pending</td>
                    <td>
                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.PunishmentRemarks))
                        {
                            <div>@Model.AdverseAward.PunishmentRemarks</div>
                        }
                        else
                        {
                            <div>@(string.IsNullOrEmpty(Model.AdverseAward?.DriverPunishmentStatus) ? "—" : Model.AdverseAward.DriverPunishmentStatus)</div>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">8</td>
                    <td class="fw-semibold">Details of action taken against driver / conductor, if any</td>
                    <td>@(string.IsNullOrEmpty(Model.AdverseAward?.PunishmentRemarks) ? (Model.AdverseAward?.DriverPunishmentStatus ?? "—") : Model.AdverseAward.PunishmentRemarks)</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">9</td>
                    <td class="fw-semibold">Whether security investigation was conducted; state findings (genuine / false / inconclusive)</td>
                    <td>
                        @(Model.AdverseAward?.SecurityRequired == true 
                            ? "Conducted (" + (Model.AdverseAward?.IsEvidenceBasedOnSecurityReport == true ? "Genuine / Evidence Adduced" : "Completed") + ")" 
                            : "Not Conducted / Not Required")
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">10</td>
                    <td class="fw-semibold">If accident is disputed / alleged, whether security investigation is conducted; if not, reasons</td>
                    <td>
                        @(Model.AdverseAward?.IsAllegedAccident == true || Model.IsAllegedAccident 
                            ? "Alleged Accident — Investigation: " + (Model.AdverseAward?.SecurityRequired == true ? "Conducted" : "Pending/Not Conducted") 
                            : "Regular Accident (Not Disputed / Disputed: No)")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- SECTION D – CLAIM PETITION, LIMITATION AND PLEADINGS -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION D – CLAIM PETITION, LIMITATION AND PLEADINGS</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Amount claimed</td>
                    <td><strong>Rs. @(Model.ClaimAmount?.ToString("N2") ?? "0.00")</strong></td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Whether claim petition was filed within the period of limitation</td>
                    <td>@(Model.IsWithinLimitation ? "Yes, within limitation" : "No, delayed") @(!string.IsNullOrEmpty(Model.LimitationRemark) ? " (" + Model.LimitationRemark + ")" : "")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">If delayed, whether application for condonation of delay was filed; enclose IA</td>
                    <td>@(Model.AdverseAward?.IsDelayApplicationFiled == true ? "Yes, Delay Application (IA) Filed" : "No / Not Applicable")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
                    <td class="fw-semibold">Whether delay was condoned; enclose certified copy of relevant order</td>
                    <td>@(Model.AdverseAward?.IsDelayCondonedAdverse == true || Model.IsDelayCondoned == true ? "Yes, Delay Condoned by Tribunal" : "No / Not Applicable")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Whether statement of objections / written statement was filed; if not, state reasons</td>
                    <td>@(Model.AdverseAward?.ObjectionFiled == true || Model.IsObjectionFiled ? "Filed" + (!string.IsNullOrEmpty(Model.AdverseAward?.ObjectionRemarks) ? " — " + Model.AdverseAward.ObjectionRemarks : "") : "Not Filed")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">6</td>
                    <td class="fw-semibold">Whether impleading application was required / filed (particularly where multiple vehicles are involved); if not, state reasons</td>
                    <td>
                        @(Model.AdverseAward?.IsImpleadingAppFiled == true 
                            ? "Yes, Impleading Application Filed" 
                            : "No" + (!string.IsNullOrEmpty(Model.AdverseAward?.ImpleadingAppNotFiledReason) ? " — " + Model.AdverseAward.ImpleadingAppNotFiledReason : ""))
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">7</td>
                    <td class="fw-semibold">Whether any double / parallel claim petition is filed before this or another MACT; details and action taken</td>
                    <td>@(Model.DoubleClaimFlag ? "Yes, Double Claim — " + (Model.AdverseAward?.DoubleClaimDetails ?? "Recorded in Connected Cases") : "No")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- SECTION E – EVIDENCE AND TRIAL PROCEEDINGS -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION E – EVIDENCE AND TRIAL PROCEEDINGS</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Evidence adduced by claimant(s) / petitioner(s), including witnesses examined and exhibits marked</td>
                    <td>
                        @if (Model.AdverseAward?.PetitionerPWNames != null && Model.AdverseAward.PetitionerPWNames.Any())
                        {
                            @string.Join(", ", Model.AdverseAward.PetitionerPWNames.Select((pw, idx) => $"PW {idx + 1} - {pw}"))
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Whether ST driver was examined; if not, state reasons</td>
                    <td>
                        @if (Model.AdverseAward?.RWNames != null && Model.AdverseAward.RWNames.Any())
                        {
                            @string.Join(", ", Model.AdverseAward.RWNames.Select((rw, idx) => $"RW {idx + 1} - {rw}"))
                        }
                        else
                        {
                            <span>Driver Not Examined</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">Whether conductor / other departmental witnesses were examined; furnish details</td>
                    <td>
                        @if (Model.CorpEvidence != null && Model.CorpEvidence.Any())
                        {
                            @string.Join("; ", Model.CorpEvidence.Select(c => $"{c.Name} ({c.Designation})"))
                        }
                        else
                        {
                            <span>@(Model.AdverseAward?.HasRWEvidence == true ? "Examined as per RW records" : "No other departmental witnesses examined")</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
                    <td class="fw-semibold">Injury cases: whether doctor was examined; name, qualification and whether treating doctor</td>
                    <td>
                        @if (Model.AdverseAward?.Doctors != null && Model.AdverseAward.Doctors.Any())
                        {
                            @string.Join("; ", Model.AdverseAward.Doctors.Select(d => $"{d.DoctorName} (Treating Doctor: {(d.IsTreated ? "Yes" : "No")})"))
                        }
                        else
                        {
                            <span>No Doctor Examined / Not Applicable</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">5</td>
                    <td class="fw-semibold">Whether age proof of deceased / injured is obtained; specify document and age established</td>
                    <td>
                        @(Model.AdverseAward?.VictimAge != null 
                            ? $"Established Age: {Model.AdverseAward.VictimAge} Years" + (!string.IsNullOrEmpty(Model.AdverseAward.AgeProofUploadPath) ? " (Proof Enclosed)" : "") 
                            : "—")
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">6</td>
                    <td class="fw-semibold">Whether bus cameras were installed in the ST bus</td>
                    <td>@(Model.AdverseAward?.IsBusCameraInstalled == true ? "Yes, Camera Installed" : "No")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">7</td>
                    <td class="fw-semibold">If cameras were installed, whether footage was preserved and produced before Tribunal; if not, reasons</td>
                    <td>@(Model.AdverseAward?.IsCameraFootageProduced == true ? "Yes, Footage Produced" : "No / Not Produced")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">8</td>
                    <td class="fw-semibold">Whether photographs of accident / vehicle / injuries are produced before Tribunal; if not, reasons</td>
                    <td>
                        @(Model.AdverseAward?.IsPhotographProduced == true 
                            ? "Yes, Produced" 
                            : "No" + (!string.IsNullOrEmpty(Model.AdverseAward?.PhotographNotProducedReason) ? " — " + Model.AdverseAward.PhotographNotProducedReason : ""))
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">9</td>
                    <td class="fw-semibold">Whether police sketch is produced before Tribunal; mention exhibit number</td>
                    <td>
                        @(Model.AdverseAward?.IsPoliceSketchEnclosed == true 
                            ? "Yes, Produced" + (!string.IsNullOrEmpty(Model.AdverseAward?.PoliceSketchExhibitNo) ? " (Exhibit No: " + Model.AdverseAward.PoliceSketchExhibitNo + ")" : "") 
                            : "No")
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">10</td>
                    <td class="fw-semibold">If sketch is not produced, whether copy is available with Division; if no sketch was drawn, state so</td>
                    <td>@(!string.IsNullOrEmpty(Model.AdverseAward?.PoliceSketchExhibitNo) ? "Exhibit marked as " + Model.AdverseAward.PoliceSketchExhibitNo : "Available in Division Records")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">11</td>
                    <td class="fw-semibold">Any other material evidence / admissions / contradictions relevant to the case</td>
                    <td>@(string.IsNullOrEmpty(Model.AdverseAward?.CertifiedCopyRemarks) ? (Model.DisposalRemarks ?? "—") : Model.AdverseAward.CertifiedCopyRemarks)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- SECTION F – FINDINGS ON NEGLIGENCE AND CORPORATION LIABILITY -->
    <div class="print-section mb-3">
        <table class="table-report">
            <colgroup>
                <col style="width: 7%;" />
                <col style="width: 45%;" />
                <col style="width: 48%;" />
            </colgroup>
            <thead>
                <tr class="report-section-header">
                    <th colspan="3" class="text-center py-1">SECTION F – FINDINGS ON NEGLIGENCE AND CORPORATION LIABILITY</th>
                </tr>
                <tr class="report-sub-header text-center">
                    <th>Sl. No.</th>
                    <th>Particulars</th>
                    <th>Details / Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-bold">1</td>
                    <td class="fw-semibold">Finding of MACT on rashness and negligence</td>
                    <td>@(string.IsNullOrEmpty(Model.DisposalRemarks) ? "Negligence fastened as per MACT Judgment & Award" : Model.DisposalRemarks)</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">2</td>
                    <td class="fw-semibold">Whether negligence is attributed wholly or partly to the ST driver / Corporation</td>
                    <td>
                        @(Model.AdverseAward?.IsCorpLiable == true 
                            ? (Model.AdverseAward?.LiabilityPercentage < 100 
                                ? $"Partly ({Model.AdverseAward?.LiabilityPercentage}%)" 
                                : "Wholly (100% on ST Driver / Corporation)") 
                            : "Not Corp Liable")
                    </td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">3</td>
                    <td class="fw-semibold">Percentage of liability fastened on NWKRTC, if apportioned</td>
                    <td><strong>@(Model.AdverseAward?.LiabilityPercentage != null ? Model.AdverseAward.LiabilityPercentage + "%" : "100%")</strong> @(Model.AdverseAward?.LiableAmount.HasValue == true ? $"(Rs. {Model.AdverseAward.LiableAmount.Value:N2})" : "")</td>
                </tr>
                <tr>
                    <td class="text-center fw-bold">4</td>
