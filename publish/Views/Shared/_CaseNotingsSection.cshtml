@model MVCCaseManagement.Models.CaseNotingViewModel
@using System.Security.Claims

@{
    var divIdStr = User.FindFirst("DivisionID")?.Value;
    var currentRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Officer";
    var currentRoleUpper = currentRole.ToUpperInvariant();

    bool isCentralOfficeUser = string.IsNullOrEmpty(divIdStr) || divIdStr == "0" || divIdStr == "5"
        || currentRoleUpper.Contains("MD") || currentRoleUpper.Contains("CLO") || currentRoleUpper.Contains("LO") 
        || currentRoleUpper.Contains("ADMIN") || currentRoleUpper.Contains("CENTRAL");

    // Strictly restrict noting features: Only Central Office & Legal Wing (LO, Dy CLO, CLO, MD, Admin) have access.
    // Division logins do not have noting features.
    if (!isCentralOfficeUser)
    {
        return;
    }

    var currentUsername = User.Identity?.Name ?? "User";
    var currentFullName = User.FindFirst("FullName")?.Value ?? currentUsername;
    var currentDivision = User.FindFirst("DivisionName")?.Value ?? "Central Office";

    var currentUsernameUpper = (User.Identity?.Name ?? "").Trim();
    bool isPrivilegedUser = currentRoleUpper.Contains("MD") || currentRoleUpper.Contains("CLO") || currentRoleUpper.Contains("ADMIN");

    string GetRoleBadgeClass(string? role)
    {
        if (string.IsNullOrEmpty(role)) return "bg-secondary text-white";
        var r = role.ToUpperInvariant();
        if (r.Contains("MD") || r.Contains("MANAGING DIRECTOR")) return "bg-success text-white";
        if (r.Contains("CLO") && !r.Contains("DY")) return "bg-primary text-white";
        if (r.Contains("DY")) return "bg-secondary text-white";
        if (r.Contains("LO") || r.Contains("LAW OFFICER")) return "bg-info text-dark";
        if (r.Contains("CENTRAL") || r.Contains("CO")) return "bg-dark text-white";
        return "bg-warning text-dark";
    }

    string GetCardBorderClass(string? role)
    {
        if (string.IsNullOrEmpty(role)) return "border-secondary";
        var r = role.ToUpperInvariant();
        if (r.Contains("MD") || r.Contains("MANAGING DIRECTOR")) return "border-success";
        if (r.Contains("CLO") && !r.Contains("DY")) return "border-primary";
        if (r.Contains("DY")) return "border-secondary";
        if (r.Contains("LO") || r.Contains("LAW OFFICER")) return "border-info";
        if (r.Contains("CENTRAL") || r.Contains("CO")) return "border-dark";
        return "border-warning";
    }
}

<!-- ===== CASE NOTING SHEET & PROCEDURAL REMARKS SECTION ===== -->
<div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-warning bg-white mt-4" id="caseNotingsSection">
    <!-- Header Banner (Clickable Toggle to Expand/Collapse) -->
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2"
         role="button"
         data-bs-toggle="collapse"
         data-bs-target="#caseNotingsCollapseBody"
         aria-expanded="false"
         aria-controls="caseNotingsCollapseBody"
         id="caseNotingsHeaderToggle"
         style="cursor: pointer; user-select: none; transition: background-color 0.15s ease;"
         onmouseover="this.style.backgroundColor='#fffcf5'"
         onmouseout="this.style.backgroundColor='#ffffff'"
         title="Click to expand/collapse Case Notings">
        <div class="d-flex align-items-center">
            <div class="p-2 bg-warning-subtle text-warning-emphasis rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="bi bi-journal-bookmark-fill fs-4 text-warning"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    Case Notings &amp; Procedural Observations
                    
                </h5>
                <small class="text-muted">Official procedural observations, directives &amp; legal notes recorded by Central Office, LO, Dy. CLO, CLO &amp; MD.</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-2 fw-bold" id="notingCountBadge">
                <i class="bi bi-chat-left-dots-fill me-1"></i> @Model.Notings.Count Noting Point@(Model.Notings.Count == 1 ? "" : "s")
            </span>
            <span class="btn btn-sm btn-outline-warning text-dark border-warning-subtle rounded-pill px-3 py-1 fw-bold d-inline-flex align-items-center gap-1 shadow-2xs"
                  id="btnToggleNotingsCollapse"
                  style="pointer-events: none;">
                <span id="notingsToggleText">Click to Open</span>
                <i class="bi bi-chevron-down transition-transform ms-1" id="notingsChevronIcon" style="transition: transform 0.25s ease;"></i>
            </span>
        </div>
    </div>

    <!-- Collapsible Section Body (Hidden by default, opens only when clicked) -->
    <div class="collapse" id="caseNotingsCollapseBody">
        <div class="card-body p-4" style="background: #fafbfe;">

        <!-- NOTINGS FEED / LIST -->
        <div id="caseNotingsList" class="d-flex flex-column gap-3 mb-4">
            @if (Model.Notings == null || !Model.Notings.Any())
            {
                <div class="p-4 text-center text-muted bg-white rounded-3 border border-dashed" id="noNotingsAlert">
                    <i class="bi bi-journal-text display-6 text-muted opacity-50 d-block mb-2"></i>
                    <div class="fw-bold">No case notings recorded yet.</div>
                    <small class="text-muted">Authorized officers from Central Office, LO, Dy. CLO, CLO, or MD can write the first noting point below.</small>
                </div>
            }
            else
            {
                int index = 1;
                foreach (var item in Model.Notings)
                {
                    bool canDelete = isPrivilegedUser || item.CreatedByUsername.Equals(currentUsernameUpper, StringComparison.OrdinalIgnoreCase);
                    <div class="card border-0 shadow-2xs rounded-3 overflow-hidden border-start border-4 @GetCardBorderClass(item.CreatedByRole) bg-white noting-item-card" id="noting-item-@item.NotingID">
                        <div class="card-body p-3 p-md-4">
                            <!-- Point Header -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-dark border px-2 py-1 font-monospace fw-bold noting-point-number" style="font-size: 0.72rem;">
                                    <i class="bi bi-pin-angle-fill text-warning me-1"></i> Noting Point #@index
                                </span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @GetRoleBadgeClass(item.CreatedByRole) rounded-pill px-3 py-1 fw-bold" style="font-size: 0.72rem;">
                                        @(string.IsNullOrEmpty(item.CreatedByRole) ? "Officer" : item.CreatedByRole)
                                    </span>
                                    @if (canDelete)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger border-0 p-1 px-2 rounded-pill d-inline-flex align-items-center gap-1 shadow-2xs" 
                                                style="font-size: 0.72rem;"
                                                title="Delete this noting point"
                                                onclick="deleteCaseNoting('@Model.CaseType', @item.NotingID, @Model.CaseID)">
                                            <i class="bi bi-trash3-fill"></i> <span class="d-none d-sm-inline">Delete</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Noting Content -->
                            <div class="text-dark fs-6 mb-3 px-1" style="white-space: pre-line; line-height: 1.6; word-break: break-word;">
                                @item.NotingText
                            </div>

                            <!-- User Details Strip (Strictly BELOW the noting as requested) -->
                            <div class="pt-2 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 text-muted" style="font-size: 0.78rem;">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="fw-bold text-dark font-monospace bg-light px-2 py-1 rounded border">
                                        <i class="bi bi-person-circle text-primary me-1"></i>@@@item.CreatedByUsername
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.CreatedByName) && !item.CreatedByName.Equals(item.CreatedByUsername, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="text-secondary fw-semibold">(@item.CreatedByName)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CreatedByDivision))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <i class="bi bi-geo-alt me-1"></i>@item.CreatedByDivision
                                        </span>
                                    }
                                </div>
                                <div class="text-muted small">
                                    <i class="bi bi-clock-history me-1 text-primary"></i>@item.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>
                        </div>
                    </div>
                    index++;
                }
            }
        </div>

        <!-- NEW NOTING INPUT SECTION (In same view section at bottom) -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white border">
            <div class="card-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark small">
                    <i class="bi bi-pencil-square text-primary me-1"></i> Add New Point of Noting
                </span>
                <span class="text-muted extra-small" style="font-size: 0.74rem;">
                    Posting as: <strong class="text-primary font-monospace">@@@currentUsername</strong>
                    <span class="badge @GetRoleBadgeClass(currentRole) ms-1" style="font-size: 0.65rem;">@currentRole</span>
                    @if (!string.IsNullOrEmpty(currentDivision))
                    {
                        <span class="badge bg-light text-muted border ms-1" style="font-size: 0.65rem;">@currentDivision</span>
                    }
                </span>
            </div>
            <div class="card-body p-3">
                <div class="mb-2">
                    <textarea id="txtCaseNotingInput" 
                              class="form-control" 
                              rows="3" 
                              maxlength="4000"
                              placeholder="Type case observations, ongoing procedural notes, directions or legal instructions here..."></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-1">
                    <small class="text-muted" style="font-size: 0.72rem;">
                        <i class="bi bi-shield-check text-success me-1"></i> Recorded under your account and visible to all authorized officers.
                    </small>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="document.getElementById('txtCaseNotingInput').value = '';">
                            Clear
                        </button>
                        <button type="button" 
                                class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center" 
                                id="btnSubmitNoting"
                                onclick="submitCaseNoting('@Model.CaseType', @Model.CaseID)">
                            <i class="bi bi-send-fill me-2"></i> Save Case Noting
                        </button>
                    </div>
                </div>
            </div>
        </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var collapseEl = document.getElementById('caseNotingsCollapseBody');
        var toggleText = document.getElementById('notingsToggleText');
        var chevronIcon = document.getElementById('notingsChevronIcon');

        if (collapseEl) {
            collapseEl.addEventListener('show.bs.collapse', function () {
                if (toggleText) toggleText.textContent = 'Hide Section';
                if (chevronIcon) chevronIcon.style.transform = 'rotate(180deg)';
            });

            collapseEl.addEventListener('hide.bs.collapse', function () {
                if (toggleText) toggleText.textContent = 'Click to Open';
                if (chevronIcon) chevronIcon.style.transform = 'rotate(0deg)';
            });
        }
    });

    function submitCaseNoting(caseType, caseId) {
        var inputEl = document.getElementById('txtCaseNotingInput');
        if (!inputEl) return;
        var text = inputEl.value.trim();

        if (!text) {
            alert('Please enter noting text before submitting.');
            inputEl.focus();
            return;
        }

        var btn = document.getElementById('btnSubmitNoting');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
        }

        var endpoint = caseType.toUpperCase() === 'MVC' ? '/Case/AddCaseNoting' : '/Labour/AddCaseNoting';

        var payload = {
            CaseType: caseType,
            CaseID: caseId,
            NotingText: text
        };

        fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res && res.success && res.noting) {
                // Clear input
                inputEl.value = '';

                // Ensure collapsible body is expanded so the user sees their new noting
                var collapseEl = document.getElementById('caseNotingsCollapseBody');
                if (collapseEl && !collapseEl.classList.contains('show')) {
                    if (typeof bootstrap !== 'undefined' && bootstrap.Collapse) {
                        bootstrap.Collapse.getOrCreateInstance(collapseEl).show();
                    } else {
                        collapseEl.classList.add('show');
                    }
                }

                // Remove placeholder if present
                var placeholder = document.getElementById('noNotingsAlert');
                if (placeholder) placeholder.remove();

                // Build new item card
                var feed = document.getElementById('caseNotingsList');
                var currentItems = feed.querySelectorAll('.card').length + 1;

                var roleBadgeClass = 'bg-secondary text-white';
                var r = (res.noting.createdByRole || '').toUpperCase();
                if (r.indexOf('MD') !== -1) roleBadgeClass = 'bg-success text-white';
                else if (r.indexOf('CLO') !== -1 && r.indexOf('DY') === -1) roleBadgeClass = 'bg-primary text-white';
                else if (r.indexOf('DY') !== -1) roleBadgeClass = 'bg-secondary text-white';
                else if (r.indexOf('LO') !== -1) roleBadgeClass = 'bg-info text-dark';
                else if (r.indexOf('CENTRAL') !== -1 || r.indexOf('CO') !== -1) roleBadgeClass = 'bg-dark text-white';
                else roleBadgeClass = 'bg-warning text-dark';

                var borderClass = 'border-primary';
                if (r.indexOf('MD') !== -1) borderClass = 'border-success';
                else if (r.indexOf('DY') !== -1) borderClass = 'border-secondary';
                else if (r.indexOf('LO') !== -1) borderClass = 'border-info';
                else if (r.indexOf('CENTRAL') !== -1 || r.indexOf('CO') !== -1) borderClass = 'border-dark';
                else if (r.indexOf('DIV') !== -1) borderClass = 'border-warning';

                var itemCard = document.createElement('div');
                itemCard.id = 'noting-item-' + res.noting.notingID;
                itemCard.className = 'card border-0 shadow-2xs rounded-3 overflow-hidden border-start border-4 ' + borderClass + ' bg-white animate-fade-in noting-item-card';
                
                var escapeHtml = function(s) {
                    if (!s) return '';
                    var d = document.createElement('div');
                    d.textContent = s;
                    return d.innerHTML;
                };

                var safeText = escapeHtml(res.noting.notingText).replace(/\n/g, '<br/>');
                var safeUsername = escapeHtml(res.noting.createdByUsername);
                var safeName = escapeHtml(res.noting.createdByName);
                var safeRole = escapeHtml(res.noting.createdByRole || 'Officer');
                var safeDiv = escapeHtml(res.noting.createdByDivision);
                var dateStr = res.formattedDate || 'Just now';

                itemCard.innerHTML = 
                    '<div class="card-body p-3 p-md-4">' +
                        '<div class="d-flex justify-content-between align-items-center mb-2">' +
                            '<span class="badge bg-light text-dark border px-2 py-1 font-monospace fw-bold noting-point-number" style="font-size: 0.72rem;">' +
                                '<i class="bi bi-pin-angle-fill text-warning me-1"></i> Noting Point #' + currentItems +
                            '</span>' +
                            '<div class="d-flex align-items-center gap-2">' +
                                '<span class="badge ' + roleBadgeClass + ' rounded-pill px-3 py-1 fw-bold" style="font-size: 0.72rem;">' +
                                    safeRole +
                                '</span>' +
                                '<button type="button" class="btn btn-sm btn-outline-danger border-0 p-1 px-2 rounded-pill d-inline-flex align-items-center gap-1 shadow-2xs" style="font-size: 0.72rem;" title="Delete this noting point" onclick="deleteCaseNoting(\'' + caseType + '\', ' + res.noting.notingID + ', ' + caseId + ')">' +
                                    '<i class="bi bi-trash3-fill"></i> <span class="d-none d-sm-inline">Delete</span>' +
                                '</button>' +
                            '</div>' +
                        '</div>' +
                        '<div class="text-dark fs-6 mb-3 px-1" style="white-space: pre-line; line-height: 1.6; word-break: break-word;">' +
                            safeText +
                        '</div>' +
                        '<div class="pt-2 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 text-muted" style="font-size: 0.78rem;">' +
                            '<div class="d-flex align-items-center gap-2 flex-wrap">' +
                                '<span class="fw-bold text-dark font-monospace bg-light px-2 py-1 rounded border">' +
                                    '<i class="bi bi-person-circle text-primary me-1"></i>@@' + safeUsername +
                                '</span>' +
                                (safeName && safeName !== safeUsername ? '<span class="text-secondary fw-semibold">(' + safeName + ')</span>' : '') +
                                (safeDiv ? '<span class="badge bg-secondary-subtle text-secondary border"><i class="bi bi-geo-alt me-1"></i>' + safeDiv + '</span>' : '') +
                            '</div>' +
                            '<div class="text-muted small">' +
                                '<i class="bi bi-clock-history me-1 text-primary"></i>' + dateStr +
                            '</div>' +
                        '</div>' +
                    '</div>';

                feed.appendChild(itemCard);

                // Update count badge
                var badge = document.getElementById('notingCountBadge');
                if (badge) {
                    badge.innerHTML = '<i class="bi bi-chat-left-dots-fill me-1"></i> ' + currentItems + ' Noting Point' + (currentItems === 1 ? '' : 's');
                }

                // Smooth scroll to new noting
                itemCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                alert(res && res.message ? res.message : 'Failed to save case noting.');
            }
        })
        .catch(function(err) {
            console.error('Error submitting noting:', err);
            alert('A network error occurred while submitting the noting.');
        })
        .finally(function() {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-fill me-2"></i> Save Case Noting';
            }
        });
    }

    function deleteCaseNoting(caseType, notingId, caseId) {
        if (!confirm('Are you sure you want to delete this noting point?')) {
            return;
        }

        var endpoint = caseType.toUpperCase() === 'MVC' ? '/Case/DeleteCaseNoting' : '/Labour/DeleteCaseNoting';

        var payload = {
            NotingID: notingId,
            CaseType: caseType,
            CaseID: caseId
        };

        fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res && res.success) {
                var itemEl = document.getElementById('noting-item-' + notingId);
                if (itemEl) {
                    itemEl.style.transition = 'all 0.3s ease';
                    itemEl.style.opacity = '0';
                    itemEl.style.transform = 'scale(0.95)';
                    setTimeout(function () {
                        itemEl.remove();

                        var feed = document.getElementById('caseNotingsList');
                        var remainingCards = feed ? feed.querySelectorAll('.noting-item-card') : [];
                        var count = remainingCards.length;

                        // Update count badge
                        var badge = document.getElementById('notingCountBadge');
                        if (badge) {
                            badge.innerHTML = '<i class="bi bi-chat-left-dots-fill me-1"></i> ' + count + ' Noting Point' + (count === 1 ? '' : 's');
                        }

                        // Re-number remaining badges
                        remainingCards.forEach(function (card, idx) {
                            var numBadge = card.querySelector('.noting-point-number');
                            if (numBadge) {
                                numBadge.innerHTML = '<i class="bi bi-pin-angle-fill text-warning me-1"></i> Noting Point #' + (idx + 1);
                            }
                        });

                        // Show placeholder if empty
                        if (count === 0 && feed) {
                            feed.innerHTML =
                                '<div class="p-4 text-center text-muted bg-white rounded-3 border border-dashed" id="noNotingsAlert">' +
                                    '<i class="bi bi-journal-text display-6 text-muted opacity-50 d-block mb-2"></i>' +
                                    '<div class="fw-bold">No case notings recorded yet.</div>' +
                                    '<small class="text-muted">Authorized officers from Division, Central Office, LO, Dy. CLO, CLO, or MD can write the first noting point below.</small>' +
                                '</div>';
                        }
                    }, 300);
                }
            } else {
                alert(res && res.message ? res.message : 'Failed to delete noting.');
            }
        })
        .catch(function (err) {
            console.error('Error deleting noting:', err);
            alert('A network error occurred while deleting the noting.');
        });
    }
</script>
