@model MVCCaseManagement.Models.ArisingApplication
@using Microsoft.AspNetCore.Html

@functions {
    string? Row(string label, string? val)
    {
        if (string.IsNullOrWhiteSpace(val) || val == "-") return null;
        if (val.Length > 60)
        {
            return $@"<div class='lcp-row lcp-row--full'>
                <span class='lcp-label'>{label}</span>
                <div class='lcp-value lcp-value--block white-space-pre-line'>{val}</div>
            </div>";
        }
        return $@"<div class='lcp-row'>
            <span class='lcp-label'>{label}</span>
            <span class='lcp-value'>{val}</span>
        </div>";
    }

    IHtmlContent Card(string title, string icon, IEnumerable<string?> rows, string colClass = "col-lg-6 col-md-12 mb-3")
    {
        var validRows = rows.Where(r => !string.IsNullOrEmpty(r)).ToList();
        if (!validRows.Any()) return HtmlString.Empty;
        var content = string.Join("", validRows);
        return new HtmlString($@"<div class='{colClass}'>
            <div class='lcp-card h-100'>
                <div class='lcp-card-header'>
                    <span class='lcp-card-icon'><i class='bi bi-{icon}'></i></span>
                    <span class='lcp-card-title'>{title}</span>
                </div>
                <div class='lcp-card-body'>
                    {content}
                </div>
            </div>
        </div>");
    }

    string? D(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;
    string? DB(bool? v) => v == true ? "Yes" : (v == false ? "No" : null);
    string? DD(DateTime? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy") : null;
    bool HasD(params string?[] values) => values.Any(v => !string.IsNullOrWhiteSpace(v));
}

@{
    LabourCase? pCase = (ViewBag.ParentCase as LabourCase) ?? (ViewBag.LinkedParentCase as LabourCase);

    bool hasAppeals = !string.IsNullOrWhiteSpace(Model.CO_WP_CaseNumber) 
                   || !string.IsNullOrWhiteSpace(Model.CO_WA_CaseNumber)
                   || Model.CO_IsWorkmanReinstated 
                   || !string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_CaseNumber)
                   || (pCase != null && (!string.IsNullOrWhiteSpace(pCase.CO_WP_CaseNumber) || !string.IsNullOrWhiteSpace(pCase.CO_WA_CaseNumber)));

    bool hasDocs = !string.IsNullOrEmpty(Model.JudgmentCopyPath)
                || !string.IsNullOrEmpty(Model.DE_HistorySheetPath)
                || !string.IsNullOrEmpty(Model.LokAdalatDocumentPath)
                || !string.IsNullOrEmpty(Model.CO_WP_JudgmentCopyPath)
                || !string.IsNullOrEmpty(Model.CO_WP_StayOrderPath)
                || !string.IsNullOrEmpty(Model.CO_WA_StayOrderPath)
                || !string.IsNullOrEmpty(Model.CO_ClosedDocumentPath)
                || !string.IsNullOrEmpty(Model.CO_Reinstatement_ApprovalCopyPath);

    var tabs = new List<(string Id, string Label, string Icon)> {
        ("tab-arising-overview", "Overview", "info-circle-fill"),
        ("tab-arising-progress", "Progress & DE", "journal-text"),
        ("tab-arising-disposal", "Disposal & Awards", "award-fill")
    };

    if (hasAppeals)
    {
        tabs.Add(("tab-arising-appeals", "Appeals (WP/WA/SLP)", "diagram-3-fill"));
    }

    tabs.Add(("tab-arising-opinions", "Legal Opinions & Decisions", "chat-square-quote-fill"));

    if (hasDocs)
    {
        tabs.Add(("tab-arising-docs", "Documents", "paperclip"));
    }
}

<style>
    /* ===== Arising Application Details Partial — Unified Grid & Aligned Sections ===== */
    .lcp-wrapper {
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        background: #f8fafd;
        min-height: 60vh;
    }

    /* ---------- Tab Navigation ---------- */
    .lcp-tabs {
        display: flex;
        gap: 4px;
        padding: 12px 16px 0;
        background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);
        border-radius: 0;
        overflow-x: auto;
        scrollbar-width: thin;
    }
    .lcp-tabs::-webkit-scrollbar { height: 3px; }
    .lcp-tabs::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.3); border-radius: 3px; }

    .lcp-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255,255,255,0.75);
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.15);
        border-bottom: none;
        border-radius: 8px 8px 0 0;
        cursor: pointer;
        transition: all 0.18s ease;
        white-space: nowrap;
        letter-spacing: 0.02em;
    }
    .lcp-tab-btn:hover {
        background: rgba(255,255,255,0.2);
        color: #ffffff;
    }
    .lcp-tab-btn.active {
        background: #f8fafd;
        color: #1e3a8a;
        border-color: #e2e8f0;
        border-bottom-color: #f8fafd;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.08);
    }

    /* ---------- Tab Content ---------- */
    .lcp-content {
        padding: 20px 16px;
        background: #f8fafd;
    }
    .lcp-pane { display: none; }
    .lcp-pane.active { display: block; animation: lcpFadeIn 0.2s ease; }
    @@keyframes lcpFadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    /* ---------- Cards ---------- */
    .lcp-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        transition: box-shadow 0.18s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .lcp-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

    .lcp-card-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: linear-gradient(90deg, #f0f4ff, #f8fafd);
        border-bottom: 1px solid #e2e8f0;
        flex-shrink: 0;
    }
    .lcp-card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px; height: 26px;
        border-radius: 6px;
        background: #dbeafe;
        color: #1d4ed8;
        font-size: 0.8rem;
        flex-shrink: 0;
    }
    .lcp-card-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #1e3a8a;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .lcp-card-body {
        padding: 4px 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    /* ---------- Rows (Strict 42% / 58% Grid Alignment) ---------- */
    .lcp-row {
        display: grid;
        grid-template-columns: 42% 1fr;
        align-items: baseline;
        gap: 8px;
        padding: 7px 14px;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.12s;
    }
    .lcp-row:last-child { border-bottom: none; }
    .lcp-row:hover { background: #f8fafd; }

    .lcp-row--full {
        grid-template-columns: 1fr;
        gap: 4px;
        background: #f8fafd;
        padding: 8px 14px;
        flex: 1 1 auto;
    }

    .lcp-label {
        font-size: 0.74rem;
        color: #64748b;
        font-weight: 600;
        letter-spacing: 0.01em;
    }
    .lcp-value {
        font-size: 0.82rem;
        font-weight: 600;
        color: #1e293b;
        word-break: break-word;
    }
    .lcp-value--block {
        font-size: 0.8rem;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 8px 10px;
        color: #374151;
        font-weight: 500;
        min-height: 52px;
        display: flex;
        align-items: center;
    }
    .white-space-pre-line { white-space: pre-line; }

    /* ---------- Document Pill Links ---------- */
    .lcp-doc-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        border-bottom: 1px solid #f1f5f9;
        text-decoration: none;
        transition: background 0.15s;
    }
    .lcp-doc-item:last-child { border-bottom: none; }
    .lcp-doc-item:hover { background: #f1f5f9; }
</style>

<div class="lcp-wrapper">

    <!-- ===== Top KPI Summary Strip ===== -->
    <div class="p-3 bg-white border-bottom shadow-2xs">
        <div class="row g-2">
            <div class="col-md-3">
                <div class="p-2 rounded bg-light border h-100">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:0.65rem;">Application Status</small>
                    <div class="fw-bold @(Model.CaseStatus == "Disposed" ? "text-success" : "text-warning")" style="font-size:0.85rem;">
                        @(Model.CaseStatus ?? "Pending")
                        @if (Model.DisposalDate.HasValue) { <span class="text-muted fw-normal">(@Model.DisposalDate.Value.ToString("dd-MM-yyyy"))</span> }
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-2 rounded bg-light border h-100">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:0.65rem;">Outcome / Result</small>
                    <div class="fw-bold @(Model.DisposalResult == "Against" ? "text-danger" : "text-dark")" style="font-size:0.85rem;">
                        @(!string.IsNullOrEmpty(Model.DisposalResult) ? Model.DisposalResult : "Pending Result")
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-2 rounded bg-light border h-100">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:0.65rem;">Assigned Advocate</small>
                    <div class="fw-bold text-truncate text-primary" style="font-size:0.85rem;" title="@Model.AdvocateName">
                        @(Model.AdvocateName ?? "Not Assigned")
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-2 rounded bg-light border h-100">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:0.65rem;">Current Stage</small>
                    <div class="fw-bold text-truncate text-dark" style="font-size:0.85rem;" title="@Model.CurrentStage">
                        @(Model.CurrentStage ?? "Initial")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Tab Bar ===== -->
    <div class="lcp-tabs" role="tablist">
        @foreach (var (id, label, icon) in tabs)
        {
            <button class="lcp-tab-btn @(id == "tab-arising-overview" ? "active" : "")"
                    data-lcp-tab="@id" role="tab" aria-selected="@(id == "tab-arising-overview" ? "true" : "false")">
                <i class="bi bi-@icon"></i> @label
            </button>
        }
    </div>

    <!-- ===== Tab Content ===== -->
    <div class="lcp-content">

        <!-- ── 1. Overview Tab ── -->
        <div class="lcp-pane active" id="tab-arising-overview">
            <div class="row g-3">
                @Card("Case Registration Details", "info-circle-fill", new[] {
                    Row("Case Number / Year", $"{Model.CaseNumber} / {Model.CaseYear}"),
                    Row("Case Type", D(Model.CaseType)),
                    Row("Court Name", D(Model.CourtName)),
                    Model.CourtID == 0 ? Row("Other Court Details", D(Model.OtherCourtDetails)) : null,
                    Row("Division", D(Model.DivisionName)),
                    Row("Petitioner Name", D(Model.PetitionerName)),
                    Row("CNR Number", D(Model.CNRNumber)),
                    Row("Current Stage", D(Model.CurrentStage))
                })

                @Card("Workman & Service Profile", "person-badge-fill", new[] {
                    Row("Badge / Employee No", D(Model.EmployeeNo)),
                    Row("PF Number", D(Model.PFNumber)),
                    Row("Designation", D(Model.Designation)),
                    Row("Working Status", D(Model.WorkingStatus)),
                    Model.WorkingStatus == "Death" ? Row("LRs / Petitioner Name", D(Model.LegalRepresentativeName)) : null,
                    Row("LR Relationship", D(Model.LRRelationship)),
                    Row("Is Workman", DB(Model.IsWorkman)),
                    Row("Workman Remark", D(Model.IsWorkmanRemark)),
                    Row("Nature of Misconduct", D(Model.NatureOfMisconduct)),
                    Row("Nature of Case", D(Model.NatureOfCase))
                })

                @Card("Linked Original / Primary Case", "link-45deg", new[] {
                    Row("Original Case No / Year", D($"{Model.Parent_CaseNumber} / {Model.Parent_CaseYear}")),
                    Row("Original Court", D(Model.Parent_CourtName)),
                    Row("Original Case Type", D(Model.Parent_CaseType)),
                    Row("Original Status", D(Model.Parent_CaseStatus)),
                    Row("Original Petitioner", D(Model.Parent_PetitionerName)),
                    pCase != null ? Row("Original Award Summary", D(pCase.AwardDetails ?? pCase.FavorRemark)) : null
                })

                @Card("Legal Entrustment", "briefcase-fill", new[] {
                    Row("Advocate Name", D(Model.AdvocateName)),
                    Row("Entrustment No", D(Model.EntrustmentNo)),
                    Row("Entrustment Date", DD(Model.EntrustmentDate))
                })
            </div>
        </div>

        <!-- ── 2. Progress & DE Tab ── -->
        <div class="lcp-pane" id="tab-arising-progress">
            <div class="row g-3">
                @Card("Case Progress & Milestones", "speedometer2", new[] {
                    Row("Claim Filed On", D(Model.ClaimFiledOn)),
                    Row("Delay In Filing", D(Model.DelayInFiling)),
                    Row("Document Sent to Adv", DB(Model.IsDocumentSent)),
                    Model.IsDocumentSent ? Row("Document Sent Outward", D($"{Model.DocumentSent_OutwardNo} (Dt: {DD(Model.DocumentSent_OutwardDate) ?? "-"})")) : null,
                    Row("Objection Filed", DB(Model.IsObjectionFiled)),
                    Model.IsObjectionFiled ? Row("Objection Outward", D($"{Model.ObjectionFiled_OutwardNo} (Dt: {DD(Model.ObjectionFiled_OutwardDate) ?? "-"})")) : null,
                    Row("Evidence Filed", DB(Model.IsEvidenceFiled)),
                    Row("Next Hearing Date", DD(Model.NextHearingDate))
                })

                @Card("Certified Copy Timelines", "clock-history", new[] {
                    Row("CC Case Disposed Date", DD(Model.CC_CaseDisposedDate)),
                    Row("CC Applied Date", DD(Model.CC_AppliedDate)),
                    Row("CC Issued Date", DD(Model.CC_IssuedDate)),
                    Row("CC Received Date", DD(Model.CC_ReceivedDate)),
                    Row("CC Publication Date", DD(Model.CC_PublicationDate)),
                    Row("CC Remarks", D(Model.CC_Remarks))
                })

                @Card("Departmental Enquiry (DE) Proceedings", "file-earmark-check-fill", new[] {
                    Row("History Sheet Uploaded", DB(Model.DE_HistorySheet)),
                    Row("DE Order", D(Model.DE_Order)),
                    Row("Objections Filed (DE)", DB(Model.DE_ObjectionsFiled)),
                    Model.DE_ObjectionsFiled ? Row("DE Objections Remark", D(Model.DE_ObjectionsRemark)) : null,
                    Row("Documents Marked (DE)", DB(Model.DE_DocumentsMarked)),
                    Model.DE_DocumentsMarked ? Row("DE Documents Remark", D(Model.DE_DocumentsRemark)) : null
                })

                @Card("Enquiry Officers & Witnesses", "people-fill", new[] {
                    Row("Enquiry Officer (EO)", D($"{Model.DE_EO_Name} ({Model.DE_EO_Designation})")),
                    Row("Reporter", D($"{Model.DE_Reporter_Name} ({Model.DE_Reporter_Designation})")),
                    Row("Other Witness", D($"{Model.DE_Other_Name} ({Model.DE_Other_Designation})"))
                })
            </div>
        </div>

        <!-- ── 3. Disposal & Awards Tab ── -->
        <div class="lcp-pane" id="tab-arising-disposal">
            <div class="row g-3">
                @Card("Disposal Particulars", "check-circle-fill", new[] {
                    Row("Disposal Mode", D(Model.DisposalMode)),
                    Row("Disposal Date", DD(Model.DisposalDate)),
                    Row("Disposal Result", D(Model.DisposalResult)),
                    Row("Favor Outward Date", DD(Model.FavorOutwardDate)),
                    Row("Favor Finding / Remarks", D(Model.FavorRemark))
                })

                @Card("Award & Claim Details", "cash-stack", new[] {
                    Row("Award Amount (₹)", Model.AwardAmount.HasValue ? Model.AwardAmount.Value.ToString("N2") : null),
                    Row("Award Details", D(Model.AwardDetails)),
                    Row("Claim Details", D(Model.ClaimDetails))
                })

                @Card("Advocate's Legal Opinion", "chat-left-quote-fill", new[] {
                    Row("Advocate's Opinion", D(Model.Opinion_Advocate))
                })

                @Card("Divisional Opinions & Remarks", "chat-right-quote-fill", new[] {
                    Row("DC's Opinion", D(Model.Opinion_DC)),
                    Row("General Remarks", D(Model.Remarks))
                })
            </div>
        </div>

        <!-- ── 4. Appeals (WP/WA/SLP) Tab ── -->
        @if (hasAppeals)
        {
            <div class="lcp-pane" id="tab-arising-appeals">
                <div class="row g-3">
                    @Card("Corporation High Court WP", "building", new[] {
                        Row("WP Number / Year", D($"{Model.CO_WP_CaseNumber} / {Model.CO_WP_Year}")),
                        Row("High Court Bench", D(Model.CO_WP_HighCourtBench)),
                        Row("High Court CNR", D(Model.CO_WP_CNRNumber)),
                        Row("Advocate Assigned", D(Model.CO_WP_AdvocateName)),
                        Row("Entrustment No / Date", D($"{Model.CO_WP_EntrustmentNo} (Dt: {DD(Model.CO_WP_EntrustmentDate) ?? "-"})")),
                        Row("Status / Stage", D(Model.CO_WP_Status ?? Model.CO_WP_CaseStatus_Option)),
                        Row("Stay Granted", DB(Model.CO_WP_StayGranted)),
                        Model.CO_WP_StayGranted == true ? Row("Stay Date", DD(Model.CO_WP_StayDate)) : null,
                        Model.CO_WP_StayGranted == true ? Row("Stay Nature", D(Model.CO_WP_StayNature)) : null,
                        Row("Outcome", D(Model.CO_WP_Outcome)),
                        Row("Outcome Remark", D(Model.CO_WP_OutcomeRemark))
                    })

                    @Card("Corporation Writ Appeal (WA)", "diagram-2-fill", new[] {
                        Row("WA Number / Year", D($"{Model.CO_WA_CaseNumber} / {Model.CO_WA_Year}")),
                        Row("High Court Bench", D(Model.CO_WA_HighCourtBench)),
                        Row("Advocate Assigned", D(Model.CO_WA_AdvocateName)),
                        Row("Entrustment No / Date", D($"{Model.CO_WA_EntrustmentNo} (Dt: {DD(Model.CO_WA_EntrustmentDate) ?? "-"})")),
                        Row("Status", D(Model.CO_WA_Status ?? Model.CO_WA_CaseStatus_Option)),
                        Row("Stay Granted", DB(Model.CO_WA_StayGranted)),
                        Model.CO_WA_StayGranted == true ? Row("Stay Nature", D(Model.CO_WA_StayNature)) : null,
                        Row("Outcome", D(Model.CO_WA_Outcome))
                    })

                    @Card("Workman Reinstatement", "person-check-fill", new[] {
                        Row("Workman Reinstated", DB(Model.CO_IsWorkmanReinstated)),
                        Row("Subject to WP", D(Model.CO_ReinstatedSubjectToWP)),
                        Row("Reinstatement Approval Issued", DB(Model.CO_ReinstatementApprovalIssued)),
                        Row("Reinstatement Approval No", D(Model.CO_Reinstatement_ApprovalNo)),
                        Row("Reinstatement Date", DD(Model.CO_ReinstatementApprovalDate))
                    })

                    @Card("Supreme Court / Further Appeal", "bank2", new[] {
                        Row("SC / Further Appeal Case No", D($"{Model.CO_FurtherAppeal_CaseNumber} / {Model.CO_FurtherAppeal_Year}")),
                        Row("SC Advocate", D(Model.CO_FurtherAppeal_AdvocateName)),
                        Row("SC Entrustment No", D(Model.CO_FurtherAppeal_EntrustmentNo)),
                        Row("SC Status", D(Model.CO_FurtherAppeal_CaseStatus ?? Model.CO_FurtherAppeal_Status_Option))
                    })
                </div>
            </div>
        }

        <!-- ── 5. Legal Opinions & Decisions Tab ── -->
        <div class="lcp-pane" id="tab-arising-opinions">
            <div class="row g-3">
                <!-- 4-Level Central Office Review Cards -->
                <div class="col-lg-6 col-md-12">
                    <div class="lcp-card h-100 border-start border-4 border-info">
                        <div class="lcp-card-header bg-info-subtle bg-opacity-25 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="lcp-card-icon bg-info text-white"><i class="bi bi-person-badge"></i></span>
                                <span class="lcp-card-title text-info">Law Officer (LO)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ActionTaken_LO))
                            {
                                <span class="badge @(Model.ActionTaken_LO == "Approved" ? "bg-success" : "bg-danger")">@Model.ActionTaken_LO</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Pending</span>
                            }
                        </div>
                        <div class="lcp-card-body">
                            <div class="lcp-row">
                                <span class="lcp-label">Approval Date</span>
                                <span class="lcp-value">@(DD(Model.ApprovalDate_LO) ?? "—")</span>
                            </div>
                            <div class="lcp-row lcp-row--full">
                                <span class="lcp-label">Opinion / Remarks</span>
                                <div class="lcp-value lcp-value--block white-space-pre-line">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_LO) ? "— Pending LO Legal Review —" : Model.Opinion_LO)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-12">
                    <div class="lcp-card h-100 border-start border-4 border-secondary">
                        <div class="lcp-card-header bg-secondary-subtle bg-opacity-25 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="lcp-card-icon bg-secondary text-white"><i class="bi bi-person-check"></i></span>
                                <span class="lcp-card-title text-secondary">Dy. Chief Law Officer (Dy CLO)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ActionTaken_DyCLO))
                            {
                                <span class="badge @(Model.ActionTaken_DyCLO == "Approved" ? "bg-success" : "bg-danger")">@Model.ActionTaken_DyCLO</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Pending</span>
                            }
                        </div>
                        <div class="lcp-card-body">
                            <div class="lcp-row">
                                <span class="lcp-label">Approval Date</span>
                                <span class="lcp-value">@(DD(Model.ApprovalDate_DyCLO) ?? "—")</span>
                            </div>
                            <div class="lcp-row lcp-row--full">
                                <span class="lcp-label">Opinion / Remarks</span>
                                <div class="lcp-value lcp-value--block white-space-pre-line">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_DyCLO) ? "— Pending Dy CLO Legal Review —" : Model.Opinion_DyCLO)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-12">
                    @{
                        var cloVal = Model.ActionTaken_CLO ?? Model.CO_Disposal_Decision;
                        var cloDate = Model.ApprovalDate_CLO ?? Model.CO_ApprovalDate;
                    }
                    <div class="lcp-card h-100 border-start border-4 border-primary">
                        <div class="lcp-card-header bg-primary-subtle bg-opacity-25 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="lcp-card-icon bg-primary text-white"><i class="bi bi-award-fill"></i></span>
                                <span class="lcp-card-title text-primary">Chief Law Officer (CLO)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(cloVal))
                            {
                                <span class="badge @(cloVal == "Approved" ? "bg-success" : (cloVal == "Rejected" ? "bg-danger" : "bg-primary"))">@cloVal</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Pending</span>
                            }
                        </div>
                        <div class="lcp-card-body">
                            <div class="lcp-row">
                                <span class="lcp-label">Approval Date</span>
                                <span class="lcp-value">@(DD(cloDate) ?? "—")</span>
                            </div>
                            <div class="lcp-row lcp-row--full">
                                <span class="lcp-label">Opinion / Remarks</span>
                                <div class="lcp-value lcp-value--block white-space-pre-line">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_CLO) ? "— Pending CLO Legal Review —" : Model.Opinion_CLO)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-12">
                    @{
                        var mdVal = Model.ActionTaken_MD ?? Model.CO_ActionTaken;
                        var mdDate = Model.ApprovalDate_MD ?? Model.CO_ApprovalDate;
                        var mdOpinion = Model.Opinion_MD ?? Model.CO_Remarks;
                    }
                    <div class="lcp-card h-100 border-start border-4 border-success">
                        <div class="lcp-card-header bg-success-subtle bg-opacity-25 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="lcp-card-icon bg-success text-white"><i class="bi bi-check-circle-fill"></i></span>
                                <span class="lcp-card-title text-success">Managing Director (MD)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(mdVal))
                            {
                                <span class="badge @(mdVal == "Approved" ? "bg-success" : (mdVal == "Rejected" ? "bg-danger" : "bg-primary"))">@mdVal</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Pending</span>
                            }
                        </div>
                        <div class="lcp-card-body">
                            <div class="lcp-row">
                                <span class="lcp-label">Approval Date</span>
                                <span class="lcp-value">@(DD(mdDate) ?? "—")</span>
                            </div>
                            <div class="lcp-row lcp-row--full">
                                <span class="lcp-label">Opinion / Remarks</span>
                                <div class="lcp-value lcp-value--block white-space-pre-line">
                                    @(string.IsNullOrWhiteSpace(mdOpinion) ? "— Pending MD Legal Review —" : mdOpinion)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Central Office Administrative Tracking -->
                @Card("Central Office Dispatch & Feasibility", "send-check-fill", new[] {
                    Row("Sent to Central Office", DB(Model.SentToCO)),
                    Row("CO Outward No", D(Model.CO_OutwardNo)),
                    Row("CO Outward Date", DD(Model.CO_OutwardDate)),
                    Row("Feasibility Status", Model.CO_FeasibilityReceived == true ? "Judgment Received" : (Model.SentToCO ? "Pending Feasibility" : "Not Sent")),
                    Row("Feasibility Date", DD(Model.CO_FeasibilityDate))
                })

                @Card("Central Office Directives & Closure", "building-check", new[] {
                    Row("Approval Outward No", D(Model.CO_ApprovalOutwardNo)),
                    Row("CO Action Taken", D(Model.CO_ActionTaken)),
                    Row("CO General Remarks", D(Model.Remarks))
                })
            </div>
        </div>

        <!-- ── 6. Documents Tab ── -->
        @if (hasDocs)
        {
            <div class="lcp-pane" id="tab-arising-docs">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="lcp-card">
                            <div class="lcp-card-header">
                                <span class="lcp-card-icon"><i class="bi bi-paperclip"></i></span>
                                <span class="lcp-card-title">Attached Files &amp; Official Records</span>
                            </div>
                            <div class="lcp-card-body">
                                @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath)) {
                                    <a href="@Model.JudgmentCopyPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-pdf text-danger me-2 fs-6"></i><span class="fw-bold">Judgment Copy</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.DE_HistorySheetPath)) {
                                    <a href="@Model.DE_HistorySheetPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-person text-primary me-2 fs-6"></i><span class="fw-bold">DE History Sheet</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.LokAdalatDocumentPath)) {
                                    <a href="@Model.LokAdalatDocumentPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-check text-success me-2 fs-6"></i><span class="fw-bold">Lok Adalat Settlement Document</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.CO_WP_JudgmentCopyPath)) {
                                    <a href="@Model.CO_WP_JudgmentCopyPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-pdf text-info me-2 fs-6"></i><span class="fw-bold">High Court WP Judgment Copy</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.CO_WP_StayOrderPath)) {
                                    <a href="@Model.CO_WP_StayOrderPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-pdf text-warning me-2 fs-6"></i><span class="fw-bold">WP Stay Order Copy</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.CO_WA_StayOrderPath)) {
                                    <a href="@Model.CO_WA_StayOrderPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-pdf text-danger me-2 fs-6"></i><span class="fw-bold">WA Stay Order Copy</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.CO_ClosedDocumentPath)) {
                                    <a href="@Model.CO_ClosedDocumentPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-check text-secondary me-2 fs-6"></i><span class="fw-bold">CO Closed Approval Document</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.CO_Reinstatement_ApprovalCopyPath)) {
                                    <a href="@Model.CO_Reinstatement_ApprovalCopyPath" target="_blank" class="lcp-doc-item">
                                        <div><i class="bi bi-file-earmark-text text-success me-2 fs-6"></i><span class="fw-bold">Reinstatement Approval Copy</span></div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i>View Document</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div><!-- /.lcp-content -->
</div><!-- /.lcp-wrapper -->

<script>
(function () {
    document.querySelectorAll('.lcp-wrapper .lcp-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var targetId = btn.getAttribute('data-lcp-tab');
            var wrapper = btn.closest('.lcp-wrapper');
            wrapper.querySelectorAll('.lcp-tab-btn').forEach(function (b) {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
            });
            wrapper.querySelectorAll('.lcp-pane').forEach(function (p) {
                p.classList.remove('active');
            });
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            var pane = wrapper.querySelector('#' + targetId);
            if (pane) pane.classList.add('active');
        });
    });
})();
</script>
