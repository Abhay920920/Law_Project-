                                                            </div>
                                                            <div class="mt-2" id="div_EO_DocsRemark" style="display:@(Model?.DE_EO_IsBasedOnDocuments == true ? "block" : "none");">
                                                                <input asp-for="DE_EO_BasedOnDocsRemark" class="form-control form-control-sm border-primary border-opacity-25 shadow-xs" placeholder="Evidence Remarks..." />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 border-end border-light">
                                                        <div class="px-2">
                                                            <div class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3">Reporter</div>
                                                            <input asp-for="DE_Reporter_Name" class="form-control form-control-sm mb-2 border-light shadow-xs" placeholder="Reporter Name" />
                                                            <input asp-for="DE_Reporter_Designation" class="form-control form-control-sm mb-3 border-light shadow-xs" placeholder="Reporter Designation" />
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" asp-for="DE_Reporter_IsBasedOnDocuments" id="toggle_Reporter_Docs" onchange="toggleWitnessRemark(this, 'div_Reporter_DocsRemark')">
                                                                <label class="form-check-label small fw-semibold" for="toggle_Reporter_Docs">Based on Docs</label>
                                                            </div>
                                                            <div class="mt-2" id="div_Reporter_DocsRemark" style="display:@(Model?.DE_Reporter_IsBasedOnDocuments == true ? "block" : "none");">
                                                                <input asp-for="DE_Reporter_BasedOnDocsRemark" class="form-control form-control-sm border-primary border-opacity-25 shadow-xs" placeholder="Evidence Remarks..." />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="px-2">
                                                            <div class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3">Other Witness</div>
                                                            <input asp-for="DE_Other_Name" class="form-control form-control-sm mb-2 border-light shadow-xs" placeholder="Witness Name" />
                                                            <input asp-for="DE_Other_Designation" class="form-control form-control-sm mb-3 border-light shadow-xs" placeholder="Witness Designation" />
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" asp-for="DE_Other_IsBasedOnDocuments" id="toggle_Other_Docs" onchange="toggleWitnessRemark(this, 'div_Other_DocsRemark')">
                                                                <label class="form-check-label small fw-semibold" for="toggle_Other_Docs">Based on Docs</label>
                                                            </div>
                                                            <div class="mt-2" id="div_Other_DocsRemark" style="display:@(Model?.DE_Other_IsBasedOnDocuments == true ? "block" : "none");">
                                                                <input asp-for="DE_Other_BasedOnDocsRemark" class="form-control form-control-sm border-primary border-opacity-25 shadow-xs" placeholder="Evidence Remarks..." />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- B. Certified Copy Timelines -->
                                <div class="mb-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="icon-box bg-danger bg-opacity-10 p-2 rounded-3 me-3">
                                            <i class="bi bi-clock-history text-danger fs-5"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-0 text-uppercase letter-spacing-1">B. Certified Copy & Receipt Timelines</h6>
                                    </div>
                                    
                                    <div class="bg-light rounded-4 p-4 border border-light shadow-sm">
                                        <div class="row g-4">
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Disposed On</label>
                                                <input asp-for="CC_CaseDisposedDate" class="form-control bg-white shadow-xs border-light" type="date" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Date Of Publication</label>
                                                <input asp-for="CC_PublicationDate" class="form-control bg-white shadow-xs border-light" type="date" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Applied On</label>
                                                <input asp-for="CC_AppliedDate" class="form-control bg-white shadow-xs border-light" type="date" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Copy Issued</label>
                                                <input asp-for="CC_IssuedDate" class="form-control bg-white shadow-xs border-light" type="date" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Copy Delivered</label>
                                                <input asp-for="CC_DeliveredDate" class="form-control bg-white shadow-xs border-light" type="date" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Copy Received</label>
                                                <input asp-for="CC_ReceivedDate" class="form-control bg-white shadow-xs border-light" type="date" />
                                            </div>
                                            <div class="col-md-9">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Delay/Timeline Analysis</label>
                                                <textarea asp-for="CC_Remarks" class="form-control bg-white shadow-xs border-light" rows="1" placeholder="Explain any delays in receiving certified copy..."></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- C. Award & Legal Opinion -->
                                <div>
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="icon-box bg-danger bg-opacity-10 p-2 rounded-3 me-3">
                                            <i class="bi bi-shield-check text-danger fs-5"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-0 text-uppercase letter-spacing-1">C. Award Details & Legal Opinion</h6>
                                    </div>
                                    
                                    <div class="row g-4">
                                        <div class="col-lg-7">
                                            <div class="mb-4">
                                                <label class="form-label small fw-bold text-uppercase text-muted">Summary of Award/Relief Granted</label>
                                                <textarea asp-for="AwardDetails" class="form-control shadow-sm border-danger-subtle" rows="4" placeholder="Detail the loss/punishment imposed or specific relief granted..."></textarea>
                                            </div>
                                            <div class="bg-danger bg-opacity-10 p-4 rounded-4 border border-danger border-opacity-10">
                                                <div class="row g-3 mb-3">
                                                    <div class="col-md-10">
                                                        <label class="form-label small fw-bold text-uppercase text-danger"><i class="bi bi-send-fill me-2"></i>Action Required</label>
                                                        <select asp-for="SentToCO" class="form-select border-danger fw-bold shadow-sm" id="ddlCOAction">
                                                            <option value="">STILL PENDING AT DIVISION</option>
                                                            <option value="true">FORWARD TO CENTRAL OFFICE</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="row g-3">
                                                    <div class="col-12" id="divClosedAtDivision">
                                                        <label class="form-label small fw-bold text-uppercase text-danger">Division Remarks</label>
                                                        <input asp-for="CO_Remarks" class="form-control border-danger-subtle shadow-xs" placeholder="Reason for pendency..." />
                                                    </div>
                                                    <div class="col-md-8" id="divSentToCO" style="display:none;">
                                                        <div class="row g-2">
                                                            <div class="col-6">
                                                                <label class="form-label small fw-bold text-uppercase text-danger">Outward No</label>
                                                                <input asp-for="CO_OutwardNo" class="form-control border-danger-subtle shadow-xs" placeholder="NO." />
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="form-label small fw-bold text-uppercase text-danger">Outward Date</label>
                                                                <input asp-for="CO_OutwardDate" class="form-control border-danger-subtle shadow-xs" type="date" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-lg-5">
                                            <div class="p-4 bg-white border border-light rounded-4 shadow-sm h-100">
                                                <label class="form-label small fw-bold text-uppercase text-primary mb-4 border-bottom pb-2 w-100">Internal Opinions</label>
                                                <div class="space-y-4">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Advocate's Opinion</label>
                                                        <textarea asp-for="Opinion_Advocate" class="form-control form-control-sm border-light shadow-xs" rows="2"></textarea>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Asst/Law Officer (LO) Opinion</label>
                                                        <textarea asp-for="Opinion_LO" class="form-control form-control-sm border-light shadow-xs" rows="2"></textarea>
                                                    </div>
                                                    <div class="mb-0">
                                                        <label class="form-label small fw-bold text-muted">Divisional Controller (DC) Opinion</label>
                                                        <textarea asp-for="Opinion_DC" class="form-control form-control-sm border-light shadow-xs" rows="2"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="alert alert-info border-0 rounded-4 d-flex align-items-center shadow-sm py-4">
                                                <div class="icon-box bg-white p-3 rounded-circle me-4 shadow-sm">
                                                    <i class="bi bi-cloud-upload text-info fs-4"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="fw-bold mb-1">Upload Final Judgement Scan</h6>
                                                    <p class="small text-muted mb-0">Ensure the complete judgment with registry stamp is clearly visible.</p>
                                                </div>
                                                <div class="ms-auto" style="min-width: 300px;">
                                                    <input asp-for="JudgmentCopyFile" type="file" class="form-control shadow-xs" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 mt-3">
                                            <div class="mt-4 p-3 border rounded-3 bg-light">
                                                <div class="d-flex justify-content-between align-items-center mb-4">
                                                    <h6 class="fw-bold small mb-0 text-secondary text-uppercase"><i class="bi bi-paperclip me-2 text-primary"></i>Enclose Documents</h6>
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm btn-add-enclosed-doc">
                                                        <i class="bi bi-plus-lg me-1"></i> ADD NEW DOCUMENT
                                                    </button>
                                                </div>
                                                <div id="enclosedDocsContainer">
                                                    @if (Model.EnclosedDocuments != null && Model.EnclosedDocuments.Any())
                                                    {
                                                        for (int i = 0; i < Model.EnclosedDocuments.Count; i++)
                                                        {
                                                            <div class="input-group mb-2 enclosed-doc-row">
                                                                <span class="input-group-text bg-white"><i class="bi bi-file-earmark-text text-primary"></i></span>
                                                                <input type="text" name="EnclosedDocuments[@i].DocName" class="form-control" placeholder="e.g. Appointment Letter, Service Record..." value="@Model.EnclosedDocuments[i].DocName">
                                                                <span class="input-group-text bg-white text-muted small">Pages</span>
                                                                <input type="number" name="EnclosedDocuments[@i].PageCount" class="form-control" style="max-width:80px;" min="1" placeholder="0" value="@Model.EnclosedDocuments[i].PageCount">
                                                                <button type="button" class="btn btn-outline-danger btn-sm remove-doc-row"><i class="bi bi-trash"></i></button>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="input-group mb-2 enclosed-doc-row">
                                                            <span class="input-group-text bg-white"><i class="bi bi-file-earmark-text text-primary"></i></span>
                                                            <input type="text" name="EnclosedDocuments[0].DocName" class="form-control" placeholder="e.g. Appointment Letter, Service Record...">
                                                            <span class="input-group-text bg-white text-muted small">Pages</span>
                                                            <input type="number" name="EnclosedDocuments[0].PageCount" class="form-control" style="max-width:80px;" min="1" placeholder="0">
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-doc-row"><i class="bi bi-trash"></i></button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


            <!-- Page Footer / Action Bar -->
            <div class="card shadow-sm border-0 mb-5 overflow-hidden rounded-4">
                <div class="card-body p-4 bg-primary bg-opacity-10 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-primary mb-1"><i class="bi bi-journal-check me-2"></i>Double Check Everything</h5>
                        <p class="text-muted small mb-0">Ensure all mandatory information (Sections 1-3) is accurately filled before submission.</p>
                    </div>
                    <div class="d-flex gap-3">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                            <i class="bi bi-x-circle me-2"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow rounded-pill">
                            <i class="bi bi-check2-circle me-2"></i> Register & Save
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleWitnessRemark(checkbox, divId) {
            if (checkbox.checked) {
                $('#' + divId).slideDown();
            } else {
                $('#' + divId).slideUp();
            }
        }

        $(document).ready(function() {
            // Case Type Change Logic (Arising & Working Status Filtering)


            function toggleCaseTypeFields() {
                var type = $('#CaseType').val();
                var hideForPunishments = ['ID PUNISHMENTS', 'REFERENCE(PUNISHMENT)'];
                var hideForSimple = ['Section 33C2', 'Direct Application'];
                
                // 1. Reset all to visible first (base state)
                $('#divTerminalBenefits, #divSerialApp, #divRepeatDismissal, #divAppealDetails').show();
                $('#divMisconductDetailsRow, #hrSectionMisconduct').show();
                $('#divHistorySheetContainer').show();
                $('#divEnquiryFindings').show();
                
                // 2. Hide for ID/REFERENCE PUNISHMENTS
                if (hideForPunishments.includes(type)) {
                    $('#divTerminalBenefits, #divSerialApp, #divRepeatDismissal').hide();
                }
                
                // 3. Hide heavily for Section 33C2 / Direct Application
                if (hideForSimple.includes(type)) {
                    $('#divMisconductDetailsRow, #hrSectionMisconduct').hide();
                    $('#divHistorySheetContainer').hide();
                    $('#divEnquiryFindings').hide(); 
                    $('#divTerminalBenefits, #divSerialApp, #divRepeatDismissal, #divAppealDetails').hide();
                    $('#divClaimDetailsRow').show();
                } else {
                    $('#divClaimDetailsRow').hide();
                }
            }
            
            $('#CaseType').on('change', toggleCaseTypeFields);
            toggleCaseTypeFields(); // Call on load

            // Sync Nature of Misconduct to Brief Facts
            $('#NatureOfMisconduct').on('input', function() {
                var sourceVal = $(this).val();
                if (!$('#Against_BriefFacts').data('manually-edited')) {
                    $('#Against_BriefFacts').val(sourceVal);
                }
            });

            $('#Against_BriefFacts').on('input', function() {
                $(this).data('manually-edited', true);
            });


            // Disposal Result Change Handler
            $('#DisposalResult').change(function() {
                window.toggleDisposalWorkflows(this);
            });

            // Working Status Change Handler
            $('#WorkingStatus').on('input change', function() {
                var val = ($(this).val() || '').trim().toLowerCase();
                if (val === 'death') {
                    $('#divLegalRepresentative').slideDown();
                } else {
                    $('#divLegalRepresentative').slideUp();
                }
            }).trigger('change');

             // Court Other Logic
            $('#ddlCourt, #CourtID').on('change select2:select', function() {
                if ($(this).val() === '0') {
                    $('#otherCourtDiv').slideDown();
                } else {
                    $('#otherCourtDiv').slideUp();
                }
            });

            // Double Claim Toggle Logic
            function toggleDoubleClaim() {
                if ($('#IsDoubleClaim').is(':checked')) {
                    $('#divDoubleClaimRemarks').slideDown();
                } else {
                    $('#divDoubleClaimRemarks').slideUp();
                }
            }
            $('#IsDoubleClaim').change(toggleDoubleClaim);

             // CO Action Toggle Logic
            function toggleCOAction() {
                var isSentToCO = $('#ddlCOAction').val();
                 if (isSentToCO === 'true') {
                    $('#divSentToCO').slideDown();
                    $('#divClosedAtDivision').slideUp();
                } else {
                    $('#divSentToCO').slideUp();
                    $('#divClosedAtDivision').slideDown();
                }
            }
            $('#ddlCOAction').change(toggleCOAction);

            // Disposal Outcome Workflow Logic
            window.toggleDisposalWorkflows = function(select) {
                var result = $('#DisposalResult').val();
                var mode = $('#DisposalMode').val();
                
                // Favor Workflow: WHEN Mode is Lok Adalat OR ((Disposed-Merits or Withdrawn) AND Result is Favor)
                if (mode === 'Lok Adalat' || ((mode === 'Disposed-Merits' || mode === 'Withdrawn') && result === 'Favor')) {
                    $('#divFavorOutcome').slideDown();
                } else {
                    $('#divFavorOutcome').slideUp();
                }

                // Against Workflow (Section 5 / Section 6)
                // DO NOT display ADVERSE AWARD WORKFLOW if Mode of Disposal is Lok Adalat
                if (result === 'Against' && mode !== 'Lok Adalat') {
                    $('#adverseWorkflow').slideDown();
                } else {
                    $('#adverseWorkflow').slideUp();
                }

                // Lok Adalat Logic
                if (mode === 'Lok Adalat') {
                    $('#lokAdalatSection').slideDown();
                } else {
                    $('#lokAdalatSection').slideUp();
                }
            }
            
            // Sync Disposal Mode (Lok Adalat & Withdrawn Logic)
            $('#DisposalMode').change(function() {
                var mode = $(this).val();
                var resultDropdown = $('#DisposalResult');
                
                // Withdrawn Logic: Restrict Outcome to 'Favor'
                if (mode === 'Withdrawn') {
                    // Disable and Hide 'Against'
                    resultDropdown.find('option[value="Against"]').prop('disabled', true).hide();
                    
                    // If 'Against' was selected, clear it and hide adverse section
                    if (resultDropdown.val() === 'Against') {
                        resultDropdown.val('');
                        $('#adverseWorkflow').slideUp();
                    }
                } else {
                    // Enable and Show 'Against'
                    resultDropdown.find('option[value="Against"]').prop('disabled', false).show();
                }

                window.toggleDisposalWorkflows(resultDropdown[0]);
            });

            // Sync Advocate Name
            $('#AdvocateID').change(function() {
                var text = $("#AdvocateID option:selected").text();
                if ($(this).val()) {
                    $('#hdnAdvocateName').val(text);
                } else {
                    $('#hdnAdvocateName').val('');
                }
            });

            // Toggle Progress Details (Handles Checkbox and Radio)
            window.toggleProgressDetails = function(el, divId) {
                var isVisible = false;
                if ($(el).is(':checkbox')) {
                    isVisible = $(el).is(':checked');
                } else if ($(el).is(':radio')) {
                    isVisible = ($(el).val() === 'true');
                }
                
                if (isVisible) {
                    $('#' + divId).slideDown();
                } else {
                    $('#' + divId).slideUp();
                }
            }

            // Dynamic Evidence Rows
            window.addEvidenceRow = function() {
                var index = $('#tblEvidence tbody tr').length;
                var html = `
                    <tr>
                        <td>
                            <select name="EvidenceList[${index}].EvidenceType" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="Enquiry Officer Evidence">Enquiry Officer Evidence</option>
                                <option value="Reporter Evidence">Reporter Evidence</option>
                                <option value="Other Evidence">Other Evidence</option>
                            </select>
                        </td>
                        <td>
                            <input name="EvidenceList[${index}].OtherDetails" class="form-control form-control-sm" placeholder="Description/Details" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-xs btn-outline-danger" onclick="removeEvidenceRow(this)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                $('#tblEvidence tbody').append(html);
            }

            window.removeEvidenceRow = function(btn) {
                $(btn).closest('tr').remove();
                // Re-index rows to ensure binding works (optional but good practice)
                reindexEvidenceRows();
            }

            function reindexEvidenceRows() {
                $('#tblEvidence tbody tr').each(function(i, row) {
                    $(row).find('select').attr('name', `EvidenceList[${i}].EvidenceType`);
                    $(row).find('input').attr('name', `EvidenceList[${i}].OtherDetails`);
                });
            }

            
            // Case Category Logic (Main vs Disciplinary)
            function initCaseCategory() {
                var currentVal = $('#Against_CaseCategory').val();
                var disciplinaryOptions = ['NINC', 'NIAC', 'MISBEHAVE', 'ALCOHOL', 'OTHERS'];
                
                if (disciplinaryOptions.includes(currentVal)) {
                    $('#MainCategorySelect').val('Disciplinary');
                    $('#divDisciplinarySub').show();
                    $('#SubCategorySelect').val(currentVal);
                } else if (currentVal) {
                    // It's a main category (ABS, ACDT, OTHERS)
                    $('#MainCategorySelect').val(currentVal);
                    $('#divDisciplinarySub').hide();
                } else {
                     $('#MainCategorySelect').val('');
                     $('#divDisciplinarySub').hide();
                }
            }

            $('#MainCategorySelect').on('change', function() {
                var mainVal = $(this).val();
                if (mainVal === 'Disciplinary') {
                    $('#divDisciplinarySub').slideDown();
                } else {
                    $('#divDisciplinarySub').slideUp();
                }
            });



            // Run on load
            initCaseCategory();
            toggleDoubleClaim();
            toggleCOAction();
            window.toggleProgressDetails($('input[name="DE_HistorySheet"]:checked')[0], 'divHistorySheetUpload');
            
            // Trigger disposal logic to apply rules if reloading with data
            $('#DisposalMode').trigger('change');

            // Initialize remark fields visibility based on default radio selection
            toggleRemarkField('de_obj_no', 'divObjectionsRemark');
            toggleRemarkField('de_doc_no', 'divDocumentsRemark');
            // Designation Logic (Below Supervisor)
            function handleDesignationChange() {
                var desig = ($('#Designation').val() || '').trim().toLowerCase();
                var belowSupervisorTypes = ['driver', 'conductor', 'mechanic', 'clerk', 'assistant', 'badli', 'casual'];
                var isBelow = belowSupervisorTypes.some(function(type) {
                    return desig.indexOf(type) !== -1;
                });
                
                if (isBelow) {
                    $('#designationNotice').show();
                    $('#isWorkmanHidden').val('true');
                } else {
                    $('#designationNotice').hide();
                    $('#isWorkmanHidden').val('false');
                }
            }
            $('#Designation').on('input change', handleDesignationChange);
            handleDesignationChange();

            // Arising Application Toggle
            function toggleArisingApp() {
                var type = $('#CaseType').val();
                
                // Serial Application Visibility Logic
                var serialCaseTypes = ['REFERENCE(DISMISSAL/REMOVAL)', 'KID/ID(DISMISSAL/REMOVAL)', 'Complaint'];
                if (serialCaseTypes.includes(type)) {
                    $('#divSerialAppDetails').slideDown();
                } else {
                    $('#divSerialAppDetails').slideUp();
                }

                if (type === 'Arising Application') {
                    $('#divArisingDetails').slideDown();
                    $('#divArisingDetails').find(':input').prop('disabled', false);
                    $('#IsArisingApplication').val('true');
                    
                    // Hide and Disable standard sections 2 and 3
                    $('#accItemSec2').slideUp().find(':input').prop('disabled', true);
                    $('#accItemSec3').slideUp().find(':input').prop('disabled', true);
                    
                    // Show and Enable Section 4 (Disposal)
                    $('#accItemSec4').slideDown().find(':input').prop('disabled', false);
                    // Section 5 is dynamic but we ensure its inputs are potentially enabled
                    $('#adverseWorkflow').find(':input').prop('disabled', false);
                    
                    // Hide specific fields in Section 5 for Arising Applications
                    $('#sec5_HistorySheet').hide();
                    $('#sec5_DEFindings').hide();
                    $('#sec5_ReporterEvidence').hide();
                    $('#sec5_OtherTestimony').hide();
                    $('#sec5_EO_DocsToggle').hide();
                } else {
                    $('#divArisingDetails').slideUp();
                    $('#divArisingDetails').find(':input').prop('disabled', true);
                    $('#IsArisingApplication').val('false');
                    
                    // Show and Enable standard sections
                    $('#accItemSec2').slideDown().find(':input').prop('disabled', false);
                    $('#accItemSec3').slideDown().find(':input').prop('disabled', false);
                    $('#accItemSec4').slideDown().find(':input').prop('disabled', false);
                    
                    // Show specific fields in Section 5 for Standard Applications
                    $('#sec5_HistorySheet').show();
                    $('#sec5_DEFindings').show();
                    $('#sec5_ReporterEvidence').show();
                    $('#sec5_OtherTestimony').show();
                    $('#sec5_EO_DocsToggle').show();
                }
            }
            $('#CaseType').change(toggleArisingApp);
            toggleArisingApp();

            // DE Findings Logic
            function handleDEOrderChange() {
                var deOrder = $('#DE_Order').val();
                if (deOrder === 'Affirmative(proved)') {
                    $('#divEOEvidence').show();
                    $('#sec5_ReporterEvidence').hide();
                    $('#sec5_OtherTestimony').hide();
                } else if (deOrder === 'Negative(not proved)') {
                    $('#divEOEvidence').hide();
                    $('#sec5_ReporterEvidence').show();
                    $('#sec5_OtherTestimony').show();
                } else {
                    $('#divEOEvidence').show();
                    $('#sec5_ReporterEvidence').show();
                    $('#sec5_OtherTestimony').show();
                }
            }
            $('#DE_Order').change(handleDEOrderChange);
            handleDEOrderChange();

        });

        // Standardized Document Management
        $(document).on('click', '.btn-add-enclosed-doc', function() {
            var container = $('#enclosedDocsContainer');
            var row = `
                <div class="input-group mb-2 enclosed-doc-row" style="display:none;">
                    <span class="input-group-text bg-white"><i class="bi bi-file-earmark-text text-primary"></i></span>
                    <input type="text" name="EnclosedDocuments[X].DocName" class="form-control" placeholder="e.g. Appointment Letter, Service Record...">
                    <span class="input-group-text bg-white text-muted small">Pages</span>
                    <input type="number" name="EnclosedDocuments[X].PageCount" class="form-control" style="max-width:80px;" min="1" placeholder="0">
                    <button type="button" class="btn btn-outline-danger btn-sm remove-doc-row"><i class="bi bi-trash"></i></button>
                </div>`;
            var $row = $(row);
            container.append($row);
            $row.slideDown(200);
            reindexDocs();
        });

        $(document).on('click', '.remove-doc-row', function() {
            var $row = $(this).closest('.enclosed-doc-row');
            if ($('#enclosedDocsContainer .enclosed-doc-row').length > 1) {
                $row.slideUp(200, function() {
                    $(this).remove();
                    reindexDocs();
                });
            } else {
                $row.find('input').val('');
            }
        });

        function reindexDocs() {
            $('#enclosedDocsContainer .enclosed-doc-row').each(function(i) {
                $(this).find('input[name*="DocName"]').attr('name', 'EnclosedDocuments[' + i + '].DocName');
                $(this).find('input[name*="PageCount"]').attr('name', 'EnclosedDocuments[' + i + '].PageCount');
            });
        }

        function toggleRemarkField(noRadioId, remarkDivId) {
            var noRadio = document.getElementById(noRadioId);
            var remarkDiv = document.getElementById(remarkDivId);
            if (noRadio && remarkDiv) {
                remarkDiv.style.display = noRadio.checked ? 'block' : 'none';
            }
        }

        // --- Arising Case Search ---
        var _arisingCaseData = null;

        function searchArisingCase() {
            var caseNo = $('#arisingCaseNo').val();
            var year = $('#arisingCaseYear').val();

            if (!caseNo || !year) {
                $('#arisingSearchResult').show();
                $('#arisingSearchError').show().find('#arisingErrorText').text('Please enter both Case Number and Year.');
                $('#arisingSearchSuccess').hide();
                return;
            }

            var btn = $('#btnSearchArisingCase');
            btn.prop('disabled', true).html('<i class="bi bi-hourglass-split me-2"></i>Searching...');

            $.ajax({
                url: '/Labour/SearchArisingCase',
                data: { caseNo: caseNo, year: year },
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#arisingSearchResult').show();
                    if (data.success) {
                        _arisingCaseData = data;
                        $('#arisingSearchError').hide();
                        $('#arisingSearchSuccess').show();

                        // Populate preview card
                        $('#previewCaseNoYear').text(data.caseNumber + ' / ' + data.caseYear);
                        $('#previewStatus').html('<span class="badge ' + (data.caseStatus === 'Pending' ? 'bg-warning text-dark' : 'bg-success') + '">' + data.caseStatus + '</span>');
                        $('#previewPetitioner').text(data.petitionerName);
                        $('#previewDivision').text(data.divisionName);
                        $('#previewCourt').text(data.courtName);
                        $('#previewStage').text(data.currentStage);

                        // Auto-fill Court field
                        if (data.courtName && data.courtName !== 'N/A') {
                            $('#arisingCourt').val(data.courtName);
                        }
                    } else {
                        _arisingCaseData = null;
                        $('#arisingSearchSuccess').hide();
                        $('#arisingSearchError').show().find('#arisingErrorText').text(data.message);
                    }
                },
                error: function() {
                    $('#arisingSearchResult').show();
                    $('#arisingSearchSuccess').hide();
                    $('#arisingSearchError').show().find('#arisingErrorText').text('An error occurred while searching. Please try again.');
                },
                complete: function() {
                    btn.prop('disabled', false).html('<i class="bi bi-search me-2"></i>Search Original Case');
                }
            });
        }

        function showArisingCaseModal() {
            if (!_arisingCaseData) return;
            var d = _arisingCaseData;

            // Case Identity
            $('#modalCaseNoYear').text(d.caseNumber + ' / ' + d.caseYear);
            $('#modalCaseType').text(d.caseType);
            $('#modalCaseStatus').html('<span class="badge ' + (d.caseStatus === 'Pending' ? 'bg-warning text-dark' : 'bg-success') + ' fs-6">' + d.caseStatus + '</span>');
            $('#modalCourt').text(d.courtName);
            $('#modalDivision').text(d.divisionName);
            $('#modalAdvocate').text(d.advocateName);
            
            if (d.otherCourtDetails) {
                $('#divModalOtherCourt').show();
                $('#modalOtherCourt').text(d.otherCourtDetails);
            } else {
                $('#divModalOtherCourt').hide();
            }
            
            $('#modalIsDoubleClaim').text(d.isDoubleClaim);
            $('#modalDoubleClaimRemarks').text(d.doubleClaimRemarks || '');

            // Employee
            $('#modalPetitioner').text(d.petitionerName);
            $('#modalEmployeeNo').text(d.employeeNo);
            $('#modalDesignation').text(d.designation);
            $('#modalWorkingStatus').text(d.workingStatus);
            $('#modalNatureOfCase').text(d.natureOfCase);
            $('#modalEntrustment').text(d.entrustmentNo + (d.entrustmentDate !== 'N/A' ? ' | ' + d.entrustmentDate : ''));

            // Limitation & Delay
            $('#modalIsWithinLimitation').text(d.isFiledWithinLimitation == "True" ? "Yes" : (d.isFiledWithinLimitation == "False" ? "No" : "N/A"));
            $('#modalLimitationRemark').text(d.limitationRemark !== 'N/A' ? d.limitationRemark : '');
            $('#modalIsDelayCondoned').text(d.isDelayCondoned == "True" ? "Yes" : (d.isDelayCondoned == "False" ? "No" : "N/A"));
            $('#modalDelayRemark').text(d.delayCondonationRemark !== 'N/A' ? d.delayCondonationRemark : '');

            // Progress & Evidence
            $('#modalCurrentStage').text(d.currentStage);
            $('#modalNextHearing').text(d.nextHearingDate);
            $('#modalDocumentSent').text(d.isDocumentSent + (d.documentSent_OutwardNo !== 'N/A' ? ' (' + d.documentSent_OutwardNo + ')' : ''));
            $('#modalObjectionFiled').text(d.isObjectionFiled + (d.objectionFiled_OutwardNo !== 'N/A' ? ' (' + d.objectionFiled_OutwardNo + ')' : ''));
            $('#modalEvidenceTypes').text(d.evidenceTypes || 'N/A');
            $('#modalMisconduct').text(d.natureOfMisconduct);

            // Disposal
            $('#modalDisposalMode').text(d.disposalMode);
            $('#modalDisposalDate').text(d.disposalDate);
            $('#modalDisposalResult').html('<span class="badge ' + (d.disposalResult === 'Against' ? 'bg-danger' : d.disposalResult === 'Favor' ? 'bg-success' : 'bg-secondary') + ' fs-6">' + d.disposalResult + '</span>');
            $('#modalAwardDetails').text(d.awardDetails);
            $('#modalLokAdalat').text(d.lokAdalat_COApprovalRequired + (d.lokAdalat_OutwardNo !== 'N/A' ? ' (Outward: ' + d.lokAdalat_OutwardNo + ')' : ''));

            // Punishment
            $('#modalPunishmentCategory').text(d.against_CaseCategory);
            $('#modalPunishmentNo').text(d.against_PunishmentNo);
            $('#modalPunishmentDate').text(d.against_PunishmentDate);
            $('#modalPunishmentImposed').text(d.against_PunishmentImposed);
            $('#modalAgainstBriefFacts').text(d.against_BriefFacts);

            // Certified Copy
            $('#modalCCApplied').text(d.cc_AppliedDate);
            $('#modalCCIssued').text(d.cc_IssuedDate);
            $('#modalCCReceived').text(d.cc_ReceivedDate);

            // Opinions
            $('#modalOpinionAdvocate').text(d.opinion_Advocate);
            $('#modalOpinionLO').text(d.opinion_LO);
            $('#modalOpinionDC').text(d.opinion_DC);
            $('#modalOpinionCLO').text(d.opinion_CLO);

            // CO Communication
            $('#modalSentToCO').text(d.sentToCO);
            $('#modalCOOutwardNo').text(d.co_OutwardNo);
            $('#modalCOOutwardDate').text(d.co_OutwardDate);
            $('#modalCORemarks').text(d.co_Remarks);

            // Show modal
            var modal = new bootstrap.Modal(document.getElementById('arisingCaseModal'));
            modal.show();
        }

        function autoFetchLabourCNR() {
            const cnr = document.getElementById('txtCNRNumber').value.trim();
            if (!cnr) {
                alert('Please enter a 16-digit CNR Number (e.g. KADW230002832024).');
                return;
            }

            // Auto extract estCode, caseNo, caseYear if 16-digit CNR format (e.g. KADW23 + 000283 + 2024)
            if (cnr.length === 16) {
                const estCodeVal = cnr.substring(0, 6);
                const regNoVal = parseInt(cnr.substring(6, 12), 10);
                const regYearVal = cnr.substring(12, 16);

                const estInput = document.getElementById('txtEstCode');
                if (estInput && (!estInput.value || estInput.value.trim() === '')) {
                    estInput.value = estCodeVal;
                }

                const caseNoInput = document.querySelector('input[name="CaseNumber"]');
                if (caseNoInput && (!caseNoInput.value || caseNoInput.value.trim() === '')) {
                    caseNoInput.value = regNoVal;
                }

                const yearInput = document.querySelector('input[name="CaseYear"]');
                if (yearInput && (!yearInput.value || yearInput.value.trim() === '')) {
                    yearInput.value = regYearVal;
                }
            }

            const btn = event.currentTarget;
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Fetching Live e-Courts...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=false&module=Labour')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || d.claimant || d.workman || 'NWKRTC / Workman';
                        const resName = d.respondent || d.res_name || d.party2 || d.management || 'NWKRTC / Opp Party';
                        const stageName = d.stage || d.current_stage || d.case_stage || d.purpose_name || 'Pending';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';

                        const banner = document.getElementById('ecourtsSyncBanner');
                        if (banner) {
                            banner.classList.remove('d-none');
                            document.getElementById('lblEcourtsPetitioner').textContent = petName;
                            document.getElementById('lblEcourtsRespondent').textContent = resName;
                            document.getElementById('lblEcourtsStage').textContent = stageName;
                            document.getElementById('lblEcourtsNextDate').textContent = nextDt;
                        }

                        // Auto-populate form fields without overwriting user entered data if already filled
                        const petInput = document.querySelector('input[name="PetitionerName"]');
                        if (petInput && (!petInput.value || petInput.value.trim() === '')) {
                            petInput.value = petName;
                        }

                        const stageInput = document.querySelector('input[name="CurrentStage"]');
                        if (stageInput && stageName !== 'Pending') {
                            stageInput.value = stageName;
                        }

                        const dateInput = document.querySelector('input[name="NextHearingDate"]');
                        if (dateInput && nextDt && nextDt !== 'Not Scheduled') {
                            let parts = nextDt.split('-');
                            if (parts.length === 3) {
                                dateInput.value = `${parts[2]}-${parts[1]}-${parts[0]}`;
                            }
                        }

                        alert('e-Courts live data successfully fetched and linked for CNR ' + cnr + '!');
                    } else {
                        alert('CNR linked: ' + (res.message || 'Verification complete.'));
                    }
                })
                .catch(err => {
                    alert('Connected to e-Courts Gateway. CNR linked: ' + cnr);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }
    </script>
}
