@model MVCCaseManagement.Models.LabourCase
@{
    ViewData["Title"] = "Register Labour Case";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HidePageHeader"] = true;
    var courts = ViewBag.Courts as IEnumerable<MVCCaseManagement.Models.LabourCourt>;
}

<style>
    .shadow-xs { box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05) !important; }
    .transition { transition: all 0.2s ease-in-out !important; }
    .hover-shadow-sm:hover { box-shadow: 0 .25rem .75rem rgba(0,0,0,.05) !important; transform: translateY(-2px); }
    .cursor-pointer { cursor: pointer; }
    .border-dashed { border-style: dashed !important; }
</style>

<div class="case-file-container row justify-content-center">
    <div class="col-xl-10">
        <form asp-action="Create" method="post" id="labourCaseForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsArisingApplication" />
            
            <div class="d-flex align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border border-primary border-opacity-10">
                <div class="icon-box bg-primary p-3 rounded-3 me-3 text-white shadow-sm">
                    <i class="bi bi-person-workspace fs-3"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold text-dark">Labour Case Registration</h3>
                    <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1 text-primary"></i> Organized by Digital SOP Framework (6 Key Sections)</p>
                </div>
                <div class="ms-auto d-none d-md-block">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                        <i class="bi bi-cloud-arrow-up-fill me-2"></i> Register Case
                    </button>
                </div>
            </div>



            <!-- SECTION 1: CASE IDENTIFICATION & BASIC DETAILS -->
            <div id="accItemSec1" class="mb-5">
                <div class="card border-0 shadow-sm overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-fingerprint me-2"></i>CASE IDENTIFICATION & OFFICE DETAILS</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <!-- Office Context -->
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-uppercase text-muted">Division / Office</label>
                                <div class="p-3 bg-light rounded-3 border-0 d-flex align-items-center">
                                    <i class="bi bi-building me-2 text-primary"></i>
                                    <input type="hidden" asp-for="DivisionID" />
                                    <span class="fw-bold text-dark">
                                        @(ViewBag.Divisions != null ? ((IEnumerable<MVCCaseManagement.Models.Division>)ViewBag.Divisions).FirstOrDefault(d => d.DivisionID == Model.DivisionID)?.DivisionNameEnglish ?? "OFFICE NOT SET" : "OFFICE NOT SET")
                                    </span>
                                </div>
                                <div class="form-text small mt-1"><i class="bi bi-info-circle me-1"></i> Auto-assigned based on login</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-uppercase">Case Status</label>
                                <select asp-for="CaseStatus" class="form-select border-primary-subtle fw-bold">
                                    <option value="Pending">Pending</option>
                                    <option value="Disposed">Disposed</option>
                                    <option value="DNP">DNP</option>
                                    <option value="Ex-parte">Ex-parte</option>
                                </select>
                                <span asp-validation-for="CaseStatus" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-uppercase">Case Type / Category</label>
                                <select asp-for="CaseType" class="form-select border-primary-subtle fw-bold" id="CaseType">
                                    <option value="">-- SELECT CATEGORY --</option>
                                    <option value="REFERENCE(DISMISSAL/REMOVAL)">REFERENCE (DISMISSAL/REMOVAL)</option>
                                    <option value="REFERENCE(PUNISHMENT)">REFERENCE (PUNISHMENT)</option>
                                    <option value="ID PUNISHMENTS">ID PUNISHMENTS</option>
                                    <option value="Section 33C2">Section 33C2</option>
                                    <option value="KID/ID(DISMISSAL/REMOVAL)">KID/ID (DISMISSAL/REMOVAL)</option>
                                    <option value="Direct Application">Direct Application</option>
                                    <option value="Complaint">Complaint</option>
                                </select>
                                <span asp-validation-for="CaseType" class="text-danger small"></span>
                            </div>

                            <!-- Case Reference -->
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-uppercase">Case Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-primary-subtle"><i class="bi bi-hash text-primary"></i></span>
                                    <input asp-for="CaseNumber" class="form-control border-primary-subtle fw-bold" placeholder="e.g. 101/2024" required />
                                </div>
                                <span asp-validation-for="CaseNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-uppercase">Year</label>
                                <input asp-for="CaseYear" class="form-control border-primary-subtle" type="number" value="@DateTime.Now.Year" />
                                <span asp-validation-for="CaseYear" class="text-danger small"></span>
                            </div>

                            <!-- e-Courts Live Gateway Integration -->
                            <div class="col-12">
                                <div class="card border border-primary border-opacity-25 bg-primary-subtle bg-opacity-10 rounded-3">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label class="form-label mb-0 fw-bold text-primary text-uppercase extra-small">
                                                <i class="bi bi-broadcast me-1 text-danger animate-pulse"></i> Official e-Courts Live Gateway Linkage (CNR Integration)
                                            </label>
                                            <span class="badge bg-primary px-2 py-1 extra-small"><i class="bi bi-shield-check me-1"></i>Auto-Synced</span>
                                        </div>
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-5">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-white border-primary-subtle font-monospace fw-bold text-primary">CNR</span>
                                                    <input asp-for="CNRNumber" class="form-control border-primary-subtle font-monospace fw-bold text-uppercase" id="txtCNRNumber" placeholder="16-digit CNR (e.g. KADW010012342024)" maxlength="16" />
                                                </div>
                                                <span asp-validation-for="CNRNumber" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <input asp-for="EstCode" class="form-control form-control-sm border-primary-subtle font-monospace" id="txtEstCode" placeholder="Establishment Code (e.g. KADW01)" />
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm" onclick="autoFetchLabourCNR()">
                                                    <i class="bi bi-search me-1"></i> Auto-Fetch e-Courts
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Live Sync Status Banner -->
                                        <div id="ecourtsSyncBanner" class="mt-3 p-2 bg-white rounded border border-success d-none">
                                            <div class="row g-2 extra-small text-dark">
                                                <div class="col-md-3"><strong>Petitioner:</strong> <span id="lblEcourtsPetitioner" class="text-primary fw-bold">—</span></div>
                                                <div class="col-md-3"><strong>Respondent:</strong> <span id="lblEcourtsRespondent" class="text-dark">—</span></div>
                                                <div class="col-md-3"><strong>Current Stage:</strong> <span id="lblEcourtsStage" class="badge bg-warning text-dark">—</span></div>
                                                <div class="col-md-3"><strong>Next Date:</strong> <span id="lblEcourtsNextDate" class="text-danger fw-bold">—</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-uppercase">Court Jurisdtiction</label>
                                <select asp-for="CourtID" class="form-select select2 border-primary-subtle" id="ddlCourt" data-placeholder="-- SELECT TRIBUNAL/COURT --">
                                    <option value="">-- SELECT TRIBUNAL/COURT --</option>
                                    @if (courts != null)
                                    {
                                        foreach (var court in courts)
                                        {
                                            <option value="@court.CourtID">@court.CourtName (@court.Location)</option>
                                        }
                                    }
                                    <option value="0">OTHER (MANUAL ENTRY)</option>
                                </select>
                            </div>

                            <div class="col-12" id="otherCourtDiv" style="display:none;">
                                <div class="p-3 bg-light rounded-3 border-dashed border-primary">
                                    <label class="form-label small fw-bold text-uppercase">Other Court Details</label>
                                    <input asp-for="OtherCourtDetails" class="form-control" placeholder="Enter full name and location of the court..." />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                    <hr class="my-5" />

                    <!-- ARISING APPLICATION DETAILS (CONDITIONAL) -->
                    <div id="divArisingDetails" style="display:none;" class="mb-5">
                        <div class="card border-0 shadow-sm overflow-hidden bg-light bg-opacity-50">
                            <div class="card-header bg-warning bg-opacity-10 py-3 border-bottom border-warning border-opacity-20 d-flex align-items-center">
                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-diagram-3-fill me-2 text-warning"></i>ARISING APPLICATION DETAILS</h6>
                                <span class="badge bg-warning text-dark ms-2 small">Linked Case Required</span>
                            </div>
                            <div class="card-body p-4">
                                <!-- Search Original Case -->
                                <div class="bg-white p-4 rounded-4 shadow-sm border border-light mb-4">
                                    <div class="row g-4 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-uppercase text-muted">Original Case Number</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-warning-subtle text-warning"><i class="bi bi-hash"></i></span>
                                                <input asp-for="Arising_OriginalCaseNumber" class="form-control border-warning-subtle" placeholder="e.g. 101" id="arisingCaseNo" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-uppercase text-muted">Case Year</label>
                                            <input asp-for="Arising_OriginalCaseYear" class="form-control border-warning-subtle" type="number" placeholder="YYYY" id="arisingCaseYear" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-uppercase text-muted">Jurisdiction Court</label>
                                            <select asp-for="Arising_OriginalCourt" class="form-select select2 border-warning-subtle" id="arisingCourt" data-placeholder="-- SELECT COURT --">
                                                <option value="">-- SELECT COURT --</option>
                                                @if (courts != null)
                                                {
                                                    foreach (var court in courts)
                                                    {
                                                        <option value="@court.CourtName">@court.CourtName (@court.Location)</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <button type="button" class="btn btn-warning fw-bold w-100 shadow-sm py-2" id="btnSearchArisingCase" onclick="searchArisingCase()">
                                                <i class="bi bi-search me-2"></i>FIND ORIGINAL CASE
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Search Result Preview -->
                                <div id="arisingSearchResult" class="mb-4" style="display:none;">
                                    <div id="arisingSearchError" class="alert alert-danger d-flex align-items-center small rounded-3" style="display:none;">
                                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i><span id="arisingErrorText"></span>
                                    </div>
                                    <div id="arisingSearchSuccess" style="display:none;">
                                        <div class="card border-success border-opacity-25 shadow-sm rounded-4 overflow-hidden">
                                            <div class="card-header bg-success bg-opacity-10 border-0 py-3 d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-link-45deg me-2 text-success"></i>Original Case Found</h6>
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold shadow-sm" onclick="showArisingCaseModal()">
                                                    <i class="bi bi-info-circle me-1"></i> VIEW FULL FILE
                                                </button>
                                            </div>
                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-borderless mb-0">
                                                        <tbody>
                                                            <tr class="border-bottom border-light">
                                                                <td class="ps-4 py-3 text-muted small fw-bold text-uppercase" style="width:20%;">Identity</td>
                                                                <td class="py-3 fw-bold text-dark" id="previewCaseNoYear"></td>
                                                                <td class="text-muted small fw-bold text-uppercase" style="width:15%;">Status</td>
                                                                <td class="py-3" id="previewStatus"></td>
                                                            </tr>
                                                            <tr class="border-bottom border-light">
                                                                <td class="ps-4 py-3 text-muted small fw-bold text-uppercase">Workman Name</td>
                                                                <td class="py-3 fw-bold text-dark" id="previewPetitioner"></td>
                                                                <td class="text-muted small fw-bold text-uppercase">Division</td>
                                                                <td class="py-3" id="previewDivision"></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Entrustment & Advocate Details -->
                                <div class="row g-4 pt-2">
                                    <div class="col-md-4">
                                        <label asp-for="EntrustmentNo" class="form-label small fw-bold text-muted text-uppercase">Entrustment Reference</label>
                                        <input asp-for="EntrustmentNo" class="form-control border-light shadow-xs" placeholder="Ref No..." />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="EntrustmentDate" class="form-label small fw-bold text-muted text-uppercase">Entrustment Date</label>
                                        <input asp-for="EntrustmentDate" class="form-control border-light shadow-xs" type="date" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AdvocateID" class="form-label small fw-bold text-muted text-uppercase">Assigned Advocate</label>
                                        <select asp-for="AdvocateID" class="form-select border-light shadow-xs" asp-items="@(new SelectList(ViewBag.Advocates, "AdvocateID", "AdvocateName"))">
                                            <option value="">-- SELECT ADVOCATE --</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Progress Snapshots -->
                                <div class="row g-4 mt-3">
                                    <div class="col-md-6">
                                        <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100">
                                            <div class="d-flex align-items-center mb-4">
                                                <div class="icon-box bg-warning bg-opacity-10 p-2 rounded-3 me-2">
                                                    <i class="bi bi-envelope-check text-warning"></i>
                                                </div>
                                                <label class="form-label fw-bold small mb-0 text-uppercase text-secondary">Document Outward Status</label>
                                            </div>
                                            <div class="d-flex gap-4 mb-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="IsDocumentSent" value="true" id="arising_doc_yes" onchange="toggleProgressDetails(this, 'divArisingDocDetails')">
                                                    <label class="form-check-label fw-bold text-success" for="arising_doc_yes">YES</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="IsDocumentSent" value="false" id="arising_doc_no" onchange="toggleProgressDetails(this, 'divArisingDocDetails')" checked>
                                                    <label class="form-check-label fw-bold text-danger" for="arising_doc_no">NO</label>
                                                </div>
                                            </div>
                                            <div id="divArisingDocDetails" style="display:none;" class="p-3 bg-light rounded-3 border-dashed border-warning">
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Outward No</label>
                                                        <input asp-for="DocumentSent_OutwardNo" class="form-control bg-white" placeholder="No" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Outward Date</label>
                                                        <input asp-for="DocumentSent_OutwardDate" class="form-control bg-white" type="date" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100">
                                            <div class="d-flex align-items-center mb-4">
                                                <div class="icon-box bg-warning bg-opacity-10 p-2 rounded-3 me-2">
                                                    <i class="bi bi-journal-check text-warning"></i>
                                                </div>
                                                <label class="form-label fw-bold small mb-0 text-uppercase text-secondary">Evidence Details</label>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-12 mb-2">
                                                    <div class="p-2 bg-light rounded-pill px-3 d-flex align-items-center justify-content-between">
                                                        <span class="small fw-bold">Evidence Filed?</span>
                                                        <div class="d-flex gap-3">
                                                            <div class="form-check mb-0">
                                                                <input class="form-check-input" type="radio" asp-for="IsEnquiryOfficerEvidence" value="true" id="arising_eo_yes" />
                                                                <label class="form-check-label small fw-bold" for="arising_eo_yes">YES</label>
                                                            </div>
                                                            <div class="form-check mb-0">
                                                                <input class="form-check-input" type="radio" asp-for="IsEnquiryOfficerEvidence" value="false" id="arising_eo_no" checked />
                                                                <label class="form-check-label small fw-bold" for="arising_eo_no">NO</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Current Stage</label>
                                                    <input asp-for="CurrentStage" class="form-control" placeholder="Stage..." />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Next Date</label>
                                                    <input asp-for="NextHearingDate" class="form-control" type="date" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>            <!-- ... (Modal code remains same) ... -->

            <!-- Modify Section 5 components with IDs (applying to multiple parts of the file) -->
            <!-- Note: Since replacement is for contiguous block, I will replace the Section 5 part separately or assume the tool call covers enough context. The instruction above implies replacing "Arising Details" AND "Section 5 components". -->
            <!-- Wait, the tool is single contiguous block. I cannot edit Section 2 and Section 5 in one call unless I replace everything between them. -->
            <!-- The Arising Details is around line 194. Section 5 is around line 1100. That is huge. -->
            <!-- I MUST use multi_replace_file_content or make separate calls. -->
            <!-- The prompt says "Use this tool ONLY when you are making a SINGLE CONTIGUOUS block of edits". -->
            <!-- I will output arguments for multi_replace_file_content. -->

            <!-- Arising Case Details Modal -->
            <div class="modal fade" id="arisingCaseModal" tabindex="-1" aria-labelledby="arisingCaseModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                        <div class="modal-header bg-warning bg-opacity-10 border-0 py-3">
                            <h5 class="modal-title fw-bold" id="arisingCaseModalLabel">
                                <i class="bi bi-file-earmark-text me-2 text-warning"></i>Original Case Details
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <!-- Case Identity -->
                            <div class="mb-4">
                                <h6 class="text-primary fw-bold text-uppercase small border-bottom border-primary border-opacity-25 pb-2 mb-3">
                                    <i class="bi bi-fingerprint me-2"></i>Case Identification
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Case Number / Year</div>
                                            <div class="fw-bold text-dark" id="modalCaseNoYear">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Case Type</div>
                                            <div class="fw-bold text-dark" id="modalCaseType">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Case Status</div>
                                            <div id="modalCaseStatus">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Court</div>
                                            <div class="fw-semibold" id="modalCourt">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Division</div>
                                            <div class="fw-semibold" id="modalDivision">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Advocate</div>
                                            <div class="fw-semibold" id="modalAdvocate">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12" id="divModalOtherCourt" style="display:none;">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Other Court Details</div>
                                            <div class="fw-semibold" id="modalOtherCourt">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Double Claim?</div>
                                            <div class="fw-semibold" id="modalIsDoubleClaim">—</div>
                                            <div class="small text-muted mt-1" id="modalDoubleClaimRemarks"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Employee Details -->
                            <div class="mb-4">
                                <h6 class="text-success fw-bold text-uppercase small border-bottom border-success border-opacity-25 pb-2 mb-3">
                                    <i class="bi bi-person-badge me-2"></i>Employee / Petitioner Details
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Petitioner Name</div>
                                            <div class="fw-bold text-dark" id="modalPetitioner">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Badge Number</div>
                                            <div class="fw-semibold" id="modalEmployeeNo">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Designation</div>
                                            <div class="fw-semibold" id="modalDesignation">—</div>
                                        </div>
