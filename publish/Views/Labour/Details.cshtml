                                                    <i class="bi bi-journal-text me-1 text-warning"></i> Interim Applications (I.A.)
                                                    <span class="badge bg-warning text-dark rounded-pill ms-1" id="tabCountIA_corp_wp">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 rounded-2" data-bs-toggle="tab" data-bs-target="#tabParties_corp_wp" type="button">
                                                    <i class="bi bi-card-heading me-1 text-info"></i> Full Case Details
                                                </button>
                                            </li>
                                        </ul>

                                        <div class="tab-content">
                                            <!-- 1. Hearing History Tab -->
                                            <div class="tab-pane fade show active" id="tabHistory_corp_wp">
