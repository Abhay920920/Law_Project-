                                                    <a href="@Model.CO_Claimant_PetitionCopyPath" target="_blank" class="btn btn-xs btn-outline-dark rounded-pill px-2 py-1 fw-bold extra-small">
                                                        <i class="bi bi-file-earmark-pdf me-1"></i>View Petition Copy
                                                    </a>
