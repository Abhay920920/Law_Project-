                                                {
                                                    <span class="badge bg-info text-white"><i class="bi bi-shield-check me-1"></i>Stay Granted</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">No Stay</span>
                                                }
                                            </div>
                                            <div class="col-md-3 text-md-end">
                                                <div class="d-flex flex-wrap gap-1 justify-content-md-end">
