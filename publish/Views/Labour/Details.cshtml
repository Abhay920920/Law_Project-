                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small">Entrustment Number</small>
                                                <span class="fw-semibold text-dark small">@(string.IsNullOrWhiteSpace(Model.CO_WA_EntrustmentNo) ? "—" : Model.CO_WA_EntrustmentNo)</span>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small">Stay Status</small>
