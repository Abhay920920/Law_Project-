                                                            <div class="extra-small mb-1">Registration Date: <strong id="fullRegDate_corp_wp" class="text-dark">@(Model.CO_WP_EntrustmentDate?.ToString("dd-MM-yyyy") ?? (Model.CO_WP_Year.HasValue && Model.CO_WP_Year > 1900 ? $"01-01-{Model.CO_WP_Year}" : "—"))</strong></div>
