                                            <i class="bi bi-folder2-open text-warning text-dark me-2"></i>Corporation In-House Records &amp; Documents (Claimant WP)
                                        </h6>
                                        <div class="row g-2 align-items-center">
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small">Corporation Assigned Advocate</small>
                                                <span class="fw-semibold text-dark small">@(Model.CO_Claimant_AdvocateName ?? "Not Assigned")</span>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small">Entrustment Number</small>
                                                <span class="fw-semibold text-dark small">@(string.IsNullOrWhiteSpace(Model.CO_Claimant_EntrustmentNo) ? "—" : Model.CO_Claimant_EntrustmentNo)</span>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small">Original Case Status</small>
                                                <span class="badge bg-secondary">@(Model.CO_Claimant_OriginalCaseStatus ?? "Active")</span>
