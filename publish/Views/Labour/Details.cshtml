                                        id="tab-btn-corp-wp" data-bs-toggle="pill" data-bs-target="#pane-corp-wp" type="button" role="tab" aria-selected="true">
                                    <span><i class="bi bi-building me-2 text-primary"></i>Corporation WP</span>
                                    @if (!string.IsNullOrWhiteSpace(Model.CO_WP_CaseNumber))
                                    {
                                        <span class="badge bg-primary text-white rounded-pill ms-2">WP @Model.CO_WP_CaseNumber/@Model.CO_WP_Year</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(Model.CO_WP_CNRNumber))
                                    {
                                        <span class="badge bg-success text-white rounded-pill ms-2">CNR Linked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill ms-2">WP</span>
                                    }
                                </button>
                            </li>

                            <!-- 2. Corporation WA -->
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small py-2 px-3 rounded-pill text-start d-flex align-items-center justify-content-between border shadow-xs" 
                                        id="tab-btn-corp-wa" data-bs-toggle="pill" data-bs-target="#pane-corp-wa" type="button" role="tab" aria-selected="false">
                                    <span><i class="bi bi-diagram-2 me-2 text-danger"></i>Corporation WA</span>
                                    @if (!string.IsNullOrWhiteSpace(Model.CO_WA_CaseNumber))
                                    {
                                        <span class="badge bg-danger text-white rounded-pill ms-2">WA @Model.CO_WA_CaseNumber/@Model.CO_WA_Year</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(Model.CO_WA_CNRNumber))
                                    {
                                        <span class="badge bg-success text-white rounded-pill ms-2">CNR Linked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill ms-2">WA</span>
                                    }
                                </button>
                            </li>

                            <!-- 3. Claimant WP -->
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small py-2 px-3 rounded-pill text-start d-flex align-items-center justify-content-between border shadow-xs" 
                                        id="tab-btn-claimant-wp" data-bs-toggle="pill" data-bs-target="#pane-claimant-wp" type="button" role="tab" aria-selected="false">
                                    <span><i class="bi bi-person-fill-exclamation me-2 text-warning text-dark"></i>Claimant WP</span>
                                    @if (!string.IsNullOrWhiteSpace(Model.CO_Claimant_CaseNumber))
                                    {
                                        <span class="badge bg-secondary text-white rounded-pill ms-2">WP @Model.CO_Claimant_CaseNumber/@Model.CO_Claimant_CaseYear</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(Model.CO_Claimant_CNRNumber))
