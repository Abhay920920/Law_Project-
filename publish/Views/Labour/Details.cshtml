<!-- UPDATE CNR NUMBER MODAL -->
<div class="modal fade" id="updateCnrModal" tabindex="-1" aria-labelledby="updateCnrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3 px-4">
                <h5 class="modal-title fw-bold" id="updateCnrModalLabel">
                    <i class="bi bi-broadcast me-2"></i>Update eCourts 16-Digit CNR Number
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info py-2 px-3 small mb-3 border-0 bg-info-subtle text-info-emphasis rounded-3">
                    <i class="bi bi-info-circle-fill me-1"></i> Linking a valid 16-digit CNR Number enables real-time eCourts Gateway status synchronization, automated hearing tracking, and order retrieval.
                </div>
                <form id="updateCnrForm" onsubmit="event.preventDefault(); submitUpdateCnr();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="updateCnrCaseId" value="@Model.CaseID" />
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="txtNewCnrNumber" class="form-label fw-bold text-secondary small text-uppercase mb-0">16-Digit CNR Number</label>
                            <span id="cnrCharCount" class="badge bg-secondary font-monospace">0 / 16 chars</span>
                        </div>
                        <div class="input-group">
                            <input type="text" id="txtNewCnrNumber" class="form-control font-monospace fs-6 text-uppercase" 
                                   maxlength="16" placeholder="e.g. KADW200035312025" 
                                   value="@activeCnrNumber" oninput="onCnrInputChange(this)" />
                            <button type="button" class="btn btn-outline-secondary" onclick="verifyCnrLive()" id="btnVerifyCnr" title="Test CNR on eCourts Gateway">
                                <i class="bi bi-shield-check me-1"></i> Verify
                            </button>
                        </div>
                        <div class="form-text small text-muted mt-1" id="cnrHelperText">
                            Format: 6-char establishment code + 6-digit case number + 4-digit year (e.g. <code>KADW200035312025</code> or <code>KAHC010012342024</code>)
                        </div>
                        <div id="verifyCnrResult" class="mt-2" style="display:none;"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light px-4 py-3 border-top d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="unlinkCnrNumber()">
                    <i class="bi bi-trash3 me-1"></i> Unlink CNR
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="btnSaveCnr" onclick="submitUpdateCnr()">
                        <i class="bi bi-check2-circle me-1"></i> Save & Link CNR
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

