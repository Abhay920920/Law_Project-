                                        <button class="btn btn-sm btn-outline-primary fw-bold px-3"
                                                type="button"
                                                id="btnRefreshMfa_corp_wp"
                                                onclick="fetchLiveMfaDetails(document.getElementById('cnrInput_corp_wp').value, @Model.CaseID, 'corp_wp')">
                                            <i class="bi bi-arrow-clockwise me-1"></i> Fetch Live
                                        </button>
                                    </div>
                                </div>
                            </div>

