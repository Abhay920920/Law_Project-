@model MVCCaseManagement.Models.LabourCase

@{
    ViewData["Title"] = "Labour Case Details - " + Model.CaseNumber;
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool isClosedCase = (Model.CaseStatus == "Disposed" || Model.CaseStatus == "Closed" || Model.CaseStatus == "Allowed" || Model.CaseStatus == "Dismissed" 
        || Model.DisposalDate.HasValue 
        || (!string.IsNullOrEmpty(Model.DisposalResult) && !string.Equals(Model.DisposalResult, "Pending", StringComparison.OrdinalIgnoreCase))
        || string.Equals(Model.CO_OverallCaseStatus, "Closed", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.CO_ActionTaken, "CLOSED", StringComparison.OrdinalIgnoreCase));
    bool isDisposed = isClosedCase;
    bool isServiceMatter = ViewBag.IsServiceMatter == true 
        || string.Equals(Model.CaseType, "Service Matter", StringComparison.OrdinalIgnoreCase) 
        || string.Equals(Model.CaseType, "Service/Commercial Matters", StringComparison.OrdinalIgnoreCase)
        || (Context.Request.Path.Value != null && Context.Request.Path.Value.Contains("ServiceMatterDetails", StringComparison.OrdinalIgnoreCase));
}

@{
    string displayCaseNo = !string.IsNullOrWhiteSpace(Model.CaseNumber) 
        ? Model.CaseNumber 
        : (!string.IsNullOrWhiteSpace(Model.CO_Claimant_CaseNumber) 
            ? Model.CO_Claimant_CaseNumber 
            : (!string.IsNullOrWhiteSpace(Model.CO_WP_CaseNumber) 
                ? Model.CO_WP_CaseNumber 
                : (!string.IsNullOrWhiteSpace(Model.SerialApp_CaseNumber) 
                    ? Model.SerialApp_CaseNumber 
                    : (!string.IsNullOrWhiteSpace(Model.Arising_OriginalCaseNumber) 
                        ? Model.Arising_OriginalCaseNumber 
                        : "N/A"))));
    int? displayCaseYear = Model.CaseYear.HasValue && Model.CaseYear > 0 
        ? Model.CaseYear 
        : (Model.CO_Claimant_CaseYear ?? Model.CO_WP_Year ?? Model.Arising_OriginalCaseYear);
}

<div class="container py-4 fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Labour")" class="text-decoration-none small text-muted">Labour Module</a></li>
                    <li class="breadcrumb-item active small">Case Details</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-primary mb-0">
                <i class="bi bi-file-earmark-text me-2"></i>@displayCaseNo / @(displayCaseYear?.ToString() ?? "-") <span class="fs-6 fw-normal text-muted ms-1">(@Model.CaseType)</span>
            </h2>
            <small class="text-muted">Division: <strong>@Model.DivisionName</strong> | Court: <strong>@Model.CourtName</strong></small>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2 ms-auto d-print-none">
            @{
                var aiDivId = User.FindFirst("DivisionID")?.Value;
                bool isAICentral = aiDivId == "0" || aiDivId == "5";
                bool isAIRole = User.IsInRole("Dy CLO") || User.IsInRole("DyCLO") || User.IsInRole("CLO") || User.IsInRole("MD");
            }
            @if (isAICentral && isAIRole)
            {
                <a href="/NyayaPatha?caseType=Labour&caseId=@Model.CaseID" class="btn btn-outline-primary shadow-sm rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center" title="Analyze case with Nyaya Patha AI">
                    <i class="bi bi-robot me-1 text-primary"></i> Nyaya Patha AI
                </a>
            }
            @{
                int targetActionId = (isServiceMatter && Model.ServiceID.HasValue && Model.ServiceID > 0) ? Model.ServiceID.Value : Model.CaseID;
                var statusClean = (Model.CO_ActionTaken ?? "").Trim().ToUpper();
                bool isPendingMD = statusClean == "PENDING BEFORE COMPETENT AUTHORITY" || statusClean == "PENDING AT CA";
                bool isApprovedOrRejected = statusClean == "APPROVED" || statusClean == "REJECTED" || statusClean == "CLOSED";
            }

            @if (User.IsInRole("MD") || User.IsInRole("CLO") || User.IsInRole("Dy CLO") || User.IsInRole("DyCLO") || User.IsInRole("LO") || ViewBag.IsCentralOffice == true)
            {
                if (User.IsInRole("LO"))
                {
                    <a href="@Url.Action("LOAction", "Labour", new { id = targetActionId, isService = isServiceMatter })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> Action
                    </a>
                }
                else if (User.IsInRole("Dy CLO") || User.IsInRole("DyCLO"))
                {
                    <a href="@Url.Action("DyCLOAction", "Labour", new { id = targetActionId, isService = isServiceMatter })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> Action
                    </a>
                }
                else if (User.IsInRole("CLO"))
                {
                    if (!isPendingMD && !isApprovedOrRejected)
                    {
                        <a href="@Url.Action("CLOAction", "Labour", new { id = targetActionId, isService = isServiceMatter })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                            <i class="bi bi-shield-check me-2"></i> Action
                        </a>
                    }
                    else if (isPendingMD)
                    {
                        <span class="badge bg-info text-dark p-2 px-3 rounded-pill d-inline-flex align-items-center"><i class="bi bi-hourglass-split me-1"></i> Pending at MD level</span>
                    }
                }
                else if (User.IsInRole("MD"))
                {
                    <a href="@Url.Action("MDAction", "Labour", new { id = targetActionId, isService = isServiceMatter })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> Action
                    </a>
                }
                else
                {
                    <!-- Central Office Action -->
                    <a href="@Url.Action("Action", "Labour", new { id = targetActionId })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> Central Office Action
                    </a>
                }
            }

            @if (Model.CaseType == "Service Matter")
            {
                if (ViewBag.CanEdit == true && !User.IsInRole("CLO") && !User.IsInRole("Dy CLO") && !User.IsInRole("DyCLO") && !User.IsInRole("LO") && !User.IsInRole("MD"))
                {
                    <a href="@Url.Action("ManageServiceMatter", "Labour", new { id = Model.ServiceID ?? Model.CaseID })" class="btn btn-outline-warning shadow-sm rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-pencil-square me-2"></i> Update / Manage Service Matter
                    </a>
                }
            }
            else if (string.Equals(Model.CaseType, "Claimant Writ Appeal", StringComparison.OrdinalIgnoreCase))
            {
                if (ViewBag.CanEdit == true && !User.IsInRole("CLO") && !User.IsInRole("Dy CLO") && !User.IsInRole("DyCLO") && !User.IsInRole("LO") && !User.IsInRole("MD"))
                {
                    <a href="@Url.Action("ManageClaimantWritAppeal", "Labour", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-pencil-square me-2"></i> Update Claimant Writ Appeal
                    </a>
                }
            }
            else if (string.Equals(Model.CaseType, "Claimant Appeal", StringComparison.OrdinalIgnoreCase) || string.Equals(Model.CaseType, "Claimant Writ Petition", StringComparison.OrdinalIgnoreCase))
            {
                if (ViewBag.CanEdit == true && !User.IsInRole("CLO") && !User.IsInRole("Dy CLO") && !User.IsInRole("DyCLO") && !User.IsInRole("LO") && !User.IsInRole("MD"))
                {
                    <a href="@Url.Action("ManageClaimantAppeal", "Labour", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-pencil-square me-2"></i> Update Claimant Appeal
                    </a>
                }
            }
            else
            {
                if (ViewBag.CanEdit == true && !User.IsInRole("CLO") && !User.IsInRole("Dy CLO") && !User.IsInRole("DyCLO") && !User.IsInRole("LO") && !User.IsInRole("MD"))
                {
                    <a href="@Url.Action("Edit", "Labour", new { id = Model.CaseID })" class="btn btn-primary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-pencil-square me-2"></i> Update
                    </a>
                }
                else if (Model.SentToCO == true && ViewBag.IsCentralOffice != true)
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center" title="Forwarded to Central Office - Read Only">
                        <i class="bi bi-lock-fill me-1 text-secondary"></i> Forwarded to CO (Read-Only)
                    </span>
                }
            }
            <button type="button" class="btn btn-outline-primary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#labourFullDetailsModal">
                <i class="bi bi-info-circle me-2"></i> View More Details
            </button>
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                <i class="bi bi-printer me-2"></i> Print
            </button>
        </div>
    </div>

    <!-- SUMMARY SECTION (3-Card or 4-Card Row) -->
    <div class="row g-4 mb-4 d-print-none">
        <!-- Petitioner Card -->
        <div class="@(isServiceMatter ? "col-md-4" : "col-md-3")">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white overflow-hidden position-relative">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-white bg-opacity-25 text-white rounded-3 p-2 me-3">
                            <i class="bi bi-person-badge fs-5"></i>
                        </div>
                        <small class="text-uppercase fw-bold opacity-75" style="font-size: 0.7rem; letter-spacing: 0.05em;">Petitioner</small>
                    </div>
                    <div class="fw-bold h5 mb-1 text-truncate" title="@Model.PetitionerName">@Model.PetitionerName</div>
                    <div class="small opacity-75"><i class="bi bi-hash me-1"></i>@(Model.EmployeeNo ?? "No Badge No.")</div>
                </div>
                <div class="position-absolute end-0 bottom-0 p-3 opacity-25">
                    <i class="bi bi-person-fill display-4"></i>
                </div>
            </div>
        </div>

        <!-- Disposal / Result Card -->
        <div class="@(isServiceMatter ? "col-md-4" : "col-md-3")">
            @{
                var displayResultText = !string.IsNullOrWhiteSpace(Model.DisposalMode) ? Model.DisposalMode : "Pending";
                var isPendingMode = string.Equals(displayResultText, "Pending", StringComparison.OrdinalIgnoreCase);
                var isAgainst = string.Equals(Model.DisposalResult, "Against", StringComparison.OrdinalIgnoreCase);
                var resultColor = isAgainst ? "danger" : (isPendingMode ? "warning" : "success");
                var resultIcon = isAgainst ? "exclamation-triangle" : (isPendingMode ? "hourglass-split" : "check-circle");
            }
            <div class="card border-0 shadow-sm h-100 bg-@resultColor text-white overflow-hidden position-relative">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-white bg-opacity-25 text-white rounded-3 p-2 me-3">
                            <i class="bi bi-@resultIcon fs-5"></i>
                        </div>
                        <small class="text-uppercase fw-bold opacity-75" style="font-size: 0.7rem; letter-spacing: 0.05em;">Disposal / Result</small>
                    </div>
                    <div class="fw-bold h5 mb-1" id="top-card-disposal-status">@displayResultText</div>
                    @if (Model.DisposalDate.HasValue) { 
                        <div class="small opacity-75" id="top-card-disposal-date"><i class="bi bi-calendar-check me-1"></i>@Model.DisposalDate.Value.ToString("dd MMM yyyy")</div> 
                    } else {
                        <div class="small opacity-75" id="top-card-disposal-date">@(!isPendingMode ? "Disposal Recorded" : "Tracking Active")</div>
                    }
                </div>
                <div class="position-absolute end-0 bottom-0 p-3 opacity-25">
                    <i class="bi bi-gavel display-4"></i>
                </div>
            </div>
        </div>

        @if (!isServiceMatter)
        {
            <!-- CO Status Card -->
            <div class="col-md-3">
                @{
                    var coTitle = "Not Sent to CO";
                    var coBgColor = "secondary";
                    var coIcon = "building";

                    if (Model.SentToCO == true)
                    {
                        coBgColor = "warning";
                        coIcon = "building-check";
                        
                        if (!string.IsNullOrEmpty(Model.CO_OverallCaseStatus))
                        {
                            coTitle = Model.CO_OverallCaseStatus;
                        }
                        else if (!string.IsNullOrEmpty(Model.CO_ActionTaken))
                        {
                            coTitle = Model.CO_ActionTaken;
                        }
                        else if (Model.IsViewedByCO == true)
                        {
                            coTitle = "Under CO Review";
                        }
                        else
                        {
                            coTitle = "Pending at CO";
                        }
                    }

                    var feasibilityStatusText = Model.SentToCO == true 
                        ? (Model.CO_FeasibilityReceived == true ? "Feasibility Received" : "Feasibility Pending") 
                        : "Not Applicable";
                    var feasibilityDateText = Model.CO_FeasibilityDate.HasValue 
                        ? Model.CO_FeasibilityDate.Value.ToString("dd-MMM-yyyy") 
                        : (Model.CC_ReceivedDate.HasValue ? Model.CC_ReceivedDate.Value.ToString("dd-MMM-yyyy") : "-");
                }
                <div class="card border-0 shadow-sm h-100 bg-@coBgColor text-dark overflow-hidden position-relative">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white bg-opacity-50 text-dark rounded-3 p-2 me-3">
                                <i class="bi bi-@coIcon fs-5"></i>
                            </div>
                            <small class="text-uppercase fw-bold opacity-75" style="font-size: 0.7rem; letter-spacing: 0.05em;">Central Office Status</small>
                        </div>
                        <div class="fw-bold h5 mb-1 text-truncate" title="@coTitle">@coTitle</div>
                        <div class="small opacity-75 text-truncate" title="Feasibility Status: @feasibilityStatusText">
                            <i class="bi bi-check2-circle me-1"></i>@feasibilityStatusText
                        </div>
                        <div class="small opacity-75 text-truncate" title="Received Date: @feasibilityDateText">
                            <i class="bi bi-calendar-event me-1"></i>Received: @feasibilityDateText
                        </div>
                    </div>
                    <div class="position-absolute end-0 bottom-0 p-3 opacity-25">
                        <i class="bi bi-shield-shaded display-4"></i>
                    </div>
                </div>
            </div>
        }

        <!-- Advocate Card -->
        <div class="@(isServiceMatter ? "col-md-4" : "col-md-3")">
            @{
                var isCOUser = ViewBag.IsCentralOffice == true || User.IsInRole("MD") || User.IsInRole("CLO") || User.IsInRole("CentralOffice") || User.IsInRole("CO");

                string? selectedAdv = null;
                string? selectedEnt = null;
                string? selectedSubtext = null;

                var cType = Model.CaseType ?? "";
                bool isClaimantType = cType.Contains("Claimant", StringComparison.OrdinalIgnoreCase);
                bool isServiceType = cType.Contains("Service", StringComparison.OrdinalIgnoreCase);

                if (isClaimantType && (!string.IsNullOrWhiteSpace(Model.CO_Claimant_AdvocateName) || !string.IsNullOrWhiteSpace(Model.CO_Claimant_EntrustmentNo)))
                {
                    selectedAdv = Model.CO_Claimant_AdvocateName;
                    selectedEnt = Model.CO_Claimant_EntrustmentNo;
                    selectedSubtext = "Claimant Advocate";
                }
                else if (isServiceType && (!string.IsNullOrWhiteSpace(Model.CO_Service_AppealAdvocate) || !string.IsNullOrWhiteSpace(Model.CO_Service_EntrustmentNo)))
                {
                    selectedAdv = Model.CO_Service_AppealAdvocate;
                    selectedEnt = Model.CO_Service_EntrustmentNo;
                    selectedSubtext = "Service Matter Advocate";
                }
                else if (!string.IsNullOrWhiteSpace(Model.CO_WA_AdvocateName) || !string.IsNullOrWhiteSpace(Model.CO_WA_EntrustmentNo))
                {
                    selectedAdv = Model.CO_WA_AdvocateName;
                    selectedEnt = Model.CO_WA_EntrustmentNo;
                    selectedSubtext = "Writ Appeal Advocate";
                }
                else if (!string.IsNullOrWhiteSpace(Model.CO_WP_AdvocateName) || !string.IsNullOrWhiteSpace(Model.CO_WP_EntrustmentNo))
                {
                    selectedAdv = Model.CO_WP_AdvocateName;
                    selectedEnt = Model.CO_WP_EntrustmentNo;
                    selectedSubtext = "High Court Advocate";
                }
                else if (!string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_AdvocateName) || !string.IsNullOrWhiteSpace(Model.ClaimantSCAdvocate))
                {
                    selectedAdv = !string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_AdvocateName) ? Model.CO_FurtherAppeal_AdvocateName : Model.ClaimantSCAdvocate;
                    selectedEnt = !string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_EntrustmentNo) ? Model.CO_FurtherAppeal_EntrustmentNo : Model.ClaimantSCEntrustmentNo;
                    selectedSubtext = "Supreme Court Advocate";
                }
                else if (!string.IsNullOrWhiteSpace(Model.CO_Claimant_AdvocateName) || !string.IsNullOrWhiteSpace(Model.CO_Claimant_EntrustmentNo))
                {
                    selectedAdv = Model.CO_Claimant_AdvocateName;
                    selectedEnt = Model.CO_Claimant_EntrustmentNo;
                    selectedSubtext = "Claimant Advocate";
                }
                else if (!string.IsNullOrWhiteSpace(Model.CO_Service_AppealAdvocate) || !string.IsNullOrWhiteSpace(Model.CO_Service_EntrustmentNo))
                {
                    selectedAdv = Model.CO_Service_AppealAdvocate;
                    selectedEnt = Model.CO_Service_EntrustmentNo;
                    selectedSubtext = "Service Advocate";
                }
                else if (!string.IsNullOrWhiteSpace(Model.AdvocateName) || !string.IsNullOrWhiteSpace(Model.EntrustmentNo))
                {
                    selectedAdv = Model.AdvocateName;
                    selectedEnt = Model.EntrustmentNo;
                    selectedSubtext = "Lower Court Advocate";
                }

                string cardTitle = isCOUser ? "Selected Advocate" : "Advocate Details";
                string cardAdvName = !string.IsNullOrWhiteSpace(selectedAdv) ? selectedAdv : "Not Assigned";
                string cardEntNo = !string.IsNullOrWhiteSpace(selectedEnt) ? selectedEnt : "-";
                string cardSubtext = !string.IsNullOrWhiteSpace(selectedSubtext) ? selectedSubtext : "Advocate Entrustment";
            }
            <div class="card border-0 shadow-sm h-100 bg-info text-white overflow-hidden position-relative">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-white bg-opacity-25 text-white rounded-3 p-2 me-3">
                            <i class="bi bi-person-workspace fs-5"></i>
                        </div>
                        <small class="text-uppercase fw-bold opacity-75" style="font-size: 0.7rem; letter-spacing: 0.05em;">@cardTitle</small>
                    </div>
                    <div class="fw-bold h5 mb-1 text-truncate" title="@cardAdvName">@cardAdvName</div>
                    <div class="small opacity-75 text-truncate" title="@cardSubtext">
                        <i class="bi bi-hash me-1"></i>Ent: @cardEntNo @(string.IsNullOrEmpty(cardSubtext) ? "" : $" | {cardSubtext}")
                    </div>
                </div>
                <div class="position-absolute end-0 bottom-0 p-3 opacity-25">
                    <i class="bi bi-briefcase-fill display-4 text-white"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Official e-Courts Live Gateway Linkage & Real-Time Tracking -->
    @{
        var activeCnrNumber = !string.IsNullOrWhiteSpace(Model.CNRNumber) ? Model.CNRNumber :
                              !string.IsNullOrWhiteSpace(Model.CO_WP_CNRNumber) ? Model.CO_WP_CNRNumber :
                              !string.IsNullOrWhiteSpace(Model.CO_WA_CNRNumber) ? Model.CO_WA_CNRNumber :
                              Model.CO_Claimant_CNRNumber;
    }
    <div class="card border-info shadow-sm mb-4 rounded-3 overflow-hidden d-print-none" id="ecourtsNapixLabourCard">
        <div class="card-header bg-info bg-opacity-10 border-info border-opacity-25 d-flex flex-wrap justify-content-between align-items-center py-2 px-3 gap-2"
             style="cursor: pointer;"
             data-bs-toggle="collapse"
             data-bs-target="#collapseLabourNapixSection"
             aria-expanded="false"
             aria-controls="collapseLabourNapixSection"
             id="headerLabourNapixSection"
             title="Click to expand/collapse live eCourts NAPIX details">
            <div class="d-flex align-items-center">
                <i class="bi bi-broadcast text-info fs-5 me-2 animate-pulse"></i>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold text-dark">eCourts NAPIX Live Gateway Status (Labour Court / Tribunal / High Court)</h6>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill extra-small px-2 py-0">
                            <i class="bi bi-hand-index-thumb me-1"></i>Click to open
                        </span>
                    </div>
                    <small class="text-muted extra-small">Live real-time case tracking from e-Courts Gateway (NAPIX / NJDG Services)</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div id="details-cnr-badge" class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                    @if (!string.IsNullOrEmpty(activeCnrNumber))
                    {
                        <span class="badge bg-success font-monospace fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center text-nowrap">
                            <i class="bi bi-broadcast me-1"></i> CNR: @activeCnrNumber
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Copy CNR Number" onclick="event.stopPropagation(); navigator.clipboard.writeText('@activeCnrNumber'); alert('CNR Number copied to clipboard: @activeCnrNumber');">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> CNR Not Linked
                        </span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                        <i class="bi bi-pencil-square me-1"></i>Update CNR
                    </button>
                    @if (!string.IsNullOrEmpty(activeCnrNumber))
                    {
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" id="btnRefreshLabourLive" onclick="event.stopPropagation(); triggerFetchLabourLiveStatus()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-info text-white rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseLabourNapixSection"
                        aria-expanded="false"
                        aria-controls="collapseLabourNapixSection"
                        id="btnToggleLabourNapixSection"
                        onclick="event.stopPropagation();">
                    <i class="bi bi-chevron-down" id="iconToggleLabourNapix"></i>
                    <span id="textToggleLabourNapix">View NAPIX Details</span>
                </button>
            </div>
        </div>
        <div class="collapse" id="collapseLabourNapixSection">
            <div class="card-body bg-light p-3">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Labour Case No &amp; Year</small>
                    <div class="fs-6 fw-bold text-dark">
                        @Model.CaseType No. @Model.CaseNumber / @Model.CaseYear
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Court / Establishment</small>
                    <div class="fw-bold text-dark" title="@Model.CourtName" style="word-break: break-word;">@(!string.IsNullOrEmpty(Model.CourtName) ? Model.CourtName : "Labour Court / Tribunal")</div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">First Hearing Date</small>
                    <div class="fw-semibold text-secondary" id="live-first-date">@(Model.EntrustmentDate.HasValue ? Model.EntrustmentDate.Value.ToString("dd-MM-yyyy") : "—")</div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Next Hearing Date</small>
                    <div class="fs-6 fw-bold @(Model.PendDispStatus == "D" || Model.CaseStatus == "Disposed" ? "text-danger" : "text-primary")" id="live-next-date">
                        @if (Model.PendDispStatus == "D" || Model.CaseStatus == "Disposed")
                        {
                            <span>Disposed</span>
                        }
                        else if (Model.NextHearingDate.HasValue)
                        {
                            <span>@Model.NextHearingDate.Value.ToString("dd-MM-yyyy")</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Stage</small>
                    <div class="fw-bold text-dark" id="live-stage">@(!string.IsNullOrWhiteSpace(Model.ECourtsStage) ? Model.ECourtsStage : (!string.IsNullOrWhiteSpace(Model.CurrentStage) ? Model.CurrentStage : "—"))</div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Status</small>
                    <div class="fw-semibold text-dark" id="live-case-status">@(!string.IsNullOrWhiteSpace(Model.CaseStatus) ? Model.CaseStatus : (Model.PendDispStatus == "D" ? "Disposed" : (Model.PendDispStatus == "P" ? "Pending" : "—")))</div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Filing Date</small>
                    <div class="fw-semibold text-dark" id="live-filing-date">@(Model.EntrustmentDate.HasValue ? Model.EntrustmentDate.Value.ToString("dd-MM-yyyy") : "—")</div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Decision Date</small>
                    <div class="fw-semibold text-dark" id="live-decision-date">@(Model.DisposalDate.HasValue ? Model.DisposalDate.Value.ToString("dd-MM-yyyy") : "—")</div>
                </div>
                <div class="col-12 col-md-6">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Court Number &amp; Judge</small>
                    <div class="fw-semibold text-dark" id="live-court-judge" style="word-break: break-word;">
                        @{
                            var lCourtJudgeParts = new[] { Model.ECourtsCourtNo, Model.ECourtsJudge }.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
                            var lCourtJudgeDisplay = lCourtJudgeParts.Any() ? string.Join(" — ", lCourtJudgeParts) : (!string.IsNullOrWhiteSpace(Model.OtherCourtDetails) ? Model.OtherCourtDetails : (!string.IsNullOrWhiteSpace(Model.CourtName) ? Model.CourtName : "—"));
                        }
                        @lCourtJudgeDisplay
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner / Workman</small>
                    <div class="fw-semibold text-dark" id="live-petitioner" style="word-break: break-word;">
                        @(!string.IsNullOrEmpty(Model.PetitionerName) ? Model.PetitionerName : "Workman / Petitioner")
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner Advocate</small>
                    <div class="fw-semibold text-dark" id="live-pet-adv" style="word-break: break-word;">@(!string.IsNullOrWhiteSpace(Model.AdvocateName) ? Model.AdvocateName : "—")</div>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Respondent / Management</small>
                    <div class="fw-semibold text-dark" id="live-respondent" style="word-break: break-word;">
                        @(!string.IsNullOrEmpty(Model.DivisionName) ? Model.DivisionName + " (NWKRTC)" : "NWKRTC")
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Extra Parties / Respondents</small>
                    <div class="fw-semibold text-dark" id="live-extra-party" style="word-break: break-word;">—</div>
                </div>

                <div class="col-12 d-none" id="live-transfer-block">
                    <div class="alert alert-warning alert-sm py-2 px-3 mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left-right text-warning fs-5"></i>
                        <div>
                            <div class="fw-bold small">Case Transferred from Establishment</div>
                            <div class="small" id="live-transfer-est">—</div>
                            <div class="small text-muted">Transfer Date: <span id="live-transfer-date">—</span>
                            &nbsp;|&nbsp; CNR: <span class="font-monospace" id="live-transfer-cino">—</span></div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(activeCnrNumber))
            {
                <div class="col-12 border-top mt-3 pt-3">
                    <ul class="nav nav-pills mb-3 gap-2" id="ecourtsTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active btn-sm py-1 px-3 fw-bold" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-pane" type="button" role="tab">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Court Orders &amp; Judgments 
                                <span class="badge bg-light text-danger ms-1" id="orders-count-badge">0 Files Available</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link btn-sm py-1 px-3 fw-bold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab">
                                <i class="bi bi-clock-history me-1"></i> Case Hearing History 
                                <span class="badge bg-light text-dark ms-1" id="history-count-badge">0 Hearings</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link btn-sm py-1 px-3 fw-bold" id="ia-tab" data-bs-toggle="tab" data-bs-target="#ia-pane" type="button" role="tab">
                                <i class="bi bi-file-earmark-text me-1"></i> IA Applications 
                                <span class="badge bg-light text-primary ms-1" id="ia-count-badge">0 IAs</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link btn-sm py-1 px-3 fw-bold" id="process-tab" data-bs-toggle="tab" data-bs-target="#process-pane" type="button" role="tab">
                                <i class="bi bi-envelope-paper me-1"></i> Processes &amp; Notices 
                                <span class="badge bg-light text-secondary ms-1" id="process-count-badge">0 Notices</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link btn-sm py-1 px-3 fw-bold" id="fulldata-tab" data-bs-toggle="tab" data-bs-target="#fulldata-pane" type="button" role="tab">
                                <i class="bi bi-card-text me-1"></i> Full Case Details
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content" id="ecourtsTabContent">
                        <!-- Orders & Judgments Pane -->
                        <div class="tab-pane fade show active" id="orders-pane" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Official Court Orders &amp; Judgments verified by eCourts Gateway</small>
                                <a href="/ECourts/DownloadAllOrdersZip?cnr=@activeCnrNumber" class="btn btn-sm btn-outline-danger rounded-pill shadow-sm" title="Download all orders in a single ZIP">
                                    <i class="bi bi-file-earmark-zip-fill me-1"></i> Download All Orders (ZIP)
                                </a>
                            </div>
                            <div id="live-orders-container">
                                <div class="text-muted small py-2">
                                    <i class="bi bi-hourglass-split me-1"></i> Querying Court Orders &amp; Judgments from eCourts Gateway...
                                </div>
                            </div>
                        </div>
                        <!-- Hearing History Pane -->
                        <div class="tab-pane fade" id="history-pane" role="tabpanel">
                            <div id="live-history-container">
                                <div class="text-muted small py-2">
                                    <i class="bi bi-hourglass-split me-1"></i> Loading Case Hearing History from eCourts Gateway...
                                </div>
                            </div>
                        </div>
                        <!-- IA Applications Pane -->
                        <div class="tab-pane fade" id="ia-pane" role="tabpanel">
                            <div id="live-ia-container">
                                <div class="text-muted small py-2">
                                    <i class="bi bi-hourglass-split me-1"></i> Loading Interim Applications from eCourts Gateway...
                                </div>
                            </div>
                        </div>
                        <!-- Processes Pane -->
                        <div class="tab-pane fade" id="process-pane" role="tabpanel">
                            <div id="live-process-container">
                                <div class="text-muted small py-2">
                                    <i class="bi bi-hourglass-split me-1"></i> Loading Processes &amp; Notices from eCourts Gateway...
                                </div>
                            </div>
                        </div>
                        <!-- Full Case Details Pane -->
                        <div class="tab-pane fade" id="fulldata-pane" role="tabpanel">
                            <div id="live-fulldata-container">
                                <div class="text-muted small py-2">
                                    <i class="bi bi-hourglass-split me-1"></i> Loading Complete eCourts Data...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-12 border-top mt-3 pt-3">
                    <div class="card border-primary border-opacity-25 bg-white shadow-sm rounded-3 p-4 text-center">
                        <div class="mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-cloud-arrow-down-fill me-2"></i>Live e-Courts NAPIX Integration
                            </span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Connect This Labour Case to Live e-Courts Gateway</h5>
                        <p class="text-muted small mb-3 mx-auto" style="max-width: 620px;">
                            The 16-character CNR Number is not linked yet. Click below to automatically discover the CNR from e-Courts using Case Number <strong>@Model.CaseType @Model.CaseNumber / @Model.CaseYear</strong> and Workman name <strong>@Model.PetitionerName</strong>.
                        </p>
                        <div class="d-flex flex-column align-items-center gap-2">
                            <div class="d-flex gap-2">
                                <button type="button" id="btn-autolink-cnr" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="autoLinkCnrInline(@Model.CaseID, 'Labour')">
                                    <i class="bi bi-search me-2"></i>Auto-Discover &amp; Link CNR
                                </button>
                                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="openUpdateCnrModal()">
                                    <i class="bi bi-pencil-square me-2"></i>Enter CNR Manually
                                </button>
                            </div>
                            <div id="autolink-status-msg" class="mt-1"></div>
                        </div>
                    </div>
                </div>
            }
                <div class="col-12 border-top pt-2 d-flex justify-content-between align-items-center">
                    <div class="small text-muted" id="live-sync-msg">
                        @if (Model.LastNapixSyncAt.HasValue)
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Synced: @Model.LastNapixSyncAt.Value.ToString("dd MMM yyyy, hh:mm tt") (@(Model.LastNapixSyncStatus ?? "Success"))</span>
                        }
                        else
                        {
                            <span><i class="bi bi-arrow-repeat me-1"></i> Auto-synced with eCourts Gateway</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(activeCnrNumber))
                        {
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill" onclick="triggerFetchLabourLiveStatus()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Live Status
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-info text-white rounded-pill shadow-sm" onclick="autoLinkCnrInline(@Model.CaseID, 'Labour')">
                                <i class="bi bi-link-45deg me-1"></i> Auto-Discover &amp; Link CNR
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <div class="row g-4 d-print-none">
        <!-- Main Column -->
        <div class="col-lg-8">
            @if (isServiceMatter)
            {
                <!-- Prayer / Subject Matter Card for Service Matter -->
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-primary">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-primary">
                            <i class="bi bi-file-earmark-text-fill me-2 fs-5 text-primary"></i>Prayer / Subject Matter
                        </h6>
                        @if (!string.IsNullOrWhiteSpace(Model.CO_Service_CaseNature))
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold">
                                @Model.CO_Service_CaseNature
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        @if (Model.CO_Service_IsEmployee.HasValue || Model.CO_Service_StayGranted.HasValue)
                        {
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (Model.CO_Service_IsEmployee == true)
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-person-check me-1 text-primary"></i>Corporation Employee: Yes</span>
                                }
                                else if (Model.CO_Service_IsEmployee == false)
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1"><i class="bi bi-person-x me-1"></i>Corporation Employee: No</span>
                                }
                                @if (Model.CO_Service_StayGranted == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1"><i class="bi bi-shield-check me-1"></i>Stay Granted</span>
                                }
                            </div>
                        }

                        <div class="p-3 bg-light rounded-3 text-dark small white-space-pre-line border mb-2">
                            @(string.IsNullOrWhiteSpace(Model.CO_Service_Prayer) 
                                ? (string.IsNullOrWhiteSpace(Model.AwardDetails) 
                                    ? (string.IsNullOrWhiteSpace(Model.FavorRemark) ? "No prayer or subject matter recorded." : Model.FavorRemark) 
                                    : Model.AwardDetails) 
                                : Model.CO_Service_Prayer)
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CO_Service_PetitionCopyPath) || !string.IsNullOrEmpty(Model.CO_Service_ApprovalCopyPath) || !string.IsNullOrEmpty(Model.JudgmentCopyPath) || !string.IsNullOrEmpty(Model.JudgmentCopyPath2))
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top">
                                @if (!string.IsNullOrEmpty(Model.CO_Service_PetitionCopyPath))
                                {
                                    <a href="@Model.CO_Service_PetitionCopyPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                        <i class="bi bi-file-earmark-pdf me-1"></i> View Petition Copy
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.CO_Service_ApprovalCopyPath))
                                {
                                    <a href="@Model.CO_Service_ApprovalCopyPath" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold">
                                        <i class="bi bi-file-earmark-check me-1"></i> View Approval Copy
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath))
                                {
                                    <a href="@Model.JudgmentCopyPath" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                        <i class="bi bi-file-earmark-check me-1"></i> View Judgment Copy
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath2))
                                {
                                    <a href="@Model.JudgmentCopyPath2" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                        <i class="bi bi-file-earmark-check me-1"></i> View Judgment Copy 2
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Award & Punishment Details Card -->
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-success">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-success">
                            <i class="bi bi-award-fill me-2 fs-5 text-success"></i>Award &amp; Punishment Details
                        </h6>
                        @if (!string.IsNullOrEmpty(Model.DisposalResult))
                        {
                            <span class="badge @(Model.DisposalResult == "Against" ? "bg-danger" : "bg-success") text-white rounded-pill px-3 py-2 fw-bold">
                                @Model.DisposalResult
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Punishment Imposed</small>
                                <div class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.Against_PunishmentImposed) ? "-" : Model.Against_PunishmentImposed)</div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Order Number</small>
                                <div class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.Against_PunishmentNo) ? "-" : Model.Against_PunishmentNo)</div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Order Date</small>
                                <div class="fw-bold text-dark d-flex align-items-center flex-wrap gap-2">
                                    <span>@(Model.Against_PunishmentDate.HasValue ? Model.Against_PunishmentDate.Value.ToString("dd MMM yyyy") : "-")</span>
                                    @if (!string.IsNullOrEmpty(Model.Against_PunishmentCopyPath))
                                    {
                                        <a href="@Model.Against_PunishmentCopyPath" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 fw-bold" style="font-size: 0.75rem;" title="View Punishment Copy">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>Punishment Copy
                                        </a>
                                    }
                                </div>
                            </div>
                            <div class="col-12 border-top pt-3">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Award Details</small>
                                <div class="p-3 bg-light rounded-3 text-dark small white-space-pre-line border mb-2">
                                    @(string.IsNullOrWhiteSpace(Model.AwardDetails) ? (string.IsNullOrWhiteSpace(Model.FavorRemark) ? "No specific award details recorded." : Model.FavorRemark) : Model.AwardDetails)
                                </div>
                                @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath) || !string.IsNullOrEmpty(Model.JudgmentCopyPath2))
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath))
                                        {
                                            <a href="@Model.JudgmentCopyPath" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                                <i class="bi bi-file-earmark-check me-1"></i> View Judgment Copy
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath2))
                                        {
                                            <a href="@Model.JudgmentCopyPath2" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                                <i class="bi bi-file-earmark-check me-1"></i> View Judgment Copy 2
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!isServiceMatter)
            {
                var linkedArisingAppsList = ViewBag.LinkedArisingApplications as List<ArisingApplication>;
                bool hasCorpWP = !string.IsNullOrWhiteSpace(Model.CO_WP_CaseNumber) || (Model.CO_WP_CaseStatus_Option != null && Model.CO_WP_CaseStatus_Option.Contains("PENDING", StringComparison.OrdinalIgnoreCase))
                                 || (linkedArisingAppsList != null && linkedArisingAppsList.Any(a => !string.IsNullOrWhiteSpace(a.CO_WP_CaseNumber)));
                bool hasSvcWP = !string.IsNullOrWhiteSpace(Model.CO_Service_WPNumber);
                bool hasWA = !string.IsNullOrWhiteSpace(Model.CO_WA_CaseNumber) || (Model.CO_WA_CaseStatus_Option != null && Model.CO_WA_CaseStatus_Option.Contains("PENDING", StringComparison.OrdinalIgnoreCase))
                             || (linkedArisingAppsList != null && linkedArisingAppsList.Any(a => !string.IsNullOrWhiteSpace(a.CO_WA_CaseNumber)));
                bool hasClaimantWP = !string.IsNullOrWhiteSpace(Model.CO_Claimant_CaseNumber);
                bool hasClaimantSC = !string.IsNullOrWhiteSpace(Model.ClaimantSCNumber) || !string.IsNullOrWhiteSpace(Model.ClaimantSCDiaryNumber) || Model.IsClaimantSCPending;
                bool hasCorpSC = !string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_CaseNumber) || (Model.CO_FurtherAppeal_Status_Option != null && Model.CO_FurtherAppeal_Status_Option.Contains("PENDING", StringComparison.OrdinalIgnoreCase));
                
                int higherCourtCount = (hasCorpWP ? 1 : 0) + (hasSvcWP ? 1 : 0) + (hasWA ? 1 : 0) + (hasClaimantWP ? 1 : 0) + (hasClaimantSC ? 1 : 0) + (hasCorpSC ? 1 : 0);

                <!-- Higher Courts & Appeals Hierarchy Section (WP / WA / SC Details) -->
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-primary">
                    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2"
                         style="cursor: pointer;"
                         data-bs-toggle="collapse"
                         data-bs-target="#collapseHigherCourtsSection"
                         aria-expanded="false"
                         aria-controls="collapseHigherCourtsSection"
                         id="headerHigherCourtsSection"
                         title="Click to expand/collapse Higher Courts & Appeals details">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-primary-subtle text-primary rounded-3">
                                <i class="bi bi-diagram-3-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="mb-0 fw-bold text-dark">Higher Courts &amp; Appeals Details (WP / WA / SLP)</h6>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill extra-small px-2 py-0">
                                        <i class="bi bi-hand-index-thumb me-1"></i>Click to open
                                    </span>
                                </div>
                                <small class="text-muted">High Court Writ Petitions, Writ Appeals &amp; Supreme Court Live e-Courts Tracking</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(higherCourtCount > 0 ? "bg-primary text-white" : "bg-light text-muted border") rounded-pill px-3 py-2 fw-bold" onclick="event.stopPropagation();">
                                @(higherCourtCount > 0 ? $"{higherCourtCount} Appeal Record(s)" : "No Appeals Recorded")
                            </span>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1"
