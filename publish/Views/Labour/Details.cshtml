                                 PANE 4: SERVICE MATTER WRIT PETITION
                                 ========================================== -->
                            <div class="tab-pane fade" id="pane-service-wp" role="tabpanel">
                                <div class="card-body p-3 bg-light">
                                    <div class="p-3 bg-white rounded-3 border shadow-xs">
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                            <div>
                                                <span class="badge bg-success mb-1">Service Matter Writ Petition</span>
                                                <h6 class="fw-bold text-dark mb-0">WP @Model.CO_Service_WPNumber / @(Model.CO_Service_WPYear?.ToString() ?? "-")</h6>
                                            </div>
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                                @(Model.CO_Service_Status ?? "Pending")
                                            </span>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small text-uppercase fw-bold">Case Nature</small>
                                                <span class="fw-semibold text-dark small">@(Model.CO_Service_CaseNature ?? "Service Matter")</span>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small text-uppercase fw-bold">Assigned Advocate</small>
                                                <span class="fw-semibold text-dark small">@(Model.CO_Service_AppealAdvocate ?? "Not Assigned")</span>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small text-uppercase fw-bold">Entrustment No</small>
                                                <span class="fw-semibold text-dark small">@(string.IsNullOrWhiteSpace(Model.CO_Service_EntrustmentNo) ? "—" : Model.CO_Service_EntrustmentNo)</span>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block extra-small text-uppercase fw-bold">Prayer / Action</small>
                                                <span class="text-dark extra-small text-truncate d-block" title="@Model.CO_Service_Prayer">@(Model.CO_Service_Prayer ?? "—")</span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(Model.CO_Service_PetitionCopyPath) || !string.IsNullOrEmpty(Model.CO_Service_ApprovalCopyPath))
                                        {
                                            <div class="mt-3 pt-2 border-top d-flex gap-2">
                                                @if (!string.IsNullOrEmpty(Model.CO_Service_PetitionCopyPath))
                                                {
                                                    <a href="@Model.CO_Service_PetitionCopyPath" target="_blank" class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 fw-bold extra-small">
                                                        <i class="bi bi-file-earmark-pdf me-1"></i>View Petition Copy
                                                    </a>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.CO_Service_ApprovalCopyPath))
                                                {
                                                    <a href="@Model.CO_Service_ApprovalCopyPath" target="_blank" class="btn btn-xs btn-outline-info rounded-pill px-3 py-1 fw-bold extra-small">
                                                        <i class="bi bi-file-earmark-check me-1"></i>View Approval Copy
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (hasCorpSC || hasClaimantSC)
                        {
                            <!-- ==========================================
                                 PANE 5: SUPREME COURT / SLP / FURTHER APPEALS
                                 ========================================== -->
                            <div class="tab-pane fade" id="pane-supreme-court" role="tabpanel">
                                <div class="card-body p-3 bg-light">
                                    <div class="p-3 bg-white rounded-3 border shadow-xs">
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                            <div>
                                                <span class="badge bg-dark mb-1">Supreme Court / Special Leave Petition (SLP)</span>
                                                <h6 class="fw-bold text-dark mb-0">Higher Appellate Proceedings</h6>
                                            </div>
                                        </div>

                                        <div class="row g-3">
                                            @if (hasCorpSC)
                                            {
                                                <div class="col-md-6 border-end pe-3">
                                                    <div class="p-2 rounded bg-light border">
                                                        <small class="text-primary fw-bold text-uppercase d-block mb-1 extra-small">Corporation SLP / Civil Appeal:</small>
                                                        <div class="fw-bold fs-6 text-dark">
                                                            @(string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_CaseNumber) ? "Pending Filing" : $"SLP/CA {Model.CO_FurtherAppeal_CaseNumber} / {Model.CO_FurtherAppeal_Year}")
                                                        </div>
                                                        <div class="extra-small text-muted mt-1"><i class="bi bi-person me-1"></i>Adv: <strong>@(Model.CO_FurtherAppeal_AdvocateName ?? "Not Assigned")</strong></div>
                                                        <span class="badge bg-dark mt-2">@(Model.CO_FurtherAppeal_CaseStatus ?? "Active SLP")</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (hasClaimantSC)
                                            {
                                                <div class="col-md-6 ps-3">
                                                    <div class="p-2 rounded bg-light border">
                                                        <small class="text-danger fw-bold text-uppercase d-block mb-1 extra-small">Claimant SLP / Appeal:</small>
                                                        <div class="fw-bold fs-6 text-dark">
                                                            @(string.IsNullOrWhiteSpace(Model.ClaimantSCNumber) ? $"Diary: {Model.ClaimantSCDiaryNumber} / {Model.ClaimantSCYear}" : $"SLP {Model.ClaimantSCNumber} / {Model.ClaimantSLPYear}")
                                                        </div>
                                                        <div class="extra-small text-muted mt-1"><i class="bi bi-person me-1"></i>Adv: <strong>@(Model.ClaimantSCAdvocate ?? "Not Assigned")</strong></div>
                                                        <span class="badge bg-secondary mt-2">@(Model.ClaimantSCStatus ?? "Claimant SLP Active")</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            }
            @if (!isServiceMatter && Model.CaseStatus == "Disposed")
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                         <h6 class="mb-0 fw-bold text-success"><i class="bi bi-award me-2"></i>Award &amp; Remarks</h6>
                    </div>
                    <div class="card-body">
                        <div class="p-3 bg-light rounded italic small">
                             @(Model.FavorRemark ?? Model.AwardDetails ?? "No specific award details recorded.")
                        </div>
                    </div>
                </div>
            }

            @if (!isServiceMatter)
            {
                var linkedArisingApps = ViewBag.LinkedArisingApplications as List<MVCCaseManagement.Models.ArisingApplication>;

                <!-- Linked Arising Application(s) Section -->
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-warning">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-diagram-3-fill text-warning me-2 fs-5"></i>Linked Arising Application(s)
                        </h6>
                        @if (linkedArisingApps != null && linkedArisingApps.Any())
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold">@linkedArisingApps.Count Linked</span>
                        }
                    </div>
                    <div class="card-body p-4">
                        @if (linkedArisingApps != null && linkedArisingApps.Any())
                        {
                            <div class="list-group list-group-flush gap-3">
                                @foreach (var arising in linkedArisingApps)
                                {
                                    <div class="p-3 bg-light rounded-4 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <div class="fw-bold text-dark fs-6 mb-1">
                                                <i class="bi bi-file-earmark-code me-1 text-primary"></i>Application No: @arising.CaseNumber / @arising.CaseYear
                                                <span class="badge @(arising.CaseStatus == "Disposed" ? "bg-success" : "bg-warning text-dark") ms-2">@arising.CaseStatus</span>
                                            </div>
                                            <div class="small text-muted mb-1">
                                                <strong>Court:</strong> @(arising.CourtName ?? "Labour Court") | <strong>Stage:</strong> @(arising.CurrentStage ?? "Pending") | <strong>Advocate:</strong> @(arising.AdvocateName ?? "Not Assigned")
                                            </div>
                                            @if (!string.IsNullOrEmpty(arising.AwardDetails) || !string.IsNullOrEmpty(arising.FavorRemark))
                                            {
                                                <div class="small text-secondary italic">
                                                    <i class="bi bi-chat-left-text me-1"></i>@(arising.FavorRemark ?? arising.AwardDetails)
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <a href="@Url.Action("DetailsArisingApplication", "Labour", new { id = arising.ArisingID })" class="btn btn-warning btn-sm rounded-pill px-4 fw-bold shadow-sm">
                                                <i class="bi bi-eye-fill me-1"></i> View Arising Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="bi bi-info-circle me-1"></i> No Arising Applications linked to this Labour Case yet.</span>
                                <a href="@Url.Action("CreateArisingApplication", "Labour", new { parentId = Model.CaseID })" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-plus-circle me-1"></i> Create Arising Application
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Connected Execution Petition(s) (EP) Section -->
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-info">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-file-earmark-text-fill text-info me-2 fs-5"></i>Connected Execution Petition(s) (EP)
                        </h6>
                        @if (Model.ConnectedEPs != null && Model.ConnectedEPs.Any())
                        {
                            <span class="badge bg-info text-white rounded-pill px-3 py-2 fw-bold">@Model.ConnectedEPs.Count Linked EP(s)</span>
                        }
                    </div>
                    <div class="card-body p-4">
                        @if (Model.ConnectedEPs != null && Model.ConnectedEPs.Any())
                        {
                            <div class="list-group list-group-flush gap-3">
                                @foreach (var ep in Model.ConnectedEPs)
                                {
                                    <div class="p-3 bg-light rounded-4 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <div class="fw-bold text-dark fs-6 mb-1">
                                                <i class="bi bi-file-earmark-medical me-1 text-info"></i>EP No: @ep.EPNumber / @ep.EPYear
                                                <span class="badge bg-info text-white ms-2">@(ep.OriginalCaseStatus ?? "Active EP")</span>
                                            </div>
                                            <div class="small text-muted mb-1">
                                                <strong>Court:</strong> @(ep.EPCourt ?? "Labour Court") | <strong>Entrustment No:</strong> @(ep.EP_EntrustmentNo ?? "-")
                                                @if (ep.NextHearingDate.HasValue)
                                                {
                                                    <span> | <strong>Next Hearing:</strong> @ep.NextHearingDate.Value.ToString("dd-MMM-yyyy")</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <a href="@Url.Action("Details", "LabourEP", new { id = ep.EPID })" class="btn btn-info text-white btn-sm rounded-pill px-4 fw-bold shadow-sm">
                                                <i class="bi bi-eye-fill me-1"></i> View EP Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="bi bi-info-circle me-1"></i> No Execution Petitions linked to this Labour Case yet.</span>
                                <a href="@Url.Action("Create", "LabourEP", new { caseId = Model.CaseID })" class="btn btn-outline-info btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-plus-circle me-1"></i> Create EP for this Case
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Connected Cases -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-link-45deg me-2"></i>Connected &amp; Cross Cases</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.ConnectedCases != null && Model.ConnectedCases.Any())
                        {
                            <div class="row g-2">
                                @foreach (var cc in Model.ConnectedCases)
                                {
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded small bg-light">
                                            <strong>@cc.CaseDetails</strong> - <span class="text-primary small">@cc.CurrentStatus</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0 small italic">No connected cases found.</p>
                        }
                    </div>
                </div>
            }

            <!-- Case History Table -->
            @if (Model.HistoryList != null && Model.HistoryList.Any())
            {
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clock-history me-2"></i>Hearing History</h6>
                        <span class="badge bg-light text-primary border rounded-pill">@Model.HistoryList.Count() Sessions</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 py-3 text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Stage</th>
                                        <th class="py-3 text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Next Hearing</th>
                                        <th class="py-3 text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Remarks</th>
                                        <th class="pe-4 py-3 text-uppercase text-muted fw-bold text-end" style="font-size: 0.7rem;">Recorded On</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in Model.HistoryList.OrderByDescending(x => x.CreatedDate))
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@h.CurrentStage</div>
                                            </td>
                                            <td>
                                                <span class="badge @(h.NextHearingDate.HasValue && h.NextHearingDate > DateTime.Now ? "bg-primary-subtle text-primary" : "bg-light text-muted") rounded-pill">
                                                    <i class="bi bi-calendar-event me-1"></i>@(h.NextHearingDate?.ToString("dd-MMM-yyyy") ?? "N/A")
                                                </span>
                                            </td>
                                            <td class="text-muted small">@h.Remarks</td>
                                            <td class="pe-4 text-end small text-muted">@h.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">



            @if (Model.CO_IsWorkmanReinstated == true)
            {
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                    <div class="card-header bg-success text-white py-3 border-bottom-0">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-person-check-fill me-2"></i>Compliance Status</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="p-3 bg-success-subtle text-success rounded-4 mb-3 border border-success-subtle">
                            <div class="fw-bold">WORKMAN REINSTATED</div>
                            <small class="opacity-75">Order executed as per court directive</small>
                        </div>
                        
                        <div id="reinstatementDocsList">
                            @if (Model.ReinstatedDocuments != null && Model.ReinstatedDocuments.Any())
                            {
                                <div class="list-group list-group-flush mb-3">
                                    @foreach (var doc in Model.ReinstatedDocuments)
                                    {
                                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent border-light">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-white rounded-3 p-2 me-3 shadow-sm">
                                                    <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark small">@doc.DocumentName</div>
                                                    <small class="text-muted xs">@doc.UploadedDate.ToString("dd-MMM-yyyy")</small>
                                                </div>
                                            </div>
                                            <a href="@doc.DocumentPath" target="_blank" class="btn btn-sm btn-light rounded-circle shadow-sm">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        
                        @if (ViewBag.IsCentralOffice != true)
                        {
                            <div class="p-3 bg-light rounded-4 border border-dashed text-center">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="small fw-bold text-muted mb-0"><i class="bi bi-paperclip me-1"></i>Upload Documents</h6>
                                    <button type="button" onclick="addDocRow()" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 text-uppercase fw-bold" style="font-size:0.7rem;">
                                        <i class="bi bi-plus-circle me-1"></i> + Add More
                                    </button>
                                </div>
                                <div id="docUploadContainer">
                                    <div class="doc-upload-row mb-3 text-start p-2 bg-white rounded-3 border">
                                        <input type="text" class="form-control form-control-sm mb-2 rounded-pill px-3 doc-name-input" placeholder="Document Name (e.g. Compliance Copy)" />
                                        <input type="file" class="form-control form-control-sm rounded-pill doc-file-input" accept=".pdf,.jpg,.jpeg,.png" />
                                    </div>
                                </div>
                                <button type="button" onclick="uploadReinstatementDocs()" id="btnUploadDoc" class="btn btn-primary btn-sm w-100 rounded-pill shadow-sm py-2 fw-bold text-uppercase">
                                    <i class="bi bi-cloud-upload me-1"></i> UPLOAD DOCUMENTS
                                </button>
                                <div id="uploadStatus" class="mt-2 xs fw-bold text-success d-none"></div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Documents quick-links -->
            @{
                string closureLabel = "Closure Document";
                if ((Model.CO_ActionTaken ?? "").ToUpper().Contains("CLOSED") || (Model.CO_ActionTaken ?? "").ToUpper().Contains("APPROVED"))
                {
                    closureLabel = "Approval Copy";
                }

                var docs = new List<(string? Path, string Label)>
                {
                    (Model.JudgmentCopyPath, "Judgment Copy"),
                    (Model.JudgmentCopyPath2, "Judgment Copy 2"),
                    (Model.CO_WP_JudgmentCopyPath, "WP Judgment Copy"),
                    (Model.Against_PunishmentCopyPath, "Punishment Copy"),
                    (Model.DE_HistorySheetPath, "DE History Sheet"),
                    (Model.CO_WP_StayOrderPath, "WP Stay Order"),
                    (Model.CO_WA_StayOrderPath, "WA Stay Order"),
                    (Model.CO_Claimant_PetitionCopyPath, "Claimant Petition"),
                    (Model.CO_Service_PetitionCopyPath, "Service Matter Petition"),
                    (Model.CO_Service_ApprovalCopyPath, "Service Approval Copy"),
                    (Model.CO_ClosedDocumentPath, closureLabel),
                    (Model.CO_StayComplianceFilePath, "Stay Compliance"),
                    (Model.CO_Reinstatement_StayOrderPath, "Reinstatement Stay Order"),
                    (Model.CO_Reinstatement_ApprovalCopyPath, "Reinstatement Approval Copy"),
                    (Model.LokAdalatDocumentPath, "Lok Adalat Doc"),
                    (Model.ClaimPetitionPath, "Claim Petition"),
                };
                var availableDocs = docs.Where(d => !string.IsNullOrEmpty(d.Path)).ToList();
            }
            @{
                bool hasUserDocs = Model.ReinstatedDocuments != null && Model.ReinstatedDocuments.Any();
            }
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-paperclip me-2 text-primary"></i>Case Documents</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" data-bs-toggle="collapse" data-bs-target="#uploadCaseDocCollapse" aria-expanded="false">
                        <i class="bi bi-plus-circle me-1"></i> Upload Document
                    </button>
                </div>

                <!-- Collapsible Upload Form -->
                <div class="collapse border-bottom bg-light p-3" id="uploadCaseDocCollapse">
                    <h6 class="small fw-bold text-primary mb-2"><i class="bi bi-cloud-upload me-1"></i> Upload Document with Remark</h6>
                    <form id="formUploadCaseDoc" enctype="multipart/form-data">
                        <input type="hidden" name="caseId" value="@Model.CaseID" />
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">Document Name / Title <span class="text-danger">*</span></label>
                            <input type="text" name="documentName" id="txtCaseDocName" class="form-control form-control-sm rounded-pill px-3" placeholder="e.g. Counter Statement / Opinion / Order Copy" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">Remark / Description</label>
                            <input type="text" name="remarks" id="txtCaseDocRemark" class="form-control form-control-sm rounded-pill px-3" placeholder="Enter remarks for this document..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">Select File <span class="text-danger">*</span></label>
                            <input type="file" name="documentFile" id="fileCaseDoc" class="form-control form-control-sm rounded-pill" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#uploadCaseDocCollapse">Cancel</button>
                            <button type="button" onclick="submitCaseDocument()" id="btnSubmitCaseDoc" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                                <i class="bi bi-upload me-1"></i> Upload Document
                            </button>
                        </div>
                        <div id="caseDocUploadStatus" class="mt-2 small fw-bold text-center d-none"></div>
                    </form>
                </div>

                <div class="list-group list-group-flush">
                    @foreach (var doc in availableDocs)
                    {
                        <a href="@doc.Path" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-light">
                            <div class="d-flex align-items-center">
                                <div class="bg-danger-subtle text-danger rounded-3 p-2 me-3">
                                    <i class="bi bi-file-earmark-pdf fs-5"></i>
                                </div>
                                <span class="fw-bold text-dark small">@doc.Label</span>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }
                    @if (hasUserDocs)
                    {
                        @foreach (var uDoc in Model.ReinstatedDocuments!)
                        {
                            <a href="@uDoc.DocumentPath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-light">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary-subtle text-primary rounded-3 p-2 me-3">
                                        <i class="bi bi-file-earmark-text fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">@uDoc.DocumentName</div>
                                        <small class="text-muted xs"><i class="bi bi-clock me-1"></i>Uploaded: @uDoc.UploadedDate.ToString("dd-MMM-yyyy")</small>
                                    </div>
                                </div>
                                <i class="bi bi-box-arrow-up-right text-muted small"></i>
                            </a>
                        }
                    }
                    @if (!availableDocs.Any() && !hasUserDocs)
                    {
                        <div class="p-3 text-center text-muted small">
                            <i class="bi bi-folder2-open display-6 d-block text-muted opacity-50 mb-2"></i>
                            No documents uploaded yet. Click <strong>Upload Document</strong> above to add one.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- CASE NOTINGS SECTION (Central Office & Legal Officers only - Hidden for Division logins) -->
    @{
        var labDivId = User.FindFirst("DivisionID")?.Value;
        var labRoleUpper = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "").ToUpperInvariant();
        bool canViewLabourNotings = string.IsNullOrEmpty(labDivId) || labDivId == "0" || labDivId == "5"
            || labRoleUpper.Contains("MD") || labRoleUpper.Contains("CLO") || labRoleUpper.Contains("LO")
            || labRoleUpper.Contains("ADMIN") || labRoleUpper.Contains("CENTRAL")
            || ViewBag.IsCentralOffice == true;
    }
    @if (canViewLabourNotings)
    {
        var labourNotingVM = new MVCCaseManagement.Models.CaseNotingViewModel
        {
            CaseType = "LABOUR",
            CaseID = Model.CaseID,
            CaseNumberTitle = $"Case No. {displayCaseNo}/{displayCaseYear}",
            Notings = (ViewBag.CaseNotings as List<MVCCaseManagement.Models.CaseNoting>) ?? new List<MVCCaseManagement.Models.CaseNoting>()
        };
        <partial name="_CaseNotingsSection" model="labourNotingVM" />
    }
