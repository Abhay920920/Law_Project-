                                    data-bs-target="#collapseHigherCourtsSection"
                                    aria-expanded="false"
                                    aria-controls="collapseHigherCourtsSection"
                                    id="btnToggleHigherCourtsSection"
                                    onclick="event.stopPropagation();">
                                <i class="bi bi-chevron-down" id="iconToggleHigherCourts"></i>
                                <span id="textToggleHigherCourts">View Higher Courts Details</span>
                            </button>
                        </div>
