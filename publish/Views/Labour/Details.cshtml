            }
            <tr><td>32</td><td>Terminal Benefits Paid</td><td>@(Model.TerminalBenefitsPaid ?? "NA")</td></tr>
            <tr><td>33</td><td>Amount of back wages payable in terms of the award</td><td>NA</td></tr>
            <tr><td>34</td><td>Opinion of Law Officer</td><td><div class="white-space-pre-line">@Model.Opinion_LO</div></td></tr>
        </tbody>
    </table>


    <div class="row mt-5 pt-5">
