                                                    {
                                                        <a href="@Model.CO_WA_StayOrderPath" target="_blank" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-1 fw-bold extra-small">
                                                            <i class="bi bi-file-earmark-pdf me-1"></i>View WA Stay Order
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        @if (linkedArisingAppsList != null && linkedArisingAppsList.Any(a => !string.IsNullOrWhiteSpace(a.CO_WA_CaseNumber)))
                                        {
                                            <div class="mt-3 pt-2 border-top">
                                                <small class="fw-bold text-muted text-uppercase d-block mb-2 extra-small">Linked Arising Applications (WA Records):</small>
                                                @foreach (var arisingWa in linkedArisingAppsList.Where(a => !string.IsNullOrWhiteSpace(a.CO_WA_CaseNumber)))
                                                {
                                                    <div class="p-2 bg-light border border-danger rounded-2 mb-2 d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="badge bg-danger text-white me-2">App No. @arisingWa.CaseNumber / @arisingWa.CaseYear</span>
                                                            <strong class="text-dark small">WA @arisingWa.CO_WA_CaseNumber / @(arisingWa.CO_WA_Year?.ToString() ?? "-")</strong>
                                                            <span class="text-muted extra-small ms-2">Bench: @(arisingWa.CO_WA_HighCourtBench ?? "High Court") | Adv: @(arisingWa.CO_WA_AdvocateName ?? "—")</span>
                                                        </div>
                                                        <div>
                                                            @if (!string.IsNullOrEmpty(arisingWa.CO_WA_StayOrderPath))
                                                            {
                                                                <a href="@arisingWa.CO_WA_StayOrderPath" target="_blank" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-1 extra-small">
                                                                    <i class="bi bi-file-earmark-pdf me-1"></i>Stay
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==========================================
                             PANE 3: CLAIMANT WRIT PETITION (WP)
                             ========================================== -->
                        <div class="tab-pane fade" id="pane-claimant-wp" role="tabpanel">
                            <!-- Live High Court CNR Sync Bar -->
                            <div class="bg-light-subtle border-bottom px-3 py-2">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <div class="input-group input-group-sm flex-grow-1" style="min-width: 280px; max-width: 680px;">
                                        <span class="input-group-text bg-white text-muted fw-semibold">
                                            <i class="bi bi-upc-scan me-1 text-warning"></i> High Court CNR
                                        </span>
                                        <input type="text"
                                               id="cnrInput_claimant_wp"
                                               class="form-control font-monospace fw-bold text-dark text-uppercase"
                                               value="@(Model.CO_Claimant_CNRNumber ?? "")"
                                               placeholder="e.g. KAHC010123452023"
                                               maxlength="16" />
                                        <button class="btn btn-warning text-dark btn-sm px-3 fw-bold"
                                                type="button"
                                                id="btnSyncMfa_claimant_wp"
                                                onclick="fetchLiveMfaDetails(document.getElementById('cnrInput_claimant_wp').value, @Model.CaseID, 'claimant_wp', false)">
                                            <i class="bi bi-cloud-arrow-down-fill me-1"></i> Sync Live
                                        </button>
                                        <button class="btn btn-outline-success btn-sm px-2 fw-semibold"
                                                type="button"
                                                title="Save Claimant WP CNR to Database"
                                                onclick="saveAppealCnr('claimant_wp', @Model.CaseID)">
                                            <i class="bi bi-check2"></i> Save
                                        </button>
                                        @if (!string.IsNullOrWhiteSpace(Model.CO_Claimant_CaseNumber))
                                        {
                                            <button class="btn btn-outline-warning text-dark btn-sm px-2 fw-semibold"
                                                    type="button"
                                                    title="Auto-Discover High Court CNR using Case No @Model.CO_Claimant_CaseNumber"
                                                    id="btnAutoLink_claimant_wp"
                                                    onclick="autoLinkAppealCnr(@Model.CaseID, 'claimant_wp')">
                                                <i class="bi bi-magic me-1"></i> Auto-Link
                                            </button>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <span id="live_updated_claimant_wp" class="badge bg-secondary-subtle text-secondary border px-2 py-1" style="font-size:0.68rem;">
                                            @(string.IsNullOrEmpty(Model.CO_Claimant_CNRNumber) ? "Not Synced" : "Database Linked")
                                        </span>
                                        <button class="btn btn-sm btn-outline-warning text-dark fw-bold px-3"
                                                type="button"
                                                id="btnRefreshMfa_claimant_wp"
                                                onclick="fetchLiveMfaDetails(document.getElementById('cnrInput_claimant_wp').value, @Model.CaseID, 'claimant_wp')">
                                            <i class="bi bi-arrow-clockwise me-1"></i> Fetch Live
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Aligned 4-Row Metadata Grid -->
                            <div class="card-body bg-light p-3" id="ecourtsLiveCard_claimant_wp">
                                <div class="row g-3">
                                    <!-- Row 1: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">WP Case No &amp; Year</small>
                                        <div class="fs-6 fw-bold text-dark" id="live_mfa_no_claimant_wp">
                                            WP @(string.IsNullOrEmpty(Model.CO_Claimant_CaseNumber) ? "—" : Model.CO_Claimant_CaseNumber) / @(Model.CO_Claimant_CaseYear?.ToString() ?? "—")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Court / Bench</small>
                                        <div class="fw-bold text-dark" id="live_bench_claimant_wp" style="word-break: break-word;">
                                            @(string.IsNullOrEmpty(Model.CO_Claimant_Court) ? (Model.CO_Claimant_HighCourtBench ?? "High Court") : Model.CO_Claimant_Court)
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Next Hearing Date</small>
                                        <div class="fw-bold text-warning fs-6 text-dark" id="live_hearing_claimant_wp">
                                            <i class="bi bi-calendar-event me-1 text-primary"></i>—
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Stage</small>
                                        <div id="live_stage_wrap_claimant_wp">
                                            <span id="live_stage_claimant_wp" class="badge bg-secondary text-white shadow-sm px-2 py-1">
                                                @(Model.CO_Claimant_CaseStatus ?? "—")
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Row 2: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Status</small>
                                        <div class="fw-semibold text-dark" id="live_status_claimant_wp">
                                            @(Model.CO_Claimant_CaseStatus ?? "Pending")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Filing Date</small>
                                        <div class="fw-semibold text-dark" id="live_filing_date_claimant_wp">@(Model.CO_Claimant_EntrustmentDate?.ToString("dd-MM-yyyy") ?? (Model.CO_Claimant_CaseYear.HasValue && Model.CO_Claimant_CaseYear > 1900 ? $"01-01-{Model.CO_Claimant_CaseYear}" : "—"))</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Registration Date</small>
                                        <div class="fw-semibold text-dark" id="live_reg_date_claimant_wp">@(Model.CO_Claimant_EntrustmentDate?.ToString("dd-MM-yyyy") ?? (Model.CO_Claimant_CaseYear.HasValue && Model.CO_Claimant_CaseYear > 1900 ? $"01-01-{Model.CO_Claimant_CaseYear}" : "—"))</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Decision Date</small>
                                        <div class="fw-semibold text-dark" id="live_decision_date_claimant_wp">@(Model.ClaimantSCClosureDate?.ToString("dd-MM-yyyy") ?? (string.Equals(Model.CO_Claimant_CaseStatus, "Disposed", StringComparison.OrdinalIgnoreCase) ? "Disposed" : "Pending"))</div>
                                    </div>

                                    <!-- Row 3: 2 columns -->
                                    <div class="col-12 col-md-6">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Coram / Bench (Hon'ble Judges)</small>
                                        <div class="fw-semibold text-dark" id="live_judge_claimant_wp" style="word-break: break-word;">
                                            <span class="text-muted">Will sync via live NAPIX gateway...</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Type &amp; Classification</small>
                                        <div class="fw-semibold text-dark" id="live_casetype_claimant_wp" style="word-break: break-word;">
                                            Claimant Writ Petition (WP)
                                        </div>
                                    </div>

                                    <!-- Row 4: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner / Claimant</small>
                                        <div class="fw-bold text-dark" id="live_petitioner_claimant_wp" style="word-break: break-word;">
                                            @(Model.PetitionerName ?? "Claimant / Workman")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Claimant Advocate</small>
                                        <div class="fw-semibold text-dark" id="live_pet_adv_claimant_wp" style="word-break: break-word;">
                                            —
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Respondent (Corporation)</small>
                                        <div class="fw-bold text-dark" id="live_respondent_claimant_wp" style="word-break: break-word;">
                                            The Managing Director, NWKRTC
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Corporation Advocate</small>
                                        <div class="fw-semibold text-dark" id="live_res_adv_claimant_wp" style="word-break: break-word;">
                                            @(Model.CO_Claimant_AdvocateName ?? "—")
                                        </div>
                                    </div>
                                </div>

                                <!-- 4-Tab Dossier: Hearing History, Orders & Judgments, Interim Applications, Full Case Details -->
                                <div class="col-12 mt-3 pt-2 border-top">
                                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                                        <ul class="nav nav-pills nav-fill dossier-tab-nav bg-light p-1 rounded-3 border mb-3" role="tablist">
                                            <li class="nav-item">
                                                <button class="nav-link active fw-bold small py-2 rounded-2" data-bs-toggle="tab" data-bs-target="#tabHistory_claimant_wp" type="button">
                                                    <i class="bi bi-clock-history me-1 text-primary"></i> Hearing History
                                                    <span class="badge bg-primary text-white rounded-pill ms-1" id="tabCountHistory_claimant_wp">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 rounded-2" data-bs-toggle="tab" data-bs-target="#tabOrders_claimant_wp" type="button">
                                                    <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> Orders &amp; Judgments
                                                    <span class="badge bg-danger text-white rounded-pill ms-1" id="tabCountOrders_claimant_wp">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 rounded-2" data-bs-toggle="tab" data-bs-target="#tabIA_claimant_wp" type="button">
                                                    <i class="bi bi-journal-text me-1 text-warning"></i> Interim Applications (I.A.)
                                                    <span class="badge bg-warning text-dark rounded-pill ms-1" id="tabCountIA_claimant_wp">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 rounded-2" data-bs-toggle="tab" data-bs-target="#tabParties_claimant_wp" type="button">
                                                    <i class="bi bi-card-heading me-1 text-info"></i> Full Case Details
                                                </button>
                                            </li>
                                        </ul>

                                        <div class="tab-content">
                                            <!-- 1. Hearing History Tab -->
                                            <div class="tab-pane fade show active" id="tabHistory_claimant_wp">
                                                <div class="table-responsive rounded-3 border" style="max-height: 420px; overflow-y: auto;">
                                                    <table class="table table-hover table-striped align-middle extra-small mb-0" style="min-width: 760px; width: 100%; table-layout: fixed;">
                                                        <thead class="table-dark small text-uppercase sticky-top" style="position: sticky; top: 0; z-index: 2;">
                                                            <tr>
                                                                <th class="text-center py-2 px-2" style="width:5%; white-space:nowrap;">#</th>
                                                                <th class="text-start py-2 ps-3 pe-2 text-nowrap" style="width:20%;"><i class="bi bi-calendar-event me-1"></i>Hearing Date</th>
                                                                <th class="text-start py-2 px-3" style="width:43%;"><i class="bi bi-bank2 me-1"></i>Bench / Coram</th>
                                                                <th class="text-center py-2 px-2" style="width:17%;"><i class="bi bi-bookmark-star me-1"></i>Purpose / Stage</th>
                                                                <th class="text-center py-2 px-2" style="width:15%; white-space:nowrap;"><i class="bi bi-gear me-1"></i>Action</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tbodyHistory_claimant_wp">
                                                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1 text-primary"></i> No hearing history loaded yet. Click <strong>Sync Live</strong> or <strong>Fetch Live Status</strong>.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 2. Orders & Judgments Tab -->
                                            <div class="tab-pane fade" id="tabOrders_claimant_wp">
                                                <div class="table-responsive rounded-3 border" style="max-height: 350px; overflow-y: auto;">
                                                    <table class="table table-sm table-hover align-middle extra-small mb-0" style="min-width: 600px;">
                                                        <thead class="text-white sticky-top" style="background: linear-gradient(135deg, #1e293b, #334155);">
                                                            <tr>
                                                                <th class="py-2 px-3" style="width:40px;">#</th>
                                                                <th class="py-2 px-3 text-nowrap" style="width:130px;"><i class="bi bi-calendar-check me-1 text-danger"></i>Order Date</th>
                                                                <th class="py-2 px-3"><i class="bi bi-file-earmark-text me-1 text-info"></i>Order Type / Details</th>
                                                                <th class="py-2 px-3"><i class="bi bi-bank me-1 text-warning"></i>Bench / Coram</th>
                                                                <th class="py-2 px-3 text-end" style="width:160px;"><i class="bi bi-file-pdf me-1 text-danger"></i>Action / PDF</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tbodyOrders_claimant_wp">
                                                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1 text-danger"></i> No orders/judgments loaded yet. Click <strong>Sync Live</strong> to retrieve order documents.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 3. Interim Applications Tab -->
                                            <div class="tab-pane fade" id="tabIA_claimant_wp">
                                                <div class="table-responsive rounded-3 border" style="max-height: 350px; overflow-y: auto;">
                                                    <table class="table table-sm table-hover align-middle extra-small mb-0" style="min-width: 600px;">
                                                        <thead class="bg-dark text-white sticky-top">
                                                            <tr>
                                                                <th class="py-2 px-3" style="width:40px;">#</th>
                                                                <th class="py-2 px-3" style="width:220px;"><i class="bi bi-file-earmark-diff me-1 text-warning"></i>IA Number &amp; Classification</th>
                                                                <th class="py-2 px-3"><i class="bi bi-person me-1"></i>Applicant Name</th>
                                                                <th class="py-2 px-3 text-nowrap" style="width:120px;"><i class="bi bi-calendar-event me-1"></i>Filing Date</th>
                                                                <th class="py-2 px-3 text-center" style="width:100px;"><i class="bi bi-flag me-1"></i>Status</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tbodyIA_claimant_wp">
                                                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1 text-warning"></i> No interim applications loaded yet. Click <strong>Sync Live</strong> to fetch.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 4. Full Case Details Tab -->
                                            <div class="tab-pane fade" id="tabParties_claimant_wp">
                                                <div class="row g-3 extra-small">
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-warning border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-person-badge-fill text-warning me-1"></i> Petitioner / Claimant</div>
                                                            <div id="fullPetitioner_claimant_wp" class="fw-bold text-dark fs-6 mb-1" style="word-break: break-word;">@(Model.PetitionerName ?? "Claimant / Workman")</div>
                                                            <div class="extra-small text-muted"><i class="bi bi-person-gear me-1"></i>Advocate: <span id="fullPetAdv_claimant_wp" class="fw-semibold text-dark">—</span></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-secondary border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-building-fill text-secondary me-1"></i> Respondent (Corporation)</div>
                                                            <div id="fullRespondent_claimant_wp" class="fw-bold text-dark fs-6 mb-1" style="word-break: break-word;">The Managing Director, NWKRTC</div>
                                                            <div class="extra-small text-muted"><i class="bi bi-person-gear me-1"></i>Advocate: <span id="fullResAdv_claimant_wp" class="fw-semibold text-dark">@(Model.CO_Claimant_AdvocateName ?? "—")</span></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-info border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-bank2 text-info me-1"></i> Judicial Bench / Court</div>
                                                            <div id="fullCourt_claimant_wp" class="fw-bold text-dark fs-6 mb-1" style="word-break: break-word;">@(Model.CO_Claimant_Court ?? (Model.CO_Claimant_HighCourtBench ?? "High Court of Karnataka"))</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-warning border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-calendar-range-fill text-warning me-1"></i> Milestone Dates</div>
                                                            <div class="extra-small mb-1">Filing Date: <strong id="fullFilingDate_claimant_wp" class="text-dark">@(Model.CO_Claimant_EntrustmentDate?.ToString("dd-MM-yyyy") ?? "—")</strong></div>
                                                            <div class="extra-small mb-1">Registration Date: <strong id="fullRegDate_claimant_wp" class="text-dark">@(Model.CO_Claimant_EntrustmentDate?.ToString("dd-MM-yyyy") ?? (Model.CO_Claimant_CaseYear.HasValue && Model.CO_Claimant_CaseYear > 1900 ? $"01-01-{Model.CO_Claimant_CaseYear}" : "—"))</strong></div>
                                                            <div class="extra-small">Decision Date: <strong id="fullDisposalDate_claimant_wp" class="text-dark">@(Model.ClaimantSCClosureDate?.ToString("dd-MM-yyyy") ?? (string.Equals(Model.CO_Claimant_CaseStatus, "Disposed", StringComparison.OrdinalIgnoreCase) ? "Disposed" : "Pending"))</strong></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Claimant In-House Records Sub-card -->
                                <div class="col-12 mt-3 pt-2 border-top">
                                    <div class="p-3 bg-white border rounded-3 shadow-xs">
