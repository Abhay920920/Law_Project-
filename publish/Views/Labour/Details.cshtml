                                            <span id="live_stage_corp_wp" class="badge bg-primary text-white shadow-sm px-2 py-1">
                                                @(Model.CO_WP_Status ?? "—")
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Row 2: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Status</small>
                                        <div class="fw-semibold text-dark" id="live_status_corp_wp">
                                            @(Model.CO_WP_Status ?? "Pending")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Filing Date</small>
                                        <div class="fw-semibold text-dark" id="live_filing_date_corp_wp">@(Model.CO_WP_EntrustmentDate?.ToString("dd-MM-yyyy") ?? (Model.CO_WP_Year.HasValue && Model.CO_WP_Year > 1900 ? $"01-01-{Model.CO_WP_Year}" : "—"))</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Registration Date</small>
                                        <div class="fw-semibold text-dark" id="live_reg_date_corp_wp">@(Model.CO_WP_EntrustmentDate?.ToString("dd-MM-yyyy") ?? (Model.CO_WP_Year.HasValue && Model.CO_WP_Year > 1900 ? $"01-01-{Model.CO_WP_Year}" : "—"))</div>
                                    </div>
                                    <div class="col-6 col-md-3">
