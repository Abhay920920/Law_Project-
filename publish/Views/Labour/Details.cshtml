        <h6 class="fw-bold mb-0">@Model.DivisionName?.ToUpper() DIVISION, @Model.DivisionName?.ToUpper() (LAW SECTION)</h6>
        <hr class="mt-2 mb-3" style="border-top: 2px solid #000;" />
    </div>
    <table class="table table-bordered border-dark print-table">
        <tbody>
            <tr><td style="width: 50px;">1</td><td style="width: 300px;">Name of the Division</td><td>@Model.DivisionName</td></tr>
            <tr><td>2</td><td>Case No.</td><td>@Model.CaseType No.@Model.CaseNumber/@Model.CaseYear</td></tr>
            <tr><td>3</td><td>Name of the Advocate</td><td>@Model.AdvocateName</td></tr>
            <tr><td>4</td><td>Name of the Court</td><td>@Model.CourtName</td></tr>
            <tr><td>5</td><td>In case of Ref. Details of reference made by Govt. Order</td><td>@(Model.CaseType == "REF" ? "Available in Case Records" : "N.A")</td></tr>
            <tr><td>6</td><td>Name &amp; Designation of the workman</td><td>@Model.PetitionerName, @Model.Designation @(Model.EmployeeNo != null ? "("+Model.EmployeeNo+")" : "")</td></tr>
            <tr><td>7</td><td>Status of workman</td><td>@Model.WorkingStatus @(Model.WorkingStatus == "Death" && !string.IsNullOrEmpty(Model.LegalRepresentativeName) ? " (LRs: " + Model.LegalRepresentativeName + ")" : "")</td></tr>
            <tr><td>8</td><td>Details of Misconduct/Charges</td><td>@Model.Against_CaseCategory - @Model.NatureOfMisconduct</td></tr>
            <tr><td>9</td><td>Order No, Date &amp; of penalty imposed by D.A</td><td>No:@Model.Against_PunishmentNo; Dt:@(Model.Against_PunishmentDate?.ToShortDateString() ?? "N.A")</td></tr>
            <tr><td>10</td><td>Order No. Date &amp; details of appellate Authority</td><td>@Model.Against_PunishmentImposed</td></tr>
            <tr><td>11</td><td>Whether Counter Statement filed?</td><td>@(Model.IsObjectionFiled ? "YES" : "NO")</td></tr>
            <tr><td>12</td><td>List of document produced &amp; marked before Tribunal</td><td>@(Model.DE_DocumentsMarked ? "YES" : "NO")</td></tr>
            <tr><td>13</td><td>Order of Domestic Enquiry</td><td>@Model.DE_Order @(!string.IsNullOrEmpty(Model.ChargesStatus) ? " (Charges: " + Model.ChargesStatus + ")" : "")</td></tr>
            <tr><td>14</td><td>If it is held unfair, the reasons given by court</td><td>@(Model.DE_ObjectionsRemark ?? "NA")</td></tr>
            <tr><td>15</td><td>Name &amp; Design. Of witnesses examined on behalf of Corp.</td><td>@Model.DE_EO_Name, @Model.DE_EO_Designation</td></tr>
            <tr><td>16</td><td>Whether management witness are tendered for Cross-examination</td><td>@(Model.IsEnquiryOfficerEvidence ? "YES" : "NO")</td></tr>
            <tr><td>17</td><td>If management witness are not examined/cross examined reasons</td><td>NA</td></tr>
            <tr><td>18</td><td>Name &amp; design. Of witness examined by workman &amp; cross examined</td><td>@Model.DE_Other_Name (@Model.DE_Other_Designation)</td></tr>
            <tr><td>19</td><td>Whether advocate for Corporation submitted arguments</td><td>YES</td></tr>
