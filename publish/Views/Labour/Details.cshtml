            <tr><td>21</td><td>Date of Order</td><td>@(Model.DisposalDate?.ToShortDateString() ?? "N.A")</td></tr>
            <tr><td>22</td><td>Date of publication of award</td><td>@(Model.CC_PublicationDate?.ToShortDateString() ?? "Not received")</td></tr>
            <tr><td>23</td><td>Date of receipt of CC at Division</td><td>@(Model.CC_ReceivedDate?.ToShortDateString() ?? "N.A")</td></tr>
            <tr><td>24</td><td>@(isServiceMatter ? "Prayer / Subject Matter" : "Gist of the award (in details)")</td><td><div class="white-space-pre-line">@(isServiceMatter ? (Model.CO_Service_Prayer ?? Model.AwardDetails) : Model.AwardDetails)</div></td></tr>
            <tr><td>25</td><td>If there is delay in furnishing CC the reasons for it</td><td>@(Model.CC_Remarks ?? "NA")</td></tr>
            <tr><td>26</td><td>Opinion of Advocate</td><td>@Model.Opinion_Advocate</td></tr>
            <tr><td>27</td><td>Details of action taken against the official for lapse</td><td>N.A.</td></tr>
            <tr><td>28</td><td>List of document forwarded to Central Office</td><td>1)Objections 2)Claim Statement 3)Order on DE 4)Judgment 5)Opinion</td></tr>
            <tr><td>29</td><td>If the workman was dismissed on earlier occasions (Repeat Dismissal)</td><td>@(Model.IsRepeatDismissal ? "YES: " + Model.RepeatDismissalRemark : "NO")</td></tr>
            <tr><td>30</td><td>Details of past history of the workman</td><td><div class="white-space-pre-line">@Model.CaseHistory</div></td></tr>
