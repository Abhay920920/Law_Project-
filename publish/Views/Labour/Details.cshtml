@section Scripts {
    <script src="~/js/ecourts-details.js" asp-append-version="true"></script>
    <script>
        window.currentCaseId = @Model.CaseID;
        window.lastCaseId = @Model.CaseID;
        function addDocRow() {
            var rowHtml = `
                <div class="doc-upload-row mb-3 text-start p-2 bg-white rounded-3 border position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2" style="font-size: 0.65rem;" onclick="$(this).closest('.doc-upload-row').remove()" title="Remove Row"></button>
                    <input type="text" class="form-control form-control-sm mb-2 rounded-pill px-3 doc-name-input" placeholder="Document Name" />
                    <input type="file" class="form-control form-control-sm rounded-pill doc-file-input" accept=".pdf,.jpg,.jpeg,.png" />
                </div>`;
            $('#docUploadContainer').append(rowHtml);
        }

        function uploadReinstatementDocs() {
            var caseId = @Model.CaseID;
            var formData = new FormData();
            formData.append('caseId', caseId);

            var hasValidFile = false;
            $('.doc-upload-row').each(function () {
                var docName = $(this).find('.doc-name-input').val();
                var docFile = $(this).find('.doc-file-input')[0]?.files[0];

                if (docFile) {
                    hasValidFile = true;
                    formData.append('documentNames', docName || docFile.name);
                    formData.append('documentFiles', docFile);
                }
            });

            if (!hasValidFile) {
                alert('Please select at least one file to upload.');
                return;
            }

            $('#btnUploadDoc').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Uploading...');

            $.ajax({
                url: '@Url.Action("UploadReinstatementDocuments", "Labour")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        $('#uploadStatus').text(response.message).removeClass('d-none text-danger').addClass('text-success');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    } else {
                        $('#uploadStatus').text(response.message).removeClass('d-none text-success').addClass('text-danger');
                        $('#btnUploadDoc').prop('disabled', false).html('<i class="bi bi-cloud-upload me-1"></i> UPLOAD DOCUMENTS');
                    }
                },
                error: function () {
                    $('#uploadStatus').text('Server error occurred.').removeClass('d-none text-success').addClass('text-danger');
                    $('#btnUploadDoc').prop('disabled', false).html('<i class="bi bi-cloud-upload me-1"></i> UPLOAD DOCUMENTS');
                }
            });
        }

        function submitCaseDocument() {
            var caseId = @Model.CaseID;
            var docName = $('#txtCaseDocName').val();
            var remarks = $('#txtCaseDocRemark').val();
            var fileInput = $('#fileCaseDoc')[0];

            if (!docName || !docName.trim()) {
                alert('Please enter a Document Name / Title.');
                $('#txtCaseDocName').focus();
                return;
            }

            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                alert('Please select a file to upload.');
                return;
            }

            var formData = new FormData();
            formData.append('caseId', caseId);
            formData.append('documentName', docName);
            formData.append('remarks', remarks);
            formData.append('documentFile', fileInput.files[0]);

            $('#btnSubmitCaseDoc').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Uploading...');

            $.ajax({
                url: '@Url.Action("UploadCaseDocumentWithRemark", "Labour")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        $('#caseDocUploadStatus').text(response.message).removeClass('d-none text-danger').addClass('text-success');
                        setTimeout(function() {
                            location.reload();
                        }, 800);
                    } else {
                        $('#caseDocUploadStatus').text(response.message).removeClass('d-none text-success').addClass('text-danger');
                        $('#btnSubmitCaseDoc').prop('disabled', false).html('<i class="bi bi-upload me-1"></i> Upload Document');
                    }
                },
                error: function () {
                    $('#caseDocUploadStatus').text('Server error occurred while uploading.').removeClass('d-none text-success').addClass('text-danger');
                    $('#btnSubmitCaseDoc').prop('disabled', false).html('<i class="bi bi-upload me-1"></i> Upload Document');
                }
            });
        }

        function renderOrdersList(ordersArray) {
            if (!ordersArray || !Array.isArray(ordersArray) || ordersArray.length === 0) return;

            const ordersSec = document.getElementById('liveEcourtsOrdersSection');
            const ordersList = document.getElementById('listLiveOrders');
            if (document.getElementById('lblLiveOrdersCount')) {
                document.getElementById('lblLiveOrdersCount').textContent = ordersArray.length;
            }
            if (ordersList) ordersList.innerHTML = '';

            const cnr = window.currentActiveCnr || '@(activeCnrNumber ?? "")';
            const caseId = @Model.CaseID;

            ordersArray.forEach((ord, i) => {
                const orderDt = ord.order_date || ord.orderdate || ord.date || ord.date_of_order || ord.judgment_date || '—';
                const orderNo = ord.order_number || ord.order_no || ord.order_type || ord.type || ord.title || ord.order_details || ('Order #' + (i + 1));
                const judgeName = ord.judge_name || ord.judge || ord.court || ord.presiding_officer || '';
                let rawPdf = ord.pdf_url || ord.url || ord.link || ord.download_link || ord.order_pdf || ord.pdf || ord.file_path || ord.pdf_path || '';
                let downloadUrl = ord.download_url || '';

                if (!downloadUrl && rawPdf) {
                    if (rawPdf.startsWith('/ECourts/DownloadOrderPdf')) {
                        downloadUrl = rawPdf;
                        if (!downloadUrl.includes('module=')) downloadUrl += '&module=Labour';
                    } else if (rawPdf.startsWith('/ECourts/ViewOrderPdf')) {
                        downloadUrl = rawPdf.replace('/ECourts/ViewOrderPdf', '/ECourts/DownloadOrderPdf');
                        if (!downloadUrl.includes('module=')) downloadUrl += '&module=Labour';
                    } else {
                        downloadUrl = `/ECourts/DownloadOrderPdf?pdfPath=${encodeURIComponent(rawPdf)}&cnr=${encodeURIComponent(cnr)}&orderNo=${encodeURIComponent(orderNo)}&date=${encodeURIComponent(orderDt)}&caseId=${caseId}&module=Labour`;
                    }
                }

                let viewUrl = rawPdf;
                if (viewUrl && !viewUrl.startsWith('/ECourts/ViewOrderPdf') && !viewUrl.startsWith('data:')) {
                    viewUrl = `/ECourts/ViewOrderPdf?url=${encodeURIComponent(rawPdf)}&cnr=${encodeURIComponent(cnr)}&title=${encodeURIComponent(orderNo)}&date=${encodeURIComponent(orderDt)}&caseId=${caseId}&module=Labour`;
                } else if (viewUrl && viewUrl.startsWith('/ECourts/ViewOrderPdf') && !viewUrl.includes('module=')) {
                    viewUrl += '&module=Labour';
                }

                const safeViewUrl = (viewUrl || '').replace(/'/g, "\\'");
                const safeTitle = (orderNo || '').replace(/'/g, "\\'");
                const safeDt = (orderDt || '').replace(/'/g, "\\'");

                let actionHtml = '<span class="badge bg-light text-muted border">Certified Copy</span>';
                if (rawPdf) {
                    actionHtml = `
                        <div class="d-inline-flex gap-1 align-items-center">
                            <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1 fw-bold rounded-pill" onclick="openOrderInModal('${safeViewUrl}', '${safeTitle}', '${cnr}', '${safeDt}', ${caseId}, '${orderNo}')">
                                <i class="bi bi-eye me-1"></i> View Order
                            </button>
                            <a href="${downloadUrl || viewUrl}" target="_blank" class="btn btn-sm btn-outline-danger px-2 py-1 fw-bold rounded-pill" title="Download Order PDF">
                                <i class="bi bi-download me-1"></i> Download
                            </a>
                        </div>
                    `;
                }

                const itemHtml = `
                    <div class="list-group-item bg-light border-0 rounded-2 mb-2 p-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <strong class="text-dark"><i class="bi bi-file-earmark-pdf text-danger me-1"></i> ${orderNo}</strong>
                            <span class="text-muted ms-2">Date: ${orderDt}</span>
                            ${judgeName ? `<span class="badge bg-secondary ms-2">${judgeName}</span>` : ''}
                        </div>
                        <div>
                            ${actionHtml}
                        </div>
                    </div>
                `;
                if (ordersList) ordersList.insertAdjacentHTML('beforeend', itemHtml);
            });

            if (ordersSec) ordersSec.classList.remove('d-none');
        }

        window.currentActiveCnr = '@(activeCnrNumber ?? "")';

        function onCnrInputChange(input) {
            input.value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            const val = input.value;
            const len = val.length;
            const countBadge = $('#cnrCharCount');
            const helper = $('#cnrHelperText');

            if (len === 0) {
                countBadge.removeClass('bg-success bg-warning bg-danger').addClass('bg-secondary').text('0 / 16 chars');
                helper.html('Format: 6-char establishment code + 6-digit case number + 4-digit year (e.g. <code>KADW200035312025</code>)');
            } else if (len === 16) {
                countBadge.removeClass('bg-secondary bg-warning bg-danger').addClass('bg-success').html('<i class="bi bi-check2"></i> 16 / 16 chars (Complete)');
                helper.html('<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Valid 16-character CNR length. Click <strong>Verify</strong> or <strong>Save & Link CNR</strong>.</span>');
                $('#verifyCnrResult').slideUp();
            } else {
                const remaining = 16 - len;
                countBadge.removeClass('bg-secondary bg-success').addClass('bg-warning text-dark').text(`${len} / 16 chars (${remaining} more needed)`);
                if (len >= 12 && val.endsWith('202')) {
                    helper.html('<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Year needs 4 digits (e.g. 2024, 2025, or 2026). Add the final digit of the year.</span>');
                } else {
                    helper.html(`Format: 6-char court/est code + 6-digit case no + 4-digit year. Need <strong>${remaining}</strong> more character(s).`);
                }
            }
        }

        function openUpdateCnrModal() {
            $('#verifyCnrResult').hide().empty();
            const input = document.getElementById('txtNewCnrNumber');
            if (input) onCnrInputChange(input);
            const modalEl = document.getElementById('updateCnrModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        async function verifyCnrLive() {
            const cnr = ($('#txtNewCnrNumber').val() || '').trim().toUpperCase();
            const resultBox = $('#verifyCnrResult');
            const btn = $('#btnVerifyCnr');

            if (!cnr || cnr.length !== 16) {
                const remaining = 16 - (cnr ? cnr.length : 0);
                resultBox.html(`
                    <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                        <div class="fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>Invalid CNR Length (${cnr.length}/16 characters)</div>
                        <div>A valid eCourts CNR must be exactly 16 characters. You entered <code>${cnr}</code> (${cnr.length} chars).</div>
                        <div class="mt-1">Please add the remaining <strong>${remaining}</strong> character(s) (such as the last digit of the year, e.g. 2024, 2025, or 2026).</div>
                    </div>
                `).slideDown();
                return;
            }

            const isHc = cnr.startsWith('KAHC') || cnr.includes('HC');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Verifying...');
            resultBox.html('<div class="text-muted small py-1"><span class="spinner-border spinner-border-sm text-primary me-1"></span>Checking live eCourts NAPIX Gateway...</div>').slideDown();

            try {
                const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=${isHc}&module=Labour`);
                const data = await res.json();
                if (data.success && data.data) {
                    const s = data.data;
                    resultBox.html(`
                        <div class="alert alert-success py-2 px-3 small mb-0 rounded-3 shadow-sm">
                            <div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i>Verified on eCourts!</div>
                            <div><strong>Court:</strong> ${s.establishment_name || s.court_no_judge || 'eCourts'}</div>
                            <div><strong>Case:</strong> ${s.case_type || ''} ${s.case_number || ''} | <strong>Stage:</strong> ${s.stage || 'N/A'}</div>
                            ${s.next_hearing_date ? `<div><strong>Next Date:</strong> ${s.next_hearing_date}</div>` : ''}
                        </div>
                    `).slideDown();
                } else {
                    resultBox.html(`<div class="alert alert-warning py-2 px-3 small mb-0 rounded-3"><i class="bi bi-exclamation-circle me-1"></i>${data.message || 'Valid 16-digit CNR format, but not yet indexed on live eCourts.'}</div>`).slideDown();
                }
            } catch (e) {
                resultBox.html('<div class="alert alert-info py-2 px-3 small mb-0 rounded-3"><i class="bi bi-info-circle me-1"></i>Gateway test completed. Format is valid. You can save and link.</div>').slideDown();
            } finally {
                btn.prop('disabled', false).html('<i class="bi bi-shield-check me-1"></i> Verify');
            }
        }

        async function submitUpdateCnr() {
            const caseId = $('#updateCnrCaseId').val();
            const cnr = ($('#txtNewCnrNumber').val() || '').trim().toUpperCase();
            const btn = $('#btnSaveCnr');
            const resultBox = $('#verifyCnrResult');

            if (cnr && cnr.length !== 16) {
                const remaining = 16 - cnr.length;
                resultBox.html(`
                    <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                        <div class="fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>CNR Number must be exactly 16 characters</div>
                        <div>You entered <code>${cnr}</code> which is only <strong>${cnr.length}</strong> characters.</div>
                        <div class="mt-1">Please enter the missing <strong>${remaining}</strong> character(s) (e.g. 4-digit filing year like 2024, 2025, or 2026).</div>
                    </div>
                `).slideDown();
                return;
            }

            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

            const token = $('input[name="__RequestVerificationToken"]').first().val();

            try {
                const formData = new FormData();
                formData.append('caseId', caseId);
                formData.append('cnrNumber', cnr);
                if (token) formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Labour/UpdateCnr', {
                    method: 'POST',
                    body: formData
                });

                if (res.redirected || (res.url && res.url.includes('/Account/Login'))) {
                    resultBox.html(`
                        <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Your session expired. Please <a href="/Account/Login" class="alert-link fw-bold">Login again</a> to save changes.
                        </div>
                    `).slideDown();
                    return;
                }

                if (!res.ok) {
                    const errorText = await res.text();
                    resultBox.html(`
                        <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Server error (${res.status}): ${errorText || res.statusText}
                        </div>
                    `).slideDown();
                    return;
                }

                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    const rawText = await res.text();
                    if (rawText.includes('login') || rawText.includes('Login') || rawText.includes('<!DOCTYPE')) {
                        resultBox.html(`
                            <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Your session expired. Please <a href="/Account/Login" class="alert-link fw-bold">Login again</a>.
                            </div>
                        `).slideDown();
                        return;
                    }
                    throw new Error('Unexpected response format from server.');
                }

                const json = await res.json();

                if (json.success) {
                    window.currentActiveCnr = json.cnrNumber || '';

                    const modalEl = document.getElementById('updateCnrModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();

                    $('#displayCnrNumber').text(json.cnrNumber ? json.cnrNumber : 'Not Linked');
                    if (json.estCode) {
                        $('#displayEstCodeWrapper').html(`<small class="text-muted" id="displayEstCode">Est Code: <strong>${json.estCode}</strong></small>`);
                    } else {
                        $('#displayEstCodeWrapper').empty();
                    }

                    if (json.cnrNumber) {
                        $('#details-cnr-badge').html(`
                            <span class="badge bg-success font-monospace fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center text-nowrap">
                                <i class="bi bi-broadcast me-1"></i> CNR: ${json.cnrNumber}
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Copy CNR Number" onclick="navigator.clipboard.writeText('${json.cnrNumber}'); alert('CNR Number copied to clipboard: ${json.cnrNumber}');">
                                <i class="bi bi-clipboard"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                                <i class="bi bi-pencil-square me-1"></i>Update CNR
                            </button>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" id="btnRefreshLabourLive" onclick="event.stopPropagation(); triggerFetchLabourLiveStatus()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status
                            </button>
                        `);
                        triggerFetchLabourLiveStatus();
                    } else {
                        $('#details-cnr-badge').html(`
                            <span class="badge bg-warning text-dark px-3 py-2">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> CNR Not Linked
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="openUpdateCnrModal()">
                                <i class="bi bi-pencil-square me-1"></i>Update CNR
                            </button>
                        `);
                        fetchLiveCnrDetails('', caseId);
                    }

                    alert(json.message || 'CNR Number updated successfully!');
                } else {
                    resultBox.html(`
                        <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i>${json.message || 'Unable to update CNR Number.'}
                        </div>
                    `).slideDown();
                }
            } catch (e) {
                resultBox.html(`
                    <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>An error occurred: ${e.message || e}
                    </div>
                `).slideDown();
            } finally {
                btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Save & Link CNR');
            }
        }

        function unlinkCnrNumber() {
            if (!confirm('Are you sure you want to unlink the CNR Number from this Labour case?')) return;
            $('#txtNewCnrNumber').val('');
            submitUpdateCnr();
        }

        function fetchLiveECourtsDetails() {
            let cnr = window.currentActiveCnr;
            if (!cnr || cnr.trim() === '') {
                cnr = '@(Model.CNRNumber ?? "")';
            }
            if (!cnr || cnr.trim() === '') {
                cnr = '@Html.Raw(!string.IsNullOrWhiteSpace(Model.CO_WP_CNRNumber) ? Model.CO_WP_CNRNumber : !string.IsNullOrWhiteSpace(Model.CO_WA_CNRNumber) ? Model.CO_WA_CNRNumber : !string.IsNullOrWhiteSpace(Model.CO_Claimant_CNRNumber) ? Model.CO_Claimant_CNRNumber : "")';
            }
            queueManualLabourSync(cnr, @Model.CaseID);
        }

        function queueManualLabourSync(cnr, caseId) {
            const msgElem = document.getElementById('live-sync-msg');
            if (msgElem) {
                msgElem.innerHTML = '<span class="text-primary"><span class="spinner-border spinner-border-sm me-1"></span> Queuing Labour case sync with priority...</span>';
            }

            const formData = new FormData();
            formData.append('caseId', caseId);
            formData.append('cnrNumber', cnr);
            formData.append('module', 'Labour');

            fetch('/ECourts/QueueCaseSync', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    if (msgElem) msgElem.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> ' + (data.message || 'Failed to queue sync') + '</span>';
                    return;
                }

                if (msgElem) {
                    msgElem.innerHTML = '<span class="text-info"><span class="spinner-border spinner-border-sm me-1"></span> Sync queued (' + data.status + '). Processing in background...</span>';
                }

                let attempts = 0;
                const pollInterval = setInterval(() => {
                    attempts++;
                    if (attempts > 30) {
                        clearInterval(pollInterval);
                        if (msgElem) msgElem.innerHTML = '<span class="text-warning"><i class="bi bi-clock-history me-1"></i> Sync is taking longer than expected. Refresh page later.</span>';
                        return;
                    }

                    fetch('/ECourts/GetQueueStatus?queueId=' + (data.queueId || 0) + '&caseId=' + caseId + '&module=Labour')
                    .then(r => r.json())
                    .then(statusData => {
                        if (statusData.status === 'Success') {
                            clearInterval(pollInterval);
                            if (msgElem) {
                                msgElem.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Synced with e-Courts! Reloading...</span>';
                            }
                            setTimeout(() => window.location.reload(), 1200);
                        } else if (statusData.status === 'Failed') {
                            clearInterval(pollInterval);
                            if (msgElem) {
                                msgElem.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Sync Failed: ' + (statusData.error || 'e-Courts error') + '</span>';
                            }
                        } else if (msgElem) {
                            msgElem.innerHTML = '<span class="text-info"><span class="spinner-border spinner-border-sm me-1"></span> ' + statusData.status + '... (Attempt ' + attempts + ')</span>';
                        }
                    })
                    .catch(() => {});
                }, 2000);
            })
            .catch(err => {
                if (msgElem) msgElem.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Error connecting to sync queue</span>';
            });
        }

        async function saveAppealCnr(appealType, caseId) {
            const inputId = 'cnrInput_' + appealType;
            const cnr = ($('#' + inputId).val() || '').trim().toUpperCase();
            const updatedBadge = $('#live_updated_' + appealType);

            if (cnr && cnr.length !== 16) {
                alert('High Court CNR Number must be exactly 16 characters (e.g. KAHC010123452023). Current length: ' + cnr.length);
                return;
            }

            if (updatedBadge.length) {
                updatedBadge.removeClass('bg-success-subtle bg-secondary-subtle text-success text-secondary')
                            .addClass('bg-primary-subtle text-primary')
                            .html('<span class="spinner-border spinner-border-sm me-1"></span>Saving CNR...');
            }

            const formData = new FormData();
            formData.append('caseId', caseId);
            formData.append('appealType', appealType);
            formData.append('cnrNumber', cnr);

            try {
                const res = await fetch('/Labour/UpdateAppealCnr', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    if (updatedBadge.length) {
                        updatedBadge.removeClass('bg-primary-subtle text-primary')
                                    .addClass('bg-success-subtle text-success border-success')
                                    .html('<i class="bi bi-check-circle-fill me-1"></i> CNR Saved');
                    }
                    alert(data.message || 'Appeal CNR saved successfully!');
                    if (cnr) {
                        fetchLiveMfaDetails(cnr, caseId, appealType, false);
                    }
                } else {
                    alert(data.message || 'Unable to update Appeal CNR.');
                    if (updatedBadge.length) {
                        updatedBadge.removeClass('bg-primary-subtle text-primary')
                                    .addClass('bg-warning-subtle text-warning border-warning')
                                    .html('<i class="bi bi-exclamation-triangle me-1"></i> Error');
                    }
                }
            } catch (e) {
                console.error('Error saving appeal CNR:', e);
                alert('Network or server error while saving appeal CNR.');
            }
        }

        async function autoLinkAppealCnr(caseId, appealType) {
            const btn = $('#btnAutoLink_' + appealType);
            const oldHtml = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Discovering...');

            let moduleType = 'Labour_WP';
            if (appealType === 'corp_wa') moduleType = 'Labour_WA';
            else if (appealType === 'claimant_wp') moduleType = 'Labour_Claimant';

            const postData = new URLSearchParams();
            postData.append('caseId', caseId);
            postData.append('module', moduleType);

            try {
                const res = await fetch('/ECourts/AutoLinkCnrInline', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: postData.toString()
                });
                const data = await res.json();
                if (data.success && data.cnr) {
                    $('#cnrInput_' + appealType).val(data.cnr);
                    btn.removeClass('btn-outline-primary btn-outline-danger btn-outline-warning').addClass('btn-success').html('<i class="bi bi-check2-circle me-1"></i>Linked!');
                    alert('CNR auto-discovered & linked: ' + data.cnr);
                    fetchLiveMfaDetails(data.cnr, caseId, appealType, false);
                } else {
                    btn.prop('disabled', false).html(oldHtml);
                    alert(data.message || 'Could not auto-discover High Court CNR. Please enter it manually.');
                }
            } catch (e) {
                btn.prop('disabled', false).html(oldHtml);
                alert('Error connecting to eCourts auto-discovery service.');
            }
        }

        let labourNapixLoaded = false;

        function triggerFetchLabourLiveStatus() {
            var collapseEl = document.getElementById('collapseLabourNapixSection');
            if (collapseEl && !collapseEl.classList.contains('show')) {
                var bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseEl);
                bsCollapse.show();
            }
            var activeCnr = (window.currentActiveCnr || '@activeCnrNumber').trim();
            if (activeCnr && activeCnr !== '') {
                if (typeof fetchLiveCnrDetails === 'function') {
                    fetchLiveCnrDetails(activeCnr, @Model.CaseID);
                }
                queueManualLabourSync(activeCnr, @Model.CaseID);
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            window.currentCaseId = @Model.CaseID;
            window.lastCaseId = @Model.CaseID;

            const labourCollapseEl = document.getElementById('collapseLabourNapixSection');
            if (labourCollapseEl) {
                labourCollapseEl.addEventListener('show.bs.collapse', function () {
                    const icon = document.getElementById('iconToggleLabourNapix');
                    const text = document.getElementById('textToggleLabourNapix');
                    if (icon) { icon.classList.remove('bi-chevron-down'); icon.classList.add('bi-chevron-up'); }
                    if (text) { text.textContent = 'Hide NAPIX Details'; }
                });

                labourCollapseEl.addEventListener('hide.bs.collapse', function () {
                    const icon = document.getElementById('iconToggleLabourNapix');
                    const text = document.getElementById('textToggleLabourNapix');
                    if (icon) { icon.classList.remove('bi-chevron-up'); icon.classList.add('bi-chevron-down'); }
                    if (text) { text.textContent = 'View NAPIX Details'; }
                });
            }

            const higherCourtsCollapseEl = document.getElementById('collapseHigherCourtsSection');
            if (higherCourtsCollapseEl) {
                higherCourtsCollapseEl.addEventListener('show.bs.collapse', function () {
                    const icon = document.getElementById('iconToggleHigherCourts');
                    const text = document.getElementById('textToggleHigherCourts');
                    if (icon) { icon.classList.remove('bi-chevron-down'); icon.classList.add('bi-chevron-up'); }
                    if (text) { text.textContent = 'Hide Higher Courts Details'; }
                });

                higherCourtsCollapseEl.addEventListener('hide.bs.collapse', function () {
                    const icon = document.getElementById('iconToggleHigherCourts');
                    const text = document.getElementById('textToggleHigherCourts');
                    if (icon) { icon.classList.remove('bi-chevron-up'); icon.classList.add('bi-chevron-down'); }
                    if (text) { text.textContent = 'View Higher Courts Details'; }
                });
            }
        });
    </script>
}
