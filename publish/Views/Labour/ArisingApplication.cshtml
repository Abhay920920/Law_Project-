@model IEnumerable<MVCCaseManagement.Models.ArisingApplication>
@{
    ViewData["Title"] = "Arising Applications";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int divisionId = ViewBag.DivisionID ?? 0;
    bool isCO = (divisionId == 0 || divisionId == 5);
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 20;
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = pageSize > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
}

<div class="container-fluid py-4 fade-in arising-page">

    <!-- Page Title Bar -->
    <div class="page-title-bar d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Labour")" class="text-decoration-none">Labour Module</a></li>
                    <li class="breadcrumb-item active fw-semibold">Arising Applications</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-layers-half text-primary me-2"></i>Arising Applications
            </h1>
            <p class="text-muted small mb-0 mt-1">Applications arising out of original Labour cases — filed before High Court / Supreme Court</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="@Url.Action("CreateArisingApplication", "Labour")" class="btn btn-primary rounded-pill shadow-sm px-4 fw-semibold">
                <i class="bi bi-plus-circle-fill me-2"></i>New Application
            </a>
        </div>
    </div>

    <!-- Stats + Search Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card total">
                <div class="stat-icon">
                    <i class="bi bi-collection-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Total Applications</div>
                    <div class="stat-value">@totalCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card pending">
                <div class="stat-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="stat-label">Pending</div>
                    <div class="stat-value">@(Model?.Count(x => x.CaseStatus == "Pending") ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card disposed">
                <div class="stat-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Disposed</div>
                    <div class="stat-value">@(Model?.Count(x => x.CaseStatus == "Disposed") ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card hearing">
                <div class="stat-icon">
                    <i class="bi bi-shield-check text-warning"></i>
                </div>
                <div>
                    <div class="stat-label">CO Action / WP Filed</div>
                    <div class="stat-value">@(Model?.Count(x => !string.IsNullOrEmpty(x.CO_WP_CaseNumber) || !string.IsNullOrEmpty(x.CO_ActionTaken) || x.SentToCO) ?? 0)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3 px-4">
            <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
                <div class="input-group rounded-pill border overflow-hidden shadow-sm flex-grow-1" style="max-width:540px;">
                    <span class="input-group-text bg-white border-0 ps-3 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control border-0 ps-1"
                           placeholder="Search by case number, WP/WA number, petitioner, CO action...">
                    <button class="btn btn-primary border-0 px-4 fw-semibold rounded-0" type="submit">Search</button>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a href="@Url.Action("ArisingApplication")" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </a>
                }
                <span class="text-muted small ms-auto">
                    Showing <strong>@(Model?.Count() ?? 0)</strong> of <strong>@totalCount</strong> results
                </span>
            </form>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-table me-2 text-primary"></i>Application Records
            </h6>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@totalCount Total</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 arising-table">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 5%; min-width: 60px;">#</th>
                        <th style="width: 25%; min-width: 200px;">Case Identification &amp; Appeals</th>
                        <th style="width: 15%; min-width: 150px;">Petitioner / Applicant</th>
                        <th style="width: 15%; min-width: 150px;">Original / Parent Case</th>
                        <th style="width: 15%; min-width: 160px;">Entrustment &amp; Stage</th>
                        <th style="width: 15%; min-width: 160px;">Status &amp; CO Action</th>
                        <th class="text-end pe-4" style="width: 10%; min-width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int sno = ((pageNumber - 1) * pageSize) + 1;
                        foreach (var item in Model)
                        {
                            <tr class="arising-row">
                                <td class="ps-4 text-muted small fw-semibold">@sno</td>
                                <td>
                                    <div class="data-id font-monospace">@item.CaseNumber / @item.CaseYear</div>
                                    <div class="location-text text-muted">
                                        <i class="bi bi-building me-1"></i>@item.CourtName
                                    </div>
                                    <div class="location-text text-muted">
                                        <i class="bi bi-diagram-2 me-1"></i>@item.DivisionName
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.CO_WP_CaseNumber))
                                    {
                                        <div class="small fw-bold text-danger mt-1">
                                            <i class="bi bi-file-earmark-text-fill me-1"></i>WP @item.CO_WP_CaseNumber / @(item.CO_WP_Year?.ToString() ?? "-") @(!string.IsNullOrEmpty(item.CO_WP_HighCourtBench) ? $"({item.CO_WP_HighCourtBench})" : "")
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CO_WA_CaseNumber))
                                    {
                                        <div class="small fw-bold text-primary mt-1">
                                            <i class="bi bi-diagram-3-fill me-1"></i>WA @item.CO_WA_CaseNumber / @(item.CO_WA_Year?.ToString() ?? "-")
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.PetitionerName</div>
                                    @if (item.NextHearingDate.HasValue)
                                    {
                                        <div class="small mt-1">
                                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">
                                                <i class="bi bi-calendar-event me-1"></i>@item.NextHearingDate.Value.ToString("dd MMM yyyy")
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="data-id font-monospace text-primary">
                                        <i class="bi bi-link-45deg me-1"></i>@item.Parent_CaseNumber / @item.Parent_CaseYear
                                    </div>
                                    <div class="location-text text-muted">@item.Parent_CourtName</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.EntrustmentNo))
                                    {
                                        <div class="small text-muted">
                                            <i class="bi bi-file-earmark-text me-1"></i><strong>Ent:</strong> @item.EntrustmentNo
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CO_WP_AdvocateName))
                                    {
                                        <div class="small text-muted">
                                            <i class="bi bi-person-badge me-1"></i><strong>WP Adv:</strong> @item.CO_WP_AdvocateName
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CurrentStage))
                                    {
                                        <div class="small fw-semibold text-dark mt-1">@item.CurrentStage</div>
                                    }
                                    <div class="d-flex gap-1 mt-1 flex-wrap">
                                        @if (item.IsDocumentSent)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill" style="font-size:.65rem;">Doc Sent</span>
                                        }
                                        @if (item.IsObjectionFiled)
                                        {
                                            <span class="badge bg-purple-subtle rounded-pill" style="font-size:.65rem;">Obj Filed</span>
                                        }
                                        @if (item.CO_WP_StayGranted == true)
                                        {
                                            <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill" style="font-size:.65rem;">WP Stay</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var statusClass = item.CaseStatus switch {
                                            "Disposed" => "bg-success-subtle text-success-emphasis",
                                            "Pending" => "bg-warning-subtle text-warning-emphasis",
                                            _ => "bg-secondary-subtle text-secondary-emphasis"
                                        };
                                    }
                                    <span class="badge @statusClass rounded-pill px-3">@item.CaseStatus</span>
                                    @if (!string.IsNullOrEmpty(item.CO_ActionTaken))
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1" style="font-size: 0.65rem;" title="Central Office Action">
                                                <i class="bi bi-shield-check me-1"></i>@item.CO_ActionTaken
                                            </span>
                                        </div>
                                    }
                                    else if (item.SentToCO)
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                                                <i class="bi bi-building me-1"></i>Sent to CO
                                            </span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CO_WP_Status))
                                    {
                                        <div class="mt-1">
                                            <span class="badge @(item.CO_WP_Status == "Disposed" ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis") rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                                                WP: @item.CO_WP_Status
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="@Url.Action("DetailsArisingApplication", "Labour", new { id = item.ArisingID })"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3" title="View Details">
                                            <i class="bi bi-eye-fill me-1"></i>View
                                        </a>
                                        @if (!isCO && item.SentToCO != true)
                                        {
                                            <a href="@Url.Action("EditArisingApplication", "Labour", new { id = item.ArisingID })"
                                               class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Edit">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </a>
                                            <form method="post" action="@Url.Action("DeleteArisingApplication", "Labour", new { id = item.ArisingID })" onsubmit="return confirm('Are you sure you want to delete Arising Application @item.CaseNumber / @item.CaseYear?');" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete">
                                                    <i class="bi bi-trash-fill me-1"></i>Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                            sno++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-folder-x fs-1 d-block mb-3 text-muted opacity-50"></i>
                                <h6 class="text-muted fw-semibold">No Arising Applications Found</h6>
                                <p class="text-muted small mb-3">
                                    @if (!string.IsNullOrEmpty(ViewBag.Search as string)) {
                                        <span>No results for "<strong>@ViewBag.Search</strong>". Try different keywords.</span>
                                    } else {
                                        <span>No applications have been registered yet.</span>
                                    }
                                </p>
                                <a href="@Url.Action("CreateArisingApplication", "Labour")" class="btn btn-primary rounded-pill px-4">
                                    <i class="bi bi-plus-circle me-2"></i>Add Application
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-muted">
                    Page <strong>@pageNumber</strong> of <strong>@totalPages</strong> — @totalCount total records
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill border-0 shadow-sm px-3" href="@Url.Action("ArisingApplication", new { pageNumber = pageNumber - 1, search = ViewBag.Search })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, pageNumber - 2); i <= Math.Min(totalPages, pageNumber + 2); i++)
                        {
                            <li class="page-item @(pageNumber == i ? "active" : "")">
                                <a class="page-link rounded-pill border-0 shadow-sm px-3" href="@Url.Action("ArisingApplication", new { pageNumber = i, search = ViewBag.Search })">@i</a>
                            </li>
                        }
                        <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill border-0 shadow-sm px-3" href="@Url.Action("ArisingApplication", new { pageNumber = pageNumber + 1, search = ViewBag.Search })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Styles {
<style>
    .arising-page { background-color: #f8f9fa; min-height: 100vh; }

    /* Page Title */
    .page-title-bar .breadcrumb { font-size: 0.8rem; }

    /* Stat Cards */
    .stat-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 16px 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
        transition: all .3s ease;
        position: relative;
        overflow: hidden;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1); }
    
    .stat-card.total { background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border-top: 4px solid #0d6efd; }
    .stat-card.pending { background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-top: 4px solid #f59e0b; }
    .stat-card.disposed { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-top: 4px solid #10b981; }
    .stat-card.hearing { background: linear-gradient(135deg, #fdf4ff 0%, #fae8ff 100%); border-top: 4px solid #d946ef; }

    .stat-icon {
        width: 44px; height: 44px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
        background: #fff;
        box-shadow: 0 2px 5px rgba(0,0,0,.05);
    }
    
    .stat-card.total .stat-icon { color: #0d6efd; }
    .stat-card.pending .stat-icon { color: #f59e0b; }
    .stat-card.disposed .stat-icon { color: #10b981; }
    .stat-card.hearing .stat-icon { color: #d946ef; }

    .stat-label { 
        font-size: 0.72rem; 
        color: #000000 !important; 
        font-weight: 800 !important; 
        text-transform: uppercase; 
        letter-spacing: .05em; 
    }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #212529; line-height: 1.1; }

    /* Data Typography */
    .data-id {
        font-family: var(--bs-font-monospace);
        font-weight: 700;
        color: #1e293b;
        font-size: 0.95rem;
    }

    .location-text {
        font-size: 0.8rem;
        line-height: 1.3;
    }

    /* Table */
    .arising-table thead tr {
        background: #f1f3f6;
    }
    .arising-table thead th {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #495057;
        border-bottom: 2px solid #dee2e6;
        padding: 12px 10px;
        white-space: nowrap;
    }
    .arising-table tbody td {
        padding: 14px 10px;
        border-bottom: 1px solid #f1f3f6;
        vertical-align: middle;
    }
    .arising-row { transition: background .15s; }
    .arising-row:hover { background-color: #f0f7ff !important; }
    .arising-row:last-child td { border-bottom: none; }

    /* Badges */
    .bg-purple-subtle { background-color: #ede9fe; color: #5b21b6; }
    .bg-info-subtle { background-color: #e0f2fe; color: #0369a1; }

    /* Pagination */
    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }
    .pagination .page-link { color: #0d6efd; }

    /* Buttons */
    .btn-outline-primary:hover { background-color: #0d6efd; color: #fff; }
</style>
}
