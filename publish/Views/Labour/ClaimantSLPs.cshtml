@model IEnumerable<MVCCaseManagement.Models.LabourCase>

@{
    ViewData["Title"] = "Claimant Supreme Court SLP ";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid fade-in py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="bi bi-bank text-primary me-2"></i>Claimant Supreme Court SLP 
            </h1>
            <p class="text-muted small mb-0">Manage Special Leave Petitions (SLP) in Supreme Court filed for WA/WP</p>
        </div>
        <div>
            <a href="@Url.Action("ManageClaimantSLP", "Labour")" class="btn btn-primary rounded-pill shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Register New SLP/Appeal
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">SLP / Diary Number</th>
                            <th>Parent WP/WA</th>
                            <th>Petitioner Name</th>
                            <th>Filed By</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        @if (!string.IsNullOrEmpty(item.ClaimantSCNumber))
                                        {
                                            <span>SLP @item.ClaimantSCNumber / @item.ClaimantSCYear</span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.ClaimantSCDiaryNumber))
                                        {
                                            <span class="text-info">Diary @item.ClaimantSCDiaryNumber / @item.ClaimantSCYear</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning">Pending Filing</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CO_WA_CaseNumber))
                                        {
                                            <div class="small fw-bold">WA: @item.CO_WA_CaseNumber / @item.CO_WA_Year</div>
                                        }
                                        else if (!string.IsNullOrEmpty(item.CO_Claimant_CaseNumber))
                                        {
                                            <div class="small fw-bold">WP: @item.CO_Claimant_CaseNumber / @item.CO_Claimant_CaseYear</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">--</span>
                                        }
                                    </td>
                                    <td>@item.PetitionerName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.ClaimantSCFiledBy</span>
                                    </td>
                                    <td>
                                        @if (item.ClaimantSCStatus == "Disposed")
                                        {
                                            <span class="badge bg-success-subtle text-success">Disposed (@item.ClaimantSCOutcome)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary">@item.ClaimantSCStatus</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@Url.Action("ManageClaimantSLP", "Labour", new { id = item.CaseID })" class="btn btn-sm btn-outline-primary rounded-circle" title="Edit/View SLP">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    No Supreme Court SLP records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
