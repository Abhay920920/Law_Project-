@model MVCCaseManagement.Controllers.ApiDashboardVm
@{
    ViewData["Title"] = "NAPIX API Quota Dashboard";
    ViewData["HidePageHeader"] = true; // Prevents duplicate layout header
    Layout = "~/Views/Shared/_Layout.cshtml";

    double pct = Model.UsedPercent;
    string barGradient = pct < 60 
        ? "linear-gradient(90deg, #10b981 0%, #059669 100%)" 
        : pct < 85 
            ? "linear-gradient(90deg, #f59e0b 0%, #d97706 100%)" 
            : "linear-gradient(90deg, #ef4444 0%, #dc2626 100%)";

    string statusBadge = pct < 60 ? "HEALTHY (SAFE)" : pct < 85 ? "WARNING (ELEVATED)" : "CRITICAL (THROTTLED)";
    string statusBadgeClass = pct < 60 ? "bg-success" : pct < 85 ? "bg-warning text-dark" : "bg-danger";
    string statusTextClass = pct < 60 ? "text-success" : pct < 85 ? "text-warning" : "text-danger";

    // 60-minute sparkline mapping
    var minuteMap = Model.MinuteTrend.ToDictionary(m => m.Hour * 60 + m.Minute, m => m.CallCount);
    var nowIst = DateTime.UtcNow.AddHours(5).AddMinutes(30);
    var sparkLabels = new List<string>();
    var sparkData = new List<int>();
    for (int i = 59; i >= 0; i--)
    {
        var slot = nowIst.AddMinutes(-i);
        int key = slot.Hour * 60 + slot.Minute;
        sparkLabels.Add(slot.ToString("HH:mm"));
        sparkData.Add(minuteMap.TryGetValue(key, out var v) ? v : 0);
    }

    // Hourly bar chart (24h)
    var hourlyLabels = Model.HourlyTrend.Select(h => $"{h.Date:dd MMM} {h.Hour:00}:00").ToList();
    var hourlyCounts = Model.HourlyTrend.Select(h => h.CallCount).ToList();

    double ratePerMin = Model.MinuteTrend.Count > 0 ? Model.MinuteTrend.Average(m => m.CallCount) : 0;
    int peakMinute = Model.MinuteTrend.Count > 0 ? Model.MinuteTrend.Max(m => m.CallCount) : 0;
    int todayTotal = Model.HourlyTrend.Sum(h => h.CallCount);
}

@section Styles {
    <style>
        .quota-glass-header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-radius: 1.25rem;
            padding: 1.25rem 1.75rem;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(226, 232, 240, 0.8);
            box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.05);
        }

        .quota-hero-card {
            background: #ffffff;
            border-radius: 1.25rem;
            padding: 1.75rem;
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.06);
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .quota-hero-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: @barGradient;
        }

        /* Top 5 Stat Cards - Aligned with Application Dashboard */
        .stat-card-gradient {
            border-radius: 1.25rem;
            padding: 1.2rem 1.25rem;
            color: white;
            position: relative;
            overflow: hidden;
            height: 100%;
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            border: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 115px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        }
        .stat-card-gradient:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(0, 0, 0, 0.15);
        }
        .stat-card-gradient .label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 0.3rem;
            opacity: 0.92;
            z-index: 1;
        }
        .stat-card-gradient .value {
            font-size: 2.1rem;
            font-weight: 900;
            line-height: 1;
            margin: 0.2rem 0;
            z-index: 1;
            font-family: 'Outfit', sans-serif;
        }
        .stat-card-gradient .icon-btm {
            font-size: 1.15rem;
            margin-top: 0.3rem;
            opacity: 0.8;
            z-index: 1;
        }
        .stat-card-gradient .bg-circle {
            position: absolute;
            top: -15px;
            right: -15px;
            width: 95px;
            height: 95px;
            background: rgba(255, 255, 255, 0.16);
            border-radius: 50%;
            z-index: 0;
        }

        .bg-grad-green  { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
        .bg-grad-red    { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
        .bg-grad-blue   { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); }
        .bg-grad-orange { background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%); }
        .bg-grad-indigo { background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%); }

        /* Progress Bar Enhancements */
        .progress-track-wrapper {
            background: #f1f5f9;
            border-radius: 999px;
            height: 18px;
            padding: 3px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.04);
        }
        .progress-bar-animated-smooth {
            height: 100%;
            border-radius: 999px;
            background: @barGradient;
            transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        /* Glass Panel for Charts & Tables */
        .analytics-card {
            background: #ffffff;
            border-radius: 1.25rem;
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 4px 18px -2px rgba(15, 23, 42, 0.05);
            overflow: hidden;
            height: 100%;
        }
        .analytics-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #f1f5f9;
            padding: 1.1rem 1.4rem;
        }

        .live-dot-pulse {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            display: inline-block;
            background-color: #10b981;
            animation: livePulse 1.4s infinite;
        }
        @@keyframes livePulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1.15); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .table-responsive {
            max-height: 480px;
            overflow-y: auto;
        }
        .table-custom thead th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 0.73rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 1px solid #e2e8f0;
            padding: 11px 16px;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .table-custom tbody td {
            padding: 12px 16px;
            font-size: 0.83rem;
            color: #1e293b;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }
        .table-custom tbody tr:hover td {
            background-color: #f8fafc;
        }

        .code-pill {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 0.78rem;
            padding: 3px 8px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #e2e8f0;
        }
    </style>
}

<div class="container-fluid px-0">

    <!-- ── 1. Top Glass Header & Navigation ─────────────────────────────── -->
    <div class="quota-glass-header">
        <div class="row align-items-center">
            <div class="col-lg-7 col-md-6 mb-3 mb-md-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none text-primary"><i class="bi bi-house-door me-1"></i>Home</a></li>
                        <li class="breadcrumb-item"><span class="text-secondary">Administration</span></li>
                        <li class="breadcrumb-item active fw-semibold text-dark">NAPIX API Dashboard</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center gap-3 mt-1">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-speedometer2 fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0 font-outfit" style="letter-spacing: -0.02em;">NAPIX API Quota & Rate Limit Monitor</h3>
                        <p class="text-secondary mb-0 small">
                            eCourts National API Portal • Subscription Window: <strong>1,000 calls / rolling 60 minutes</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-6">
                <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                    <!-- Live indicator -->
                    <div class="d-inline-flex align-items-center bg-light px-3 py-2 rounded-pill border shadow-sm">
                        <span class="live-dot-pulse me-2" id="liveDot"></span>
                        <span class="small fw-bold text-dark" id="liveStatusText">Live Feed Active</span>
                        <span class="mx-2 text-muted opacity-50">|</span>
                        <span class="small text-secondary" id="lastUpdatedTime">@DateTime.Now.ToString("HH:mm:ss") IST</span>
                    </div>

                    <!-- Auto-Refresh Toggle -->
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" id="btnAutoRefresh" onclick="toggleAutoRefresh()">
                        <i class="bi bi-arrow-repeat" id="autoRefreshIcon"></i>
                        <span id="autoRefreshText">Auto: 15s</span>
                    </button>

                    <!-- Manual Refresh Form -->
                    <form method="post" action="/ApiDashboard/ResetCache" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" title="Clears in-memory count cache and queries fresh from DB">
                            <i class="bi bi-arrow-clockwise"></i>
                            <span>Reset Cache</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 2. Error / Warning Banners ───────────────────────────────────── -->
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4" role="alert" style="border-left: 5px solid #ef4444 !important;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                <div class="flex-grow-1">
                    <h6 class="alert-heading fw-bold mb-1">Database Schema Notice</h6>
                    <p class="mb-0 small">@Model.Error</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (pct >= 85 && string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4" role="alert" style="background: linear-gradient(to right, #fef3c7, #fff); border-left: 5px solid #f59e0b !important;">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-fill-exclamation fs-3 me-3 text-warning"></i>
                <div>
                    <h6 class="alert-heading fw-bold mb-1 text-dark">
                        @(pct >= 100 ? "🚨 Quota Depleted — Outbound NAPIX Calls Paused" : "⚠️ High API Consumption Detected")
                    </h6>
                    <p class="mb-0 small text-secondary">
                        @Model.TotalCallsThisHour of @Model.HourlyQuota calls used in the last 60 minutes (@pct.ToString("F1")%). 
                        @(pct >= 100 ? "New calls are temporarily rejected to avoid supplier penalties until older calls slide out of the rolling hour window." : $"Only {Model.RemainingQuota} calls remaining before rate limiting kicks in.")
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- ── 3. Hero Quota Status Card ────────────────────────────────────── -->
    <div class="quota-hero-card mb-4">
        <div class="row align-items-center">
            <!-- Left: Numbers and Gauge -->
            <div class="col-lg-8 col-md-7 pe-lg-4 border-end-md">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <div>
                        <span class="text-uppercase text-secondary fw-bold small letter-spacing-1">Current Rolling Hour Quota</span>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <span class="display-5 fw-black text-dark font-outfit" id="metricTotalCalls">@Model.TotalCallsThisHour</span>
                            <span class="fs-4 text-muted fw-semibold">/ @Model.HourlyQuota</span>
                            <span class="badge @statusBadgeClass rounded-pill ms-2 px-3 py-2 small fw-bold" id="badgeStatus">@statusBadge</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="display-6 fw-bold @statusTextClass font-outfit" id="metricPercent">@pct.ToString("F1")%</span>
                        <div class="small text-muted">Window Capacity Used</div>
                    </div>
                </div>

                <!-- Modern Progress Track -->
                <div class="progress-track-wrapper my-3">
                    <div class="progress-bar-animated-smooth" id="heroProgressBar" style="width: @(Math.Min(pct, 100).ToString("F1"))%;"></div>
                </div>

                <!-- Scale Legend -->
                <div class="d-flex justify-content-between text-muted small fw-semibold">
                    <span><i class="bi bi-record-circle me-1 text-success"></i>0 (Start)</span>
                    <span class="d-none d-sm-inline">250 (25%)</span>
                    <span>500 (50% Halfway)</span>
                    <span class="d-none d-sm-inline">750 (75%)</span>
                    <span><i class="bi bi-shield-lock me-1 text-danger"></i>1,000 (100% Quota Cap)</span>
                </div>
            </div>

            <!-- Right: Rolling Window Details -->
            <div class="col-lg-4 col-md-5 ps-lg-4 mt-4 mt-md-0">
                <div class="bg-light p-3 rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary text-uppercase">Immediate Capacity</span>
                        <i class="bi bi-hourglass-split text-primary fs-5"></i>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-black text-dark mb-0 font-outfit" id="metricRemainingQuota">@Model.RemainingQuota</h2>
                        <span class="small text-muted fw-semibold">calls available now</span>
                    </div>
                    <hr class="my-2 border-secondary opacity-10">
                    <p class="small text-secondary mb-0" style="line-height: 1.45;">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        The quota uses a <strong>continuous rolling 60-minute window</strong>. Every API call automatically falls off exactly 60 minutes after it occurred, releasing quota steadily.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 4. Key Performance KPI Cards (5 Cards) ───────────────────────── -->
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 mb-4">
        <!-- 1. Successful Calls -->
        <div class="col">
            <div class="stat-card-gradient bg-grad-green">
                <div class="bg-circle"></div>
                <div class="label">Successful (1h)</div>
                <div class="value" id="cardSuccessCalls">@Model.SuccessfulCalls</div>
                <span class="small text-white-50">HTTP 200 OK</span>
                <i class="bi bi-check2-circle icon-btm"></i>
            </div>
        </div>

        <!-- 2. Failed Calls -->
        <div class="col">
            <div class="stat-card-gradient bg-grad-red">
                <div class="bg-circle"></div>
                <div class="label">Failed / Errs (1h)</div>
                <div class="value" id="cardFailedCalls">@Model.FailedCalls</div>
                <span class="small text-white-50">4xx / 5xx / Timeouts</span>
                <i class="bi bi-exclamation-octagon icon-btm"></i>
            </div>
        </div>

        <!-- 3. Velocity Rate -->
        <div class="col">
            <div class="stat-card-gradient bg-grad-blue">
                <div class="bg-circle"></div>
                <div class="label">Avg Rate / Min</div>
                <div class="value" id="cardRatePerMin">@ratePerMin.ToString("F1")</div>
                <span class="small text-white-50">Calls/min (last 60m)</span>
                <i class="bi bi-activity icon-btm"></i>
            </div>
        </div>

        <!-- 4. Peak Minute Activity -->
        <div class="col">
            <div class="stat-card-gradient bg-grad-orange">
                <div class="bg-circle"></div>
                <div class="label">Peak Minute</div>
                <div class="value" id="cardPeakMinute">@peakMinute</div>
                <span class="small text-white-50">Max burst in 1 min</span>
                <i class="bi bi-fire icon-btm"></i>
            </div>
        </div>

        <!-- 5. 24h Volume -->
        <div class="col">
            <div class="stat-card-gradient bg-grad-indigo">
                <div class="bg-circle"></div>
                <div class="label">Today's Total (24h)</div>
                <div class="value" id="cardTodayTotal">@todayTotal</div>
                <span class="small text-white-50">Cumulative volume</span>
                <i class="bi bi-calendar2-check icon-btm"></i>
            </div>
        </div>
    </div>

    <!-- ── Staged Backfill & Persistent Queue Management (8,000 Cases) ── -->
    <div class="analytics-card mb-4 border-primary shadow-sm" style="border: 2px solid rgba(13, 110, 253, 0.25) !important;">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center py-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-stack text-primary me-2"></i>e-Courts 8,000 Cases Staged Backfill & Queue Controller
                </h5>
                <small class="text-secondary">
                    Dual Concurrency-Safe Workers: <strong>MVC (1,000/hr)</strong> | <strong>Labour (1,000/hr)</strong> &bull; Authoritative <code>pend_disp</code> &bull; Idempotent Enqueuing
                </small>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
                <button type="button" class="btn btn-outline-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" id="btnDryRun" onclick="runDryRun()">
                    <i class="bi bi-clipboard2-pulse"></i>
                    <span>Run Dry Run Analysis</span>
                </button>
                <button type="button" class="btn btn-success rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" id="btnPilot10" onclick="queueBatch('Pilot10')">
                    <i class="bi bi-play-circle"></i>
                    <span>Step 1: Pilot (10+10)</span>
                </button>
                <button type="button" class="btn btn-warning rounded-pill px-3 shadow-sm d-flex align-items-center gap-1 text-dark" id="btnStaged100" onclick="queueBatch('Staged100')">
                    <i class="bi bi-fast-forward-circle"></i>
                    <span>Step 2: Staged (100+100)</span>
                </button>
                <button type="button" class="btn btn-danger rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" id="btnFullBackfill" onclick="queueBatch('Full')">
                    <i class="bi bi-rocket-takeoff"></i>
                    <span>Step 3: Full Backfill</span>
                </button>
            </div>
        </div>
        <div class="card-body p-4 bg-light bg-opacity-50">
            <!-- Dry Run / Workload Metrics -->
            <div class="row g-3 mb-3" id="dryRunMetricsRow">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-primary small text-uppercase"><i class="bi bi-car-front me-1"></i>MVC Module Workload</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill" id="badgeMvcSynced">Synced: —</span>
                        </div>
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 border rounded-3 bg-light">
                                    <div class="small text-secondary">With CNR</div>
                                    <div class="fw-bold fs-6" id="dryMvcWithCnr">—</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded-3 bg-light">
                                    <div class="small text-secondary">To Sync</div>
                                    <div class="fw-bold fs-6 text-danger" id="dryMvcEligible">—</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded-3 bg-light">
                                    <div class="small text-secondary">Active Q</div>
                                    <div class="fw-bold fs-6 text-info" id="dryMvcQueue">—</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted d-flex justify-content-between">
                            <span>Authoritative Disposed: <strong id="dryMvcDisposed">—</strong></span>
                            <span>Pending: <strong id="dryMvcPending">—</strong></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-success small text-uppercase"><i class="bi bi-person-workspace me-1"></i>Labour Module Workload</span>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill" id="badgeLabourSynced">Synced: —</span>
                        </div>
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 border rounded-3 bg-light">
                                    <div class="small text-secondary">With CNR</div>
                                    <div class="fw-bold fs-6" id="dryLabourWithCnr">—</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded-3 bg-light">
                                    <div class="small text-secondary">To Sync</div>
                                    <div class="fw-bold fs-6 text-danger" id="dryLabourEligible">—</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded-3 bg-light">
                                    <div class="small text-secondary">Active Q</div>
                                    <div class="fw-bold fs-6 text-info" id="dryLabourQueue">—</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted d-flex justify-content-between">
                            <span>Authoritative Disposed: <strong id="dryLabourDisposed">—</strong></span>
                            <span>Pending: <strong id="dryLabourPending">—</strong></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-indigo small text-uppercase"><i class="bi bi-speedometer me-1"></i>Estimated Completion</span>
                            <span class="badge bg-dark rounded-pill">Realistic Latency</span>
                        </div>
                        <div class="text-center py-2">
                            <div class="display-6 fw-bold text-dark font-outfit" id="dryEstimatedHours">—</div>
                            <div class="small text-muted" id="dryEstimatedDetail">Click 'Run Dry Run Analysis' to inspect actual remaining cases and throughput.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Staged Backfill Status Banner / Feedback -->
            <div id="backfillActionAlert" class="alert alert-secondary mb-0 rounded-3 d-flex align-items-center d-none">
                <div class="spinner-border spinner-border-sm me-2 text-primary" role="status" id="backfillSpinner"></div>
                <div id="backfillActionText" class="small fw-semibold">Ready.</div>
            </div>
        </div>
    </div>

    <!-- ── 5. Analytics Charts Row ──────────────────────────────────────── -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Per-minute sparkline -->
        <div class="col-lg-7">
            <div class="analytics-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-primary me-2"></i>Minute-by-Minute Velocity (Last 60 Minutes)</h6>
                        <small class="text-secondary">Shows real-time request bursts and rolling volume evolution</small>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 small">Rolling 60m</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="sparkChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Hourly Distribution -->
        <div class="col-lg-5">
            <div class="analytics-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-fill text-info me-2"></i>24-Hour Hourly Call Volume</h6>
                        <small class="text-secondary">Aggregated consumption across today's hours</small>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1 small">24h History</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="hourlyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 6. Endpoint Distribution Table ───────────────────────────────── -->
    <div class="analytics-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-diagram-3-fill text-primary me-2"></i>API Endpoint Usage Breakdown (Current Rolling Hour)</h6>
                <small class="text-secondary">Distribution of calls, status rates, and average latency by eCourts service method</small>
            </div>
            <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 small">@Model.EndpointBreakdown.Count Endpoints Active</span>
        </div>
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>NAPIX Service Endpoint</th>
                        <th class="text-center">Total Calls</th>
                        <th class="text-center">Success</th>
                        <th class="text-center">Failed</th>
                        <th class="text-center">Avg Latency</th>
                        <th style="min-width: 140px;">Window Share</th>
                    </tr>
                </thead>
                <tbody id="endpointTableBody">
                    @if (Model.EndpointBreakdown.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary opacity-50"></i>
                                No API calls recorded in the current rolling hour window.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ep in Model.EndpointBreakdown)
                        {
                            double epShare = Model.TotalCallsThisHour > 0 ? (ep.TotalCalls * 100.0 / Model.TotalCallsThisHour) : 0;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-cpu text-primary me-2"></i>
                                        <span class="code-pill fw-semibold">@ep.Endpoint</span>
                                    </div>
                                </td>
                                <td class="text-center fw-bold">@ep.TotalCalls</td>
                                <td class="text-center text-success fw-semibold">
                                    <i class="bi bi-check2"></i> @ep.SuccessCalls
                                </td>
                                <td class="text-center text-danger fw-semibold">
                                    @if (ep.FailedCalls > 0)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">@ep.FailedCalls</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(ep.AvgDurationMs < 600 ? "bg-success bg-opacity-10 text-success" : ep.AvgDurationMs < 1500 ? "bg-warning bg-opacity-10 text-warning" : "bg-danger bg-opacity-10 text-danger") rounded-pill px-2 py-1">
                                        @ep.AvgDurationMs ms
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; border-radius: 999px;">
                                            <div class="progress-bar bg-primary" style="width: @epShare.ToString("F0")%;"></div>
                                        </div>
                                        <small class="text-muted fw-semibold" style="width: 35px;">@epShare.ToString("F0")%</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── 7. Recent 50 NAPIX API Calls (Real-Time Audit Trail) ─────────── -->
    <div class="analytics-card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Recent NAPIX API Invocations (Last 50 Calls)</h6>
                <small class="text-secondary">Granular audit log of case searches, cause list lookups, and CNR queries</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 240px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-start-0" id="tableFilterInput" placeholder="Filter calls (CNR, User)..." onkeyup="filterRecentCalls()">
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0" id="recentCallsTable">
                <thead>
                    <tr>
                        <th style="width: 80px;"># ID</th>
                        <th style="width: 170px;">Timestamp (IST)</th>
                        <th>Target Endpoint</th>
                        <th class="text-center" style="width: 100px;">Status</th>
                        <th>Triggered By</th>
                        <th>CNR Number</th>
                        <th class="text-end" style="width: 110px;">Duration</th>
                    </tr>
                </thead>
                <tbody id="recentCallsBody">
                    @if (Model.RecentCalls.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="bi bi-cloud-check fs-1 text-primary opacity-50 d-block mb-2"></i>
                                    <h6 class="fw-bold text-dark">No API Calls Logged Yet</h6>
                                    <p class="small text-secondary mb-0">Whenever cases are synchronized or searched via eCourts, transactions will populate here instantaneously.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var call in Model.RecentCalls)
                        {
                            <tr>
                                <td><span class="code-pill text-muted">#@call.CallID</span></td>
                                <td class="small text-secondary">
                                    <i class="bi bi-calendar3 me-1 opacity-75"></i>@call.CalledAt.ToString("dd-MMM HH:mm:ss")
                                </td>
                                <td>
                                    <span class="code-pill fw-semibold text-primary">@call.Endpoint</span>
                                </td>
                                <td class="text-center">
                                    @if (call.IsSuccess)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>@(call.HttpStatus ?? 200)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i>@(call.HttpStatus?.ToString() ?? "ERR")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem;">
                                            @(!string.IsNullOrEmpty(call.Username) ? call.Username.Substring(0, 1).ToUpper() : "S")
                                        </div>
                                        <span class="small fw-semibold text-dark">@(call.Username ?? "System/Sync")</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(call.CNRNumber))
                                    {
                                        <span class="code-pill fw-bold text-dark">@call.CNRNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (call.DurationMs.HasValue)
                                    {
                                        <span class="small fw-semibold @(call.DurationMs.Value < 600 ? "text-success" : call.DurationMs.Value < 1500 ? "text-warning" : "text-danger")">
                                            @call.DurationMs.Value ms
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js 4.4.4 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script>
        // Sparkline minute data
        const sparkLabels = [@Html.Raw(string.Join(",", sparkLabels.Select(s => $"'{s}'")))];
        const sparkValues = [@string.Join(",", sparkData)];

        // Hourly 24h data
        const hourlyLabels = [@Html.Raw(string.Join(",", hourlyLabels.Select(s => $"'{s}'")))];
        const hourlyValues = [@string.Join(",", hourlyCounts)];

        // Initialize Sparkline Chart
        const ctxSpark = document.getElementById('sparkChart').getContext('2d');
        const sparkGradient = ctxSpark.createLinearGradient(0, 0, 0, 240);
        sparkGradient.addColorStop(0, 'rgba(99, 102, 241, 0.35)');
        sparkGradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

        const sparkChart = new Chart(ctxSpark, {
            type: 'line',
            data: {
                labels: sparkLabels,
                datasets: [{
                    label: 'API Calls / min',
                    data: sparkValues,
                    borderColor: '#6366f1',
                    borderWidth: 2.2,
                    backgroundColor: sparkGradient,
                    fill: true,
                    tension: 0.35,
                    pointRadius: 1.5,
                    pointHoverRadius: 5,
                    pointBackgroundColor: '#6366f1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: '#1e293b',
                        titleColor: '#ffffff',
                        bodyColor: '#cbd5e1',
                        padding: 10,
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            font: { size: 10 },
                            color: '#64748b',
                            maxTicksLimit: 12
                        }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: 10,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            font: { size: 10 },
                            color: '#64748b',
                            stepSize: 2
                        }
                    }
                }
            }
        });

        // Initialize Hourly Chart
        const ctxHourly = document.getElementById('hourlyChart').getContext('2d');
        const hourlyChart = new Chart(ctxHourly, {
            type: 'bar',
            data: {
                labels: hourlyLabels,
                datasets: [{
                    label: 'Calls / Hour',
                    data: hourlyValues,
                    backgroundColor: '#0ea5e9',
                    borderRadius: 6,
                    hoverBackgroundColor: '#0284c7'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#ffffff',
                        bodyColor: '#cbd5e1',
                        padding: 10,
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            font: { size: 10 },
                            color: '#64748b',
                            maxTicksLimit: 8
                        }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: 20,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            font: { size: 10 },
                            color: '#64748b'
                        }
                    }
                }
            }
        });

        // Auto-Refresh state
        let autoRefreshEnabled = true;
        let refreshInterval = null;

        function toggleAutoRefresh() {
            autoRefreshEnabled = !autoRefreshEnabled;
            const btn = document.getElementById('btnAutoRefresh');
            const icon = document.getElementById('autoRefreshIcon');
            const text = document.getElementById('autoRefreshText');

            if (autoRefreshEnabled) {
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-outline-secondary');
                icon.classList.add('text-primary');
                text.innerText = 'Auto: 15s';
                startInterval();
            } else {
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-secondary');
                icon.classList.remove('text-primary');
                text.innerText = 'Auto: OFF';
                clearInterval(refreshInterval);
            }
        }

        function startInterval() {
            clearInterval(refreshInterval);
            refreshInterval = setInterval(fetchDashboardData, 15000);
        }

        async function fetchDashboardData() {
            try {
                const response = await fetch('/ApiDashboard/Data');
                if (!response.ok) return;
                const data = await response.json();
                if (!data) return;

                // Update Hero Metric
                const pct = data.usedPercent || 0;
                document.getElementById('metricTotalCalls').innerText = data.totalCallsThisHour || 0;
                document.getElementById('metricRemainingQuota').innerText = data.remainingQuota != null ? data.remainingQuota : 1000;
                document.getElementById('metricPercent').innerText = pct.toFixed(1) + '%';

                const pBar = document.getElementById('heroProgressBar');
                pBar.style.width = Math.min(pct, 100).toFixed(1) + '%';
                
                // Color shift based on percentage
                const barColor = pct < 60 
                    ? 'linear-gradient(90deg, #10b981 0%, #059669 100%)' 
                    : pct < 85 
                        ? 'linear-gradient(90deg, #f59e0b 0%, #d97706 100%)' 
                        : 'linear-gradient(90deg, #ef4444 0%, #dc2626 100%)';
                pBar.style.background = barColor;

                // Update 5 Cards
                document.getElementById('cardSuccessCalls').innerText = data.successfulCalls || 0;
                document.getElementById('cardFailedCalls').innerText = data.failedCalls || 0;

                let rate = 0;
                let peak = 0;
                if (data.minuteTrend && data.minuteTrend.length > 0) {
                    const counts = data.minuteTrend.map(m => m.callCount);
                    rate = counts.reduce((a, b) => a + b, 0) / counts.length;
                    peak = Math.max(...counts);
                }
                document.getElementById('cardRatePerMin').innerText = rate.toFixed(1);
                document.getElementById('cardPeakMinute').innerText = peak;

                let total24 = 0;
                if (data.hourlyTrend && data.hourlyTrend.length > 0) {
                    total24 = data.hourlyTrend.reduce((acc, h) => acc + h.callCount, 0);
                }
                document.getElementById('cardTodayTotal').innerText = total24;

                // Timestamp
                const now = new Date();
                const timeStr = now.toLocaleTimeString('en-US', { hour12: false }) + ' IST';
                document.getElementById('lastUpdatedTime').innerText = timeStr;

            } catch (err) {
                console.error("Dashboard refresh error:", err);
            }
        }

        // Search Filter for Recent Calls table
        function filterRecentCalls() {
            const query = document.getElementById('tableFilterInput').value.toLowerCase();
            const rows = document.querySelectorAll('#recentCallsBody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        }

        // Start polling on load
        startInterval();

        // ── Staged Backfill & Dry Run Operations ────────────────────────
        async function runDryRun() {
            const btn = document.getElementById('btnDryRun');
            const alertBox = document.getElementById('backfillActionAlert');
            const alertText = document.getElementById('backfillActionText');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Analyzing...';

            alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            alertBox.classList.add('alert-info');
            alertText.innerHTML = 'Executing dry-run database analysis across MVC and Labour cases...';

            try {
                const res = await fetch('/ApiDashboard/DryRun');
                const data = await res.json();
                if (!data.success) {
                    alertBox.classList.remove('alert-info');
                    alertBox.classList.add('alert-danger');
                    alertText.innerText = 'Dry run failed: ' + (data.message || 'Unknown error');
                    return;
                }

                // Update MVC Card
                document.getElementById('dryMvcWithCnr').innerText = data.mvc.casesWithCnr;
                document.getElementById('dryMvcEligible').innerText = data.mvc.eligibleForBackfill;
                document.getElementById('dryMvcQueue').innerText = (data.mvc.activeQueued + data.mvc.activeProcessing);
                document.getElementById('dryMvcDisposed').innerText = data.mvc.authoritativeDisposed;
                document.getElementById('dryMvcPending').innerText = data.mvc.authoritativePending;
                document.getElementById('badgeMvcSynced').innerText = 'Synced: ' + data.mvc.casesSynced;

                // Update Labour Card
                document.getElementById('dryLabourWithCnr').innerText = data.labour.casesWithCnr;
                document.getElementById('dryLabourEligible').innerText = data.labour.eligibleForBackfill;
                document.getElementById('dryLabourQueue').innerText = (data.labour.activeQueued + data.labour.activeProcessing);
                document.getElementById('dryLabourDisposed').innerText = data.labour.authoritativeDisposed;
                document.getElementById('dryLabourPending').innerText = data.labour.authoritativePending;
                document.getElementById('badgeLabourSynced').innerText = 'Synced: ' + data.labour.casesSynced;

                // Update Estimate Card (Rule 18)
                document.getElementById('dryEstimatedHours').innerText = data.combined.estimatedHours + ' hrs';
                document.getElementById('dryEstimatedDetail').innerText = `Remaining workload: ${data.combined.eligibleBackfill} cases to sync across dual quota buckets.`;

                alertBox.classList.remove('alert-info');
                alertBox.classList.add('alert-success');
                alertText.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Dry run complete! Total cases eligible for backfill: <strong>${data.combined.eligibleBackfill}</strong>. Active in queue: <strong>${data.combined.activeQueue}</strong>.`;
            } catch (err) {
                alertBox.classList.remove('alert-info');
                alertBox.classList.add('alert-danger');
                alertText.innerText = 'Network error during dry run analysis: ' + err.message;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-clipboard2-pulse me-1"></i> Run Dry Run Analysis';
            }
        }

        async function queueBatch(mode) {
            const promptMsg = mode === 'Pilot10'
                ? 'Queue 10 MVC + 10 Labour cases for Step 1 Pilot verification?'
                : mode === 'Staged100'
                    ? 'Queue 100 MVC + 100 Labour cases for Step 2 Staged verification?'
                    : 'Are you sure you want to queue ALL remaining unsynced cases for full backfill? Dual workers will process them within quota limits.';

            if (!confirm(promptMsg)) return;

            const alertBox = document.getElementById('backfillActionAlert');
            const alertText = document.getElementById('backfillActionText');
            alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            alertBox.classList.add('alert-primary');
            alertText.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Enqueuing batch (${mode})...`;

            const formData = new FormData();
            formData.append('mode', mode);

            try {
                const res = await fetch('/ApiDashboard/QueueBatch', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    alertBox.classList.remove('alert-primary');
                    alertBox.classList.add('alert-success');
                    alertText.innerHTML = `<i class="bi bi-check2-circle me-1"></i> ${data.message} Background workers are processing jobs within 1,000/hr quota.`;
                    // Refresh dry run metrics
                    setTimeout(runDryRun, 1000);
                } else {
                    alertBox.classList.remove('alert-primary');
                    alertBox.classList.add('alert-danger');
                    alertText.innerText = 'Failed to queue batch: ' + (data.message || 'Unknown error');
                }
            } catch (err) {
                alertBox.classList.remove('alert-primary');
                alertBox.classList.add('alert-danger');
                alertText.innerText = 'Network error queuing batch: ' + err.message;
            }
        }
    </script>
}
