@model MVCCaseManagement.Models.MvcMonthlyStatementViewModel
@{
    ViewData["HidePageHeader"] = true;
    bool isLabour = Model.SelectedModule == "Labour";
    bool isGratuity = Model.SelectedModule == "Gratuity";
    bool isOthers = Model.SelectedModule == "Others";
    bool isMmrSt2 = Model.SelectedModule == "MMR-ST2";
    string moduleTitle = isMmrSt2 ? "MMR-ST2 Particulars" : (isOthers ? "OTHERS / Consumer Form / LAC" : (isGratuity ? "Gratuity Cases" : (isLabour ? "Labour Cases" : "MVC Cases")));
    ViewData["Title"] = $"Monthly Statement - {moduleTitle}";
    string[] months = new string[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    string selectedMonthName = months[Model.SelectedMonth - 1];
}

<style>
    .statement-table {
        table-layout: fixed !important;
        width: 100% !important;
        border-collapse: collapse;
    }
    .statement-table th, .statement-table td {
        font-size: 0.78rem;
        vertical-align: middle;
        padding: 6px 4px;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .particulars-col {
        font-weight: 600;
        text-align: left;
        width: 25% !important;
        background-color: #f8f9fa !important;
        font-size: 0.78rem;
    }
    .total-col {
        background-color: #e9ecef !important;
        font-weight: 700;
        width: 9% !important;
        font-size: 0.78rem;
    }
    .division-col {
        font-size: 0.74rem;
        padding: 5px 2px !important;
    }
    .category-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: #fff;
    }
    .category-header-labour {
        background: linear-gradient(135deg, #8e2de2 0%, #4a00e0 100%);
        color: #fff;
    }
    .category-header-gratuity {
        background: linear-gradient(135deg, #e65c00 0%, #F9D423 100%);
        color: #fff;
    }
    .category-header-others {
        background: linear-gradient(135deg, #d81b60 0%, #8e2de2 100%);
        color: #fff;
    }
    .statement-table-container {
        width: 100%;
        overflow-x: hidden;
    }
    @@media print {
        .no-print {
            display: none !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        .statement-table {
            width: 100% !important;
            font-size: 9pt !important;
        }
        .statement-table th, .statement-table td {
            padding: 4px 3px !important;
        }
    }
</style>

@if (!isGratuity && !isOthers && !isMmrSt2)
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 no-print">
        <div class="btn-group shadow-sm" role="group" aria-label="Statement View Toggle">
            <a href="@Url.Action("CentralOffice", "Report", new { month = Model.SelectedMonth, year = Model.SelectedYear, module = Model.SelectedModule, caseType = Model.SelectedCaseType, view = "MonthlyStatement" })" 
               class="btn btn-sm px-3 fw-bold @(Model.SelectedView != "HighCourt" ? "btn-primary active" : "btn-outline-primary")">
                <i class="bi bi-table me-1"></i>Division Monthly Statement
            </a>
            <a href="@Url.Action("CentralOffice", "Report", new { month = Model.SelectedMonth, year = Model.SelectedYear, module = Model.SelectedModule, caseType = Model.SelectedCaseType, view = "HighCourt" })" 
               class="btn btn-sm px-3 fw-bold @(Model.SelectedView == "HighCourt" ? "btn-danger active" : "btn-outline-danger")">
                <i class="bi bi-bank2 me-1"></i>High Court & Supreme Court
            </a>
        </div>
        <div class="text-muted small">
            Current View: <strong>@(Model.SelectedView == "HighCourt" ? "High Court & Supreme Court Statement" : "Division Monthly Statement")</strong>
        </div>
    </div>
}

@if (Model.SelectedView == "HighCourt" && (!isGratuity && !isOthers && !isMmrSt2))
{
    bool isMvcHC = Model.SelectedModule == "MVC";
    bool isLabourHC = Model.SelectedModule == "Labour";

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-0 text-danger fw-bold text-uppercase">
                            <i class="bi bi-bank2 me-2"></i>STATEMENT OF CASES PENDING BEFORE THE HIGH COURT & SUPREME
                        </h4>
                        <small class="text-muted">Breakdown for <strong>@selectedMonthName @Model.SelectedYear</strong> - @(isMvcHC ? "MFA & Supreme Court SLP Cases" : "W.P., W.A. & Supreme Court SLP Cases")</small>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2 flex-wrap no-print">
                        <form method="get" action="@Url.Action("CentralOffice", "Report")" class="d-flex align-items-center gap-2 flex-wrap">
                            <input type="hidden" name="module" value="@Model.SelectedModule" />
                            <input type="hidden" name="view" value="HighCourt" />

                            <label class="form-label mb-0 fw-semibold text-nowrap ms-1">Month:</label>
                            <select name="month" class="form-select form-select-sm w-auto">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == Model.SelectedMonth)">@months[m - 1]</option>
                                }
                            </select>

                            <label class="form-label mb-0 fw-semibold text-nowrap ms-1">Year:</label>
                            <select name="year" class="form-select form-select-sm w-auto">
                                @for (int y = DateTime.Now.Year; y >= 2020; y--)
                                {
                                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                                }
                            </select>

                            <button type="submit" class="btn btn-sm btn-primary px-3">
                                <i class="bi bi-filter me-1"></i>Filter
                            </button>
                        </form>

                        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary px-3 ms-2">
                            <i class="bi bi-printer me-1"></i>Print
                        </button>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover mb-0 text-start align-middle">
                            <thead class="table-dark text-uppercase">
                                <tr>
                                    <th style="width: 8%; text-align: center;">Sl.No.</th>
                                    <th style="width: 72%;">PARTICULARS</th>
                                    <th style="width: 20%; text-align: center;">TOTAL / COUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (isMvcHC)
                            {
                                <!-- 1. MFA CASES -->
                                <tr class="table-secondary fw-bold">
                                    <td class="text-center text-danger">1</td>
                                    <td class="text-danger" colspan="2">MFA CASES</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">a</td>
                                    <td class="ps-4">No. of Cases Pending at the beginning of the month</td>
                                    <td class="text-center fw-bold fs-6">@Model.HighCourtData.MfaCases.BeginningPending</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">b</td>
                                    <td class="ps-4">No. of Cases Entrusted Appl file by the <strong>Corporation</strong></td>
                                    <td class="text-center">@Model.HighCourtData.MfaCases.EntrustedCorp</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">c</td>
                                    <td class="ps-4">No. of Cases Entrusted Appl file by the <strong>Claimant</strong></td>
                                    <td class="text-center">@Model.HighCourtData.MfaCases.EntrustedClaimant</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">d</td>
                                    <td class="ps-4">No. of Cases total disposed</td>
                                    <td class="text-center fw-bold">@Model.HighCourtData.MfaCases.TotalDisposed</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">e</td>
                                    <td class="ps-4">No. of Cases disposed favour Appl file by the <strong>Corporation</strong></td>
                                    <td class="text-center text-success fw-semibold">@Model.HighCourtData.MfaCases.DisposedFavorCorp</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">f</td>
                                    <td class="ps-4">No. of Cases disposed favour Appl file by the <strong>Claimant</strong></td>
                                    <td class="text-center text-danger fw-semibold">@Model.HighCourtData.MfaCases.DisposedFavorClaimant</td>
                                </tr>
                                <tr class="table-info fw-bold">
                                    <td class="text-center text-danger">g</td>
                                    <td class="ps-4 text-danger fw-bold">No. of cases pending at the end of the month</td>
                                    <td class="text-center text-danger fs-6 fw-bold">@Model.HighCourtData.MfaCases.EndingPending</td>
                                </tr>

                                <!-- 5. S.L.P. CASES -->
                                <tr class="table-secondary fw-bold">
                                    <td class="text-center text-danger">5</td>
                                    <td class="text-danger" colspan="2">S.L.P. CASES</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">a</td>
                                    <td class="ps-4">S.L.P. IN MVC CASES</td>
                                    <td class="text-center fw-bold text-primary fs-6">@Model.HighCourtData.SlpMvcCasesCount</td>
                                </tr>
                                <tr class="table-warning fw-bold fs-6">
                                    <td class="text-center"></td>
                                    <td class="text-dark">TOTAL S.L.P. CASES</td>
                                    <td class="text-center text-dark fw-bold">@Model.HighCourtData.SlpMvcCasesCount</td>
                                </tr>
                            }
                            else if (isLabourHC)
                            {
                                <!-- 2. LABOUR COURT CASES IN W.P. -->
                                <tr class="table-secondary fw-bold">
                                    <td class="text-center text-danger">2</td>
                                    <td class="text-danger" colspan="2">LABOUR COURT CASES IN W.P.</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">a</td>
                                    <td class="ps-4">No. of Cases Pending at the beginning of the month</td>
                                    <td class="text-center fw-bold fs-6">@Model.HighCourtData.LabourWpCases.BeginningPending</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">b</td>
                                    <td class="ps-4">No. of Cases Entrusted Appl file by the <strong>Corporation</strong></td>
                                    <td class="text-center">@Model.HighCourtData.LabourWpCases.EntrustedCorp</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">c</td>
                                    <td class="ps-4">No. of Cases Entrusted Appl file by the <strong>Claimant</strong></td>
                                    <td class="text-center">@Model.HighCourtData.LabourWpCases.EntrustedClaimant</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">d</td>
                                    <td class="ps-4">No. of Cases disposed of NWKRTC</td>
                                    <td class="text-center fw-bold">@Model.HighCourtData.LabourWpCases.TotalDisposed</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">e</td>
                                    <td class="ps-4">No. of Cases disposed favour Appl file by the <strong>Corporation</strong></td>
                                    <td class="text-center text-success fw-semibold">@Model.HighCourtData.LabourWpCases.DisposedFavorCorp</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">f</td>
                                    <td class="ps-4">No. of Cases disposed favour Appl file by the <strong>Claimant</strong></td>
                                    <td class="text-center text-danger fw-semibold">@Model.HighCourtData.LabourWpCases.DisposedFavorClaimant</td>
                                </tr>
                                <tr class="table-info fw-bold">
                                    <td class="text-center text-danger">g</td>
                                    <td class="ps-4 text-danger fw-bold">No. of cases pending at the end of the month</td>
                                    <td class="text-center text-danger fs-6 fw-bold">@Model.HighCourtData.LabourWpCases.EndingPending</td>
                                </tr>

                                <!-- 3. LABOUR COURT CASES IN W.A. -->
                                <tr class="table-secondary fw-bold">
                                    <td class="text-center text-danger">3</td>
                                    <td class="text-danger" colspan="2">LABOUR COURT CASES IN W.A.</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">a</td>
                                    <td class="ps-4">No. of Cases Pending at the beginning of the month</td>
                                    <td class="text-center fw-bold fs-6">@Model.HighCourtData.LabourWaCases.BeginningPending</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">b</td>
                                    <td class="ps-4">No. of Cases Entrusted Appl file by the <strong>Corporation</strong></td>
                                    <td class="text-center">@Model.HighCourtData.LabourWaCases.EntrustedCorp</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">c</td>
                                    <td class="ps-4">No. of Cases Entrusted Appl file by the <strong>Claimant</strong></td>
                                    <td class="text-center">@Model.HighCourtData.LabourWaCases.EntrustedClaimant</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">d</td>
                                    <td class="ps-4">No. of Cases disposed of NWKRTC</td>
                                    <td class="text-center fw-bold">@Model.HighCourtData.LabourWaCases.TotalDisposed</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">e</td>
                                    <td class="ps-4">No. of Cases disposed favour Appl file by the <strong>Corporation</strong></td>
                                    <td class="text-center text-success fw-semibold">@Model.HighCourtData.LabourWaCases.DisposedFavorCorp</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">f</td>
                                    <td class="ps-4">No. of Cases disposed favour Appl file by the <strong>Claimant</strong></td>
                                    <td class="text-center text-danger fw-semibold">@Model.HighCourtData.LabourWaCases.DisposedFavorClaimant</td>
                                </tr>
                                <tr class="table-info fw-bold">
                                    <td class="text-center text-danger">g</td>
                                    <td class="ps-4 text-danger fw-bold">No. of Cases pending at the end of the month</td>
                                    <td class="text-center text-danger fs-6 fw-bold">@Model.HighCourtData.LabourWaCases.EndingPending</td>
                                </tr>

                                <!-- TOTAL HIGH COURT CASES -->
                                <tr class="table-danger fw-bold fs-6">
                                    <td class="text-center"></td>
                                    <td class="text-danger fw-bold">TOTAL HIGH COURT CASES (2+3)</td>
                                    <td class="text-center text-danger fw-bold fs-6">@(Model.HighCourtData.LabourWpCases.EndingPending + Model.HighCourtData.LabourWaCases.EndingPending)</td>
                                </tr>

                                <!-- 5. S.L.P. CASES -->
                                <tr class="table-secondary fw-bold">
                                    <td class="text-center text-danger">5</td>
                                    <td class="text-danger" colspan="2">S.L.P. CASES</td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-semibold">b</td>
                                    <td class="ps-4">S.L.P. IN LABOUR CASES</td>
                                    <td class="text-center fw-bold text-danger fs-6">@Model.HighCourtData.SlpLabourCasesCount</td>
                                </tr>
                                <tr class="table-warning fw-bold fs-6">
                                    <td class="text-center"></td>
                                    <td class="text-dark">TOTAL S.L.P. CASES</td>
                                    <td class="text-center text-dark fw-bold">@Model.HighCourtData.SlpLabourCasesCount</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (isMmrSt2)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-0 text-warning fw-bold text-uppercase" style="color: #d97706 !important;">
                            <i class="bi bi-file-earmark-text-fill me-2"></i>CASES RECEIVED, DISPOSED OF AND PENDING DURING THE MONTH OF @selectedMonthName.ToUpper()-@Model.SelectedYear.
                        </h4>
                        <small class="text-muted">Consolidated Particulars across All Modules (MVC, Labour, Gratuity & Other Courts)</small>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2 flex-wrap no-print">
                        <form method="get" action="@Url.Action("CentralOffice", "Report")" class="d-flex align-items-center gap-2 flex-wrap">
                            <input type="hidden" name="module" value="MMR-ST2" />

                            <label class="form-label mb-0 fw-semibold text-nowrap ms-1">Month:</label>
                            <select name="month" class="form-select form-select-sm w-auto">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == Model.SelectedMonth)">@months[m - 1]</option>
                                }
                            </select>

                            <label class="form-label mb-0 fw-semibold text-nowrap ms-1">Year:</label>
                            <select name="year" class="form-select form-select-sm w-auto">
                                @for (int y = DateTime.Now.Year; y >= 2020; y--)
                                {
                                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                                }
                            </select>

                            <button type="submit" class="btn btn-sm btn-primary px-3">
                                <i class="bi bi-filter me-1"></i>Filter
                            </button>
                        </form>

                        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary px-3 ms-2">
                            <i class="bi bi-printer me-1"></i>Print
                        </button>
                        <button onclick="exportToExcel()" class="btn btn-sm btn-outline-success px-3">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                    </div>
                </div>

                <div class="card-body p-3">
                    <div class="table-responsive">
                        <table id="monthlyStatementTable" class="table table-bordered table-hover align-middle mb-0 text-center" style="border: 2px solid #000; font-family: 'Public Sans', sans-serif;">
                            <thead>
                                <tr style="background-color: #f8f9fa; border-bottom: 2px solid #000;">
                                    <th colspan="9" class="py-2 text-center text-uppercase fw-bold fs-6" style="border: 1px solid #000;">
                                        CASES RECEIVED, DISPOSED OF AND PENDING DURING THE MONTH OF @selectedMonthName.ToUpper()-@Model.SelectedYear.
                                    </th>
                                </tr>
                                <tr class="text-uppercase fw-bold align-middle" style="background-color: #f1f3f5; font-size: 0.82rem; border-bottom: 2px solid #000;">
                                    <th rowspan="2" style="width: 5%; border: 1px solid #000; vertical-align: middle;">Sl<br/>No</th>
                                    <th rowspan="2" style="width: 33%; border: 1px solid #000; text-align: left; vertical-align: middle;" class="ps-3">Name of the Court wherein the<br/>cases are pending</th>
                                    <th rowspan="2" style="width: 10%; border: 1px solid #000; vertical-align: middle;">Cases<br/>Pending</th>
                                    <th rowspan="2" style="width: 11%; border: 1px solid #000; vertical-align: middle;">No. of cases<br/>entrusted</th>
                                    <th rowspan="2" style="width: 10%; border: 1px solid #000; vertical-align: middle;">Total<br/>cases</th>
                                    <th colspan="3" style="width: 21%; border: 1px solid #000; vertical-align: middle;">Cases disposed during the month</th>
                                    <th rowspan="2" style="width: 10%; border: 1px solid #000; vertical-align: middle;">Cases<br/>Pending end</th>
                                </tr>
                                <tr class="text-uppercase fw-bold align-middle" style="background-color: #f1f3f5; font-size: 0.8rem; border-bottom: 2px solid #000;">
                                    <th style="width: 7%; border: 1px solid #000;">Favour</th>
                                    <th style="width: 7%; border: 1px solid #000;">Against</th>
                                    <th style="width: 7%; border: 1px solid #000;">Total</th>
                                </tr>
                            </thead>
                            <tbody style="font-size: 0.88rem; font-weight: 500;">
                                <!-- 1. SUPREME COURT -->
                                <tr style="border-bottom: 1px solid #000;">
                                    <td class="fw-bold" style="border: 1px solid #000;">1</td>
                                    <td class="text-start fw-bold text-uppercase ps-3" style="border: 1px solid #000;">SUPREME COURT</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.SupremeCourt.BeginningPending</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.SupremeCourt.EntrustedCount</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.SupremeCourt.TotalCases</td>
                                    <td style="border: 1px solid #000;" class="text-success fw-semibold">@Model.MmrSt2Data.SupremeCourt.DisposedFavorCount</td>
                                    <td style="border: 1px solid #000;" class="text-danger fw-semibold">@Model.MmrSt2Data.SupremeCourt.DisposedAgainstCount</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.SupremeCourt.TotalDisposed</td>
                                    <td style="border: 1px solid #000;" class="fw-bold">@Model.MmrSt2Data.SupremeCourt.EndingPending</td>
                                </tr>
                                <!-- 2. HIGH COURT -->
                                <tr style="border-bottom: 1px solid #000;">
                                    <td class="fw-bold" style="border: 1px solid #000;">2</td>
                                    <td class="text-start fw-bold text-uppercase ps-3" style="border: 1px solid #000;">HIGH COURT</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.HighCourt.BeginningPending</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.HighCourt.EntrustedCount</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.HighCourt.TotalCases</td>
                                    <td style="border: 1px solid #000;" class="text-success fw-semibold">@Model.MmrSt2Data.HighCourt.DisposedFavorCount</td>
                                    <td style="border: 1px solid #000;" class="text-danger fw-semibold">@Model.MmrSt2Data.HighCourt.DisposedAgainstCount</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.HighCourt.TotalDisposed</td>
                                    <td style="border: 1px solid #000;" class="fw-bold">@Model.MmrSt2Data.HighCourt.EndingPending</td>
                                </tr>
                                <!-- 3. OTHER COURTS -->
                                <tr style="border-bottom: 1px solid #000;">
                                    <td class="fw-bold" style="border: 1px solid #000;">3</td>
                                    <td class="text-start fw-bold text-uppercase ps-3" style="border: 1px solid #000;">OTHER COURTS</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.OtherCourts.BeginningPending</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.OtherCourts.EntrustedCount</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.OtherCourts.TotalCases</td>
                                    <td style="border: 1px solid #000;" class="text-success fw-semibold">@Model.MmrSt2Data.OtherCourts.DisposedFavorCount</td>
                                    <td style="border: 1px solid #000;" class="text-danger fw-semibold">@Model.MmrSt2Data.OtherCourts.DisposedAgainstCount</td>
                                    <td style="border: 1px solid #000;" class="fw-semibold">@Model.MmrSt2Data.OtherCourts.TotalDisposed</td>
                                    <td style="border: 1px solid #000;" class="fw-bold">@Model.MmrSt2Data.OtherCourts.EndingPending</td>
                                </tr>
                            </tbody>
                            <tfoot style="border-top: 2px solid #000; font-size: 0.92rem;" class="fw-bold">
                                <tr style="background-color: #f8f9fa;">
                                    <td style="border: 1px solid #000;"></td>
                                    <td class="text-start ps-3" style="border: 1px solid #000;">Total</td>
                                    <td style="border: 1px solid #000;">@Model.MmrSt2Data.TotalBeginningPending</td>
                                    <td style="border: 1px solid #000;">@Model.MmrSt2Data.TotalEntrustedCount</td>
                                    <td style="border: 1px solid #000;">@Model.MmrSt2Data.TotalCases</td>
                                    <td style="border: 1px solid #000;" class="text-success">@Model.MmrSt2Data.TotalDisposedFavor</td>
                                    <td style="border: 1px solid #000;" class="text-danger">@Model.MmrSt2Data.TotalDisposedAgainst</td>
                                    <td style="border: 1px solid #000;">@Model.MmrSt2Data.TotalDisposed</td>
                                    <td style="border: 1px solid #000;" class="text-primary fs-6">@Model.MmrSt2Data.TotalEndingPending</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-0 text-primary fw-bold">
                        <i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>Monthly Statement - @moduleTitle
                    </h4>
                    <small class="text-muted">Division-wise breakdown for <strong>@selectedMonthName @Model.SelectedYear</strong> @((isLabour || isGratuity || isOthers) && Model.SelectedCaseType != "ALL" ? $"({(Model.SelectedCaseType == "PGACR" ? "PGA / CR Number" : Model.SelectedCaseType == "PGAApplCR" ? "PGA / Appeal / CR Number" : Model.SelectedCaseType)})" : "")</small>
                </div>
                
                <div class="d-flex align-items-center gap-2 flex-wrap no-print">
                    <form method="get" action="@Url.Action("CentralOffice", "Report")" class="d-flex align-items-center gap-2 flex-wrap">
                        <input type="hidden" name="module" value="@Model.SelectedModule" />

                        @if (isLabour || isGratuity || isOthers)
                        {
                            <div class="d-flex align-items-center gap-1">
                                <label class="form-label mb-0 fw-semibold text-nowrap">Case Type:</label>
                                <select name="caseType" id="caseTypeSelect" class="form-select form-select-sm w-auto">
                                    @if (isLabour)
                                    {
                                        <option value="ALL" selected="@(Model.SelectedCaseType == "ALL")">All Types</option>
                                        <option value="KID" selected="@(Model.SelectedCaseType == "KID")">KID</option>
                                        <option value="ID" selected="@(Model.SelectedCaseType == "ID")">ID</option>
                                        <option value="ArisingApplication" selected="@(Model.SelectedCaseType == "ArisingApplication" || Model.SelectedCaseType == "Arising Application")">Arising Application</option>
                                    }
                                    else if (isGratuity)
                                    {
                                        <option value="ALL" selected="@(Model.SelectedCaseType == "ALL")">All Types</option>
                                        <option value="PGACR" selected="@(Model.SelectedCaseType == "PGACR" || Model.SelectedCaseType == "PGA/CR")">PGA / CR Number</option>
                                        <option value="PGAApplCR" selected="@(Model.SelectedCaseType == "PGAApplCR" || Model.SelectedCaseType == "PGA/Appeal/CR Number" || Model.SelectedCaseType == "PGA/Appeal/CR")">PGA / Appeal / CR Number</option>
                                    }
                                    else if (isOthers)
                                    {
                                        <option value="ALL" selected="@(Model.SelectedCaseType == "ALL")">All Types</option>
                                        <option value="OS" selected="@(Model.SelectedCaseType == "OS")">OS Cases</option>
                                        <option value="PSC" selected="@(Model.SelectedCaseType == "PSC" || Model.SelectedCaseType == "P&SC")">P & SC Cases</option>
                                        <option value="CC" selected="@(Model.SelectedCaseType == "CC")">CC Cases</option>
                                        <option value="ECA" selected="@(Model.SelectedCaseType == "ECA")">ECA Cases</option>
                                        <option value="LAC" selected="@(Model.SelectedCaseType == "LAC")">LAC Cases</option>
                                        <option value="Consumer" selected="@(Model.SelectedCaseType == "Consumer")">Consumer Complaint</option>
                                    }
                                </select>
                            </div>
                        }

                        <label class="form-label mb-0 fw-semibold text-nowrap ms-1">Month:</label>
                        <select name="month" class="form-select form-select-sm w-auto">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == Model.SelectedMonth)">@months[m - 1]</option>
                            }
                        </select>

                        <label class="form-label mb-0 fw-semibold text-nowrap ms-1">Year:</label>
                        <select name="year" class="form-select form-select-sm w-auto">
                            @for (int y = DateTime.Now.Year; y >= 2020; y--)
                            {
                                <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-sm btn-primary px-3">
                            <i class="bi bi-filter me-1"></i>Filter
                        </button>
                    </form>

                    <button onclick="window.print()" class="btn btn-sm btn-outline-secondary px-3 ms-2">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                    <button onclick="exportToExcel()" class="btn btn-sm btn-outline-success px-3">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="statement-table-container">
                    <table id="monthlyStatementTable" class="table table-bordered table-hover statement-table mb-0 text-center align-middle">
                        <thead>
                            <tr class="@(isOthers ? "category-header-others" : isGratuity ? "category-header-gratuity" : isLabour ? "category-header-labour" : "category-header")">
                                <th class="particulars-col py-2 ps-3 text-start">
                                    <span class="fs-6 fw-bold">PARTICULARS</span><br/>
                                    <span class="badge bg-light @(isOthers ? "text-danger fw-bold" : isGratuity ? "text-warning fw-bold" : isLabour ? "text-danger" : "text-primary") mt-1" style="font-size: 0.68rem; white-space: normal;">
                                        @(isOthers ? "OTHERS / Consumer Form / LAC" : isGratuity ? "GRATUITY CASES" : isLabour ? $"LABOUR CASES {(Model.SelectedCaseType != "ALL" ? $"({Model.SelectedCaseType})" : "")}" : "MVC CASES")
                                    </span>
                                </th>
                                @foreach (var div in Model.Divisions)
                                {
                                    <th class="division-col py-2 px-1">
                                        <div style="font-size: 0.74rem; font-weight: 600; line-height: 1.2;">@div.DivisionName</div>
                                        @if (!string.IsNullOrEmpty(div.DivisionCode) && div.DivisionCode != div.DivisionName)
                                        {
                                            <span class="badge bg-light text-dark fw-normal" style="font-size: 0.63rem;">@div.DivisionCode</span>
                                        }
                                    </th>
                                }
                                <th class="total-col py-2 px-1">TOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (isOthers)
                        {
                            <!-- OTHERS / CONSUMER FORM / LAC TABLE (5 Particulars) -->
                            
                            <!-- 1. Pending at beginning of the month -->
                            <tr>
                                <td class="particulars-col ps-3">No. of Cases pending at the beginning of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.BeginningPending</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.BeginningPending)</td>
                            </tr>

                            <!-- 2. Cases Entrusted -->
                            <tr>
                                <td class="particulars-col ps-3">No. of Cases Entrusted</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.EntrustedCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.EntrustedCount)</td>
                            </tr>

                            <!-- 3. Disposed off in favour of NWKRTC -->
                            <tr>
                                <td class="particulars-col ps-3">No. of Cases disposed off in favour of NWKRTC</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-success fw-semibold">@div.DisposedFavorCount</td>
                                }
                                <td class="total-col text-success">@Model.Divisions.Sum(d => d.DisposedFavorCount)</td>
                            </tr>

                            <!-- 4. Disposed off against NWKRTC -->
                            <tr>
                                <td class="particulars-col ps-3">No. of cases disposed off against NWKRTC</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-semibold">@div.DisposedAgainstCount</td>
                                }
                                <td class="total-col text-danger">@Model.Divisions.Sum(d => d.DisposedAgainstCount)</td>
                            </tr>

                            <!-- 5. Pending at the end of the month -->
                            <tr class="table-info fw-bold">
                                <td class="particulars-col ps-3 text-danger fw-bold">No. of cases pending at the end of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-bold">@div.EndingPending</td>
                                }
                                <td class="total-col text-danger fw-bold">@Model.Divisions.Sum(d => d.EndingPending)</td>
                            </tr>
                        }
                        else if (isLabour || isGratuity)
                        {
                            <!-- LABOUR / GRATUITY CASES TABLE (8 Particulars) -->
                            
                            <!-- 1. Pending at beginning of the month -->
                            <tr>
                                <td class="particulars-col ps-3">No. of Cases pending at the beginning of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.BeginningPending</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.BeginningPending)</td>
                            </tr>

                            <!-- 2. Cases Entrusted -->
                            <tr>
                                <td class="particulars-col ps-3">No. of Cases Entrusted</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.EntrustedCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.EntrustedCount)</td>
                            </tr>

                            <!-- 3. Disposed off in favour of NWKRTC -->
                            <tr>
                                <td class="particulars-col ps-3">No. of Cases disposed off in favour of NWKRTC</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-success fw-semibold">@div.DisposedFavorCount</td>
                                }
                                <td class="total-col text-success">@Model.Divisions.Sum(d => d.DisposedFavorCount)</td>
                            </tr>

                            <!-- 4. Disposed off against NWKRTC -->
                            <tr>
                                <td class="particulars-col ps-3">No. of cases disposed off against NWKRTC</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-semibold">@div.DisposedAgainstCount</td>
                                }
                                <td class="total-col text-danger">@Model.Divisions.Sum(d => d.DisposedAgainstCount)</td>
                            </tr>

                            <!-- 5. Received from other division -->
                            <tr>
                                <td class="particulars-col ps-3">No.of cases received from other division</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.ReceivedFromOtherDivisionCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.ReceivedFromOtherDivisionCount)</td>
                            </tr>

                            <!-- 6. Transferred to other division -->
                            <tr>
                                <td class="particulars-col ps-3">No.of cases transfered to other division</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.TransferredCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.TransferredCount)</td>
                            </tr>

                            <!-- 7. Pending at the end of the month -->
                            <tr class="table-info fw-bold">
                                <td class="particulars-col ps-3 text-danger fw-bold">No. of cases pending at the end of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-bold">@div.EndingPending</td>
                                }
                                <td class="total-col text-danger fw-bold">@Model.Divisions.Sum(d => d.EndingPending)</td>
                            </tr>

                            <!-- 8. Particular 8 (Amount due in gratuity cases / Outstanding balance pending at Accounts) -->
                            <tr class="table-warning fw-bold">
                                <td class="particulars-col ps-3 text-dark">
                                    @(isGratuity ? "Amount due in gratuity cases" : "Outstanding balance pending at Accounts In no. of cases")
                                </td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-dark" style="font-size:0.73rem;">
                                        @(isGratuity ? $"₹ {div.GratuityAmountDue:N2}" : div.AccountsPendingCasesCount.ToString())
                                    </td>
                                }
                                <td class="total-col text-dark" style="font-size:0.75rem;">
                                    @(isGratuity ? $"₹ {Model.Divisions.Sum(d => d.GratuityAmountDue):N2}" : Model.Divisions.Sum(d => d.AccountsPendingCasesCount).ToString())
                                </td>
                            </tr>
                        }
                        else
                        {
                            <!-- MVC CASES TABLE (Original 9 Particulars) -->
                            
                            <!-- 1. Pending at beginning -->
                            <tr>
                                <td class="particulars-col ps-3">1. No. of Cases pending at the beginning of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.BeginningPending</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.BeginningPending)</td>
                            </tr>

                            <!-- 2. Entrusted -->
                            <tr>
                                <td class="particulars-col ps-3">2. No. of Cases Entrusted</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.EntrustedCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.EntrustedCount)</td>
                            </tr>

                            <!-- 3. Disposed in favour -->
                            <tr>
                                <td class="particulars-col ps-3">3. No. of Cases disposed off in favour of NWKRTC</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-success fw-semibold">@div.DisposedFavorCount</td>
                                }
                                <td class="total-col text-success">@Model.Divisions.Sum(d => d.DisposedFavorCount)</td>
                            </tr>

                            <!-- 4. Disposed against -->
                            <tr>
                                <td class="particulars-col ps-3">4. No. of Cases disposed off against NWKRTC</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-semibold">@div.DisposedAgainstCount</td>
                                }
                                <td class="total-col text-danger">@Model.Divisions.Sum(d => d.DisposedAgainstCount)</td>
                            </tr>

                            <!-- 5. Transferred -->
                            <tr>
                                <td class="particulars-col ps-3">5. No. of cases transferred</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.TransferredCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.TransferredCount)</td>
                            </tr>

                            <!-- 6. Pending at end of month -->
                            <tr class="table-info fw-bold">
                                <td class="particulars-col ps-3 text-primary">6. No. of cases pending at the end of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-primary">@div.EndingPending</td>
                                }
                                <td class="total-col text-primary fw-bold">@Model.Divisions.Sum(d => d.EndingPending)</td>
                            </tr>

                            <!-- 7. Compensation paid -->
                            <tr>
                                <td class="particulars-col ps-3">7. Compensation paid in MVC case for the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td style="font-size:0.73rem;">₹ @div.CompensationPaidAmount.ToString("N2")</td>
                                }
                                <td class="total-col" style="font-size:0.75rem;">₹ @Model.Divisions.Sum(d => d.CompensationPaidAmount).ToString("N2")</td>
                            </tr>

                            <!-- 8. No. of cases Compensation paid -->
                            <tr>
                                <td class="particulars-col ps-3">8. No. of cases Compensation paid in MVC case for the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.CompensationPaidCaseCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.CompensationPaidCaseCount)</td>
                            </tr>

                            <!-- 9. Outstanding balance pending at Accounts -->
                            <tr class="table-warning fw-bold">
                                <td class="particulars-col ps-3 text-dark">9. Outstanding balance pending at Accounts</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-dark" style="font-size:0.73rem;">₹ @div.OutstandingBalanceAmount.ToString("N2")</td>
                                }
                                <td class="total-col text-dark" style="font-size:0.75rem;">₹ @Model.Divisions.Sum(d => d.OutstandingBalanceAmount).ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
    <script>
        function exportToExcel() {
            var table = document.getElementById("monthlyStatementTable");
            var html = table.outerHTML;
            var url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            var link = document.createElement('a');
            link.href = url;
            link.download = '@(isMmrSt2 ? "MMR-ST2" : isGratuity ? "Gratuity" : isLabour ? "Labour" : isOthers ? "Others" : "MVC")_Monthly_Statement_@(selectedMonthName)_@(Model.SelectedYear).xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
