                                    <td class="text-danger fw-semibold">@div.DisposedAgainstCount</td>
                                }
                                <td class="total-col text-danger">@Model.Divisions.Sum(d => d.DisposedAgainstCount)</td>
                            </tr>

                            <!-- 5. Received from other division -->
                            <tr>
                                <td class="particulars-col ps-3">No.of cases received from other division</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.ReceivedFromOtherDivisionCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.ReceivedFromOtherDivisionCount)</td>
                            </tr>

                            <!-- 6. Transferred to other division -->
                            <tr>
                                <td class="particulars-col ps-3">No.of cases transfered to other division</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.TransferredCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.TransferredCount)</td>
                            </tr>

                            <!-- 7. Pending at the end of the month -->
                            <tr class="table-info fw-bold">
                                <td class="particulars-col ps-3 text-danger fw-bold">No. of cases pending at the end of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-bold">@div.EndingPending</td>
                                }
                                <td class="total-col text-danger fw-bold">@Model.Divisions.Sum(d => d.EndingPending)</td>
                            </tr>

                            <!-- 8. Particular 8 (Amount due in gratuity cases / Outstanding balance pending at Accounts) -->
                            <tr class="table-warning fw-bold">
                                <td class="particulars-col ps-3 text-dark">
                                    @(isGratuity ? "Amount due in gratuity cases" : "Outstanding balance pending at Accounts In no. of cases")
                                </td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-dark @(isGratuity ? "amount-cell" : "")" style="font-size:0.73rem;">
                                        @(isGratuity ? $"₹ {div.GratuityAmountDue:N2}" : div.AccountsPendingCasesCount.ToString())
                                    </td>
                                }
                                <td class="total-col text-dark @(isGratuity ? "amount-cell" : "") text-center" style="font-size:0.75rem; text-align: center !important;">
                                    @(isGratuity ? $"₹ {Model.Divisions.Sum(d => d.GratuityAmountDue):N2}" : Model.Divisions.Sum(d => d.AccountsPendingCasesCount).ToString())
                                </td>
                            </tr>
                        }
                        else
                        {
                            <!-- MVC CASES TABLE (Original 9 Particulars) -->
                            
                            <!-- 1. Pending at beginning -->
                            <tr>
                                <td class="particulars-col ps-3">1. No. of Cases pending at the beginning of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.BeginningPending</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.BeginningPending)</td>
                            </tr>

                            <!-- 2. Entrusted -->
                            <tr>
                                <td class="particulars-col ps-3">2. No. of Cases Entrusted</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.EntrustedCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.EntrustedCount)</td>
                            </tr>

                            <!-- 3. Disposed in favour -->
                            <tr>
                                <td class="particulars-col ps-3">3. No. of Cases disposed off in favour of @(OrgService.GetCurrentSettings().OrganizationShortName)</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-success fw-semibold">@div.DisposedFavorCount</td>
                                }
                                <td class="total-col text-success">@Model.Divisions.Sum(d => d.DisposedFavorCount)</td>
                            </tr>

                            <!-- 4. Disposed against -->
                            <tr>
                                <td class="particulars-col ps-3">4. No. of Cases disposed off against @(OrgService.GetCurrentSettings().OrganizationShortName)</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-danger fw-semibold">@div.DisposedAgainstCount</td>
                                }
                                <td class="total-col text-danger">@Model.Divisions.Sum(d => d.DisposedAgainstCount)</td>
                            </tr>

                            <!-- 5. Transferred -->
                            <tr>
                                <td class="particulars-col ps-3">5. No. of cases transferred</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.TransferredCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.TransferredCount)</td>
                            </tr>

                            <!-- 6. Pending at end of month -->
                            <tr class="table-info fw-bold">
                                <td class="particulars-col ps-3 text-primary">6. No. of cases pending at the end of the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-primary">@div.EndingPending</td>
                                }
                                <td class="total-col text-primary fw-bold">@Model.Divisions.Sum(d => d.EndingPending)</td>
                            </tr>

                            <!-- 7. Compensation paid -->
                            <tr>
                                <td class="particulars-col ps-3">7. Compensation paid in MVC case for the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="amount-cell" style="font-size:0.73rem;">₹ @div.CompensationPaidAmount.ToString("N2")</td>
                                }
                                <td class="total-col amount-cell text-center" style="font-size:0.75rem; text-align: center !important;">₹ @Model.Divisions.Sum(d => d.CompensationPaidAmount).ToString("N2")</td>
                            </tr>

                            <!-- 8. No. of cases Compensation paid -->
                            <tr>
                                <td class="particulars-col ps-3">8. No. of cases Compensation paid in MVC case for the month</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td>@div.CompensationPaidCaseCount</td>
                                }
                                <td class="total-col">@Model.Divisions.Sum(d => d.CompensationPaidCaseCount)</td>
                            </tr>

                            <!-- 9. Outstanding balance pending at Accounts -->
                            <tr class="table-warning fw-bold">
                                <td class="particulars-col ps-3 text-dark">9. Outstanding balance pending at Accounts</td>
                                @foreach (var div in Model.Divisions)
                                {
                                    <td class="text-dark amount-cell" style="font-size:0.73rem;">₹ @div.OutstandingBalanceAmount.ToString("N2")</td>
                                }
                                <td class="total-col text-dark amount-cell text-center" style="font-size:0.75rem; text-align: center !important;">₹ @Model.Divisions.Sum(d => d.OutstandingBalanceAmount).ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Official Printable Signoff Block -->
            <div class="print-signoff d-none d-print-flex">
                <div>Prepared by / Case Worker</div>
                <div>Verified by / Superintendent</div>
                <div>Law Officer / Chief Law Officer</div>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
    <script>
        function exportToExcel() {
            var table = document.getElementById("monthlyStatementTable");
            var html = table.outerHTML;
            var url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            var link = document.createElement('a');
            link.href = url;
            link.download = '@(isMmrSt2 ? "MMR-ST2" : isGratuity ? "Gratuity" : isLabour ? "Labour" : isOthers ? "Others" : "MVC")_Monthly_Statement_@(selectedMonthName)_@(Model.SelectedYear).xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
