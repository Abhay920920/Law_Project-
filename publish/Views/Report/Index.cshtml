@{
    ViewData["Title"] = "Petty Bill Generation";
}

@section Styles {
    <style>
        .section-title {
            background-color: #eef2ff;
            border-left: 4px solid #4f46e5;
            color: #4338ca;
            padding: 10px 15px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            border-radius: 0 4px 4px 0;
            margin-bottom: 1.5rem;
            font-size: 0.8rem;
        }
        .bg-calc { background-color: #f8fdf9; }
        .saved-bill-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 5px;
        }
        .load-bill { flex-grow: 1; text-align: left; }
    </style>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-receipt me-2"></i>Generate Petty Bill</h5>
    </div>
    <div class="card-body p-4">
        <!-- Search Section -->
        <h6 class="section-title">Step 1: Search Case</h6>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label for="searchMVCNo" class="form-label fw-bold small text-muted">MVC Number</label>
                <input type="text" class="form-control" id="searchMVCNo" placeholder="Enter MVC No">
            </div>
            <div class="col-md-3">
                <label for="searchYear" class="form-label fw-bold small text-muted">Year</label>
                <input type="number" class="form-control" id="searchYear" placeholder="YYYY">
            </div>
            <div class="col-md-3">
                <label for="searchMACT" class="form-label fw-bold small text-muted">MACT Name (Optional)</label>
                <select class="form-control" id="searchMACT">
                    <option value="">-- Select MACT --</option>
                    @if (ViewBag.MACTList != null)
                    {
                        foreach (var mact in ViewBag.MACTList)
                        {
                            <option value="@mact.MACTName">@mact.MACTName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" id="btnSearch">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </div>

        <hr class="text-muted opacity-25">

        <!-- Saved Bills Section (Hidden initially) -->
        <div id="savedBillsSection" class="mb-4" style="display:none;">
            <h6 class="section-title">Saved Bills for this Case</h6>
            <div id="savedBillsList" class="d-flex flex-wrap gap-2">
                <!-- Dynamic buttons -->
            </div>
        </div>

        <!-- Bill Form (Hidden initially) -->
        <form id="billForm" action="/Report/GenerateBill" method="post" target="_blank" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BillID" id="hidBillID" value="0">
            <input type="hidden" name="CaseID" id="hidCaseID">
            
            <!-- Case Details -->
            <h6 class="section-title">Step 2: Verify Details</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">MVC No / Year</label>
                    <input type="text" class="form-control bg-light" id="dispMVCDetails" readonly>
                    <input type="hidden" name="MVCNo" id="hidMVCNo">
                    <input type="hidden" name="MVCYear" id="hidMVCYear">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">MACT</label>
                    <input type="text" class="form-control bg-light" id="dispMACT" readonly>
                    <input type="hidden" name="MACTName" id="hidMACT">
                    <input type="hidden" name="DivisionName" id="hidDivision">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Vehicle No</label>
                    <input type="text" class="form-control bg-light" id="dispVehicle" readonly>
                    <input type="hidden" name="VehicleNo" id="hidVehicle">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">MFA/Appeal No</label>
                    <input type="text" class="form-control bg-light" id="dispAppeal" readonly>
                    <input type="hidden" name="AppealNumber" id="hidAppeal">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Accident Date</label>
                    <input type="date" class="form-control bg-light" id="dispAccidentDate" readonly>
                    <input type="hidden" name="AccidentDate" id="hidAccidentDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Petitioner Name</label>
                    <input type="text" class="form-control bg-light" id="dispPetitioner" readonly>
                    <input type="hidden" name="PetitionerName" id="hidPetitioner">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Claim Petition Date</label>
                    <input type="date" class="form-control" name="PetitionDate" id="petitionDate">
                </div>
            </div>

            <!-- Calculation Parameters -->
            <h6 class="section-title">Step 3: Award & Calculation Parameters</h6>
            <div class="row g-3 mb-4 bg-calc p-3 rounded border">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Bill Phase</label>
                    <select class="form-select border-primary fw-bold" name="AwardType" id="awardType">
                        <option value="Lower Court">Bill 1 (Lower Court Award)</option>
                        <option value="High Court">Bill 2 (High Court Award)</option>
                    </select>
                </div>
                <div class="col-md-3" id="baseAwardContainer" style="display:none;">
                    <label class="form-label fw-bold text-muted small">Original Lower Court Award</label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" step="0.01" class="form-control bg-light" name="BaseAwardAmount" id="baseAwardAmount" value="0" readonly>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold" id="awardLabel">Award Amount</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white">₹</span>
                        <input type="number" step="0.01" class="form-control fw-bold" name="EnhancedAmount" id="enhancedAmount" required>
                    </div>
                </div>
                 <div class="col-md-2">
                    <label class="form-label fw-bold">Interest Rate (%)</label>
                    <input type="number" step="0.01" class="form-control" id="interestRate" value="6">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Bill/Realization Date</label>
                    <input type="date" class="form-control border-success" name="BillDate" id="billDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Calculation Strategy</label>
                    <select class="form-select" id="calcMethod">
                        <option value="InterestDeduction">Interest Deduction (std)</option>
                        <option value="PrincipalDeduction" selected>Principal Deduction</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chkRelaxation">
                        <label class="form-check-label fw-bold" for="chkRelaxation">Apply Interest Relaxation?</label>
                    </div>
                </div>
                <div class="col-md-6" id="relaxationPeriodContainer" style="display:none;">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-bold text-danger small">Relaxation From</label>
                            <input type="date" class="form-control border-danger" id="relaxFromDate" value="2025-06-01">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold text-danger small">Relaxation To</label>
                            <input type="date" class="form-control border-danger" id="relaxToDate">
                        </div>
                    </div>
                </div>
                <div class="col-12 mt-2">
                    <div id="awardInfoText" class="small text-muted italic"></div>
                </div>
            </div>

            <!-- Approval Info -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">File Ref No</label>
                    <input type="text" class="form-control" name="FileRefNo" placeholder="NWKRT/___/LAW/">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Approval Letter No</label>
                    <input type="text" class="form-control" name="ApprovalLetterNo">
                </div>
                <div class="col-md-3">
                     <label class="form-label fw-bold small text-muted">Approval Date</label>
                     <input type="date" class="form-control" name="ApprovalDate">
                </div>
            </div>

            <!-- Previous Payments -->
            <h6 class="section-title">Step 4: Previous Payments (Deductions)</h6>
            <div class="mb-4">
                 <button type="button" class="btn btn-sm btn-outline-primary mb-2" id="btnAddPayment">
                    <i class="bi bi-plus"></i> Add Payment
                </button>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th width="40" title="Include in Deductions">Incl</th>
                            <th>Cheque No</th>
                            <th>Cheque Date</th>
                            <th>Amount (₹)</th>
                            <th>Remarks</th>
                            <th width="50"></th>
                        </tr>
                    </thead>
                    <tbody id="paymentsBody">
                        <!-- Dynamic rows -->
                    </tbody>
                </table>
                 <div class="row g-3 mt-2">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">TDS (%)</label>
                        <input type="number" step="0.01" class="form-control" name="TDSPercentage" id="tdsPercent" value="10">
                    </div>
                     <div class="col-md-3">
                        <label class="form-label fw-bold">Court Cost</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" class="form-control" name="CourtCost" id="courtCost" value="0">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Auto-Calculated Results (Hidden Inputs for Submission) -->
            <div id="interestContainer"></div>
            <input type="hidden" name="GrossPayable" id="hidGrossPayable">
            <input type="hidden" name="NetPayable" id="hidNetPayable">
            <input type="hidden" name="TDSAmount" id="hidTDSAmount">
            <input type="hidden" name="TotalDeductions" id="hidTotalDeductions">

            <div class="alert alert-success d-flex align-items-center mb-0 border-0 rounded-0 rounded-top">
                <i class="bi bi-calculator-fill fs-3 me-3"></i>
                <div>
                     <div class="small text-uppercase fw-bold opacity-75">Net Payable Estimate (Stored in Database)</div>
                     <div class="fs-4 fw-bold" id="lblNetPayable">₹ 0.00</div>
                </div>
            </div>
            
            <div class="bg-light p-3 border rounded-bottom d-flex gap-2 mb-4">
                <button type="button" class="btn btn-warning" id="btnRecalculate">
                    <i class="bi bi-arrow-clockwise"></i> Recalculate
                </button>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-success px-4" id="btnSaveBill">
                        <i class="bi bi-save me-2"></i> Save Bill
                    </button>
                    <button type="submit" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-printer me-2"></i> Print Bill
                    </button>
                </div>
            </div>

            <!-- Preview Breakdown -->
            <h6 class="section-title mt-4">Calculation Breakdown</h6>
            <div class="card bg-light border-0 mb-4">
                <div class="card-body p-0">
                    <div id="calcPreview" class="p-3"></div>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    let paymentIndex = 0;
    let currentSavedBills = [];

    // CORE CALCULATION LOGIC (Moved to top to ensure availability)
    window.calculate = function() {
        const principal = parseFloat($('#enhancedAmount').val()) || 0;
        
        const rateVal = $('#interestRate').val();
        const rate = (rateVal === "" || isNaN(parseFloat(rateVal))) ? 6 : parseFloat(rateVal);
        
        const tdsVal = $('#tdsPercent').val();
        const tdsRate = (tdsVal === "" || isNaN(parseFloat(tdsVal))) ? 10 : parseFloat(tdsVal);
        
        const courtCost = parseFloat($('#courtCost').val()) || 0;
        
        const petDateStr = $('#petitionDate').val();
        const billDateStr = $('#billDate').val();
        
        if (!petDateStr || !billDateStr) return;

        let lastDate = new Date(petDateStr);
        const endDate = new Date(billDateStr);
        
        // Relaxation Period
        const useRelax = $('#chkRelaxation').is(':checked');
        const rFrom = useRelax && $('#relaxFromDate').val() ? new Date($('#relaxFromDate').val()) : null;
        const rTo = useRelax && $('#relaxToDate').val() ? new Date($('#relaxToDate').val()) : null;
        if(rFrom) rFrom.setHours(12,0,0,0);
        if(rTo) rTo.setHours(12,0,0,0);

        // Normalize constants
        lastDate.setHours(12,0,0,0);
        endDate.setHours(12,0,0,0);

        function calculateDaysWithRelaxation(start, end) {
            if (!useRelax || !rFrom || !rTo) return Math.ceil((end - start) / (1000 * 3600 * 24));
            
            // Calculate total days
            const totalDays = Math.ceil((end - start) / (1000 * 3600 * 24));
            
            // Calculate overlap with relaxation period
            const overlapStart = new Date(Math.max(start, rFrom));
            const overlapEnd = new Date(Math.min(end, rTo));
            
            let overlapDays = 0;
            if (overlapStart < overlapEnd) {
                overlapDays = Math.ceil((overlapEnd - overlapStart) / (1000 * 3600 * 24));
            }
            
            return Math.max(0, totalDays - overlapDays);
        }

        // Collect Payments
        let payments = [];
        $('#paymentsBody tr').each(function() {
            if ($(this).find('input[type="checkbox"]').is(':checked')) {
                const amt = parseFloat($(this).find('.payment-amount').val()) || 0;
                const dStr = $(this).find('.payment-date').val();
                if (amt > 0 && dStr) {
                    payments.push({ amount: amt, date: new Date(dStr), obj: $(this) });
                }
            }
        });
        payments.sort((a,b) => a.date - b.date);

        // Variables
        let currentPrincipal = principal;
        let balanceInterest = 0;
        let interestEntries = []; // For Form Submission
        let previewHtml = '<ul class="list-group list-group-flush">';
        let totalPaid = 0;

        const method = $('#calcMethod').val();

        // --- Iteration ---
        let isFirst = true;

        payments.forEach(p => {
             const pDate = p.date;
             pDate.setHours(12,0,0,0);

             if (pDate > lastDate) {
                 // Calculate Interest
                 const timeDiff = pDate - lastDate;
                 const days = calculateDaysWithRelaxation(lastDate, pDate);
                 
                 if (days > 0 && currentPrincipal > 0) {
                     const interest = (currentPrincipal * rate * days) / (365 * 100);
                     balanceInterest += interest;
                     
                     // Add Entry
                     interestEntries.push({
                         from: new Date(lastDate),
                         to: new Date(pDate),
                         amount: interest,
                         relaxedDays: Math.ceil((pDate - lastDate)/(1000 * 3600 * 24)) - days
                     });
                     
                     previewHtml += `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div><small>Interest (${lastDate.toLocaleDateString()} to ${pDate.toLocaleDateString()}) - Principal: ₹${currentPrincipal.toLocaleString()} 
                        ${interestEntries[interestEntries.length-1].relaxedDays > 0 ? `<br><span class="text-danger small">(Relaxed ${interestEntries[interestEntries.length-1].relaxedDays} days)</span>` : ''}</small></div>
                        <span class="text-success">+ ₹${interest.toFixed(2)}</span>
                     </li>`;
                 }
             }

              // Apply Payment
              if (!p.obj.find('.payment-cancelled').is(':checked')) {
                 totalPaid += p.amount;
                 let remaining = p.amount;
                 
                 if (method === 'InterestDeduction') {
                     if(balanceInterest > 0) {
                         const adj = Math.min(balanceInterest, remaining);
                         balanceInterest -= adj;
                         remaining -= adj;
                     }
                     if(remaining > 0) {
                         currentPrincipal -= remaining;
                     }
                 } else {
                     if(currentPrincipal > 0) {
                         const adj = Math.min(currentPrincipal, remaining);
                         currentPrincipal -= adj;
                         remaining -= adj;
                     }
                 }
                 
                 previewHtml += `<li class="list-group-item list-group-item-light d-flex justify-content-between align-items-center">
                    <div><small class="fw-bold">Payment Deducted (Principal left: ₹${currentPrincipal.toLocaleString()})</small></div>
                    <span class="text-danger">- ₹${p.amount.toFixed(2)}</span>
                 </li>`;
              } else {
                  previewHtml += `<li class="list-group-item list-group-item-warning d-flex justify-content-between align-items-center">
                    <div><small class="text-muted"><del>Cancelled Cheque: ${p.amount.toFixed(2)}</del></small></div>
                    <span class="text-muted">Ignored</span>
                 </li>`;
              }

              lastDate = new Date(pDate);
         });

        // Final Period
        if (endDate > lastDate && currentPrincipal > 0) {
             const days = calculateDaysWithRelaxation(lastDate, endDate);
             const interest = (currentPrincipal * rate * days) / (365 * 100);
             const relaxed = Math.ceil((endDate - lastDate)/(1000 * 3600 * 24)) - days;

             balanceInterest += interest;
             interestEntries.push({ from: new Date(lastDate), to: new Date(endDate), amount: interest, relaxedDays: relaxed });
             
              previewHtml += `<li class="list-group-item d-flex justify-content-between align-items-center bg-info bg-opacity-10">
                <div><small class="fw-bold">Final Period Interest (${lastDate.toLocaleDateString()} to ${endDate.toLocaleDateString()}) 
                ${relaxed > 0 ? `<br><span class="text-danger small">(Relaxed ${relaxed} days)</span>` : ''}</small></div>
                <span class="text-success fw-bold">+ ₹${interest.toFixed(2)}</span>
              </li>`;
         }

        previewHtml += '</ul>';
        $('#calcPreview').html(previewHtml);

        // Populate Hidden Inputs for Interest Entries
        $('#interestContainer').empty();
        let i = 0;
        interestEntries.forEach(e => {
            // Format dates yyyy-MM-dd
            const f = e.from.toISOString().split('T')[0];
            const t = e.to.toISOString().split('T')[0];
            const html = `
                <input type="hidden" name="InterestEntries[${i}].FromDate" value="${f}">
                <input type="hidden" name="InterestEntries[${i}].ToDate" value="${t}">
                <input type="hidden" name="InterestEntries[${i}].Amount" value="${e.amount.toFixed(2)}">
            `;
            $('#interestContainer').append(html);
            i++;
        });

        // Summary Cals
        const totalInterest = interestEntries.reduce((sum, e) => sum + e.amount, 0);
        const grossPayable = principal + totalInterest + courtCost;
        const tds = grossPayable * (tdsRate / 100); 
        
        // Correcting implementation to be on Interest.
        const tdsAmount = totalInterest * (tdsRate / 100); 
        
        const totalDeductions = totalPaid + tdsAmount;
        const netPayable = grossPayable - totalDeductions;
        
        // Populate hidden fields for form submission
        $('#hidGrossPayable').val(grossPayable.toFixed(2));
        $('#hidNetPayable').val(netPayable.toFixed(2));
        $('#hidTDSAmount').val(tdsAmount.toFixed(2));
        $('#hidTotalDeductions').val(totalDeductions.toFixed(2));
        
        $('#lblNetPayable').text('₹ ' + netPayable.toLocaleString('en-IN', {minimumFractionDigits: 2}));
    };

    // Search
    $('#btnSearch').click(function() {
        const mvcNo = $('#searchMVCNo').val().trim();
        const year = $('#searchYear').val().trim();
        const mactName = $('#searchMACT').val().trim();

        if (!mvcNo || !year) { alert('Enter MVC No and Year'); return; }

        $.get('/Report/GetCaseDetails', { mvcNo, year, mactName }, function(res) {
            if (res.success) {
                $('#hidCaseID').val(res.caseID);
                $('#hidMVCNo').val(res.mvcNo);
                $('#hidMVCYear').val(res.mvcYear);
                $('#dispMVCDetails').val(res.mvcNo + '/' + res.mvcYear);
                $('#hidMACT').val(res.mactName);
                $('#dispMACT').val(res.mactName);
                $('#hidDivision').val(res.divisionName);
                $('#hidVehicle').val(res.vehicleNo);
                $('#dispVehicle').val(res.vehicleNo);
                
                // Format dates yyyy-MM-dd
                const accDate = parseDate(res.accidentDate);
                $('#hidAccidentDate').val(accDate);
                $('#dispAccidentDate').val(accDate);
                
                const petDate = parseDate(res.petitionDate);
                $('#petitionDate').val(petDate);

                $('#hidPetitioner').val(res.petitionerName);
                $('#dispPetitioner').val(res.petitionerName);
                $('#hidAppeal').val(res.appealNumber);
                $('#dispAppeal').val(res.appealNumber);

                // Award Phase Pre-filling
                if (res.isAppeal) {
                    $('#awardType').val('High Court').trigger('change');
                    $('#baseAwardAmount').val(res.awardAmount);
                    // For Bill 2, leave award amount field empty or suggest enhancement if known
                    $('#enhancedAmount').val(''); 
                } else {
                    $('#awardType').val('Lower Court').trigger('change');
                    $('#baseAwardAmount').val(0);
                    // Use Liability Amount (Apportioned) if available, otherwise total Award Amount
                    $('#enhancedAmount').val(res.liableAmount || res.awardAmount);
                }

                // Payments
                $('#paymentsBody').empty();
                paymentIndex = 0;
                
                console.log('Previous Payments Response:', res.previousPayments);
                console.log('Payment Count:', res.previousPayments ? res.previousPayments.length : 0);
                
                if (res.previousPayments && res.previousPayments.length > 0) {
                     console.log('Adding', res.previousPayments.length, 'payment rows');
                     res.previousPayments.forEach((p, index) => {
                         console.log('Payment', index + 1, ':', p);
                         addPaymentRow(p.amount, p.chequeDate, p.chequeNumber, p.remarks, p.isCancelled || false, p.paymentID || 0);
                     });
                } else {
                    console.warn('No previous payments found or empty array');
                }

                $('#billForm').slideDown();
                
                // Fetch saved bills for this case
                fetchSavedBills(res.mvcNo, res.mvcYear);
                
                calculate();
            } else {
                alert(res.message);
            }
        });
    });

    function parseDate(dateStr) {
        if (!dateStr) return '';
        const parts = dateStr.split('-');
        if(parts.length === 3) return `${parts[2]}-${parts[1]}-${parts[0]}`;
        return '';
    }

    function addPaymentRow(amount, date, chqNo, remarks, isCancelled = false, paymentId = 0) {
        // format date for input
        let dateVal = '';
        if(date) {
            const d = new Date(date);
            dateVal = d.toISOString().split('T')[0];
        }

        const row = `
            <tr class="${isCancelled ? 'table-warning text-muted' : ''}">
                <td class="text-center">
                    <input type="hidden" name="PreviousPayments[${paymentIndex}].PaymentID" value="${paymentId}" class="payment-id">
                    <input type="checkbox" name="PreviousPayments[${paymentIndex}].IsSelected" value="true" ${isCancelled ? '' : 'checked'} ${isCancelled ? 'disabled' : ''}>
                </td>
                <td><input type="text" class="form-control form-control-sm" name="PreviousPayments[${paymentIndex}].ChequeNumber" value="${chqNo || ''}"></td>
                <td><input type="date" class="form-control form-control-sm payment-date" name="PreviousPayments[${paymentIndex}].ChequeDate" value="${dateVal}"></td>
                <td><input type="number" step="0.01" class="form-control form-control-sm payment-amount" name="PreviousPayments[${paymentIndex}].Amount" value="${amount}"></td>
                <td><input type="text" class="form-control form-control-sm" name="PreviousPayments[${paymentIndex}].Remarks" value="${remarks || ''}" placeholder="Source/Remarks"></td>
                <td><button type="button" class="btn btn-sm text-danger remove-row"><i class="bi bi-trash"></i></button></td>
            </tr>
        `;
        $('#paymentsBody').append(row);
        paymentIndex++;
    }

    function reindexPayments() {
        $('#paymentsBody tr').each(function(index) {
            $(this).find('input').each(function() {
                let name = $(this).attr('name');
                if (name) {
                    name = name.replace(/PreviousPayments\[\d+\]/, `PreviousPayments[${index}]`);
                    $(this).attr('name', name);
                }
            });
        });
        paymentIndex = $('#paymentsBody tr').length;
    }

    $('#btnAddPayment').click(function() { addPaymentRow(0, null, ''); });
    
    // Event Delegations
    $(document).on('click', '.remove-row', function() { 
        const row = $(this).closest('tr');
        const paymentId = parseInt(row.find('.payment-id').val()) || 0;

        if (paymentId > 0) {
            if (!confirm('This payment is saved in the database. Are you sure you want to PERMANENTLY delete it? This will affect all future searches for this case.')) {
                return;
            }

            $.ajax({
                url: '/Report/DeletePaymentRow',
                type: 'POST',
                data: { paymentId: paymentId },
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                success: function(res) {
                    if (res.success) {
                        row.remove();
                        reindexPayments();
                        calculate();
                        alert('Deleted from database successfully.');
                    } else {
                        alert('Error: ' + res.message);
                    }
                },
                error: function() { alert('Failed to delete from server.'); }
            });
        } else {
            row.remove();
            reindexPayments();
            calculate();
        }
    });

    $(document).on('change keyup', '.payment-amount, .payment-date, input[type="checkbox"]', function() { calculate(); });
    
    // Bill Phase Toggle
    $('#awardType').change(function() {
        const type = $(this).val();
        if (type === 'High Court') {
            $('#baseAwardContainer').show();
            $('#awardLabel').text('Revised Award Amount');
            $('#awardInfoText').text('Note: This will calculate interest and deductions based on the High Court judgment.');
        } else {
            $('#baseAwardContainer').hide();
            $('#awardLabel').text('Award Amount');
            $('#awardInfoText').text('');
        }
        calculate();
    });

    $('#chkRelaxation').change(function() {
        if ($(this).is(':checked')) {
            $('#relaxationPeriodContainer').show();
        } else {
            $('#relaxationPeriodContainer').hide();
        }
        calculate();
    });
    
    // Recalculation Triggers
    $('#enhancedAmount, #interestRate, #billDate, #petitionDate, #calcMethod, #tdsPercent, #courtCost, #relaxFromDate, #relaxToDate').on('change input', calculate);
    $('#btnRecalculate').click(calculate);

    // Save Bill Logic
    $('#btnSaveBill').click(function() {
        // Collect form data into model
        const formData = {
            BillID: parseInt($('#hidBillID').val()) || 0,
            CaseID: parseInt($('#hidCaseID').val()) || null,
            MVCNo: $('#hidMVCNo').val(),
            MVCYear: parseInt($('#hidMVCYear').val()) || null,
            MACTName: $('#hidMACT').val(),
            DivisionName: $('#hidDivision').val(),
            VehicleNo: $('#hidVehicle').val(),
            AccidentDate: $('#hidAccidentDate').val(),
            PetitionerName: $('#hidPetitioner').val(),
            AppealNumber: $('#hidAppeal').val(),
            ApprovalLetterNo: $('input[name="ApprovalLetterNo"]').val(),
            ApprovalDate: $('input[name="ApprovalDate"]').val() || null,
            FileRefNo: $('input[name="FileRefNo"]').val(),
            BillDate: $('#billDate').val(),
            EnhancedAmount: parseFloat($('#enhancedAmount').val()) || 0,
            BaseAwardAmount: parseFloat($('#baseAwardAmount').val()) || 0,
            AwardType: $('#awardType').val(),
            CourtCost: parseFloat($('#courtCost').val()) || 0,
            TDSPercentage: ($('#tdsPercent').val() === "" || isNaN(parseFloat($('#tdsPercent').val()))) ? 10 : parseFloat($('#tdsPercent').val()),
            IsRelaxationApplied: $('#chkRelaxation').is(':checked'),
            RelaxationFrom: $('#relaxFromDate').val() || null,
            RelaxationTo: $('#relaxToDate').val() || null,
            
            // Interest Entries (re-calculate to get latest)
            InterestEntries: [],
            PreviousPayments: []
        };

        // Collect Interest
        $('#interestContainer input').each(function() {
            const name = $(this).attr('name');
            const val = $(this).val();
            const indexMatch = name.match(/\[(\d+)\]/);
            if (indexMatch) {
                const index = parseInt(indexMatch[1]);
                if (!formData.InterestEntries[index]) formData.InterestEntries[index] = {};
                
                if (name.includes('FromDate')) formData.InterestEntries[index].FromDate = val;
                else if (name.includes('ToDate')) formData.InterestEntries[index].ToDate = val;
                else if (name.includes('Amount')) formData.InterestEntries[index].Amount = parseFloat(val);
            }
        });

        // Collect Payments
        $('#paymentsBody tr').each(function(index) {
            formData.PreviousPayments.push({
                PaymentID: parseInt($(this).find('.payment-id').val()) || 0,
                IsSelected: $(this).find('input[type="checkbox"]:not(.payment-cancelled)').is(':checked'),
                IsCancelled: $(this).find('.payment-cancelled').is(':checked'),
                ChequeNumber: $(this).find('input[name*="ChequeNumber"]').val(),
                ChequeDate: $(this).find('input[name*="ChequeDate"]').val(),
                Amount: parseFloat($(this).find('.payment-amount').val()) || 0,
                Remarks: $(this).find('input[name*="Remarks"]').val()
            });
        });

        // Add calculated fields for database
        formData.TotalInterest = formData.InterestEntries.reduce((s, e) => s + (e.amount || e.Amount || 0), 0);
        formData.GrossPayable = formData.EnhancedAmount + formData.TotalInterest + formData.CourtCost;
        formData.TDSAmount = formData.TotalInterest * (formData.TDSPercentage / 100);
        formData.TotalPreviousPayments = formData.PreviousPayments.filter(p => p.IsSelected).reduce((s, p) => s + p.Amount, 0);
        formData.TotalDeductions = formData.TotalPreviousPayments + formData.TDSAmount;
        formData.NetPayable = formData.GrossPayable - formData.TotalDeductions;

        $.ajax({
            url: '/Report/SaveBill',
            type: 'POST',
            contentType: 'application/json',
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: JSON.stringify(formData),
            success: function(res) {
                if (res.success) {
                    $('#hidBillID').val(res.billId);
                    alert(res.message);
                    fetchSavedBills(formData.MVCNo, formData.MVCYear);
                } else {
                    alert(res.message);
                }
            },
            error: function() { alert('Error saving bill'); }
        });
    });

    function fetchSavedBills(mvcNo, year) {
        $.get('/Report/GetBillsByMVC', { mvcNo, mvcYear: year }, function(res) {
            if (res.success && res.bills && res.bills.length > 0) {
                $('#savedBillsList').empty();
                res.bills.forEach(bill => {
                    const dateStr = bill.billDate ? new Date(bill.billDate).toLocaleDateString() : 'No Date';
                    const item = `<div class="saved-bill-item">
                        <button type="button" class="btn btn-sm btn-outline-info load-bill" data-id="${bill.billID}">
                            Bill #${bill.billID} (${dateStr}) - ₹${bill.netPayable.toLocaleString()}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-bill" data-id="${bill.billID}" title="Delete Bill">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>`;
                    $('#savedBillsList').append(item);
                });
                $('#savedBillsSection').slideDown();
            } else {
                $('#savedBillsSection').hide();
            }
        });
    }

    $(document).on('click', '.load-bill', function() {
        const billId = $(this).data('id');
        if(!confirm('Load this saved bill? Unsaved changes will be lost.')) return;

        $.get('/Report/GetBill', { billId }, function(res) {
            if (res.success) {
                const bill = res.bill;
                $('#hidBillID').val(bill.billID);
                $('#awardType').val(bill.awardType || 'Lower Court').trigger('change');
                $('#baseAwardAmount').val(bill.baseAwardAmount || 0);
                $('#enhancedAmount').val(bill.enhancedAmount);
                $('#tdsPercent').val(bill.tdsPercentage);
                $('#courtCost').val(bill.courtCost);
                $('input[name="FileRefNo"]').val(bill.fileRefNo);
                $('input[name="ApprovalLetterNo"]').val(bill.approvalLetterNo);
                
                if (bill.billDate) $('#billDate').val(bill.billDate.split('T')[0]);
                if (bill.approvalDate) $('input[name="ApprovalDate"]').val(bill.approvalDate.split('T')[0]);
                
                $('#chkRelaxation').prop('checked', bill.isRelaxationApplied).trigger('change');
                if (bill.relaxationFrom) $('#relaxFromDate').val(bill.relaxationFrom.split('T')[0]);
                if (bill.relaxationTo) $('#relaxToDate').val(bill.relaxationTo.split('T')[0]);

                // Clear and add payments
                $('#paymentsBody').empty();
                paymentIndex = 0;
                if (bill.previousPayments) {
                    bill.previousPayments.forEach(p => addPaymentRow(p.amount, p.chequeDate, p.chequeNumber, p.remarks, p.isCancelled, p.paymentID || 0));
                }

                calculate();
                window.scrollTo({ top: $('#billForm').offset().top - 20, behavior: 'smooth' });
            } else {
                alert(res.message);
            }
        });
    });

    $(document).on('click', '.delete-bill', function() {
        const billId = $(this).data('id');
        if(!confirm('Are you sure you want to delete this bill from the database? This cannot be undone.')) return;

        $.ajax({
            url: '/Report/DeleteBill',
            type: 'POST',
            data: { billId: billId },
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            success: function(res) {
                if(res.success) {
                    alert(res.message);
                    fetchSavedBills($('#hidMVCNo').val(), $('#hidMVCYear').val());
                    // If the current loaded bill was the one deleted, reset form
                    if($('#hidBillID').val() == billId) {
                        $('#hidBillID').val(0);
                    }
                } else {
                    alert(res.message);
                }
            },
            error: function() { alert('Error deleting bill'); }
        });
    });

});
</script>
}
