@model MVCCaseManagement.Models.OtherCourtsCase
@inject MVCCaseManagement.DAL.IMasterRepository MasterRepo
@inject MVCCaseManagement.Services.Storage.IFileStorageService FileStorage

@{
    Layout = "~/Views/Shared/_OtherCourtsLayout.cshtml";
    string courtName = Model.CaseType switch {
        "PSC" => "P & SC (Probate & Succession)",
        "CC" => "Criminal Case (CC)",
        "Consumer" => "Consumer Dispute",
        "LAC" => "Land Acquisition Case",
        "OS" => (Model.LitigantType == "Corporation" ? "O.S (Corporation Filed)" : "O.S (Claimant Filed)"),
        "ECA" => "ECA Case",
        _ => Model.CaseType ?? "Other Courts"
    };

    ViewData["Title"] = $"{courtName} Details - {(string.IsNullOrEmpty(Model.CaseNumber) ? "Pending" : Model.CaseNumber)}";
    ViewBag.ActiveCourt = Model.CaseType;
    ViewBag.LitigantType = Model.LitigantType;

    string displayCaseNo = !string.IsNullOrWhiteSpace(Model.CaseNumber) ? Model.CaseNumber : "N/A";
    int? displayCaseYear = Model.CaseYear.HasValue && Model.CaseYear > 0 ? Model.CaseYear : null;

    string printDivisionName = !string.IsNullOrWhiteSpace(Model.DivisionName)
        ? Model.DivisionName
        : (Model.DivisionID == 0 || Model.DivisionID == 5 
            ? "Central Office" 
            : (MasterRepo.GetAllDivisions().FirstOrDefault(d => d.DivisionID == Model.DivisionID)?.DivisionNameEnglish ?? "Central Office"));

    bool isDisposed = Model.DisposalStatus == "DISPOSED" || Model.DisposalStatus == "DNP" || Model.DisposalStatus == "Decreed" || Model.ClosureDate.HasValue;
    bool isFavor = string.Equals(Model.Result, "FAVOR", StringComparison.OrdinalIgnoreCase);
    bool isAgainst = string.Equals(Model.Result, "AGAINST", StringComparison.OrdinalIgnoreCase);

    var caseOrdersList = ViewBag.CaseOrders as List<(string Cnr, DateTime? OrderDate, string OrderType, string? LocalPdfPath, string? ExternalUrl)>;
}

<!-- ======================================================= -->
<!-- 1. OFFICIAL LEGAL CASE DOSSIER PRINT VIEW (PRINT-ONLY) -->
<!-- ======================================================= -->
<div id="print-view" class="d-none d-print-block" style="font-family: 'Times New Roman', serif; font-size: 11pt;">
    <div class="text-center mb-3 fw-bold">
        <h5 class="mb-0 text-uppercase">@(OrgService.GetCurrentSettings().OrganizationNameEnglish.ToUpper())</h5>
        <h6 class="mb-0 text-uppercase">@(printDivisionName.ToUpper()) DIVISION, @(printDivisionName.ToUpper()) (LAW SECTION)</h6>
        <div class="mt-1 small"><u>OFFICIAL CASE DOSSIER &amp; PROCEEDINGS REPORT: @courtName.ToUpper()</u></div>
        <hr class="mt-2 mb-3" style="border-top: 2px solid #000;" />
    </div>

    <table class="table table-bordered border-dark print-table" style="font-size: 10.5pt;">
        <tbody>
            <tr><td style="width: 6%;"><strong>1</strong></td><td style="width: 44%;">Name of the Division</td><td style="width: 50%;">@printDivisionName</td></tr>
            <tr><td><strong>2</strong></td><td>Case Category &amp; Nature</td><td>@courtName — @(string.IsNullOrEmpty(Model.CaseNature) ? "Standard Civil / Special Suit" : Model.CaseNature)</td></tr>
            <tr><td><strong>3</strong></td><td>Case Number &amp; Year</td><td>@(Model.CaseType) No. @displayCaseNo / @(displayCaseYear?.ToString() ?? "N/A")</td></tr>
            @if (!string.IsNullOrEmpty(Model.CNRNumber))
            {
                <tr class="table-light"><td><strong>3a</strong></td><td>e-Courts 16-Digit Alphanumeric CNR</td><td class="font-monospace fw-bold">@Model.CNRNumber</td></tr>
            }
            <tr><td><strong>4</strong></td><td>Court Name &amp; Bench</td><td>@(string.IsNullOrEmpty(Model.Court) ? "District / Civil Court" : Model.Court)</td></tr>
            <tr><td><strong>5</strong></td><td>Litigant Status / Suit Type</td><td>@(Model.LitigantType == "Corporation" ? "Corporation is Plaintiff / Petitioner" : "Corporation is Defendant / Respondent")</td></tr>
            <tr><td><strong>6</strong></td><td>Date of Incident / Accident (if any)</td><td>@(Model.DateOfAccident?.ToString("dd-MM-yyyy") ?? "N/A")</td></tr>
            <tr><td><strong>7</strong></td><td>Vehicle Involved &amp; Details</td><td>@(Model.IsVehicleInvolved == "yes" ? $"Yes — Vehicle No: {Model.VehicleNumber} ({Model.VehicleType})" : "No Vehicle Involved")</td></tr>
            <tr>
                <td><strong>8</strong></td>
                <td>Petitioner(s) / Claimant(s)</td>
                <td>
                    @if (Model.Petitioners != null && Model.Petitioners.Any())
                    {
                        @for (int i = 0; i < Model.Petitioners.Count; i++)
                        {
                            <div>@(i + 1)) @Model.Petitioners[i].Name @(!string.IsNullOrEmpty(Model.Petitioners[i].Remark) ? $"({Model.Petitioners[i].Remark})" : "")</div>
                        }
                    }
                    else
                    {
                        <div>@(string.IsNullOrEmpty(Model.PetitionerName) ? (Model.LitigantType == "Corporation" ? OrgService.GetCurrentSettings().OrganizationNameEnglish : "Claimant") : Model.PetitionerName)</div>
                    }
                </td>
            </tr>
            <tr>
                <td><strong>9</strong></td>
                <td>Respondent(s) / Defendant(s)</td>
                <td>
                    @if (Model.Respondents != null && Model.Respondents.Any())
                    {
                        @for (int i = 0; i < Model.Respondents.Count; i++)
                        {
                            <div>@(i + 1)) @Model.Respondents[i].Name @(!string.IsNullOrEmpty(Model.Respondents[i].Remark) ? $"({Model.Respondents[i].Remark})" : "")</div>
                        }
                    }
                    else
                    {
                        <div>@(string.IsNullOrEmpty(Model.RespondentName) ? (Model.LitigantType == "Corporation" ? "Opposite Party" : OrgService.GetCurrentSettings().OrganizationNameEnglish) : Model.RespondentName)</div>
                    }
                </td>
            </tr>
            <tr><td><strong>10</strong></td><td>Total Claim Amount / Valuation</td><td>@(Model.ClaimAmount.HasValue ? $"Rs. {Model.ClaimAmount.Value:N2}" : "As per Plaint / N/A")</td></tr>
            <tr><td><strong>11</strong></td><td>Relief Sought / Manner of Incident</td><td><div class="white-space-pre-line">@(!string.IsNullOrEmpty(Model.ClaimDetails) ? Model.ClaimDetails : (!string.IsNullOrEmpty(Model.MannerOfIncident) ? Model.MannerOfIncident : "Refer Case File Records"))</div></td></tr>
            <tr><td><strong>12</strong></td><td>Whether Document / Records Sent</td><td>@(Model.DocumentSent == "Yes" ? $"YES (No: {Model.InitialOutwardNumber ?? "-"}; Dt: {Model.InitialOutwardDate?.ToString("dd-MM-yyyy") ?? "-"})" : "NO")</td></tr>
            <tr><td><strong>13</strong></td><td>Whether Written Statement / Objections Filed</td><td>@(Model.IsObjectionFiled == "Yes" || Model.ObjectionVerified == "Yes" ? $"YES (No: {Model.ObjectionOutwardNumber ?? "-"}; Dt: {Model.ObjectionFiledDate?.ToString("dd-MM-yyyy") ?? "-"})" : "NO / PENDING")</td></tr>
            <tr><td><strong>14</strong></td><td>Interim Order / Injunction Granted</td><td>@(Model.InterimOrder == "Yes" ? "YES — Interim Order in Force" : "NO")</td></tr>
            <tr><td><strong>15</strong></td><td>Witnesses / Evidence by Corporation</td><td>@(Model.CorpEvidence != null && Model.CorpEvidence.Any() ? string.Join("; ", Model.CorpEvidence.Select(e => $"{e.Name} ({e.Designation})")) : (Model.EvidenceFiled == "Yes" ? "YES" : "NO"))</td></tr>
            <tr><td><strong>16</strong></td><td>Opposite Party Evidence Recorded</td><td>@(Model.RespondentEvidence != null && Model.RespondentEvidence.Any() ? string.Join("; ", Model.RespondentEvidence.Select(e => e.Name)) : "N/A")</td></tr>
            <tr><td><strong>17</strong></td><td>Assigned Advocate for Corporation</td><td>@(string.IsNullOrEmpty(Model.AdvocateName) ? "Not Assigned" : $"{Model.AdvocateName} (Entrustment: {Model.EntrustmentNumber ?? "N/A"}; Dt: {Model.EntrustmentDate?.ToString("dd-MM-yyyy") ?? "N/A"})")</td></tr>
            <tr><td><strong>18</strong></td><td>Current Case Stage / Trial Status</td><td>@(string.IsNullOrEmpty(Model.CaseStage) ? (Model.CaseStatus ?? "Active Trial") : Model.CaseStage)</td></tr>
            <tr><td><strong>19</strong></td><td>Judicial Finding / Final Outcome</td><td>@(isDisposed ? $"{Model.DisposalStatus} — Result: {Model.Result ?? "N/A"}" : "PENDING")</td></tr>
            <tr><td><strong>20</strong></td><td>Date of Final Order / Decree</td><td>@(Model.ClosureDate?.ToString("dd-MM-yyyy") ?? "N/A")</td></tr>
            <tr><td><strong>21</strong></td><td>Award / Decree Summary</td><td><div class="white-space-pre-line">@(!string.IsNullOrEmpty(Model.AwardDetails) ? Model.AwardDetails : (!string.IsNullOrEmpty(Model.ClosureRemark) ? Model.ClosureRemark : "N/A"))</div></td></tr>
            <tr><td><strong>22</strong></td><td>Certified Copy (CC) Received Details</td><td>Applied: @(Model.CopyAppliedOn?.ToString("dd-MM-yyyy") ?? "—"); Ready: @(Model.CopyReadyOn?.ToString("dd-MM-yyyy") ?? "—"); Received at Div: @(Model.CopyReceivedAtDivision?.ToString("dd-MM-yyyy") ?? "—")</td></tr>
            <tr><td><strong>23</strong></td><td>Opinion of Advocate</td><td><div class="white-space-pre-line">@(Model.AdvocateOpinion ?? "N/A")</div></td></tr>
            <tr><td><strong>24</strong></td><td>Opinion of Law Officer &amp; DC Decision</td><td><div class="white-space-pre-line">LO: @(Model.LawOfficerOpinion ?? "N/A") | DC: @(Model.DCFinalDecision ?? "N/A")</div></td></tr>
            <tr><td><strong>25</strong></td><td>Appeal Details (if filed in Higher Court)</td><td>@(string.IsNullOrEmpty(Model.AppealNumber) ? "No Appeal Recorded" : $"Appeal No: {Model.AppealNumber}/{Model.AppealYear}; Court: {Model.CourtAppellateAuth}; Advocate: {Model.AppealAdvocateName}; Status: {Model.AppealForwardingStatus}")</td></tr>
        </tbody>
    </table>

    <div class="row mt-4 pt-4 print-sig-block">
        <div class="col-6 text-center">
            <p class="fw-bold mb-0">Law Officer</p>
            <p class="small">@(OrgService.GetCurrentSettings().OrganizationShortName), @printDivisionName Division</p>
        </div>
        <div class="col-6 text-center">
            <p class="fw-bold mb-0">Divisional Controller</p>
            <p class="small">@(OrgService.GetCurrentSettings().OrganizationShortName), @printDivisionName Division</p>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 2. INTERACTIVE SCREEN DOSSIER VIEW (DISPLAY-ONLY)         -->
<!-- ======================================================== -->
<div class="container-fluid py-3 py-md-4 fade-in details-page-container d-print-none">

    <!-- Top Action Header & Breadcrumbs -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4 d-print-none details-page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("OtherCourtsCaseList", "Home", new { activeCourt = Model.CaseType, litigantType = Model.LitigantType })" class="text-decoration-none small text-muted">Other Courts</a></li>
                    <li class="breadcrumb-item"><span class="small text-muted">@courtName</span></li>
                    <li class="breadcrumb-item active small">Case Details</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="fw-bold text-primary mb-0 details-case-title">
                    <i class="bi bi-file-earmark-text me-2"></i>@displayCaseNo / @(displayCaseYear?.ToString() ?? "-")
                    <span class="fs-6 fw-normal text-muted ms-1">(@courtName)</span>
                </h2>
                @if (isDisposed)
                {
                    <span class="badge @(isFavor ? "bg-success" : (isAgainst ? "bg-danger" : "bg-primary")) px-2.5 py-1 fs-6 rounded-pill shadow-xs">
                        <i class="bi @(isFavor ? "bi-check-circle" : "bi-exclamation-octagon") me-1"></i>@(Model.Result ?? Model.DisposalStatus ?? "Disposed")
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-2.5 py-1 fs-6 rounded-pill shadow-xs">
                        <i class="bi bi-clock-history me-1"></i>@(string.IsNullOrEmpty(Model.CaseStatus) ? "Active Trial" : Model.CaseStatus)
                    </span>
                }
                <span class="badge @(Model.LitigantType == "Corporation" ? "bg-info text-white" : "bg-secondary text-white") px-2.5 py-1 fs-6 rounded-pill shadow-xs">
                    <i class="bi bi-shield-shaded me-1"></i>@(Model.LitigantType == "Corporation" ? "Corp. Plaintiff" : "Claimant Plaintiff")
                </span>
                @if (!string.IsNullOrEmpty(Model.CNRNumber))
                {
                    <span class="badge bg-light text-dark border font-monospace fs-6 px-2.5 py-1 rounded-pill shadow-xs">
                        <i class="bi bi-broadcast text-primary me-1"></i>@Model.CNRNumber
                    </span>
                }
            </div>
            <small class="text-muted d-block mt-1">
                Division: <strong class="text-dark">@printDivisionName</strong> &nbsp;|&nbsp;
                Court: <strong class="text-dark">@(string.IsNullOrEmpty(Model.Court) ? "Not Specified" : Model.Court)</strong> &nbsp;|&nbsp;
                Registered: <span class="text-dark">@Model.CreatedDate.ToString("dd-MM-yyyy")</span>
            </small>
        </div>

        <!-- Action Header Buttons -->
        <div class="d-flex align-items-center flex-wrap gap-2 w-100 w-md-auto details-header-actions">
            @{
                var otherDivId = User.FindFirst("DivisionID")?.Value;
                bool isOtherAICentral = otherDivId == "0" || otherDivId == "5";
                bool isOtherAIRole = User.IsInRole("Dy CLO") || User.IsInRole("DyCLO") || User.IsInRole("CLO") || User.IsInRole("MD");
            }
            @if (isOtherAICentral && isOtherAIRole)
            {
                <a href="/NyayaPatha?caseType=OtherCourts&caseId=@Model.CaseID" class="btn btn-outline-primary shadow-sm rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center" title="Analyze with Nyaya Patha AI">
                    <i class="bi bi-robot me-1.5 text-primary"></i> Nyaya Patha AI
                </a>
            }
            @if (ViewBag.CanEdit == true)
            {
                <a href="@Url.Action("OtherCourtsCaseEdit", "Home", new { id = Model.CaseID })" class="btn btn-primary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                    <i class="bi bi-pencil-square me-2"></i> Edit Case
                </a>
            }
            <button type="button" class="btn btn-outline-primary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#otherCourtsFullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-general-nav')).show(); }, 150);">
                <i class="bi bi-info-circle me-2"></i> View More Details
            </button>
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center" title="Print Official Case Dossier">
                <i class="bi bi-printer me-2"></i> Print Dossier
            </button>
            <a href="@Url.Action("OtherCourtsCaseList", "Home", new { activeCourt = Model.CaseType, litigantType = Model.LitigantType })" class="btn btn-light shadow-sm rounded-pill px-3 py-2 fw-semibold border d-inline-flex align-items-center">
                <i class="bi bi-arrow-left me-1.5"></i> Back to Registry
            </a>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- 3. THE 4 EXECUTIVE SUMMARY KPI CARDS                      -->
    <!-- ======================================================== -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-2 g-md-3 mb-4 summary-cards-row">

        <!-- Card 1: Basic & Incident Info -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white rounded-3 overflow-hidden position-relative">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white text-opacity-75 text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">Basic &amp; Incident Info</span>
                            <i class="bi bi-info-circle-fill text-white text-opacity-75 fs-5"></i>
                        </div>
                        <div class="fs-6 fw-bold mb-1 text-truncate" title="@Model.Court">
                            @(string.IsNullOrEmpty(Model.Court) ? "Court Not Specified" : Model.Court)
                        </div>
                        <div class="small fw-semibold text-white text-opacity-90">
                            Nature: <span class="badge bg-white text-primary fw-bold">@(string.IsNullOrEmpty(Model.CaseNature) ? "Civil Suit" : Model.CaseNature)</span>
                        </div>
                        @if (Model.DateOfAccident.HasValue)
                        {
                            <div class="extra-small text-white text-opacity-75 mt-1">
                                <i class="bi bi-calendar2-event me-1"></i>Incident: @Model.DateOfAccident.Value.ToString("dd-MM-yyyy")
                            </div>
                        }
                        @if (Model.IsVehicleInvolved == "yes")
                        {
                            <div class="extra-small text-white text-opacity-90 mt-1">
                                <i class="bi bi-truck me-1"></i>Vehicle: <span class="badge bg-dark text-white font-monospace">@(string.IsNullOrEmpty(Model.VehicleNumber) ? "Yes" : Model.VehicleNumber)</span>
                            </div>
                        }
                    </div>
                    @if (Model.ClaimAmount.HasValue && Model.ClaimAmount > 0)
                    {
                        <div class="extra-small text-white text-opacity-90 border-top border-white border-opacity-25 pt-1 mt-2">
                            Valuation / Claim: <strong>₹ @Model.ClaimAmount.Value.ToString("N2")</strong>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Card 2: Outcome & Judicial Award -->
        <div class="col">
            @{
                string outcomeBgClass = isAgainst ? "bg-danger text-white" : (isFavor ? "bg-success text-white" : "bg-warning text-dark");
            }
            <div class="card border-0 shadow-sm h-100 @outcomeBgClass rounded-3 overflow-hidden position-relative">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="@(isAgainst || isFavor ? "text-white text-opacity-75" : "text-dark text-opacity-75") text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">Judicial Outcome &amp; Award</span>
                            <i class="bi @(isAgainst ? "bi-exclamation-octagon-fill text-white" : (isFavor ? "bi-award-fill text-white" : "bi-hourglass-split text-dark")) fs-5"></i>
                        </div>
                        <div class="fs-5 fw-bold mb-1">
                            @(isDisposed ? (Model.Result ?? Model.DisposalStatus ?? "Disposed") : (Model.CaseStatus ?? "Trial Active"))
                        </div>
                        @if (isDisposed)
                        {
                            <div class="small fw-semibold @(isAgainst || isFavor ? "text-white text-opacity-90" : "text-dark text-opacity-90")">
                                Decree: <span class="badge @(isAgainst || isFavor ? "bg-white text-dark" : "bg-dark text-white") fw-bold">@(Model.DisposalStatus ?? "CLOSED")</span>
                            </div>
                            @if (Model.ClosureDate.HasValue)
                            {
                                <div class="extra-small @(isAgainst || isFavor ? "text-white text-opacity-75" : "text-dark text-opacity-75") mt-1">
                                    <i class="bi bi-calendar-check me-1"></i>Date: @Model.ClosureDate.Value.ToString("dd-MM-yyyy")
                                </div>
                            }
                        }
                        else
                        {
                            <div class="small fw-semibold text-dark text-opacity-90">
                                Stage: <span class="badge bg-dark text-white">@(string.IsNullOrEmpty(Model.CaseStage) ? "Trial Stage" : Model.CaseStage)</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-1 mt-2 pt-1 border-top @(isAgainst || isFavor ? "border-white border-opacity-25" : "border-dark border-opacity-25")">
                        @if (!string.IsNullOrEmpty(Model.FinalJudgmentFilePath))
                        {
                            <button type="button" onclick="openOrderInModal('@Model.FinalJudgmentFilePath', 'Final Judgment Copy', '@(Model.CNRNumber ?? "")', '@courtName', @Model.CaseID)" class="btn btn-sm btn-light fw-bold rounded-pill px-2.5 py-0 shadow-xs" style="font-size: 0.75rem;" title="View Final Judgment Copy">
                                <i class="bi bi-file-earmark-pdf me-1"></i>View Judgment
                            </button>
                        }
                        <button type="button" class="btn btn-sm @(isAgainst || isFavor ? "btn-light text-dark" : "btn-dark text-white") fw-semibold px-2 py-0 rounded-pill shadow-xs" data-bs-toggle="modal" data-bs-target="#otherCourtsFullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-cc-nav')).show(); }, 150);" style="font-size: 0.75rem;">
                            <i class="bi bi-journal-text me-1"></i>CC Details
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Division & Legal Action -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-light text-dark border rounded-3 overflow-hidden position-relative">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">Division &amp; Legal Action</span>
                            <i class="bi bi-building-check text-primary fs-5"></i>
                        </div>
                        <div class="fs-6 fw-bold mb-1 text-truncate">
                            @(string.IsNullOrEmpty(Model.AdvocateName) ? "Advocate Pending" : Model.AdvocateName)
                        </div>
                        <div class="small fw-semibold text-muted">
                            Objection: <span class="badge @(Model.IsObjectionFiled == "Yes" || Model.ObjectionVerified == "Yes" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-dark border")">@(Model.IsObjectionFiled == "Yes" || Model.ObjectionVerified == "Yes" ? "Filed" : "Pending")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.FinalForwardingStatus))
                        {
                            <div class="extra-small text-muted mt-1">
                                Forwarding: <span class="badge bg-secondary-subtle text-secondary border">@Model.FinalForwardingStatus</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-secondary-subtle">
                        <span class="extra-small text-truncate text-muted" style="max-width: 75%;">
                            @(string.IsNullOrEmpty(Model.OutwardNumber) ? "Legal section file" : $"Outward: {Model.OutwardNumber}")
                        </span>
                        <button type="button" class="btn btn-link p-0 text-primary text-decoration-none extra-small fw-bold" data-bs-toggle="modal" data-bs-target="#otherCourtsFullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-opinions-nav')).show(); }, 150);" title="View Legal Opinions">
                            Opinions <i class="bi bi-arrow-right-short"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Higher Court & Appeals -->
        <div class="col">
            @{
                bool hasAppeal = !string.IsNullOrEmpty(Model.AppealNumber);
            }
            <div class="card border-0 shadow-sm h-100 @(hasAppeal ? "bg-info text-white" : "bg-light text-dark border") rounded-3 overflow-hidden position-relative">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="@(hasAppeal ? "text-white text-opacity-75" : "text-secondary") text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">Higher Court &amp; Appeal</span>
                            <i class="bi bi-bank @(hasAppeal ? "text-white text-opacity-75" : "text-secondary") fs-5"></i>
                        </div>
                        <div class="fs-6 fw-bold mb-1 text-truncate">
                            @(hasAppeal ? $"Appeal {Model.AppealNumber} / {Model.AppealYear}" : "No Appeal Filed")
                        </div>
                        <div class="small fw-semibold @(hasAppeal ? "text-white text-opacity-90" : "text-muted")">
                            Status: <span class="badge @(hasAppeal ? "bg-white text-info" : "bg-secondary-subtle text-secondary border") fw-bold">@(hasAppeal ? (Model.AppealForwardingStatus ?? "Appeal Active") : "Lower Court Only")</span>
                        </div>
                        @if (hasAppeal && !string.IsNullOrEmpty(Model.CourtAppellateAuth))
                        {
                            <div class="extra-small @(hasAppeal ? "text-white text-opacity-75" : "text-muted") mt-1 text-truncate">
                                <i class="bi bi-geo-alt me-1"></i>@Model.CourtAppellateAuth
                            </div>
                        }
                    </div>

                    @if (hasAppeal)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-white border-opacity-25">
                            @if (!string.IsNullOrEmpty(Model.AppealJudgmentCopyPath))
                            {
                                <button type="button" onclick="openOrderInModal('@Model.AppealJudgmentCopyPath', 'Appeal Judgment Copy', '@(Model.CNRNumber ?? "")', '@courtName', @Model.CaseID)" class="btn btn-sm btn-light text-info fw-bold rounded-pill px-2 py-0 shadow-xs" style="font-size: 0.75rem;">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>Appeal Copy
                                </button>
                            }
                            <button type="button" class="btn btn-link p-0 text-white text-decoration-none extra-small fw-bold ms-auto" data-bs-toggle="modal" data-bs-target="#otherCourtsFullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-appeal-nav')).show(); }, 150);" title="View Appeal Details">
                                Details <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="extra-small text-muted border-top pt-1 mt-2">
                            <i class="bi bi-info-circle me-1"></i>Proceedings at trial court level
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- 4. PLEADINGS & DEFENSE STATUS DECK                       -->
    <!-- ======================================================== -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden" id="pleadingsDefenseStatusCard">
        <div class="card-header bg-white py-2.5 px-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-check text-primary fs-5 me-2"></i>
                <h6 class="mb-0 fw-bold text-dark">Pleadings &amp; Defense Status</h6>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-light text-dark border px-2.5 py-1 extra-small">
                    <i class="bi bi-calendar-event text-primary me-1"></i>Next Hearing: <strong class="@(Model.NextDateOfHearing == DateTime.Today ? "text-danger" : "text-primary")">@(Model.NextDateOfHearing.HasValue ? Model.NextDateOfHearing.Value.ToString("dd-MM-yyyy") : "—")</strong>
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 extra-small">
                    <i class="bi bi-diagram-3 me-1"></i>Stage: <strong>@(!string.IsNullOrEmpty(Model.CaseStage) ? Model.CaseStage : (Model.CaseStatus ?? "Trial"))</strong>
                </span>
            </div>
        </div>
        <div class="card-body p-3 bg-light bg-opacity-25">
            <div class="row g-3">
                <!-- 1. Document Sent -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Document Sent</span>
                                <i class="bi bi-send text-primary opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.DocumentSent == "Yes")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-check-circle me-1"></i>Yes, Sent
                                    </span>
                                    <div class="small mt-2 text-dark">
                                        <div><span class="text-muted">Outward No:</span> <strong class="font-monospace text-primary">@(string.IsNullOrEmpty(Model.InitialOutwardNumber) ? "—" : Model.InitialOutwardNumber)</strong></div>
                                        @if (Model.InitialOutwardDate.HasValue)
                                        {
                                            <div class="text-muted extra-small mt-1"><i class="bi bi-calendar-date me-1"></i>Date: @Model.InitialOutwardDate.Value.ToString("dd-MM-yyyy")</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fs-6">
                                        <i class="bi bi-x-circle me-1"></i>No
                                    </span>
                                    <div class="text-muted extra-small mt-2">Documents not yet dispatched</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Written Statement / Objection Filed -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">WS / Objection</span>
                                <i class="bi bi-shield-check text-primary opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.IsObjectionFiled == "Yes" || Model.ObjectionVerified == "Yes")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-check2-circle me-1"></i>Yes, Filed
                                    </span>
                                    <div class="small mt-2 text-dark">
                                        @if (!string.IsNullOrEmpty(Model.ObjectionOutwardNumber))
                                        {
                                            <div><span class="text-muted">Outward:</span> <strong class="font-monospace text-primary">@Model.ObjectionOutwardNumber</strong></div>
                                        }
                                        @if (Model.ObjectionFiledDate.HasValue)
                                        {
                                            <div class="text-muted extra-small mt-1"><i class="bi bi-calendar-date me-1"></i>Date: @Model.ObjectionFiledDate.Value.ToString("dd-MM-yyyy")</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-exclamation-circle me-1"></i>Not Filed
                                    </span>
                                    <div class="text-muted extra-small mt-2">Written statement / Objection pending</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Evidence / Proof Filed -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Evidence / Proof</span>
                                <i class="bi bi-file-earmark-person text-primary opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.EvidenceFiled == "Yes" || (Model.CorpEvidence != null && Model.CorpEvidence.Any()))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-check2 me-1"></i>Yes, Recorded
                                    </span>
                                    <div class="text-success extra-small mt-2">
                                        <i class="bi bi-people-fill me-1"></i>@(Model.CorpEvidence?.Count ?? 0) Corporation Witness(es)
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fs-6">
                                        <i class="bi bi-dash-circle me-1"></i>No
                                    </span>
                                    <div class="text-muted extra-small mt-2">Evidence not yet filed</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Interim Order / Injunction -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Interim Order / Stay</span>
                                <i class="bi bi-shield-slash text-warning opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.InterimOrder == "Yes")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-shield-exclamation me-1"></i>Interim Order Granted
                                    </span>
                                    @if (!string.IsNullOrEmpty(Model.InterimOrderFilePath))
                                    {
                                        <div class="mt-2">
                                            <button type="button" onclick="openOrderInModal('@Model.InterimOrderFilePath', 'Interim Order Copy', '@(Model.CNRNumber ?? "")', '@courtName', @Model.CaseID)" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-0 extra-small">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>View Order Copy
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1 fs-6">
                                        <i class="bi bi-dash-circle me-1"></i>None Granted
                                    </span>
                                    <div class="text-muted extra-small mt-2">No active interim injunction</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- 5. ECOURTS NAPIX LIVE GATEWAY CARD                       -->
    <!-- ======================================================== -->
    <div class="card border-info shadow-sm mb-4 rounded-3 overflow-hidden d-print-none" id="ecourtsNapixMainCard">
        <div class="card-header bg-info bg-opacity-10 border-info border-opacity-25 d-flex flex-wrap justify-content-between align-items-center py-2 px-3 gap-2"
             style="cursor: pointer;"
             data-bs-toggle="collapse"
             data-bs-target="#collapseCaseNapixSection"
             aria-expanded="false"
             aria-controls="collapseCaseNapixSection"
             id="headerCaseNapixSection"
             title="Click to expand/collapse live eCourts NAPIX details">
            <div class="d-flex align-items-center">
                <i class="bi bi-broadcast text-info fs-5 me-2"></i>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold text-dark">eCourts NAPIX Live Gateway Status (District &amp; Higher Courts)</h6>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill extra-small px-2 py-0">
                            <i class="bi bi-hand-index-thumb me-1"></i>Click to open
                        </span>
                    </div>
                    <small class="text-muted extra-small">Live judicial case tracking via NAPIX / NJDG National Judicial Gateway</small>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-lg-auto justify-content-between justify-content-lg-end mt-1 mt-lg-0">
                <div id="details-cnr-badge" class="d-flex flex-wrap align-items-center gap-2" onclick="event.stopPropagation();">
                    @if (!string.IsNullOrEmpty(Model.CNRNumber))
                    {
                        <span id="live-cnr-badge-span" class="badge bg-success font-monospace fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center text-nowrap">
                            <i class="bi bi-broadcast me-1"></i> CNR: @Model.CNRNumber
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Copy CNR Number" onclick="event.stopPropagation(); navigator.clipboard.writeText('@Model.CNRNumber'); alert('CNR Number copied to clipboard: @Model.CNRNumber');">
                            <i class="bi bi-clipboard"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                            <i class="bi bi-pencil-square me-1"></i>Update CNR
                        </button>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" id="btnRefreshCaseLive" onclick="event.stopPropagation(); triggerFetchOtherCourtsLiveStatus()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status
                        </button>
                    }
                    else
                    {
                        <span id="live-cnr-badge-span" class="badge bg-warning text-dark px-3 py-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> CNR Not Linked
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                            <i class="bi bi-pencil-square me-1"></i>Update CNR
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-info text-white rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseCaseNapixSection"
                        aria-expanded="false"
                        aria-controls="collapseCaseNapixSection"
                        id="btnToggleCaseNapixSection"
                        onclick="event.stopPropagation();">
                    <i class="bi bi-chevron-down" id="iconToggleCaseNapix"></i>
                    <span id="textToggleCaseNapix">View NAPIX Details</span>
                </button>
            </div>
        </div>

        <div class="collapse" id="collapseCaseNapixSection">
            <div class="card-body bg-light p-3">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Court Hall / Room</small>
                        <div class="fs-6 fw-bold text-dark" id="live-court-no">
                            @(!string.IsNullOrWhiteSpace(Model.ECourtsCourtNo) ? Model.ECourtsCourtNo : "—")
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Presiding Judge</small>
                        <div class="fw-semibold text-secondary text-truncate" id="live-judge" title="@Model.ECourtsJudge">
                            @(!string.IsNullOrWhiteSpace(Model.ECourtsJudge) ? Model.ECourtsJudge : "—")
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Next Hearing Date</small>
                        <div class="fs-6 fw-bold text-primary" id="live-next-date">
                            @(Model.NextDateOfHearing.HasValue ? Model.NextDateOfHearing.Value.ToString("dd-MM-yyyy") : "—")
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Stage (eCourts)</small>
                        <div class="fw-bold text-dark" id="live-stage">
                            @(!string.IsNullOrWhiteSpace(Model.ECourtsStage) ? Model.ECourtsStage : (!string.IsNullOrWhiteSpace(Model.CaseStage) ? Model.CaseStage : "—"))
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Status</small>
                        <div class="fw-semibold text-dark" id="live-case-status">
                            @(!string.IsNullOrWhiteSpace(Model.PendDispStatus) ? (Model.PendDispStatus == "D" ? "Disposed" : "Pending") : (Model.CaseStatus ?? "Active"))
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Establishment</small>
                        <div class="fw-semibold text-dark text-truncate" id="live-est-name">
                            @(!string.IsNullOrWhiteSpace(Model.EstName) ? Model.EstName : (Model.Court ?? "—"))
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner / Plaintiff</small>
                        <div class="fw-semibold text-dark text-truncate" id="live-petitioner" title="@Model.PetitionerName">
                            @(string.IsNullOrEmpty(Model.PetitionerName) ? (Model.LitigantType == "Corporation" ? OrgService.GetCurrentSettings().OrganizationShortName : "Plaintiff") : Model.PetitionerName)
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Assigned Advocate</small>
                        <div class="fw-semibold text-dark text-truncate" id="live-advocate">
                            @(!string.IsNullOrWhiteSpace(Model.AdvocateName) ? Model.AdvocateName : "—")
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CNRNumber))
                    {
                        <!-- Sub-Tabs for Orders & Hearing History -->
                        <div class="col-12 border-top mt-2 pt-3">
                            <ul class="nav nav-pills mb-3 gap-2 mobile-nav-tabs-scroll flex-nowrap" id="ecourtsOtherTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active btn-sm py-1 px-3 fw-bold" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-pane" type="button" role="tab">
                                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> Court Orders &amp; Judgments 
                                        <span class="badge bg-light text-danger ms-1" id="orders-count-badge">@(caseOrdersList?.Count ?? 0) Files</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link btn-sm py-1 px-3 fw-bold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab">
                                        <i class="bi bi-clock-history me-1"></i> Case Hearing History 
                                        <span class="badge bg-light text-dark ms-1" id="history-count-badge">0 Hearings</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link btn-sm py-1 px-3 fw-bold" id="ia-tab" data-bs-toggle="tab" data-bs-target="#ia-pane" type="button" role="tab">
                                        <i class="bi bi-file-earmark-text me-1"></i> IA Applications 
                                        <span class="badge bg-light text-primary ms-1" id="ia-count-badge">0 IAs</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link btn-sm py-1 px-3 fw-bold" id="fulldata-tab" data-bs-toggle="tab" data-bs-target="#fulldata-pane" type="button" role="tab">
                                        <i class="bi bi-card-text me-1"></i> Full eCourts Payload
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content" id="ecourtsOtherTabContent">
                                <!-- Orders Pane -->
                                <div class="tab-pane fade show active" id="orders-pane" role="tabpanel">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-2 gap-2">
                                        <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Verified Court Orders &amp; Judgments fetched via eCourts Gateway</small>
                                        <div class="d-flex gap-2">
                                            <a href="/ECourts/DownloadAllOrdersZip?cnr=@Model.CNRNumber" class="btn btn-sm btn-outline-danger rounded-pill shadow-sm fw-semibold" title="Download all orders in a single ZIP">
                                                <i class="bi bi-file-earmark-zip-fill me-1"></i> Download All Orders (ZIP)
                                            </a>
                                        </div>
                                    </div>

                                    <div id="live-orders-container">
                                        @if (caseOrdersList != null && caseOrdersList.Any())
                                        {
                                            <div class="table-responsive rounded border bg-white shadow-xs">
                                                <table class="table table-sm table-hover mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 5%;">#</th>
                                                            <th style="width: 25%;">Order Date</th>
                                                            <th style="width: 45%;">Order / Judgment Description</th>
                                                            <th class="text-end" style="width: 25%;">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{ int oIdx = 0; }
                                                        @foreach (var ord in caseOrdersList)
                                                        {
                                                            oIdx++;
                                                            string oPath = !string.IsNullOrWhiteSpace(ord.LocalPdfPath) ? ord.LocalPdfPath : (ord.ExternalUrl ?? "");
                                                            <tr>
                                                                <td class="fw-bold">@oIdx</td>
                                                                <td>@(ord.OrderDate.HasValue ? ord.OrderDate.Value.ToString("dd-MMM-yyyy") : "—")</td>
                                                                <td class="fw-semibold text-dark">
                                                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>@ord.OrderType
                                                                </td>
                                                                <td class="text-end">
                                                                    @if (!string.IsNullOrEmpty(oPath))
                                                                    {
                                                                        <button type="button" onclick="openOrderInModal('@oPath', '@ord.OrderType', '@ord.Cnr', '@(ord.OrderDate?.ToString("dd-MM-yyyy") ?? "")', @Model.CaseID)" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0">
                                                                            <i class="bi bi-eye-fill me-1"></i>View PDF
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                                <i class="bi bi-file-earmark-pdf text-primary fs-5 d-block mb-1"></i>
                                                Click <strong>Fetch Live Status</strong> above to query court servers and download verified order copies.
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- History Pane -->
                                <div class="tab-pane fade" id="history-pane" role="tabpanel">
                                    <div id="live-history-container">
                                        <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                            <i class="bi bi-clock-history text-secondary fs-5 d-block mb-1"></i>
                                            Click <strong>Fetch Live Status</strong> to view the complete case hearing history.
                                        </div>
                                    </div>
                                </div>

                                <!-- IA Pane -->
                                <div class="tab-pane fade" id="ia-pane" role="tabpanel">
                                    <div id="live-ia-container">
                                        <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                            <i class="bi bi-file-earmark-text text-secondary fs-5 d-block mb-1"></i>
                                            Click <strong>Fetch Live Status</strong> to view interim applications.
                                        </div>
                                    </div>
                                </div>

                                <!-- Full Payload Pane -->
                                <div class="tab-pane fade" id="fulldata-pane" role="tabpanel">
                                    <div id="live-fulldata-container">
                                        <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                            <i class="bi bi-card-text text-secondary fs-5 d-block mb-1"></i>
                                            Click <strong>Fetch Live Status</strong> to view full eCourts response payload.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12 border-top mt-2 pt-3">
                            <div class="card border-primary border-opacity-25 bg-white shadow-sm rounded-3 p-4 text-center">
                                <h5 class="fw-bold text-dark mb-2">Connect This Case to Live e-Courts Gateway</h5>
                                <p class="text-muted small mb-3 mx-auto" style="max-width: 600px;">
                                    The 16-character CNR Number is not linked yet. Link the CNR to automatically track hearings, court halls, judges, and download verified orders directly.
                                </p>
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="autoLinkCnrInline(@Model.CaseID, 'OtherCourts')">
                                        <i class="bi bi-search me-1.5"></i> Auto-Discover &amp; Link CNR
                                    </button>
                                    <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="openUpdateCnrModal()">
                                        <i class="bi bi-pencil-square me-1.5"></i> Enter CNR Manually
                                    </button>
                                </div>
                                <div id="autolink-status-msg" class="mt-2"></div>
                            </div>
                        </div>
                    }

                    <div class="col-12 border-top pt-2 d-flex justify-content-between align-items-center">
                        <small class="text-muted" id="live-sync-msg">
                            @if (Model.LastNapixSyncAt.HasValue)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Synced: @Model.LastNapixSyncAt.Value.ToString("dd MMM yyyy, hh:mm tt") (@(Model.LastNapixSyncStatus ?? "Success"))</span>
                            }
                            else
                            {
                                <span><i class="bi bi-arrow-repeat me-1"></i> Ready for e-Courts synchronization</span>
                            }
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ======================================================== -->
<!-- 6. A-Z COMPREHENSIVE MASTER MODAL (8 SUB-TABS)           -->
<!-- ======================================================== -->
<div class="modal fade" id="otherCourtsFullDetailsModal" tabindex="-1" aria-labelledby="otherCourtsFullDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down" style="max-width: min(96vw, 1300px);">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            
            <!-- Modal Header -->
            <div class="modal-header border-0 py-3 px-4" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);">
                <div class="d-flex flex-column">
                    <h5 class="modal-title fw-bold text-white mb-0" id="otherCourtsFullDetailsModalLabel">
                        <i class="bi bi-folder2-open me-2 opacity-75"></i>Comprehensive A-Z Case Dossier: @courtName (@displayCaseNo/@(displayCaseYear?.ToString() ?? "-"))
                    </h5>
                    <small class="text-white opacity-75 mt-1" style="font-size: 0.78rem;">
                        <i class="bi bi-geo-alt me-1"></i>@printDivisionName Division &nbsp;|&nbsp;
                        <i class="bi bi-bank me-1"></i>@(string.IsNullOrEmpty(Model.Court) ? "Court Not Specified" : Model.Court)
                        @if (!string.IsNullOrEmpty(Model.CNRNumber))
                        {
                            <span>&nbsp;|&nbsp;<i class="bi bi-broadcast me-1"></i>CNR: @Model.CNRNumber</span>
                        }
                    </small>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-3 p-md-4" style="background-color: #f8fafc;">
                <!-- Navigation Tabs -->
                <ul class="nav nav-pills gap-2 mb-3 p-2 rounded-3 border bg-white shadow-sm flex-wrap" id="otherCourtsTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold small py-2 px-3 rounded-2" id="tab-general-nav" data-bs-toggle="pill" data-bs-target="#tab-general-content" type="button" role="tab">
                            <i class="bi bi-info-circle-fill me-1 text-primary"></i> General &amp; Incident
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-parties-nav" data-bs-toggle="pill" data-bs-target="#tab-parties-content" type="button" role="tab">
                            <i class="bi bi-people-fill me-1 text-indigo"></i> Parties &amp; Advocates
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-pleadings-nav" data-bs-toggle="pill" data-bs-target="#tab-pleadings-content" type="button" role="tab">
                            <i class="bi bi-shield-check me-1 text-info"></i> Pleadings &amp; Defense
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-evidence-nav" data-bs-toggle="pill" data-bs-target="#tab-evidence-content" type="button" role="tab">
                            <i class="bi bi-journal-check me-1 text-secondary"></i> Evidence &amp; Proof
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-cc-nav" data-bs-toggle="pill" data-bs-target="#tab-cc-content" type="button" role="tab">
                            <i class="bi bi-file-earmark-check me-1 text-success"></i> Certified Copy (CC)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-opinions-nav" data-bs-toggle="pill" data-bs-target="#tab-opinions-content" type="button" role="tab">
                            <i class="bi bi-chat-quote-fill me-1 text-warning"></i> Opinions &amp; Decisions
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-appeal-nav" data-bs-toggle="pill" data-bs-target="#tab-appeal-content" type="button" role="tab">
                            <i class="bi bi-bank me-1 text-danger"></i> Higher Court Appeals
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small py-2 px-3 rounded-2" id="tab-documents-nav" data-bs-toggle="pill" data-bs-target="#tab-documents-content" type="button" role="tab">
                            <i class="bi bi-folder-check me-1 text-dark"></i> Documents &amp; Vault
                        </button>
                    </li>
                </ul>

                <!-- Tabs Content -->
                <div class="tab-content" id="otherCourtsTabsContent">
                    
                    <!-- TAB 1: General & Incident -->
                    <div class="tab-pane fade show active" id="tab-general-content" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-building me-1"></i>Court &amp; Suit Particulars</h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Court Name</span>
                                        <strong class="text-dark small">@(string.IsNullOrEmpty(Model.Court) ? "—" : Model.Court)</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Case Type / Class</span>
                                        <span class="badge bg-primary">@courtName</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Nature of Suit</span>
                                        <span class="fw-semibold text-dark small">@(string.IsNullOrEmpty(Model.CaseNature) ? "Standard Civil Suit" : Model.CaseNature)</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Filing / Pending Status</span>
                                        <span class="fw-semibold text-dark small">@(Model.IsPendingForFiling ? "Pending for Filing" : "Filed in Court")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Valuation / Claim</span>
                                        <strong class="text-success small">@(Model.ClaimAmount.HasValue ? $"₹ {Model.ClaimAmount.Value:N2}" : "—")</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-truck me-1"></i>Incident &amp; Vehicle Particulars</h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Date of Incident</span>
                                        <strong class="text-dark small">@(Model.DateOfAccident?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Vehicle Involved?</span>
                                        <span class="badge @(Model.IsVehicleInvolved == "yes" ? "bg-primary" : "bg-secondary")">@(Model.IsVehicleInvolved?.ToUpper() ?? "NO")</span>
                                    </div>
                                    @if (Model.IsVehicleInvolved == "yes")
                                    {
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Vehicle Number</span>
                                            <span class="badge bg-dark font-monospace">@Model.VehicleNumber</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Vehicle Type</span>
                                            <span class="fw-semibold text-dark small">@Model.VehicleType</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Corporation Employee?</span>
                                        <span class="badge @(Model.IsCorporationEmployee == "Yes" ? "bg-info text-dark" : "bg-light text-dark border")">@(Model.IsCorporationEmployee ?? "No")</span>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ClaimDetails) || !string.IsNullOrEmpty(Model.MannerOfIncident))
                            {
                                <div class="col-12">
                                    <div class="p-3 bg-white rounded-3 border shadow-xs">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Relief Sought &amp; Manner of Incident</h6>
                                        <div class="text-dark small white-space-pre-line">@(!string.IsNullOrEmpty(Model.ClaimDetails) ? Model.ClaimDetails : Model.MannerOfIncident)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- TAB 2: Parties & Advocates -->
                    <div class="tab-pane fade" id="tab-parties-content" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-person-fill me-1"></i>Petitioner(s) / Plaintiff(s)</h6>
                                    @if (Model.Petitioners != null && Model.Petitioners.Any())
                                    {
                                        @foreach (var p in Model.Petitioners)
                                        {
                                            <div class="p-2 border rounded mb-2 bg-light">
                                                <div class="fw-bold text-dark small">@p.Name</div>
                                                @if (!string.IsNullOrEmpty(p.Remark)) { <small class="text-muted d-block">@p.Remark</small> }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark small">@(string.IsNullOrEmpty(Model.PetitionerName) ? (Model.LitigantType == "Corporation" ? OrgService.GetCurrentSettings().OrganizationNameEnglish : "Plaintiff") : Model.PetitionerName)</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-building me-1"></i>Respondent(s) / Defendant(s)</h6>
                                    @if (Model.Respondents != null && Model.Respondents.Any())
                                    {
                                        @foreach (var r in Model.Respondents)
                                        {
                                            <div class="p-2 border rounded mb-2 bg-light">
                                                <div class="fw-bold text-dark small">@r.Name</div>
                                                @if (!string.IsNullOrEmpty(r.Remark)) { <small class="text-muted d-block">@r.Remark</small> }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark small">@(string.IsNullOrEmpty(Model.RespondentName) ? (Model.LitigantType == "Corporation" ? "Opposite Party" : OrgService.GetCurrentSettings().OrganizationNameEnglish) : Model.RespondentName)</div>
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-3 bg-white rounded-3 border shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-2"><i class="bi bi-briefcase-fill me-1"></i>Corporation Advocate Entrustment</h6>
                                    <div class="row g-2 small">
                                        <div class="col-md-4">
                                            <span class="text-muted d-block">Advocate Name</span>
                                            <strong class="text-dark">@(string.IsNullOrEmpty(Model.AdvocateName) ? "Not Assigned" : Model.AdvocateName)</strong>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="text-muted d-block">Entrustment No</span>
                                            <strong class="text-dark">@(Model.EntrustmentNumber ?? "—")</strong>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="text-muted d-block">Entrustment Date</span>
                                            <strong class="text-dark">@(Model.EntrustmentDate?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: Pleadings & Defense -->
                    <div class="tab-pane fade" id="tab-pleadings-content" role="tabpanel">
                        <div class="p-3 bg-white rounded-3 border shadow-xs">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-shield-check me-1"></i>Pleadings &amp; Injunction Status</h6>
                            <div class="row g-3 small">
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Records Sent Outward No</span>
                                    <strong class="text-dark">@(Model.InitialOutwardNumber ?? "—")</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Records Sent Date</span>
                                    <strong class="text-dark">@(Model.InitialOutwardDate?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Written Statement Filed</span>
                                    <span class="badge @(Model.IsObjectionFiled == "Yes" ? "bg-success" : "bg-danger")">@(Model.IsObjectionFiled == "Yes" ? "YES" : "NO")</span>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">WS Outward No &amp; Date</span>
                                    <strong class="text-dark">@(Model.ObjectionOutwardNumber ?? "—") (@(Model.ObjectionFiledDate?.ToString("dd-MM-yyyy") ?? "—"))</strong>
                                </div>
                                <div class="col-md-8">
                                    <span class="text-muted d-block">Objection / Defense Remarks</span>
                                    <div class="p-2 bg-light rounded text-dark">@(string.IsNullOrEmpty(Model.ObjectionRemarks) ? "None recorded" : Model.ObjectionRemarks)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 4: Evidence & Witnesses -->
                    <div class="tab-pane fade" id="tab-evidence-content" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-people me-1"></i>Corporation Witnesses</h6>
                                    @if (Model.CorpEvidence != null && Model.CorpEvidence.Any())
                                    {
                                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                                            @foreach (var ev in Model.CorpEvidence)
                                            {
                                                <div class="list-group-item bg-light p-2 px-3 d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold small text-dark">@ev.Name</span>
                                                    <span class="badge bg-secondary-subtle text-dark border small">@(string.IsNullOrEmpty(ev.Designation) ? "Officer" : ev.Designation)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">No Corporation witnesses recorded.</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-person-lines-fill me-1"></i>Opposite Party Evidence</h6>
                                    @if (Model.RespondentEvidence != null && Model.RespondentEvidence.Any())
                                    {
                                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                                            @foreach (var ev in Model.RespondentEvidence)
                                            {
                                                <div class="list-group-item bg-light p-2 px-3 d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold small text-dark">@ev.Name</span>
                                                    <span class="text-muted small">@(string.IsNullOrEmpty(ev.Remark) ? "—" : ev.Remark)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">No opposite evidence recorded.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 5: Certified Copy (CC) -->
                    <div class="tab-pane fade" id="tab-cc-content" role="tabpanel">
                        <div class="p-3 bg-white rounded-3 border shadow-xs">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-file-earmark-check me-1"></i>Certified Copy (CC) Tracking Details</h6>
                            <div class="row g-3 small">
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block">Disposed On</span>
                                    <strong class="text-dark">@(Model.CopyDisposedOn?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block">Applied On</span>
                                    <strong class="text-dark">@(Model.CopyAppliedOn?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block">Ready On</span>
                                    <strong class="text-dark">@(Model.CopyReadyOn?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block">Delivered On</span>
                                    <strong class="text-dark">@(Model.CopyDeliveredOn?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block">Received at Division</span>
                                    <strong class="text-dark">@(Model.CopyReceivedAtDivision?.ToString("dd-MM-yyyy") ?? "—")</strong>
                                </div>
                                <div class="col-12">
                                    <span class="text-muted d-block">Delay / Special Remarks</span>
                                    <div class="p-2 bg-light rounded text-dark">@(string.IsNullOrEmpty(Model.CertifiedCopyRemarks) ? "No remarks" : Model.CertifiedCopyRemarks)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 6: Opinions & Decisions -->
                    <div class="tab-pane fade" id="tab-opinions-content" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-2"><i class="bi bi-briefcase me-1"></i>Advocate's Opinion</h6>
                                    <div class="text-dark small white-space-pre-line">@(string.IsNullOrEmpty(Model.AdvocateOpinion) ? "No opinion recorded" : Model.AdvocateOpinion)</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-2"><i class="bi bi-shield me-1"></i>Law Officer's Opinion</h6>
                                    <div class="text-dark small white-space-pre-line">@(string.IsNullOrEmpty(Model.LawOfficerOpinion) ? "No opinion recorded" : Model.LawOfficerOpinion)</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-2"><i class="bi bi-check2-circle me-1"></i>DC's Final Decision</h6>
                                    <div class="text-dark small white-space-pre-line">@(string.IsNullOrEmpty(Model.DCFinalDecision) ? "No decision recorded" : Model.DCFinalDecision)</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-3 bg-white rounded-3 border shadow-xs d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-muted small d-block">Forwarding to Central Office</span>
                                        <span class="badge bg-secondary rounded-pill px-3 py-1">@(Model.FinalForwardingStatus ?? "Pending at Division")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.OutwardNumber))
                                    {
                                        <div>
                                            <span class="text-muted small d-block">CO Outward No &amp; Date</span>
                                            <strong class="text-dark small">@Model.OutwardNumber (@(Model.OutwardDate?.ToString("dd-MM-yyyy") ?? "—"))</strong>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 7: Higher Court Appeals -->
                    <div class="tab-pane fade" id="tab-appeal-content" role="tabpanel">
                        <div class="p-3 bg-white rounded-3 border shadow-xs">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-bank me-1"></i>Appellate Proceedings</h6>
                            <div class="row g-3 small">
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Appeal Number &amp; Year</span>
                                    <strong class="text-dark fs-6">@(string.IsNullOrEmpty(Model.AppealNumber) ? "Not Filed" : $"{Model.AppealNumber} / {Model.AppealYear}")</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Appellate Authority / Court</span>
                                    <strong class="text-dark">@(Model.CourtAppellateAuth ?? "—")</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Appeal Advocate</span>
                                    <strong class="text-dark">@(Model.AppealAdvocateName ?? "—")</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Compliance Amount</span>
                                    <strong class="text-success">@(Model.AppealComplianceAmount.HasValue ? $"₹ {Model.AppealComplianceAmount.Value:N2}" : "—")</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Cheque Number &amp; Date</span>
                                    <strong class="text-dark">@(Model.AppealChequeNumber ?? "—") (@(Model.AppealChequeDate?.ToString("dd-MM-yyyy") ?? "—"))</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted d-block">Appeal Status</span>
                                    <span class="badge bg-secondary">@(Model.AppealForwardingStatus ?? "Pending")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.AppealAwardDetails))
                                {
                                    <div class="col-12">
                                        <span class="text-muted d-block">Appeal Findings / Remarks</span>
                                        <div class="p-2 bg-light rounded text-dark">@Model.AppealAwardDetails</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- TAB 8: Documents & Vault -->
                    <div class="tab-pane fade" id="tab-documents-content" role="tabpanel">
                        <div class="p-3 bg-white rounded-3 border shadow-xs">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-folder-check me-1"></i>Persistent Document Vault (uploads_vault/other_courts)</h6>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill extra-small">
                                    <i class="bi bi-shield-check me-1"></i>Zero Fallback Isolation
                                </span>
                            </div>

                            <div class="row g-3">
                                <!-- 1. Interim Order Document -->
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="bi bi-file-earmark-text text-warning fs-5 me-2"></i>
                                                <strong class="small text-dark">Interim Order Copy</strong>
                                            </div>
                                            <small class="text-muted d-block text-truncate">@(string.IsNullOrEmpty(Model.InterimOrderFilePath) ? "No file uploaded" : Model.InterimOrderFilePath.Split('/').Last())</small>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            @if (!string.IsNullOrEmpty(Model.InterimOrderFilePath))
                                            {
                                                <button type="button" onclick="openOrderInModal('@Model.InterimOrderFilePath', 'Interim Order Copy', '@(Model.CNRNumber ?? "")', '@courtName', @Model.CaseID)" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 flex-fill">
                                                    <i class="bi bi-eye-fill me-1"></i>View
                                                </button>
                                            }
                                            <button type="button" onclick="openEditOtherCourtsDocModal('InterimOrderFilePath', 'Interim Order Copy', '@(Model.InterimOrderFilePath ?? "")', 'Interim Order Injunction')" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 flex-fill">
                                                <i class="bi bi-upload me-1"></i>Re-upload
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. Final Judgment Document -->
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="bi bi-file-earmark-pdf text-success fs-5 me-2"></i>
                                                <strong class="small text-dark">Final Judgment Order</strong>
                                            </div>
                                            <small class="text-muted d-block text-truncate">@(string.IsNullOrEmpty(Model.FinalJudgmentFilePath) ? "No file uploaded" : Model.FinalJudgmentFilePath.Split('/').Last())</small>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            @if (!string.IsNullOrEmpty(Model.FinalJudgmentFilePath))
                                            {
                                                <button type="button" onclick="openOrderInModal('@Model.FinalJudgmentFilePath', 'Final Judgment Copy', '@(Model.CNRNumber ?? "")', '@courtName', @Model.CaseID)" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 flex-fill">
                                                    <i class="bi bi-eye-fill me-1"></i>View
                                                </button>
                                            }
                                            <button type="button" onclick="openEditOtherCourtsDocModal('FinalJudgmentFilePath', 'Final Judgment Order', '@(Model.FinalJudgmentFilePath ?? "")', 'Final Order / Decree')" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 flex-fill">
                                                <i class="bi bi-upload me-1"></i>Re-upload
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- 3. Appeal Judgment Document -->
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="bi bi-file-earmark-ruled text-primary fs-5 me-2"></i>
                                                <strong class="small text-dark">Appeal Judgment Copy</strong>
                                            </div>
                                            <small class="text-muted d-block text-truncate">@(string.IsNullOrEmpty(Model.AppealJudgmentCopyPath) ? "No file uploaded" : Model.AppealJudgmentCopyPath.Split('/').Last())</small>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            @if (!string.IsNullOrEmpty(Model.AppealJudgmentCopyPath))
                                            {
                                                <button type="button" onclick="openOrderInModal('@Model.AppealJudgmentCopyPath', 'Appeal Judgment Copy', '@(Model.CNRNumber ?? "")', '@courtName', @Model.CaseID)" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 flex-fill">
                                                    <i class="bi bi-eye-fill me-1"></i>View
                                                </button>
                                            }
                                            <button type="button" onclick="openEditOtherCourtsDocModal('AppealJudgmentCopyPath', 'Appeal Judgment Copy', '@(Model.AppealJudgmentCopyPath ?? "")', 'Higher Court Appeal')" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 flex-fill">
                                                <i class="bi bi-upload me-1"></i>Re-upload
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (Model.EnclosedDocuments != null && Model.EnclosedDocuments.Any())
                            {
                                <div class="mt-4 pt-3 border-top">
                                    <h6 class="fw-bold text-dark mb-2">Enclosed Case Documents</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Document Name</th>
                                                    <th class="text-end">Pages</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var doc in Model.EnclosedDocuments)
                                                {
                                                    <tr>
                                                        <td class="fw-bold text-dark small"><i class="bi bi-file-earmark-text text-secondary me-2"></i>@doc.DocName</td>
                                                        <td class="text-end text-muted small">@(doc.PageCount.HasValue ? doc.PageCount.ToString() : "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 px-4 py-2" style="background: #f1f5f9;">
                <small class="text-muted me-auto" style="font-size: 0.75rem;">
                    <i class="bi bi-shield-check me-1 text-primary"></i>@(OrgService.GetCurrentSettings().OrganizationShortName) Law Management System &bull; Verified Data Integrity
                </small>
                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Case Dossier
                </button>
                <button type="button" class="btn btn-secondary rounded-pill px-4 py-2" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

