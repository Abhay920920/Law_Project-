                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill extra-small px-2 py-0.5">
                                <i class="bi bi-shield-check me-1"></i>Vault Target
                            </span>
                        </div>
                        <div class="fw-bold text-dark small text-truncate" id="editDocCurrentTitle">Document Title</div>
