@section Scripts {
    <script>
        function openOrderInModal(pdfUrl, title, cnr, orderDate, caseId) {
            if (!pdfUrl) return;
            var modalEl = document.getElementById('ecourtsOrderModal');
            var iframe = document.getElementById('orderModalIframe');
            var titleEl = document.getElementById('ecourtsOrderModalLabel');
            var subEl = document.getElementById('ecourtsOrderModalSub');
            var extBtn = document.getElementById('btnDownloadOrderExternal');
            var loader = document.getElementById('orderModalLoading');

            if (!modalEl || !iframe) return;

            var viewerUrl = '/ECourts/ViewOrderPdf?url=' + encodeURIComponent(pdfUrl) + '&caseId=' + (caseId || 0) + '&title=' + encodeURIComponent(title || 'Order');

            titleEl.textContent = title || 'Court Order / Document';
            subEl.textContent = (cnr ? 'CNR: ' + cnr : '') + (orderDate ? ' | Date: ' + orderDate : '');
            extBtn.href = viewerUrl;

            loader.style.display = 'block';
            iframe.src = viewerUrl;

            var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
            bsModal.show();
        }

        function openUpdateCnrModal() {
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('updateCnrModal'));
            var input = document.getElementById('txtNewCnrNumber');
            if (input) onCnrInputChange(input);
            modal.show();
        }

        function onCnrInputChange(el) {
            var val = (el.value || '').trim();
            var counter = document.getElementById('cnrCharCount');
            if (counter) {
                counter.textContent = val.length + ' / 16 chars';
                if (val.length === 16) {
                    counter.className = 'badge bg-success font-monospace';
                } else {
                    counter.className = 'badge bg-secondary font-monospace';
                }
            }
        }

        function submitUpdateCnr() {
            var caseId = document.getElementById('updateCnrCaseId').value;
            var cnr = document.getElementById('txtNewCnrNumber').value.trim();
            var btn = document.getElementById('btnSaveCnr');

            if (cnr && cnr.length !== 16) {
                alert('CNR Number must be exactly 16 characters (e.g. KADW200035312025).');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            var token = document.querySelector('#updateCnrForm input[name="__RequestVerificationToken"]').value;

            var formData = new FormData();
            formData.append('caseId', caseId);
            formData.append('cnrNumber', cnr);
            formData.append('__RequestVerificationToken', token);

            fetch('/Home/UpdateCnr', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save &amp; Link CNR';
                if (data.success) {
                    alert(data.message || 'CNR Number updated successfully!');
                    location.reload();
                } else {
                    alert(data.message || 'Failed to update CNR Number.');
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save &amp; Link CNR';
                alert('Network error: ' + err);
            });
        }

        function unlinkCnrNumber() {
            if (!confirm('Are you sure you want to unlink the CNR Number from this case?')) return;
            document.getElementById('txtNewCnrNumber').value = '';
            submitUpdateCnr();
        }

        function openEditOtherCourtsDocModal(docKey, title, currentPath, category) {
            document.getElementById('editDocKey').value = docKey || '';
            document.getElementById('editDocCategoryBadge').textContent = category || 'Other Courts Document';
            document.getElementById('editDocCurrentTitle').textContent = title || 'Document';
            document.getElementById('editDocCurrentFile').textContent = currentPath ? currentPath.split('/').pop().split('\\').pop() : 'No file attached';
            document.getElementById('editDocTitleInput').value = title || '';
            document.getElementById('editDocRemarksInput').value = '';
            document.getElementById('editDocFileInput').value = '';

            var statusDiv = document.getElementById('editDocStatusMsg');
            if (statusDiv) {
                statusDiv.classList.add('d-none');
                statusDiv.innerHTML = '';
            }

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editOtherCourtsDocModal'));
            modal.show();
        }

        function submitEditOtherCourtsDoc() {
            var form = document.getElementById('formEditOtherCourtsDoc');
            var btn = document.getElementById('btnSubmitEditDoc');
            var statusDiv = document.getElementById('editDocStatusMsg');
            var fileInput = document.getElementById('editDocFileInput');

            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Please select a replacement file.');
                return;
            }

            var formData = new FormData(form);
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Securing in Vault...';

            if (statusDiv) {
                statusDiv.className = 'small fw-bold text-primary text-center mt-2';
                statusDiv.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Storing in persistent vault...';
                statusDiv.classList.remove('d-none');
            }

            fetch('/Home/UpdateOrReuploadOtherCourtsDocument', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save &amp; Secure in Vault';
                if (data.success) {
                    if (statusDiv) {
                        statusDiv.className = 'small fw-bold text-success text-center mt-2';
                        statusDiv.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + (data.message || 'Updated successfully!');
                    }
                    setTimeout(function() { location.reload(); }, 900);
                } else {
                    if (statusDiv) {
                        statusDiv.className = 'small fw-bold text-danger text-center mt-2';
                        statusDiv.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (data.message || 'Failed.');
                    }
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save &amp; Secure in Vault';
                if (statusDiv) {
                    statusDiv.className = 'small fw-bold text-danger text-center mt-2';
                    statusDiv.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Error: ' + err;
                }
            });
        }

        function triggerFetchOtherCourtsLiveStatus() {
            var caseId = @Model.CaseID;
            var cnr = '@(Model.CNRNumber ?? "")';
            if (!cnr) return;

            var btn = document.getElementById('btnRefreshCaseLive');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Fetching...';
            }

            var formData = new FormData();
            formData.append('caseId', caseId);
            formData.append('cnrNumber', cnr);
            formData.append('module', 'OtherCourts');

            fetch('/ECourts/QueueCaseSync', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success && data.queueId) {
                    var pollCount = 0;
                    var timer = setInterval(function() {
                        pollCount++;
                        if (pollCount > 30) {
                            clearInterval(timer);
                            alert('Live sync queued. Please refresh in a moment.');
                            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status'; }
                            return;
                        }

                        fetch('/ECourts/GetQueueStatus?queueId=' + data.queueId + '&caseId=' + caseId + '&module=OtherCourts')
                        .then(res => res.json())
                        .then(sData => {
                            if (sData.status === 'Success') {
                                clearInterval(timer);
                                location.reload();
                            } else if (sData.status === 'Failed') {
                                clearInterval(timer);
                                alert('eCourts Sync Failed: ' + (sData.error || 'eCourts returned error'));
                                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status'; }
                            }
                        })
                        .catch(() => {
                            clearInterval(timer);
                            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status'; }
                        });
                    }, 1200);
                } else {
                    alert(data.message || 'Could not queue live sync.');
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status'; }
                }
            })
            .catch(err => {
                alert('Network error: ' + err);
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status'; }
            });
        }

        function autoLinkCnrInline(caseId, module) {
            var statusDiv = document.getElementById('autolink-status-msg');
            if (statusDiv) {
                statusDiv.innerHTML = '<span class="text-primary small fw-bold"><span class="spinner-border spinner-border-sm me-1"></span> Searching eCourts Gateway for CNR...</span>';
            }

            fetch('/ECourts/AutoDiscoverCNR?caseId=' + caseId + '&module=' + encodeURIComponent(module))
            .then(r => r.json())
            .then(data => {
                if (data.success && data.cnrNumber) {
                    if (statusDiv) {
                        statusDiv.innerHTML = '<span class="text-success small fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Found &amp; Linked CNR: ' + data.cnrNumber + '!</span>';
                    }
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    if (statusDiv) {
                        statusDiv.innerHTML = '<span class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (data.message || 'No matching CNR found. Please enter manually.') + '</span>';
                    }
                }
            })
            .catch(err => {
                if (statusDiv) {
                    statusDiv.innerHTML = '<span class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Error: ' + err + '</span>';
                }
            });
        }
    </script>
}
