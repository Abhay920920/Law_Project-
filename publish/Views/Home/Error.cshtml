@{
    ViewData["Title"] = $"Error — {OrgService.GetCurrentSettings().OrganizationShortName} Nyaya Patha";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-2">An Unexpected Error Occurred</h3>
                <p class="text-muted mb-4">
                    The requested operation could not be completed. The incident has been recorded in the application diagnostics log.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Dashboard" class="btn btn-primary px-4 py-2 rounded-pill shadow-xs">
                        <i class="bi bi-house-door me-1"></i> Return to Dashboard
                    </a>
                    <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill" onclick="window.history.back()">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
