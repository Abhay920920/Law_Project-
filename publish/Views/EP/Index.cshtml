@model IEnumerable<MVCCaseManagement.Models.EPViewModel>

@{
    ViewData["Title"] = "Execution Petition (EP) Management";
    ViewData["PageHeaderClass"] = "ep-header";
    ViewData["HidePageHeader"] = true;
}

<div class="container-fluid px-4 py-3">
    <!-- Header Line -->
    <div class="d-flex align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0 pe-3 border-end border-2 border-primary-subtle">Execution Petitions</h4>
        <nav aria-label="breadcrumb" class="ms-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Home/Index" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active">EP Management</li>
            </ol>
        </nav>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card total ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Total EPs</span>
                    <h4 class="stat-value">@Model.Count()</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card pending ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Pending Accounts</span>
                    <h4 class="stat-value">@Model.Count(x => x.IsSentToAccounts)</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-bank"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card disposed ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Fully Paid</span>
                    <h4 class="stat-value">@Model.Count(x => x.ComplianceStatus == "Paid")</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card against ultra-mini">
                <div class="stat-content">
                    <span class="stat-label">Unpaid / Action Due</span>
                    <h4 class="stat-value">@Model.Count(x => x.ComplianceStatus == "Pending")</h4>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
            </div>
        </div>
    </div>

<style>
    .stat-card.ultra-mini {
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        min-height: 80px;
        display: flex;
        align-items: center;
    }
    .stat-card.ultra-mini .stat-value {
        font-size: 1.5rem;
        margin: 0;
        font-weight: 800;
    }
    .stat-card.ultra-mini .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        opacity: 0.85;
    }
    .stat-card.ultra-mini .stat-icon-bg {
        font-size: 2rem;
        right: 8px;
        bottom: -2px;
        opacity: 0.12;
    }
    
    /* Table Improvements */
    .ep-table thead th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1rem 0.75rem;
        border-bottom: 2px solid #e2e8f0;
    }
    .ep-table tbody tr {
        transition: all 0.2s;
    }
    .ep-table tbody tr:hover {
        background-color: #f1f5f9 !important;
        transform: scale(1.002);
    }
    .ep-table td {
        padding: 1rem 0.75rem;
        font-size: 0.9rem;
    }
</style>

    <div class="gov-card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="gov-card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <div class="header-title h6 mb-0 fw-bold text-dark">
                <i class="bi bi-journal-text me-2 text-primary"></i>
                Active Execution Petitions
            </div>
            <div>
                 <a href="@Url.Action("Create", "EP")" class="btn btn-primary btn-sm rounded-3 px-3">
                    <i class="bi bi-plus-circle me-1"></i> New EP Entry
                </a>
            </div>
        </div>
        <div class="gov-card-body p-3 border-top border-bottom bg-light-subtle">
             <div class="row align-items-center">
                <div class="col-md-5">
                    <form method="get" asp-action="Index">
                        <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Filter by MVC / Vehicle No...">
                            <button class="btn btn-primary px-3" type="submit">Filter</button>
                        </div>
                    </form>
                </div>
                <div class="col-md-7 text-end">
                    <div class="btn-group btn-group-sm shadow-sm rounded-3 overflow-hidden border">
                        <a href="@Url.Action("Index", new { search = ViewBag.CurrentSearch, status = "all" })" class="btn px-3 @(ViewBag.CurrentStatus == "all" ? "btn-primary border-primary" : "btn-white text-muted")">All</a>
                        <a href="@Url.Action("Index", new { search = ViewBag.CurrentSearch, status = "SentToCO" })" class="btn px-3 @(ViewBag.CurrentStatus == "SentToCO" ? "btn-primary border-primary" : "btn-white text-muted")">CO Pending</a>
                        <a href="@Url.Action("Index", new { search = ViewBag.CurrentSearch, status = "Favor" })" class="btn px-3 @(ViewBag.CurrentStatus == "Favor" ? "btn-primary border-primary" : "btn-white text-muted")">Favor</a>
                        <a href="@Url.Action("Index", new { search = ViewBag.CurrentSearch, status = "Against" })" class="btn px-3 @(ViewBag.CurrentStatus == "Against" ? "btn-primary border-primary" : "btn-white text-muted")">Against</a>
                    </div>
                </div>
             </div>
        </div>
        <div class="gov-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 ep-table">
                    <thead>
                        <tr>
                            <th style="width: 15%">MVC Reference</th>
                            <th style="width: 20%">MACT Details</th>
                            <th style="width: 20%">Compliance Status</th>
                            <th style="width: 15%">Amount Details</th>
                            <th style="width: 20%">Filing Date</th>
                            <th class="text-end" style="width: 10%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="py-4 opacity-75">
                                        <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
                                        <h6 class="fw-bold">No Records Found</h6>
                                        <p class="small mb-0">Try adjusting your filters or search criteria</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark">MVC @item.ArisingFromMVCNo</span>
                                            <span class="small text-muted text-uppercase tracking-wider">Year: @item.ArisingFromMVCYear</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-secondary">
                                            <i class="bi bi-building me-1 opacity-50"></i>
                                            @item.ArisingFromMACT
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = item.ComplianceStatus switch
                                            {
                                                "Paid" => "bg-success-subtle text-success border-success-subtle",
                                                "Partially Paid" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
                                                "Pending" => "bg-danger-subtle text-danger border-danger-subtle",
                                                _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                                            };
                                        }
                                        <span class="badge border px-3 py-1 fw-bold @badgeClass" style="border-radius: 6px;">
                                            @(item.ComplianceStatus ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.AmountPaid.HasValue)
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-success">₹ @item.AmountPaid.Value.ToString("N2")</span>
                                                <span class="text-muted" style="font-size: 0.7rem;">PAID AMOUNT</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border py-1 px-2">UNSPECIFIED</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark small"><i class="bi bi-calendar-check me-1"></i>@DateTime.Now.ToString("dd-MMM-yyyy")</span>
                                            <span class="text-muted" style="font-size: 0.7rem;">ENTRY DATE</span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("Edit", "EP", new { id = item.EPID })" class="btn btn-sm btn-outline-primary border-0 p-1" title="Edit">
                                                <i class="bi bi-pencil-square fs-6"></i>
                                            </a>
                                            <a href="@Url.Action("Details", "EP", new { id = item.EPID })" class="btn btn-sm btn-outline-dark border-0 p-1" title="View">
                                                <i class="bi bi-arrow-right-circle fs-6"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">&laquo;</a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">@i</a>
                                </li>
                            }
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .ep-header {
        background: linear-gradient(135deg, #e0f2fe 0%, #ffffff 100%);
        border-bottom: 1px solid #bae6fd;
    }
    
    .text-navy { color: #1e3a8a; }

    .btn-icon-only {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .btn-icon-only:hover {
        background-color: #f1f5f9 !important;
        transform: translateY(-2px);
    }
</style>
