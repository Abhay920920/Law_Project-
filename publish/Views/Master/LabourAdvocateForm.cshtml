@model MVCCaseManagement.Models.LabourAdvocate
@{
    ViewData["Title"] = Model.AdvocateID == 0 ? "Add Labour Advocate" : "Edit Labour Advocate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container fade-in" style="max-width: 600px;">
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white py-3">
             <h5 class="mb-0 text-primary fw-bold">
                <i class="bi bi-person-badge me-2"></i>@(Model.AdvocateID == 0 ? "Add New Advocate" : "Edit Advocate")
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="@(Model.AdvocateID == 0 ? "LabourAdvocateCreate" : "LabourAdvocateEdit")" method="post">
                <input type="hidden" asp-for="AdvocateID" />
                
                <div class="mb-4">
                    <label asp-for="AdvocateName" class="form-label small fw-bold text-uppercase">Advocate Name</label>
                    <input asp-for="AdvocateName" class="form-control" placeholder="e.g. Adv. R.K. Sharma" autofocus />
                    <span asp-validation-for="AdvocateName" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a href="@Url.Action("LabourAdvocates", "Master")" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
