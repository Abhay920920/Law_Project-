@model MVCCaseManagement.Models.HighCourtCauseListViewModel
@{
    ViewData["Title"] = "High Court Cause List — Central Office";
    ViewData["HidePageHeader"] = true;
}

<style>
    .hc-causelist-page {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .hc-header-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
        color: #fff;
        border-radius: 12px;
    }
    .hc-tab-btn {
        border-radius: 8px;
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .hc-tab-btn:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    .hc-tab-registered.active {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
        color: #fff !important;
        border-color: #2563eb !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }
    .hc-tab-live.active {
        background: linear-gradient(135deg, #991b1b 0%, #dc2626 100%) !important;
        color: #fff !important;
        border-color: #dc2626 !important;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
    }
    .kpi-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;
    }
    .corp-match-row {
        background-color: #ecfdf5 !important;
        border-left: 4px solid #10b981 !important;
    }
    .animate-pulse {
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.6; }
        100% { opacity: 1; }
    }
    .hc-toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1080;
        max-width: 380px;
    }

    @@media (max-width: 767.98px) {
        .hc-header-gradient {
            padding: 1.1rem !important;
            border-radius: 1rem !important;
        }
        .hc-header-gradient h3 {
            font-size: 1.15rem !important;
        }
        .hc-tab-btn {
            font-size: 0.8rem !important;
            padding: 0.5rem 0.75rem !important;
            text-align: center;
        }
        .kpi-card {
            border-radius: 1rem !important;
            margin-bottom: 0.5rem;
        }
        .hc-toast-container {
            left: 12px;
            right: 12px;
            bottom: 12px;
            max-width: calc(100% - 24px);
        }
    }
</style>

<div class="hc-causelist-page">
    <!-- Header Banner -->
    <div class="hc-header-gradient p-4 mb-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1"><i class="bi bi-shield-check me-1"></i>CENTRAL OFFICE</span>
                <span class="badge bg-danger text-white font-monospace fw-bold px-2 py-1"><i class="bi bi-broadcast me-1"></i>LIVE E-COURTS GATEWAY</span>
            </div>
            <h3 class="fw-bold mb-1 text-white">
                <i class="bi bi-calendar-event-fill me-2 text-warning"></i>High Court Cause List & Hearing Schedule
            </h3>
            <p class="text-light text-opacity-75 small mb-0">Central Office Registry — Monitoring registered High Court MFA cases & live e-Courts listings.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-warning btn-sm fw-bold shadow-sm px-3 py-2" type="button" id="btnSyncAll" onclick="syncAllVisibleCnrs()">
                <i class="bi bi-arrow-repeat me-1"></i> Sync All Visible CNRs
            </button>
            <a href="/ECourts/HighCourtCauseList" class="btn btn-outline-light btn-sm px-3 py-2" title="Reload Listings">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </a>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
        <div class="col">
            <div class="card border-0 shadow-sm border-start border-4 border-danger bg-white kpi-card h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Listed Today (NWKRTC)</span>
                            <h2 class="fw-bold text-danger mb-0 mt-1" id="kpiListedTodayVal">@Model.NwkrtcListedTodayCount</h2>
                        </div>
                        <div class="bg-danger-subtle p-3 rounded-3 text-danger">
                            <i class="bi bi-bell-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-0 shadow-sm border-start border-4 border-primary bg-white kpi-card h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">With NWKRTC (Appellant)</span>
                            <h2 class="fw-bold text-primary mb-0 mt-1" id="kpiWithNwkrtcVal">@Model.NwkrtcWithCount</h2>
                        </div>
                        <div class="bg-primary-subtle p-3 rounded-3 text-primary">
                            <i class="bi bi-shield-check fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-0 shadow-sm border-start border-4 border-warning bg-white kpi-card h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Against NWKRTC (Respondent)</span>
                            <h2 class="fw-bold text-warning mb-0 mt-1" id="kpiAgainstNwkrtcVal">@Model.NwkrtcAgainstCount</h2>
                        </div>
                        <div class="bg-warning-subtle p-3 rounded-3 text-warning">
                            <i class="bi bi-shield-exclamation fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-0 shadow-sm border-start border-4 border-success bg-white kpi-card h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Total Saved in Registry</span>
                            <h2 class="fw-bold text-success mb-0 mt-1" id="kpiTotal">@Model.TotalRegisteredCases</h2>
                        </div>
                        <div class="bg-success-subtle p-3 rounded-3 text-success">
                            <i class="bi bi-check-circle-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Search & Roster Filter Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3 col-lg-3">
                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-bank me-1 text-danger"></i>High Court Establishment</label>
                    <select id="liveEstCode" class="form-select form-select-sm fw-bold" onchange="loadHcCourtBenches(); fetchLiveHcCauselist();">
                        <option value="ALL" selected>All High Court Benches (Bengaluru, Dharwad, Kalaburagi)</option>
                        <option value="KAHC01">High Court of Karnataka — Principal Bench (Bengaluru)</option>
                        <option value="KAHC02">High Court of Karnataka — Dharwad Bench</option>
                        <option value="KAHC03">High Court of Karnataka — Kalaburagi Bench</option>
                    </select>
                </div>

                <div class="col-12 col-md-3 col-lg-2">
                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-calendar-date me-1 text-danger"></i>Today's Hearing Date</label>
                    <input type="text" id="liveDate" class="form-control form-control-sm font-monospace fw-bold" value="@DateTime.Today.ToString("dd-MM-yyyy")" placeholder="dd-MM-yyyy" onchange="loadHcCourtBenches(); fetchLiveHcCauselist();" onkeyup="if(event.key==='Enter') fetchLiveHcCauselist();" />
                </div>

                <div class="col-12 col-md-3 col-lg-3">
                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-person-badge-fill me-1 text-danger"></i>Litigant Party Name</label>
                    <input type="text" id="livePartySearchInput" class="form-control form-control-sm fw-bold" value="NWKRTC" placeholder="e.g. NWKRTC, Managing Director, CPM" oninput="filterLiveCauselistRows()" onkeyup="if(event.key==='Enter') fetchLiveHcCauselist();" />
                </div>

                <div class="col-12 col-md-3 col-lg-2">
                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-diagram-3 me-1 text-danger"></i>Court Hall / Bench</label>
                    <select id="liveBenchId" class="form-select form-select-sm fw-bold" onchange="filterLiveCauselistRows()">
                        <option value="ALL">All Benches / Court Halls</option>
                    </select>
                </div>

                <div class="col-12 col-md-12 col-lg-2 d-flex gap-2">
                    <button type="button" class="btn btn-danger btn-sm w-100 fw-bold shadow-sm" onclick="fetchLiveHcCauselist()">
                        <i class="bi bi-broadcast me-1"></i> Search Today's Cause List
                    </button>
                </div>
            </div>

            <!-- Quick Party Presets & Saved CNR Dates Bar -->
            <div class="mt-2 pt-2 border-top d-flex flex-wrap align-items-center gap-1">
                <span class="extra-small fw-bold text-secondary text-uppercase me-1"><i class="bi bi-tags me-1 text-danger"></i>Party Presets:</span>
                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 extra-small active" id="chipLiveNwkrtc" onclick="setLivePartyPreset('NWKRTC')">NWKRTC</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveMd" onclick="setLivePartyPreset('MANAGING DIRECTOR')">Managing Director</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveCpm" onclick="setLivePartyPreset('CHIEF PERSONNEL MANAGER')">CPM</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveDc" onclick="setLivePartyPreset('DIVISIONAL CONTROLLER')">Divisional Controller</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveDm" onclick="setLivePartyPreset('DEPOT MANAGER')">Depot Manager</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveAll" onclick="setLivePartyPreset('')">All Parties (Entire Roster)</button>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="extra-small fw-bold text-secondary text-uppercase"><i class="bi bi-calendar3 me-1 text-primary"></i>Saved CNR Dates:</span>
                    <div id="quickHearingDateChips" class="d-inline-flex flex-wrap gap-1">
                        <!-- Populated dynamically -->
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 extra-small fw-bold" onclick="showAllSavedCnrCases()">
                        <i class="bi bi-card-checklist me-1"></i>View All Saved Cases (<span id="btnAllCnrCount">4</span>)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Cause List Results Container -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <h6 class="mb-0 fw-bold text-danger"><i class="bi bi-broadcast-pin me-2"></i>Official High Court Daily Cause List (e-Courts Live Gateway API)</h6>
                <div class="form-check form-switch m-0 border-start ps-3">
                    <input class="form-check-input" type="checkbox" id="chkOnlyToday" checked onchange="fetchLiveHcCauselist()">
                    <label class="form-check-label fw-bold text-danger small" for="chkOnlyToday">
                        <i class="bi bi-calendar-check-fill me-1"></i>Only Today's Listed Cases
                    </label>
                </div>
                <div class="form-check form-switch m-0 border-start ps-3">
                    <input class="form-check-input" type="checkbox" id="chkOnlyCorp" checked onchange="filterLiveCauselistRows()">
                    <label class="form-check-label fw-bold text-dark small" for="chkOnlyCorp">
                        <i class="bi bi-shield-check text-primary me-1"></i>Show Only Corporation Cases
                    </label>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary py-0 px-2 extra-small active" id="pillFilterAll" onclick="setLiveListingFilter('ALL')">All</button>
                    <button type="button" class="btn btn-outline-danger py-0 px-2 extra-small fw-bold" id="pillFilterToday" onclick="setLiveListingFilter('TODAY')"><i class="bi bi-bell-fill me-1"></i>Listed Today</button>
                    <button type="button" class="btn btn-outline-primary py-0 px-2 extra-small" id="pillFilterWith" onclick="setLiveListingFilter('WITH')">With NWKRTC</button>
                    <button type="button" class="btn btn-outline-warning text-dark py-0 px-2 extra-small" id="pillFilterAgainst" onclick="setLiveListingFilter('AGAINST')">Against NWKRTC</button>
                    <button type="button" class="btn btn-outline-success py-0 px-2 extra-small" id="pillFilterSaved" onclick="setLiveListingFilter('SAVED')">Saved in DB</button>
                </div>
                <span id="liveListBadge" class="badge bg-secondary px-3 py-1">Loading Today's Cause List...</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="liveCauselistContainer">
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-danger" role="status"></div>
                    <h5 class="mt-3 fw-bold">Querying High Court Daily Cause List for 'NWKRTC'...</h5>
                    <p class="small mb-0">Cross-referencing Dharwad, Bengaluru, and Kalaburagi official daily rosters.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Full e-Courts Dossier Modal -->
<div class="modal fade" id="dossierModal" tabindex="-1" aria-labelledby="dossierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="dossierModalLabel">
                    <i class="bi bi-journal-richtext me-2"></i>e-Courts Full Dossier — <span id="modalMfaNo" class="font-monospace"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info border-0 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <strong>CNR Number:</strong> <span id="modalCnr" class="font-monospace fw-bold fs-6 ms-1"></span>
                    </div>
                    <span id="modalLastUpdated" class="badge bg-white text-info fw-bold">Live Data</span>
                </div>

                <!-- Tabs -->
                <ul class="nav nav-tabs nav-fill mb-3" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold small" data-bs-toggle="tab" data-bs-target="#mTabHistory">
                            <i class="bi bi-clock-history me-1 text-primary"></i> Hearing History (<span id="mCountHistory">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small" data-bs-toggle="tab" data-bs-target="#mTabOrders">
                            <i class="bi bi-file-earmark-pdf me-1 text-danger"></i> Orders & Judgments (<span id="mCountOrders">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small" data-bs-toggle="tab" data-bs-target="#mTabParties">
                            <i class="bi bi-info-circle me-1 text-info"></i> Case Details
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- History Tab -->
                    <div class="tab-pane fade show active" id="mTabHistory">
                        <div class="table-responsive" style="max-height: 350px;">
                            <table class="table table-sm table-hover align-middle extra-small border mb-0">
                                <thead class="bg-light sticky-top">
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Stage / Purpose</th>
                                        <th>Bench / Judge</th>
                                        <th>Business On Date / Remarks</th>
                                    </tr>
                                </thead>
                                <tbody id="mTbodyHistory">
                                    <tr><td colspan="5" class="text-center text-muted py-3">Loading history...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Orders Tab -->
                    <div class="tab-pane fade" id="mTabOrders">
                        <div class="table-responsive" style="max-height: 350px;">
                            <table class="table table-sm table-hover align-middle extra-small border mb-0">
                                <thead class="bg-light sticky-top">
                                    <tr>
                                        <th>#</th>
                                        <th>Order Date</th>
                                        <th>Type / Details</th>
                                        <th>Judge</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="mTbodyOrders">
                                    <tr><td colspan="5" class="text-center text-muted py-3">Loading orders...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Parties Tab -->
                    <div class="tab-pane fade" id="mTabParties">
                        <div class="row g-3 small">
                            <div class="col-md-6 border-bottom pb-2"><strong>Petitioner(s):</strong> <div id="mPetitioner" class="fw-bold text-dark">—</div></div>
                            <div class="col-md-6 border-bottom pb-2"><strong>Respondent(s):</strong> <div id="mRespondent" class="fw-bold text-dark">—</div></div>
                            <div class="col-md-6 border-bottom pb-2"><strong>Petitioner Advocate:</strong> <div id="mPetAdv">—</div></div>
                            <div class="col-md-6 border-bottom pb-2"><strong>Respondent Advocate:</strong> <div id="mResAdv">—</div></div>
                            <div class="col-md-4"><strong>Filing Date:</strong> <div id="mFilingDate">—</div></div>
                            <div class="col-md-4"><strong>Registration Date:</strong> <div id="mRegDate">—</div></div>
                            <div class="col-md-4"><strong>Disposal Date:</strong> <div id="mDisposalDate">—</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Toast Container -->
<div class="hc-toast-container" id="hcToastContainer"></div>

<script>
let liveHcInitialized = false;

function showToast(title, message, isSuccess = true) {
    const container = document.getElementById('hcToastContainer');
    if (!container) return;

    const toastId = 'toast_' + Date.now();
    const borderClass = isSuccess ? 'border-success' : 'border-danger';
    const iconClass = isSuccess ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';

    const toastHtml = `
        <div id="${toastId}" class="toast align-items-center bg-white border ${borderClass} shadow-lg mb-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body small py-2">
                    <div class="fw-bold text-dark d-flex align-items-center">
                        <i class="bi ${iconClass} me-2 fs-6"></i> ${title}
                    </div>
                    <div class="text-muted mt-1 ps-4">${message}</div>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>`;
    container.insertAdjacentHTML('beforeend', toastHtml);

    const el = document.getElementById(toastId);
    if (el) {
        const bsToast = new bootstrap.Toast(el, { delay: 4000 });
        bsToast.show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }
}

function extractArrayFromData(data) {
    if (!data) return [];
    if (Array.isArray(data)) return data;
    if (typeof data === 'object') {
        const keys = ['causelist', 'causelistdetails', 'cause_list', 'cases', 'items', 'benches', 'court_halls', 'data', 'results'];
        for (let k of keys) {
            if (Array.isArray(data[k])) return data[k];
        }
        for (let k in data) {
            if (Array.isArray(data[k]) && data[k].length > 0) return data[k];
            if (typeof data[k] === 'object' && data[k] !== null) {
                let inner = extractArrayFromData(data[k]);
                if (inner.length > 0) return inner;
            }
        }
    }
    return [];
}

function initLiveHcCauselist() {
    populateScheduledDateChips();
    if (!liveHcInitialized) {
        liveHcInitialized = true;
        loadHcCourtBenches();
    }
    fetchLiveHcCauselist();
}

function normalizeDateKey(val) {
    if (!val) return "";
    val = String(val).split('T')[0].trim();
    const delim = val.includes('-') ? '-' : (val.includes('/') ? '/' : '');
    if (!delim) return val;
    const parts = val.split(delim);
    if (parts.length === 3) {
        if (parts[0].length === 4) {
            // YYYY-MM-DD
            return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
        } else {
            // DD-MM-YYYY
            return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
        }
    }
    return val;
}

function formatDateDisplay(val) {
    if (!val) return "—";
    const key = normalizeDateKey(val);
    if (key.length === 10) {
        const parts = key.split('-');
        return `${parts[2]}-${parts[1]}-${parts[0]}`;
    }
    return String(val);
}

function populateScheduledDateChips() {
    const chipContainer = document.getElementById('quickHearingDateChips');
    if (!chipContainer) return;

    const dateMap = new Map();
    let totalCnrCases = 0;

    registeredCases.forEach(c => {
        if (c.CNRNumber && c.CNRNumber.trim().length > 0) {
            totalCnrCases++;
            if (c.NextHearingDate) {
                const key = normalizeDateKey(c.NextHearingDate);
                if (key) {
                    if (!dateMap.has(key)) dateMap.set(key, []);
                    dateMap.get(key).push(c);
                }
            }
        }
    });

    const btnAllCnr = document.getElementById('btnAllCnrCount');
    if (btnAllCnr) btnAllCnr.textContent = totalCnrCases;

    let html = '';
    const sortedKeys = Array.from(dateMap.keys()).sort().reverse();
    sortedKeys.forEach(k => {
        const count = dateMap.get(k).length;
        const dParts = k.split('-');
        const displayD = `${dParts[2]}-${dParts[1]}-${dParts[0]}`;
        html += `<button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 extra-small rounded-pill fw-bold shadow-sm" onclick="selectScheduledDate('${displayD}')" title="${count} case(s) scheduled on ${displayD}">
            <i class="bi bi-calendar-event me-1"></i>${displayD} <span class="badge bg-danger ms-1">${count}</span>
        </button>`;
    });

    if (sortedKeys.length === 0) {
        html = '<span class="extra-small text-muted fst-italic">No upcoming hearing dates saved yet.</span>';
    }

    chipContainer.innerHTML = html;
}

