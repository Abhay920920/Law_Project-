function fetchLiveHcCauselist() {
    const estCode = document.getElementById('liveEstCode').value;
    const dateInputVal = document.getElementById('liveDate').value.trim();
    const targetKey = normalizeDateKey(dateInputVal);
    const benchId = document.getElementById('liveBenchId').value;
    const partyName = (document.getElementById('livePartySearchInput')?.value || 'NWKRTC').trim();
    const container = document.getElementById('liveCauselistContainer');
    const badge = document.getElementById('liveListBadge');
    const chkOnlyToday = document.getElementById('chkOnlyToday');
    const todayOnly = chkOnlyToday ? chkOnlyToday.checked : true;

    badge.className = "badge bg-warning text-dark px-3 py-1";
    badge.textContent = todayOnly ? "Checking Today's Roster..." : "Querying Live Gateway...";
    container.innerHTML = `<div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="mt-2 text-muted fw-bold">Checking official High Court Daily Cause List for '<strong>${partyName || 'NWKRTC'}</strong>' on ${dateInputVal}...</p>
        <p class="extra-small text-muted mb-0">${todayOnly ? "Filtering strictly to cases scheduled for hearing on " + dateInputVal + " across High Court benches..." : "Cross-referencing Dharwad, Bengaluru, Kalaburagi rosters, designations, and hearing schedules..."}</p>
    </div>`;

    let targetBench = "";
    if (estCode === "KAHC01") targetBench = "Bengaluru";
    else if (estCode === "KAHC02") targetBench = "Dharwad";
    else if (estCode === "KAHC03") targetBench = "Kalaburagi";
    else targetBench = "All Benches";

    // Call GetLiveHighCourtPartyCases with partyName, hearingDate, and todayOnly
    const partyUrl = `/ECourts/GetLiveHighCourtPartyCases?estCode=${encodeURIComponent(estCode)}&partyName=${encodeURIComponent(partyName || 'NWKRTC')}&hearingDate=${encodeURIComponent(dateInputVal)}&todayOnly=${todayOnly}`;

    fetch(partyUrl)
        .then(r => r.json())
        .then(res => {
            if (res && res.success && res.data && res.data.length > 0) {
                renderLivePartyCauseList(res.data, dateInputVal, targetBench, container, badge, res.todayCount, todayOnly);
            } else if (todayOnly) {
                // If 0 cases listed for today, show informative empty state with button to browse historical cases
                renderNoCasesListedTodayView(dateInputVal, targetBench, container, badge, partyName);
            } else {
                // If live party search returns 0, try causelist details or fallback table
                renderSavedCnrDateMatchTable(targetKey, dateInputVal, targetBench, container, badge);
            }
        })
        .catch(() => {
            if (todayOnly) {
                renderNoCasesListedTodayView(dateInputVal, targetBench, container, badge, partyName);
            } else {
                renderSavedCnrDateMatchTable(targetKey, dateInputVal, targetBench, container, badge);
            }
        });
}

