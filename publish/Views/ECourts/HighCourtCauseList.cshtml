function loadHcCourtBenches() {
    const estCode = document.getElementById('liveEstCode').value;
    const date = document.getElementById('liveDate').value;
    const benchSelect = document.getElementById('liveBenchId');

    benchSelect.innerHTML = '';
    
    const defaultOpt = document.createElement('option');
    defaultOpt.value = 'ALL';
    defaultOpt.textContent = 'All Benches / Court Halls';
    benchSelect.appendChild(defaultOpt);

    const queryEst = (estCode === "ALL") ? "KAHC01" : estCode;

    fetch(`/ECourts/GetHighCourtCauselistBenches?estCode=${encodeURIComponent(queryEst)}&causelistDate=${encodeURIComponent(date)}`)
        .then(r => r.json())
        .then(res => {
            const addedIds = new Set();
            addedIds.add('ALL');

            if (res && res.success && res.data) {
                let items = extractArrayFromData(res.data);
                if (items.length > 0) {
                    const group = document.createElement('optgroup');
                    group.label = 'Live Listed Benches (Today)';

                    items.forEach((b, idx) => {
                        const id = String(b.bench_id || b.bench_code || b.court_no || b.id || idx);
                        const name = b.bench_name || b.judge_name || b.court_name || b.name || `Court Hall ${id}`;
                        if (!addedIds.has(id)) {
                            addedIds.add(id);
                            const opt = document.createElement('option');
                            opt.value = id;
                            opt.textContent = `${name} (Bench #${id})`;
                            group.appendChild(opt);
                        }
                    });
                    if (group.children.length > 0) benchSelect.appendChild(group);
                }
            }

            const masterGroup = document.createElement('optgroup');
            masterGroup.label = 'High Court Court Halls & Benches';

            const standardBenches = [
                { id: '1', name: 'Court Hall 1 — Hon\'ble Chief Justice Bench' },
                { id: '2', name: 'Court Hall 2 — Division Bench I' },
                { id: '3', name: 'Court Hall 3 — Division Bench II' },
                { id: '4', name: 'Court Hall 4 — Single Bench' },
                { id: '5', name: 'Court Hall 5 — Single Bench' },
                { id: '6', name: 'Court Hall 6 — Single Bench' },
                { id: '7', name: 'Court Hall 7 — Single Bench' },
                { id: '8', name: 'Court Hall 8 — Single Bench' },
                { id: '9', name: 'Court Hall 9 — Single Bench' },
                { id: '10', name: 'Court Hall 10 — Single Bench' },
                { id: '11', name: 'Court Hall 11 — Single Bench' },
                { id: '12', name: 'Court Hall 12 — Single Bench' },
                { id: '13', name: 'Court Hall 13 — Single Bench' },
                { id: '14', name: 'Court Hall 14 — Single Bench' },
                { id: '15', name: 'Court Hall 15 — Single Bench' },
                { id: '16', name: 'Court Hall 16 — Single Bench' },
                { id: '17', name: 'Court Hall 17 — Single Bench' },
                { id: '18', name: 'Court Hall 18 — Single Bench' },
                { id: '19', name: 'Court Hall 19 — Single Bench' },
                { id: '20', name: 'Court Hall 20 — Single Bench' },
                { id: '21', name: 'Court Hall 21 — Single Bench' },
                { id: '22', name: 'Court Hall 22 — Single Bench' },
                { id: '23', name: 'Court Hall 23 — Single Bench' },
                { id: '24', name: 'Court Hall 24 — Single Bench' },
                { id: '25', name: 'Court Hall 25 — Single Bench' }
            ];

            standardBenches.forEach(sb => {
                if (!addedIds.has(sb.id)) {
                    addedIds.add(sb.id);
                    const opt = document.createElement('option');
                    opt.value = sb.id;
                    opt.textContent = sb.name;
                    masterGroup.appendChild(opt);
                }
            });
            benchSelect.appendChild(masterGroup);
        })
        .catch(() => {
            const masterGroup = document.createElement('optgroup');
            masterGroup.label = 'High Court Court Halls';
            for (let ch = 1; ch <= 25; ch++) {
                const opt = document.createElement('option');
                opt.value = String(ch);
                opt.textContent = `Court Hall ${ch}`;
                masterGroup.appendChild(opt);
            }
            benchSelect.appendChild(masterGroup);
        });
