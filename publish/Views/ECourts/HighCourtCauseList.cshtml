function syncSingleCnr(appealId, cnr, isBatch = false) {
    if (!cnr) return Promise.resolve({ success: false, cnr: '' });
    const btn = document.getElementById('sync_btn_' + appealId);
    let origText = '';
    if (btn) {
        origText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
    }

    return fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=true&appealId=${encodeURIComponent(appealId)}`)
        .then(r => r.json())
        .then(res => {
            if (res && res.success && res.data) {
                const d = res.data;

                // 1. Update Stage
                if (d.stage) {
                    const stageEl = document.getElementById('stage_' + appealId);
                    if (stageEl) {
                        stageEl.textContent = d.stage;
                        stageEl.title = d.stage;
                    }
                }

                // 2. Update Court Hall
                const courtHallVal = d.court_no_judge || d.court_no;
                if (courtHallVal) {
                    const chEl = document.getElementById('courthall_' + appealId);
                    if (chEl) {
                        chEl.className = "badge bg-warning-subtle text-dark border border-warning extra-small text-truncate";
                        chEl.style.maxWidth = "160px";
                        chEl.title = courtHallVal;
                        chEl.innerHTML = '<i class="bi bi-bank2 me-1"></i>' + courtHallVal;
                    }
                }

                // 3. Update Next Hearing Date & Status
                let nextDateDisplay = 'Date Pending';
                let isListedToday = false;
                let isUpcomingWeek = false;

                if (d.next_hearing_date && d.next_hearing_date !== 'Disposed' && d.next_hearing_date !== 'Pending') {
                    let parsedDt = null;
                    const parts = d.next_hearing_date.split('-');
                    if (parts.length === 3) {
                        if (parts[0].length === 4) {
                            // yyyy-MM-dd
                            parsedDt = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                            nextDateDisplay = `${parts[2]}-${parts[1]}-${parts[0]}`;
                        } else {
                            // dd-MM-yyyy
                            parsedDt = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                            nextDateDisplay = d.next_hearing_date;
                        }
                    } else {
                        parsedDt = new Date(d.next_hearing_date);
                        if (!isNaN(parsedDt.getTime())) {
                            nextDateDisplay = parsedDt.toLocaleDateString('en-GB').replace(/\//g, '-');
                        }
                    }

                    if (parsedDt && !isNaN(parsedDt.getTime())) {
                        const today = new Date();
                        today.setHours(0, 0, 0, 0);
                        const hearingDay = new Date(parsedDt.getTime());
                        hearingDay.setHours(0, 0, 0, 0);

                        const diffDays = Math.round((hearingDay - today) / (1000 * 60 * 60 * 24));
                        if (diffDays === 0) isListedToday = true;
                        else if (diffDays > 0 && diffDays <= 7) isUpcomingWeek = true;
                    }
                } else if (d.next_hearing_date === 'Disposed') {
                    nextDateDisplay = 'Disposed';
                }

                // Update DOM Hearing Date
                const dtEl = document.getElementById('hearing_dt_' + appealId);
                if (dtEl) {
                    if (nextDateDisplay !== 'Date Pending' && nextDateDisplay !== 'Disposed') {
                        dtEl.outerHTML = `<strong class="text-dark fs-6 d-block" id="hearing_dt_${appealId}"><i class="bi bi-calendar-event me-1 text-primary"></i>${nextDateDisplay}</strong>`;
                    } else if (nextDateDisplay === 'Disposed') {
                        dtEl.outerHTML = `<span class="badge bg-secondary" id="hearing_dt_${appealId}">Disposed</span>`;
                    } else {
                        dtEl.outerHTML = `<span class="text-muted fst-italic" id="hearing_dt_${appealId}">Date Pending</span>`;
                    }
                }

                // Update Status Badge
                const statusBadgeEl = document.getElementById('status_badge_' + appealId);
                const rowEl = document.getElementById('row_' + appealId);

                if (statusBadgeEl) {
                    if (isListedToday) {
                        statusBadgeEl.className = "badge bg-danger text-white animate-pulse p-2";
                        statusBadgeEl.textContent = "Listed Today";
                        if (rowEl) rowEl.classList.add("table-danger");
                    } else if (isUpcomingWeek) {
                        statusBadgeEl.className = "badge bg-warning text-dark p-2";
                        statusBadgeEl.textContent = "Upcoming This Week";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    } else if (nextDateDisplay === 'Disposed') {
                        statusBadgeEl.className = "badge bg-secondary text-white p-2";
                        statusBadgeEl.textContent = "Disposed";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    } else if (nextDateDisplay !== 'Date Pending') {
                        statusBadgeEl.className = "badge bg-info text-dark p-2";
                        statusBadgeEl.textContent = "Future Hearing";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    } else {
                        statusBadgeEl.className = "badge bg-secondary text-white p-2";
                        statusBadgeEl.textContent = "Pending";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    }
                }

                // Update KPI Counters
                recalculateKpis();

                if (!isBatch) {
                    showToast(`CNR Synced (${cnr})`, `Live data updated: ${nextDateDisplay} | ${d.stage || 'Hearing Active'}`, true);
                }
                return { success: true, cnr };
            } else {
                if (!isBatch) {
                    showToast(`Sync Failed (${cnr})`, res.message || 'No live records found on eCourts Gateway.', false);
                }
                return { success: false, cnr };
            }
        })
        .catch(err => {
            if (!isBatch) {
                showToast(`Sync Error (${cnr})`, 'Network error querying eCourts Gateway.', false);
            }
            return { success: false, cnr };
        })
        .finally(() => {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Synced';
                setTimeout(() => {
                    btn.innerHTML = origText || '<i class="bi bi-arrow-repeat"></i> Sync';
                }, 2500);
            }
        });
}

function recalculateKpis() {
    const rows = document.querySelectorAll('tr[id^="row_"]');
    let total = rows.length;
    let todayCount = 0;
    let weekCount = 0;
    let cnrCount = 0;

    rows.forEach(r => {
        const cnr = r.getAttribute('data-cnr');
        if (cnr && cnr.trim().length > 0) cnrCount++;

        const statusBadge = r.querySelector('[id^="status_badge_"]');
        if (statusBadge) {
            const txt = statusBadge.textContent.trim();
            if (txt === "Listed Today") todayCount++;
            else if (txt === "Upcoming This Week") weekCount++;
        }
    });

    const kpiTotalEl = document.getElementById('kpiTotal');
    const kpiTodayEl = document.getElementById('kpiToday');
    const kpiWeekEl = document.getElementById('kpiWeek');
    const kpiCnrEl = document.getElementById('kpiCnr');

    if (kpiTotalEl) kpiTotalEl.textContent = total;
    if (kpiTodayEl) kpiTodayEl.textContent = todayCount;
    if (kpiWeekEl) kpiWeekEl.textContent = weekCount;
    if (kpiCnrEl) kpiCnrEl.textContent = cnrCount;
}

async function syncAllVisibleCnrs() {
    const rows = document.querySelectorAll('tr[data-appeal-id][data-cnr]');
    const validRows = Array.from(rows).filter(r => (r.getAttribute('data-cnr') || '').trim().length > 0);
    const masterBtn = document.getElementById('btnSyncAll');
    
    if (validRows.length === 0) {
        showToast("CNR Sync", "No cases with CNR linked to sync.", false);
        return;
    }

    let originalHtml = '';
    if (masterBtn) {
        originalHtml = masterBtn.innerHTML;
        masterBtn.disabled = true;
    }

    let successCount = 0;
    let failCount = 0;
    const total = validRows.length;

    for (let i = 0; i < total; i++) {
        const row = validRows[i];
        const appealId = row.getAttribute('data-appeal-id');
        const cnr = row.getAttribute('data-cnr');

        if (masterBtn) {
            masterBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Syncing ${i + 1} of ${total}...`;
        }

        try {
            const res = await syncSingleCnr(appealId, cnr, true);
            if (res && res.success) {
                successCount++;
            } else {
                failCount++;
            }
        } catch (e) {
            failCount++;
        }

        // Slight interval between requests to be polite to the gateway
        if (i < total - 1) {
            await new Promise(r => setTimeout(r, 600));
        }
    }

    if (masterBtn) {
        masterBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Sync Complete';
        setTimeout(() => {
            masterBtn.innerHTML = originalHtml;
            masterBtn.disabled = false;
        }, 3000);
    }

    // ONLY 1 single toast notification at the end of the entire bulk sync
    if (failCount === 0) {
        showToast("Bulk Sync Completed", `All ${successCount} High Court cases synced successfully with live eCourts Gateway.`, true);
    } else {
        showToast("Bulk Sync Completed", `Synced ${successCount} of ${total} cases (${failCount} pending/offline).`, successCount > 0);
    }
}

function openDossierModal(appealId, cnr, mfaNo) {
    document.getElementById('modalMfaNo').textContent = mfaNo;
    document.getElementById('modalCnr').textContent = cnr;
    
    document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading hearing history from NAPIX...</td></tr>';
    document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm text-danger me-2"></div>Loading orders from NAPIX...</td></tr>';

    const modal = new bootstrap.Modal(document.getElementById('dossierModal'));
    modal.show();

    fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=true&appealId=${encodeURIComponent(appealId)}`)
        .then(r => r.json())
        .then(res => {
            if (res && res.success) {
                const history = res.history || [];
                const orders = res.orders || [];
                const d = res.data || {};

                document.getElementById('mCountHistory').textContent = history.length;
                document.getElementById('mCountOrders').textContent = orders.length;

                // Render History
                if (history.length === 0) {
                    document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No hearing history returned by e-Courts Gateway.</td></tr>';
                } else {
                    let hHtml = '';
                    history.forEach((item, idx) => {
                        const dt = item.business_date || item.hearing_date || item.date || item.next_date || '—';
                        const purpose = item.purpose_name || item.stage || item.next_purpose || '—';
                        const judge = item.judge || item.desgname || item.judge_name || '—';
                        const business = item.business || item.remarks || item.court_business || '—';
                        hHtml += `<tr>
                            <td class="text-muted fw-bold">${idx + 1}</td>
                            <td class="fw-bold text-dark font-monospace">${dt}</td>
                            <td><span class="badge bg-light text-primary border">${purpose}</span></td>
                            <td>${judge}</td>
                            <td class="fst-italic text-secondary">${business}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyHistory').innerHTML = hHtml;
                }

                // Render Orders
                if (orders.length === 0) {
                    document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No orders or judgments published for this case.</td></tr>';
                } else {
                    let oHtml = '';
                    orders.forEach((item, idx) => {
                        const dt = item.order_date || item.orderDate || item.date || '—';
                        const type = item.order_type || item.order_number || item.title || item.order_details || 'Order / Judgment';
                        const judge = item.judge || item.desgname || '—';
                        const pdfUrl = item.pdf_url || item.order_link || item.link || item.pdf || '';

                        let actionBtn = `<a href="/ECourts/ViewOrderPdf?cnr=${encodeURIComponent(cnr)}" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold"><i class="bi bi-file-pdf-fill me-1"></i> View Order PDF</a>`;
                        if (pdfUrl) {
                            let targetUrl = pdfUrl;
                            if (!pdfUrl.startsWith('/ECourts/ViewOrderPdf')) {
                                targetUrl = `/ECourts/ViewOrderPdf?url=${encodeURIComponent(pdfUrl)}&cnr=${encodeURIComponent(cnr)}`;
                            }
                            actionBtn = `<a href="${targetUrl}" target="_blank" class="btn btn-sm btn-danger py-0 px-2 text-white fw-bold shadow-sm"><i class="bi bi-file-pdf-fill me-1"></i> Open Order PDF</a>`;
                        }

                        oHtml += `<tr>
                            <td class="text-muted fw-bold">${idx + 1}</td>
                            <td class="fw-bold text-dark font-monospace">${dt}</td>
                            <td><strong>${type}</strong></td>
                            <td>${judge}</td>
                            <td>${actionBtn}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyOrders').innerHTML = oHtml;
                }

                // Render Details
                document.getElementById('mPetitioner').textContent = d.petitioner || '—';
                document.getElementById('mRespondent').textContent = d.respondent || '—';
                document.getElementById('mPetAdv').textContent = d.petitioner_advocate || d.pet_adv || '—';
                document.getElementById('mResAdv').textContent = d.respondent_advocate || d.res_adv || '—';
                document.getElementById('mFilingDate').textContent = d.filing_date || '—';
                document.getElementById('mRegDate').textContent = d.dt_regis || '—';
                document.getElementById('mDisposalDate').textContent = d.date_of_decision || '—';
            } else {
                document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Could not load eCourts history.</td></tr>';
                document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Could not load eCourts orders.</td></tr>';
            }
        })
        .catch(() => {
            document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Network error fetching dossier.</td></tr>';
            document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Network error fetching dossier.</td></tr>';
        });
}

// Auto-initialize on page load: load benches, populate date chips, and immediately fetch today's live cause list!
document.addEventListener('DOMContentLoaded', function () {
    populateScheduledDateChips();
    loadHcCourtBenches();
    fetchLiveHcCauselist();
});
</script>
