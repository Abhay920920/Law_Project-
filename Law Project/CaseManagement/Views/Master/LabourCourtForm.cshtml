@model MVCCaseManagement.Models.LabourCourt
@{
    ViewData["Title"] = Model.CourtID == 0 ? "Add Labour Court" : "Edit Labour Court";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container fade-in" style="max-width: 600px;">
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white py-3">
             <h5 class="mb-0 text-primary fw-bold">
                <i class="bi bi-bank me-2"></i>@(Model.CourtID == 0 ? "Add New Labour Court" : "Edit Labour Court")
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="@(Model.CourtID == 0 ? "LabourCourtCreate" : "LabourCourtEdit")" method="post">
                <input type="hidden" asp-for="CourtID" />
                
                <div class="mb-3">
                    <label asp-for="CourtName" class="form-label small fw-bold text-uppercase">Court Name</label>
                    <input asp-for="CourtName" class="form-control" placeholder="e.g. Labour Court - I" autofocus />
                    <span asp-validation-for="CourtName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Location" class="form-label small fw-bold text-uppercase">Location</label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. City Name" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a href="@Url.Action("LabourCourts", "Master")" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
