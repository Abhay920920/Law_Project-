@model MVCCaseManagement.Models.UserFormViewModel

@{
    bool isEdit = Model.UserID > 0;
    ViewData["Title"] = isEdit ? "Edit User" : "Add User";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@(isEdit ? "Edit User" : "Add New User")</h4>
                </div>
                <div class="card-body">
                    <form asp-action="@(isEdit ? "UserEdit" : "UserCreate")" method="post">
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="UserID" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label">Full Name</label>
                                <input asp-for="FullName" class="form-control" required />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Username" class="form-label">Username</label>
                                @if (isEdit)
                                {
                                    <input asp-for="Username" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="Username" class="form-control" required />
                                }
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password @(isEdit ? "(Leave blank to keep current)" : "")</label>
                            <input asp-for="Password" type="password" class="form-control" required="@(!isEdit)" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Mobile" class="form-label">Mobile</label>
                                <input asp-for="Mobile" class="form-control" />
                                <span asp-validation-for="Mobile" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RoleID" class="form-label">Role</label>
                                <select asp-for="RoleID" class="form-select" asp-items="@(new SelectList(ViewBag.Roles, "RoleID", "RoleName"))" required>
                                    <option value="">-- Select Role --</option>
                                </select>
                                <span asp-validation-for="RoleID" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DivisionID" class="form-label">Division</label>
                                <select asp-for="DivisionID" class="form-select" asp-items="@(new SelectList(ViewBag.Divisions, "DivisionID", "DivisionNameEnglish"))">
                                    <option value="">-- Select Division (Optional) --</option>
                                </select>
                                <small class="text-muted">Required for Division Users</small>
                                <span asp-validation-for="DivisionID" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">
                                Is Active
                            </label>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Users" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
