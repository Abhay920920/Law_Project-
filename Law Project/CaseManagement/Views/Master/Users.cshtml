@model IEnumerable<MVCCaseManagement.Models.User>

@{
    ViewData["Title"] = "User Master";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Masters</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Users</li>
                </ol>
            </nav>
            <h1>Users List</h1>
        </div>
        <a asp-action="UserCreate" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New User</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Full Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Division</th>
                            <th>Mobile</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.FullName</td>
                                <td>@item.Username</td>
                                <td>@item.RoleName</td>
                                <td>@(item.DivisionName ?? "-")</td>
                                <td>@item.Mobile</td>
                                <td>
                                    @if(item.IsActive) { <span class="badge bg-success">Active</span> }
                                    else { <span class="badge bg-danger">Inactive</span> }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="UserEdit" asp-route-id="@item.UserID" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="UserDelete" asp-route-id="@item.UserID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
