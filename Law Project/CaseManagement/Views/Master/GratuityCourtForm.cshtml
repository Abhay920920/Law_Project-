@model MVCCaseManagement.Models.GratuityCourt

@{
    bool isEdit = Model.CourtID > 0;
    ViewData["Title"] = isEdit ? "Edit Gratuity Court" : "Add Gratuity Court";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@(isEdit ? "Edit Gratuity Court" : "Add New Gratuity Court")</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="@(isEdit ? "GratuityCourtEdit" : "GratuityCourtCreate")" method="post">
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="CourtID" />
                        }

                        <div class="mb-3">
                            <label asp-for="CourtName" class="form-label fw-bold">Court Name</label>
                            <input asp-for="CourtName" class="form-control" required placeholder="e.g. ALC - Belagavi" />
                            <span asp-validation-for="CourtName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-bold">Location (Optional)</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Labour Dept Complex" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="GratuityCourts" class="btn btn-light border">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Save Court
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
