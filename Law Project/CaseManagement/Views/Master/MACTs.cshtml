@model IEnumerable<MVCCaseManagement.Models.MACT>

@{
    ViewData["Title"] = "MACT Courts Master";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Masters</a></li>
                    <li class="breadcrumb-item active" aria-current="page">MACT Courts</li>
                </ol>
            </nav>
            <h1>MACT Courts List</h1>
        </div>
        <a asp-action="MACTCreate" class="btn btn-success"><i class="bi bi-plus-lg"></i> Add New MACT</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Court Name</th>
                            <th>Location</th>
                            <th>Code</th> <!-- Added to see auto-generated code -->
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.MACTName</td>
                                <td>@item.Location</td>
                                <td><small class="text-muted">@item.MACTCode</small></td>
                                <td>
                                    @if(item.IsActive) { <span class="badge bg-success">Active</span> }
                                    else { <span class="badge bg-danger">Inactive</span> }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="MACTEdit" asp-route-id="@item.MACTID" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="MACTDelete" asp-route-id="@item.MACTID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this court?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
