@model MVCCaseManagement.Models.OtherCourtsCase
@{
    Layout = "~/Views/Shared/_OtherCourtsLayout.cshtml";
    string courtName = Model.CaseType switch {
        "PSC" => "P & SC (Probate & Succession)",
        "CC" => "Criminal Case (CC)",
        "Consumer" => "Consumer Dispute",
        "LAC" => "Land Acquisition Case",
        "OS" => (Model.LitigantType == "Corporation" ? "O.S (Corporation Filed)" : "O.S (Claimant Filed)"),
        "ECA" => "ECA Case",
        _ => Model.CaseType
    };
    ViewData["Title"] = $"{courtName} Details - {Model.CaseNumber}";
    ViewBag.ActiveCourt = Model.CaseType;
    ViewBag.LitigantType = Model.LitigantType;
}

<div class="container-fluid fade-in">
    <!-- Header Section -->
    <div class="glass-header shadow-sm mb-4 d-print-none">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.75rem;">@Model.CaseType</span>
                    <h4 class="fw-bold text-dark mb-0">
                        @(string.IsNullOrEmpty(Model.CaseNumber) ? "Case No. Not Filed" : $"{Model.CaseNumber} / {Model.CaseYear}")
                    </h4>
                </div>
                <p class="text-secondary small mb-0">
                    <strong>@courtName</strong> | @Model.Court | Registered: @Model.CreatedDate.ToString("dd-MM-yyyy")
                </p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                @{
                    var otherDivId = User.FindFirst("DivisionID")?.Value;
                    bool isOtherAICentral = otherDivId == "0" || otherDivId == "5";
                    bool isOtherAIRole = User.IsInRole("Dy CLO") || User.IsInRole("DyCLO") || User.IsInRole("CLO") || User.IsInRole("MD");
                }
                @if (isOtherAICentral && isOtherAIRole)
                {
                    <a href="/NyayaPatha?caseType=OtherCourts&caseId=@Model.CaseID" class="btn btn-outline-primary rounded-pill px-3 shadow-sm fw-semibold" title="Analyze with Nyaya Patha AI">
                        <i class="bi bi-robot me-1 text-primary"></i> Nyaya Patha AI
                    </a>
                }
                <a href="@Url.Action("OtherCourtsCaseEdit", "Home", new { id = Model.CaseID })" class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold">
                    <i class="bi bi-pencil-square me-1"></i> Edit Case
                </a>
                <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                    <i class="bi bi-printer me-1"></i> Print Dossier
                </button>
                <a href="@Url.Action("OtherCourtsCaseList", "Home", new { activeCourt = Model.CaseType, litigantType = Model.LitigantType })" class="btn btn-light rounded-pill px-3 shadow-sm border">
                    <i class="bi bi-arrow-left me-1"></i> Back to Registry
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Case Information & Parties -->
        <div class="col-lg-8">
            <!-- Basic Information Card -->
            <div class="glass-card shadow-sm mb-4 overflow-hidden">
                <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle text-primary me-2"></i>Basic Case Information
                    </h6>
                </div>
                <div class="p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted text-uppercase fw-bold small" style="font-size: 0.72rem;">Case Number &amp; Year</label>
                            <p class="fw-bold text-dark mb-0 fs-5">@(string.IsNullOrEmpty(Model.CaseNumber) ? "NOT FILED" : $"{Model.CaseNumber} / {Model.CaseYear}")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted text-uppercase fw-bold small" style="font-size: 0.72rem;">Court Name</label>
                            <p class="fw-bold text-dark mb-0 fs-5">@Model.Court</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted text-uppercase fw-bold small" style="font-size: 0.72rem;">Nature of Case</label>
                            <p class="text-dark mb-0 fw-semibold">@(string.IsNullOrEmpty(Model.CaseNature) ? "Standard Civil Suit" : Model.CaseNature)</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted text-uppercase fw-bold small" style="font-size: 0.72rem;">Current Stage</label>
                            <div>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-bold">
                                    @(string.IsNullOrEmpty(Model.CaseStage) ? "Trial Stage" : Model.CaseStage)
                                </span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ClaimDetails))
                        {
                            <div class="col-12">
                                <label class="text-muted text-uppercase fw-bold small" style="font-size: 0.72rem;">Claim Details / Relief Sought</label>
                                <div class="bg-light p-3 rounded-3 border text-dark">@Model.ClaimDetails</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Parties Involved Card -->
            <div class="glass-card shadow-sm mb-4 overflow-hidden">
                <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-people text-primary me-2"></i>Parties Involved
                    </h6>
                </div>
                <div class="p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <label class="small text-muted text-uppercase fw-bold d-block mb-2">Petitioner / Claimant</label>
                                @if (Model.Petitioners != null && Model.Petitioners.Any())
                                {
                                    @foreach (var pet in Model.Petitioners)
                                    {
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                                            <div>
                                                <div class="fw-bold small text-dark">@pet.Name</div>
                                                @if (!string.IsNullOrEmpty(pet.Remark)) { <div class="text-muted small">@pet.Remark</div> }
                                            </div>
                                        </div>
                                    }
                                }
                                else if (Model.LitigantType == "Claimant" && Model.Respondents != null && Model.Respondents.Any())
                                {
                                    @foreach (var pet in Model.Respondents)
                                    {
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                                            <div>
                                                <div class="fw-bold small text-dark">@pet.Name</div>
                                                @if (!string.IsNullOrEmpty(pet.Remark)) { <div class="text-muted small">@pet.Remark</div> }
                                            </div>
                                        </div>
                                    }
                                }
                                else if (Model.LitigantType == "Corporation")
                                {
                                    <div class="fw-bold text-dark fs-6">
                                        <i class="bi bi-building text-primary me-2"></i>
                                        @(Model.DivisionName ?? "North Western Karnataka Road Transport Corporation")
                                    </div>
                                    <div class="text-muted small mt-1">Corporation (Plaintiff / Petitioner)</div>
                                }
                                else
                                {
                                    <div class="fw-bold text-dark fs-6">@(string.IsNullOrEmpty(Model.PetitionerName) ? "Claimant" : Model.PetitionerName)</div>
                                    @if (!string.IsNullOrEmpty(Model.PetitionerRelationship))
                                    {
                                        <small class="text-muted d-block">Relationship: @Model.PetitionerRelationship</small>
                                    }
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <label class="small text-muted text-uppercase fw-bold d-block mb-2">Respondent / Defendant</label>
                                @if (Model.LitigantType == "Corporation")
                                {
                                    @if (Model.Respondents != null && Model.Respondents.Any())
                                    {
                                        @foreach (var resp in Model.Respondents)
                                        {
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="bi bi-person-circle text-secondary me-2 fs-5"></i>
                                                <div>
                                                    <div class="fw-bold small text-dark">@resp.Name</div>
                                                    @if (!string.IsNullOrEmpty(resp.Remark)) { <div class="text-muted small">@resp.Remark</div> }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark fs-6">@(string.IsNullOrEmpty(Model.RespondentName) ? "Opposite Party" : Model.RespondentName)</div>
                                    }
                                }
                                else
                                {
                                    <div class="fw-bold text-dark fs-6">
                                        <i class="bi bi-building text-secondary me-2"></i>
                                        @(Model.DivisionName ?? "North Western Karnataka Road Transport Corporation")
                                    </div>
                                    <div class="text-muted small mt-1">Respondent: <strong>Corporation (NWKRTC)</strong></div>
                                    @if (!string.IsNullOrEmpty(Model.RespondentName) && Model.RespondentName != "NWKRTC / Corporation")
                                    {
                                        <div class="text-dark small mt-2 border-top pt-2">
                                            <span class="text-muted">Named / Co-Respondent:</span> @Model.RespondentName
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Incident & Vehicle Details (if applicable) -->
            @if (Model.CaseType == "ECA" || Model.IsVehicleInvolved == "yes" || Model.DateOfAccident.HasValue || Model.ClaimAmount.HasValue)
            {
                <div class="glass-card shadow-sm mb-4 overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-truck text-warning me-2"></i>Incident &amp; Vehicle Details
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Vehicle Involved?</label>
                                <span class="badge @(Model.IsVehicleInvolved == "yes" ? "bg-primary" : "bg-secondary") rounded-pill px-3 py-1">
                                    @(Model.IsVehicleInvolved?.ToUpper() ?? "NO")
                                </span>
                            </div>
                            @if (Model.IsVehicleInvolved == "yes")
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Vehicle Number</label>
                                    <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.VehicleNumber) ? "-" : Model.VehicleNumber)</span>
                                </div>
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Vehicle Type</label>
                                    <span class="text-dark">@(string.IsNullOrEmpty(Model.VehicleType) ? "-" : Model.VehicleType)</span>
                                </div>
                            }
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Date of Incident</label>
                                <span class="fw-bold text-dark">@(Model.DateOfAccident?.ToString("dd-MM-yyyy") ?? "-")</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Claim Amount</label>
                                <span class="fw-bold text-success fs-6">@(Model.ClaimAmount.HasValue ? $"₹ {Model.ClaimAmount.Value:N2}" : "-")</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Corp Employee?</label>
                                <span class="badge @(Model.IsCorporationEmployee == "Yes" ? "bg-info text-dark" : "bg-light text-dark border") rounded-pill px-3 py-1">
                                    @(Model.IsCorporationEmployee ?? "No")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.MannerOfIncident))
                            {
                                <div class="col-12">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Manner of Incident</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark small">@Model.MannerOfIncident</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Evidence Details (if recorded) -->
            @if ((Model.RespondentEvidence != null && Model.RespondentEvidence.Any()) || (Model.CorpEvidence != null && Model.CorpEvidence.Any()) || Model.IsObjectionFiled == "Yes" || !string.IsNullOrEmpty(Model.ObjectionRemarks))
            {
                <div class="glass-card shadow-sm mb-4 overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-journal-check text-info me-2"></i>Evidence &amp; Objections
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-4">
                            @if (Model.RespondentEvidence != null && Model.RespondentEvidence.Any())
                            {
                                <div class="col-md-6">
                                    <label class="small text-muted text-uppercase fw-bold d-block mb-2">Opposite Party Evidence</label>
                                    <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                                        @foreach (var ev in Model.RespondentEvidence)
                                        {
                                            <div class="list-group-item bg-light p-2 px-3 d-flex justify-content-between align-items-center">
                                                <span class="fw-bold small text-dark">@ev.Name</span>
                                                <span class="text-muted small">@(string.IsNullOrEmpty(ev.Remark) ? "-" : ev.Remark)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Model.CorpEvidence != null && Model.CorpEvidence.Any())
                            {
                                <div class="col-md-6">
                                    <label class="small text-muted text-uppercase fw-bold d-block mb-2">Corporation Witnesses / Evidence</label>
                                    <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                                        @foreach (var ev in Model.CorpEvidence)
                                        {
                                            <div class="list-group-item bg-light p-2 px-3 d-flex justify-content-between align-items-center">
                                                <span class="fw-bold small text-dark">@ev.Name</span>
                                                <span class="badge bg-secondary-subtle text-dark border small">@(string.IsNullOrEmpty(ev.Designation) ? "-" : ev.Designation)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ObjectionRemarks))
                            {
                                <div class="col-12">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Objection / Written Statement Remarks</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark small">@Model.ObjectionRemarks</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Certified Copy Tracking (if recorded) -->
            @if (Model.CopyAppliedOn.HasValue || Model.CopyReadyOn.HasValue || Model.CopyDeliveredOn.HasValue || Model.CopyReceivedAtDivision.HasValue || !string.IsNullOrEmpty(Model.CertifiedCopyRemarks))
            {
                <div class="glass-card shadow-sm mb-4 overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-file-earmark-check text-success me-2"></i>Certified Copy (CC) Details
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="small text-muted text-uppercase fw-bold d-block">Applied On</label>
                                <span class="fw-bold text-dark">@(Model.CopyAppliedOn?.ToString("dd-MM-yyyy") ?? "-")</span>
                            </div>
                            <div class="col-md-3">
                                <label class="small text-muted text-uppercase fw-bold d-block">Ready On</label>
                                <span class="fw-bold text-dark">@(Model.CopyReadyOn?.ToString("dd-MM-yyyy") ?? "-")</span>
                            </div>
                            <div class="col-md-3">
                                <label class="small text-muted text-uppercase fw-bold d-block">Delivered On</label>
                                <span class="fw-bold text-dark">@(Model.CopyDeliveredOn?.ToString("dd-MM-yyyy") ?? "-")</span>
                            </div>
                            <div class="col-md-3">
                                <label class="small text-muted text-uppercase fw-bold d-block">Received at Division</label>
                                <span class="fw-bold text-dark">@(Model.CopyReceivedAtDivision?.ToString("dd-MM-yyyy") ?? "-")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.CertifiedCopyRemarks))
                            {
                                <div class="col-12">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Certified Copy Remarks</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark small">@Model.CertifiedCopyRemarks</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Opinions & Decision Section (if recorded) -->
            @if (!string.IsNullOrEmpty(Model.AdvocateOpinion) || !string.IsNullOrEmpty(Model.LawOfficerOpinion) || !string.IsNullOrEmpty(Model.DCFinalDecision) || !string.IsNullOrEmpty(Model.FinalForwardingStatus))
            {
                <div class="glass-card shadow-sm mb-4 overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-chat-left-text text-secondary me-2"></i>Legal Opinions &amp; Decisions
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(Model.AdvocateOpinion))
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Advocate's Opinion</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark small">@Model.AdvocateOpinion</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.LawOfficerOpinion))
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Law Officer's Opinion</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark small">@Model.LawOfficerOpinion</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.DCFinalDecision))
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">DC's Final Decision</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark small">@Model.DCFinalDecision</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.FinalForwardingStatus))
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Forwarding Status</label>
                                    <span class="badge bg-secondary rounded-pill px-3 py-1">@Model.FinalForwardingStatus</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.OutwardNumber))
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">CO Outward No &amp; Date</label>
                                    <span class="fw-bold text-dark">@Model.OutwardNumber (@(Model.OutwardDate?.ToString("dd-MM-yyyy") ?? "-"))</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Appeal Details (if recorded) -->
            @if (!string.IsNullOrEmpty(Model.AppealNumber) || Model.AppealComplianceAmount.HasValue || !string.IsNullOrEmpty(Model.AppealJudgmentCopyPath))
            {
                <div class="glass-card shadow-sm mb-4 border-start border-4 border-primary overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-primary bg-opacity-10">
                        <h6 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Appeal Details
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Appeal Number &amp; Year</label>
                                <span class="fw-bold text-dark fs-6">@Model.AppealNumber / @Model.AppealYear</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Appellate Court</label>
                                <span class="text-dark">@(string.IsNullOrEmpty(Model.CourtAppellateAuth) ? "-" : Model.CourtAppellateAuth)</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Appeal Advocate</label>
                                <span class="text-dark">@(string.IsNullOrEmpty(Model.AppealAdvocateName) ? "-" : Model.AppealAdvocateName)</span>
                            </div>
                            @if (Model.AppealComplianceAmount.HasValue)
                            {
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Compliance Amount</label>
                                    <span class="fw-bold text-success">₹ @Model.AppealComplianceAmount.Value.ToString("N2")</span>
                                </div>
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Cheque No &amp; Date</label>
                                    <span class="text-dark">@(Model.AppealChequeNumber ?? "-") (@(Model.AppealChequeDate?.ToString("dd-MM-yyyy") ?? "-"))</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.AppealJudgmentCopyPath))
                            {
                                <div class="col-12 mt-2">
                                    <a href="@Model.AppealJudgmentCopyPath" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                        <i class="bi bi-file-earmark-pdf-fill me-2"></i>View Appeal Judgment Copy
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Enclosed Documents (if recorded) -->
            @if (Model.EnclosedDocuments != null && Model.EnclosedDocuments.Any())
            {
                <div class="glass-card shadow-sm mb-4 overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-paperclip text-dark me-2"></i>Enclosed Case Documents
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Document Name</th>
                                        <th class="text-end">Pages</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.EnclosedDocuments)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark small"><i class="bi bi-file-earmark-text text-secondary me-2"></i>@doc.DocName</td>
                                            <td class="text-end text-muted small">@(doc.PageCount.HasValue ? doc.PageCount.ToString() : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Disposal & Final Outcome (if closed) -->
            @if (Model.DisposalStatus == "DISPOSED" || Model.DisposalStatus == "DNP" || Model.DisposalStatus == "Decreed" || Model.ClosureDate.HasValue)
            {
                <div class="glass-card shadow-sm mb-4 border-start border-4 border-success overflow-hidden">
                    <div class="p-3 px-4 border-bottom bg-success bg-opacity-10">
                        <h6 class="fw-bold mb-0 text-success">
                            <i class="bi bi-check-circle-fill me-2"></i>Disposal &amp; Final Outcome
                        </h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Disposal Status</label>
                                <span class="badge bg-success px-3 py-1 rounded-pill">@(Model.DisposalStatus ?? "DISPOSED")</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Judicial Result</label>
                                <span class="badge @(Model.Result == "FAVOR" ? "bg-success" : "bg-danger") px-3 py-1 rounded-pill">@(Model.Result ?? "DISPOSED")</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted text-uppercase fw-bold d-block">Closure Date</label>
                                <p class="fw-bold text-dark mb-0">@(Model.ClosureDate?.ToString("dd-MM-yyyy") ?? "-")</p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ClosureRemark))
                            {
                                <div class="col-12">
                                    <label class="small text-muted text-uppercase fw-bold d-block">Award Summary / Remarks</label>
                                    <div class="bg-light p-3 rounded-3 border text-dark">@Model.ClosureRemark</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.FinalJudgmentFilePath))
                            {
                                <div class="col-12">
                                    <a href="@Model.FinalJudgmentFilePath" target="_blank" class="btn btn-outline-success btn-sm rounded-pill px-4">
                                        <i class="bi bi-file-earmark-pdf-fill me-2"></i>View Final Judgment Order
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Status Card, Counsel & Progress -->
        <div class="col-lg-4">
            <!-- Status Card -->
            <div class="glass-card shadow-sm mb-4 overflow-hidden">
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important;">
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-2">@Model.CaseType</span>
                    <div class="display-6 fw-bold mb-0">@(string.IsNullOrEmpty(Model.CaseStatus) ? "Active" : Model.CaseStatus)</div>
                    <p class="mb-0 text-white-50 small mt-1">Current File Status</p>
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted small">Next Hearing</span>
                        <span class="fw-bold @(Model.NextDateOfHearing == DateTime.Today ? "text-danger" : "text-dark")">
                            @(Model.NextDateOfHearing?.ToString("dd MMM yyyy") ?? "Not Scheduled")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted small">Advocate</span>
                        <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.AdvocateName) ? "Not Assigned" : Model.AdvocateName)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted small">Entrustment No.</span>
                        <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.EntrustmentNumber) ? "-" : Model.EntrustmentNumber)</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Entrustment Date</span>
                        <span class="fw-bold text-dark">@(Model.EntrustmentDate?.ToString("dd-MM-yyyy") ?? "-")</span>
                    </div>
                </div>
            </div>

            <!-- Procedural Milestones Card -->
            <div class="glass-card shadow-sm mb-4 overflow-hidden">
                <div class="p-3 px-4 border-bottom bg-light bg-opacity-50">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-check2-square text-primary me-2"></i>Procedural Milestones
                    </h6>
                </div>
                <div class="p-4">
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                            <span>Document / Records Sent</span>
                            <span class="badge @(Model.DocumentSent == "Yes" ? "bg-success" : "bg-light text-dark border") rounded-pill">@(Model.DocumentSent ?? "No")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                            <span>Written Statement / Objection</span>
                            <span class="badge @(Model.ObjectionVerified == "Yes" ? "bg-success" : "bg-light text-dark border") rounded-pill">@(Model.ObjectionVerified ?? "No")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                            <span>Evidence / Proof Filed</span>
                            <span class="badge @(Model.EvidenceFiled == "Yes" ? "bg-success" : "bg-light text-dark border") rounded-pill">@(Model.EvidenceFiled ?? "No")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                            <span>Interim Order Granted</span>
                            <span class="badge @(Model.InterimOrder == "Yes" ? "bg-info text-dark" : "bg-light text-dark border") rounded-pill">@(Model.InterimOrder ?? "No")</span>
                        </li>
                    </ul>
                    @if (!string.IsNullOrEmpty(Model.InterimOrderFilePath))
                    {
                        <a href="@Model.InterimOrderFilePath" target="_blank" class="btn btn-outline-primary btn-sm w-100 rounded-pill mt-3 shadow-sm">
                            <i class="bi bi-file-earmark-text-fill me-2"></i>View Interim Order Copy
                        </a>
                    }
                </div>
            </div>

            <!-- e-Courts Live Gateway Integration Card -->
            <div class="glass-card shadow-sm mb-4 border-start border-4 border-primary overflow-hidden">
                <div class="p-3 px-4 border-bottom bg-light bg-opacity-75 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-bank2 text-primary me-2"></i>e-Courts Live Gateway
                    </h6>
                    @if (Model.LastNapixSyncAt.HasValue)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill xsmall">
                            <i class="bi bi-check-circle-fill me-1"></i>Synced
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill xsmall">
                            Unsynced
                        </span>
                    }
                </div>
                <div class="p-4">
                    <div class="mb-3">
                        <label class="text-muted text-uppercase fw-bold small" style="font-size: 0.72rem;">16-Digit CNR Number</label>
                        @if (!string.IsNullOrWhiteSpace(Model.CNRNumber))
                        {
                            <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded border">
                                <span class="fw-bold font-monospace text-primary fs-6">@Model.CNRNumber</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary border-0 py-0" title="Copy CNR" onclick="navigator.clipboard.writeText('@Model.CNRNumber'); alert('CNR copied to clipboard');">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic bg-light p-2 rounded border">No CNR linked yet</div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CNRNumber))
                    {
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-muted small">eCourts Status</span>
                            <span class="fw-bold @(Model.PendDispStatus == "D" ? "text-success" : "text-primary") small">
                                @(Model.PendDispStatus == "D" ? "Disposed" : (Model.PendDispStatus == "P" ? "Pending" : (Model.LastNapixSyncStatus ?? "Active")))
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-muted small">eCourts Stage</span>
                            <span class="fw-semibold text-dark small text-end" style="max-width: 180px;">
                                @(string.IsNullOrEmpty(Model.ECourtsStage) ? "-" : Model.ECourtsStage)
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-muted small">Court / Hall No</span>
                            <span class="fw-semibold text-dark small text-end">
                                @(string.IsNullOrEmpty(Model.ECourtsCourtNo) ? "-" : Model.ECourtsCourtNo)
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-muted small">Presiding Judge</span>
                            <span class="fw-semibold text-dark small text-end text-truncate" style="max-width: 180px;" title="@Model.ECourtsJudge">
                                @(string.IsNullOrEmpty(Model.ECourtsJudge) ? "-" : Model.ECourtsJudge)
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
                            <span class="text-muted small">Last Sync Time</span>
                            <span class="text-muted small">
                                @(Model.LastNapixSyncAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never")
                            </span>
                        </div>

                        <div id="syncStatusMsg" class="mb-2 small"></div>

                        <button type="button" id="btnSyncECourts" class="btn btn-primary w-100 rounded-pill shadow-sm fw-bold"
                                data-caseid="@Model.CaseID" data-cnr="@Model.CNRNumber">
                            <i class="bi bi-arrow-repeat me-1"></i> Sync Live with e-Courts
                        </button>
                    }
                    else
                    {
                        <a href="@Url.Action("OtherCourtsCaseEdit", "Home", new { id = Model.CaseID })" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                            <i class="bi bi-pencil me-1"></i> Link CNR Number in Edit Case
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .d-print-none { display: none !important; }
        .glass-card { border: 1px solid #ccc !important; box-shadow: none !important; }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#btnSyncECourts').on('click', function(e) {
                e.preventDefault();
                var $btn = $(this);
                var caseId = $btn.data('caseid');
                var cnr = $btn.data('cnr');
                var $msg = $('#syncStatusMsg');

                if (!cnr) return;

                var origHtml = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Queueing Sync...');
                $msg.html('<span class="text-info"><i class="bi bi-hourglass-split me-1"></i> Requesting e-Courts gateway...</span>');

                var formData = new FormData();
                formData.append('caseId', caseId);
                formData.append('cnrNumber', cnr);
                formData.append('module', 'OtherCourts');

                fetch('/ECourts/QueueCaseSync', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) {
                        $msg.html('<span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (data.message || 'Failed') + '</span>');
                        $btn.prop('disabled', false).html(origHtml);
                        return;
                    }

                    $msg.html('<span class="text-primary"><span class="spinner-border spinner-border-sm me-1"></span> Sync in progress...</span>');

                    var queueId = data.queueId;
                    var pollCount = 0;
                    var timer = setInterval(function() {
                        pollCount++;
                        if (pollCount > 30) {
                            clearInterval(timer);
                            $msg.html('<span class="text-warning"><i class="bi bi-clock-history me-1"></i> Sync taking longer than usual. Please refresh later.</span>');
                            $btn.prop('disabled', false).html(origHtml);
                            return;
                        }

                        fetch('/ECourts/GetQueueStatus?queueId=' + queueId + '&caseId=' + caseId + '&module=OtherCourts')
                        .then(res => res.json())
                        .then(statusData => {
                            if (statusData.status === 'Success') {
                                clearInterval(timer);
                                $msg.html('<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Sync Completed Successfully!</span>');
                                $btn.html('<i class="bi bi-check-circle-fill text-success"></i> Synced');
                                setTimeout(function() { location.reload(); }, 800);
                            } else if (statusData.status === 'Failed') {
                                clearInterval(timer);
                                $msg.html('<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Failed: ' + (statusData.error || 'eCourts returned error') + '</span>');
                                $btn.prop('disabled', false).html(origHtml);
                            }
                        })
                        .catch(() => {
                            clearInterval(timer);
                            $btn.prop('disabled', false).html(origHtml);
                        });
                    }, 1200);
                })
                .catch(err => {
                    $msg.html('<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> Network error: ' + err + '</span>');
                    $btn.prop('disabled', false).html(origHtml);
                });
            });
        });
    </script>
}
