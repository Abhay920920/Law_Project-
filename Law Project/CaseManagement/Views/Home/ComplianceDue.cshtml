@model IEnumerable<MVCCaseManagement.Models.GlobalCaseViewModel>

@{
    ViewData["Title"] = "Compliance Due";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-warning mb-0"><i class="bi bi-shield-check me-2"></i>Compliance Due</h2>
            <small class="text-muted">List of all cases across all modules with compliance dates in the next 7 days.</small>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <form method="get" class="d-flex align-items-center">
                <label class="me-2 text-muted small fw-bold text-uppercase">Filter Module:</label>
                <select name="module" class="form-select rounded-pill shadow-sm border-0 px-4" style="min-width: 180px; height: 42px;" onchange="this.form.submit()">
                    <option value="All" selected="@(ViewBag.SelectedModule == "All")">All Modules</option>
                    <option value="MVC" selected="@(ViewBag.SelectedModule == "MVC")">MVC</option>
                    <option value="Labour" selected="@(ViewBag.SelectedModule == "Labour")">Labour</option>
                    <option value="Gratuity" selected="@(ViewBag.SelectedModule == "Gratuity")">Gratuity</option>
                </select>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm px-4" style="height: 42px; display: flex; align-items: center;">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Module</th>
                            <th>Case Number</th>
                            <th>Court / Bench</th>
                            <th>Status / Stage</th>
                            <th>e-Courts CNR</th>
                            <th>Compliance Deadline</th>
                            <th>Urgency</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var isOverdue = item.DaysOverdue < 0; // Negative means deadline is in the past
                                var daysRemaining = Math.Abs(item.DaysOverdue);

                                <tr>
                                    <td class="ps-4">
                                        @if (item.ModuleName == "MVC")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-truck-front-fill me-1"></i>MVC</span>
                                        }
                                        else if (item.ModuleName == "Labour")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-people-fill me-1"></i>Labour</span>
                                        }
                                        else if (item.ModuleName == "Labour Service")
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-bank me-1"></i>High Court</span>
                                        }
                                        else if (item.ModuleName == "Gratuity")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-cash-coin me-1"></i>Gratuity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark bg-opacity-10 text-dark border rounded-pill px-3 py-1">@item.ModuleName</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.CaseNo</div>
                                    </td>
                                    <td>
                                        <div class="text-dark small">@item.CourtOrAuthority</div>
                                        @if (!string.IsNullOrEmpty(item.CourtHall))
                                        {
                                            <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@item.CourtHall</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 small">
                                            @(string.IsNullOrEmpty(item.Stage) ? (item.DisposalResult ?? "Stay / Compliance") : item.Stage)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CNRNumber))
                                        {
                                            <code class="text-primary small fw-bold">@item.CNRNumber</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Not Linked</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.NextHearingDate.HasValue)
                                        {
                                            <span class="fw-bold @(isOverdue ? "text-danger" : "text-dark")">
                                                <i class="bi bi-calendar-event me-1"></i>@item.NextHearingDate.Value.ToString("dd-MM-yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Immediate</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2 py-1">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Overdue by @daysRemaining d
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 px-2 py-1">
                                                Due in @daysRemaining d
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@item.DetailsUrl" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                            View Details <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-50 text-success"></i>
                                        <h5>No Compliance Due</h5>
                                        <p>There are no court compliances due or overdue across all modules.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
