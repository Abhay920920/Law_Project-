@model MVCCaseManagement.Models.HighCourtCauseListViewModel

@{

    ViewData["Title"] = $"High Court Cause List — {OrgService.GetCurrentSettings().OrganizationShortName} Matters Listed Today";

    ViewData["HidePageHeader"] = true;

}



<style>

    .hc-causelist-page {

        width: 100%;

        max-width: 100%;

        box-sizing: border-box;

    }

/* Modal stabilization: prevent background table distortion and layout shift */
    body.modal-open {
        padding-right: 0 !important;
    }

    body.modal-open .branding-header {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100% !important;
        z-index: 1030 !important;
    }

    body.modal-open .sidebar {
        position: fixed !important;
        top: 66px !important;
        left: 0 !important;
        bottom: 0 !important;
        width: 280px !important;
        height: calc(100vh - 66px) !important;
        z-index: 1030 !important;
        overflow-y: auto !important;
    }

    #dossierModal.modal,
    #roznamaModal.modal {
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(2px);
    }

    #dossierModal .modal-dialog,
    #roznamaModal .modal-dialog {
        transition: transform 0.25s ease-out;
        margin: 1.75rem auto;
    }

    #dossierModal .modal-content,
    #roznamaModal .modal-content {
        border-radius: 16px;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
        border: none;
        overflow: hidden;
    }

    #dossierModal .table th {
        font-weight: 700;
        font-size: 11.5px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        background-color: #f8fafc;
    }

    #dossierModal .table td {
        vertical-align: middle;
        padding: 9px 12px;
    }

    #dossierModal #mTbodyHistory tr td:nth-child(2),
    #dossierModal #mTbodyOrders tr td:nth-child(2) {
        white-space: nowrap !important;
    }

    .hc-header-gradient {

        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);

        color: #fff;

        border-radius: 12px;

    }

    .kpi-card {

        border-radius: 12px;

        transition: transform 0.2s ease, box-shadow 0.2s ease;

        border: 1px solid #e2e8f0;

    }

    .kpi-card:hover {

        transform: translateY(-2px);

        box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;

    }

    .corp-match-row {

        background-color: #ecfdf5 !important;

        border-left: 4px solid #10b981 !important;

    }

    .animate-pulse {

        animation: pulse 2s infinite;

    }

    @@keyframes pulse {

        0% { opacity: 1; }

        50% { opacity: 0.6; }

        100% { opacity: 1; }

    }

    .hc-toast-container {

        position: fixed;

        bottom: 24px;

        right: 24px;

        z-index: 1080;

        max-width: 380px;

    }



    /* Mobile First Enhancements */

    .mobile-presets-scroll {

        scrollbar-width: none;

    }

    .mobile-presets-scroll::-webkit-scrollbar {

        display: none;

    }



    .causelist-mobile-card {

        border-radius: 10px;

        transition: transform 0.15s ease, box-shadow 0.15s ease;

        border: 1px solid #e2e8f0;

    }

    .corp-match-card {

        background-color: #f0fdf4 !important;

        border: 1.5px solid #86efac !important;

        border-left: 5px solid #10b981 !important;

    }



    @@media (max-width: 767.98px) {

        .hc-header-gradient {

            padding: 1.15rem !important;

            border-radius: 0.75rem !important;

        }

        .hc-header-gradient h3 {

            font-size: 1.15rem !important;

            line-height: 1.35;

        }

        .hc-header-actions {

            width: 100%;

            display: flex;

            gap: 8px;

        }

        .hc-header-actions .btn {

            flex: 1;

            padding: 8px 12px !important;

            font-size: 0.82rem !important;

            display: flex;

            align-items: center;

            justify-content: center;

        }

        .kpi-row {

            margin-bottom: 0.75rem !important;

        }

        .kpi-card {

            border-radius: 0.75rem !important;

        }

        .kpi-card .card-body {

            padding: 0.6rem 0.75rem !important;

        }

        .kpi-label {

            font-size: 0.66rem !important;

            line-height: 1.15;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;

        }

        .kpi-num {

            font-size: 1.3rem !important;

            margin-top: 2px !important;

        }

    .mobile-presets-scroll {

            display: flex !important;

            flex-wrap: nowrap !important;

            overflow-x: auto !important;

            -webkit-overflow-scrolling: touch;

            padding-bottom: 4px;

        }

        .mobile-presets-scroll .btn {

            flex-shrink: 0;

            white-space: nowrap;

            padding: 4px 10px !important;

            font-size: 0.75rem !important;

        }

        .dossier-nav-tabs {

            display: flex !important;

            flex-wrap: nowrap !important;

            overflow-x: auto !important;

            -webkit-overflow-scrolling: touch;

        }

        .dossier-nav-tabs .nav-item {

            flex-shrink: 0;

        }

        .dossier-nav-tabs .nav-link {

            white-space: nowrap;

            padding: 7px 12px !important;

            font-size: 0.8rem !important;

        }

        .hc-toast-container {

            left: 12px;

            right: 12px;

            bottom: 12px;

            max-width: calc(100% - 24px);

        }

    }



    @@media (max-width: 575.98px) {

        .kpi-card .card-body {

            padding: 0.5rem 0.6rem !important;

        }

        .kpi-label {

            font-size: 0.62rem !important;

        }

        .kpi-num {

            font-size: 1.2rem !important;

        }

    }

</style>



<div class="hc-causelist-page">

    <!-- Header Banner -->

    <div class="hc-header-gradient p-3 p-md-4 mb-3 mb-md-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-3">

        <div>

            <div class="d-flex flex-wrap align-items-center gap-1.5 mb-2">

                <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1 extra-small"><i class="bi bi-shield-check me-1"></i>CENTRAL OFFICE</span>

                <span class="badge bg-danger text-white font-monospace fw-bold px-2 py-1 extra-small"><i class="bi bi-broadcast me-1"></i>LIVE E-COURTS GATEWAY</span>

                <span class="badge bg-danger-subtle text-danger border border-danger font-monospace fw-bold px-2 py-1 extra-small d-none d-sm-inline-block"><i class="bi bi-calendar-check me-1"></i>TODAY'S LISTINGS ONLY</span>

            </div>

            <h3 class="fw-bold mb-1 text-white">

                <i class="bi bi-calendar-event-fill me-2 text-warning"></i>High Court Cause List — @OrgService.GetCurrentSettings().OrganizationShortName Matters Listed Today

            </h3>

            <p class="text-light text-opacity-75 small mb-0">Official daily cause list for @OrgService.GetCurrentSettings().OrganizationShortName across Karnataka High Court benches (Dharwad, Bengaluru, Kalaburagi).</p>

        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 hc-header-actions">

            <button class="btn btn-warning btn-sm fw-bold shadow-sm px-3 py-2" type="button" id="btnSyncAll" onclick="syncAllVisibleCnrs()">

                <i class="bi bi-arrow-repeat me-1"></i> Sync All Visible CNRs

            </button>

            <a href="/ECourts/HighCourtCauseList" class="btn btn-outline-light btn-sm px-3 py-2" title="Reload Listings">

                <i class="bi bi-arrow-clockwise me-1"></i> Refresh

            </a>

        </div>

    </div>



    <!-- KPI Summary Cards: Strictly NWKRTC Listed Today -->

    <div class="row row-cols-2 row-cols-md-4 g-2 g-md-3 mb-3 mb-md-4 kpi-row">

        <div class="col">

            <div class="card border-0 shadow-sm border-start border-4 border-danger bg-white kpi-card h-100">

                <div class="card-body p-2 p-md-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="w-100">

                            <span class="text-muted extra-small text-uppercase fw-bold kpi-label">Listed on Date</span>

                            <h2 class="fw-bold text-danger mb-0 mt-1 kpi-num" id="kpiListedTodayVal">@Model.NwkrtcListedTodayCount</h2>

                        </div>

                        <div class="bg-danger-subtle p-2 p-md-3 rounded-3 text-danger d-none d-sm-block flex-shrink-0 ms-2">

                            <i class="bi bi-bell-fill fs-4 fs-md-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <div class="col">

            <div class="card border-0 shadow-sm border-start border-4 border-info bg-white kpi-card h-100">

                <div class="card-body p-2 p-md-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="w-100">

                            <span class="text-muted extra-small text-uppercase fw-bold kpi-label">Total NWKRTC Loaded</span>

                            <h2 class="fw-bold text-info mb-0 mt-1 kpi-num" id="kpiTotalNwkrtcVal">@Model.NwkrtcTotalCount</h2>

                        </div>

                        <div class="bg-info-subtle p-2 p-md-3 rounded-3 text-info d-none d-sm-block flex-shrink-0 ms-2">

                            <i class="bi bi-collection-fill fs-4 fs-md-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <div class="col">

            <div class="card border-0 shadow-sm border-start border-4 border-primary bg-white kpi-card h-100">

                <div class="card-body p-2 p-md-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="w-100">

                            <span class="text-muted extra-small text-uppercase fw-bold kpi-label">With @OrgService.GetCurrentSettings().OrganizationShortName</span>

                            <h2 class="fw-bold text-primary mb-0 mt-1 kpi-num" id="kpiWithNwkrtcVal">@Model.NwkrtcWithCount</h2>

                        </div>

                        <div class="bg-primary-subtle p-2 p-md-3 rounded-3 text-primary d-none d-sm-block flex-shrink-0 ms-2">

                            <i class="bi bi-shield-check fs-4 fs-md-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <div class="col">

            <div class="card border-0 shadow-sm border-start border-4 border-warning bg-white kpi-card h-100">

                <div class="card-body p-2 p-md-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="w-100">

                            <span class="text-muted extra-small text-uppercase fw-bold kpi-label">Against @OrgService.GetCurrentSettings().OrganizationShortName</span>

                            <h2 class="fw-bold text-warning mb-0 mt-1 kpi-num" id="kpiAgainstNwkrtcVal">@Model.NwkrtcAgainstCount</h2>

                        </div>

                        <div class="bg-warning-subtle p-2 p-md-3 rounded-3 text-warning d-none d-sm-block flex-shrink-0 ms-2">

                            <i class="bi bi-shield-exclamation fs-4 fs-md-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- Live Search & Roster Filter Bar -->

    <div class="card shadow-sm border-0 mb-3 mb-md-4 bg-white rounded-3">

        <div class="card-body p-3">

            <div class="row g-2 align-items-end">

                <div class="col-12 col-md-4 col-lg-2">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-bank me-1 text-danger"></i>High Court Bench</label>

                    <select id="liveEstCode" class="form-select form-select-sm fw-bold" onchange="loadHcCourtBenches(); fetchLiveHcCauselist();">

                        <option value="ALL" selected>All High Court Benches (Bengaluru, Dharwad, Kalaburagi)</option>

                        <option value="KAHC01">High Court of Karnataka — Principal Bench (Bengaluru)</option>

                        <option value="KAHC02">High Court of Karnataka — Dharwad Bench</option>

                        <option value="KAHC03">High Court of Karnataka — Kalaburagi Bench</option>

                    </select>

                </div>



                <div class="col-6 col-md-4 col-lg-2">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-calendar-range me-1 text-danger"></i>Registration Year</label>

                    <select id="liveRegYear" class="form-select form-select-sm fw-bold" onchange="fetchLiveHcCauselist();">

                        <option value="RECENT" selected>Recent Active (2023–2026)</option>

                        <option value="LAST5">Last 5 Years (2022–2026)</option>

                        <option value="LAST10">Last 10 Years (2017–2026)</option>

                        <option value="ALL">All Active Years (Full ~4K Archive)</option>

                        @for (int yr = DateTime.Today.Year; yr >= 2008; yr--)

                        {

                            <option value="@yr">@yr</option>

                        }

                    </select>

                </div>



                <div class="col-6 col-md-4 col-lg-2">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-funnel me-1 text-danger"></i>Case Status</label>

                    <select id="liveCaseStatus" class="form-select form-select-sm fw-bold" onchange="fetchLiveHcCauselist();">

                        <option value="P" selected>Pending Cases (Active Cause List)</option>

                        <option value="BOTH">All Cases (Pending + Disposed ~4K)</option>

                        <option value="D">Disposed / Decided Cases</option>

                    </select>

                </div>



                <div class="col-6 col-md-6 col-lg-2">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-calendar-date me-1 text-danger"></i>Hearing Date</label>

                    <input type="text" id="liveDate" class="form-control form-control-sm font-monospace fw-bold" value="@DateTime.Today.ToString("dd-MM-yyyy")" placeholder="dd-MM-yyyy" onchange="loadHcCourtBenches(); fetchLiveHcCauselist();" onkeyup="if(event.key==='Enter') fetchLiveHcCauselist();" />

                </div>



                <div class="col-6 col-md-6 col-lg-2">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-diagram-3 me-1 text-danger"></i>Court Hall</label>

                    <select id="liveBenchId" class="form-select form-select-sm fw-bold" onchange="filterLiveCauselistRows()">

                        <option value="ALL">All Benches / Halls</option>

                    </select>

                </div>



                <div class="col-6 col-md-6 col-lg-2">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-card-checklist me-1 text-danger"></i>Cause List No</label>

                    <select id="liveCauseListNo" class="form-select form-select-sm fw-bold" onchange="filterLiveCauselistRows()">

                        <option value="ALL" selected>All Cause Lists</option>

                        <option value="1">Cause List No. 1</option>

                        <option value="2">Cause List No. 2</option>

                        <option value="3">Cause List No. 3</option>

                        <option value="4">Cause List No. 4</option>

                    </select>

                </div>



                <div class="col-12 col-md-9 col-lg-10">

                    <label class="form-label small fw-bold text-secondary mb-1"><i class="bi bi-person-badge-fill me-1 text-danger"></i>Litigant Party Name</label>

                    <input type="text" id="livePartySearchInput" class="form-control form-control-sm fw-bold" value="@OrgService.GetCurrentSettings().OrganizationShortName" placeholder="e.g. @OrgService.GetCurrentSettings().OrganizationShortName, Managing Director, CPM" oninput="debouncedFilterLiveCauselist()" onkeyup="if(event.key==='Enter') fetchLiveHcCauselist();" />

                </div>



                <div class="col-12 col-md-3 col-lg-2">

                    <button type="button" class="btn btn-danger btn-sm w-100 fw-bold shadow-sm py-2" onclick="fetchLiveHcCauselist()">

                        <i class="bi bi-broadcast me-1"></i> Search Cause List

                    </button>

                </div>

            </div>



            <!-- Quick Party Presets Bar (Corporate Designations Only) -->

            <div class="mt-2 pt-2 border-top d-flex align-items-center gap-1 mobile-presets-scroll">

                <span class="extra-small fw-bold text-secondary text-uppercase me-1 flex-shrink-0"><i class="bi bi-tags me-1 text-danger"></i>Presets:</span>

                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 extra-small active" id="chipLiveNwkrtc" onclick="setLivePartyPreset('@OrgService.GetCurrentSettings().OrganizationShortName')">@OrgService.GetCurrentSettings().OrganizationShortName</button>

                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveMd" onclick="setLivePartyPreset('MANAGING DIRECTOR')">Managing Director</button>

                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveCpm" onclick="setLivePartyPreset('CHIEF PERSONNEL MANAGER')">CPM</button>

                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveDc" onclick="setLivePartyPreset('DIVISIONAL CONTROLLER')">Divisional Controller</button>

                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 extra-small" id="chipLiveDm" onclick="setLivePartyPreset('DEPOT MANAGER')">Depot Manager</button>

            </div>

        </div>

    </div>



    <!-- Live Cause List Results Container -->

    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">

            <div class="d-flex align-items-center gap-2">

                <h6 class="mb-0 fw-bold text-danger"><i class="bi bi-broadcast-pin me-2"></i>Official High Court Daily Cause List — @OrgService.GetCurrentSettings().OrganizationShortName Matters Listed Today</h6>

                <span class="badge bg-danger-subtle text-danger border border-danger fw-bold extra-small px-2 py-1">

                    <i class="bi bi-bell-fill me-1"></i>Today's Listed @OrgService.GetCurrentSettings().OrganizationShortName Matters Only

                </span>

            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <button type="button" class="btn btn-sm btn-outline-danger fw-bold shadow-sm py-1 px-2.5" id="btnLiveBenchScan" onclick="triggerLiveHighCourtScan()" title="Deep scan all sitting benches from NAPIX cause list PDF rosters for 100% accuracy">
                    <i class="bi bi-cpu-fill me-1"></i>⚡ Live Bench Sync
                </button>

                <div class="btn-group">

                    <button type="button" class="btn btn-sm btn-outline-success fw-bold shadow-sm py-1 px-2.5" onclick="exportCauseListToExcel('visible')" title="Export current cause list view to Excel">

                        <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Export to Excel

                    </button>

                    <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle dropdown-toggle-split shadow-sm" data-bs-toggle="dropdown" aria-expanded="false">

                        <span class="visually-hidden">Toggle Dropdown</span>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 small">

                        <li><h6 class="dropdown-header text-uppercase extra-small fw-bold text-muted"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel Export Options</h6></li>

                        <li>

                            <a class="dropdown-item py-1.5" href="javascript:void(0)" onclick="exportCauseListToExcel('visible')">

                                <i class="bi bi-funnel-fill text-primary me-2"></i>Export Current Filtered List (<span id="exportCountVisible">0</span>)

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item py-1.5" href="javascript:void(0)" onclick="exportCauseListToExcel('today')">

                                <i class="bi bi-calendar-check-fill text-danger me-2"></i>Export Today's Listed Cases (<span id="exportCountToday">0</span>)

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item py-1.5" href="javascript:void(0)" onclick="exportCauseListToExcel('all')">

                                <i class="bi bi-collection-fill text-success me-2"></i>Export All Active NWKRTC Matters (<span id="exportCountAll">0</span>)

                            </a>

                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>

                            <a class="dropdown-item py-1.5" href="javascript:void(0)" onclick="downloadServerExcel()">

                                <i class="bi bi-cloud-arrow-down-fill text-secondary me-2"></i>Download Direct from Server (.xls)

                            </a>

                        </li>

                    </ul>

                </div>

                <span id="liveListBadge" class="badge bg-secondary px-3 py-1">Loading Today's Cause List...</span>

            </div>

        </div>

        <div class="card-body p-0">

            <div id="liveCauselistContainer">

                <div class="text-center py-5 text-muted">

                    <div class="spinner-border text-danger" role="status"></div>

                    <h5 class="mt-3 fw-bold">Querying High Court Daily Cause List for '@OrgService.GetCurrentSettings().OrganizationShortName'...</h5>

                    <p class="small mb-0">Cross-referencing Dharwad, Bengaluru, and Kalaburagi official daily rosters for today.</p>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- Full Comprehensive e-Courts Dossier Modal -->
<div class="modal fade" id="dossierModal" tabindex="-1" aria-labelledby="dossierModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down" style="max-width: min(96vw, 1200px);">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <!-- Modal Header -->
            <div class="modal-header py-3 px-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); border-bottom: 1px solid rgba(255,255,255,0.15);">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-20 rounded-circle p-2.5 d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="bi bi-journal-richtext fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h5 class="modal-title fw-bold mb-0 text-white" id="modalCaseHeading">Case Dossier — <span id="modalMfaNo" class="font-monospace text-warning"></span></h5>
                            <span class="badge bg-warning text-dark font-monospace fw-bold" id="modalCnrBadge">CNR: —</span>
                            <span class="badge bg-success" id="modalStatusBadge">Pending</span>
                        </div>
                        <div class="extra-small text-white-50 mt-0.5" id="modalSubtitle">
                            High Court of Karnataka • Live Judicial Case Record • NAPIX Gateway
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5" onclick="printHighCourtDossier()" title="Print full comprehensive legal dossier">
                        <i class="bi bi-printer-fill"></i>
                        <span class="d-none d-sm-inline">Print Dossier</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 d-flex align-items-center gap-1.5" id="btnRefreshDossier" onclick="reFetchDossier()" title="Refresh live case data from e-Courts">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span class="d-none d-sm-inline">Sync Live</span>
                    </button>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Tab Navigation (Clean Horizontal Scroll) -->
            <div class="bg-light border-bottom px-3 pt-2">
                <ul class="nav nav-tabs border-0 flex-nowrap overflow-x-auto dossier-nav-tabs" id="dossierNavTabs" role="tablist" style="scrollbar-width: none;">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold small text-primary" data-bs-toggle="tab" data-bs-target="#mTabOverview" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i> Overview & Status
