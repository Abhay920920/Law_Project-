function printHighCourtDossier() {
    if (!currentHighCourtDossier) {
        showToast('Print Notice', 'Please wait for case dossier to finish loading before printing.', false);
        return;
    }
    const d = currentHighCourtDossier.data || {};
    const raw = currentHighCourtDossier.raw || {};
    const cnr = currentDossierCnr || d.cnr_number || '—';
    const caseNo = currentDossierCaseNo || d.case_number || '—';
    const est = d.establishment_name || raw.court_est_name || 'High Court of Karnataka';

    const pWin = window.open('', '_blank', 'width=900,height=800');
    if (!pWin) {
        alert('Please allow popups to print the dossier.');
        return;
    }

    const historyRows = (currentHighCourtDossier.history || []).map((h, i) => `
        <tr>
            <td style="text-align:center;">${i + 1}</td>
            <td>${h.business_date || h.hearing_date || h.date || '—'}</td>
            <td>${h.purpose_name || h.stage || h.purpose || '—'}</td>
            <td>${h.judge || h.judge_name || '—'}</td>
            <td>${h.business || h.roznama || h.remarks || '—'}</td>
        </tr>
    `).join('') || '<tr><td colspan="5" style="text-align:center;">No history recorded</td></tr>';

    const orderRows = (currentHighCourtDossier.orders || []).map((o, i) => `
        <tr>
            <td style="text-align:center;">${i + 1}</td>
            <td>${o.order_date || o.date || '—'}</td>
            <td>${o.order_number || o.order_no || `#${i+1}`}</td>
            <td>${o.order_type || o.order_details || '—'}</td>
            <td>${o.judge_name || o.judge || '—'}</td>
        </tr>
    `).join('') || '<tr><td colspan="5" style="text-align:center;">No orders recorded</td></tr>';

    pWin.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>Case Dossier - ${caseNo}</title>
            <style>
                body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #1e293b; padding: 24px; margin: 0; }
                .header { text-align: center; border-bottom: 2px solid #1e3a8a; padding-bottom: 12px; margin-bottom: 20px; }
                .org { font-size: 14pt; font-weight: bold; color: #1e3a8a; }
                .sub { font-size: 10pt; color: #64748b; margin-top: 4px; }
                .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                .meta-table td { padding: 6px 10px; border: 1px solid #cbd5e1; font-size: 10pt; }
                .meta-table td.label { background: #f8fafc; font-weight: bold; width: 22%; color: #334155; }
                table.data { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
                table.data th { background: #1e293b; color: #fff; font-size: 9.5pt; text-align: left; padding: 7px 10px; border: 1px solid #64748b; }
                table.data td { padding: 6px 10px; border: 1px solid #cbd5e1; font-size: 9pt; }
                .sec-title { font-size: 11pt; font-weight: bold; color: #1e3a8a; border-bottom: 1.5px solid #cbd5e1; padding-bottom: 4px; margin: 18px 0 10px; }
                @@media print { body { padding: 0; } }
            </style>
        </head>
        <body>
            <div class="header">
                <div class="org">NORTH WESTERN KARNATAKA ROAD TRANSPORT CORPORATION</div>
                <div class="sub">LEGAL DEPARTMENT • COMPREHENSIVE e-COURTS CASE DOSSIER</div>
            </div>
            <table class="meta-table">
                <tr>
                    <td class="label">Case Number</td><td><strong>${caseNo}</strong></td>
                    <td class="label">CNR Number</td><td><strong>${cnr}</strong></td>
                </tr>
                <tr>
                    <td class="label">Court / Bench</td><td>${est}</td>
                    <td class="label">Case Status</td><td>${d.case_status || 'Pending'}</td>
                </tr>
                <tr>
                    <td class="label">Petitioner</td><td>${d.petitioner || raw.pet_name || '—'} (Adv: ${d.petitioner_advocate || raw.pet_adv || '—'})</td>
                    <td class="label">Respondent</td><td>${d.respondent || raw.res_name || '—'} (Adv: ${d.respondent_advocate || raw.res_adv || '—'})</td>
                </tr>
                <tr>
                    <td class="label">Next Hearing Date</td><td><strong>${d.next_hearing_date || '—'}</strong></td>
                    <td class="label">Stage / Purpose</td><td>${d.stage || raw.purpose_name || '—'}</td>
                </tr>
                <tr>
                    <td class="label">Filing Date</td><td>${d.filing_date || raw.date_of_filing || '—'}</td>
                    <td class="label">Registration Date</td><td>${d.registration_date || raw.dt_regis || '—'}</td>
                </tr>
            </table>

            <div class="sec-title">Hearing History & Daily Proceedings</div>
            <table class="data">
                <thead>
                    <tr><th style="width:30px;">#</th><th style="width:90px;">Date</th><th style="width:160px;">Stage / Purpose</th><th style="width:150px;">Judge</th><th>Business On Date</th></tr>
                </thead>
                <tbody>${historyRows}</tbody>
            </table>

            <div class="sec-title">Court Orders & Judgments</div>
            <table class="data">
                <thead>
                    <tr><th style="width:30px;">#</th><th style="width:90px;">Order Date</th><th style="width:80px;">Order No</th><th>Order Type / Details</th><th>Judge / Coram</th></tr>
                </thead>
                <tbody>${orderRows}</tbody>
            </table>

            <div style="margin-top: 30px; text-align: right; font-size: 8.5pt; color: #94a3b8;">
                Generated on: ${new Date().toLocaleString()} | e-Courts Gateway Data
            </div>
            <script>
                window.onload = function() { window.print(); };
            <\/script>
        </body>
        </html>
    `);
    pWin.document.close();
}

function openLiveRoznamaDirect(cnr, date, caseNo, pet, res) {

    curRzCnr = cnr || '';

    

    // Fallback date if not provided or empty

    if (!date || date === '—' || date === 'null' || date === 'undefined') {

        date = document.getElementById('liveDate')?.value || '';

        if (!date) {

            const today = new Date();

            const dd = String(today.getDate()).padStart(2, '0');

            const mm = String(today.getMonth() + 1).padStart(2, '0');

            date = `${dd}-${mm}-${today.getFullYear()}`;

        }

    }

    curRzDate = date;

    curRzCaseNo = caseNo || '';



    const elCnr = document.getElementById('rzCnr');

    const elDate = document.getElementById('rzDate');

    const elCaseNo = document.getElementById('rzCaseNo');

    const elParties = document.getElementById('rzParties');

    const elText = document.getElementById('rzText');



    if (elCnr) elCnr.textContent = cnr || '—';

    if (elDate) elDate.textContent = date || '—';

    if (elCaseNo) elCaseNo.textContent = caseNo || '—';

    if (elParties) elParties.textContent = (pet && res) ? `${pet} vs ${res}` : (caseNo || 'High Court Case Record');

    if (elText) elText.textContent = `Querying live e-Courts NAPIX showBusiness gateway for CNR ${cnr} on ${date}...`;

    

    const badge = document.getElementById('rzLiveBadge');

    if (badge) {

        badge.className = 'badge bg-warning text-dark extra-small';

        badge.innerHTML = '<span class="spinner-border spinner-border-sm me-1" style="width:0.6rem;height:0.6rem;"></span> Checking Live...';

    }

    const msg = document.getElementById('rzLiveMsg');

    if (msg) msg.textContent = `Connecting to official Daily Status gateway for ${date}...`;



    const modalEl = document.getElementById('roznamaModal');
    if (modalEl && modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }
    if (modalEl) {
        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {

            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            modal.show();

        } else if (typeof $ !== 'undefined') {

            $('#roznamaModal').modal('show');

        }

    }



    reloadCurrentRoznama();

}



function reloadCurrentRoznama() {

    if (!curRzCnr || !curRzDate) return;

    const badge = document.getElementById('rzLiveBadge');

    const msg = document.getElementById('rzLiveMsg');

    const rzText = document.getElementById('rzText');



    const urlParams = new URLSearchParams(window.location.search);

    const curModule = urlParams.get('module') || 'MVC';



    fetch(`/ECourts/GetCaseBusiness?cnrNumber=${encodeURIComponent(curRzCnr)}&date=${encodeURIComponent(curRzDate)}&isHighCourt=true&module=${encodeURIComponent(curModule)}`)

        .then(r => r.json())

        .then(res => {

            if (res && res.success) {

                const isDb = (res.source === 'Database');

                if (badge) {

                    badge.className = isDb ? 'badge bg-primary extra-small' : 'badge bg-success extra-small';

                    badge.innerHTML = isDb ? '<i class="bi bi-database-fill me-1"></i> Database Record' : '<i class="bi bi-broadcast me-1"></i> Live NAPIX Roznama';

                }

                if (msg) msg.textContent = isDb ? 'Proceedings loaded from recorded case database history.' : 'Live Daily Status successfully retrieved from e-Courts NAPIX Gateway.';



                const bText = res.business || res.roznama || res.proceedings || (res.data && (res.data.business || res.data.roznama || res.data.proceedings || res.data.court_business)) || '';

                if (bText && bText.trim().length >= 3) {

                    if (rzText) rzText.textContent = bText.trim();

                } else {

                    if (rzText) rzText.textContent = 'Listing scheduled for ' + curRzDate + '. No verbatim text was returned by e-Courts NJDG for this date.';

                }

            } else {

                if (badge) {

                    badge.className = 'badge bg-secondary extra-small';

                    badge.innerHTML = '<i class="bi bi-info-circle me-1"></i> Not Available';

                }

                if (msg) msg.textContent = res.message || 'No Daily Status record found on NAPIX gateway for this date.';

                if (rzText) {

                    rzText.textContent = '⚠️ Daily proceedings (Roznama) not available on NJDG for this hearing date.\n\n' +

                        'Hearing Date: ' + curRzDate + '\nCNR: ' + curRzCnr + '\n\n' +

                        (res.message ? res.message : 'The daily order was not uploaded to e-Courts for this date.');

                }

            }

        })

        .catch(err => {

            if (badge) {

                badge.className = 'badge bg-danger extra-small';

                badge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> Connection Error';

            }

            if (msg) msg.textContent = 'Network error contacting eCourts gateway.';

            if (rzText) rzText.textContent = 'Network error fetching live proceedings: ' + err;

        });

}



function copyRoznamaText() {

    const txt = document.getElementById('rzText')?.innerText || '';

    if (!txt || txt.includes('Loading verbatim')) {

        showToast('Notice', 'No roznama text to copy.', false);

        return;

    }

    navigator.clipboard.writeText(txt).then(() => {

        showToast('Copied', 'Roznama text copied to clipboard.', true);

    }).catch(() => {

        showToast('Notice', 'Could not access clipboard.', false);

    });

}



// Auto-initialize on page load: load benches and immediately fetch today's live cause list for NWKRTC

document.addEventListener('DOMContentLoaded', function () {
    loadHcCourtBenches();
    fetchLiveHcCauselist();

    // Ensure modals are mounted to document.body to prevent flex overflow clipping and background scroll jumping
    const dModal = document.getElementById('dossierModal');
    if (dModal && dModal.parentElement !== document.body) {
        document.body.appendChild(dModal);
    }
    const rzModal = document.getElementById('roznamaModal');
    if (rzModal && rzModal.parentElement !== document.body) {
        document.body.appendChild(rzModal);
    }



    // Multi-modal support: Keep body scrollable if dossierModal is still active when roznamaModal is dismissed

    const rzModalEl = document.getElementById('roznamaModal');

    if (rzModalEl) {

        rzModalEl.addEventListener('hidden.bs.modal', function () {

            const dossier = document.getElementById('dossierModal');

            if (dossier && (dossier.classList.contains('show') || dossier.style.display === 'block')) {

                document.body.classList.add('modal-open');

            }

        });

    }

});



function downloadServerExcel() {

    const estCode = document.getElementById('liveEstCode')?.value || 'ALL';

    const regYear = document.getElementById('liveRegYear')?.value || 'RECENT';

    const caseStatus = document.getElementById('liveCaseStatus')?.value || 'P';

    const hearingDate = (document.getElementById('liveDate')?.value || '').trim();

    const partyName = (document.getElementById('livePartySearchInput')?.value || defaultOrgShortName).trim();

    const isTodayOnly = (currentViewMode === 'today');



    const url = `/ECourts/ExportHighCourtCauseListToExcel?estCode=${encodeURIComponent(estCode)}&partyName=${encodeURIComponent(partyName)}&regYear=${encodeURIComponent(regYear)}&pendDisp=${encodeURIComponent(caseStatus)}&hearingDate=${encodeURIComponent(hearingDate)}&todayOnly=${isTodayOnly}`;

    window.location.href = url;

}



function exportCauseListToExcel(scope = 'visible') {

    const allItems = window.__currentHcCauselistItems || [];

    if (!allItems || allItems.length === 0) {

        showToast('Notice', 'No High Court cases loaded to export.', false);

        return;

    }



    const hearingDateVal = (document.getElementById('liveDate')?.value || '').trim();

    const estCodeVal = document.getElementById('liveEstCode')?.value || 'ALL';

    let targetBench = estCodeVal === "KAHC01" ? "Bengaluru" : (estCodeVal === "KAHC02" ? "Dharwad" : (estCodeVal === "KAHC03" ? "Kalaburagi" : "All Benches"));



    let exportItems = [];

    if (scope === 'today') {

        exportItems = allItems.filter(x => x.isListedToday === true);

    } else if (scope === 'all') {

        exportItems = allItems;

    } else { // 'visible' (all cases currently matching active filters)

        exportItems = (window.__filteredHcCauselistItems && window.__filteredHcCauselistItems.length > 0)

            ? window.__filteredHcCauselistItems

            : allItems;

    }



    if (exportItems.length === 0) {

        showToast('Notice', 'No matching cases found for the selected export option.', false);

        return;

    }



    const orgName = '@OrgService.GetCurrentSettings().OrganizationNameEnglish';

    const orgShort = defaultOrgShortName;

    const nowStr = new Date().toLocaleString();



    let html = `<!DOCTYPE html>

<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">

<head>

<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

<!--[if gte mso 9]>

<xml>

 <x:ExcelWorkbook>

  <x:ExcelWorksheets>

   <x:ExcelWorksheet>

    <x:Name>High Court Cause List</x:Name>

    <x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>

   </x:ExcelWorksheet>

  </x:ExcelWorksheets>

 </x:ExcelWorkbook>

</xml>

<![endif]-->

<style>

  body { font-family: Calibri, 'Segoe UI', Arial, sans-serif; font-size: 11pt; }

  table { border-collapse: collapse; width: 100%; }

  .title-header { background-color: #991b1b; color: #ffffff; font-size: 14pt; font-weight: bold; text-align: center; padding: 12px; }

  .sub-header { background-color: #f8fafc; color: #334155; font-size: 10pt; text-align: center; padding: 6px; border: 1px solid #cbd5e1; }

  th { background-color: #1e293b; color: #ffffff; font-weight: bold; font-size: 10.5pt; text-align: left; padding: 8px 10px; border: 1px solid #94a3b8; }

  td { font-size: 10pt; padding: 6px 10px; border: 1px solid #cbd5e1; vertical-align: top; }

  .row-even { background-color: #ffffff; }

  .row-odd { background-color: #f8fafc; }

  .text-fmt { mso-number-format: "\\@@"; }

  .center { text-align: center; }

  .badge-with { color: #0284c7; font-weight: bold; }

  .badge-against { color: #d97706; font-weight: bold; }

  .badge-today { color: #dc2626; font-weight: bold; }

</style>

</head>

<body>

<table>

  <tr><td colspan="16" class="title-header">${escapeHtml(orgName.toUpperCase())} (${escapeHtml(orgShort)})</td></tr>

  <tr><td colspan="16" class="sub-header"><strong>HIGH COURT CAUSE LIST &amp; ACTIVE MATTERS ROSTER</strong> | Bench: ${escapeHtml(targetBench)} | Hearing Date: ${escapeHtml(hearingDateVal)} | Scope: ${scope.toUpperCase()} | Total Records: ${exportItems.length} | Exported: ${escapeHtml(nowStr)}</td></tr>

  <tr>

    <th class="center" style="width: 45px;">#</th>

    <th>Case Number &amp; Year</th>

    <th>High Court Bench</th>

    <th>Court Hall / Bench</th>

    <th>Judge Name</th>

    <th>CNR Number</th>

    <th>Petitioner Name</th>

    <th>Respondent Name</th>

    <th>Corporation Role</th>

    <th>Matched Designation / Unit</th>

    <th>Next Hearing Date</th>

    <th>Hearing Stage / Purpose</th>

    <th>Cause List Type</th>

    <th>Serial Number</th>

    <th>Listing Status</th>

    <th>Listing Source</th>

  </tr>`;



    exportItems.forEach((item, idx) => {

        const rowClass = (idx % 2 === 0) ? 'row-even' : 'row-odd';

        const caseNo = `${item.caseType || 'MFA'} ${item.regNumber || ''}/${item.regYear || ''}`.trim();

        let hearingDateDisplay = item.nextHearingDate ? (typeof item.nextHearingDate === 'string' ? item.nextHearingDate.substring(0, 10) : '') : '-';

        if (hearingDateDisplay.startsWith('5000')) hearingDateDisplay = '-';

        const roleClass = (item.nwkrtcRole === 'With NWKRTC' || (item.nwkrtcRole && item.nwkrtcRole.includes('With'))) ? 'badge-with' : 'badge-against';

        const isToday = item.isListedToday === true;

        const listingStatus = isToday ? `Listed Today (${hearingDateVal})` : (hearingDateDisplay !== '-' ? `Next: ${hearingDateDisplay}` : 'Hearing Active');



        html += `

  <tr class="${rowClass}">

    <td class="center">${idx + 1}</td>

    <td class="text-fmt"><strong>${escapeHtml(caseNo)}</strong></td>

    <td>${escapeHtml(item.highCourtBench || item.establishmentName || '-')}</td>

    <td>${escapeHtml(item.courtHall || '-')}</td>

    <td>${escapeHtml(item.judgeName || '-')}</td>

    <td class="text-fmt font-monospace">${escapeHtml(item.cnrNumber || '-')}</td>

    <td>${escapeHtml(item.petitionerName || '-')}</td>

    <td>${escapeHtml(item.respondentName || '-')}</td>

    <td class="${roleClass}">${escapeHtml(item.nwkrtcRole || '-')}</td>

    <td>${escapeHtml(item.matchedDesignation || '-')}</td>

    <td class="center">${escapeHtml(hearingDateDisplay)}</td>

    <td>${escapeHtml(item.caseStage || '-')}</td>

    <td>${escapeHtml(item.causeListType || '-')}</td>

    <td class="center text-fmt">${escapeHtml(item.causeListItemNo || '-')}</td>

    <td>${isToday ? `<span class="badge-today">${escapeHtml(listingStatus)}</span>` : escapeHtml(listingStatus)}</td>

    <td>Live High Court Registry</td>

  </tr>`;

    });



    html += `</table></body></html>`;



    function escapeHtml(str) {

        if (!str) return '';

        return String(str)

            .replace(/&/g, '&amp;')

            .replace(/</g, '&lt;')

            .replace(/>/g, '&gt;')

            .replace(/"/g, '&quot;');

    }



    const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=utf-8;' });

    const link = document.createElement("a");

    const scopeLabel = scope === 'today' ? 'TodayListed' : (scope === 'all' ? 'AllActive' : 'Filtered');

    const fileName = `${orgShort}_HighCourt_CauseList_${scopeLabel}_${new Date().toISOString().slice(0,10)}.xls`;

    

    if (navigator.msSaveBlob) {

        navigator.msSaveBlob(blob, fileName);

    } else {

        link.href = URL.createObjectURL(blob);

        link.download = fileName;

        document.body.appendChild(link);

        link.click();

        document.body.removeChild(link);

        URL.revokeObjectURL(link.href);

    }



    showToast('Export Complete', `Exported ${exportItems.length} matters to ${fileName}.`, true);

}



</script>

