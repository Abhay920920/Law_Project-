<!-- Floating Toast Container -->

<div class="hc-toast-container" id="hcToastContainer"></div>



<script>

let liveHcInitialized = false;



function safeJsArg(str) {

    if (!str) return '';

    return String(str)

        .replace(/\\/g, '\\\\')

        .replace(/'/g, "\\'")

        .replace(/"/g, '&quot;')

        .replace(/\n|\r/g, ' ');

}



function showToast(title, message, isSuccess = true) {

    const container = document.getElementById('hcToastContainer');

    if (!container) return;



    const toastId = 'toast_' + Date.now();

    const borderClass = isSuccess ? 'border-success' : 'border-danger';

    const iconClass = isSuccess ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';



    const toastHtml = `

        <div id="${toastId}" class="toast align-items-center bg-white border ${borderClass} shadow-lg mb-2" role="alert" aria-live="assertive" aria-atomic="true">

            <div class="d-flex">

                <div class="toast-body small py-2">

                    <div class="fw-bold text-dark d-flex align-items-center">

                        <i class="bi ${iconClass} me-2 fs-6"></i> ${title}

                    </div>

                    <div class="text-muted mt-1 ps-4">${message}</div>

                </div>

                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>

            </div>

        </div>`;

    container.insertAdjacentHTML('beforeend', toastHtml);



    const el = document.getElementById(toastId);

    if (el) {

        const bsToast = new bootstrap.Toast(el, { delay: 4000 });

        bsToast.show();

        el.addEventListener('hidden.bs.toast', () => el.remove());

    }

}



function extractArrayFromData(data) {

    if (!data) return [];

    if (Array.isArray(data)) return data;

    if (typeof data === 'object') {

        const keys = ['causelist', 'causelistdetails', 'cause_list', 'cases', 'items', 'benches', 'court_halls', 'data', 'results'];

        for (let k of keys) {

            if (Array.isArray(data[k])) return data[k];

        }

        for (let k in data) {

            if (Array.isArray(data[k]) && data[k].length > 0) return data[k];

            if (typeof data[k] === 'object' && data[k] !== null) {

                let inner = extractArrayFromData(data[k]);

                if (inner.length > 0) return inner;

            }

        }

    }

    return [];

}



