        .then(r => r.json())
        .then(res => {
            currentHighCourtDossier = res;
            if (res && res.success) {
                const d = res.data || {};
                const raw = res.raw || {};

                // Subtitle
                const estName = d.establishment_name || raw.court_est_name || raw.est_name || 'High Court of Karnataka';
                document.getElementById('modalSubtitle').textContent = `${estName} • Live Judicial Case Record • NAPIX Gateway`;

