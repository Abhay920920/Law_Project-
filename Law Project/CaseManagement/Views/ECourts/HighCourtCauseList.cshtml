                const isDisposed = statusStr.toLowerCase().includes('dispos');
                const sBadge = document.getElementById('modalStatusBadge');
                sBadge.className = isDisposed ? 'badge bg-success' : 'badge bg-warning text-dark';
                sBadge.textContent = statusStr || (isDisposed ? 'Disposed' : 'Pending');

                const sPill = document.getElementById('dStatusPill');
                sPill.className = isDisposed ? 'badge bg-success-subtle text-success border border-success extra-small' : 'badge bg-warning-subtle text-dark border border-warning extra-small';
                sPill.textContent = statusStr || (isDisposed ? 'Disposed' : 'Active');

                // 1. Overview Card - Registration
                const caseType = d.case_type || raw.type_name_reg || raw.type_name || '';
                document.getElementById('dCaseTypeBadge').textContent = caseType || 'High Court Matter';
                document.getElementById('dCaseNo').textContent = `${caseType ? caseType + ' ' : ''}${d.case_number || mfaNo || '—'}`;
                document.getElementById('dFilNo').textContent = raw.fil_no ? `${raw.fil_no}/${raw.fil_year || ''}` : (d.filing_date || '—');
                document.getElementById('dFilDate').textContent = d.filing_date || raw.date_of_filing || '—';
                document.getElementById('dRegDate').textContent = d.registration_date || raw.dt_regis || '—';

                // Overview Card - Listing & Hearing
                document.getElementById('dNextHearing').textContent = d.next_hearing_date || '—';
                document.getElementById('dStage').textContent = d.stage || raw.purpose_name || '—';
                document.getElementById('dFirstHearing').textContent = d.first_hearing_date || raw.date_first_list || '—';
                document.getElementById('dDisposalDate').textContent = d.decision_date || raw.date_of_decision || '—';

                // Overview Card - Court & Bench
                document.getElementById('dCourtName').textContent = estName;
                document.getElementById('dJudgeName').textContent = raw.coram || d.court_no_judge || d.judge || '—';
                document.getElementById('dCourtNo').textContent = d.court_no || raw.court_no || '—';
                const dCauseListNoEl = document.getElementById('dCauseListNo');
                if (dCauseListNoEl) {
                    const matchedItem = (window.__allHcCauselistItems || []).find(x => (x.cnrNumber && x.cnrNumber.toUpperCase() === cnr.toUpperCase()) || (x.regNumber && x.regNumber === appealId));
                    const clNoVal = (matchedItem && (matchedItem.causeListNo || (matchedItem.causeListType ? matchedItem.causeListType.match(/No\.?\s*(\d+)/i)?.[1] : null))) || raw.causelist_no || raw.cause_list_no || (raw.causelist_type ? raw.causelist_type.match(/No\.?\s*(\d+)/i)?.[1] : null) || (matchedItem && matchedItem.isListedToday ? '1' : '');
                    dCauseListNoEl.textContent = clNoVal ? `Cause List No. ${clNoVal}` : '—';
                }
                const benchDesc = raw.bench_name || (raw.bench_type == 1 ? 'Single Bench' : raw.bench_type == 2 ? 'Division Bench' : raw.bench_type == 3 ? 'Full Bench' : 'High Court Bench');
                document.getElementById('dBenchType').textContent = benchDesc;
                document.getElementById('dStateDist').textContent = `${raw.state_name || 'Karnataka'}${raw.dist_name ? ', ' + raw.dist_name : ''}`;

                // Overview Card - Metadata
                document.getElementById('dNatureDisposal').textContent = d.nature_of_disposal || raw.disposal_type || '—';
                document.getElementById('dJudicialBranch').textContent = raw.judicial_branch || '—';
                document.getElementById('dCauselistType').textContent = raw.causelist_type || 'Daily Cause List';
                document.getElementById('dMainMatterCnr').textContent = raw.main_matter_cino || '—';
                document.getElementById('dLowerCourt').textContent = raw.lower_court_name || '—';
                document.getElementById('dLowerCourtCaseNo').textContent = raw.lower_court_caseno ? `${raw.lower_court_caseno}${raw.lower_court_dec_dt ? ' (Decided: ' + raw.lower_court_dec_dt + ')' : ''}` : (d.lower_court_caseno || '—');
                document.getElementById('dTransferEst').textContent = d.transfer_est || raw.transfer_est || '—';
                document.getElementById('dTransferDate').textContent = d.transfer_date || raw.transfer_date || '—';

                let linkedStr = '—';
                if (res.linked_cases && res.linked_cases.length > 0) {
                    linkedStr = res.linked_cases.map(lc => lc.case_number || lc.cino || lc.reg_no || JSON.stringify(lc)).join(', ');
                } else if (raw.connected_cases || raw.connected_case) {
                    linkedStr = typeof raw.connected_cases === 'string' ? raw.connected_cases : JSON.stringify(raw.connected_cases);
                }
                document.getElementById('dConnectedCases').textContent = linkedStr;

                // 2. Parties & Advocates
                function formatExtraParties(val) {
                    if (!val) return "None";
                    if (typeof val === 'string') return val;
                    if (typeof val === 'object') {
                        const arr = Object.values(val).filter(v => typeof v === 'string' && v.trim().length > 0);
                        return arr.length > 0 ? arr.join(", ") : "None";
                    }
                    return String(val);
                }

                document.getElementById('mPetName').textContent = d.petitioner || raw.pet_name || '—';
                document.getElementById('mPetAdv').textContent = d.petitioner_advocate || raw.pet_adv || 'Not Assigned / In Person';
                document.getElementById('mPetExtra').textContent = formatExtraParties(raw.pet_extra_party);

                document.getElementById('mResName').textContent = d.respondent || raw.res_name || '—';
                document.getElementById('mResAdv').textContent = d.respondent_advocate || raw.res_adv || 'Not Assigned / In Person';
                document.getElementById('mResExtra').textContent = formatExtraParties(raw.res_extra_party || d.extra_party);

                // 3. Proceedings History
                const history = (res.history && res.history.length > 0) ? res.history : 
                                (res.data && res.data.history && res.data.history.length > 0 ? res.data.history : 
                                (res.data && res.data.case_history ? res.data.case_history : []));
                document.getElementById('mCountHistory').textContent = history.length;

                if (history.length === 0) {
                    document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No proceedings records found in e-Courts payload.</td></tr>';
                } else {
                    let hHtml = '';
                    history.forEach((item, idx) => {
                        const dt = item.business_date || item.hearing_date || item.date || item.next_date || item.cause_date || '—';
                        const purpose = item.purpose_name || item.stage || item.next_purpose || item.purpose || item.court_stage || '—';
                        const judge = item.judge || item.judge_name || item.desgname || item.court_no_judge || item.presiding_officer || '—';
                        const business = item.business || item.roznama || item.proceedings || item.remarks || item.court_business || '—';

                        hHtml += `<tr>
                            <td class="text-center text-muted fw-bold">${idx + 1}</td>
                            <td class="fw-bold text-dark font-monospace text-nowrap" style="white-space: nowrap !important;">${dt}</td>
                            <td><span class="badge bg-light text-primary border text-wrap text-start" style="font-size: 11.5px; line-height: 1.4; padding: 5px 8px;">${purpose}</span></td>
                            <td class="fw-semibold text-secondary" style="font-size: 12px; line-height: 1.4;">${judge}</td>
                            <td>
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <span class="fst-italic text-secondary text-truncate" style="max-width: 280px; font-size: 12px;" title="${business}">${business}</span>
                                    <button type="button" class="btn btn-xs btn-outline-primary py-1 px-2 extra-small text-nowrap shadow-xs fw-semibold" onclick="openLiveRoznamaDirect('${cnr}', '${dt}', '${safeJsArg(mfaNo)}', '${safeJsArg(d.petitioner || '')}', '${safeJsArg(d.respondent || '')}')" title="Open Full Roznama Proceedings">
                                        <i class="bi bi-file-earmark-text me-1"></i>Roznama
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyHistory').innerHTML = hHtml;
                }

                // 4. Orders & Judgments
                const orders = (res.orders && res.orders.length > 0) ? res.orders : 
                               (res.data && res.data.orders ? res.data.orders : []);
                document.getElementById('mCountOrders').textContent = orders.length;

                if (orders.length === 0) {
                    document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No formal court orders uploaded yet.</td></tr>';
                } else {
                    let oHtml = '';
                    orders.forEach((item, idx) => {
                        const dt = item.order_date || item.orderDate || item.date || '—';
                        const oNo = item.order_number || item.order_no || `#${idx + 1}`;
                        const type = item.order_type || item.title || item.order_details || 'Order / Judgment';
                        const judge = item.judge || item.desgname || item.judge_name || '—';
                        const pdfUrl = item.pdf_url || item.order_link || item.link || item.pdf || item.order_pdf_url || '';

                        let actionBtn = `<a href="/ECourts/ViewOrderPdf?cnr=${encodeURIComponent(cnr)}" target="_blank" class="btn btn-sm btn-outline-danger py-1 px-2.5 extra-small fw-bold"><i class="bi bi-file-pdf-fill me-1"></i>View PDF</a>`;
                        if (pdfUrl) {
                            let targetUrl = pdfUrl;
                            if (!pdfUrl.startsWith('/ECourts/ViewOrderPdf')) {
                                targetUrl = `/ECourts/ViewOrderPdf?url=${encodeURIComponent(pdfUrl)}&cnr=${encodeURIComponent(cnr)}`;
                            }
                            actionBtn = `<a href="${targetUrl}" target="_blank" class="btn btn-sm btn-danger py-1 px-2.5 text-white extra-small fw-bold shadow-xs"><i class="bi bi-file-pdf-fill me-1"></i>Open PDF</a>`;
                        }

                        oHtml += `<tr>
                            <td class="text-center text-muted fw-bold">${idx + 1}</td>
                            <td class="fw-bold text-dark font-monospace text-nowrap">${dt}</td>
                            <td class="font-monospace fw-bold text-primary">${oNo}</td>
                            <td><strong>${type}</strong></td>
                            <td class="text-secondary small">${judge}</td>
                            <td class="text-center">${actionBtn}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyOrders').innerHTML = oHtml;
                }

                // 5. IA Filings
                let rawIa = res.ia_filings;
                if (!rawIa || (Array.isArray(rawIa) && rawIa.length === 0)) {
                    rawIa = raw.iafiling || raw.ia_filing || raw.ia_filings || raw.ia_details || raw.ias || raw.interim_application || [];
                }
                let iaList = [];
                if (Array.isArray(rawIa)) {
                    iaList = rawIa;
                } else if (typeof rawIa === 'object' && rawIa !== null) {
                    iaList = Object.values(rawIa);
                }
                document.getElementById('mCountIA').textContent = iaList.length;

                if (iaList.length === 0) {
                    document.getElementById('mTbodyIA').innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No interim applications recorded in e-Courts payload.</td></tr>';
                } else {
                    let iaHtml = '';
                    iaList.forEach((ia, idx) => {
                        let iaNo = ia.ia_number || ia.ia_no || ia.no || ia.ianumber || ia.ia_num || `IA #${idx + 1}`;
                        let classification = ia.classification || ia.ia_prayer || ia.prayer || ia.purpose || '';
                        if (typeof iaNo === 'string') {
                            const classMatch = iaNo.match(/(?:<b>\s*)?classification\s*:\s*(?:<\/b>\s*)?([^<]+)/i);
                            if (classMatch && classMatch[1] && !classification) classification = classMatch[1].trim();
                            iaNo = iaNo.replace(/<\/?b>/gi, '').replace(/<\/?br\s*\/?>/gi, ' - ').replace(/classification\s*:\s*.*$/i, '').trim();
                            if (iaNo.endsWith('-')) iaNo = iaNo.slice(0, -1).trim();
                        }
                        const filingDate = ia.date_of_filing || ia.filing_date || ia.date || ia.filingdate || '—';
                        const party = ia.ia_pet_name || ia.party_name || ia.applicant || ia.party || ia.petitioner || '—';
                        const st = (ia.ia_pend_disp || ia.status || ia.ia_status || '').trim().toUpperCase();
                        let badge = '<span class="badge bg-secondary-subtle text-secondary border extra-small">Recorded</span>';
                        if (st === 'P' || st.includes('PEND')) {
                            badge = '<span class="badge bg-warning-subtle text-dark border border-warning extra-small">Pending</span>';
                        } else if (st === 'D' || st.includes('DISPOS')) {
                            badge = '<span class="badge bg-success-subtle text-success border border-success extra-small">Disposed</span>';
                        } else if (st.includes('ALLOW')) {
                            badge = '<span class="badge bg-primary-subtle text-primary border border-primary extra-small">Allowed</span>';
                        } else if (st.includes('DISMISS') || st.includes('REJECT')) {
                            badge = '<span class="badge bg-danger-subtle text-danger border border-danger extra-small">Dismissed</span>';
                        }

                        iaHtml += `<tr>
                            <td class="text-center fw-bold text-muted">${idx + 1}</td>
                            <td class="font-monospace fw-bold text-primary">${iaNo}</td>
                            <td class="font-monospace">${filingDate}</td>
                            <td><div class="fw-semibold text-dark">${party}</div></td>
                            <td><div class="small text-secondary">${classification || '—'}</div></td>
                            <td class="text-center">${badge}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyIA').innerHTML = iaHtml;
                }

                // 6. Process Issued
                let rawProc = res.processes;
                if (!rawProc || (Array.isArray(rawProc) && rawProc.length === 0)) {
                    rawProc = raw.processes || raw.case_processes || raw.process || raw.process_details || raw.notice_details || raw.notices || raw.notice || [];
                }
                let procList = [];
                if (Array.isArray(rawProc)) {
                    procList = rawProc;
                } else if (typeof rawProc === 'object' && rawProc !== null) {
                    procList = Object.values(rawProc);
                }
                document.getElementById('mCountProcess').textContent = procList.length;

                if (procList.length === 0) {
                    document.getElementById('mTbodyProcess').innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No process notices recorded in e-Courts payload.</td></tr>';
                } else {
                    let procHtml = '';
                    procList.forEach((p, idx) => {
                        const procId = p.process_id || p.process_no || p.id || p.sr_no || `P-${idx + 1}`;
                        const pTitle = p.process_title || p.title || p.process_name || p.name || p.notice_title || 'Notice / Process';
                        const pParty = p.party_name || p.recipient || p.issued_to || p.pet_name || p.res_name || '';
                        const pDate = p.issue_date || p.process_date || p.date || p.issued_date || '—';
                        const rDate = p.return_date || p.next_date || '';
                        const nType = p.notice_type || p.type || p.process_type || p.status || 'Process Issued';

                        procHtml += `<tr>
                            <td class="text-center fw-bold text-muted">${idx + 1}</td>
                            <td class="font-monospace fw-bold text-primary">${procId}</td>
                            <td>
                                <div class="fw-semibold text-dark">${pTitle}</div>
                                ${pParty ? `<div class="extra-small text-muted mt-0.5"><i class="bi bi-person me-1"></i>Issued To: <strong>${pParty}</strong></div>` : ''}
                            </td>
                            <td class="font-monospace">${pDate}</td>
                            <td class="font-monospace">${rDate || '—'}</td>
                            <td class="text-center"><span class="badge bg-light text-dark border extra-small">${nType}</span></td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyProcess').innerHTML = procHtml;
                }

                // 7. Acts & Sections
                const acts = res.acts || raw.acts || [];
                document.getElementById('mCountActs').textContent = acts.length;

                if (acts.length === 0) {
                    document.getElementById('mTbodyActs').innerHTML = '<tr><td colspan="3" class="text-center text-muted py-4">No specific acts or sections recorded in e-Courts payload.</td></tr>';
                } else {
                    let actsHtml = '';
                    acts.forEach((a, idx) => {
                        actsHtml += `<tr>
                            <td class="text-center fw-bold text-muted">${idx + 1}</td>
                            <td class="fw-semibold text-dark">${a.act || a.act_name || '—'}</td>
                            <td class="font-monospace text-primary fw-bold">${a.section || '—'}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyActs').innerHTML = actsHtml;
                }

            } else {
                document.getElementById('modalStatusBadge').textContent = 'Offline / Error';
                document.getElementById('modalStatusBadge').className = 'badge bg-danger';
                document.getElementById('mTbodyHistory').innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">${res?.message || 'Could not load e-Courts history.'}</td></tr>`;
                document.getElementById('mTbodyOrders').innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">${res?.message || 'Could not load e-Courts orders.'}</td></tr>`;
                document.getElementById('mTbodyIA').innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No records.</td></tr>';
                document.getElementById('mTbodyProcess').innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No records.</td></tr>';
                document.getElementById('mTbodyActs').innerHTML = '<tr><td colspan="3" class="text-center text-muted py-4">No records.</td></tr>';
            }
        })
        .catch(err => {
            document.getElementById('modalStatusBadge').textContent = 'Network Error';
            document.getElementById('modalStatusBadge').className = 'badge bg-danger';
            document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Network error connecting to e-Courts Gateway.</td></tr>';
            document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Network error connecting to e-Courts Gateway.</td></tr>';
        });
}

