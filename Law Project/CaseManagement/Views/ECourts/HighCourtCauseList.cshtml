function setLivePartyPreset(party) {

    const input = document.getElementById('livePartySearchInput');

    if (input) input.value = party;



    ['chipLiveNwkrtc', 'chipLiveMd', 'chipLiveCpm', 'chipLiveDc', 'chipLiveDm'].forEach(id => {

        document.getElementById(id)?.classList.remove('active', 'btn-outline-danger');

        document.getElementById(id)?.classList.add('btn-outline-secondary');

    });



    if (party === defaultOrgShortName || party === 'NWKRTC') {

        const c = document.getElementById('chipLiveNwkrtc');

        if (c) { c.classList.add('active', 'btn-outline-danger'); c.classList.remove('btn-outline-secondary'); }

    } else if (party === 'MANAGING DIRECTOR') {

        const c = document.getElementById('chipLiveMd');

        if (c) { c.classList.add('active', 'btn-outline-danger'); c.classList.remove('btn-outline-secondary'); }

    } else if (party === 'CHIEF PERSONNEL MANAGER') {

        const c = document.getElementById('chipLiveCpm');

        if (c) { c.classList.add('active', 'btn-outline-danger'); c.classList.remove('btn-outline-secondary'); }

    } else if (party === 'DIVISIONAL CONTROLLER') {

        const c = document.getElementById('chipLiveDc');

        if (c) { c.classList.add('active', 'btn-outline-danger'); c.classList.remove('btn-outline-secondary'); }

    } else if (party === 'DEPOT MANAGER') {

        const c = document.getElementById('chipLiveDm');

        if (c) { c.classList.add('active', 'btn-outline-danger'); c.classList.remove('btn-outline-secondary'); }

    }



    fetchLiveHcCauselist();

}



function syncSingleCnr(appealId, cnr, isBatch = false) {

    if (!cnr) return Promise.resolve({ success: false, cnr: '' });

    const btn = document.getElementById('sync_btn_' + appealId);

    let origText = '';

    if (btn) {

        origText = btn.innerHTML;

        btn.disabled = true;

        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

    }



    return fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=true&appealId=${encodeURIComponent(appealId)}`)

        .then(r => r.json())

        .then(res => {

            if (res && res.success && res.data) {

                const d = res.data;

                const nextDateDisplay = d.next_hearing_date || 'Updated';

                if (!isBatch) {

                    showToast(`CNR Synced (${cnr})`, `Live data updated: ${nextDateDisplay} | ${d.stage || 'Hearing Active'}`, true);

                }

                return { success: true, cnr };

            } else {

                if (!isBatch) {

                    showToast(`Sync Failed (${cnr})`, res.message || 'No live records found on eCourts Gateway.', false);

                }

                return { success: false, cnr };

            }

        })

        .catch(() => {

            if (!isBatch) {

                showToast(`Sync Error (${cnr})`, 'Network error querying eCourts Gateway.', false);

            }

            return { success: false, cnr };

        })

        .finally(() => {

            if (btn) {

                btn.disabled = false;

                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Synced';

                setTimeout(() => {

                    btn.innerHTML = origText || '<i class="bi bi-arrow-repeat"></i> Sync';

                }, 2500);

            }

        });

}



async function syncAllVisibleCnrs() {

    // 1. Strictly query visible, genuine NWKRTC corporation cases currently displayed on screen

    let visibleElements = Array.from(document.querySelectorAll('#livePartyCauselistTable tbody tr.live-causelist-row'))

        .filter(r => r.style.display !== 'none' && r.getAttribute('data-is-corp') === 'true');



    // Fallback to mobile cards if viewing on mobile viewport

    if (visibleElements.length === 0) {

        visibleElements = Array.from(document.querySelectorAll('.live-causelist-card'))

            .filter(c => c.style.display !== 'none' && c.getAttribute('data-is-corp') === 'true');

    }



    const seenCnrs = new Set();

    const validItems = [];

    visibleElements.forEach(el => {

        const cnr = (el.getAttribute('data-cnr') || '').trim().toUpperCase();

        const appealId = (el.getAttribute('data-appeal-id') || '').trim();

        const isCorp = el.getAttribute('data-is-corp') === 'true';



        // Must be a valid High Court CNR and verified NWKRTC matter

        if (cnr.length >= 14 && isCorp && !seenCnrs.has(cnr)) {

            seenCnrs.add(cnr);

            validItems.push({ appealId, cnr });

        }

    });



    const masterBtn = document.getElementById('btnSyncAll');

    

    if (validItems.length === 0) {

        showToast("CNR Sync", "No visible NWKRTC cases with linked CNR found to sync.", false);

        return;

    }



    const modeLabel = (currentViewMode === 'today') ? "Today's Listed" : "Visible";

    const confirmMsg = `Sync live e-Courts status for ${validItems.length} ${modeLabel} NWKRTC High Court case(s)?`;

    if (!confirm(confirmMsg)) {

        return;

    }



    // Safety limit to avoid exhausting NAPIX rate limits / hanging browser on thousands of items

    const maxBatch = 50;

    const itemsToSync = validItems.slice(0, maxBatch);

    if (validItems.length > maxBatch) {

        showToast("Batch Sync Cap", `Batching first ${maxBatch} of ${validItems.length} visible NWKRTC cases to protect e-Courts API quota.`, true);

    }



    let originalHtml = '';

    if (masterBtn) {

        originalHtml = masterBtn.innerHTML;

        masterBtn.disabled = true;

    }



    let successCount = 0;

    let failCount = 0;

    const total = itemsToSync.length;



    for (let i = 0; i < total; i++) {

        const item = itemsToSync[i];

        const appealId = item.appealId;

        const cnr = item.cnr;



        if (masterBtn) {

            masterBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Syncing ${i + 1} of ${total} NWKRTC...`;

        }



        try {

            const res = await syncSingleCnr(appealId, cnr, true);

            if (res && res.success) {

                successCount++;

            } else {

                failCount++;

            }

        } catch (e) {

            failCount++;

        }



        if (i < total - 1) {

            await new Promise(r => setTimeout(r, 600));

        }

    }



    if (masterBtn) {

        masterBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Sync Complete';

        setTimeout(() => {

            masterBtn.innerHTML = originalHtml;

            masterBtn.disabled = false;

        }, 3000);

    }



    if (failCount === 0) {

        showToast("Bulk Sync Completed", `All ${successCount} visible NWKRTC High Court cases synced successfully with live eCourts Gateway.`, true);

    } else {

        showToast("Bulk Sync Completed", `Synced ${successCount} of ${total} visible NWKRTC cases (${failCount} pending/offline).`, successCount > 0);

    }

}



