function filterLiveCauselistRows() {

    const partyInput = (document.getElementById('livePartySearchInput')?.value || '').trim().toLowerCase();

    const benchFilter = (document.getElementById('liveBenchId')?.value || 'ALL').trim();

    const causeListFilter = (document.getElementById('liveCauseListNo')?.value || 'ALL').trim();

    const allItems = window.__currentHcCauselistItems || [];



    const filtered = allItems.filter(item => {

        const pet = (item.petitionerName || '').toUpperCase();

        const resName = (item.respondentName || '').toUpperCase();

        const isCorp = item.nwkrtcRole === 'With NWKRTC' || item.nwkrtcRole === 'Against NWKRTC' ||

            (item.nwkrtcRole && item.nwkrtcRole.includes(defaultOrgShortName)) ||

            pet.includes('NWKRTC') || resName.includes('NWKRTC') ||

            pet.includes('NKWRTC') || resName.includes('NKWRTC') ||

            pet.includes('NWKSRTC') || resName.includes('NWKSRTC') ||

            pet.includes(defaultOrgShortName.toUpperCase()) || resName.includes(defaultOrgShortName.toUpperCase());



        if (!isCorp) return false;

        if (currentViewMode === 'today' && !item.isListedToday) return false;



        const caseNo = `${item.caseType || 'MFA'} ${item.regNumber || ''}/${item.regYear || ''}`.trim();

        const courtNo = item.courtHall || '';

        const itemCnr = (item.cnrNumber || '').trim();

        const stageText = item.caseStage || '';

        const searchTerms = `${pet} ${resName} ${caseNo} ${courtNo} ${itemCnr} ${stageText} ${item.matchedDesignation || ''} ${item.highCourtBench || ''}`.toLowerCase();



        let matchParty = true;

        if (partyInput && partyInput !== defaultOrgShortName.toLowerCase() && partyInput !== 'nwkrtc') {

            matchParty = searchTerms.includes(partyInput);

        }



        let matchBench = true;

        if (benchFilter !== 'ALL') {

            matchBench = searchTerms.includes(`court hall ${benchFilter.toLowerCase()}`) || searchTerms.includes(`bench #${benchFilter.toLowerCase()}`);

        }

        let matchCauseList = true;

        if (causeListFilter !== 'ALL') {

            const itemCl = (item.causeListNo || (item.causeListType ? item.causeListType.match(/\d+/)?.[0] : '') || (item.isListedToday ? '1' : '')).toString();

            matchCauseList = itemCl === causeListFilter || searchTerms.includes(`cause list no. ${causeListFilter}`) || searchTerms.includes(`cause list no : ${causeListFilter}`);

        }



        return matchParty && matchBench && matchCauseList;

    });



    window.__filteredHcCauselistItems = filtered;

    hcCurrentPage = 1;

    const visibleCount = filtered.length;



    const badge = document.getElementById('liveListBadge');

    if (badge) {

        const dateInputVal = document.getElementById('liveDate')?.value || '';

        if (currentViewMode === 'today') {

            badge.className = visibleCount > 0 ? "badge bg-danger px-3 py-1 shadow-sm" : "badge bg-secondary px-3 py-1";

            badge.textContent = `${visibleCount} ${defaultOrgShortName} Matter${visibleCount === 1 ? '' : 's'} Listed on ${dateInputVal}`;

        } else {

            badge.className = "badge bg-primary px-3 py-1 shadow-sm";

            badge.textContent = `${visibleCount} Active ${defaultOrgShortName} Matters Loaded`;

        }

    }



    const headerCount = document.getElementById('liveHeaderCount');

    if (headerCount) headerCount.textContent = visibleCount;



    const countVisEl = document.getElementById('exportCountVisible');

    if (countVisEl) countVisEl.textContent = visibleCount;



    if (currentViewMode === 'all' && (!partyInput || partyInput === defaultOrgShortName.toLowerCase() || partyInput === 'nwkrtc') && benchFilter === 'ALL') {

        const tabCountAll = document.getElementById('tabCountAll');

        if (tabCountAll) tabCountAll.textContent = visibleCount;

        const kpiTotal = document.getElementById('kpiTotalNwkrtcVal');

        if (kpiTotal) kpiTotal.textContent = visibleCount;

    }



    renderHcCauselistPage();

}



function renderHcCauselistPage() {

    const items = window.__filteredHcCauselistItems || [];

    const totalItems = items.length;

    const tbody = document.getElementById('liveTableBody');

    const cardsContainer = document.getElementById('liveCardsContainer');

    const paginationContainer = document.getElementById('livePaginationContainer');



    if (!tbody || !cardsContainer) return;



    if (totalItems === 0) {

        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted"><i class="bi bi-info-circle me-1"></i>No matching High Court cases found for the selected criteria.</td></tr>`;

        cardsContainer.innerHTML = `<div class="text-center py-4 text-muted small"><i class="bi bi-info-circle me-1"></i>No matching High Court cases found.</div>`;

        if (paginationContainer) paginationContainer.innerHTML = '';

        return;

    }



    const totalPages = hcPageSize === 'ALL' ? 1 : (Math.ceil(totalItems / hcPageSize) || 1);

    if (hcCurrentPage > totalPages) hcCurrentPage = totalPages;

    if (hcCurrentPage < 1) hcCurrentPage = 1;



    const startIndex = hcPageSize === 'ALL' ? 0 : (hcCurrentPage - 1) * hcPageSize;

    const endIndex = hcPageSize === 'ALL' ? totalItems : Math.min(startIndex + hcPageSize, totalItems);

    const pageItems = items.slice(startIndex, endIndex);



    const displayDate = window.__currentDisplayDate || '';

    const targetBench = window.__currentTargetBench || 'All Benches';

    const benchId = document.getElementById('liveBenchId')?.value || 'ALL';



    let desktopRowsHtml = '';

    let mobileCardsHtml = '';



    pageItems.forEach((item, idx) => {

        const sr = startIndex + idx + 1;

        const caseNo = `${item.caseType || 'MFA'} ${item.regNumber || ''}/${item.regYear || ''}`.trim();

        let rawCourtNo = item.courtHall || (benchId !== "ALL" ? `Court Hall ${benchId}` : (item.highCourtBench || 'Dharwad Bench'));
        let courtNo = rawCourtNo;
        if (courtNo && (courtNo.length > 35 || courtNo.includes('Cause List') || courtNo.includes('Sl.No'))) {
            const m = courtNo.match(/(?:COURT\s+HALL\s+(?:NO\s*)?:?\s*|Bench\s*#?)(\d+)/i);
            const slM = courtNo.match(/Serial\s+No\.?\s*(\d+(?:\.\d+)?)/i);
            if (m) {
