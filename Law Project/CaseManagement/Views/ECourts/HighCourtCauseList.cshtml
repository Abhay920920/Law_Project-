async function triggerLiveHighCourtScan() {
    const btn = document.getElementById('btnLiveBenchScan');
    const origHtml = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Scanning Benches...`;
    }

    const estCode = (document.getElementById('liveEstCode')?.value || 'KAHC02').trim();
    const dateInput = (document.getElementById('hearingDateInput')?.value || '').trim();

    try {
        const res = await fetch(`/ECourts/SyncDailyHighCourtCauseList?estCode=${encodeURIComponent(estCode)}&date=${encodeURIComponent(dateInput)}&force=true`, {
            method: 'POST'
        });
        const data = await res.json();
        if (data.success) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'Cause List Scan Complete',
                    html: `<b>${data.count} NWKRTC matters</b> successfully scanned across High Court sitting benches for <b>${data.date}</b>.`,
                    timer: 3000,
                    showConfirmButton: false
                });
            }
            fetchLiveHcCauselist();
        } else {
            alert('Scan notice: ' + (data.message || 'Error scanning cause list.'));
        }
    } catch (e) {
        console.error('Error triggering live scan:', e);
        fetchLiveHcCauselist();
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml;
        }
    }
}

function fetchLiveHcCauselist(viewMode) {

    if (viewMode !== undefined) currentViewMode = viewMode;

    const estCode = document.getElementById('liveEstCode')?.value || 'ALL';

    const dateInputVal = (document.getElementById('liveDate')?.value || '').trim();

    const benchId = document.getElementById('liveBenchId')?.value || 'ALL';

    const partyName = (document.getElementById('livePartySearchInput')?.value || defaultOrgShortName).trim();

    const container = document.getElementById('liveCauselistContainer');

    const badge = document.getElementById('liveListBadge');



    if (badge) {

        badge.className = "badge bg-warning text-dark px-3 py-1";

        badge.textContent = "Loading High Court Cases...";

    }



    if (container) {

        container.innerHTML = `<div class="text-center py-5">

            <div class="spinner-border text-danger" role="status"></div>

            <p class="mt-2 text-muted fw-bold">Fetching High Court cases for '<strong>${partyName || defaultOrgShortName}</strong>'...</p>

            <p class="extra-small text-muted mb-0">Cross-referencing Dharwad, Bengaluru, and Kalaburagi rosters...</p>

        </div>`;

    }



    let targetBench = "";

    if (estCode === "KAHC01") targetBench = "Bengaluru";

    else if (estCode === "KAHC02") targetBench = "Dharwad";

    else if (estCode === "KAHC03") targetBench = "Kalaburagi";

    else targetBench = "All Benches";



    const regYear = document.getElementById('liveRegYear')?.value || 'RECENT';

    const caseStatus = document.getElementById('liveCaseStatus')?.value || 'P';

    // Always fetch full roster (todayOnly=false) so both all matters and scheduled tabs are populated without network lag
    const partyUrl = `/ECourts/GetLiveHighCourtPartyCases?estCode=${encodeURIComponent(estCode)}&partyName=${encodeURIComponent(partyName || defaultOrgShortName)}&regYear=${encodeURIComponent(regYear)}&pendDisp=${encodeURIComponent(caseStatus)}&hearingDate=${encodeURIComponent(dateInputVal)}&todayOnly=false&multiAlias=true`;



    fetch(partyUrl)

        .then(r => r.json())

        .then(res => {

            if (res && res.success) {

                // Update live KPI cards

                const kpiToday = document.getElementById('kpiListedTodayVal');

                const kpiTotal = document.getElementById('kpiTotalNwkrtcVal');

                const kpiWith = document.getElementById('kpiWithNwkrtcVal');

                const kpiAgainst = document.getElementById('kpiAgainstNwkrtcVal');

                if (kpiToday && res.todayCount !== undefined) kpiToday.textContent = res.todayCount;

                if (kpiTotal) {

                    const totalLoaded = res.allCount !== undefined ? res.allCount : (res.count !== undefined ? res.count : ((res.withCount || 0) + (res.againstCount || 0)));

                    kpiTotal.textContent = totalLoaded;

                }

                if (kpiWith && res.withCount !== undefined) kpiWith.textContent = res.withCount;

                if (kpiAgainst && res.againstCount !== undefined) kpiAgainst.textContent = res.againstCount;

                window.__allHcCauselistItems = res.allMatters || res.data || [];
                window.__serverRes = res;

                if (window.__allHcCauselistItems.length > 0) {

                    renderLivePartyCauseList(window.__allHcCauselistItems, dateInputVal, targetBench, container, badge, res);

                } else {

                    renderNoCasesListedTodayView(dateInputVal, targetBench, container, badge, partyName, res);

                }

            } else {

                renderNoCasesListedTodayView(dateInputVal, targetBench, container, badge, partyName, null);

            }

        })

        .catch(() => {

            renderNoCasesListedTodayView(dateInputVal, targetBench, container, badge, partyName, null);

        });

}



