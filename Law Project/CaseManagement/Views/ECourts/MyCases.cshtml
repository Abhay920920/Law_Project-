                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-info btn-sm px-2.5" title="Daily Proceedings & Hearing Date Analysis" onclick="openDailyProceedingsModal(${c.trackedID})">
                        <i class="bi bi-journal-text me-1"></i><span class="d-none d-xl-inline">Proceedings</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm px-2" title="Check Live High Court Cause List & Court Hall" id="btnCl_${c.trackedID}" onclick="checkLiveCauseList(${c.trackedID}, '${c.cnrNumber}')">
                        <i class="bi bi-broadcast"></i>
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm px-2.5 py-1" title="View Full Case Dossier" onclick="openCaseDossier(${c.trackedID})">
                        <i class="bi bi-file-earmark-medical me-1"></i> Dossier
                    </button>
                    <button type="button" class="btn btn-outline-dark btn-sm px-2" title="Print Case Dossier" onclick="printSingleCase(${c.trackedID})">
                        <i class="bi bi-printer"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-2" title="Reassign Case Worker" onclick="openReassignModal(${c.trackedID}, '${c.cnrNumber}', '${escapeJs(workerName)}')">
                        <i class="bi bi-person-gear"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-2" title="Sync live with eCourts" id="btnSync_${c.trackedID}" onclick="syncCaseLive(${c.trackedID})">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm px-2" title="Remove from My Cases" onclick="removeCase(${c.trackedID}, '${c.cnrNumber}')">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
        
        <!-- Expandable Hearing History & Daily Status Drawer Row -->
        <tr id="drawer_row_${c.trackedID}" class="d-none bg-light bg-opacity-75 border-start border-4 border-primary hearing-drawer-row ${groupClass ? `group-row-${groupClass}` : ''}">
            <td colspan="9" class="p-3 ps-4 pe-4">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                    <div class="card-header bg-dark text-white py-2.5 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark font-monospace fw-bold">${escapeHtml(getDisplayCaseType(c))}</span>
                            <span class="font-monospace fw-bold text-white small">${escapeHtml(c.cnrNumber)}</span>
                            <span class="badge ${isTodayListed ? 'bg-danger text-white' : (isTomorrowListed ? 'bg-warning text-dark' : 'bg-primary-subtle text-primary')} extra-small">
                                ${escapeHtml(c.hearingUrgency || 'SCHEDULED')}
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-xs btn-outline-light rounded-pill px-2.5 py-1 extra-small" onclick="openDailyProceedingsModal(${c.trackedID})">
                                <i class="bi bi-journal-text me-1"></i>Full Roznama Timeline
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-light rounded-pill px-2.5 py-1 extra-small" onclick="openCaseDossier(${c.trackedID})">
                                <i class="bi bi-file-earmark-medical me-1"></i>Full Dossier
                            </button>
                            <button type="button" class="btn btn-xs btn-link text-white p-0 text-decoration-none ms-1" onclick="toggleHearingDrawer(${c.trackedID})" title="Close Drawer">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <!-- Column 1: Daily Status & Court Listing -->
                            <div class="col-12 col-md-4 border-end-md">
                                <div class="extra-small text-uppercase fw-bold text-primary mb-1">
                                    <i class="bi bi-broadcast me-1"></i>Daily Status & Court Listing
                                </div>
                                <div class="p-2.5 rounded-3 bg-light border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">Court Hall:</span>
                                        <span class="badge bg-warning-subtle text-dark border border-warning font-monospace fw-bold">${escapeHtml(c.courtNo || 'Awaited')}</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">Serial / Item #:</span>
                                        <span class="font-monospace fw-bold text-dark small">${c.itemNo ? escapeHtml(c.itemNo) : '—'}</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">Bench Roster:</span>
                                        <span class="extra-small fw-semibold text-truncate" style="max-width: 170px;" title="${escapeHtml(c.benchName || '')}">${escapeHtml(c.benchName || (isHc ? 'Single Bench' : 'Court'))}</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">Coram / Judge:</span>
                                        <span class="extra-small fw-semibold text-truncate text-secondary" style="max-width: 170px;" title="${escapeHtml(c.judgeDesignation || '')}">${escapeHtml(c.judgeDesignation || 'Hon\'ble Court')}</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                        <span class="extra-small text-muted">Next Listing Date:</span>
                                        <span class="font-monospace fw-bold ${c.nextHearingDate ? 'text-primary' : 'text-muted'}">${c.nextHearingDate ? c.nextHearingDate.split('T')[0] : 'Date Awaited'}</span>
                                    </div>
                                    <div class="extra-small text-dark fw-semibold mt-1 text-truncate" title="${escapeHtml(c.stagePurpose || '')}">
                                        <i class="bi bi-bookmark-fill text-warning me-1"></i>Stage: ${escapeHtml(c.stagePurpose || 'Regular Listing')}
                                    </div>
                                </div>
                            </div>

                            <!-- Column 2: Last Concluded Proceeding & Roznama -->
                            <div class="col-12 col-md-5 border-end-md">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="extra-small text-uppercase fw-bold text-success">
                                        <i class="bi bi-file-earmark-text me-1"></i>Last Concluded Proceeding (Roznama)
                                    </span>
                                    <span class="extra-small text-muted">${c.daysSinceLastHearing != null ? c.daysSinceLastHearing + ' days ago' : ''}</span>
                                </div>
                                <div class="p-2.5 rounded-3 bg-light border h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                                            <span class="extra-small text-muted">Listing Date: <strong class="text-dark font-monospace">${escapeHtml(c.lastHearingDate || '—')}</strong></span>
                                            <span class="extra-small text-muted">Coram: <strong class="text-dark text-truncate" style="max-width: 120px;">${escapeHtml(c.lastHearingJudge || '—')}</strong></span>
                                        </div>
                                        <div class="p-2 bg-white rounded border text-dark font-monospace extra-small" style="max-height: 85px; overflow-y: auto; line-height: 1.4;">
                                            ${lastBiz ? escapeHtml(lastBiz) : '<span class="text-muted fst-italic">No offline roznama text stored. Click below to query live from eCourts.</span>'}
                                        </div>
                                    </div>
                                    <div class="mt-2 d-flex justify-content-between align-items-center">
                                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 extra-small"
                                                onclick="fetchLiveHearingRoznama('${escapeJs(c.cnrNumber)}', '${escapeJs(c.lastHearingDate || '')}', ${isHc}, null)">
                                            <i class="bi bi-broadcast me-1"></i>Fetch Live Roznama
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1 extra-small"
                                                onclick="openDailyProceedingsModal(${c.trackedID})">
                                            All ${c.totalHearings || 0} Proceedings &raquo;
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Column 3: Hearing Velocity & Recent Hearings -->
                            <div class="col-12 col-md-3">
                                <div class="extra-small text-uppercase fw-bold text-dark mb-1">
                                    <i class="bi bi-clock-history me-1 text-info"></i>Hearing Velocity & Timeline
                                </div>
                                <div class="p-2.5 rounded-3 bg-light border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">Total Hearings:</span>
                                        <span class="badge bg-info text-dark font-monospace fw-bold">${c.totalHearings || 0} Listed</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">Avg Interval:</span>
                                        <span class="extra-small fw-bold text-dark">${c.avgDaysBetweenHearings ? `~${c.avgDaysBetweenHearings} days` : '—'}</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted">First Listed:</span>
                                        <span class="extra-small font-monospace text-secondary">${escapeHtml(c.firstHearingDate || '—')}</span>
                                    </div>
                                    <div class="mt-2 pt-1 border-top">
                                        <span class="extra-small fw-bold text-muted text-uppercase">Recent Hearings:</span>
                                        ${recentHearingsSnippet}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </td>
        </tr>`;
    }

    // ==========================================
    // Toggle Inline Hearing Drawer
    // ==========================================
    function toggleHearingDrawer(trackedId) {
        const row = document.getElementById(`drawer_row_${trackedId}`);
        const icon = document.getElementById(`drawer_icon_${trackedId}`);
        if (!row) return;
        if (row.classList.contains("d-none")) {
            row.classList.remove("d-none");
            if (icon) icon.className = "bi bi-chevron-down fs-6 fw-bold text-primary";
        } else {
            row.classList.add("d-none");
            if (icon) icon.className = "bi bi-chevron-right fs-6 fw-bold text-secondary";
        }
    }

    // ==========================================
    // Toggle Mobile In-Card Hearing Drawer
    // ==========================================
    function toggleMobileCardDrawer(trackedId) {
        const drawer = document.getElementById(`mobile_drawer_${trackedId}`);
        const icon = document.getElementById(`mobile_drawer_icon_${trackedId}`);
        if (!drawer) return;
        if (drawer.classList.contains("d-none")) {
            drawer.classList.remove("d-none");
            if (icon) icon.className = "bi bi-chevron-up extra-small text-primary";
        } else {
            drawer.classList.add("d-none");
            if (icon) icon.className = "bi bi-chevron-down extra-small text-muted";
        }
    }

    // ==========================================
    // Render Mobile Case Card HTML Helper (Zero Data Loss)
    // ==========================================
    function renderCaseMobileCardHtml(c, index) {
        const isHc = (c.cnrNumber || "").startsWith("HC") || (c.cnrNumber && c.cnrNumber.length >= 4 && c.cnrNumber.substring(2, 4).toUpperCase() === "HC");
        const courtTierBadge = isHc 
            ? `<span class="badge bg-primary-subtle text-primary border border-primary extra-small">High Court</span>` 
            : `<span class="badge bg-secondary-subtle text-dark border extra-small">District / Lower</span>`;

        const st = (c.caseStatus || "").toLowerCase();
        const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
        const statusBadge = isDisposed
            ? `<span class="badge bg-success text-white extra-small"><i class="bi bi-check-circle-fill me-1"></i>Disposed</span>`
            : `<span class="badge bg-warning-subtle text-dark border border-warning extra-small"><i class="bi bi-hourglass-split me-1"></i>${escapeHtml(c.caseStatus || "—")}</span>`;

        const todayStr = new Date().toISOString().split('T')[0];

        // Urgency Analysis formatting & border accent
        let urgencyBadge = "";
        let urgencyBorderClass = "border-urgency-default";
        if (c.hearingUrgency === "TODAY") {
            urgencyBadge = `<span class="badge bg-danger text-white extra-small px-1.5 py-0.5"><i class="bi bi-fire me-0.5"></i>TODAY</span>`;
            urgencyBorderClass = "border-urgency-today";
        } else if (c.hearingUrgency === "TOMORROW") {
            urgencyBadge = `<span class="badge bg-warning text-dark extra-small px-1.5 py-0.5"><i class="bi bi-lightning-fill me-0.5"></i>TOMORROW</span>`;
            urgencyBorderClass = "border-urgency-tomorrow";
        } else if (c.hearingUrgency === "THIS_WEEK") {
            urgencyBadge = `<span class="badge bg-primary-subtle text-primary border border-primary extra-small px-1.5 py-0.5">${c.daysToNextHearing}d left</span>`;
            urgencyBorderClass = "border-urgency-upcoming";
        } else if (c.hearingUrgency === "OVERDUE") {
            urgencyBadge = `<span class="badge bg-danger-subtle text-danger border border-danger extra-small px-1.5 py-0.5">${Math.abs(c.daysToNextHearing)}d overdue</span>`;
            urgencyBorderClass = "border-urgency-overdue";
        } else if (isDisposed) {
            urgencyBorderClass = "border-urgency-disposed";
        }

        let hearingDisplay = "";
        if (c.nextHearingDate) {
            const dt = new Date(c.nextHearingDate);
            const yr = dt.getFullYear();
            if (yr > 1990 && yr < 2090) {
                const dtFormatted = dt.toLocaleDateString("en-GB", { day: '2-digit', month: 'short', year: 'numeric' });
                const isUpcoming = dt.toISOString().split('T')[0] >= todayStr;
                hearingDisplay = `
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-1">
                        <span class="fw-bold ${isUpcoming ? "text-primary" : "text-danger"} fs-6">
                            <i class="bi bi-calendar-event me-1"></i>${dtFormatted}
                        </span>
                        ${urgencyBadge}
                    </div>
                    <div class="extra-small text-dark fw-semibold mt-1">
                        <i class="bi bi-bookmark-star text-secondary me-1"></i>Stage: ${escapeHtml(c.stagePurpose || "—")}
                    </div>`;
            }
        }
        if (!hearingDisplay) {
            hearingDisplay = `
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-1">
                    <span class="fw-semibold text-secondary"><i class="bi bi-hourglass-split me-1"></i>Date Awaited</span>
                </div>
                <div class="extra-small text-muted mt-1">
                    <i class="bi bi-bookmark-star me-1"></i>Stage: ${escapeHtml(c.stagePurpose || "—")}
                </div>`;
        }

        // Last synced formatting
        let syncedStr = "—";
        if (c.lastSyncedAt) {
            const sDt = new Date(c.lastSyncedAt);
            syncedStr = sDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' ' + sDt.toLocaleDateString("en-GB", { day: '2-digit', month: 'short' });
        }

        const workerName = c.addedBy || "Central Office";
        const lastBiz = (c.lastProceeding || "").trim();

        // Build recent hearings snippet
        let recentHearingsSnippet = "";
        if (c.proceedingsHistory && Array.isArray(c.proceedingsHistory) && c.proceedingsHistory.length > 0) {
            const recent = c.proceedingsHistory.slice(0, 3);
            recentHearingsSnippet = `<div class="d-flex flex-column gap-1.5 mt-1">` + recent.map(rh => {
                const rDt = rh.hearing_date || rh.business_date || rh.next_date || "—";
                const rPurp = rh.purpose_of_listing || rh.purpose || rh.next_purpose || rh.stage || "Listing";
                const rBiz = (rh.business || rh.roznama || rh.proceeding || "").trim();
                return `
                <div class="extra-small p-2 bg-white rounded border d-flex justify-content-between align-items-center gap-1.5">
                    <span class="font-monospace fw-bold text-primary">${escapeHtml(rDt)}</span>
                    <span class="text-truncate text-dark fw-semibold" style="max-width: 140px;" title="${escapeHtml(rPurp)}">${escapeHtml(rPurp)}</span>
                    ${rBiz ? '<span class="badge bg-success-subtle text-success extra-small border border-success" title="' + escapeHtml(rBiz) + '">Roznama</span>' : ''}
                </div>`;
            }).join("") + `</div>`;
        } else {
            recentHearingsSnippet = `<div class="extra-small text-muted fst-italic mt-1">No earlier proceedings recorded in eCourts dossier.</div>`;
        }

        return `
        <div class="mobile-case-card mb-3 shadow-sm ${urgencyBorderClass}" id="mcard_${c.trackedID}">
            <!-- Card Header: Index, Case Type & Number, Status -->
            <div class="mobile-card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                    <span class="badge bg-secondary text-white rounded-pill extra-small">#${index}</span>
                    <span class="badge bg-primary font-monospace fw-bold">${escapeHtml(getDisplayCaseType(c))}</span>
                    <span class="fw-bold text-dark font-monospace">${escapeHtml(c.caseNumber || "")}${c.caseYear ? "/" + c.caseYear : ""}</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    ${courtTierBadge}
                    ${statusBadge}
                </div>
            </div>

            <!-- Card Body: CNR, Court Hall, Parties, Hearing, Worker -->
            <div class="mobile-card-body">
                <!-- CNR with 1-touch copy -->
                <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded-3 border mb-2">
                    <div class="d-flex align-items-center gap-1.5">
                        <i class="bi bi-hash text-muted"></i>
                        <span class="font-monospace fw-bold text-dark fs-6">${escapeHtml(c.cnrNumber)}</span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary py-1 px-2.5 rounded-pill extra-small d-flex align-items-center gap-1" onclick="copyToClipboard('${c.cnrNumber}')" title="Copy CNR">
                        <i class="bi bi-clipboard"></i>
                        <span>Copy</span>
                    </button>
                </div>

                <!-- Court Hall, Bench & Judge -->
                <div class="mb-2">
                    <div class="fw-bold text-dark small d-flex align-items-center gap-1 text-truncate">
                        <i class="bi bi-building text-primary"></i>
                        <span>${escapeHtml(c.courtEstName || c.estCode || 'Court')}</span>
                    </div>
                    <div class="d-flex align-items-center gap-1.5 flex-wrap my-1">
                        ${(c.courtNo && (c.courtNo.toLowerCase().includes("court hall") || /^\d+$/.test(c.courtNo.trim()))) ? `
                        <span class="badge bg-warning-subtle text-dark border border-warning font-monospace fw-bold">
                            <i class="bi bi-bank2 me-1"></i>${escapeHtml(c.courtNo)}
                        </span>` : ''}
                        ${(c.itemNo && c.itemNo !== '—') ? `<span class="badge bg-primary text-white font-monospace extra-small fw-bold"><i class="bi bi-list-ol me-1"></i>${c.itemNo.toString().startsWith('Item') || c.itemNo.toString().startsWith('Sl') ? escapeHtml(c.itemNo) : `Item #${escapeHtml(c.itemNo)}`}</span>` : ''}
                        ${c.benchId ? `<span class="badge bg-info-subtle text-info border border-info font-monospace extra-small"><i class="bi bi-hash"></i>Bench ${escapeHtml(c.benchId)}</span>` : ''}
                        <span class="badge bg-light text-dark border extra-small">${escapeHtml(c.benchName || (!c.courtNo?.toLowerCase().includes("court hall") ? c.courtNo : '') || (isHc ? "Single Bench" : "Court"))}</span>
                    </div>
                    <div class="extra-small text-muted text-truncate">
                        <i class="bi bi-person-lines-fill me-1"></i>Coram: ${escapeHtml(c.judgeDesignation || "—")}
                    </div>
                </div>

                <!-- Parties: Petitioner vs Respondent -->
                <div class="p-2.5 rounded-3 bg-light border mb-2">
                    <div class="fw-bold text-dark small text-truncate" title="${escapeHtml(c.petitioner || '')}">
                        <span class="text-primary me-1 fw-bold">P:</span>${escapeHtml(c.petitioner || "—")}
                    </div>
                    <div class="text-muted extra-small text-truncate mt-1" title="${escapeHtml(c.respondent || '')}">
                        <span class="text-danger me-1 fw-bold">R:</span>vs ${escapeHtml(c.respondent || "—")}
                    </div>
                </div>

                <!-- Next Hearing Date & Stage -->
                <div class="p-2.5 rounded-3 border bg-white mb-2 shadow-xs">
                    ${hearingDisplay}
                </div>

                <!-- Case Worker & Sync Metadata -->
                <div class="d-flex justify-content-between align-items-center extra-small text-muted pt-1 border-top">
                    <span class="badge bg-light text-dark border py-1 px-2" title="Assigned Case Worker">
                        <i class="bi bi-person-fill text-primary me-1"></i>${escapeHtml(workerName)}
                    </span>
                    <span><i class="bi bi-arrow-repeat me-1"></i>${syncedStr}</span>
                </div>

                <!-- In-Card Hearing Drawer Toggle -->
                <button type="button" class="btn btn-sm btn-link text-decoration-none text-secondary p-0 extra-small mt-2 d-flex align-items-center justify-content-between w-100" onclick="toggleMobileCardDrawer(${c.trackedID})">
                    <span class="fw-semibold"><i class="bi bi-journal-text text-primary me-1"></i>Roznama Preview &amp; History (${c.totalHearings || 0})</span>
                    <i class="bi bi-chevron-down extra-small" id="mobile_drawer_icon_${c.trackedID}"></i>
                </button>

                <!-- In-Card Expandable Roznama Drawer -->
                <div class="mobile-card-drawer d-none mt-2" id="mobile_drawer_${c.trackedID}">
                    <div class="extra-small text-uppercase fw-bold text-primary mb-1">
                        <i class="bi bi-broadcast me-1"></i>Latest Roznama / Order
                    </div>
                    <div class="p-2 bg-white rounded border text-dark font-monospace extra-small mb-2" style="max-height: 90px; overflow-y: auto; line-height: 1.4;">
                        ${lastBiz ? escapeHtml(lastBiz) : '<span class="text-muted fst-italic">No offline roznama text stored. Click below to query live from eCourts.</span>'}
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 extra-small"
                                onclick="fetchLiveHearingRoznama('${escapeJs(c.cnrNumber)}', '${escapeJs(c.lastHearingDate || '')}', ${isHc}, null)">
                            <i class="bi bi-broadcast me-1"></i>Fetch Live
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1 extra-small"
                                onclick="openDailyProceedingsModal(${c.trackedID})">
                            All ${c.totalHearings || 0} Proceedings &raquo;
                        </button>
                    </div>
                    <div class="extra-small fw-bold text-muted text-uppercase mb-1">Recent Hearings:</div>
                    ${recentHearingsSnippet}
                </div>
            </div>

            <!-- Card Footer: Mobile Touch Actions (>= 44px tap area) -->
            <div class="mobile-card-footer">
                <div class="d-flex align-items-center gap-1.5">
                    <button type="button" class="btn btn-sm btn-info text-white mobile-action-btn shadow-xs" onclick="openDailyProceedingsModal(${c.trackedID})" title="Daily Proceedings &amp; Roznama Timeline">
                        <i class="bi bi-journal-text me-1"></i>Roznamas
                    </button>
                    <button type="button" class="btn btn-sm btn-primary mobile-action-btn shadow-xs" onclick="openCaseDossier(${c.trackedID})" title="View Full Case Dossier">
                        <i class="bi bi-file-earmark-medical me-1"></i>Dossier
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger mobile-action-btn shadow-xs" id="mbtnCl_${c.trackedID}" onclick="checkLiveCauseList(${c.trackedID}, '${c.cnrNumber}')" title="Check Live High Court Cause List">
                        <i class="bi bi-broadcast me-1"></i>Cause List
                    </button>
                    <!-- 3-Dots More Options Menu -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary mobile-action-btn px-2.5 dropdown-toggle dropdown-toggle-split" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More Case Actions">
                            <i class="bi bi-three-dots-vertical"></i>
