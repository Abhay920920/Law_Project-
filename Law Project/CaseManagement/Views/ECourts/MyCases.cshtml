    async function syncAllCauseLists() {
        showToast("Live Cause List Sync", "Querying today's cause lists across Dharwad, Bengaluru & Kalaburagi benches...", true);

        try {
            const res = await fetch(`/ECourts/SyncCauseListForTrackedCases?module=${encodeURIComponent(currentModule)}`, { method: "POST" });
            const json = await res.json();

            if (json.success) {
                showToast("Cause List Sync Complete", json.message || `Checked ${json.totalCasesChecked} cases: ${json.totalMatches} matched on live roster.`, true);
                loadTrackedCases();
            } else {
                showToast("Sync Notice", json.message || "Failed to sync cause lists.", false);
            }
        } catch (err) {
            showToast("Sync Error", "Network error while connecting to cause list gateway.", false);
        }
    }

    function renderCauseListDetailsCard(res, dateStr, cnr) {
        if (!res || !res.success) {
            return `
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-exclamation-circle-fill fs-5 text-warning"></i>
                    <div>
                        <div class="fw-bold">Notice from eCourts Cause List Gateway</div>
                        <div class="small">${res?.message || 'No cause list records returned.'}</div>
                    </div>
                </div>`;
        }

        if (res.isListed && res.data) {
            const d = res.data;
