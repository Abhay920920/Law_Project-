        document.getElementById("dossierModalTitle").innerText = `${displayType ? displayType + " " : ""}${data.case_number || ""} — Dossier`;
        document.getElementById("dossierCnrBadge").innerText = `CNR: ${cnr}`;

        const isDisposed = (data.case_status || "").toLowerCase().includes("dispos");
        const statusBadge = document.getElementById("dossierStatusBadge");
        statusBadge.className = isDisposed ? "badge bg-success" : "badge bg-warning text-dark";
        statusBadge.innerText = data.case_status || "—";

        document.getElementById("dossierSubtitle").innerText = `${data.establishment_name || raw.court_est_name || "—"} — Live NAPIX Sync: ${dossier.synced_at || "Recent"}`;

        // Overview
        document.getElementById("dCaseNo").innerText = `${displayType ? displayType + " " : ""}${data.case_number || "—"}`;
        document.getElementById("dFilNo").innerText = raw.fil_no ? `${raw.fil_no}/${raw.fil_year || ""}` : (data.filing_date || "—");
        document.getElementById("dFilDate").innerText = data.filing_date || raw.date_of_filing || "—";
        document.getElementById("dRegDate").innerText = data.registration_date || raw.dt_regis || "—";

