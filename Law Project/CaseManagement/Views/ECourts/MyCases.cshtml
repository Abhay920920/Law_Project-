@{
    string module = ViewBag.Module ?? "MVC";
    bool isLabour = ViewBag.IsLabour ?? false;
    ViewData["Title"] = isLabour ? "Labour - My Cases & Live CNR Tracker" : "MVC - My Cases & Live CNR Tracker";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .mycases-page {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .mycases-header-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
        color: #fff;
        border-radius: 12px;
    }
    .kpi-card-clean {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .kpi-card-clean:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;
    }
    .status-filter-group .btn-check:checked + label {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
        color: #ffffff !important;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
    }
    .status-filter-group label {
        color: #475569;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }
    .status-filter-group label:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }
    .table-cases thead th {
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        font-weight: 700;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding-top: 12px;
        padding-bottom: 12px;
    }
    .table-cases tbody tr:hover {
        background-color: #f8fafc;
    }
    .spin-animation {
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="mycases-page px-3 px-md-4 py-3">

    <!-- Header Banner -->
    <div class="mycases-header-gradient p-4 mb-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge @(isLabour ? "bg-purple text-white" : "bg-primary text-white") font-monospace fw-bold px-2.5 py-1">
                    <i class="bi @(isLabour ? "bi-briefcase-fill" : "bi-truck-front-fill") me-1"></i>@(isLabour ? "LABOUR DISPUTES" : "MVC / MACT CLAIMS")
                </span>
                <span class="badge bg-danger text-white font-monospace fw-bold px-2.5 py-1">
                    <i class="bi bi-broadcast me-1"></i>LIVE E-COURTS GATEWAY
                </span>
            </div>
            <h3 class="fw-bold mb-1 text-white d-flex align-items-center gap-2">
                <i class="bi bi-folder-check text-warning"></i> My Cases & Live CNR Tracker
            </h3>
            <p class="text-light text-opacity-75 small mb-0">Central Office Registry — High-fidelity live CNR monitoring, automated proceedings sync, orders & judgements.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-warning btn-sm fw-bold shadow-sm px-3 py-2 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addCnrModal">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add CNR Cases</span>
            </button>
            <button type="button" class="btn btn-danger btn-sm shadow-sm px-3 py-2 d-flex align-items-center gap-2 fw-semibold" onclick="syncAllCauseLists()" title="Query live High Court cause lists for today across Dharwad, Bengaluru, Kalaburagi">
                <i class="bi bi-broadcast"></i>
                <span class="d-none d-sm-inline">Check Live Cause Lists</span>
            </button>
            <button type="button" class="btn btn-outline-light btn-sm px-3 py-2 d-flex align-items-center gap-2" onclick="printCasesReport('filtered')" title="Print judicial report of current cases">
                <i class="bi bi-printer-fill"></i>
                <span class="d-none d-sm-inline">Print Report</span>
            </button>
            <button type="button" class="btn btn-outline-light btn-sm px-3 py-2 d-flex align-items-center gap-2" onclick="loadTrackedCases(true)" title="Refresh table data">
                <i class="bi bi-arrow-clockwise" id="refreshBtnIcon"></i>
                <span class="d-none d-sm-inline">Refresh</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('all')" title="Filter: All Cases">
            <div class="card border-0 shadow-sm border-start border-4 border-primary bg-white kpi-card-clean h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Tracked Cases</span>
                            <h2 class="fw-bold text-primary mb-0 mt-1" id="statTotalCases">0</h2>
                        </div>
                        <div class="bg-primary-subtle p-3 rounded-3 text-primary">
                            <i class="bi bi-folder-check fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('upcoming')" title="Filter: Upcoming Hearings">
            <div class="card border-0 shadow-sm border-start border-4 border-warning bg-white kpi-card-clean h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Upcoming Hearings</span>
                            <h2 class="fw-bold text-warning mb-0 mt-1" id="statUpcomingHearings">0</h2>
                        </div>
                        <div class="bg-warning-subtle p-3 rounded-3 text-warning">
                            <i class="bi bi-calendar-event fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('pending')" title="Filter: Active / Pending Cases">
            <div class="card border-0 shadow-sm border-start border-4 border-info bg-white kpi-card-clean h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Active / Pending</span>
                            <h2 class="fw-bold text-info mb-0 mt-1" id="statPendingCases">0</h2>
                        </div>
                        <div class="bg-info-subtle p-3 rounded-3 text-info">
                            <i class="bi bi-hourglass-split fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('disposed')" title="Filter: Disposed Cases">
            <div class="card border-0 shadow-sm border-start border-4 border-success bg-white kpi-card-clean h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Disposed Cases</span>
                            <h2 class="fw-bold text-success mb-0 mt-1" id="statDisposedCases">0</h2>
                        </div>
                        <div class="bg-success-subtle p-3 rounded-3 text-success">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Filter and Search Header -->
        <div class="card-header bg-white border-bottom p-3 p-md-4">
            <!-- Row 1: Search & Status Pills -->
            <div class="row g-3 align-items-center justify-content-between mb-3">
                <div class="col-12 col-lg-5">
                    <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                        <span class="input-group-text bg-light border-0 text-muted ps-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="caseSearchInput" class="form-control bg-light border-0 py-2" 
                               placeholder="Search by CNR, Case No, Petitioner, Respondent, Judge..." oninput="filterCasesTable()" />
                    </div>
                </div>

                <div class="col-12 col-lg-7 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
                    <!-- Status Filter Pills -->
                    <div class="btn-group p-1 bg-light rounded-pill border status-filter-group" role="group">
                        <input type="radio" class="btn-check" name="statusFilter" id="filterAll" value="all" checked onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-3 py-1.5" for="filterAll">All (<span id="countPillAll">0</span>)</label>

                        <input type="radio" class="btn-check" name="statusFilter" id="filterUpcoming" value="upcoming" onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-3 py-1.5" for="filterUpcoming">Listed / Future (<span id="countPillUpcoming">0</span>)</label>

                        <input type="radio" class="btn-check" name="statusFilter" id="filterPending" value="pending" onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-3 py-1.5" for="filterPending">Pending (<span id="countPillPending">0</span>)</label>

                        <input type="radio" class="btn-check" name="statusFilter" id="filterDisposed" value="disposed" onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-3 py-1.5" for="filterDisposed">Disposed (<span id="countPillDisposed">0</span>)</label>
                    </div>

                    <!-- Print Dropdown Button -->
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 shadow-sm dropdown-toggle d-flex align-items-center gap-1.5" data-bs-toggle="dropdown" aria-expanded="false" title="Print Judicial Cases Report">
                            <i class="bi bi-printer-fill text-primary"></i>
                            <span>Print Report</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2" style="min-width: 230px;">
                            <li>
                                <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="printCasesReport('filtered')">
                                    <i class="bi bi-funnel-fill text-primary fs-6"></i>
                                    <div>
                                        <div class="fw-bold">Print Current View</div>
                                        <div class="extra-small text-muted">Filtered cases matching current filters</div>
                                    </div>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="printCasesReport('all')">
                                    <i class="bi bi-collection-fill text-success fs-6"></i>
                                    <div>
                                        <div class="fw-bold">Print All Cases</div>
                                        <div class="extra-small text-muted">Complete master tracking register</div>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 shadow-sm" onclick="exportToCsv()">
                        <i class="bi bi-download me-1"></i> Export CSV
                    </button>
                </div>
            </div>

            <!-- Row 2: Hearing Date Filter Toolbar -->
            <div class="bg-light bg-opacity-75 p-2.5 px-3 rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-2.5">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="small fw-bold text-dark d-flex align-items-center gap-1.5 text-nowrap">
                        <i class="bi bi-calendar-event-fill text-primary fs-6"></i>
                        <span>Hearing Date:</span>
                    </span>

                    <!-- Quick Preset Select -->
                    <select id="hearingDatePreset" class="form-select form-select-sm rounded-pill border-secondary-subtle px-3 py-1 fw-semibold text-dark shadow-sm" style="width: auto; min-width: 175px;" onchange="onHearingPresetChange()">
                        <option value="all">All Hearing Dates</option>
                        <option value="today">📅 Listed Today</option>
                        <option value="tomorrow">📅 Listed Tomorrow</option>
                        <option value="this_week">🗓 Next 7 Days</option>
                        <option value="this_month">🗓 Next 30 Days</option>
                        <option value="overdue">⚠️ Past / Overdue</option>
                        <option value="unscheduled">⏳ Date Pending</option>
                        <option value="custom">🔍 Custom Date Range...</option>
                    </select>

                    <!-- From & To Date Pickers -->
                    <div class="d-flex align-items-center gap-1.5" id="customDateRangeInputs">
                        <span class="extra-small text-muted text-uppercase fw-semibold">From:</span>
                        <input type="date" id="hearingDateFrom" class="form-control form-control-sm rounded-pill px-2.5 py-1 text-dark bg-white border" style="width: 135px;" onchange="onCustomDateInputChanged()" title="From hearing date" />
                        
                        <span class="extra-small text-muted text-uppercase fw-semibold ms-1">To:</span>
                        <input type="date" id="hearingDateTo" class="form-control form-control-sm rounded-pill px-2.5 py-1 text-dark bg-white border" style="width: 135px;" onchange="onCustomDateInputChanged()" title="To hearing date" />
                    </div>

                    <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1 text-decoration-none extra-small" onclick="clearHearingDateFilter()" title="Reset date filters">
                        <i class="bi bi-x-circle me-1"></i>Reset Date
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-white text-secondary border shadow-sm small py-1.5 px-2.5" id="hearingFilterSummaryBadge">
                        Showing all dates
                    </span>
                </div>
            </div>
        </div>

        <!-- Cases Table -->
        <div class="table-responsive" style="min-height: 380px;">
            <table class="table table-hover align-middle mb-0 table-cases" id="myCasesTable">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th style="width: 50px;" class="ps-4">#</th>
                        <th style="min-width: 170px;">CNR Number</th>
                        <th style="min-width: 150px;">Case No & Type</th>
                        <th style="min-width: 190px;">Court Hall & Bench</th>
                        <th style="min-width: 220px; max-width: 280px;">Parties (Petitioner vs Respondent)</th>
                        <th style="min-width: 160px;">Next Hearing / Stage</th>
                        <th style="min-width: 110px;">Status</th>
                        <th style="min-width: 130px;">Last Synced</th>
                        <th style="min-width: 180px;" class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="myCasesTbody">
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                            <span>Loading your tracked cases from database...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination Info -->
        <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="small text-muted" id="tableSummaryText">
                Showing 0 cases
            </div>
            <div class="small text-muted">
                <i class="bi bi-shield-check text-success me-1"></i> Synced via NAPIX eCourts Official API
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: Add CNR Numbers (Supports Bulk Paste)              -->
<!-- ======================================================== -->
<div class="modal fade" id="addCnrModal" tabindex="-1" aria-labelledby="addCnrModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3 px-4" 
                 style="background: @(isLabour ? "linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%)" : "linear-gradient(135deg, #0f172a 0%, #0284c7 100%)");">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-plus-lg text-warning fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="addCnrModalLabel">Add CNR Numbers to Track</h5>
                        <div class="small text-white-50" style="font-size: 0.75rem;">
                            Target Module: <strong>@module</strong> — Live eCourts NAPIX synchronization
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="alert alert-info border-0 rounded-3 d-flex align-items-start gap-2 mb-3 py-2.5 px-3">
                    <i class="bi bi-info-circle-fill text-primary fs-5 mt-0.5"></i>
                    <div class="small text-dark">
                        <strong>Bulk Entry Supported:</strong> Paste one or multiple 16-character CNR numbers separated by lines, commas, or spaces (e.g. <code>KAHC020060752019</code>). 
                        The system will automatically query the live NAPIX eCourts Gateway, retrieve complete case history, orders, parties, and status, and store the dossier with zero data loss.
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="bulkCnrTextarea" class="form-label fw-bold text-dark small mb-0">
                            Enter / Paste CNR Numbers:
                        </label>
                        <span class="badge bg-secondary-subtle text-dark border small" id="detectedCnrsBadge">
                            0 valid CNR(s) detected
                        </span>
                    </div>
                    <textarea class="form-control font-monospace border-2" id="bulkCnrTextarea" rows="6" 
                              placeholder="e.g.&#10;KAHC020060752019&#10;KAHC010045232021&#10;KADW200035292024"
                              style="font-size: 0.9rem;" oninput="onCnrInputChanged()"></textarea>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <button type="button" class="btn btn-link text-decoration-none p-0 extra-small text-muted" onclick="insertSampleCnr()">
                        <i class="bi bi-magic me-1 text-primary"></i> Paste sample High Court CNR (KAHC020060752019)
                    </button>
                    <button type="button" class="btn btn-link text-decoration-none p-0 extra-small text-danger" onclick="clearCnrInput()">
                        <i class="bi bi-trash me-1"></i> Clear Input
                    </button>
                </div>

                <!-- Live Progress indicator -->
                <div id="addCnrProgressContainer" class="d-none mt-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-dark" id="addCnrProgressLabel">Connecting to eCourts NAPIX Gateway...</span>
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="addCnrProgressBar" style="width: 100%;"></div>
                    </div>
                    <div class="small text-muted mt-2" id="addCnrProgressDetails" style="font-size: 0.75rem;">
                        Fetching details from <code>/nic/ecourts/hc-cnr-api/CNR</code> with token authentication...
                    </div>
                </div>

                <!-- Result Message Alert -->
                <div id="addCnrResultAlert" class="d-none mt-3 alert mb-0" role="alert"></div>
            </div>

            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnSubmitAddCnrs" onclick="submitAddCnrs()">
                    <i class="bi bi-cloud-arrow-down-fill me-1"></i> Fetch & Save Cases
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: Full Case Dossier Viewer (100% Data Integrity)     -->
<!-- ======================================================== -->
<div class="modal fade" id="myCaseDossierModal" tabindex="-1" aria-labelledby="dossierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Modal Header -->
            <div class="modal-header text-white p-3 px-4" 
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0369a1 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-journal-text text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title fw-bold mb-0 text-white" id="dossierModalTitle">Case Dossier</h5>
                            <span class="badge bg-warning text-dark font-monospace fw-bold" id="dossierCnrBadge">CNR: —</span>
                            <span class="badge bg-success" id="dossierStatusBadge">Pending</span>
                        </div>
                        <div class="small text-white-50 mt-0.5" id="dossierSubtitle">
                            High Court of Karnataka — Live eCourts Case Record
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5" onclick="printCurrentDossier()" title="Print full comprehensive legal dossier">
                        <i class="bi bi-printer-fill"></i>
                        <span>Print Dossier</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="btnDossierRefreshLive" onclick="refreshCurrentDossierLive()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Sync Live
                    </button>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Nav Tabs -->
            <div class="bg-light border-bottom px-3 pt-2">
                <ul class="nav nav-tabs border-0" id="dossierTabList" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold small" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i> Overview & Status
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold small text-danger" id="tab-causelist" data-bs-toggle="tab" data-bs-target="#pane-causelist" type="button" role="tab">
                            <i class="bi bi-broadcast text-danger me-1"></i> Cause List & Court Hall
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold small" id="tab-parties" data-bs-toggle="tab" data-bs-target="#pane-parties" type="button" role="tab">
                            <i class="bi bi-people me-1"></i> Parties & Advocates
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold small" id="tab-history" data-bs-toggle="tab" data-bs-target="#pane-history" type="button" role="tab">
                            <i class="bi bi-clock-history me-1"></i> Proceedings (<span id="dossierHistoryCount">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold small" id="tab-orders" data-bs-toggle="tab" data-bs-target="#pane-orders" type="button" role="tab">
