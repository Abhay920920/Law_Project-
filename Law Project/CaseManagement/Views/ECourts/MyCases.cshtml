    }

    function onSearchInputChanged() {
        const val = document.getElementById("caseSearchInput")?.value || "";
        const btn = document.getElementById("clearSearchBtn");
        if (btn) {
            if (val.trim()) btn.classList.remove("d-none");
            else btn.classList.add("d-none");
        }
        filterCasesTable();
    }

    function clearSearchInput() {
        const inp = document.getElementById("caseSearchInput");
        const btn = document.getElementById("clearSearchBtn");
        if (inp) {
            inp.value = "";
        }
        if (btn) btn.classList.add("d-none");
        filterCasesTable();
    }

    // ==========================================
    // Render Cases Table with search, worker & hearing date filters
    // ==========================================
    function renderCasesTable() {
        const tbody = document.getElementById("myCasesTbody");
        const query = (document.getElementById("caseSearchInput").value || "").trim().toLowerCase();
        const selectedFilter = document.querySelector('input[name="statusFilter"]:checked')?.value || "all";
        const selectedWorker = document.getElementById("caseWorkerFilter")?.value || "all";
        const isGrouped = document.getElementById("groupByWorkerToggle")?.checked || false;
        const preset = document.getElementById("hearingDatePreset")?.value || "all";
        const fromVal = document.getElementById("hearingDateFrom")?.value || "";
        const toVal = document.getElementById("hearingDateTo")?.value || "";
        const todayStr = new Date().toISOString().split('T')[0];

        const filtered = allCasesData.filter(c => {
            // Text search
            if (query) {
                const searchStr = `${c.cnrNumber || ""} ${getDisplayCaseType(c)} ${c.caseTypeCode || ""} ${c.caseNumber || ""} ${c.caseYear || ""} ${c.petitioner || ""} ${c.respondent || ""} ${c.courtNo || ""} ${c.judgeDesignation || ""} ${c.courtEstName || ""} ${c.benchId || ""} ${c.benchName || ""} ${c.causeListType || ""} ${c.addedBy || ""}`.toLowerCase();
                if (!searchStr.includes(query)) return false;
            }

            // Case Worker Filter
            if (selectedWorker !== "all") {
                const w = (c.addedBy || "Central Office").trim().toLowerCase();
                if (w !== selectedWorker.toLowerCase()) return false;
            }

            // Radio status filter
            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");

            if (selectedFilter === "disposed" && !isDisposed) return false;
            if (selectedFilter === "pending" && isDisposed) return false;
            if (selectedFilter === "upcoming") {
                if (!c.nextHearingDate) return false;
                const dt = new Date(c.nextHearingDate);
                const yr = dt.getFullYear();
                if (yr <= 1990 || yr >= 2090) return false;
                const hDateStr = c.nextHearingDate.split('T')[0];
                if (hDateStr < todayStr) return false;
            }

            // Hearing Date Filter
            let hDate = null;
            if (c.nextHearingDate) {
                const dt = new Date(c.nextHearingDate);
                const yr = dt.getFullYear();
                if (yr > 1990 && yr < 2090) {
                    hDate = c.nextHearingDate.split('T')[0];
                }
            }

            if (preset === "unscheduled") {
                if (hDate || isDisposed) return false;
            } else if (preset === "overdue") {
                if (!hDate || hDate >= todayStr || isDisposed) return false;
            } else {
                if (fromVal && (!hDate || hDate < fromVal)) return false;
                if (toVal && (!hDate || hDate > toVal)) return false;
            }

            return true;
        });

        // Calculate pagination slices
        const totalCount = filtered.length;
        let pagedItems = filtered;
        let totalPages = 1;
        let startIndex = 0;
        let endIndex = totalCount;

        if (pageSize !== "all") {
            const pageSizeNum = parseInt(pageSize, 10) || 10;
            totalPages = Math.max(1, Math.ceil(totalCount / pageSizeNum));
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            startIndex = (currentPage - 1) * pageSizeNum;
            endIndex = Math.min(startIndex + pageSizeNum, totalCount);
            pagedItems = filtered.slice(startIndex, endIndex);
        } else {
            currentPage = 1;
            totalPages = 1;
        }

        // Update table summary
        const summaryEl = document.getElementById("tableSummaryText");
        if (summaryEl) {
            if (totalCount === 0) {
                summaryEl.innerText = "Showing 0 cases";
            } else if (pageSize === "all") {
                summaryEl.innerHTML = `Showing all <strong>${totalCount}</strong> tracked case(s)${totalCount !== allCasesData.length ? ` <span class="text-secondary">(filtered from ${allCasesData.length})</span>` : ''}`;
            } else {
                summaryEl.innerHTML = `Showing <strong>${startIndex + 1}</strong> to <strong>${endIndex}</strong> of <strong>${totalCount}</strong> tracked case(s)${totalCount !== allCasesData.length ? ` <span class="text-secondary">(filtered from ${allCasesData.length})</span>` : ''}`;
            }
        }

        // Render pagination controls
        renderPagination(totalPages, currentPage);

        // Update Case Worker summary badge
        const workerBadge = document.getElementById("workerFilterSummaryBadge");
        if (workerBadge) {
            if (selectedWorker === "all") {
                workerBadge.innerText = `All workers (${filtered.length})`;
            } else {
                workerBadge.innerHTML = `<i class="bi bi-person-fill text-primary me-1"></i>${escapeHtml(selectedWorker)} (${filtered.length})`;
            }
        }

        // Update Hearing Filter Summary Badge
        const summaryBadge = document.getElementById("hearingFilterSummaryBadge");
        if (summaryBadge) {
            if (preset === "today") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-check text-success me-1"></i>Listed Today (${filtered.length})`;
            } else if (preset === "tomorrow") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-event text-primary me-1"></i>Listed Tomorrow (${filtered.length})`;
            } else if (preset === "this_week") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-week text-warning me-1"></i>Next 7 Days (${filtered.length})`;
            } else if (preset === "this_month") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-month text-info me-1"></i>Next 30 Days (${filtered.length})`;
            } else if (preset === "overdue") {
                summaryBadge.innerHTML = `<i class="bi bi-exclamation-triangle text-danger me-1"></i>Overdue Hearings (${filtered.length})`;
            } else if (preset === "unscheduled") {
                summaryBadge.innerHTML = `<i class="bi bi-hourglass text-muted me-1"></i>Unscheduled (${filtered.length})`;
            } else if (fromVal || toVal) {
                summaryBadge.innerHTML = `<i class="bi bi-funnel-fill text-primary me-1"></i>${fromVal || '...'} to ${toVal || '...'} (${filtered.length})`;
            } else {
                summaryBadge.innerText = `Showing all dates (${filtered.length})`;
            }
        }

        if (filtered.length === 0) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 text-secondary d-block mb-2"></i>
                No cases match the selected filter criteria.
            </td></tr>`;
            if (cardsContainer) {
                cardsContainer.innerHTML = `<div class="p-4 text-center text-muted bg-white rounded-3 border my-2">
                    <i class="bi bi-inbox fs-2 text-secondary d-block mb-2"></i>
                    No cases match the selected filter criteria.
                </div>`;
            }
            return;
        }

        // Group by Case Worker Rendering
        if (isGrouped) {
            const workerGroups = {};
            pagedItems.forEach(c => {
                const w = (c.addedBy || "Central Office").trim();
                if (!workerGroups[w]) workerGroups[w] = [];
                workerGroups[w].push(c);
            });

            let groupHtml = "";
            let groupCardsHtml = "";
            let overallIndex = startIndex;
            const workerNames = Object.keys(workerGroups).sort((a, b) => a.localeCompare(b));

            workerNames.forEach((wName, gIdx) => {
                const wCases = workerGroups[wName];
                const gId = `wgroup_${gIdx}`;
                const pendingCnt = wCases.filter(c => {
                    const st = (c.caseStatus || "").toLowerCase();
                    return !st.includes("dispos") && !st.includes("dismiss") && !st.includes("allowed");
                }).length;
                const disposedCnt = wCases.length - pendingCnt;
                const todayCnt = wCases.filter(c => c.nextHearingDate && c.nextHearingDate.split('T')[0] === todayStr).length;

                groupHtml += `
                <tr class="table-group-header border-top border-bottom border-primary-subtle" style="background: linear-gradient(90deg, #f0f4ff 0%, #ffffff 100%);">
                    <td colspan="9" class="py-2.5 px-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-link text-primary p-0 text-decoration-none" onclick="toggleGroupCollapse('${gId}')" title="Collapse / Expand group">
                                    <i class="bi bi-chevron-down fs-6 fw-bold" id="icon_${gId}"></i>
                                </button>
                                <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fs-6 shadow-sm">
                                    <i class="bi bi-person-badge-fill me-1.5"></i>${escapeHtml(wName)}
                                </span>
                                <span class="badge bg-white text-dark border shadow-sm small py-1 px-2.5">
                                    <strong>${wCases.length}</strong> Case(s)
                                </span>
                                <span class="badge bg-warning-subtle text-dark border border-warning small py-1 px-2">
                                    <i class="bi bi-hourglass-split me-1 text-warning"></i>${pendingCnt} Pending
                                </span>
                                ${todayCnt > 0 ? `<span class="badge bg-danger text-white small py-1 px-2"><i class="bi bi-calendar-check me-1"></i>${todayCnt} Listed Today</span>` : ''}
                                <span class="badge bg-success-subtle text-success border border-success small py-1 px-2">
                                    <i class="bi bi-check-circle me-1 text-success"></i>${disposedCnt} Disposed
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill extra-small px-2.5 py-1" onclick="filterByWorkerOnly('${escapeJs(wName)}')" title="Filter table to only this worker">
                                    <i class="bi bi-funnel me-1"></i>Focus Worker
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>`;

                // Mobile grouped cards wrapper
                groupCardsHtml += `
                <div class="card border-primary-subtle shadow-sm mb-3 rounded-3 overflow-hidden">
                    <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-white text-primary rounded-pill px-2.5 py-1 fw-bold fs-6">
                                <i class="bi bi-person-badge-fill me-1"></i>${escapeHtml(wName)}
                            </span>
                            <span class="badge bg-white bg-opacity-25 text-white extra-small">${wCases.length} Cases</span>
                        </div>
                        <button type="button" class="btn btn-xs btn-outline-light rounded-pill extra-small px-2 py-0.5" onclick="filterByWorkerOnly('${escapeJs(wName)}')">Focus</button>
                    </div>
                    <div class="card-body p-2 bg-light">`;

                wCases.forEach(c => {
                    overallIndex++;
                    groupHtml += renderCaseRowHtml(c, overallIndex, gId);
                    groupCardsHtml += renderCaseMobileCardHtml(c, overallIndex);
                });

                groupCardsHtml += `</div></div>`;
            });

            tbody.innerHTML = groupHtml;
            if (cardsContainer) cardsContainer.innerHTML = groupCardsHtml;
            return;
        }

        // Standard Flat View Rendering
        let html = "";
        let cardsHtml = "";
        pagedItems.forEach((c, index) => {
            html += renderCaseRowHtml(c, startIndex + index + 1);
            cardsHtml += renderCaseMobileCardHtml(c, startIndex + index + 1);
        });

        tbody.innerHTML = html;
        if (cardsContainer) cardsContainer.innerHTML = cardsHtml;
    }

    function filterCasesTable() {
        currentPage = 1;
        renderCasesTable();
    }

    function onPageSizeChange(val) {
        pageSize = val === 'all' ? 'all' : (parseInt(val, 10) || 10);
        currentPage = 1;
        renderCasesTable();
    }

    function goToPage(page) {
        currentPage = page;
        renderCasesTable();
        const tableCard = document.getElementById("myCasesTable");
        const mobileContainer = document.getElementById("myCasesCardsContainer");
        if (window.innerWidth < 992 && mobileContainer) {
            mobileContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else if (tableCard) {
            tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function renderPagination(totalPages, page) {
        const nav = document.getElementById("casesPaginationNav");
        const ul = document.getElementById("casesPaginationList");
        if (!nav || !ul) return;

        if (totalPages <= 1) {
            nav.classList.add("d-none");
            ul.innerHTML = "";
            return;
        }

        nav.classList.remove("d-none");

        let html = "";

        // First button
        html += `<li class="page-item ${page <= 1 ? 'disabled' : ''}">
            <button class="page-link rounded-start shadow-none" type="button" onclick="goToPage(1)" title="First Page" ${page <= 1 ? 'tabindex="-1" aria-disabled="true"' : ''}>
                <i class="bi bi-chevron-double-left"></i>
            </button>
        </li>`;

        // Previous button
        html += `<li class="page-item ${page <= 1 ? 'disabled' : ''}">
            <button class="page-link shadow-none" type="button" onclick="goToPage(${page - 1})" title="Previous Page" ${page <= 1 ? 'tabindex="-1" aria-disabled="true"' : ''}>
                <i class="bi bi-chevron-left"></i>
            </button>
        </li>`;

        // Smart page windowing (window of +/- 2 around active page)
        const windowSize = 2;
        let startPage = Math.max(1, page - windowSize);
        let endPage = Math.min(totalPages, page + windowSize);

        if (endPage - startPage < windowSize * 2) {
            if (startPage === 1) {
                endPage = Math.min(totalPages, startPage + windowSize * 2);
            } else if (endPage === totalPages) {
                startPage = Math.max(1, endPage - windowSize * 2);
            }
        }

        if (startPage > 1) {
            html += `<li class="page-item">
                <button class="page-link shadow-none" type="button" onclick="goToPage(1)">1</button>
            </li>`;
            if (startPage > 2) {
                html += `<li class="page-item disabled"><span class="page-link border-0 text-muted px-2">...</span></li>`;
            }
        }

        for (let p = startPage; p <= endPage; p++) {
            const isActive = (p === page);
            html += `<li class="page-item ${isActive ? 'active' : ''}">
                <button class="page-link shadow-none ${isActive ? 'fw-bold' : ''}" type="button" onclick="goToPage(${p})">${p}</button>
            </li>`;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                html += `<li class="page-item disabled"><span class="page-link border-0 text-muted px-2">...</span></li>`;
            }
            html += `<li class="page-item">
                <button class="page-link shadow-none" type="button" onclick="goToPage(${totalPages})">${totalPages}</button>
            </li>`;
        }

        // Next button
        html += `<li class="page-item ${page >= totalPages ? 'disabled' : ''}">
            <button class="page-link shadow-none" type="button" onclick="goToPage(${page + 1})" title="Next Page" ${page >= totalPages ? 'tabindex="-1" aria-disabled="true"' : ''}>
                <i class="bi bi-chevron-right"></i>
            </button>
        </li>`;

        // Last button
        html += `<li class="page-item ${page >= totalPages ? 'disabled' : ''}">
            <button class="page-link rounded-end shadow-none" type="button" onclick="goToPage(${totalPages})" title="Last Page" ${page >= totalPages ? 'tabindex="-1" aria-disabled="true"' : ''}>
                <i class="bi bi-chevron-double-right"></i>
            </button>
        </li>`;

        ul.innerHTML = html;
    }

    // ==========================================
    // EXPORT TO EXCEL (.XLS) & CSV (.CSV) ENGINE
    // ==========================================
    function getCasesForExport(scope = 'filtered') {
        if (!allCasesData || allCasesData.length === 0) return [];
        if (scope === 'all') return [...allCasesData];

        const query = (document.getElementById("caseSearchInput").value || "").trim().toLowerCase();
        const selectedFilter = document.querySelector('input[name="statusFilter"]:checked')?.value || "all";
        const selectedWorker = document.getElementById("caseWorkerFilter")?.value || "all";
        const preset = document.getElementById("hearingDatePreset")?.value || "all";
        const fromVal = document.getElementById("hearingDateFrom")?.value || "";
        const toVal = document.getElementById("hearingDateTo")?.value || "";
        const todayStr = new Date().toISOString().split('T')[0];

        return allCasesData.filter(c => {
            if (query) {
                const searchStr = `${c.cnrNumber || ""} ${getDisplayCaseType(c)} ${c.caseTypeCode || ""} ${c.caseNumber || ""} ${c.caseYear || ""} ${c.petitioner || ""} ${c.respondent || ""} ${c.courtNo || ""} ${c.judgeDesignation || ""} ${c.courtEstName || ""} ${c.benchId || ""} ${c.benchName || ""} ${c.causeListType || ""} ${c.addedBy || ""}`.toLowerCase();
                if (!searchStr.includes(query)) return false;
            }

            if (selectedWorker !== "all") {
                const w = (c.addedBy || "Central Office").trim().toLowerCase();
                if (w !== selectedWorker.toLowerCase()) return false;
            }

            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
            if (selectedFilter === "disposed" && !isDisposed) return false;
            if (selectedFilter === "pending" && isDisposed) return false;
            if (selectedFilter === "upcoming") {
                if (!c.nextHearingDate) return false;
                if (c.nextHearingDate.split('T')[0] < todayStr) return false;
            }
            const hDate = c.nextHearingDate ? c.nextHearingDate.split('T')[0] : null;
            if (preset === "unscheduled") {
                if (hDate) return false;
            } else if (preset === "overdue") {
                if (!hDate || hDate >= todayStr || isDisposed) return false;
            } else {
                if (fromVal && (!hDate || hDate < fromVal)) return false;
                if (toVal && (!hDate || hDate > toVal)) return false;
            }
            return true;
        });
    }

    function exportToExcel(scope = 'filtered') {
        if (!allCasesData || allCasesData.length === 0) {
            showToast("Export", `No case records currently tracked under ${currentModule} to export. Add CNR numbers to track cases.`, false);
            return;
        }

        let toExport = getCasesForExport(scope);
        if (toExport.length === 0) {
            if (scope === 'filtered' && allCasesData.length > 0) {
                showToast("Export Notice", `No cases matched active filter. Exporting all ${allCasesData.length} tracked cases instead.`, true);
                toExport = [...allCasesData];
            } else {
                showToast("Export", "No cases match the selected criteria to export.", false);
                return;
            }
        }

        const todayStr = new Date().toISOString().split('T')[0];
        const printTime = new Date().toLocaleString("en-GB", {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit', hour12: true
        });

        const isLabour = currentModule.toLowerCase() === "labour";
        const moduleLabel = isLabour ? "LABOUR DISPUTES & INDUSTRIAL TRIBUNALS" : "MVC / MACT MOTOR ACCIDENT CLAIMS";

        // MSO Excel text format so long CNR numbers are never converted to scientific notation
        const msoText = "mso-number-format: '\\" + String.fromCharCode(64) + "';";

        let rowsHtml = "";
        toExport.forEach((c, index) => {
            const isHc = (c.cnrNumber || "").startsWith("HC") || (c.cnrNumber && c.cnrNumber.length >= 4 && c.cnrNumber.substring(2, 4).toUpperCase() === "HC");
            const courtTier = isHc ? "High Court" : "District / Lower Court";
            const caseType = getDisplayCaseType(c);
            const caseNum = `${c.caseNumber || ""}${c.caseYear ? "/" + c.caseYear : ""}`;
            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
            const statusText = isDisposed ? "DISPOSED" : (c.caseStatus || "PENDING");
            const statusStyle = isDisposed ? "background-color: #dcfce7; color: #15803d; font-weight: bold;" : "background-color: #fef3c7; color: #b45309; font-weight: bold;";

            let hearingDateStr = "Date Awaited";
            if (c.nextHearingDate) {
                const dt = new Date(c.nextHearingDate);
                if (!isNaN(dt.getTime()) && dt.getFullYear() > 1990 && dt.getFullYear() < 2090) {
                    hearingDateStr = dt.toISOString().split('T')[0];
                }
            }

            let syncedDateStr = "";
            if (c.lastSyncedAt) {
                const sDt = new Date(c.lastSyncedAt);
                if (!isNaN(sDt.getTime())) {
                    syncedDateStr = sDt.toLocaleString("en-GB");
                }
            }

            rowsHtml += `
            <tr>
                <td style="text-align: center; border: 0.5pt solid #cbd5e1;">${index + 1}</td>
                <td style="${msoText} font-family: monospace; font-weight: bold; border: 0.5pt solid #cbd5e1;">${escapeHtml(c.cnrNumber || "")}</td>
                <td style="border: 0.5pt solid #cbd5e1;">${escapeHtml(courtTier)}</td>
                <td style="font-weight: bold; color: #0369a1; border: 0.5pt solid #cbd5e1;">${escapeHtml(caseType)}</td>
                <td style="${msoText} font-family: monospace; border: 0.5pt solid #cbd5e1;">${escapeHtml(caseNum)}</td>
                <td style="border: 0.5pt solid #cbd5e1;">${escapeHtml(c.caseYear || "")}</td>
                <td style="${msoText} border: 0.5pt solid #cbd5e1;">${escapeHtml(c.estCode || "")}</td>
                <td style="border: 0.5pt solid #cbd5e1;">${escapeHtml(c.courtEstName || c.estCode || "")}</td>
                <td style="border: 0.5pt solid #cbd5e1;">${escapeHtml(c.courtNo || "")}</td>
