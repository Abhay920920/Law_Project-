<!-- MODAL: Add CNR Numbers (Supports Bulk Paste)              -->
<!-- ======================================================== -->
<div class="modal fade" id="addCnrModal" tabindex="-1" aria-labelledby="addCnrModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-lg-down">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3 px-4" 
                 style="background: @(isLabour ? "linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%)" : "linear-gradient(135deg, #0f172a 0%, #0284c7 100%)");">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-plus-lg text-warning fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="addCnrModalLabel">Add CNR Numbers to Track</h5>
                        <div class="small text-white-50" style="font-size: 0.75rem;">
                            Target Module: <strong>@module</strong> — Live eCourts NAPIX synchronization
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="alert alert-info border-0 rounded-3 d-flex align-items-start gap-2 mb-3 py-2.5 px-3">
                    <i class="bi bi-info-circle-fill text-primary fs-5 mt-0.5"></i>
                    <div class="small text-dark">
                        <strong>Bulk Entry Supported:</strong> Paste one or multiple 16-character CNR numbers separated by lines, commas, or spaces (e.g. <code>KAHC020060752019</code>). 
                        The system will automatically query the live NAPIX eCourts Gateway, retrieve complete case history, orders, parties, and status, and store the dossier with zero data loss.
                    </div>
                </div>

                <!-- Assigned Case Worker / Desk Selector -->
                <div class="mb-3 p-3 bg-light rounded-3 border">
                    <label for="assignedCaseWorkerSelect" class="form-label fw-bold text-dark small mb-1.5 d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-person-fill-check text-primary"></i>
                            <span>Assign to Case Worker / Desk:</span>
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle extra-small">
                            @(string.Equals(module, "Labour", StringComparison.OrdinalIgnoreCase) ? "Labour Desks" : "MVC Desks")
                        </span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <select id="assignedCaseWorkerSelect" class="form-select fw-semibold text-dark shadow-sm" onchange="onAssignedWorkerSelectChange()">
                            @if (string.Equals(module, "Labour", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Labour 1 ( Sahana)">1) Labour 1 ( Sahana)</option>
                                <option value="Labour 2 ( Pavitra)">2) Labour 2 ( Pavitra)</option>
                                <option value="Gratuity ( Karthik)">3) Gratuity ( Karthik)</option>
                                <option value="Service & Other Matters ( Ajay )">4) Service & Other Matters ( Ajay )</option>
                                <option value="Central Office">Central Office (General Desk)</option>
                                <option value="__custom__">➕ Other / Custom Desk...</option>
                            }
                            else
                            {
                                <option value="MFA 1 ( V V Arekeri )">1) MFA 1 ( V V Arekeri )</option>
                                <option value="MFA 2 ( Raju P )">2) MFA 2 ( Raju P )</option>
                                <option value="Central Office">Central Office (General Desk)</option>
                                <option value="__custom__">➕ Other / Custom Desk...</option>
                            }
                        </select>
                    </div>
                    <div id="customAssignedWorkerBox" class="mt-2 d-none">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted">Other Desk:</span>
                            <input type="text" id="assignedCaseWorkerInput" class="form-control" 
                                   placeholder="Type custom Case Worker name or desk..." />
                        </div>
                    </div>
                    <div class="extra-small text-muted mt-1.5 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-info-circle me-1"></i>Select designated case worker or assign to a custom desk.</span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="bulkCnrTextarea" class="form-label fw-bold text-dark small mb-0">
                            Enter / Paste CNR Numbers:
                        </label>
                        <span class="badge bg-secondary-subtle text-dark border small" id="detectedCnrsBadge">
                            0 valid CNR(s) detected
                        </span>
                    </div>
                    <textarea class="form-control font-monospace border-2" id="bulkCnrTextarea" rows="6" 
                              placeholder="e.g.&#10;KAHC020060752019&#10;KAHC010045232021&#10;KADW200035292024"
                              style="font-size: 0.9rem;" oninput="onCnrInputChanged()"></textarea>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <button type="button" class="btn btn-link text-decoration-none p-0 extra-small text-muted" onclick="insertSampleCnr()">
                        <i class="bi bi-magic me-1 text-primary"></i> Paste sample High Court CNR (KAHC020060752019)
                    </button>
                    <button type="button" class="btn btn-link text-decoration-none p-0 extra-small text-danger" onclick="clearCnrInput()">
                        <i class="bi bi-trash me-1"></i> Clear Input
                    </button>
                </div>

                <!-- Live Progress indicator -->
                <div id="addCnrProgressContainer" class="d-none mt-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-dark" id="addCnrProgressLabel">Connecting to eCourts NAPIX Gateway...</span>
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="addCnrProgressBar" style="width: 100%;"></div>
                    </div>
                    <div class="small text-muted mt-2" id="addCnrProgressDetails" style="font-size: 0.75rem;">
                        Fetching details from <code>/nic/ecourts/hc-cnr-api/CNR</code> with token authentication...
                    </div>
                </div>

                <!-- Result Message Alert -->
                <div id="addCnrResultAlert" class="d-none mt-3 alert mb-0" role="alert"></div>
            </div>

            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnSubmitAddCnrs" onclick="submitAddCnrs()">
                    <i class="bi bi-cloud-arrow-down-fill me-1"></i> Fetch & Save Cases
                </button>
            </div>
        </div>
    </div>
</div>

