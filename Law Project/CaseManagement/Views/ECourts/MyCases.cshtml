    async function refreshCurrentDossierLive() {
        if (!currentDossierTrackedId) return;
        const btn = document.getElementById("btnDossierRefreshLive");
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Syncing...`;

        try {
            const res = await fetch(`/ECourts/RefreshTrackedCnr?trackedId=${currentDossierTrackedId}`, { method: "POST" });
            const json = await res.json();
            if (json.success) {
                showToast("Synced", "Dossier refreshed with latest live eCourts data.", true);
                openCaseDossier(currentDossierTrackedId);
                loadTrackedCases();
            } else {
                showToast("Sync Error", json.message || "Failed to sync.", false);
            }
        } catch (err) {
            showToast("Sync Error", "Network error.", false);
        } finally {
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-arrow-clockwise me-1"></i> Sync Live`;
        }
    }



