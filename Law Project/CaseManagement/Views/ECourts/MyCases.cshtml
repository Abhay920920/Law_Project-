                                <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="openReassignModal(${c.trackedID}, '${c.cnrNumber}', '${escapeJs(workerName)}')">
                                    <i class="bi bi-person-gear text-info fs-6"></i>
                                    <div>
                                        <div class="fw-bold">Reassign Case Worker</div>
