    function exportToCsv(scope = 'filtered') {
        if (!allCasesData || allCasesData.length === 0) {
            showToast("Export", `No case records currently tracked under ${currentModule} to export. Add CNR numbers to track cases.`, false);
            return;
        }

        let toExport = getCasesForExport(scope);
        if (toExport.length === 0) {
            if (scope === 'filtered' && allCasesData.length > 0) {
                showToast("Export Notice", `No cases matched active filter. Exporting all ${allCasesData.length} tracked cases instead.`, true);
                toExport = [...allCasesData];
            } else {
                showToast("Export", "No cases match the selected criteria to export.", false);
                return;
            }
        }

        const headers = [
            "#", "CNR Number", "Court Tier", "Case Type", "Case Number", "Case Year",
            "Est Code", "Court Establishment", "Court Hall", "Bench", "Presiding Judge",
            "Cause List Type", "Petitioner", "Respondent", "Next Hearing Date",
            "Stage/Purpose", "Hearing Urgency", "Total Hearings", "First Listed Date",
            "Last Listing Date", "Last Proceeding Summary", "Case Status", "Case Worker", "Last Synced At"
        ];

        const rows = toExport.map((c, i) => {
            const isHc = (c.cnrNumber || "").startsWith("HC") || (c.cnrNumber && c.cnrNumber.length >= 4 && c.cnrNumber.substring(2, 4).toUpperCase() === "HC");
            const courtTier = isHc ? "High Court" : "District / Lower Court";
            const hDate = c.nextHearingDate ? c.nextHearingDate.split('T')[0] : "";
            return [
                i + 1,
                `"${(c.cnrNumber || "").replace(/"/g, '""')}"`,
                `"${courtTier}"`,
                `"${(getDisplayCaseType(c) || "").replace(/"/g, '""')}"`,
                `"${(c.caseNumber || "").replace(/"/g, '""')}"`,
                `"${c.caseYear || ""}"`,
                `"${(c.estCode || "").replace(/"/g, '""')}"`,
                `"${(c.courtEstName || c.estCode || "").replace(/"/g, '""')}"`,
                `"${(c.courtNo || "").replace(/"/g, '""')}"`,
                `"${(c.benchName || (c.benchId ? `Bench ${c.benchId}` : "")).replace(/"/g, '""')}"`,
                `"${(c.judgeDesignation || "").replace(/"/g, '""')}"`,
                `"${(c.causeListType || "").replace(/"/g, '""')}"`,
                `"${(c.petitioner || "").replace(/"/g, '""')}"`,
                `"${(c.respondent || "").replace(/"/g, '""')}"`,
                `"${hDate}"`,
                `"${(c.stagePurpose || "").replace(/"/g, '""')}"`,
                `"${(c.hearingUrgency || "UNSCHEDULED")}"`,
                `"${c.totalHearings || 0}"`,
                `"${c.firstHearingDate || ""}"`,
                `"${c.lastHearingDate || ""}"`,
                `"${(c.lastProceeding || "").replace(/"/g, '""')}"`,
                `"${(c.caseStatus || "").replace(/"/g, '""')}"`,
                `"${(c.addedBy || "Central Office").replace(/"/g, '""')}"`,
                `"${(c.lastSyncedAt || "").replace(/"/g, '""')}"`
            ].join(",");
        });

        const csvContent = "\uFEFF" + [headers.join(","), ...rows].join("\r\n");
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `NWKRTC_MyCases_${currentModule}_${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);

        showToast("Export Complete", `Exported ${toExport.length} cases to CSV.`, true);
    }

    // ==========================================
    // Add CNR Numbers logic
    // ==========================================
    function onCnrInputChanged() {
        const val = document.getElementById("bulkCnrTextarea").value || "";
        const matches = val.match(/[A-Za-z0-9]{16}/g) || [];
        const unique = [...new Set(matches.map(m => m.toUpperCase()))];
        const badge = document.getElementById("detectedCnrsBadge");
        if (unique.length > 0) {
            badge.innerText = `${unique.length} valid CNR(s) detected`;
            badge.className = "badge bg-success-subtle text-success border border-success small";
        } else {
            badge.innerText = `0 valid CNR(s) detected`;
            badge.className = "badge bg-secondary-subtle text-dark border small";
        }
    }

    function insertSampleCnr() {
        const textarea = document.getElementById("bulkCnrTextarea");
        textarea.value = (textarea.value.trim() ? textarea.value.trim() + "\n" : "") + "KAHC020060752019";
        onCnrInputChanged();
    }

    function clearCnrInput() {
        document.getElementById("bulkCnrTextarea").value = "";
        onCnrInputChanged();
        document.getElementById("addCnrResultAlert").className = "d-none mt-3 alert mb-0";
    }

    async function submitAddCnrs() {
        const text = document.getElementById("bulkCnrTextarea").value || "";
        const btn = document.getElementById("btnSubmitAddCnrs");
        const progressBox = document.getElementById("addCnrProgressContainer");
        const alertBox = document.getElementById("addCnrResultAlert");

        const matches = text.match(/[A-Za-z0-9]{16}/g) || [];
        const unique = [...new Set(matches.map(m => m.toUpperCase()))];

        if (unique.length === 0) {
            alertBox.className = "mt-3 alert alert-danger mb-0 small";
            alertBox.innerText = "Please enter at least one valid 16-character CNR number (e.g. KAHC020060752019).";
            return;
        }

        let assignedWorker = (document.getElementById("assignedCaseWorkerSelect")?.value || "").trim();
        if (assignedWorker === "__custom__") {
            assignedWorker = (document.getElementById("assignedCaseWorkerInput")?.value || "").trim();
        }
        if (!assignedWorker) {
            assignedWorker = "Central Office";
        }

        btn.disabled = true;
        progressBox.classList.remove("d-none");
        alertBox.className = "d-none mt-3 alert mb-0";

        try {
            const res = await fetch("/ECourts/AddTrackedCnrs", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ 
                    cnrNumbers: unique.join("\n"), 
                    module: currentModule,
                    caseWorker: assignedWorker
                })
            });

            const json = await res.json();
            progressBox.classList.add("d-none");
            btn.disabled = false;

            if (json.success) {
                alertBox.className = "mt-3 alert alert-success mb-0 small";
                let msg = `<strong>Success!</strong> ${json.message}`;
                if (json.failed && json.failed.length > 0) {
                    msg += `<div class="mt-1 text-danger">Failed / Not Found: ${json.failed.map(f => f.cnr).join(", ")}</div>`;
                }
                alertBox.innerHTML = msg;

                // Reload table
                loadTrackedCases();
                showToast("Cases Added", `${json.added} new case(s) tracked.`, true);

                setTimeout(() => {
                    const modalEl = document.getElementById('addCnrModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal && (json.added > 0 || json.updated > 0)) {
                        modal.hide();
                        clearCnrInput();
                    }
                }, 1600);
            } else {
                alertBox.className = "mt-3 alert alert-danger mb-0 small";
                alertBox.innerText = json.message || "Failed to process CNR numbers.";
            }
        } catch (err) {
            progressBox.classList.add("d-none");
            btn.disabled = false;
            alertBox.className = "mt-3 alert alert-danger mb-0 small";
            alertBox.innerText = "Network or server error while connecting to eCourts Gateway.";
        }
    }

    // ==========================================
    // Sync single case live
    // ==========================================
    async function syncCaseLive(trackedId) {
        const btn = document.getElementById(`btnSync_${trackedId}`);
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span>`;
        }

        try {
            const res = await fetch(`/ECourts/RefreshTrackedCnr?trackedId=${trackedId}`, { method: "POST" });
            const json = await res.json();

            if (json.success) {
                showToast("Live Sync Complete", "Case record updated from live eCourts Gateway.", true);
                loadTrackedCases();
            } else {
                showToast("Sync Error", json.message || "Failed to fetch live eCourts update.", false);
            }
        } catch (err) {
            showToast("Sync Error", "Network error during eCourts refresh.", false);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<i class="bi bi-arrow-clockwise"></i>`;
            }
        }
    }

    // ==========================================
    // Remove Case from My Cases
    // ==========================================
    async function removeCase(trackedId, cnr) {
        if (!confirm(`Are you sure you want to remove CNR ${cnr} from My Cases?`)) return;

        try {
            const res = await fetch(`/ECourts/DeleteTrackedCnr?trackedId=${trackedId}`, { method: "POST" });
            const json = await res.json();
            if (json.success) {
                showToast("Case Removed", `CNR ${cnr} was removed from your tracked cases.`, true);
                loadTrackedCases();
            } else {
                showToast("Error", json.message || "Failed to remove case.", false);
            }
        } catch (err) {
            showToast("Error", "Network error during removal.", false);
        }
    }

    // ========================================================
    // Daily Proceedings & Hearing Date Analysis Engine
    // ========================================================
    let currentProceedingsTrackedId = null;
    let currentProceedingsCase = null;
    let currentProceedingsList = [];

    async function openDailyProceedingsModal(trackedId) {
        currentProceedingsTrackedId = trackedId;
        const modalEl = document.getElementById('dailyProceedingsModal');
        if (!modalEl) return;
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        // Close live roznama box if open
        closeLiveRoznamaBox();

        // Check if case is already in allCasesData cache
        let cachedCase = allCasesData.find(x => (x.trackedID == trackedId || x.trackedId == trackedId || x.id == trackedId));
        if (cachedCase) {
            currentProceedingsCase = cachedCase;
            populateDailyProceedingsModal(cachedCase, cachedCase.proceedingsHistory || []);
        } else {
            // Show loading placeholder
            document.getElementById("dpModalTitle").innerHTML = `<i class="bi bi-journal-text me-2 text-warning"></i>Loading Daily Proceedings...`;
            document.getElementById("dpProceedingsTbody").innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2 text-primary"></span>Loading proceedings analysis from database...</td></tr>`;
        }

        // Fetch fresh proceedings details from server
        try {
            const res = await fetch(`/ECourts/GetCaseProceedings?trackedId=${trackedId}`);
            const json = await res.json();
            const cInfo = json.caseInfo || json.data;
            const pList = json.proceedings || (cInfo && cInfo.proceedingsHistory) || [];
            if (json.success && cInfo) {
                currentProceedingsCase = cInfo;
                currentProceedingsList = pList;
                populateDailyProceedingsModal(cInfo, pList);

                // By default: if any listed hearing is missing verbatim Roznama text, auto-fetch all and store in DB
                const missingCount = pList.filter(h => {
                    const r = (h.business || h.roznama || h.proceeding || "").trim();
                    const dt = extractValidDate(h.business_date || h.businessDate || h.hearing_date || h.hearingDate);
                    return !r && !!dt;
                }).length;
                if (missingCount > 0) {
                    fetchAllCaseRoznamas(true);
                }
            } else if (!cachedCase) {
                document.getElementById("dpProceedingsTbody").innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>${json.message || "Failed to load proceedings."}</td></tr>`;
            }
        } catch (err) {
            console.error("Error fetching case proceedings:", err);
            if (!cachedCase) {
                document.getElementById("dpProceedingsTbody").innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Network error loading proceedings.</td></tr>`;
            }
        }
    }

    function populateDailyProceedingsModal(c, hist) {
        currentProceedingsList = hist || [];

        // Header
        const displayType = getDisplayCaseType(c);
        document.getElementById("dpModalCaseType").innerText = displayType || "CASE";
        document.getElementById("dpModalCnr").innerText = c.cnrNumber || "—";
        document.getElementById("dpModalCourtHall").innerText = c.courtEstablishmentName || c.courtEstName || "District / High Court";
        
        const statusEl = document.getElementById("dpModalStatus");
        const statusText = (c.caseStatus || "PENDING").toUpperCase();
        statusEl.innerText = statusText;
        statusEl.className = (statusText.includes("DISP") || statusText.includes("DISMISS")) ? "badge bg-secondary" : "badge bg-success";

        document.getElementById("dpModalTitle").innerHTML = `<i class="bi bi-journal-text me-2 text-warning"></i>${escapeHtml(displayType)} ${escapeHtml(c.caseNumber || "")} — Daily Proceedings &amp; Hearing Analysis`;
        document.getElementById("dpModalParties").innerText = `${c.petitioner || "Petitioner"} vs ${c.respondent || "Respondent"}`;

        // KPI 1: Next Scheduled Hearing
        const nextDt = c.nextHearingDate ? (typeof c.nextHearingDate === 'string' && c.nextHearingDate.includes('T') ? c.nextHearingDate.split('T')[0] : c.nextHearingDate) : "—";
        document.getElementById("dpMetricNextDate").innerText = nextDt;
        document.getElementById("dpMetricNextStage").innerText = c.stagePurpose || c.caseStage || c.stage || "Stage not specified";
        
        // Urgency badge
        const urgencyContainer = document.getElementById("dpMetricUrgencyBadge");
        urgencyContainer.innerHTML = getHearingUrgencyBadge(c.hearingUrgency, c.daysToNextHearing);

        // KPI 2: Last Concluded Listing
        document.getElementById("dpMetricLastDate").innerText = c.lastHearingDate || "—";
        document.getElementById("dpMetricLastJudge").innerText = c.lastHearingJudge ? `Coram: ${c.lastHearingJudge}` : (c.lastProceeding ? `Proc: ${c.lastProceeding.substring(0, 35)}...` : "Coram: —");
        document.getElementById("dpMetricDaysSince").innerText = (c.daysSinceLastHearing !== null && c.daysSinceLastHearing !== undefined)
            ? `${c.daysSinceLastHearing} days since last listing`
            : "—";

        // KPI 3: Hearing Velocity & Count
        const totalCount = (hist && hist.length > 0) ? hist.length : (c.totalHearings || 0);
        document.getElementById("dpMetricTotalHearings").innerText = `${totalCount} Listed Hearings`;
        document.getElementById("dpMetricAvgInterval").innerText = c.avgDaysBetweenHearings ? `Avg interval: ~${c.avgDaysBetweenHearings} days` : "Avg interval: —";
        document.getElementById("dpMetricFirstDate").innerText = c.firstHearingDate ? `First listed: ${c.firstHearingDate}` : "First listed: —";

        // KPI 4: Assigned Desk / Court
        document.getElementById("dpMetricWorker").innerText = c.addedBy || c.caseWorkerName || "Unassigned Case Worker";
        document.getElementById("dpMetricEstName").innerText = c.courtEstablishmentName || c.courtEstName || "eCourts Gateway";
        document.getElementById("dpMetricSyncedAt").innerText = c.lastSyncedAt ? `Synced: ${new Date(c.lastSyncedAt).toLocaleString("en-GB")}` : "Verified eCourts Record";

        // Table Count
        document.getElementById("dpTableCount").innerText = totalCount;

        // Render Chronological Timeline Table
        const tbody = document.getElementById("dpProceedingsTbody");
        if (hist && hist.length > 0) {
            tbody.innerHTML = hist.map((h, i) => {
                const rawBus = (h.business_date || h.businessDate || h.cause_date || h.hist_date || "").trim();
                const rawHear = (h.hearing_date || h.hearingDate || "").trim();
                const rawNext = (h.next_date || h.nextDate || "").trim();

                const validBus = extractValidDate(rawBus);
                const validHear = extractValidDate(rawHear);
                const validNext = extractValidDate(rawNext);

                // Sitting date (when the court sat and business was transacted)
                const sittingDate = validBus || validHear || "";
                // Next date (when case is listed next)
                const nextDate = validNext || (rawNext && !rawNext.toLowerCase().includes("not given") ? rawNext : (rawHear && !rawHear.toLowerCase().includes("not given") && rawHear !== rawBus ? rawHear : "Next Date Not Given"));

                // Date to query for Roznama (the actual court sitting date)
                const targetQueryDate = sittingDate || validNext || "";

                const purpose = h.purpose_of_listing || h.purpose || h.stage || "—";
                const nextPurpose = h.next_purpose || h.nextPurpose || "—";
                const judge = h.judge || h.judge_name || h.judgeName || "—";
                const roznama = (h.business || h.roznama || h.proceeding || h.order || "").trim();

                const isLatest = (i === hist.length - 1);
                const rowClass = isLatest ? "table-warning bg-opacity-25" : "";

                const canFetch = !!targetQueryDate;
                const fetchBtnHtml = canFetch
                    ? (roznama 
                        ? `<button type="button" class="btn btn-xs btn-outline-success rounded-pill extra-small px-2 py-1 text-nowrap shadow-xs"
                                   onclick="fetchLiveHearingRoznama('${escapeJs(c.cnrNumber)}', '${escapeJs(targetQueryDate)}', ${c.isHighCourt ? 'true' : 'false'}, ${i})"
                                   title="Saved in Database. Click to re-verify live from eCourts">
                               <i class="bi bi-database-check me-1"></i>Saved in DB <i class="bi bi-arrow-repeat ms-0.5 opacity-75"></i>
                           </button>`
                        : `<button type="button" class="btn btn-xs btn-outline-primary rounded-pill extra-small px-2 py-1 text-nowrap shadow-xs"
                                   onclick="fetchLiveHearingRoznama('${escapeJs(c.cnrNumber)}', '${escapeJs(targetQueryDate)}', ${c.isHighCourt ? 'true' : 'false'}, ${i})">
                               <i class="bi bi-cloud-arrow-down-fill me-1"></i>Fetch Roznama
                           </button>`)
                    : `<button type="button" class="btn btn-xs btn-outline-secondary rounded-pill extra-small px-2 py-1 text-nowrap disabled opacity-50"
                               title="No calendar sitting date recorded for this hearing" disabled>
                           <i class="bi bi-slash-circle me-1"></i>No Date
                       </button>`;

                return `
                <tr class="${rowClass}" id="dpRow_${i}">
                    <td class="ps-3 text-muted fw-bold">
                        ${i + 1}
                        ${isLatest ? '<span class="badge bg-warning text-dark extra-small d-block" style="font-size: 9px;">LATEST</span>' : ''}
                    </td>
                    <td class="font-monospace fw-bold text-primary">${escapeHtml(sittingDate || rawBus || rawHear || "—")}</td>
