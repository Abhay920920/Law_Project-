        `;

        executePrintHtml(`NWKRTC_MyCases_${currentModule}_Report`, bodyHtml, 'landscape');
    }

    // ==========================================
    // Print Individual Case Legal Dossier
    // ==========================================
    async function printSingleCase(trackedId) {
        if (!trackedId) return;

        if (currentDossierTrackedId === trackedId && currentDossierObject) {
            printCurrentDossier();
            return;
        }

        showToast("Preparing Print", "Loading full case dossier from database...", true);

        try {
            const res = await fetch(`/ECourts/GetTrackedCaseDossier?trackedId=${trackedId}`);
            const data = await res.json();
            if (data && (data.data || data.raw || data.cnr)) {
                currentDossierObject = data;
                currentDossierTrackedId = trackedId;
                printCurrentDossier();
            } else {
                showToast("Print Error", "Could not retrieve full dossier for printing.", false);
            }
        } catch (err) {
            console.error("Error loading dossier for print:", err);
            showToast("Print Error", "Network error retrieving dossier.", false);
        }
    }

    function printCurrentDossier() {
        if (!currentDossierObject) {
            showToast("Notice", "No case dossier currently loaded.", false);
            return;
        }

        const dossier = currentDossierObject;
        const data = dossier.data || {};
        const raw = dossier.raw || {};
        const cnr = dossier.cnr || data.cnr_number || "—";
        const rawHistory = dossier.history || raw.history || [];
        const history = Array.isArray(rawHistory) ? rawHistory : (typeof rawHistory === 'object' && rawHistory !== null ? Object.values(rawHistory) : []);

        // Multi-source extraction for Orders in Print
        let printRawOrders = dossier.orders;
        if (!printRawOrders || (Array.isArray(printRawOrders) && printRawOrders.length === 0)) {
            printRawOrders = raw.orders || raw.order_details || raw.order || raw.case_orders || raw.interim_orders || [];
        }
        const orders = Array.isArray(printRawOrders) ? printRawOrders : (typeof printRawOrders === 'object' && printRawOrders !== null ? Object.values(printRawOrders) : []);

        // Multi-source extraction for IA and Processes in Print
        let printRawIa = dossier.ia_filings;
        if (!printRawIa || (Array.isArray(printRawIa) && printRawIa.length === 0)) {
            printRawIa = raw.iafiling || raw.ia_filing || raw.ia_filings || raw.ia_details || raw.ias || [];
        }
        const iaList = Array.isArray(printRawIa) ? printRawIa : (typeof printRawIa === 'object' && printRawIa !== null ? Object.values(printRawIa) : []);

        let printRawProc = dossier.processes;
        if (!printRawProc || (Array.isArray(printRawProc) && printRawProc.length === 0)) {
            printRawProc = raw.processes || raw.case_processes || raw.process || raw.process_details || raw.notice_details || raw.notices || raw.notice || raw.process_issued || [];
        }
        const processes = Array.isArray(printRawProc) ? printRawProc : (typeof printRawProc === 'object' && printRawProc !== null ? Object.values(printRawProc) : []);

        const rawActs = dossier.acts || raw.acts || [];
        const acts = Array.isArray(rawActs) ? rawActs : (typeof rawActs === 'object' && rawActs !== null ? Object.values(rawActs) : []);

        const isDisposed = (data.case_status || "").toLowerCase().includes("dispos");
        const statusBadge = isDisposed
            ? `<span class="badge-disposed" style="font-size: 10px; padding: 2px 8px;">DISPOSED</span>`
            : `<span class="badge-pending" style="font-size: 10px; padding: 2px 8px;">PENDING / ACTIVE</span>`;

        const printTime = new Date().toLocaleString("en-GB", {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit', hour12: true
        });

        // Transfer and Connected Cases extraction
        const transferEst = data.transfer_est || raw.transfer_est || (dossier.transfers && dossier.transfers.length > 0 ? (dossier.transfers[0].transfer_from_est || dossier.transfers[0].from_est) : null);
        const transferDate = data.transfer_date || raw.transfer_date || (dossier.transfers && dossier.transfers.length > 0 ? (dossier.transfers[0].transfer_date || dossier.transfers[0].date) : null);

        let linkedCasesStr = "—";
        if (dossier.linked_cases && dossier.linked_cases.length > 0) {
            linkedCasesStr = dossier.linked_cases.map(lc => lc.case_number || lc.cino || lc.reg_no || (typeof lc === 'string' ? lc : JSON.stringify(lc))).join(", ");
        } else if (raw.connected_cases || raw.connected_case) {
            linkedCasesStr = typeof raw.connected_cases === 'string' ? raw.connected_cases : JSON.stringify(raw.connected_cases);
        }

        // 1. Proceedings History Rows
        let historyRows = "";
        if (history.length > 0) {
            historyRows = history.map((h, i) => `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="text-center font-mono">${escapeHtml(h.business_date || "—")}</td>
                    <td class="text-center font-mono fw-bold" style="color: #0284c7;">${escapeHtml(h.hearing_date || "—")}</td>
                    <td>${escapeHtml(h.purpose_of_listing || h.purpose || "—")}</td>
                    <td class="text-center font-mono">${escapeHtml(h.next_date || "—")}</td>
                    <td>${escapeHtml(h.next_purpose || "—")}</td>
                    <td>${escapeHtml(h.judge || h.judge_name || "—")}</td>
                </tr>
            `).join("");
        } else {
            historyRows = `<tr><td colspan="7" class="text-center text-muted" style="padding: 10px;">No historical proceedings recorded in eCourts payload.</td></tr>`;
        }

        // 2. Orders & Judgements Rows
        let ordersRows = "";
        if (orders.length > 0) {
            ordersRows = orders.map((o, i) => `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="text-center font-mono">${escapeHtml(o.order_date || o.date || "—")}</td>
                    <td class="text-center font-mono fw-bold">${escapeHtml(o.order_number || o.order_no || `#${i+1}`)}</td>
                    <td>${escapeHtml(o.order_details || o.details || o.short_order || "—")}</td>
                    <td>${escapeHtml(o.judge_name || o.judge || "—")}</td>
                </tr>
            `).join("");
        } else {
            ordersRows = `<tr><td colspan="5" class="text-center text-muted" style="padding: 10px;">No formal court orders recorded yet.</td></tr>`;
        }

        // 3. IA Applications Rows
        let iaRows = "";
        if (iaList.length > 0) {
            iaRows = iaList.map((ia, i) => {
                let iaNo = ia.ia_number || ia.ia_no || ia.no || ia.ianumber || ia.ia_num || `IA #${i + 1}`;
                let classification = ia.classification || ia.ia_prayer || ia.prayer || ia.purpose || "";

                if (typeof iaNo === 'string') {
                    const classMatch = iaNo.match(/(?:<b>\s*)?classification\s*:\s*(?:<\/b>\s*)?([^<]+)/i);
                    if (classMatch && classMatch[1] && !classification) {
                        classification = classMatch[1].trim();
                    }
                    iaNo = iaNo.replace(/<\/?b>/gi, '').replace(/<\/?br\s*\/?>/gi, ' - ').replace(/classification\s*:\s*.*$/i, '').trim();
                    if (iaNo.endsWith('-')) iaNo = iaNo.slice(0, -1).trim();
                }

                const filingDate = formatDateSafe(ia.date_of_filing || ia.filing_date || ia.date || ia.filingdate);
                const party = ia.ia_pet_name || ia.party_name || ia.applicant || ia.party || ia.petitioner || "—";

                const st = (ia.ia_pend_disp || ia.status || ia.ia_status || "").trim().toUpperCase();
                let badge = `<span class="badge-pending">Recorded</span>`;
                if (st === "P" || st.includes("PEND")) {
                    badge = `<span class="badge-pending">Pending</span>`;
                } else if (st === "D" || st.includes("DISPOS") || st.includes("ALLOW")) {
                    badge = `<span class="badge-disposed">${st.includes("ALLOW") ? "Allowed" : "Disposed"}</span>`;
                } else if (st.includes("DISMISS") || st.includes("REJECT")) {
                    badge = `<span class="badge-disposed" style="color: #991b1b; background: #fee2e2;">Dismissed</span>`;
                }

                return `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="font-mono fw-bold" style="color: #0369a1;">${escapeHtml(iaNo)}</td>
                    <td class="text-center font-mono">${filingDate}</td>
                    <td>
                        <div class="fw-semibold text-dark">${escapeHtml(party)}</div>
                        ${classification ? `<div style="font-size: 8.5px; color: #475569; margin-top: 1px;"><strong style="color: #0284c7;">Purpose:</strong> ${escapeHtml(classification)}</div>` : ''}
                    </td>
                    <td class="text-center">${badge}</td>
                </tr>`;
            }).join("");
        } else {
            iaRows = `<tr><td colspan="5" class="text-center text-muted" style="padding: 10px;">No interim applications recorded in eCourts payload.</td></tr>`;
        }

        // 4. Process Rows
        let processRows = "";
        if (processes.length > 0) {
            processRows = processes.map((p, i) => {
                const procId = p.process_id || p.process_no || p.id || p.sr_no || p.processid || `P-${i + 1}`;
                const pTitle = p.process_title || p.title || p.process_name || p.name || p.details || p.notice_title || "Notice / Process";
                const pParty = p.party_name || p.recipient || p.issued_to || p.pet_name || p.res_name || p.party || "";
                const pDate = formatDateSafe(p.issue_date || p.process_date || p.date || p.issued_date || p.dispatch_date);
                const rDate = p.return_date || p.next_date || "";
                const nType = p.notice_type || p.type || p.process_type || p.status || p.process_status || "Process Issued";

                return `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="text-center font-mono fw-bold">${escapeHtml(procId)}</td>
                    <td>
                        <div class="fw-semibold text-dark">${escapeHtml(pTitle)}</div>
                        ${pParty ? `<div style="font-size: 8.5px; color: #475569;">Issued To: <strong>${escapeHtml(pParty)}</strong></div>` : ''}
                        ${rDate ? `<div style="font-size: 8.5px; color: #64748b;">Return Date: ${escapeHtml(formatDateSafe(rDate))}</div>` : ''}
                    </td>
                    <td class="text-center font-mono">${pDate}</td>
                    <td class="text-center"><span class="badge-court-dc">${escapeHtml(nType)}</span></td>
                </tr>`;
            }).join("");
        } else {
            processRows = `<tr><td colspan="5" class="text-center text-muted" style="padding: 10px;">No process notices recorded in eCourts payload.</td></tr>`;
        }

        // 5. Acts Rows
        let actsRows = "";
        if (acts.length > 0) {
            actsRows = acts.map((a, i) => `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="fw-semibold">${escapeHtml(a.act || a.act_name || "—")}</td>
                    <td class="font-mono">${escapeHtml(a.section || "—")}</td>
                </tr>
            `).join("");
        } else {
            actsRows = `<tr><td colspan="3" class="text-center text-muted" style="padding: 10px;">No statutory acts recorded.</td></tr>`;
        }

        const bodyHtml = `
        <div class="official-header">
            <div>
                <div class="corp-kannada">ವಾಯವ್ಯ ಕರ್ನಾಟಕ ರಸ್ತೆ ಸಾರಿಗೆ ಸಂಸ್ಥೆ - ಕಾನೂನು ಶಾಖೆ</div>
                <h1 class="corp-title">North Western Karnataka Road Transport Corporation</h1>
                <div class="doc-title">Central Law Cell — Official Judicial Case Dossier</div>
            </div>
            <div class="text-end">
                <div>${statusBadge}</div>
                <div class="text-muted" style="font-size: 8.5px; margin-top: 3px;">
                    Dossier Printed: <strong>${printTime}</strong>
                </div>
            </div>
        </div>

        <!-- CNR Banner -->
        <div class="meta-container" style="background: #f1f5f9; border-color: #94a3b8; margin-bottom: 10px;">
            <div>
                <span class="text-muted text-uppercase" style="font-size: 8.5px; font-weight: 700;">CNR Number:</span>
                <span class="font-mono fw-bold" style="font-size: 12px; margin-left: 4px; color: #0f172a;">${escapeHtml(cnr)}</span>
            </div>
            <div>
                <span class="text-muted text-uppercase" style="font-size: 8.5px; font-weight: 700;">Case:</span>
                <span class="fw-bold" style="font-size: 12px; margin-left: 4px; color: #0369a1;">${escapeHtml(data.case_type || "Case")} ${escapeHtml(data.case_number || "—")}</span>
            </div>
            <div>
                <span class="text-muted text-uppercase" style="font-size: 8.5px; font-weight: 700;">Court:</span>
                <span class="fw-semibold" style="font-size: 10.5px; margin-left: 4px;">${escapeHtml(data.establishment_name || raw.court_est_name || "—")}</span>
            </div>
        </div>

        <!-- Section 1: Registration & Court Details (Rigid 4-Column Key-Value Table) -->
        <div class="dossier-card">
            <div class="dossier-card-header">1. Case Registration & Court Information</div>
