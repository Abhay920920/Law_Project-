        let benchDesc = raw.bench_name || (raw.bench_type == 1 ? "Single Bench" : raw.bench_type == 2 ? "Division Bench" : raw.bench_type == 3 ? "Full Bench" : "—");
        document.getElementById("dBenchType").innerText = benchDesc;
        document.getElementById("dStateDist").innerText = `${raw.state_name || "—"}, ${raw.dist_name || "—"}`;

        // Metadata
        document.getElementById("dNatureDisposal").innerText = data.nature_of_disposal || raw.disposal_type || "—";
        document.getElementById("dJudicialBranch").innerText = raw.judicial_branch || "—";
        document.getElementById("dCauselistType").innerText = raw.causelist_type || "—";
        document.getElementById("dMainMatterCnr").innerText = raw.main_matter_cino || "—";
        document.getElementById("dLowerCourt").innerText = raw.lower_court_name || "—";
        document.getElementById("dLowerCourtCaseNo").innerText = raw.lower_court_caseno ? `${raw.lower_court_caseno}${raw.lower_court_dec_dt ? ' (Decided: ' + raw.lower_court_dec_dt + ')' : ''}` : (data.lower_court_caseno || "—");

        const transferEst = data.transfer_est || raw.transfer_est || (dossier.transfers && dossier.transfers.length > 0 ? (dossier.transfers[0].transfer_from_est || dossier.transfers[0].from_est) : null);
        const transferEstEl = document.getElementById("dTransferEst");
        if (transferEstEl) transferEstEl.innerText = transferEst || "—";

        const transferDate = data.transfer_date || raw.transfer_date || (dossier.transfers && dossier.transfers.length > 0 ? (dossier.transfers[0].transfer_date || dossier.transfers[0].date) : null);
        const transferDateEl = document.getElementById("dTransferDate");
        if (transferDateEl) transferDateEl.innerText = transferDate || "—";

        let linkedCasesStr = "—";
        if (dossier.linked_cases && dossier.linked_cases.length > 0) {
            linkedCasesStr = dossier.linked_cases.map(lc => lc.case_number || lc.cino || lc.reg_no || JSON.stringify(lc)).join(", ");
        } else if (raw.connected_cases || raw.connected_case) {
            linkedCasesStr = typeof raw.connected_cases === 'string' ? raw.connected_cases : JSON.stringify(raw.connected_cases);
        }
        const linkedEl = document.getElementById("dConnectedCases");
        if (linkedEl) linkedEl.innerText = linkedCasesStr;

        const rawJsonEl = document.getElementById("dossierRawJsonPre");
        if (rawJsonEl) rawJsonEl.innerText = currentRawJsonString || JSON.stringify(dossier, null, 2);

        // Parties Helper
        function formatExtraParties(val) {
            if (!val) return "None";
            if (typeof val === 'string') return val;
            if (typeof val === 'object') {
                const arr = Object.values(val).filter(v => typeof v === 'string' && v.trim().length > 0);
                return arr.length > 0 ? arr.join(", ") : "None";
            }
            return String(val);
        }

        document.getElementById("dPetName").innerText = data.petitioner || raw.pet_name || "—";
        document.getElementById("dPetAdv").innerText = data.petitioner_advocate || raw.pet_adv || "Not Assigned / In Person";
        document.getElementById("dPetExtra").innerText = formatExtraParties(raw.pet_extra_party);

        document.getElementById("dResName").innerText = data.respondent || raw.res_name || "—";
        document.getElementById("dResAdv").innerText = data.respondent_advocate || raw.res_adv || "Not Assigned / In Person";
        document.getElementById("dResExtra").innerText = formatExtraParties(raw.res_extra_party || data.extra_party);

        // Proceedings History
        const history = dossier.history || [];
        document.getElementById("dossierHistoryCount").innerText = history.length;
        const tbodyH = document.getElementById("dTbodyHistory");
        if (history.length > 0) {
            tbodyH.innerHTML = history.map((h, i) => `
                <tr>
                    <td class="text-muted fw-bold">${i + 1}</td>
                    <td class="font-monospace">${h.business_date || "—"}</td>
                    <td class="font-monospace fw-bold text-primary">${h.hearing_date || "—"}</td>
                    <td>${h.purpose_of_listing || h.purpose || "—"}</td>
                    <td class="font-monospace">${h.next_date || "—"}</td>
                    <td>${h.next_purpose || "—"}</td>
                    <td>${h.judge || h.judge_name || "—"}</td>
                </tr>
            `).join("");
        } else {
            tbodyH.innerHTML = `<tr><td colspan="7" class="text-center text-muted py-4">No proceedings records found in eCourts payload.</td></tr>`;
        }

        // Orders
        const orders = dossier.orders || [];
        document.getElementById("dossierOrdersCount").innerText = orders.length;
        const tbodyO = document.getElementById("dTbodyOrders");
        if (orders.length > 0) {
            tbodyO.innerHTML = orders.map((o, i) => {
                const pdfLink = o.order_pdf_url || o.pdf_url || o.order_link;
                const actionBtn = pdfLink
                    ? `<a href="${pdfLink}" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 extra-small"><i class="bi bi-file-earmark-pdf me-1"></i>View PDF</a>`
                    : `<span class="badge bg-light text-muted border extra-small">No PDF</span>`;

                return `
                <tr>
                    <td class="text-muted fw-bold">${i + 1}</td>
                    <td class="font-monospace">${o.order_date || o.date || "—"}</td>
                    <td class="font-monospace fw-bold">${o.order_number || o.order_no || `#${i+1}`}</td>
                    <td>${o.order_details || o.details || o.short_order || "—"}</td>
                    <td>${o.judge_name || o.judge || "—"}</td>
                    <td class="text-end">${actionBtn}</td>
                </tr>`;
            }).join("");
        } else {
            tbodyO.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">No formal court orders uploaded yet.</td></tr>`;
        }

        // IA Filings Helper Extraction with multi-source fallback
        let rawIa = dossier.ia_filings;
        if (!rawIa || (Array.isArray(rawIa) && rawIa.length === 0)) {
            rawIa = raw.iafiling || raw.ia_filing || raw.ia_filings || raw.ia_details || raw.ias || raw.interim_application || raw.interim_applications || [];
        }
        let iaList = [];
        if (Array.isArray(rawIa)) {
            iaList = rawIa;
        } else if (typeof rawIa === 'object' && rawIa !== null) {
            iaList = Object.values(rawIa);
        }

        document.getElementById("dossierIaCount").innerText = iaList.length;
        const tbodyIa = document.getElementById("dTbodyIa");
        if (iaList.length > 0) {
            tbodyIa.innerHTML = iaList.map((ia, i) => {
                let iaNo = ia.ia_number || ia.ia_no || ia.no || ia.ianumber || ia.ia_num || `IA #${i + 1}`;
                let classification = ia.classification || ia.ia_prayer || ia.prayer || ia.purpose || "";

                if (typeof iaNo === 'string') {
                    const classMatch = iaNo.match(/(?:<b>\s*)?classification\s*:\s*(?:<\/b>\s*)?([^<]+)/i);
                    if (classMatch && classMatch[1] && !classification) {
                        classification = classMatch[1].trim();
                    }
                    iaNo = iaNo.replace(/<\/?b>/gi, '').replace(/<\/?br\s*\/?>/gi, ' - ').replace(/classification\s*:\s*.*$/i, '').trim();
                    if (iaNo.endsWith('-')) iaNo = iaNo.slice(0, -1).trim();
                }

                const filingDate = formatDateSafe(ia.date_of_filing || ia.filing_date || ia.date || ia.filingdate);
                const party = ia.ia_pet_name || ia.party_name || ia.applicant || ia.party || ia.petitioner || "—";

                const st = (ia.ia_pend_disp || ia.status || ia.ia_status || "").trim().toUpperCase();
                let badge = `<span class="badge bg-secondary-subtle text-secondary border extra-small">Recorded</span>`;
                if (st === "P" || st.includes("PEND")) {
                    badge = `<span class="badge bg-warning-subtle text-dark border border-warning extra-small">Pending</span>`;
                } else if (st === "D" || st.includes("DISPOS")) {
                    badge = `<span class="badge bg-success-subtle text-success border border-success extra-small">Disposed</span>`;
                } else if (st.includes("ALLOW")) {
                    badge = `<span class="badge bg-primary-subtle text-primary border border-primary extra-small">Allowed</span>`;
                } else if (st.includes("DISMISS") || st.includes("REJECT")) {
                    badge = `<span class="badge bg-danger-subtle text-danger border border-danger extra-small">Dismissed</span>`;
                }

                return `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="font-monospace fw-bold text-primary">${escapeHtml(iaNo)}</td>
                    <td class="font-monospace">${filingDate}</td>
                    <td>
                        <div class="fw-semibold text-dark">${escapeHtml(party)}</div>
                        ${classification ? `<div class="extra-small text-muted mt-0.5"><span class="badge bg-light text-primary border me-1 fw-bold">Classification</span>${escapeHtml(classification)}</div>` : ''}
                    </td>
                    <td class="text-center">${badge}</td>
                </tr>`;
            }).join("");
        } else {
            tbodyIa.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No interim applications recorded in eCourts payload.</td></tr>`;
        }

        // Processes Helper Extraction with multi-source fallback
        let rawProc = dossier.processes;
        if (!rawProc || (Array.isArray(rawProc) && rawProc.length === 0)) {
            rawProc = raw.processes || raw.case_processes || raw.process || raw.process_details || raw.notice_details || raw.notices || raw.notice || raw.process_issued || raw.case_process || [];
        }
        let processes = [];
        if (Array.isArray(rawProc)) {
            processes = rawProc;
        } else if (typeof rawProc === 'object' && rawProc !== null) {
            processes = Object.values(rawProc);
        }

        document.getElementById("dossierProcessCount").innerText = processes.length;
        const tbodyProc = document.getElementById("dTbodyProcess");
        if (processes.length > 0) {
            tbodyProc.innerHTML = processes.map((p, i) => {
                const procId = p.process_id || p.process_no || p.id || p.sr_no || p.processid || `P-${i + 1}`;
                const pTitle = p.process_title || p.title || p.process_name || p.name || p.details || p.notice_title || "Notice / Process";
                const pParty = p.party_name || p.recipient || p.issued_to || p.pet_name || p.res_name || p.party || "";
                const pDate = formatDateSafe(p.issue_date || p.process_date || p.date || p.issued_date || p.dispatch_date);
                const rDate = p.return_date || p.next_date || "";
                const nType = p.notice_type || p.type || p.process_type || p.status || p.process_status || "Process Issued";

                return `
                <tr>
                    <td class="text-center fw-bold text-muted">${i + 1}</td>
                    <td class="font-monospace fw-bold text-primary">${escapeHtml(procId)}</td>
                    <td>
                        <div class="fw-semibold text-dark">${escapeHtml(pTitle)}</div>
                        ${pParty ? `<div class="extra-small text-muted mt-0.5"><i class="bi bi-person me-1"></i>Issued To: <strong>${escapeHtml(pParty)}</strong></div>` : ''}
                        ${rDate ? `<div class="extra-small text-muted">Return Date: ${escapeHtml(formatDateSafe(rDate))}</div>` : ''}
                    </td>
                    <td class="font-monospace">${pDate}</td>
                    <td><span class="badge bg-light text-dark border extra-small">${escapeHtml(nType)}</span></td>
                </tr>`;
            }).join("");
        } else {
            tbodyProc.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No process notices recorded in eCourts payload.</td></tr>`;
        }

        // Acts
        const acts = dossier.acts || [];
        const tbodyActs = document.getElementById("dTbodyActs");
        if (acts.length > 0) {
            tbodyActs.innerHTML = acts.map((a, i) => `
                <tr>
                    <td class="text-muted fw-bold">${i + 1}</td>
                    <td class="fw-semibold">${a.act || a.act_name || "—"}</td>
                    <td class="font-monospace">${a.section || "—"}</td>
                </tr>
            `).join("");
        } else {
            tbodyActs.innerHTML = `<tr><td colspan="3" class="text-center text-muted py-4">No statutory acts recorded.</td></tr>`;
        }

        // 8. Initialize Cause List & Court Hall live inspection tab
        const clDateInput = document.getElementById("dCauselistDateInput");
        if (clDateInput) {
            let defaultDate = "";
            if (data.next_hearing_date && data.next_hearing_date.includes('-')) {
                const parts = data.next_hearing_date.split('T')[0].split('-');
                if (parts.length === 3 && parts[0].length === 2) {
                    defaultDate = `${parts[0]}-${parts[1]}-${parts[2]}`;
                } else if (parts.length === 3 && parts[0].length === 4) {
                    defaultDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
                }
            }
            if (!defaultDate) {
                const now = new Date();
                const dd = String(now.getDate()).padStart(2, '0');
                const mm = String(now.getMonth() + 1).padStart(2, '0');
                defaultDate = `${dd}-${mm}-${now.getFullYear()}`;
            }
            clDateInput.value = defaultDate;
        }

        // Auto load cause list details for this case
        loadCaseCauseListInModal(currentDossierTrackedId, cnr);
    }

