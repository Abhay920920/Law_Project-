    // ==========================================
    // Export Filtered Cases to CSV
    // ==========================================
    function exportToCsv() {
        if (!allCasesData || allCasesData.length === 0) {
            showToast("Export", "No case records to export.", false);
            return;
        }

        const query = (document.getElementById("caseSearchInput").value || "").trim().toLowerCase();
        const selectedFilter = document.querySelector('input[name="statusFilter"]:checked')?.value || "all";
        const preset = document.getElementById("hearingDatePreset")?.value || "all";
        const fromVal = document.getElementById("hearingDateFrom")?.value || "";
        const toVal = document.getElementById("hearingDateTo")?.value || "";
        const todayStr = new Date().toISOString().split('T')[0];

        const toExport = allCasesData.filter(c => {
            if (query) {
                const searchStr = `${c.cnrNumber || ""} ${getDisplayCaseType(c)} ${c.caseTypeCode || ""} ${c.caseNumber || ""} ${c.caseYear || ""} ${c.petitioner || ""} ${c.respondent || ""} ${c.courtNo || ""} ${c.judgeDesignation || ""}`.toLowerCase();
                if (!searchStr.includes(query)) return false;
            }
            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
            if (selectedFilter === "disposed" && !isDisposed) return false;
            if (selectedFilter === "pending" && isDisposed) return false;
            if (selectedFilter === "upcoming") {
                if (!c.nextHearingDate) return false;
                if (c.nextHearingDate.split('T')[0] < todayStr) return false;
            }
            const hDate = c.nextHearingDate ? c.nextHearingDate.split('T')[0] : null;
            if (preset === "unscheduled") {
                if (hDate) return false;
            } else if (preset === "overdue") {
                if (!hDate || hDate >= todayStr || isDisposed) return false;
            } else {
                if (fromVal && (!hDate || hDate < fromVal)) return false;
                if (toVal && (!hDate || hDate > toVal)) return false;
            }
            return true;
        });

        const headers = ["#", "CNR Number", "Case Type", "Case Number", "Year", "Court", "Judge", "Petitioner", "Respondent", "Next Hearing Date", "Stage/Purpose", "Status", "Last Synced"];
        const rows = toExport.map((c, i) => [
            i + 1,
            `"${c.cnrNumber || ""}"`,
            `"${getDisplayCaseType(c)}"`,
            `"${c.caseNumber || ""}"`,
            `"${c.caseYear || ""}"`,
            `"${(c.courtNo || "").replace(/"/g, '""')}"`,
            `"${(c.judgeDesignation || "").replace(/"/g, '""')}"`,
            `"${(c.petitioner || "").replace(/"/g, '""')}"`,
            `"${(c.respondent || "").replace(/"/g, '""')}"`,
            `"${c.nextHearingDate ? c.nextHearingDate.split('T')[0] : ""}"`,
            `"${(c.stagePurpose || "").replace(/"/g, '""')}"`,
            `"${(c.caseStatus || "").replace(/"/g, '""')}"`,
            `"${c.lastSyncedAt || ""}"`
        ]);

        const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `MyCases_${currentModule}_${new Date().toISOString().split('T')[0]}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showToast("Export Complete", `Exported ${toExport.length} cases to CSV.`, true);
    }

    // ==========================================
    // Add CNR Numbers logic
    // ==========================================
    function onCnrInputChanged() {
        const val = document.getElementById("bulkCnrTextarea").value || "";
        const matches = val.match(/[A-Za-z0-9]{16}/g) || [];
        const unique = [...new Set(matches.map(m => m.toUpperCase()))];
        const badge = document.getElementById("detectedCnrsBadge");
        if (unique.length > 0) {
            badge.innerText = `${unique.length} valid CNR(s) detected`;
            badge.className = "badge bg-success-subtle text-success border border-success small";
        } else {
            badge.innerText = `0 valid CNR(s) detected`;
            badge.className = "badge bg-secondary-subtle text-dark border small";
        }
    }

    function insertSampleCnr() {
        const textarea = document.getElementById("bulkCnrTextarea");
        textarea.value = (textarea.value.trim() ? textarea.value.trim() + "\n" : "") + "KAHC020060752019";
        onCnrInputChanged();
    }

    function clearCnrInput() {
        document.getElementById("bulkCnrTextarea").value = "";
        onCnrInputChanged();
        document.getElementById("addCnrResultAlert").className = "d-none mt-3 alert mb-0";
    }

    async function submitAddCnrs() {
        const text = document.getElementById("bulkCnrTextarea").value || "";
        const btn = document.getElementById("btnSubmitAddCnrs");
        const progressBox = document.getElementById("addCnrProgressContainer");
        const alertBox = document.getElementById("addCnrResultAlert");

        const matches = text.match(/[A-Za-z0-9]{16}/g) || [];
        const unique = [...new Set(matches.map(m => m.toUpperCase()))];

        if (unique.length === 0) {
            alertBox.className = "mt-3 alert alert-danger mb-0 small";
            alertBox.innerText = "Please enter at least one valid 16-character CNR number (e.g. KAHC020060752019).";
            return;
        }

        btn.disabled = true;
        progressBox.classList.remove("d-none");
        alertBox.className = "d-none mt-3 alert mb-0";

        try {
            const res = await fetch("/ECourts/AddTrackedCnrs", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ cnrNumbers: unique.join("\n"), module: currentModule })
            });

            const json = await res.json();
            progressBox.classList.add("d-none");
            btn.disabled = false;

            if (json.success) {
                alertBox.className = "mt-3 alert alert-success mb-0 small";
                let msg = `<strong>Success!</strong> ${json.message}`;
                if (json.failed && json.failed.length > 0) {
                    msg += `<div class="mt-1 text-danger">Failed / Not Found: ${json.failed.map(f => f.cnr).join(", ")}</div>`;
                }
                alertBox.innerHTML = msg;

                // Reload table
                loadTrackedCases();
                showToast("Cases Added", `${json.added} new case(s) tracked.`, true);

                setTimeout(() => {
                    const modalEl = document.getElementById('addCnrModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal && json.added > 0) {
                        modal.hide();
                        clearCnrInput();
                    }
                }, 1600);
            } else {
                alertBox.className = "mt-3 alert alert-danger mb-0 small";
                alertBox.innerText = json.message || "Failed to process CNR numbers.";
            }
        } catch (err) {
            progressBox.classList.add("d-none");
            btn.disabled = false;
            alertBox.className = "mt-3 alert alert-danger mb-0 small";
            alertBox.innerText = "Network or server error while connecting to eCourts Gateway.";
        }
    }

    // ==========================================
    // Sync single case live
    // ==========================================
    async function syncCaseLive(trackedId) {
        const btn = document.getElementById(`btnSync_${trackedId}`);
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span>`;
        }

        try {
            const res = await fetch(`/ECourts/RefreshTrackedCnr?trackedId=${trackedId}`, { method: "POST" });
            const json = await res.json();

            if (json.success) {
                showToast("Live Sync Complete", "Case record updated from live eCourts Gateway.", true);
                loadTrackedCases();
            } else {
                showToast("Sync Error", json.message || "Failed to fetch live eCourts update.", false);
            }
        } catch (err) {
            showToast("Sync Error", "Network error during eCourts refresh.", false);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<i class="bi bi-arrow-clockwise"></i>`;
            }
        }
    }

    // ==========================================
    // Remove Case from My Cases
    // ==========================================
    async function removeCase(trackedId, cnr) {
        if (!confirm(`Are you sure you want to remove CNR ${cnr} from My Cases?`)) return;

        try {
            const res = await fetch(`/ECourts/DeleteTrackedCnr?trackedId=${trackedId}`, { method: "POST" });
            const json = await res.json();
            if (json.success) {
                showToast("Case Removed", `CNR ${cnr} was removed from your tracked cases.`, true);
                loadTrackedCases();
            } else {
                showToast("Error", json.message || "Failed to remove case.", false);
            }
        } catch (err) {
            showToast("Error", "Network error during removal.", false);
        }
    }

    // ==========================================
    // Open Comprehensive Case Dossier Modal
    // ==========================================
    let currentRawJsonString = "";

    async function openCaseDossier(trackedId) {
        currentDossierTrackedId = trackedId;
        const modalEl = document.getElementById('myCaseDossierModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        // Reset views
        document.getElementById("dossierModalTitle").innerText = "Loading Case Dossier...";
        document.getElementById("dossierCnrBadge").innerText = "CNR: —";

        try {
            const res = await fetch(`/ECourts/GetTrackedCaseDossier?trackedId=${trackedId}`);
            const data = await res.json();
            currentRawJsonString = JSON.stringify(data, null, 2);

            populateDossierModal(data);
        } catch (err) {
            console.error("Error loading dossier:", err);
            document.getElementById("dossierModalTitle").innerText = "Error Loading Dossier";
            document.getElementById("dossierRawJsonPre").innerText = "Failed to load dossier data.";
        }
    }

    function populateDossierModal(dossier) {
        currentDossierObject = dossier;
        const data = dossier.data || {};
        const raw = dossier.raw || {};
        const cnr = dossier.cnr || data.cnr_number || "—";

        const isHc = (cnr && (cnr.startsWith("HC") || cnr.substring(2, 4) === "HC")) ||
                     (data.establishment_name || "").toLowerCase().includes("high court") ||
                     (raw.court_est_name || "").toLowerCase().includes("high court");
        let displayType = (data.case_type || "").trim();
        if ((currentModule || "").toLowerCase() === "labour") {
            if (!displayType || displayType === "MFA" || displayType === "MVC" || displayType === "Case" || displayType === "0") {
                displayType = isHc ? "WP" : "KID";
            }
        } else if (!displayType || displayType === "Case" || displayType === "0") {
            displayType = isHc ? "MFA" : "MVC";
        }

        document.getElementById("dossierModalTitle").innerText = `${displayType} ${data.case_number || ""} — Dossier`;
        document.getElementById("dossierCnrBadge").innerText = `CNR: ${cnr}`;

        const isDisposed = (data.case_status || "").toLowerCase().includes("dispos");
        const statusBadge = document.getElementById("dossierStatusBadge");
        statusBadge.className = isDisposed ? "badge bg-success" : "badge bg-warning text-dark";
        statusBadge.innerText = data.case_status || "Pending";

        document.getElementById("dossierSubtitle").innerText = `${data.establishment_name || "High Court of Karnataka"} — Live NAPIX Sync: ${dossier.synced_at || "Recent"}`;

