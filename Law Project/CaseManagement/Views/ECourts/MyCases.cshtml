                    <td class="font-monospace fw-bold ${nextDate !== '—' && !nextDate.toLowerCase().includes('not given') ? 'text-success' : 'text-muted'}">${escapeHtml(nextDate)}</td>
                    <td class="small text-muted">${escapeHtml(nextPurpose)}</td>
                    <td class="small text-truncate" style="max-width: 160px;" title="${escapeHtml(judge)}">${escapeHtml(judge)}</td>
                    <td class="small" style="max-width: 260px;">
                        <div id="dpRoznamaCell_${i}" class="text-break" style="font-size: 11.5px; line-height: 1.45;">
                            ${roznama 
                                ? `<div class="d-flex align-items-center gap-1 mb-1"><span class="badge bg-success-subtle text-success border border-success extra-small py-0.5 px-1.5"><i class="bi bi-database-fill-check me-1"></i>Stored in DB</span></div><div class="font-monospace text-dark">${escapeHtml(roznama)}</div>` 
                                : '<span class="text-muted fst-italic"><i class="bi bi-hourglass-split me-1"></i>No offline roznama text</span>'}
                        </div>
                    </td>
                    <td class="text-end pe-3">
                        ${fetchBtnHtml}
                    </td>
                </tr>`;
            }).join("");
        } else {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted"><i class="bi bi-calendar-x fs-4 d-block mb-2 text-secondary"></i>No daily proceedings or hearing history recorded in eCourts repository yet.</td></tr>`;
        }
    }

    function extractValidDate(str) {
        if (!str || typeof str !== 'string') return "";
        const s = str.trim();
        if (!s || s === "—" || s === "-" || s === "--") return "";
        const lower = s.toLowerCase();
        if (lower.includes("not given") || lower.includes("next date") || lower.includes("pending") || lower.includes("awaited") || lower.includes("sine die") || lower.includes("null")) return "";
        const m = s.match(/\b(\d{4}[-/.]\d{1,2}[-/.]\d{1,2}|\d{1,2}[-/.]\d{1,2}[-/.]\d{4})\b/);
        return m ? m[1] : "";
    }

    function getHearingUrgencyBadge(urgency, days) {
        if (!urgency) return `<span class="badge bg-light text-muted border extra-small">Unscheduled</span>`;
        switch (urgency.toUpperCase()) {
            case "TODAY":
                return `<span class="badge bg-danger text-white extra-small"><i class="bi bi-fire me-1"></i>TODAY</span>`;
            case "TOMORROW":
                return `<span class="badge bg-warning text-dark extra-small"><i class="bi bi-lightning-fill me-1"></i>TOMORROW</span>`;
            case "THIS_WEEK":
                return `<span class="badge bg-info text-dark extra-small"><i class="bi bi-calendar-event me-1"></i>THIS WEEK (${days}d left)</span>`;
            case "THIS_MONTH":
                return `<span class="badge bg-primary text-white extra-small"><i class="bi bi-calendar3 me-1"></i>IN ${days} DAYS</span>`;
            case "UPCOMING":
                return `<span class="badge bg-primary text-white extra-small"><i class="bi bi-calendar3 me-1"></i>IN ${days} DAYS</span>`;
            case "OVERDUE":
                return `<span class="badge bg-danger text-white extra-small"><i class="bi bi-exclamation-triangle-fill me-1"></i>OVERDUE (${Math.abs(days)}d ago)</span>`;
            case "DISPOSED":
                return `<span class="badge bg-secondary text-white extra-small"><i class="bi bi-check-circle-fill me-1"></i>DISPOSED</span>`;
            default:
                return `<span class="badge bg-light text-muted border extra-small">Unscheduled</span>`;
        }
    }

    // ==========================================
    // Fetch Live Hearing Roznama (NAPIX Gateway)
    // ==========================================
    async function fetchLiveHearingRoznama(cnrNumber, hearingDate, isHighCourt, rowIndex) {
        if (!cnrNumber) {
            showToast("Invalid Request", "CNR number is required to fetch verbatim proceeding.", false);
            return;
        }

        let targetDt = extractValidDate(hearingDate);
        if (!targetDt) {
            if (currentProceedingsCase && currentProceedingsCase.lastHearingDate) {
                targetDt = extractValidDate(currentProceedingsCase.lastHearingDate);
            }
            if (!targetDt && currentProceedingsList && currentProceedingsList.length > 0) {
                for (const item of currentProceedingsList) {
                    const cDt = extractValidDate(item.business_date || item.businessDate || item.hearing_date || item.hearingDate);
                    if (cDt) {
                        targetDt = cDt;
                        break;
                    }
                }
            }
        }

        if (!targetDt) {
            showToast("Invalid Date", `Cannot query Roznama: "${hearingDate}" is not a calendar date and no sitting date was found.`, false);
            return;
        }

        const liveSection = document.getElementById("dpLiveRoznamaSection");
        const liveDateLabel = document.getElementById("dpLiveHearingDateLabel");
        const liveText = document.getElementById("dpLiveRoznamaText");

        liveSection.classList.remove("d-none");
        liveDateLabel.innerText = `Hearing Date: ${targetDt} (CNR: ${cnrNumber})`;
        liveText.innerHTML = `<span class="spinner-border spinner-border-sm me-2 text-primary"></span>Connecting to live e-Courts NAPIX Gateway for verbatim roznama...`;

        liveSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        try {
            const url = `/ECourts/FetchLiveHearingProceeding?cnrNumber=${encodeURIComponent(cnrNumber)}&hearingDate=${encodeURIComponent(targetDt)}&isHighCourt=${isHighCourt}&module=${encodeURIComponent(currentModule)}`;
            const res = await fetch(url);
            const json = await res.json();

            if (json.success) {
                const bData = json.data || {};
                const businessText = (json.business || bData.business || bData.roznama || bData.proceeding || "").trim();
                const returnDate = json.date || targetDt;
                if (businessText) {
                    liveText.innerText = businessText;
                    showToast("Roznama Fetched", `Verbatim proceeding for ${returnDate} fetched and saved to registry.`, true);

                    // Update live cell in modal timeline table
                    if (rowIndex !== null && rowIndex !== undefined) {
                        const cell = document.getElementById(`dpRoznamaCell_${rowIndex}`);
                        if (cell) {
                            cell.innerHTML = `<strong class="text-success"><i class="bi bi-check2 me-1"></i>Live Fetched &amp; Saved:</strong><br>${escapeHtml(businessText)}`;
                        }
                    }

                    // Update in-memory caches in allCasesData and currentProceedingsList
                    const foundCase = allCasesData.find(x => x.cnrNumber === cnrNumber);
                    if (foundCase) {
                        foundCase.lastProceeding = businessText;
                        if (foundCase.proceedingsHistory) {
                            const pItem = foundCase.proceedingsHistory.find(h => {
                                const hDt = extractValidDate(h.business_date || h.businessDate || h.hearing_date || h.hearingDate);
                                return hDt === returnDate;
                            });
                            if (pItem) {
                                pItem.business = businessText;
                                pItem.roznama = businessText;
                            }
                        }
                    }
                    if (currentProceedingsList && rowIndex !== null && rowIndex !== undefined && currentProceedingsList[rowIndex]) {
                        currentProceedingsList[rowIndex].business = businessText;
                        currentProceedingsList[rowIndex].roznama = businessText;
                    }
                } else {
                    const stagePurpose = json.purpose || bData.purpose || bData.stage || bData.short_order_det || "—";
                    const nextDateStr = json.nextDate || bData.next_date || bData.nextDate || "—";
                    const fallbackInfo = `e-Courts recorded purpose: "${stagePurpose}" | Next Date: "${nextDateStr}"\nNo separate long-form written roznama text was recorded by the bench clerk on NJDG for this date.`;
                    liveText.innerText = fallbackInfo;
                    showToast("Notice", `Hearing details retrieved, but no separate verbatim roznama text was recorded.`, true);
                }
            } else {
                liveText.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>${escapeHtml(json.message || "e-Courts live gateway returned no proceeding details for this date.")}</span>`;
                showToast("Fetch Failed", json.message || "Failed to query e-Courts.", false);
            }
        } catch (err) {
            console.error("Error fetching live roznama:", err);
            liveText.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Network error communicating with server gateway.</span>`;
            showToast("Network Error", "Failed to connect to eCourts gateway.", false);
        }
    }

    function closeLiveRoznamaBox() {
        const liveSection = document.getElementById("dpLiveRoznamaSection");
        if (liveSection) liveSection.classList.add("d-none");
    }

    // ==========================================
    // Fetch ALL Case Proceedings and Store in DB
    // ==========================================
    async function fetchAllCaseRoznamas(isAuto = false) {
        if (!currentProceedingsTrackedId) return;

        const btnHeader = document.getElementById("btnHeaderFetchAllRoznamas");
        const btnTable = document.getElementById("btnFetchAllProceedings");

        if (btnHeader) {
            btnHeader.disabled = true;
            btnHeader.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Fetching All...`;
        }
        if (btnTable) {
            btnTable.disabled = true;
            btnTable.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Fetching All Roznamas...`;
        }

        if (!isAuto) {
            showToast("Fetching All Roznamas", "Querying e-Courts NAPIX for all hearings and storing in database...", true);
        }

        try {
            let handled = false;
            try {
                const res = await fetch(`/ECourts/FetchAllCaseProceedings?trackedId=${currentProceedingsTrackedId}&module=${encodeURIComponent(currentModule)}`, {
                    method: "POST"
                });
                if (res.ok) {
                    const text = await res.text();
                    if (text && text.trim()) {
                        const json = JSON.parse(text);
                        if (json.success) {
                            if (json.proceedings && json.proceedings.length > 0) {
                                currentProceedingsList = json.proceedings;
                                if (currentProceedingsCase) {
                                    currentProceedingsCase.proceedingsHistory = json.proceedings;
                                }
                                populateDailyProceedingsModal(currentProceedingsCase, json.proceedings);
                            }
                            showToast("All Proceedings Stored", json.message || "All proceedings successfully saved into database.", true);
                            handled = true;
                        }
                    }
                }
            } catch (eBatch) {
                console.warn("Batch fetch endpoint not yet active or network error, falling back to live hearings fetch:", eBatch);
            }

            // Fallback: If FetchAllCaseProceedings is 404 or unavailable, fetch missing hearings sequentially via FetchLiveHearingProceeding
            if (!handled && currentProceedingsCase && currentProceedingsList && currentProceedingsList.length > 0) {
                let newlySaved = 0;
                const cnr = currentProceedingsCase.cnrNumber;
                const isHc = currentProceedingsCase.isHighCourt || (cnr && (cnr.startsWith("HC") || cnr.startsWith("KAHC")));

                for (let i = 0; i < currentProceedingsList.length; i++) {
                    const h = currentProceedingsList[i];
                    const existingRoz = (h.business || h.roznama || h.proceeding || "").trim();
                    if (existingRoz) continue;

                    const rawBus = (h.business_date || h.businessDate || h.cause_date || h.hist_date || "").trim();
                    const rawHear = (h.hearing_date || h.hearingDate || "").trim();
                    const validBus = extractValidDate(rawBus);
                    const validHear = extractValidDate(rawHear);
                    const targetDt = validBus || validHear || extractValidDate(h.next_date || h.nextDate);

                    if (!targetDt) continue;

                    const rowCell = document.getElementById(`dpRoznamaCell_${i}`);
                    if (rowCell) {
                        rowCell.innerHTML = `<span class="spinner-border spinner-border-sm me-1 text-primary"></span><span class="text-muted extra-small">Fetching live from eCourts &amp; storing in DB...</span>`;
                    }

                    try {
                        const url = `/ECourts/FetchLiveHearingProceeding?cnrNumber=${encodeURIComponent(cnr)}&hearingDate=${encodeURIComponent(targetDt)}&isHighCourt=${isHc ? 'true' : 'false'}&module=${encodeURIComponent(currentModule)}`;
                        const fRes = await fetch(url);
                        if (fRes.ok) {
                            const fText = await fRes.text();
                            if (fText && fText.trim()) {
                                const fJson = JSON.parse(fText);
                                if (fJson.success) {
                                    const bData = fJson.data || {};
                                    const bizText = (fJson.business || bData.business || bData.roznama || bData.proceeding || "").trim();
                                    if (bizText) {
                                        h.business = bizText;
                                        h.roznama = bizText;
                                        newlySaved++;
                                        if (rowCell) {
                                            rowCell.innerHTML = `<div class="d-flex align-items-center gap-1 mb-1"><span class="badge bg-success-subtle text-success border border-success extra-small py-0.5 px-1.5"><i class="bi bi-database-fill-check me-1"></i>Stored in DB</span></div><div class="font-monospace text-dark">${escapeHtml(bizText)}</div>`;
                                        }
                                        const rowBtnCell = document.querySelector(`#dpRow_${i} td:last-child`);
                                        if (rowBtnCell) {
                                            rowBtnCell.innerHTML = `<button type="button" class="btn btn-xs btn-outline-success rounded-pill extra-small px-2 py-1 text-nowrap shadow-xs" onclick="fetchLiveHearingRoznama('${escapeJs(cnr)}', '${escapeJs(targetDt)}', ${isHc ? 'true' : 'false'}, ${i})" title="Saved in Database. Click to re-verify"><i class="bi bi-database-check me-1"></i>Saved in DB <i class="bi bi-arrow-repeat ms-0.5 opacity-75"></i></button>`;
                                        }
                                    } else if (rowCell) {
                                        rowCell.innerHTML = `<span class="text-muted fst-italic"><i class="bi bi-info-circle me-1"></i>No verbatim text recorded on eCourts NJDG</span>`;
                                    }
                                } else if (rowCell) {
                                    rowCell.innerHTML = `<span class="text-muted fst-italic"><i class="bi bi-info-circle me-1"></i>${escapeHtml(fJson.message || "No roznama found")}</span>`;
                                }
                            }
                        }
                    } catch (eItem) {
                        console.warn("Item live roznama fetch error:", eItem);
                    }
                }

                if (newlySaved > 0) {
                    showToast("Proceedings Saved", `${newlySaved} hearing proceeding(s) fetched and saved into database.`, true);
                    handled = true;
                } else if (!isAuto) {
                    showToast("Notice", "eCourts NAPIX queries completed. No additional verbatim roznamas were returned for these dates.", false);
                    handled = true;
                }
            }
        } catch (err) {
            console.error("Error in fetchAllCaseRoznamas:", err);
            if (!isAuto) {
                showToast("Fetch Notice", "Could not connect to eCourts gateway.", false);
            }
        } finally {
            if (btnHeader) {
                btnHeader.disabled = false;
                btnHeader.innerHTML = `<i class="bi bi-cloud-arrow-down-fill me-1"></i>Fetch All Roznamas`;
            }
            if (btnTable) {
                btnTable.disabled = false;
                btnTable.innerHTML = `<i class="bi bi-cloud-arrow-down-fill me-1"></i>Fetch All Roznamas to DB`;
            }
        }
    }

