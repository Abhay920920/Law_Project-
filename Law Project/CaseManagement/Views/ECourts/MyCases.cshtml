        <div class="report-footer">
            <div>
                <div><strong>Certified True Dossier</strong> — Live NAPIX eCourts Official Gateway Sync: ${escapeHtml(dossier.synced_at || "Recent")}</div>
                <div style="font-size: 8.5px; margin-top: 1px;">Official legal record prepared for court proceedings and Central Office law management.</div>
            </div>
            <div class="sig-block">
                <div>Law Officer / Registry In-charge</div>
                <div style="font-size: 8.5px; font-weight: normal; margin-top: 2px;">Central Office, NWKRTC, Hubballi</div>
