        document.getElementById("dFilDate").innerText = data.filing_date || raw.date_of_filing || "—";
        document.getElementById("dRegDate").innerText = data.registration_date || raw.dt_regis || "—";

        document.getElementById("dNextHearing").innerText = data.next_hearing_date ? data.next_hearing_date : "Date Not Listed / Pending";
        document.getElementById("dStage").innerText = data.stage || raw.purpose_name || "—";
