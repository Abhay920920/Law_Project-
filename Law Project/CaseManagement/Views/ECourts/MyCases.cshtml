<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;" id="myCasesToastContainer"></div>

@section Scripts {
<script>
    const currentModule = "@module";
    let allCasesData = [];
    let currentDossierTrackedId = null;
    let currentDossierObject = null;

    function getDisplayCaseType(c) {
        if (!c) return "";
        const isHc = (c.cnrNumber && (c.cnrNumber.startsWith("HC") || c.cnrNumber.substring(2, 4) === "HC")) ||
                     (c.estCode && c.estCode.startsWith("KAHC"));
        let type = (c.caseTypeCode || "").trim();
        const isLabour = (currentModule || "").toLowerCase() === "labour";

        if (isLabour) {
            if (!type || type === "MFA" || type === "MVC" || type === "Case" || type === "0") {
                return isHc ? "WP" : "KID";
            }
            return type;
        }

        if (!type || type === "Case" || type === "0") {
            return isHc ? "MFA" : "MVC";
        }
        return type;
    }

    document.addEventListener("DOMContentLoaded", function () {
        loadTrackedCases();
    });

    // ==========================================
    // Fetch all tracked cases for current module
    // ==========================================
    async function loadTrackedCases(showManualRefreshToast = false) {
        const tbody = document.getElementById("myCasesTbody");
        const refreshIcon = document.getElementById("refreshBtnIcon");
        if (refreshIcon) refreshIcon.classList.add("spin-animation");

        try {
            const res = await fetch(`/ECourts/GetMyTrackedCases?module=${encodeURIComponent(currentModule)}`);
            const json = await res.json();

            if (json.success && Array.isArray(json.data)) {
                allCasesData = json.data;
                allCasesData.forEach(c => {
                    c.caseTypeCode = getDisplayCaseType(c);
                });
                updateStatsCounters();
                renderCasesTable();
                if (showManualRefreshToast) {
                    showToast("Refreshed", "Case records reloaded from database.", true);
                }
            } else {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-danger">
                    <i class="bi bi-exclamation-octagon fs-3 d-block mb-2"></i>
                    ${json.message || "Failed to load tracked cases."}
                </td></tr>`;
            }
        } catch (err) {
            console.error("Error loading tracked cases:", err);
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-danger">
                <i class="bi bi-wifi-off fs-3 d-block mb-2"></i>
                Connection error while retrieving tracked cases.
            </td></tr>`;
        } finally {
            if (refreshIcon) refreshIcon.classList.remove("spin-animation");
        }
    }

    // ==========================================
    // Update Stats & Pill Counters
    // ==========================================
    function updateStatsCounters() {
        const total = allCasesData.length;
        let upcoming = 0;
        let pending = 0;
        let disposed = 0;

        const todayStr = new Date().toISOString().split('T')[0];

        allCasesData.forEach(c => {
            const st = (c.caseStatus || "").toLowerCase();
            if (st.includes("dispos") || st.includes("dismiss") || st.includes("allowed")) {
                disposed++;
            } else {
                pending++;
            }

            if (c.nextHearingDate) {
                const hDateStr = c.nextHearingDate.split('T')[0];
                if (hDateStr >= todayStr) {
                    upcoming++;
                }
            }
        });

        document.getElementById("statTotalCases").innerText = total;
        document.getElementById("statUpcomingHearings").innerText = upcoming;
        document.getElementById("statPendingCases").innerText = pending;
        document.getElementById("statDisposedCases").innerText = disposed;

        document.getElementById("countPillAll").innerText = total;
        document.getElementById("countPillUpcoming").innerText = upcoming;
        document.getElementById("countPillPending").innerText = pending;
        document.getElementById("countPillDisposed").innerText = disposed;
    }

    // ==========================================
    // Quick Filter by clicking KPI Cards
    // ==========================================
    function quickFilterByCard(cardType) {
        if (cardType === 'upcoming') {
            document.getElementById("filterUpcoming").checked = true;
            document.getElementById("hearingDatePreset").value = "this_week";
            onHearingPresetChange();
            return;
        }

        if (cardType === 'pending') {
            document.getElementById("filterPending").checked = true;
        } else if (cardType === 'disposed') {
            document.getElementById("filterDisposed").checked = true;
        } else {
            document.getElementById("filterAll").checked = true;
            clearHearingDateFilter();
            return;
        }
        filterCasesTable();
    }

    // ==========================================
    // Hearing Date Filter Handlers
    // ==========================================
    function onHearingPresetChange() {
        const preset = document.getElementById("hearingDatePreset").value;
        const fromInput = document.getElementById("hearingDateFrom");
        const toInput = document.getElementById("hearingDateTo");

        const now = new Date();
        const formatDate = (d) => {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        };

        if (preset === "all" || preset === "unscheduled" || preset === "overdue") {
            fromInput.value = "";
            toInput.value = "";
        } else if (preset === "today") {
            const todayStr = formatDate(now);
            fromInput.value = todayStr;
            toInput.value = todayStr;
        } else if (preset === "tomorrow") {
            const tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tomorrowStr = formatDate(tomorrow);
            fromInput.value = tomorrowStr;
            toInput.value = tomorrowStr;
        } else if (preset === "this_week") {
            const in7 = new Date(now);
            in7.setDate(in7.getDate() + 7);
            fromInput.value = formatDate(now);
            toInput.value = formatDate(in7);
        } else if (preset === "this_month") {
            const in30 = new Date(now);
            in30.setDate(in30.getDate() + 30);
            fromInput.value = formatDate(now);
            toInput.value = formatDate(in30);
        }

        filterCasesTable();
    }

    function onCustomDateInputChanged() {
        const fromVal = document.getElementById("hearingDateFrom").value;
        const toVal = document.getElementById("hearingDateTo").value;
        const preset = document.getElementById("hearingDatePreset");

        if (fromVal || toVal) {
            preset.value = "custom";
        } else {
            preset.value = "all";
        }
        filterCasesTable();
    }

    function clearHearingDateFilter() {
        document.getElementById("hearingDatePreset").value = "all";
        document.getElementById("hearingDateFrom").value = "";
        document.getElementById("hearingDateTo").value = "";
        filterCasesTable();
    }

    // ==========================================
    // Render Cases Table with search & hearing date filter
    // ==========================================
    function renderCasesTable() {
        const tbody = document.getElementById("myCasesTbody");
        const query = (document.getElementById("caseSearchInput").value || "").trim().toLowerCase();
        const selectedFilter = document.querySelector('input[name="statusFilter"]:checked')?.value || "all";
        const preset = document.getElementById("hearingDatePreset")?.value || "all";
        const fromVal = document.getElementById("hearingDateFrom")?.value || "";
        const toVal = document.getElementById("hearingDateTo")?.value || "";
        const todayStr = new Date().toISOString().split('T')[0];

        const filtered = allCasesData.filter(c => {
            // Text search
            if (query) {
                const searchStr = `${c.cnrNumber || ""} ${getDisplayCaseType(c)} ${c.caseTypeCode || ""} ${c.caseNumber || ""} ${c.caseYear || ""} ${c.petitioner || ""} ${c.respondent || ""} ${c.courtNo || ""} ${c.judgeDesignation || ""}`.toLowerCase();
                if (!searchStr.includes(query)) return false;
            }

            // Radio status filter
            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");

            if (selectedFilter === "disposed" && !isDisposed) return false;
            if (selectedFilter === "pending" && isDisposed) return false;
            if (selectedFilter === "upcoming") {
                if (!c.nextHearingDate) return false;
                const hDateStr = c.nextHearingDate.split('T')[0];
                if (hDateStr < todayStr) return false;
            }

            // Hearing Date Filter
            const hDate = c.nextHearingDate ? c.nextHearingDate.split('T')[0] : null;

            if (preset === "unscheduled") {
                if (hDate) return false;
            } else if (preset === "overdue") {
                if (!hDate || hDate >= todayStr || isDisposed) return false;
            } else {
                if (fromVal && (!hDate || hDate < fromVal)) return false;
                if (toVal && (!hDate || hDate > toVal)) return false;
            }

            return true;
        });

        // Update table summary
        document.getElementById("tableSummaryText").innerText = `Showing ${filtered.length} of ${allCasesData.length} tracked case(s)`;

        // Update Hearing Filter Summary Badge
        const summaryBadge = document.getElementById("hearingFilterSummaryBadge");
        if (summaryBadge) {
            if (preset === "today") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-check text-success me-1"></i>Listed Today (${filtered.length})`;
            } else if (preset === "tomorrow") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-event text-primary me-1"></i>Listed Tomorrow (${filtered.length})`;
            } else if (preset === "this_week") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-week text-warning me-1"></i>Next 7 Days (${filtered.length})`;
            } else if (preset === "this_month") {
                summaryBadge.innerHTML = `<i class="bi bi-calendar-month text-info me-1"></i>Next 30 Days (${filtered.length})`;
            } else if (preset === "overdue") {
                summaryBadge.innerHTML = `<i class="bi bi-exclamation-triangle text-danger me-1"></i>Overdue Hearings (${filtered.length})`;
            } else if (preset === "unscheduled") {
                summaryBadge.innerHTML = `<i class="bi bi-hourglass text-muted me-1"></i>Unscheduled (${filtered.length})`;
            } else if (fromVal || toVal) {
                summaryBadge.innerHTML = `<i class="bi bi-funnel-fill text-primary me-1"></i>${fromVal || '...'} to ${toVal || '...'} (${filtered.length})`;
            } else {
                summaryBadge.innerText = `Showing all dates (${filtered.length})`;
            }
        }

        if (filtered.length === 0) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 text-secondary d-block mb-2"></i>
                No cases match the selected hearing date or filter criteria.
            </td></tr>`;
            return;
        }

        let html = "";
        filtered.forEach((c, index) => {
            const isHc = (c.cnrNumber || "").startsWith("HC") || (c.cnrNumber && c.cnrNumber.length >= 4 && c.cnrNumber.substring(2, 4).toUpperCase() === "HC");
            const courtTierBadge = isHc ? `<span class="badge bg-primary-subtle text-primary border border-primary extra-small">High Court</span>` : `<span class="badge bg-secondary-subtle text-dark border extra-small">District / Lower</span>`;

            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
            const statusBadge = isDisposed
                ? `<span class="badge bg-success-subtle text-success border border-success extra-small"><i class="bi bi-check-circle-fill me-1"></i>Disposed</span>`
                : `<span class="badge bg-warning-subtle text-dark border border-warning extra-small"><i class="bi bi-hourglass-split me-1"></i>${c.caseStatus || "Pending"}</span>`;

            // Next hearing date formatting
            let hearingDisplay = '<span class="text-muted extra-small fst-italic">Date Pending</span>';
            if (c.nextHearingDate) {
                const dt = new Date(c.nextHearingDate);
                const dtFormatted = dt.toLocaleDateString("en-GB", { day: '2-digit', month: 'short', year: 'numeric' });
                const isUpcoming = dt.toISOString().split('T')[0] >= todayStr;
                hearingDisplay = `
                    <div class="fw-bold ${isUpcoming ? "text-primary" : "text-dark"}">
                        <i class="bi bi-calendar-event me-1"></i>${dtFormatted}
                    </div>
                    <div class="extra-small text-muted text-truncate" style="max-width: 150px;">
                        ${c.stagePurpose || "Hearing"}
                    </div>`;
            }

            // Last synced formatting
            let syncedStr = "—";
            if (c.lastSyncedAt) {
                const sDt = new Date(c.lastSyncedAt);
                syncedStr = sDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' ' + sDt.toLocaleDateString("en-GB", { day: '2-digit', month: 'short' });
            }

            html += `
            <tr id="row_${c.trackedID}">
                <td class="text-muted fw-bold ps-4">${index + 1}</td>
                <td>
                    <div class="d-flex align-items-center gap-1.5">
                        <span class="font-monospace fw-bold text-dark fs-6">${c.cnrNumber}</span>
                        <button class="btn btn-link text-muted p-0 ms-1" title="Copy CNR" onclick="copyToClipboard('${c.cnrNumber}')">
                            <i class="bi bi-clipboard extra-small"></i>
                        </button>
                    </div>
                    <div class="mt-1">${courtTierBadge}</div>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                        <span class="badge bg-primary font-monospace fw-bold">${getDisplayCaseType(c)}</span>
                        <span class="fw-bold text-dark font-monospace">${c.caseNumber || ""}${c.caseYear ? "/" + c.caseYear : ""}</span>
                    </div>
                    <div class="extra-small text-muted mt-0.5">Est: <span class="font-monospace">${c.estCode || "—"}</span></div>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-1 mb-1">
                        <span class="badge bg-warning-subtle text-dark border border-warning font-monospace fw-bold">
                            <i class="bi bi-bank2 me-1 text-secondary"></i>${c.courtNo || "Court Hall"}
                        </span>
                    </div>
                    <div class="extra-small text-muted text-truncate" style="max-width: 180px;" title="${c.judgeDesignation || ""}">
                        ${c.judgeDesignation || "Presiding Judge"}
                    </div>
                </td>
                <td>
                    <div class="fw-bold text-dark text-truncate" style="max-width: 260px;" title="${c.petitioner || ""}">
                        ${c.petitioner || "Petitioner"}
                    </div>
                    <div class="extra-small text-muted text-truncate" style="max-width: 260px;" title="${c.respondent || ""}">
                        vs ${c.respondent || "Respondent"}
                    </div>
                </td>
                <td>
                    ${hearingDisplay}
                </td>
                <td>
                    ${statusBadge}
                </td>
                <td>
                    <div class="extra-small text-muted">${syncedStr}</div>
                </td>
                <td class="text-end pe-4">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-danger btn-sm px-2" title="Check Live High Court Cause List & Court Hall" id="btnCl_${c.trackedID}" onclick="checkLiveCauseList(${c.trackedID}, '${c.cnrNumber}')">
                            <i class="bi bi-broadcast"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm px-2.5 py-1" title="View Full Case Dossier" onclick="openCaseDossier(${c.trackedID})">
                            <i class="bi bi-file-earmark-medical me-1"></i> Dossier
                        </button>
                        <button type="button" class="btn btn-outline-dark btn-sm px-2" title="Print Case Dossier" onclick="printSingleCase(${c.trackedID})">
                            <i class="bi bi-printer"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-2" title="Sync live with eCourts" id="btnSync_${c.trackedID}" onclick="syncCaseLive(${c.trackedID})">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm px-2" title="Remove from My Cases" onclick="removeCase(${c.trackedID}, '${c.cnrNumber}')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>`;
        });

        tbody.innerHTML = html;
    }

