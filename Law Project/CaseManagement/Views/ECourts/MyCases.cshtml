    async function loadCaseCauseListInModal(trackedId, cnr, customDate) {
        const container = document.getElementById("dCauselistDetailsBody");
        if (!container) return;

        let queryDate = (typeof customDate !== 'undefined' && customDate) ? customDate : "";
        const dateInput = document.getElementById("dCauselistDateInput");
        if (!queryDate && dateInput) {
            queryDate = dateInput.value.trim();
        }

        container.innerHTML = `
            <div class="text-center py-4 text-muted">
                <div class="spinner-border text-danger spinner-border-sm me-2" role="status"></div>
                <span class="small fw-semibold">Querying live High Court Cause List for <strong>${queryDate || 'today'}</strong>...</span>
            </div>`;

        try {
            const res = await fetch(`/ECourts/GetCaseCauseListDetails?trackedId=${trackedId}&cnrNumber=${encodeURIComponent(cnr || '')}&targetDate=${encodeURIComponent(queryDate)}&module=${encodeURIComponent(currentModule)}`);
            const json = await res.json();
            container.innerHTML = renderCauseListDetailsCard(json, queryDate, cnr);
        } catch (err) {
            container.innerHTML = `
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>
                        <div class="fw-bold">Unable to query live eCourts Cause List Gateway</div>
                        <div class="extra-small">Network connection or API rate limit exceeded. Please retry in a few moments.</div>
                    </div>
                </div>`;
        }
    }

    function recheckLiveCauseListInModal() {
        if (!currentDossierTrackedId && !currentDossierObject) return;
        const cnr = currentDossierObject?.cnr || currentDossierObject?.data?.cnr_number || "";
        const dateInput = document.getElementById("dCauselistDateInput");
        const queryDate = dateInput ? dateInput.value.trim() : "";
        loadCaseCauseListInModal(currentDossierTrackedId, cnr, queryDate);
    }

    async function checkLiveCauseList(trackedId, cnr, customDate) {
        currentQuickTrackedId = trackedId;
        currentQuickCnr = cnr;

        let queryDate = (typeof customDate !== 'undefined' && customDate) ? customDate : "";
        const dateInput = document.getElementById("quickCauseListDateInput");
        if (dateInput) {
            if (queryDate) {
                dateInput.value = queryDate;
            } else if (!dateInput.value) {
                dateInput.value = new Date().toISOString().split('T')[0];
            }
            if (!queryDate) {
                queryDate = dateInput.value;
            }
        }
        if (!queryDate) {
            queryDate = new Date().toISOString().split('T')[0];
        }

        const btn = document.getElementById(`btnCl_${trackedId}`);
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span>`;
        }

        const modalEl = document.getElementById("quickCauseListModal");
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        document.getElementById("quickCauseListModalTitle").innerText = `Checking Live Cause List...`;
        document.getElementById("quickCauseListModalSubtitle").innerText = `CNR: ${cnr}`;
        document.getElementById("quickCauseListModalBody").innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-danger" role="status"></div>
                <p class="mt-2 text-muted fw-bold mb-0">Querying live High Court e-Courts Gateway for <strong>${queryDate || 'today'}</strong>...</p>
                <div class="extra-small text-muted mt-1">Cross-referencing Dharwad (KAHC02), Bengaluru (KAHC01), and Kalaburagi (KAHC03) rosters...</div>
            </div>`;
        modal.show();

        try {
            const res = await fetch(`/ECourts/GetCaseCauseListDetails?trackedId=${trackedId}&cnrNumber=${encodeURIComponent(cnr)}&targetDate=${encodeURIComponent(queryDate)}&module=${encodeURIComponent(currentModule)}`);
            const json = await res.json();

            document.getElementById("quickCauseListModalTitle").innerText = json.isListed ? `Listed in High Court Cause List` : `High Court Cause List Status`;
            if (json.courtName) {
                document.getElementById("quickCauseListModalSubtitle").innerText = `${json.courtName} | CNR: ${cnr}`;
            }
            document.getElementById("quickCauseListModalBody").innerHTML = renderCauseListDetailsCard(json, json.causelistDate || queryDate, cnr);

            if (json.matched || json.isListed) {
                const matchedCase = allCasesData.find(x => x.trackedID === trackedId);
                if (matchedCase && json.data) {
                    if (json.data.courtHall) matchedCase.courtNo = json.data.courtHall;
                    if (json.data.itemNo) matchedCase.itemNo = json.data.itemNo;
                    if (json.data.benchId) matchedCase.benchId = json.data.benchId;
                    if (json.data.benchName) matchedCase.benchName = json.data.benchName;
                    if (json.data.causelistType) matchedCase.causeListType = json.data.causelistType;
                    renderCasesTable();
                }
                loadTrackedCases();
            }
        } catch (err) {
            document.getElementById("quickCauseListModalBody").innerHTML = `
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>
                        <div class="fw-bold">Gateway Connection Error</div>
                        <div class="extra-small">Failed to reach the live eCourts Gateway. Please try again.</div>
                    </div>
                </div>`;
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<i class="bi bi-broadcast"></i>`;
            }
        }
    }

