    function escapeJs(str) {
        if (!str) return "";
        return String(str).replace(/'/g, "\\'").replace(/"/g, "&quot;");
    }

    function populateCaseWorkerDropdown() {
        const workerSelect = document.getElementById("caseWorkerFilter");
        if (!workerSelect) return;

        const currentVal = workerSelect.value || "all";

        // Aggregate cases per worker from active tracked dataset
        const counts = {};
        allCasesData.forEach(c => {
            const w = (c.addedBy || "Central Office").trim();
            counts[w] = (counts[w] || 0) + 1;
        });

        const designated = getDesignatedWorkers();
        const isLabour = (currentModule || "").toLowerCase().includes("labour");
        const moduleLabel = isLabour ? "Labour" : "MVC";

        let optHtml = `<option value="all">👥 All Case Workers (${allCasesData.length} Cases Consolidated)</option>`;

        // Group 1: Designated Case Workers for this module
        optHtml += `<optgroup label="📋 Designated ${moduleLabel} Case Workers">`;
        designated.forEach(w => {
            const cnt = counts[w] || 0;
            optHtml += `<option value="${escapeHtml(w)}">👤 ${escapeHtml(w)} (${cnt} cases)</option>`;
        });
        optHtml += `</optgroup>`;

        // Group 2: Other Workers / Desks found in active dataset
        const others = Object.keys(counts).filter(w => !designated.includes(w)).sort((a, b) => a.localeCompare(b));
        if (others.length > 0) {
            optHtml += `<optgroup label="🏢 Other Desks / Offices">`;
            others.forEach(w => {
                optHtml += `<option value="${escapeHtml(w)}">🏛️ ${escapeHtml(w)} (${counts[w]} cases)</option>`;
            });
            optHtml += `</optgroup>`;
        }

        workerSelect.innerHTML = optHtml;

        if (currentVal === "all" || designated.includes(currentVal) || others.includes(currentVal)) {
            workerSelect.value = currentVal;
        } else {
            workerSelect.value = "all";
        }
    }

    function clearCaseWorkerFilter() {
        const workerSelect = document.getElementById("caseWorkerFilter");
        if (workerSelect) {
            workerSelect.value = "all";
            filterCasesTable();
        }
    }

    function filterByWorkerOnly(workerName) {
        const workerSelect = document.getElementById("caseWorkerFilter");
        if (workerSelect) {
            workerSelect.value = workerName;
            filterCasesTable();
        }
    }

    function toggleGroupCollapse(groupId) {
        const rows = document.querySelectorAll(`.group-row-${groupId}`);
        const icon = document.getElementById(`icon_${groupId}`);
        let isHiding = false;
        rows.forEach(r => {
            if (r.classList.contains("d-none")) {
                r.classList.remove("d-none");
            } else {
                r.classList.add("d-none");
                isHiding = true;
            }
        });
        if (icon) {
            icon.className = isHiding ? "bi bi-chevron-right fs-6 fw-bold" : "bi bi-chevron-down fs-6 fw-bold";
        }
    }

    function openReassignModal(trackedId, cnrNumber, currentWorker) {
        const idElem = document.getElementById("reassignTrackedId");
        if (idElem) idElem.value = trackedId;
        
        const cnrElem = document.getElementById("reassignCnrLabel");
        if (cnrElem) cnrElem.innerText = `CNR: ${cnrNumber}`;
        
        const cleanWorker = (currentWorker || "Central Office").trim();
        const displayElem = document.getElementById("currentWorkerDisplay");
        if (displayElem) displayElem.innerText = cleanWorker;

        const sel = document.getElementById("newWorkerSelect");
        const box = document.getElementById("customReassignWorkerBox");
        const inp = document.getElementById("customReassignWorkerInput");
        const fallbackInp = document.getElementById("newWorkerInput");
        if (fallbackInp) fallbackInp.value = cleanWorker;

        if (sel) {
            let found = false;
            for (let i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value.trim().toLowerCase() === cleanWorker.toLowerCase()) {
                    sel.selectedIndex = i;
                    found = true;
                    break;
                }
            }
            if (!found) {
                sel.value = "__custom__";
                if (box) box.classList.remove("d-none");
                if (inp) inp.value = cleanWorker;
            } else {
                if (box) box.classList.add("d-none");
                if (inp) inp.value = "";
            }
        }

        const modalEl = document.getElementById("reassignWorkerModal");
        if (modalEl) {
            const modal = (typeof bootstrap !== 'undefined' && bootstrap.Modal && bootstrap.Modal.getOrCreateInstance) 
                ? bootstrap.Modal.getOrCreateInstance(modalEl) 
                : new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    async function submitReassignWorker() {
        const idElem = document.getElementById("reassignTrackedId");
        const trackedId = idElem ? parseInt(idElem.value, 10) : 0;
        const sel = document.getElementById("newWorkerSelect");
        const fallbackInp = document.getElementById("newWorkerInput");
        let newWorker = sel ? sel.value : (fallbackInp ? fallbackInp.value : "");
        if (newWorker === "__custom__") {
            newWorker = (document.getElementById("customReassignWorkerInput")?.value || "").trim();
        }
        if (!newWorker) {
            newWorker = "Central Office";
        }

        const btn = document.getElementById("submitReassignBtn");
        if (btn) btn.disabled = true;

        try {
            const res = await fetch("/ECourts/ReassignCaseWorker", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ trackedId, newWorker })
            });
            const json = await res.json();
            if (json.success) {
                showToast("Worker Reassigned", json.message || "Case successfully reassigned.", true);
                const modalEl = document.getElementById("reassignWorkerModal");
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();

                // Live in-memory update so UI reflects change instantly without losing scroll
                const found = allCasesData.find(c => c.trackedID === trackedId);
                if (found) {
                    found.addedBy = newWorker;
                }
                populateCaseWorkerDropdown();
                renderCasesTable();
            } else {
                showToast("Reassign Failed", json.message || "Could not reassign case worker.", false);
            }
        } catch (err) {
            console.error("Reassign error:", err);
            showToast("Error", "Network or server error during reassignment.", false);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

