    // ==========================================
    // DATA INTEGRITY & PRINT ENGINE
    // ==========================================

    function escapeHtml(str) {
        if (str === null || str === undefined) return "—";
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatExtraParties(val) {
        if (!val) return "None";
        if (typeof val === 'string') {
            const trimmed = val.trim();
            return (trimmed && trimmed !== '—') ? trimmed : "None";
        }
        if (typeof val === 'object') {
            const arr = Object.values(val).filter(v => typeof v === 'string' && v.trim().length > 0 && v.trim() !== '—');
            return arr.length > 0 ? arr.join(", ") : "None";
        }
        return String(val);
    }

    function formatDateSafe(val) {
        if (!val) return "—";
        try {
            const d = new Date(val);
            if (isNaN(d.getTime())) return escapeHtml(val);
            return d.toLocaleDateString("en-GB", { day: '2-digit', month: 'short', year: 'numeric' });
        } catch {
            return escapeHtml(val);
        }
    }

    function formatDateTimeSafe(val) {
        if (!val) return "—";
        try {
            const d = new Date(val);
            if (isNaN(d.getTime())) return escapeHtml(val);
            const dateStr = d.toLocaleDateString("en-GB", { day: '2-digit', month: 'short', year: 'numeric' });
            const timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            return `${dateStr} ${timeStr}`;
        } catch {
            return escapeHtml(val);
        }
    }

