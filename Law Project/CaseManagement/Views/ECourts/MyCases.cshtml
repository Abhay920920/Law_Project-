    // ========================================================
    // Bulk Sync All Tracked Proceedings Across Module
    // ========================================================
    async function syncAllProceedings() {
        const btn = document.getElementById("btnSyncAllProceedings");
        const origHtml = btn ? btn.innerHTML : "";
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Syncing All Cases...`;
        }

        showToast("Sync Initiated", `Fetching latest daily proceedings & hearing updates for all ${currentModule} cases...`, true);

        try {
            const res = await fetch(`/ECourts/SyncAllTrackedProceedings`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ module: currentModule })
            });
            const json = await res.json();
            if (json.success) {
                showToast("Bulk Sync Complete", json.message || `All cases synced successfully.`, true);
                loadTrackedCases();
            } else {
                showToast("Sync Notice", json.message || "Failed to sync all cases.", false);
            }
        } catch (err) {
            console.error("Bulk sync error:", err);
            showToast("Network Error", "Failed to communicate with sync service.", false);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        }
    }

    // ==========================================
    // Open Comprehensive Case Dossier Modal
