                const badge = isPending
                    ? `<span class="badge bg-warning-subtle text-dark border border-warning extra-small">Pending</span>`
                    : `<span class="badge bg-success-subtle text-success border border-success extra-small">Disposed</span>`;
                return `
                <tr>
                    <td class="text-muted fw-bold">${i + 1}</td>
                    <td class="font-monospace fw-bold text-primary">${ia.ia_number || `IA #${i+1}`}</td>
                    <td class="font-monospace">${ia.date_of_filing || "—"}</td>
                    <td>${ia.ia_pet_name || "—"}</td>
                    <td>${badge}</td>
                </tr>`;
            }).join("");
        } else {
            tbodyIa.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No interim applications found.</td></tr>`;
        }

        // Processes
        const processes = dossier.processes || [];
        document.getElementById("dossierProcessCount").innerText = processes.length;
        const tbodyProc = document.getElementById("dTbodyProcess");
        if (processes.length > 0) {
            tbodyProc.innerHTML = processes.map((p, i) => `
                <tr>
                    <td class="text-muted fw-bold">${i + 1}</td>
                    <td class="font-monospace">${p.process_id || "—"}</td>
                    <td class="fw-semibold">${p.process_title || p.title || "Notice Issued"}</td>
                    <td class="font-monospace">${p.issue_date || "—"}</td>
                    <td><span class="badge bg-light text-dark border extra-small">${p.notice_type || "Notice"}</span></td>
                </tr>
            `).join("");
        } else {
            tbodyProc.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No process notices recorded.</td></tr>`;
        }

        // Acts
        const acts = dossier.acts || [];
        const tbodyActs = document.getElementById("dTbodyActs");
        if (acts.length > 0) {
            tbodyActs.innerHTML = acts.map((a, i) => `
                <tr>
                    <td class="text-muted fw-bold">${i + 1}</td>
                    <td class="fw-semibold">${a.act || a.act_name || "—"}</td>
                    <td class="font-monospace">${a.section || "—"}</td>
                </tr>
            `).join("");
        } else {
            tbodyActs.innerHTML = `<tr><td colspan="3" class="text-center text-muted py-4">No statutory acts recorded.</td></tr>`;
        }

        // 8. Initialize Cause List & Court Hall live inspection tab
        const clDateInput = document.getElementById("dCauselistDateInput");
        if (clDateInput) {
            let defaultDate = "";
            if (data.next_hearing_date && data.next_hearing_date.includes('-')) {
                const parts = data.next_hearing_date.split('T')[0].split('-');
                if (parts.length === 3 && parts[0].length === 2) {
                    defaultDate = `${parts[0]}-${parts[1]}-${parts[2]}`;
                } else if (parts.length === 3 && parts[0].length === 4) {
                    defaultDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
                }
            }
            if (!defaultDate) {
                const now = new Date();
                const dd = String(now.getDate()).padStart(2, '0');
                const mm = String(now.getMonth() + 1).padStart(2, '0');
                defaultDate = `${dd}-${mm}-${now.getFullYear()}`;
            }
            clDateInput.value = defaultDate;
        }

        // Auto load cause list details for this case
        loadCaseCauseListInModal(currentDossierTrackedId, cnr);
    }

