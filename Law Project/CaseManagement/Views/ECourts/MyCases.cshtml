@{
    string module = ViewBag.Module ?? "MVC";
    bool isLabour = ViewBag.IsLabour ?? false;
    ViewData["Title"] = isLabour ? "Labour - My Cases & Live CNR Tracker" : "MVC - My Cases & Live CNR Tracker";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .mycases-page {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .mycases-header-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
        color: #fff;
        border-radius: 12px;
    }
    .kpi-card-clean {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .kpi-card-clean:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;
    }
    .status-filter-group .btn-check:checked + label {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
        color: #ffffff !important;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
    }
    .status-filter-group label {
        color: #475569;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }
    .status-filter-group label:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }
    .table-cases thead th {
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        font-weight: 700;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding-top: 12px;
        padding-bottom: 12px;
    }
    .table-cases tbody tr:hover {
        background-color: #f8fafc;
    }
    .spin-animation {
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Table Pagination Styling */
    .pagination .page-link {
        color: #1e293b;
        border-color: #e2e8f0;
        font-size: 0.82rem;
        padding: 0.38rem 0.75rem;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        background-color: #ffffff;
    }
    .pagination .page-link:hover {
        background-color: #f1f5f9;
        color: @(isLabour ? "#4338ca" : "#0284c7");
        border-color: #cbd5e1;
    }
    .pagination .page-item.active .page-link {
        background: @(isLabour ? "linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%)" : "linear-gradient(135deg, #0f172a 0%, #0284c7 100%)");
        border-color: @(isLabour ? "#4338ca" : "#0284c7");
        color: #ffffff !important;
        box-shadow: 0 2px 6px @(isLabour ? "rgba(67, 56, 202, 0.3)" : "rgba(2, 132, 199, 0.3)");
    }
    .pagination .page-item.disabled .page-link {
        color: #94a3b8;
        background-color: #f8fafc;
        border-color: #e2e8f0;
        cursor: not-allowed;
    }

    @@media (max-width: 991.98px) {
        .mycases-page {
            padding: 8px 4px !important;
        }
        .mycases-header-gradient {
            padding: 1.1rem !important;
            border-radius: 1rem !important;
        }
        .mycases-header-gradient h3 {
            font-size: 1.15rem !important;
        }
        .kpi-card-clean {
            border-radius: 0.75rem !important;
            margin-bottom: 0.25rem;
        }
        .kpi-card-clean .card-body {
            padding: 0.75rem !important;
        }
        .kpi-card-clean h2 {
            font-size: 1.35rem !important;
        }
        .status-filter-group {
            width: 100%;
            overflow-x: auto;
            white-space: nowrap;
            padding-bottom: 4px;
        }
    }
</style>

<div class="mycases-page px-2 px-md-4 py-3">

    <!-- Header Banner -->
    <div class="mycases-header-gradient p-3 p-md-4 mb-3 mb-md-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2.5">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1.5 flex-wrap">
                <span class="badge @(isLabour ? "bg-purple text-white" : "bg-primary text-white") font-monospace fw-bold px-2.5 py-1">
                    <i class="bi @(isLabour ? "bi-briefcase-fill" : "bi-truck-front-fill") me-1"></i>@(isLabour ? "LABOUR DISPUTES" : "MVC / MACT CLAIMS")
                </span>
                <span class="badge bg-danger text-white font-monospace fw-bold px-2.5 py-1">
                    <i class="bi bi-broadcast me-1"></i>LIVE E-COURTS GATEWAY
                </span>
            </div>
            <h3 class="fw-bold mb-1 text-white d-flex align-items-center gap-2">
                <i class="bi bi-folder-check text-warning"></i> My Cases &amp; Live CNR Tracker
            </h3>
            <p class="text-light text-opacity-75 small mb-0 d-none d-sm-block">Central Office Registry — High-fidelity live CNR monitoring, automated proceedings sync, orders & judgements.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-lg-auto justify-content-start justify-content-lg-end">
            <button type="button" class="btn btn-warning btn-sm fw-bold shadow-sm px-3 py-2 d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0 justify-content-center" data-bs-toggle="modal" data-bs-target="#addCnrModal">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add CNR Cases</span>
            </button>
            <button type="button" class="btn btn-info btn-sm shadow-sm px-2.5 px-sm-3 py-2 d-flex align-items-center gap-1.5 text-white fw-semibold" onclick="syncAllProceedings()" id="btnSyncAllProceedings" title="Sync and analyze daily proceedings & hearing dates for all cases from live eCourts">
                <i class="bi bi-journal-check"></i>
                <span class="d-none d-md-inline">Sync All Proceedings</span>
                <span class="d-inline d-md-none">Sync All</span>
            </button>
            <button type="button" class="btn btn-danger btn-sm shadow-sm px-2.5 px-sm-3 py-2 d-flex align-items-center gap-1.5 fw-semibold" onclick="syncAllCauseLists()" title="Query live High Court cause lists for today across Dharwad, Bengaluru, Kalaburagi">
                <i class="bi bi-broadcast"></i>
                <span class="d-none d-md-inline">Check Live Cause Lists</span>
                <span class="d-inline d-md-none">Cause List</span>
            </button>
            <button type="button" class="btn btn-outline-light btn-sm px-2.5 px-sm-3 py-2 d-flex align-items-center gap-1.5" onclick="printCasesReport('filtered')" title="Print judicial report of current cases">
                <i class="bi bi-printer-fill"></i>
                <span class="d-none d-sm-inline">Print</span>
            </button>
            <!-- Export Excel / CSV Split Button -->
            <div class="btn-group shadow-sm">
                <button type="button" class="btn btn-success btn-sm px-2.5 px-sm-3 py-2 d-flex align-items-center gap-1.5 fw-semibold" onclick="exportToExcel('filtered')" title="Export filtered cases to Microsoft Excel (.xls)">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    <span class="d-none d-sm-inline">Export</span>
                </button>
                <button type="button" class="btn btn-success btn-sm dropdown-toggle dropdown-toggle-split px-2" data-bs-toggle="dropdown" aria-expanded="false" title="More Export Options">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2" style="min-width: 250px;">
                    <li>
                        <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToExcel('filtered')">
                            <i class="bi bi-file-earmark-excel-fill text-success fs-6"></i>
                            <div>
                                <div class="fw-bold">Export Current View (.xls)</div>
                                <div class="extra-small text-muted">Filtered cases with styling & columns</div>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToExcel('all')">
                            <i class="bi bi-collection-fill text-primary fs-6"></i>
                            <div>
                                <div class="fw-bold">Export All Cases (.xls)</div>
                                <div class="extra-small text-muted">Complete master tracking workbook</div>
                            </div>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToCsv('filtered')">
                            <i class="bi bi-filetype-csv text-secondary fs-6"></i>
                            <div>
                                <div class="fw-bold">Export Current View to CSV</div>
                                <div class="extra-small text-muted">Standard UTF-8 comma-separated file</div>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToCsv('all')">
                            <i class="bi bi-file-earmark-spreadsheet text-secondary fs-6"></i>
                            <div>
                                <div class="fw-bold">Export All Cases to CSV</div>
                                <div class="extra-small text-muted">Complete UTF-8 CSV master dataset</div>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
            <button type="button" class="btn btn-outline-light btn-sm px-2.5 px-sm-3 py-2 d-flex align-items-center gap-1.5" onclick="loadTrackedCases(true)" title="Refresh table data">
                <i class="bi bi-arrow-clockwise" id="refreshBtnIcon"></i>
                <span class="d-none d-sm-inline">Refresh</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Cards: 2x2 Grid on Mobile (<576px), 4 Columns on xl -->
    <div class="row row-cols-2 row-cols-sm-2 row-cols-xl-4 g-2 g-md-3 mb-3 mb-md-4">
        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('all')" title="Filter: All Cases">
            <div class="card border-0 shadow-sm border-start border-4 border-primary bg-white kpi-card-clean h-100">
                <div class="card-body p-2.5 p-sm-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Tracked Cases</span>
                            <h2 class="fw-bold text-primary mb-0 mt-0.5 fs-4 fs-sm-2" id="statTotalCases">0</h2>
                        </div>
                        <div class="bg-primary-subtle p-2 p-sm-3 rounded-3 text-primary">
                            <i class="bi bi-folder-check fs-4 fs-sm-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('upcoming')" title="Filter: Upcoming Hearings">
            <div class="card border-0 shadow-sm border-start border-4 border-warning bg-white kpi-card-clean h-100">
                <div class="card-body p-2.5 p-sm-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Upcoming</span>
                            <h2 class="fw-bold text-warning mb-0 mt-0.5 fs-4 fs-sm-2" id="statUpcomingHearings">0</h2>
                        </div>
                        <div class="bg-warning-subtle p-2 p-sm-3 rounded-3 text-warning">
                            <i class="bi bi-calendar-event fs-4 fs-sm-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('pending')" title="Filter: Active / Pending Cases">
            <div class="card border-0 shadow-sm border-start border-4 border-info bg-white kpi-card-clean h-100">
                <div class="card-body p-2.5 p-sm-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Pending</span>
                            <h2 class="fw-bold text-info mb-0 mt-0.5 fs-4 fs-sm-2" id="statPendingCases">0</h2>
                        </div>
                        <div class="bg-info-subtle p-2 p-sm-3 rounded-3 text-info">
                            <i class="bi bi-hourglass-split fs-4 fs-sm-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col" style="cursor: pointer;" onclick="quickFilterByCard('disposed')" title="Filter: Disposed Cases">
            <div class="card border-0 shadow-sm border-start border-4 border-success bg-white kpi-card-clean h-100">
                <div class="card-body p-2.5 p-sm-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted extra-small text-uppercase fw-bold">Disposed</span>
                            <h2 class="fw-bold text-success mb-0 mt-0.5 fs-4 fs-sm-2" id="statDisposedCases">0</h2>
                        </div>
                        <div class="bg-success-subtle p-2 p-sm-3 rounded-3 text-success">
                            <i class="bi bi-check-circle fs-4 fs-sm-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Filter and Search Header -->
        <div class="card-header bg-white border-bottom p-2.5 p-md-4">
            <!-- Row 1: Search Bar & Status Filter Ribbon -->
            <div class="row g-2 align-items-center justify-content-between mb-2 mb-md-3">
                <div class="col-12 col-lg-5">
                    <div class="input-group shadow-sm rounded-pill overflow-hidden border bg-light">
                        <span class="input-group-text bg-light border-0 text-muted ps-3 pe-2">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="caseSearchInput" class="form-control bg-light border-0 py-2" 
                               placeholder="Search CNR, Case No, Party, Judge..." oninput="onSearchInputChanged()" />
                        <button class="btn btn-link text-muted border-0 pe-3 d-none" type="button" id="clearSearchBtn" onclick="clearSearchInput()" title="Clear search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="col-12 col-lg-7 d-flex flex-wrap align-items-center justify-content-between justify-content-lg-end gap-2">
                    <!-- Status Filter Pills Ribbon (Horizontal Touch-Scroll on Mobile) -->
                    <div class="btn-group p-1 bg-light rounded-pill border status-filter-ribbon flex-grow-1 flex-sm-grow-0" role="group">
                        <input type="radio" class="btn-check" name="statusFilter" id="filterAll" value="all" checked onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-2.5 px-sm-3 py-1.5 text-nowrap" for="filterAll">All (<span id="countPillAll">0</span>)</label>

                        <input type="radio" class="btn-check" name="statusFilter" id="filterUpcoming" value="upcoming" onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-2.5 px-sm-3 py-1.5 text-nowrap" for="filterUpcoming">Listed (<span id="countPillUpcoming">0</span>)</label>

                        <input type="radio" class="btn-check" name="statusFilter" id="filterPending" value="pending" onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-2.5 px-sm-3 py-1.5 text-nowrap" for="filterPending">Pending (<span id="countPillPending">0</span>)</label>

                        <input type="radio" class="btn-check" name="statusFilter" id="filterDisposed" value="disposed" onchange="filterCasesTable()">
                        <label class="btn btn-sm rounded-pill px-2.5 px-sm-3 py-1.5 text-nowrap" for="filterDisposed">Disposed (<span id="countPillDisposed">0</span>)</label>
                    </div>

                    <div class="d-flex align-items-center gap-1.5">
                        <!-- Print Dropdown Button -->
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-2.5 px-sm-3 py-1.5 shadow-sm dropdown-toggle d-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false" title="Print Judicial Cases Report">
                                <i class="bi bi-printer-fill text-primary"></i>
                                <span class="d-none d-sm-inline">Print</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2" style="min-width: 230px;">
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="printCasesReport('filtered')">
                                        <i class="bi bi-funnel-fill text-primary fs-6"></i>
                                        <div>
                                            <div class="fw-bold">Print Current View</div>
                                            <div class="extra-small text-muted">Filtered cases matching current filters</div>
                                        </div>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="printCasesReport('all')">
                                        <i class="bi bi-collection-fill text-success fs-6"></i>
                                        <div>
                                            <div class="fw-bold">Print All Cases</div>
                                            <div class="extra-small text-muted">Complete master tracking register</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Export to Excel / CSV Dropdown Button -->
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2.5 px-sm-3 py-1.5 shadow-sm dropdown-toggle d-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false" title="Export cases to Microsoft Excel or CSV">
                                <i class="bi bi-file-earmark-excel-fill text-success"></i>
                                <span class="d-none d-sm-inline">Export</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2" style="min-width: 250px;">
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToExcel('filtered')">
                                        <i class="bi bi-file-earmark-excel-fill text-success fs-6"></i>
                                        <div>
                                            <div class="fw-bold">Export Current View (.xls)</div>
                                            <div class="extra-small text-muted">Filtered cases with styling & columns</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToExcel('all')">
                                        <i class="bi bi-collection-fill text-primary fs-6"></i>
                                        <div>
                                            <div class="fw-bold">Export All Cases (.xls)</div>
                                            <div class="extra-small text-muted">Complete master tracking workbook</div>
                                        </div>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToCsv('filtered')">
                                        <i class="bi bi-filetype-csv text-secondary fs-6"></i>
                                        <div>
                                            <div class="fw-bold">Export Current View to CSV</div>
                                            <div class="extra-small text-muted">Standard UTF-8 comma-separated file</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="exportToCsv('all')">
                                        <i class="bi bi-filetype-csv text-secondary fs-6"></i>
                                        <div>
                                            <div class="fw-bold">Export All Cases to CSV</div>
                                            <div class="extra-small text-muted">All cases in UTF-8 CSV</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Advanced Filters Toggle Button -->
            <div class="d-lg-none mb-2">
                <button class="btn btn-sm btn-outline-primary w-100 d-flex justify-content-between align-items-center py-2 px-3 rounded-pill shadow-xs" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFiltersCollapse" aria-expanded="false" aria-controls="advancedFiltersCollapse">
                    <span class="d-flex align-items-center gap-2 fw-semibold">
                        <i class="bi bi-funnel-fill text-primary"></i>
                        <span>Hearing Date &amp; Worker Filters</span>
                    </span>
                    <span class="badge bg-primary text-white rounded-pill px-2 py-1" id="mobileFilterSummaryBadge">Filter Options</span>
                </button>
            </div>

            <!-- Collapsible Advanced Filters Section (Always visible on lg+, collapsible on mobile) -->
            <div class="collapse d-lg-block" id="advancedFiltersCollapse">
                <!-- Row 2: Hearing Date Filter Toolbar -->
                <div class="bg-light bg-opacity-75 p-2.5 px-3 rounded-3 border">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2.5">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small fw-bold text-dark d-flex align-items-center gap-1.5 text-nowrap">
                                <i class="bi bi-calendar-event-fill text-primary fs-6"></i>
                                <span>Hearing Date:</span>
                            </span>

                            <!-- Quick Preset Select -->
                            <select id="hearingDatePreset" class="form-select form-select-sm rounded-pill border-secondary-subtle px-3 py-1 fw-semibold text-dark shadow-sm" style="width: auto; min-width: 175px;" onchange="onHearingPresetChange()">
                                <option value="all">All Hearing Dates</option>
                                <option value="today">📅 Listed Today</option>
                                <option value="tomorrow">📅 Listed Tomorrow</option>
                                <option value="this_week">🗓 Next 7 Days</option>
                                <option value="this_month">🗓 Next 30 Days</option>
                                <option value="overdue">⚠️ Past / Overdue</option>
                                <option value="unscheduled">⏳ Date Pending</option>
                                <option value="custom">🔍 Custom Date Range...</option>
                            </select>

                            <!-- From & To Date Pickers -->
                            <div class="d-flex align-items-center gap-1.5 flex-wrap flex-sm-nowrap" id="customDateRangeInputs">
                                <span class="extra-small text-muted text-uppercase fw-semibold">From:</span>
                                <input type="date" id="hearingDateFrom" class="form-control form-control-sm rounded-pill px-2.5 py-1 text-dark bg-white border" style="width: 135px;" onchange="onCustomDateInputChanged()" title="From hearing date" />
                                
                                <span class="extra-small text-muted text-uppercase fw-semibold ms-1">To:</span>
                                <input type="date" id="hearingDateTo" class="form-control form-control-sm rounded-pill px-2.5 py-1 text-dark bg-white border" style="width: 135px;" onchange="onCustomDateInputChanged()" title="To hearing date" />
                            </div>

                            <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1 text-decoration-none extra-small" onclick="clearHearingDateFilter()" title="Reset date filters">
                                <i class="bi bi-x-circle me-1"></i>Reset Date
                            </button>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-white text-secondary border shadow-sm small py-1.5 px-2.5" id="hearingFilterSummaryBadge">
                                Showing all dates
                            </span>
                        </div>
                    </div>

                    <!-- Case Worker Selection & Grouping Toolbar (For Central Office & Multi-Worker Desks) -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2.5 mt-2.5 pt-2 border-top border-secondary-subtle">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small fw-bold text-dark d-flex align-items-center gap-1.5 text-nowrap">
