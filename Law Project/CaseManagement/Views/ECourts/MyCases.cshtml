        // Render in hidden iframe for silent, clean print
        const iframe = document.createElement('iframe');
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        document.body.appendChild(iframe);

        try {
            const frameDoc = iframe.contentWindow.document;
            frameDoc.open();
            frameDoc.write(printHtml);
            frameDoc.close();
            iframe.contentWindow.focus();

            setTimeout(() => {
                iframe.contentWindow.print();
                setTimeout(() => iframe.remove(), 2500);
            }, 350);
        } catch (err) {
            console.error("Iframe print error, falling back to window.open:", err);
            iframe.remove();
            const win = window.open('', '_blank');
            if (win) {
                win.document.open();
                win.document.write(printHtml);
                win.document.close();
                win.focus();
                setTimeout(() => { win.print(); win.close(); }, 400);
            } else {
                window.print();
            }
        }
    }

    // ==========================================
    // Print Cases Report (Active Filter / All)
    // ==========================================
    function printCasesReport(scope = 'filtered') {
        if (!allCasesData || allCasesData.length === 0) {
            showToast("Print", "No tracked cases available to print.", false);
            return;
        }

        const query = (document.getElementById("caseSearchInput").value || "").trim().toLowerCase();
        const selectedFilter = document.querySelector('input[name="statusFilter"]:checked')?.value || "all";
        const selectedWorker = document.getElementById("caseWorkerFilter")?.value || "all";
        const preset = document.getElementById("hearingDatePreset")?.value || "all";
        const fromVal = document.getElementById("hearingDateFrom")?.value || "";
        const toVal = document.getElementById("hearingDateTo")?.value || "";
        const todayStr = new Date().toISOString().split('T')[0];

        let casesToPrint = [];
        let filterSummaryText = "";

        if (scope === 'all') {
            casesToPrint = [...allCasesData];
            filterSummaryText = "Scope: Complete Master Tracking Register (All Cases)";
        } else {
            casesToPrint = allCasesData.filter(c => {
                if (query) {
                    const searchStr = `${c.cnrNumber || ""} ${getDisplayCaseType(c)} ${c.caseTypeCode || ""} ${c.caseNumber || ""} ${c.caseYear || ""} ${c.petitioner || ""} ${c.respondent || ""} ${c.courtNo || ""} ${c.judgeDesignation || ""} ${c.courtEstName || ""} ${c.benchId || ""} ${c.benchName || ""} ${c.causeListType || ""} ${c.addedBy || ""}`.toLowerCase();
                    if (!searchStr.includes(query)) return false;
                }
                if (selectedWorker !== "all") {
                    const w = (c.addedBy || "Central Office").trim().toLowerCase();
                    if (w !== selectedWorker.toLowerCase()) return false;
                }
                const st = (c.caseStatus || "").toLowerCase();
                const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
                if (selectedFilter === "disposed" && !isDisposed) return false;
                if (selectedFilter === "pending" && isDisposed) return false;
                if (selectedFilter === "upcoming") {
                    if (!c.nextHearingDate) return false;
                    if (c.nextHearingDate.split('T')[0] < todayStr) return false;
                }
                const hDate = c.nextHearingDate ? c.nextHearingDate.split('T')[0] : null;
                if (preset === "unscheduled") {
                    if (hDate) return false;
                } else if (preset === "overdue") {
                    if (!hDate || hDate >= todayStr || isDisposed) return false;
                } else {
                    if (fromVal && (!hDate || hDate < fromVal)) return false;
                    if (toVal && (!hDate || hDate > toVal)) return false;
                }
                return true;
            });

            const filterParts = [];
            if (preset === "today") filterParts.push("Listed Today");
            else if (preset === "tomorrow") filterParts.push("Listed Tomorrow");
            else if (preset === "this_week") filterParts.push("Next 7 Days");
            else if (preset === "this_month") filterParts.push("Next 30 Days");
            else if (preset === "overdue") filterParts.push("Past / Overdue");
            else if (preset === "unscheduled") filterParts.push("Date Pending");
            else if (fromVal || toVal) filterParts.push(`Dates: ${fromVal || 'Start'} to ${toVal || 'End'}`);
            else filterParts.push("All Hearing Dates");

            if (selectedFilter !== "all") filterParts.push(`Status: ${selectedFilter.toUpperCase()}`);
            if (selectedWorker !== "all") filterParts.push(`Worker: ${selectedWorker}`);
            if (query) filterParts.push(`Query: "${query}"`);
            filterSummaryText = `Filtered View (${filterParts.join(" | ")})`;
        }

        if (casesToPrint.length === 0) {
            showToast("Print", "No cases match the selected filter criteria to print.", false);
            return;
        }

        // Calculate statistics for the printed report
        let statUpcoming = 0;
        let statPending = 0;
        let statDisposed = 0;
        casesToPrint.forEach(c => {
            const st = (c.caseStatus || "").toLowerCase();
            if (st.includes("dispos") || st.includes("dismiss") || st.includes("allowed")) {
                statDisposed++;
            } else {
                statPending++;
            }
            if (c.nextHearingDate && c.nextHearingDate.split('T')[0] >= todayStr) {
                statUpcoming++;
            }
        });

        const printTime = new Date().toLocaleString("en-GB", {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit', hour12: true
        });

        const isLabour = currentModule.toLowerCase() === "labour";
        const moduleLabel = isLabour ? "LABOUR DISPUTES & TRIBUNALS" : "MVC / MACT MOTOR ACCIDENT CLAIMS";

        let rowsHtml = "";
        casesToPrint.forEach((c, index) => {
            const isHc = (c.cnrNumber || "").startsWith("HC") || (c.cnrNumber && c.cnrNumber.length >= 4 && c.cnrNumber.substring(2, 4).toUpperCase() === "HC");
            const courtBadge = isHc ? `<span class="badge-court-hc">High Court</span>` : `<span class="badge-court-dc">District/Lower</span>`;

            const st = (c.caseStatus || "").toLowerCase();
            const isDisposed = st.includes("dispos") || st.includes("dismiss") || st.includes("allowed");
            const statusHtml = isDisposed
                ? `<span class="badge-disposed">Disposed</span>`
                : `<span class="badge-pending">${escapeHtml(c.caseStatus || "—")}</span>`;

            let hearingHtml = '<span class="text-muted" style="font-style: italic;">Date Pending</span>';
            if (c.nextHearingDate) {
                const dtFormatted = formatDateSafe(c.nextHearingDate);
                const isUpcoming = c.nextHearingDate.split('T')[0] >= todayStr;
                hearingHtml = `
                    <div class="fw-bold ${isUpcoming ? "text-primary" : ""}">${dtFormatted}</div>
                    <div class="text-muted" style="font-size: 9px;">${escapeHtml(c.stagePurpose || "—")}</div>
                `;
            }

            const syncedStr = formatDateTimeSafe(c.lastSyncedAt);

            rowsHtml += `
            <tr>
                <td class="text-center fw-bold text-muted">${index + 1}</td>
                <td>
                    <div class="font-mono fw-bold" style="font-size: 10.5px;">${escapeHtml(c.cnrNumber)}</div>
                    <div style="margin-top: 2px; display: flex; gap: 4px; align-items: center; flex-wrap: wrap;">
                        ${courtBadge}
                        <span class="badge" style="background:#f1f5f9;color:#334155;border:1px solid #cbd5e1;font-size:8.5px;padding:1px 4px;font-weight:600;">Worker: ${escapeHtml(c.addedBy || "Central Office")}</span>
                    </div>
                </td>
                <td>
                    <div class="fw-bold font-mono" style="color: #0369a1;"><span class="module-badge" style="background:#0284c7; padding: 1px 4px; font-size: 8px; margin-right: 3px;">${escapeHtml(getDisplayCaseType(c))}</span> ${escapeHtml(c.caseNumber || "")}${c.caseYear ? "/" + c.caseYear : ""}</div>
                    <div class="text-muted" style="font-size: 8.5px; margin-top: 2px;">Est: ${escapeHtml(c.estCode || "—")}</div>
                </td>
                <td>
                    <div class="fw-semibold" style="color: #92400e; background: #fef3c7; border: 1px solid #fcd34d; border-radius: 3px; display: inline-block; padding: 1px 5px; font-family: ui-monospace, monospace; font-size: 9px; margin-bottom: 2px;">${escapeHtml(c.courtNo || "—")}</div>
                    <div class="text-muted" style="font-size: 8.5px; line-height: 1.25;">${escapeHtml(c.judgeDesignation || "—")}</div>
                </td>
                <td>
                    <div class="party-petitioner">${escapeHtml(c.petitioner || "—")}</div>
                    <div class="party-respondent"><span class="party-vs">vs</span> ${escapeHtml(c.respondent || "—")}</div>
                </td>
                <td>
                    ${hearingHtml}
                </td>
                <td class="text-center">
                    ${statusHtml}
                </td>
                <td class="text-center text-muted" style="font-size: 8.5px;">
                    ${syncedStr}
                </td>
            </tr>`;
        });

        const bodyHtml = `
        <div class="official-header">
            <div>
                <div class="corp-kannada">ವಾಯವ್ಯ ಕರ್ನಾಟಕ ರಸ್ತೆ ಸಾರಿಗೆ ಸಂಸ್ಥೆ - ಕೇಂದ್ರೀಯ ಕಚೇರಿ, ಕಾನೂನು ಕೋಶ</div>
                <h1 class="corp-title">North Western Karnataka Road Transport Corporation</h1>
                <div class="doc-title">Central Law Cell — eCourts Judicial CNR Tracker & Cause List Register</div>
            </div>
            <div class="text-end">
                <span class="module-badge">${escapeHtml(moduleLabel)}</span>
                <div class="text-muted" style="font-size: 9px; margin-top: 4px;">
                    Printed: <strong>${printTime}</strong>
                </div>
            </div>
        </div>

        <div class="meta-container">
            <div>
                <strong>Report Filter:</strong> <span class="text-muted">${escapeHtml(filterSummaryText)}</span>
            </div>
            <div>
                <strong>Total Cases:</strong> <span class="stat-badge stat-total">${casesToPrint.length}</span>
                <strong>Upcoming Listed:</strong> <span class="stat-badge stat-upcoming">${statUpcoming}</span>
                <strong>Active Pending:</strong> <span class="stat-badge stat-pending">${statPending}</span>
                <strong>Disposed:</strong> <span class="stat-badge stat-disposed">${statDisposed}</span>
            </div>
        </div>

        <table class="report-table" style="table-layout: fixed;">
            <thead>
                <tr>
                    <th class="text-center" style="width: 32px;">#</th>
                    <th style="width: 145px;">CNR Number</th>
                    <th style="width: 140px;">Case No & Type</th>
                    <th style="width: 175px;">Court / Bench & Coram</th>
                    <th>Parties (Petitioner vs Respondent)</th>
                    <th style="width: 125px;">Next Hearing / Stage</th>
                    <th class="text-center" style="width: 85px;">Status</th>
                    <th class="text-center" style="width: 105px;">Last Synced</th>
                </tr>
            </thead>
            <tbody>
                ${rowsHtml}
            </tbody>
        </table>

        <div class="report-footer">
            <div>
                <div><strong>Official Central Office Case Register</strong> | Synchronized via NAPIX eCourts Official Gateway</div>
                <div style="font-size: 8.5px; margin-top: 1px;">Data integrity verified with 100% fidelity. Contains live CNR proceeding history.</div>
            </div>
            <div class="sig-block">
                <div>Law Officer / Registry In-charge</div>
                <div style="font-size: 8.5px; font-weight: normal; margin-top: 2px;">Central Office, NWKRTC, Hubballi</div>
            </div>
