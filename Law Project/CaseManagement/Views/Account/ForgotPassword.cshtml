@model MVCCaseManagement.Models.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="kn-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Legal Desk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/cdn.css" rel="stylesheet" />
    <link href="~/css/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-portal">
        <!-- Official Logo & Title Header -->
        <div class="portal-header-official">
            <div class="portal-logo-container">
                <img src="~/images/logo.jpg" alt="NWKRTC Logo" asp-append-version="true" />
            </div>
            <h2 class="portal-title-official">Account Recovery</h2>
            <p class="portal-subtitle-official">Enter your username to reset password</p>
        </div>
        
        <div class="portal-body-official">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small mb-4 border-start border-4 border-danger" style="font-size: 0.75rem;">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-4">
                    <label asp-for="Username" class="auth-label">Username</label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username" required autofocus />
                    </div>
                    <div class="form-text small mt-2" style="font-size: 0.7rem; color: #64748b;">
                        We will send an OTP to your registered mobile/email.
                    </div>
                </div>

                <button type="submit" class="btn btn-auth-primary w-100 shadow-sm">
                    Send OTP / ಒಟಿಪಿ ಕಳುಹಿಸಿ
                </button>
            </form>
            
            <div class="auth-footer-official pt-4">
                <a asp-action="Login" class="auth-link-back">
                    <i class="bi bi-arrow-left me-2"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</body>
</html>
