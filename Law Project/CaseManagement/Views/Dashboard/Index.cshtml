@if (User.FindFirst("DivisionID")?.Value != "5")
{
    <div class="row g-4">
        <!-- Scheduled Hearings (Modernized) -->
        <div class="col-12">
            <div class="gov-card shadow-sm border-0 h-100">
                <div class="gov-card-header d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fs-5 fw-bold"><i class="bi bi-calendar-check me-2 text-primary"></i>Scheduled Hearings</span>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-primary border-opacity-25 text-muted small">FROM</span>
                            <input type="date" id="hearingDateFrom" class="form-control border-primary border-opacity-25" value="@ViewBag.SelectedDate" />
                            <span class="input-group-text bg-white border-primary border-opacity-25 text-muted small">TO</span>
                            <input type="date" id="hearingDateTo" class="form-control border-primary border-opacity-25" value="@ViewBag.SelectedDate" />
                            <button class="btn btn-primary px-3" id="btnFilterHearings"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="p-3">
                    <div class="d-flex justify-content-end mb-3">
                        <span class="badge rounded-pill bg-primary px-3 py-2 shadow-sm" id="dateDisplayIndicator">TODAY</span>
                    </div>
                    <div id="recentCasesContainer" class="transition-all">
                        @await Html.PartialAsync("_DashboardRecentCases", (List<MVCCaseManagement.Models.RecentCaseViewModel>)ViewBag.RecentCases)
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Live Clock
            setInterval(() => {
                const now = new Date();
                $('#liveClock').text(now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0'));
            }, 1000);

            // Dynamic Greeting
            function updateGreeting() {
                const hour = new Date().getHours();
                let greeting = "Good Morning";
                if (hour >= 12 && hour < 17) greeting = "Good Afternoon";
                else if (hour >= 17) greeting = "Good Evening";
                
                const name = "@displayName";
                $('#greetingText').html(`${greeting}, ${name}! <span class="ms-1">👋</span>`);
            }
            updateGreeting();

            // Charts have been replaced by premium gradient cards


            function filterHearings() {
                const fromDate = $('#hearingDateFrom').val();
                const toDate = $('#hearingDateTo').val();
                
                if (!fromDate) return;

                $('#recentCasesContainer').css('opacity', '0.5').css('transform', 'scale(0.99)');
                
                const today = new Date().toISOString().split('T')[0];
                if (fromDate === today && toDate === today) {
                    $('#dateDisplayIndicator').text('TODAY').removeClass('bg-secondary').addClass('bg-primary');
                } else if (fromDate === toDate) {
                    const d = new Date(fromDate);
                    $('#dateDisplayIndicator').text(d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })).removeClass('bg-primary').addClass('bg-secondary');
                } else {
                    const dFrom = new Date(fromDate);
                    const dTo = new Date(toDate);
                    const formatted = dFrom.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) + ' - ' + dTo.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                    $('#dateDisplayIndicator').text(formatted).removeClass('bg-primary').addClass('bg-secondary');
                }

                $.get('/Dashboard/GetCasesByDate', { date: fromDate, endDate: toDate }, function(data) {
                    $('#recentCasesContainer').html(data).css('opacity', '1').css('transform', 'scale(1)');
                }).fail(function() {
                    $('#recentCasesContainer').css('opacity', '1').css('transform', 'scale(1)');
                    alert('Error fetching cases.');
                });
            }

            $('#btnFilterHearings').on('click', filterHearings);
            $('#hearingDateFrom, #hearingDateTo').on('keypress', function(e) { if (e.which === 13) filterHearings(); });
            $('#hearingDateFrom').on('change', function() {
                const fromDate = $(this).val();
                if ($('#hearingDateTo').val() < fromDate) $('#hearingDateTo').val(fromDate);
            });
        });

    function dismissTransfer(caseId, btnElement) {
        var alertEl = $(btnElement).closest('.alert');
        alertEl.fadeOut(200, function() { $(this).remove(); });
        $.post('/Case/DismissTransferNotification', { caseId: caseId });
    }
    </script>
}
