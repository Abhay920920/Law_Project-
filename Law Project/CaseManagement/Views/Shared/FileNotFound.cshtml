@{
    ViewData["Title"] = "Document Not Found";
    string fileName = ViewBag.FileName as string ?? "Requested File";
    string path = ViewBag.RequestedPath as string ?? "";
    string caseInfo = ViewBag.CaseInfo as string ?? "";
    int? caseId = ViewBag.CaseID as int?;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-danger text-white py-4 px-4 border-0" style="background: linear-gradient(135deg, #e63946 0%, #b71c1c 100%);">
                    <div class="d-flex align-items-center">
                        <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-file-earmark-x fs-1 text-white"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Upload Document Unavailable</h4>
                            <p class="mb-0 text-white-50 small">The document you requested cannot be located on the web server disk.</p>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark rounded-3 p-3 mb-4">
                        <div class="d-flex">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Why is this page showing?</h6>
                                <p class="small mb-0 opacity-75">
                                    Files uploaded prior to a web application server update/re-deployment may be missing if static file storage was overwritten.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle">
                            <tbody class="small">
                                <tr>
                                    <th class="bg-light w-30 text-muted">Requested File:</th>
                                    <td class="fw-bold text-dark font-monospace">@fileName</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">File Path:</th>
                                    <td class="text-secondary font-monospace">/uploads/@path</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(caseInfo))
                                {
                                    <tr>
                                        <th class="bg-light text-muted">Associated Case:</th>
                                        <td class="fw-bold text-primary">@caseInfo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="bg-light rounded-3 p-4 mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-tools text-primary me-2"></i>How to resolve:</h6>
                        <ol class="small text-secondary mb-0 ps-3">
                            <li class="mb-2">If you have the original file on your computer, please re-upload it by editing the case details.</li>
                            <li class="mb-2">Ensure all future file uploads are performed after logging into the system.</li>
                            <li>Contact system support if you require assistance restoring archived files.</li>
                        </ol>
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-2 border-top">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </a>
                        
                        @if (caseId.HasValue && caseId.Value > 0)
                        {
                            <a href="/Case/Edit/@caseId.Value" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                <i class="bi bi-upload me-2"></i>Re-upload Document for Case
                            </a>
                        }
                        else
                        {
                            <a href="/Dashboard" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                <i class="bi bi-house-door me-2"></i>Return to Dashboard
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
