<!DOCTYPE html>
<html lang="kn-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(OrgService.GetCurrentSettings().OrganizationShortName) MVC/MACT System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800;900&family=Public+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/cdn.css" rel="stylesheet" />
    <link href="~/css/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Select2 Searchable Dropdown CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* Global High-Visibility Form Controls - Requested by User */
        .form-check-input {
            border: 2px solid #000000 !important;
            cursor: pointer;
            transition: all 0.2s ease;
            width: 1.15em;
            height: 1.15em;
        }
        .form-check-input:checked {
            background-color: #000000 !important;
            border-color: #000000 !important;
            box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.12) !important;
        }
        .form-check-label {
            cursor: pointer;
            padding-left: 2px;
        }

        .bg-purple { background-color: #8b5cf6 !important; }
    </style>
</head>
<body>
    <!-- Official Branding Header -->
    <header class="branding-header d-print-none">
        <div class="d-flex align-items-center min-w-0">
            <!-- Mobile Offcanvas Toggle Hamburger -->
            <button class="btn btn-sm btn-light border-0 me-2 d-md-none p-1 rounded-2 shadow-none flex-shrink-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigationDrawer" aria-controls="mobileNavigationDrawer" aria-label="Toggle navigation" style="width: 36px; height: 36px;">
                <i class="bi bi-list fs-3 text-dark"></i>
            </button>
            <img src="@OrgService.GetCurrentSettings().LogoPath" alt="@(OrgService.GetCurrentSettings().OrganizationShortName) Logo" class="branding-logo flex-shrink-0" asp-append-version="true" onerror="this.onerror=null;this.src='/images/logo.jpg';" />
            <div class="branding-text min-w-0 text-truncate">
                <span class="kannada fw-bold text-dark opacity-75 d-none d-sm-block">@OrgService.GetCurrentSettings().OrganizationNameKannada</span>
                <h1 class="mb-0 text-truncate d-none d-lg-block">@OrgService.GetCurrentSettings().OrganizationNameEnglish</h1>
                <h1 class="mb-0 text-truncate d-none d-sm-block d-lg-none">@OrgService.GetCurrentSettings().OrganizationShortName Legal Management</h1>
                <h1 class="mb-0 text-truncate d-block d-sm-none fs-6">@OrgService.GetCurrentSettings().OrganizationShortName Legal</h1>
            </div>
        </div>
        <div class="ms-auto d-flex align-items-center flex-shrink-0">
            <!-- Notification Bell -->
            <div class="dropdown me-2 me-sm-3">
                <a class="text-dark position-relative d-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 36px; height: 36px; text-decoration: none;">
                    <i class="bi bi-bell-fill fs-6 text-primary"></i>
                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem;">
                        0
                    </span>
                </a>
                <div class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-0 mt-2" style="width: 300px; max-width: 90vw; max-height: 400px; overflow-y: auto; background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-4">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</h6>
                        <a href="/Notification/Index" class="small text-decoration-none">View All</a>
                    </div>
                    <div id="notificationList">
                        <div class="text-center p-4 text-muted small">Loading...</div>
                    </div>
                </div>
            </div>

            <!-- User Profile Widget -->
            @{
                bool isAdminUser = User.IsInRole("Admin") || 
                                   string.Equals(User.Identity?.Name, "admin", System.StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(User.FindFirst("Role")?.Value, "Admin", System.StringComparison.OrdinalIgnoreCase);
                string userDeptLabel = isAdminUser ? "Admin" : (User.FindFirst("DivisionName")?.Value ?? "Central Office");
                string userAvatarInitial = isAdminUser ? "A" : (!string.IsNullOrEmpty(userDeptLabel) ? userDeptLabel.Substring(0, 1).ToUpper() : "C");
                string userDeptIcon = isAdminUser ? "bi-shield-check" : "bi-building";
            }
            <div class="user-profile-widget me-2 me-sm-3" title="@userDeptLabel">
                <div class="user-avatar-badge position-relative rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                    <span>@userAvatarInitial</span>
                    <span class="user-status-indicator position-absolute bottom-0 end-0 rounded-circle" title="Active"></span>
                </div>
                <div class="user-profile-info text-start d-none d-md-block ms-2">
                    <div class="user-dept fw-bold text-dark text-truncate d-flex align-items-center gap-1.5" style="max-width: 150px;">
                        <i class="bi @userDeptIcon text-primary opacity-75" style="font-size: 0.75rem;"></i>
                        <span>@userDeptLabel</span>
                    </div>
                </div>
            </div>

            <!-- Sign Out Pill -->
            <a href="/Account/Logout" class="logout-pill shadow-sm" title="Sign Out">
                <i class="bi bi-power"></i>
                <span class="d-none d-sm-inline ms-1.5">Sign Out</span>
            </a>
        </div>
    </header>

    <!-- Mobile Offcanvas Navigation Drawer -->
    <div class="offcanvas offcanvas-start bg-dark text-white border-0 shadow-lg d-md-none" tabindex="-1" id="mobileNavigationDrawer" aria-labelledby="mobileNavDrawerLabel" style="width: 300px; z-index: 1060;">
        <div class="offcanvas-header border-bottom border-white border-opacity-10 py-3 px-3">
            <div class="d-flex align-items-center gap-2.5">
                <img src="@OrgService.GetCurrentSettings().LogoPath" alt="@(OrgService.GetCurrentSettings().OrganizationShortName) Logo" style="height: 32px; width: auto; border-radius: 4px;" asp-append-version="true" onerror="this.onerror=null;this.src='/images/logo.jpg';" />
                <div>
                    <h6 class="offcanvas-title fw-bold text-white mb-0" id="mobileNavDrawerLabel" style="font-size: 0.95rem;">@OrgService.GetCurrentSettings().OrganizationShortName Legal Hub</h6>
                    <span class="text-white-50" style="font-size: 0.7rem;">Official Portal Navigation</span>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-2 d-flex flex-column" style="overflow-y: auto;">
            <!-- User Status Card in Mobile Menu -->
            <div class="p-2.5 mb-2 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="user-avatar-badge position-relative rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-weight: 700;">
                        <span>@(isAdminUser ? "A" : (!string.IsNullOrEmpty(User.FindFirst("FullName")?.Value) ? User.FindFirst("FullName")?.Value.Substring(0, 1).ToUpper() : "?"))</span>
                        <span class="user-status-indicator position-absolute bottom-0 end-0 rounded-circle" title="Active"></span>
                    </div>
                    <div class="min-w-0 text-truncate">
                        <div class="fw-bold text-white small text-truncate">@(isAdminUser ? "Admin" : User.FindFirst("FullName")?.Value)</div>
                        <div class="text-white-50 small text-truncate d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <i class="bi @(isAdminUser ? "bi-shield-check" : "bi-building") extra-small"></i>
                            <span>@userDeptLabel</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation Links -->
            <partial name="_LayoutNav" />
        </div>
    </div>

    <div class="main-wrapper">
        <!-- Sidebar (Desktop) -->
        <aside class="sidebar d-none d-md-block d-print-none">
            <partial name="_LayoutNav" />
        </aside>

        <!-- Main Content -->
        <main class="content-area">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard")
            {
                <div class="mb-4">
                    <div class="glass-card p-4">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                @{
                    var displayGreeting = "Good Morning";
                    var hour = DateTime.Now.Hour;
                    if (hour >= 12 && hour < 17) displayGreeting = "Good Afternoon";
                    else if (hour >= 17) displayGreeting = "Good Evening";

                    var displayName = User.FindFirst("FullName")?.Value ?? User.FindFirst("DivisionName")?.Value ?? "User";
                    if (User.IsInRole("MD")) displayName = "Managing Director";
                    else if (User.IsInRole("CLO")) displayName = "Chief Law Officer";
                    else if (User.IsInRole("Dy CLO") || User.IsInRole("DyCLO")) displayName = "Deputy Chief Law Officer";
                    else if (User.IsInRole("LO")) displayName = "Law Officer";
                    else if (User.IsInRole("Division Controller") || User.IsInRole("DC")) displayName = "Division Controller (" + (User.FindFirst("DivisionName")?.Value ?? "Division") + ")";
                }
                                <h3 class="fw-bold text-primary mb-1" id="greetingText">@displayGreeting, @displayName! <span class="ms-1">👋</span></h3>
                                <p class="text-secondary mb-0">Monitor and manage cases with precision. Your daily case hearing schedule is below.</p>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <div class="d-inline-flex align-items-center bg-white p-2 px-3 rounded-pill shadow-sm border border-primary border-opacity-10">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <div class="fw-bold text-dark small">@DateTime.Now.ToString("dd MMM yyyy")</div>
                                    <div class="mx-2 text-muted">|</div>
                                    <i class="bi bi-clock text-primary me-2"></i>
                                    <div class="fw-bold text-dark small" id="liveClock">@DateTime.Now.ToString("HH:mm")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home" && (ViewData["HidePageHeader"] as bool? != true))
            {
                <div class="page-header d-print-none mb-4 border-0">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">@ViewData["Title"]</h2>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0 small opacity-75">
                                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Home</a></li>
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-4 mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <div style="display:none;" id="globalAntiforgeryTokenContainer">
        @Html.AntiForgeryToken()
    </div>
    <script src="~/js/jquery.min.js"></script>
    <script>
        (function() {
            var getCsrfToken = function() {
                var el = document.querySelector('#globalAntiforgeryTokenContainer input[name="__RequestVerificationToken"]') 
                      || document.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            };

            // 1. Hook native fetch to include RequestVerificationToken on all mutating requests
            if (window.fetch) {
                var origFetch = window.fetch;
                window.fetch = function(resource, init) {
                    init = init || {};
                    var method = (init.method || 'GET').toUpperCase();
                    if (['POST', 'PUT', 'DELETE', 'PATCH'].indexOf(method) !== -1) {
                        var token = getCsrfToken();
                        if (token) {
                            if (init.headers instanceof Headers) {
                                if (!init.headers.has('RequestVerificationToken')) init.headers.append('RequestVerificationToken', token);
                            } else if (Array.isArray(init.headers)) {
                                init.headers.push(['RequestVerificationToken', token]);
                            } else {
                                init.headers = init.headers || {};
                                if (!init.headers['RequestVerificationToken']) init.headers['RequestVerificationToken'] = token;
                            }
                        }
                    }
                    return origFetch.call(this, resource, init);
                };
            }

            // 2. Configure jQuery AJAX setup immediately before any child view scripts execute
            if (window.jQuery && window.jQuery.ajaxSetup) {
                window.jQuery.ajaxSetup({
                    beforeSend: function(xhr, settings) {
                        if (settings && settings.type && ['POST', 'PUT', 'DELETE', 'PATCH'].indexOf(settings.type.toUpperCase()) !== -1) {
                            var token = getCsrfToken();
                            if (token) xhr.setRequestHeader('RequestVerificationToken', token);
                        }
                    }
                });
            }
        })();
    </script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <!-- Select2 Searchable Dropdown JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
        <script>
            // Global "Others" Dropdown Handler
            // To use: Add 'others-dropdown' class to select, 
            // data-others-target="manualInputId" 
            // and optionally data-others-hidden="hiddenFieldId"
            $(document).on("change", ".others-dropdown", function () {
                var $select = $(this);
                var targetId = $select.data("others-target");
                var $target = $("#" + targetId);
                var val = String($select.val() || "").toLowerCase();
                var isOthers = (val === "others" || val === "other" || val === "ಸ್ಥಳದಲ್ಲೇ" || val === "ಇತರೆ");

                if (isOthers) {
                    $target.slideDown(200).prop("required", true).focus();
                } else {
                    $target.slideUp(200).prop("required", false).val("");
                }
                
                // Sync hidden field if present
                var hiddenId = $select.data("others-hidden");
                if (hiddenId) {
                    var $hidden = $("#" + hiddenId);
                    if (!isOthers) {
                        $hidden.val($select.val());
                    } else {
                        $hidden.val($target.val());
                    }
                }
            });

            $(document).on("input change", ".others-manual", function () {
                var $manual = $(this);
                var selectId = $manual.data("others-select");
                var $select = $("#" + selectId);
                var hiddenId = $manual.data("others-hidden") || $select.data("others-hidden");
                
                if (hiddenId) {
                    var val = String($select.val() || "").toLowerCase();
                    var isOthers = (val === "others" || val === "other" || val === "ಸ್ಥಳದಲ್ಲೇ" || val === "ಇತರೆ");
                    if (isOthers) {
                        $("#" + hiddenId).val($manual.val());
                    }
                }
            });
            
            // Initialization for Edit modes and Validation postbacks
            function initOthersDropdowns() {
                $(".others-dropdown").each(function() {
                    var $select = $(this);
                    var targetId = $select.data("others-target");
                    var $target = $("#" + targetId);
                    var hiddenId = $select.data("others-hidden");
                    
                    if (hiddenId) {
                        var hiddenVal = $("#" + hiddenId).val();
                        if (hiddenVal) {
                            var exists = false;
                            $select.find('option').each(function() {
                                if (this.value === hiddenVal) exists = true;
                            });
                            
                            if (exists) {
                                $select.val(hiddenVal);
                                $target.hide();
                            } else {
                                // Find the "Others" option value (might be "Others" or "OTHERS")
                                var othersOpt = $select.find('option').filter(function() {
                                    var t = (this.value || "").toLowerCase();
                                    return t === "others" || t === "other";
                                }).val();
                                
                                if (othersOpt) {
                                    $select.val(othersOpt);
                                    $target.show().val(hiddenVal).prop("required", true);
                                }
                            }
                        }
                    } else {
                         var val = String($select.val() || "").toLowerCase();
                         if (val === "others" || val === "other") {
                             $target.show().prop("required", true);
                         }
                    }
                });
            }

            $(document).ready(function() {
                initOthersDropdowns();
                
                // Initialize Select2 searchable dropdowns globally
                if ($.fn.select2) {
                    $('.select2').select2({
                        theme: 'bootstrap-5',
                        width: '100%',
                        allowClear: true,
                        placeholder: function() {
                            return $(this).data('placeholder') || '-- SELECT --';
                        }
                    });
                }
                
                // Heartbeat / Session Keep-Alive script (pings every 10 minutes)
                (function() {
                    var heartbeatInterval = 10 * 60 * 1000;
                    setInterval(function() {
                        fetch('/Account/Heartbeat')
                            .then(response => response.json())
                            .then(data => { if (data.success) console.log('Session refreshed'); })
                            .catch(err => console.error('Heartbeat failed:', err));
                    }, heartbeatInterval);
                })();
                
                // Fetch Notifications
                function loadNotifications() {
                    $.get('/Notification/GetUnread', function(data) {
                        if (data && data.count > 0) {
                            $('#notificationBadge').text(data.count).removeClass('d-none');
                        } else {
                            $('#notificationBadge').addClass('d-none');
                        }
                        
                        var html = '';
                        if (data && data.notifications && data.notifications.length > 0) {
                            data.notifications.forEach(function(note) {
                                html += `<div class="dropdown-item p-3 border-bottom text-wrap">
                                            <div class="d-flex justify-content-between">
                                                <strong class="small text-primary">${note.title}</strong>
                                                <small class="text-muted" style="font-size:0.7rem;">Just now</small>
                                            </div>
                                            <div class="small mt-1 text-dark">${note.message}</div>
                                            <div class="mt-2 text-end">
                                                <button class="btn btn-sm btn-light py-0 px-2 border note-read-btn" data-id="${note.notificationID || note.notificationId}">Mark Read</button>
                                                ${note.linkUrl ? `<a href="${note.linkUrl}" class="btn btn-sm btn-primary py-0 px-2 ms-1">View</a>` : ''}
                                            </div>
                                         </div>`;
                            });
                        } else {
                            html = '<div class="text-center p-4 text-muted small">No new notifications</div>';
                        }
                        $('#notificationList').html(html);
                    }).fail(function() {
                        $('#notificationList').html('<div class="text-center p-3 text-muted small">Notifications unavailable</div>');
                    });
                }
                
                loadNotifications();
                // Refresh notifications every 5 minutes
                setInterval(loadNotifications, 5 * 60 * 1000);
                
                $(document).on('click', '.note-read-btn', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var id = $(this).data('id');
                    if (!id) return;
                    var token = $('#__notificationAntiForgeryForm input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '/Notification/MarkAsRead/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token
                        },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function() {
                            loadNotifications();
                        },
                        error: function(xhr) {
                            console.warn('Notification mark read failed:', xhr.status);
                        }
                    });
                });
            });
        </script>

        <form id="__notificationAntiForgeryForm" style="display:none;" aria-hidden="true">
            @Html.AntiForgeryToken()
        </form>

        <script>
            // ── Quota warning dot on sidebar link ────────────────────────────
            (function checkQuota() {
                fetch('/ApiDashboard/Data')
                    .then(r => r.ok ? r.json() : null)
                    .then(d => {
                        if (!d) return;
                        const dot = document.getElementById('quotaDot');
                        if (dot && d.usedPercent >= 80) dot.style.display = 'inline-block';
                    })
                    .catch(() => {});
                // Re-check every 5 minutes
                setTimeout(checkQuota, 5 * 60 * 1000);
            })();
        </script>
        <style>
            @@keyframes quotaPulse {
                0%,100% { opacity:1; transform:scale(1);   }
                50%      { opacity:.4; transform:scale(.7); }
            }
        </style>
        <script>
            // Global Shortcut: Ctrl + Shift + Q -> Direct access to Case Operations & Activity Log Sheet
            window.addEventListener('keydown', function (e) {
                var isQ = (e.key && (e.key.toLowerCase() === 'q')) || e.code === 'KeyQ' || e.keyCode === 81 || e.which === 81;
                if (e.ctrlKey && e.shiftKey && isQ) {
                    e.preventDefault();
                    e.stopPropagation();
                    window.location.href = '@Url.Action("Index", "ActivityLog")';
                }
            }, true);

            // Persistent Client Workstation Hardware MAC Identifier for Audit Tracking
            (function () {
                try {
                    var key = 'NWKRTC_DEVICE_MAC';
                    var devMac = localStorage.getItem(key);
                    if (!devMac || devMac.length < 12 || devMac.indexOf('DEV-') === 0) {
                        // Generate deterministic hardware hash from machine characteristics
                        var fp = [
                            navigator.userAgent,
                            navigator.platform || '',
                            navigator.hardwareConcurrency || 4,
                            screen.width + 'x' + screen.height,
                            screen.colorDepth || 24,
                            new Date().getTimezoneOffset()
                        ].join('###');

                        var hash = 0;
                        for (var i = 0; i < fp.length; i++) {
                            hash = ((hash << 5) - hash) + fp.charCodeAt(i);
                            hash |= 0;
                        }

                        // Generate 6 octets formatted as physical MAC address (e.g. 70:85:C2:A1:3F:89)
                        var bytes = [];
                        var seed = Math.abs(hash);
                        for (var j = 0; j < 6; j++) {
                            var b = ((seed >> (j * 4)) ^ Math.floor(Math.random() * 256)) & 0xFF;
                            if (j === 0) b = (b & 0xFC) | 0x02; // locally administered unicast
                            bytes.push(('0' + b.toString(16).toUpperCase()).slice(-2));
                        }
                        devMac = bytes.join(':');
                        localStorage.setItem(key, devMac);
                    }
                    // Keep in cookie for every server request / form post
                    document.cookie = "NWKRTC_DEVICE_MAC=" + encodeURIComponent(devMac) + "; path=/; max-age=31536000; SameSite=Lax";

                    // Attach Client-MAC to all jQuery AJAX calls
                    if (devMac && window.jQuery && window.jQuery.ajaxSetup) {
                        window.jQuery.ajaxSetup({
                            headers: { 'X-Client-MAC': devMac }
                        });
                    }
                } catch (e) {}
            })();
        </script>
</body>
</html>

