@model IEnumerable<MVCCaseManagement.Models.ArisingApplication>
@using MVCCaseManagement.Common
@{
    ViewData["Title"] = "Arising Applications List";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isCO = ViewBag.IsCentralOffice ?? false;
}

<div class="container-fluid fade-in py-4">
    <!-- Header/Filter Section -->
    <div class="glass-header shadow-sm mb-4 border-0" style="background: linear-gradient(135deg, #fff9f0 0%, #fff 100%);">
        <div class="p-2">
            <div class="row align-items-center g-3">
                <div class="col-xl-5 col-lg-6">
                    <form method="get" action="@Url.Action("CaseList", "Labour")">
                        <input type="hidden" name="status" value="ArisingApplication" />
                        <div class="input-group search-group shadow-sm rounded-pill overflow-hidden border border-warning border-opacity-25">
                            <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-search text-warning"></i></span>
                            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-0 ps-2" placeholder="Search Arising Case No, Petitioner...">
                            <button class="btn btn-warning text-white border-0 px-4 fw-bold" type="submit">SEARCH</button>
                        </div>
                    </form>
                </div>
                <div class="col-xl-7 col-lg-6 text-lg-end">
                    <div class="filter-pill-group p-1 bg-white bg-opacity-50 rounded-pill border d-inline-flex gap-1 shadow-sm flex-wrap">
                        @if (isCO)
                        {
                            string inboxStatus = "SentToCO";
                            if (User.IsInRole("CLO") || User.IsInRole("Dy CLO") || User.IsInRole("DyCLO")) inboxStatus = "PendingDecision";
                            else if (User.IsInRole("MD")) inboxStatus = "PendingCompetentAuthority";

                            <a href="@Url.Action("CaseList", new { status = inboxStatus })" class="filter-pill">Inbox</a>
                            @if (!User.IsInRole("MD") && !User.IsInRole("CLO") && !User.IsInRole("Dy CLO") && !User.IsInRole("DyCLO"))
                            {
                                <a href="@Url.Action("CaseList", new { status = "PendingDecision" })" class="filter-pill">Pending Decision</a>
                            }
                            @if (!User.IsInRole("MD"))
                            {
                                <a href="@Url.Action("CaseList", new { status = "PendingCompetentAuthority" })" class="filter-pill">Pending at CA</a>
                            }
                            <a href="@Url.Action("CaseList", new { status = "Reinstatement" })" class="filter-pill">Reinstatement</a>
                            <a href="@Url.Action("CaseList", new { status = "ArisingApplication" })" class="filter-pill active" style="background-color: #ff8c00; color: white !important;">Arising Application</a>
                        }
                        else
                        {
                            <a href="@Url.Action("CaseList", new { status = "all" })" class="filter-pill">Regular Cases</a>
                            <a href="@Url.Action("CaseList", new { status = "ArisingApplication" })" class="filter-pill active" style="background-color: #ff8c00; color: white !important;">Arising Applications</a>
                        }
                    </div>
                    @if (!isCO)
                    {
                        <a href="@Url.Action("CreateArisingApplication", "Labour")" class="btn btn-warning rounded-pill shadow-sm px-4 ms-3 fw-bold text-white">
                            <i class="bi bi-plus-circle-fill me-2"></i>New Application
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card main-table-card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Arising App Identification</th>
                            <th class="py-3">Petitioner / Applicant</th>
                            <th class="py-3">Linked Original Case</th>
                            <th class="py-3">Entrustment & Stage</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.CaseNumber / @item.CaseYear</div>
                                        <div class="small text-muted">@item.CourtName</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium">@item.PetitionerName</div>
                                        <span class="badge @(item.CaseStatus == "Pending" ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success-emphasis")">@item.CaseStatus</span>
                                    </td>
                                    <td>
                                        <div class="small fw-bold text-primary">
                                            <i class="bi bi-link-45deg"></i> @item.Parent_CaseNumber / @item.Parent_CaseYear
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@item.Parent_CourtName</div>
                                    </td>
                                    <td>
                                        <div class="small fw-bold">@item.CurrentStage</div>
                                        @if (item.NextHearingDate.HasValue)
                                        {
                                            <div class="text-muted small"><i class="bi bi-calendar-event me-1"></i>Hearing: @item.NextHearingDate.Value.ToString("dd-MMM-yyyy")</div>
                                        }
                                        <div class="mt-1">
                                            @if (item.IsDocumentSent) { <span class="badge bg-info-subtle text-info-emphasis me-1" title="Document Sent">Doc Sent</span> }
                                            @if (item.IsObjectionFiled) { <span class="badge bg-primary-subtle text-primary-emphasis me-1" title="Objection Filed">Obj Filed</span> }
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (isCO)
                                            {
                                                <a href="@Url.Action("DetailsArisingApplication", "Labour", new { id = item.ArisingID })" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold">
                                                    <i class="bi bi-eye me-1"></i> View
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("EditArisingApplication", "Labour", new { id = item.ArisingID })" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold">
                                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-search fs-1 d-block mb-3 opacity-25 text-warning"></i>
                                    No Arising Applications found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                    <a class="page-link shadow-none" href="@Url.Action("CaseList", new { page = i, search = ViewBag.CurrentSearch, status = "ArisingApplication" })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .container-fluid { background-color: #f0f2f5; min-height: 100vh; }
    .filter-pill { padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.75rem; font-weight: 700; color: #64748b; text-decoration: none; transition: all 0.2s ease; }
    .filter-pill:hover { background-color: rgba(255, 140, 0, 0.05); color: #ff8c00; }
    .bg-info-subtle { background-color: #e0f2fe; color: #0369a1; }
    .bg-primary-subtle { background-color: #e0e7ff; color: #4338ca; }
    .table thead th { font-size: 0.7rem; letter-spacing: 0.05em; color: #64748b; }
    .pagination .page-item.active .page-link { background-color: #ff8c00; border-color: #ff8c00; }
</style>
