                            Row("SLP Year", D(Model.ClaimantSLPYear?.ToString())),
                            Row("SC Advocate", D(Model.ClaimantSCAdvocate)),
                            Row("SC Status", D(Model.ClaimantSCStatus))
                        };
                        if (Model.ClaimantConnectedCases != null && Model.ClaimantConnectedCases.Any())
                        {
                            var ccHtml = new System.Text.StringBuilder();
                            ccHtml.Append("<div class='lcp-row lcp-row--full'><span class='lcp-label'>Connected Cases:</span><div class='mt-1 d-flex flex-wrap'>");
                            foreach (var cc in Model.ClaimantConnectedCases)
                            {
                                ccHtml.Append($"<span class='lcp-chip'><i class='bi bi-link-45deg'></i>{cc.CaseDetails} — {cc.CurrentStatus}</span>");
                            }
