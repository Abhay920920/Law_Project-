</div><!-- /.lcp-wrapper -->

<script>
(function () {
    // Simple tab switcher — isolated to this partial
    document.querySelectorAll('.lcp-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var targetId = btn.getAttribute('data-lcp-tab');
            // deactivate all tabs + panes in this wrapper
            var wrapper = btn.closest('.lcp-wrapper');
            wrapper.querySelectorAll('.lcp-tab-btn').forEach(function (b) {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
            });
            wrapper.querySelectorAll('.lcp-pane').forEach(function (p) {
                p.classList.remove('active');
            });
            // activate the clicked tab
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            var pane = wrapper.querySelector('#' + targetId);
            if (pane) pane.classList.add('active');
        });
    });
})();
</script>
