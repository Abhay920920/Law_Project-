                            Row("High Court Bench", D(Model.CO_Claimant_HighCourtBench)),
                            Row("Original Case Status", D(Model.CO_Claimant_OriginalCaseStatus)),
                            Row("Is Connected", DB(Model.CO_Claimant_IsConnected)),
                            Row("Entrustment No.", D(Model.CO_Claimant_EntrustmentNo)),
                            Row("Advocate", D(Model.CO_Claimant_AdvocateName)),
                            Row("Case Status", D(Model.CO_Claimant_CaseStatus))
                        };
