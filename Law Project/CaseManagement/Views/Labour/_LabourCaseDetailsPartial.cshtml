                                        </span>
                                    </div>
                                    <div class="text-dark small white-space-pre-line">
                                        @(string.IsNullOrWhiteSpace(Model.Opinion_DC) ? "— No DC Opinion Recorded —" : Model.Opinion_DC)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PART 2: CENTRAL OFFICE PER-ROLE ACTIONS & OPINIONS -->
