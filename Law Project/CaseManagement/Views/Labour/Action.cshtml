@model MVCCaseManagement.Models.LabourCase

@{
    ViewData["Title"] = "Labour Case Action - " + Model.CaseNumber;
}

<style>
    /* High Contrast Tabs */
    .nav-tabs .nav-link {
        background-color: #e9ecef;
        color: #000;
        border: 1px solid #ced4da;
        border-bottom-color: transparent;
        margin-right: 4px;
        font-weight: 700;
        cursor: pointer;
    }
    
    .nav-tabs .nav-link.active {
        background-color: #f0f7ff !important;
        color: #002e5d !important;
        border-color: #dee2e6 #dee2e6 #fff !important;
        border-top: 4px solid #ffc107 !important; /* Yellow for Action */
        font-weight: 800 !important;
    }

    .nav-tabs .nav-link:hover {
        background-color: #dbeaff;
        color: #000;
    }

    .card-header.bg-action {
        background-color: #fff9e6;
        border-bottom: 2px solid #ffc107;
    }

    .section-title {
        color: #002e5d;
        border-bottom: 2px solid #ffc107;
        padding-bottom: 5px;
        margin-bottom: 15px;
        font-weight: bold;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-lightning-charge-fill text-warning"></i> Central Office Action</h3>
            <p class="text-muted mb-0">Managing Case No: <strong class="text-primary">@Model.CaseNumber (@Model.CaseYear)</strong> | @Model.PetitionerName vs NWKRTC</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.CaseID" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
            @if (!User.IsInRole("MD"))
            {
                <button type="submit" form="labourActionForm" class="btn btn-warning text-dark shadow-sm rounded-pill px-4 fw-bold">
                    <i class="bi bi-check-circle-fill me-2"></i> SAVE ACTION
                </button>
            }
        </div>
    </div>

    <form asp-action="Action" method="post" id="labourActionForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="CaseID" />
        <input type="hidden" asp-for="DE_HistorySheetPath" />
        <input type="hidden" asp-for="JudgmentCopyPath" />
        <input type="hidden" asp-for="JudgmentCopyPath2" />
        <input type="hidden" asp-for="DivisionID" />
        <input type="hidden" id="hdnNatureOfCase" value="@Model.NatureOfCase" />
        <input type="hidden" asp-for="Opinion_CLO" />
        <input type="hidden" asp-for="Opinion_Advocate" />
        <input type="hidden" asp-for="Opinion_LO" />
        <input type="hidden" asp-for="Opinion_DC" />
        <input type="hidden" asp-for="AwardDetails" />
        @if (!User.IsInRole("MD"))
        {
            <input type="hidden" asp-for="CO_Remarks" />
        }

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs mb-4 px-2" id="actionTabs" role="tablist">
            @if (User.IsInRole("MD"))
            {
                @* No tabs for MD *@
            }
            else
            {
                @if (Model.CO_ActionTaken != "CLOSED")
                {
                    <li class="nav-item"><a class="nav-link active" id="tab1-tab" data-bs-toggle="tab" href="#tab1">1. Judgment</a></li>
                }
                <li class="nav-item"><a class="nav-link @(Model.CO_ActionTaken == "CLOSED" ? "active" : "")" id="tab2-tab" data-bs-toggle="tab" href="#tab2">2-4. WP (Corp)</a></li>
                <li class="nav-item"><a class="nav-link" id="tabWA-tab" data-bs-toggle="tab" href="#tabWA">Writ Appeal</a></li>
                <li class="nav-item"><a class="nav-link" id="tab7-tab" data-bs-toggle="tab" href="#tab7">7-8. Appeals</a></li>
            }
        </ul>

        @if (User.IsInRole("MD"))
        {
            <!-- MD PRE-REVIEW OPINION CHAIN (Full Hierarchy Visibility) -->
            <div class="card shadow-sm border-0 mb-4 rounded-3 border-start border-4 border-primary">
                <div class="card-header bg-white py-2 fw-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-diagram-3-fill me-2"></i> Preceding Legal Opinions &amp; Recommendations Chain</span>
                    <span class="badge bg-primary-subtle text-primary">Hierarchy Review</span>
                </div>
                <div class="card-body small">
                    <div class="row g-3">
                        <!-- CLO Apex Opinion -->
                        <div class="col-12">
                            <div class="p-3 rounded border-start border-4 border-primary bg-primary-subtle shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-primary text-uppercase extra-small">
                                        <i class="bi bi-award-fill me-1"></i> Chief Law Officer (CLO) Legal Opinion &amp; Recommendation
                                    </span>
                                    <span class="badge bg-primary text-white">Apex Legal Direction</span>
                                </div>
                                <div class="text-dark fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_CLO) ? "— Pending CLO Legal Review —" : Model.Opinion_CLO)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.CO_Disposal_Decision))
                                {
                                    <div class="extra-small text-muted mt-1">
                                        CLO Stage Recommendation: <strong class="text-primary">@Model.CO_Disposal_Decision</strong> (@(Model.CO_ApprovalDate?.ToString("dd-MMM-yyyy") ?? ""))
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Divisional LO & DC Opinions -->
                        <div class="col-md-6">
                            <div class="p-2 rounded border-start border-3 border-info bg-light h-100">
                                <small class="text-muted d-block fw-bold extra-small text-uppercase">
                                    <i class="bi bi-file-earmark-person me-1"></i> Divisional Law Officer (LO) Opinion
                                </small>
                                <div class="text-dark small">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_LO) ? "—" : Model.Opinion_LO)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-2 rounded border-start border-3 border-secondary bg-light h-100">
                                <small class="text-muted d-block fw-bold extra-small text-uppercase">
                                    <i class="bi bi-building me-1"></i> Divisional Controller (DC) Opinion
                                </small>
                                <div class="text-dark small">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_DC) ? "—" : Model.Opinion_DC)
                                </div>
                            </div>
                        </div>

                        <!-- Advocate Opinion & Award Details -->
                        <div class="col-md-6">
                            <div class="p-2 rounded border-start border-3 border-dark bg-light h-100">
                                <small class="text-muted d-block fw-bold extra-small text-uppercase">
                                    <i class="bi bi-chat-square-quote me-1"></i> Trial Advocate Opinion
                                </small>
                                <div class="text-dark small">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_Advocate) ? "—" : Model.Opinion_Advocate)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-2 rounded border-start border-3 border-success bg-light h-100">
                                <small class="text-muted d-block fw-bold extra-small text-uppercase">
                                    <i class="bi bi-award me-1"></i> Labour Court Award Summary
                                </small>
                                <div class="text-dark small">
                                    @(string.IsNullOrWhiteSpace(Model.AwardDetails) ? "—" : Model.AwardDetails)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MD Action Panel -->
            <div class="card shadow-sm border-0 mb-4 border-start border-4 border-warning">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-shield-check me-2"></i> MD Action Panel (Executive Sanction)</h6>
                    <span class="badge bg-warning text-dark px-3">Competent Authority</span>
                </div>
                <div class="card-body bg-light-subtle">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold h6">Executive Decision / Action Taken</label>
                            <select class="form-select form-select-lg border-2 border-warning" asp-for="CO_ActionTaken">
                                <option value="">Select Action...</option>
                                <option value="Approved">Approved (Sanction Appeal / WP Filing)</option>
                                <option value="Rejected">Rejected (Sanction Refused / Close)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold h6">Approval Date</label>
                            <input asp-for="CO_ApprovalDate" type="date" class="form-control form-control-lg border-2 border-warning" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold h6">Managing Director (MD) Opinion &amp; Directives</label>
                            <textarea class="form-control border-2 border-warning" asp-for="CO_Remarks" rows="5" placeholder="Enter executive sanction decision, directives on High Court filing, 17(B) deposit, or closure instructions..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white text-end py-3">
                    <button type="submit" class="btn btn-success btn-lg shadow-sm px-5 fw-bold rounded-pill">
                        <i class="bi bi-check-circle-fill me-2"></i> SUBMIT MD SANCTION ACTION
                    </button>
                </div>
            </div>
        }
            else
            {
                <div class="tab-content" id="actionTabsContent">
            
            <!-- TAB 1: FEASIBILITY & INITIAL ACTION -->
            @if (Model.CO_ActionTaken != "CLOSED")
            {
            <div class="tab-pane fade show active" id="tab1" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-action"><h6 class="mb-0 fw-bold">1. Judgment & Initial Action</h6></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Divisional Opinions Reference Card -->
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <h6 class="fw-bold small text-primary mb-2 text-uppercase">
                                        <i class="bi bi-chat-square-quote me-1"></i> Preceding Trial &amp; Legal Opinions
                                    </h6>
                                    <div class="row g-2 extra-small">
                                        <div class="col-md-4">
                                            <span class="text-muted d-block fw-bold">Advocate:</span>
                                            <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.Opinion_Advocate) ? "—" : Model.Opinion_Advocate)</span>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="text-muted d-block fw-bold">Divisional LO:</span>
                                            <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.Opinion_LO) ? "—" : Model.Opinion_LO)</span>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="text-muted d-block fw-bold">Divisional DC:</span>
                                            <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.Opinion_DC) ? "—" : Model.Opinion_DC)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.Opinion_CLO))
                                        {
                                            <div class="col-12 mt-2 pt-2 border-top">
                                                <span class="badge bg-primary me-1">CLO Opinion</span>
                                                <strong class="text-primary">@Model.Opinion_CLO</strong>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.CO_Remarks))
                                        {
                                            <div class="col-12 mt-1">
                                                <span class="badge bg-warning text-dark me-1">MD Directives</span>
                                                <strong class="text-dark">@Model.CO_Remarks</strong>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Judgment Received?</label>
                                <select class="form-select" asp-for="CO_FeasibilityReceived">
                                    <option value="">SELECT...</option>
                                    <option value="true">YES</option>
                                    <option value="false">NO</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Judgment Received Date</label>
                                <input type="date" class="form-control" asp-for="CO_FeasibilityDate" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Action Taken</label>
                                <select class="form-select" asp-for="CO_ActionTaken" id="coActionTaken">
                                    <option value="">SELECT...</option>
                                    <option value="PENDING FOR DECISION">PENDING BEFORE CLO/LO</option>
                                    <option value="PENDING BEFORE COMPETENT AUTHORITY">PENDING BEFORE COMPETENT AUTHORITY</option>
                                    <option value="APPEAL">APPEAL</option>
                                    <option value="CLOSED">CLOSED</option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold"><i class="bi bi-upload me-1"></i>Upload Noting Sheet (Max 2)</label>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <input type="file" class="form-control" asp-for="JudgmentCopyFile" accept=".pdf,.jpg,.jpeg,.png" />
                                        @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath))
                                        {
                                            <a href="@Model.JudgmentCopyPath" target="_blank" class="small text-decoration-none ms-1 mt-1 d-inline-block"><i class="bi bi-file-earmark-pdf text-danger"></i> View Copy 1</a>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <input type="file" class="form-control" asp-for="JudgmentCopyFile2" accept=".pdf,.jpg,.jpeg,.png" />
                                        @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath2))
                                        {
                                            <a href="@Model.JudgmentCopyPath2" target="_blank" class="small text-decoration-none ms-1 mt-1 d-inline-block"><i class="bi bi-file-earmark-pdf text-danger"></i> View Copy 2</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12" id="feasibilityApprovalSection" style="display:none;">
                                <div class="bg-light p-3 rounded">
                                    <h6 class="small fw-bold border-bottom pb-2 mb-2">If Closed (Approval Details)</h6>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Approval Outward No</label>
                                            <input type="text" class="form-control" asp-for="CO_ApprovalOutwardNo" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Approval Date</label>
                                            <input type="date" class="form-control" asp-for="CO_ApprovalDate" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold"><i class="bi bi-upload me-1"></i> Upload Closed Document</label>
                                            <input type="file" class="form-control" name="ClosedDocumentFile" accept=".pdf,.jpg,.jpeg,.png" />
                                            <small class="text-muted italic">Note: If the case is closed, please upload the supporting document here.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            }

            <!-- TAB 2: WP CORP (SECTIONS 2, 3, 4) -->
            <div class="tab-pane fade @(Model.CO_ActionTaken == "CLOSED" ? "show active" : "")" id="tab2" role="tabpanel">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-action"><h6 class="mb-0 fw-bold">2. Appeal Filed by Corporation (Writ Petition)</h6></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-12" id="wpPendingContainer">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="chkWPPending">
                                    <label class="form-check-label fw-bold text-muted" for="chkWPPending">
                                        Pending for Filing (No WP Case Number)
                                    </label>
                                    <input type="hidden" asp-for="CO_WP_CaseStatus_Option" id="hdnWPCaseStatus" />
                                </div>
                            </div>
                            <div id="wpDetailsRow" class="col-12" style="display:none;">
                                <div class="row g-3">
                                     <div class="col-md-6">
                                        <label class="form-label">WP Case Number</label>
                                        <input type="text" class="form-control" asp-for="CO_WP_CaseNumber" maxlength="6" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Year</label>
                                        <input type="number" class="form-control" asp-for="CO_WP_Year" />
                                    </div>
                                </div>
                            </div>

                            <!-- Official e-Courts High Court Live Gateway Integration (Corporation WP) -->
                            <div class="col-12">
                                <div class="card border border-primary border-opacity-25 bg-primary-subtle bg-opacity-10 rounded-3">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label class="form-label mb-0 fw-bold text-primary text-uppercase extra-small">
                                                <i class="bi bi-broadcast me-1 text-danger animate-pulse"></i> Official High Court e-Courts Live Gateway (Corporation WP CNR)
                                            </label>
                                            @if (!string.IsNullOrEmpty(Model.CO_WP_CNRNumber))
                                            {
                                                <span class="badge bg-success px-2 py-1 extra-small"><i class="bi bi-wifi me-1"></i>High Court CNR Linked (@Model.CO_WP_CNRNumber)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark px-2 py-1 extra-small"><i class="bi bi-exclamation-triangle me-1"></i>Unlinked</span>
                                            }
                                        </div>
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-7">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-white border-primary-subtle font-monospace fw-bold text-primary">High Court CNR</span>
                                                    <input asp-for="CO_WP_CNRNumber" class="form-control border-primary-subtle font-monospace fw-bold text-uppercase" id="txtCOWPCNRNumber" placeholder="16-digit High Court CNR (e.g. KAHC020060752019)" maxlength="16" />
                                                </div>
                                                <span asp-validation-for="CO_WP_CNRNumber" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-5">
                                                <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm" onclick="autoFetchHighCourtCNR('CO_WP')">
                                                    <i class="bi bi-search me-1"></i> Auto-Fetch High Court Live
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Live Sync Status Banner -->
                                        <div id="ecourtsWPSyncBanner" class="mt-3 p-2 bg-white rounded border border-success d-none">
                                            <div class="row g-2 extra-small text-dark">
                                                <div class="col-md-3"><strong>Petitioner:</strong> <span id="lblWPPetitioner" class="text-primary fw-bold">—</span></div>
                                                <div class="col-md-3"><strong>Respondent:</strong> <span id="lblWPRespondent" class="text-dark">—</span></div>
                                                <div class="col-md-3"><strong>Court Hall / Bench:</strong> <span id="lblWPBench" class="badge bg-info text-dark">—</span></div>
                                                <div class="col-md-3"><strong>Next Date:</strong> <span id="lblWPNextDate" class="text-danger fw-bold">—</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">High Court Bench</label>
                                <select class="form-select" asp-for="CO_WP_HighCourtBench">
                                    <option>DHARWAD</option>
                                    <option>KALABURAGI</option>
                                    <option>BANGALORE</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Entrustment No</label>
                                <input type="text" class="form-control" asp-for="CO_WP_EntrustmentNo" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Entrustment Date</label>
                                <input type="date" class="form-control" asp-for="CO_WP_EntrustmentDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Advocate Name</label>
                                <select class="form-select" asp-for="CO_WP_AdvocateName">
                                    <option value="">Select Advocate...</option>
                                    @if (ViewBag.Advocates != null)
                                    {
                                        foreach (var advocate in ViewBag.Advocates)
                                        {
                                            <option value="@advocate.AdvocateName">@advocate.AdvocateName</option>
                                        }
                                    }
                                    <option value="Others">OTHERS</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Interim Stay Granted?</label>
                                <select class="form-select" asp-for="CO_WP_StayGranted" id="wpStayGranted">
                                    <option value="false">NO</option>
                                    <option value="true">YES</option>
                                </select>
                            </div>

                            <div class="col-12" id="wpStayDetails" style="display:none;">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <h6 class="small fw-bold border-bottom pb-2 mb-3 text-muted">WP Stay Details</h6>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label">Approval Outward No</label>
                                                <input type="text" class="form-control" asp-for="CO_WP_StayApprovalNo" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Date of Stay</label>
                                                <input type="date" class="form-control" asp-for="CO_WP_StayDate" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Nature of Order</label>
                                                <input type="text" class="form-control" asp-for="CO_WP_StayNature" placeholder="Enter nature of order..." />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Upload Stay Order Copy</label>
                                                <input type="file" class="form-control" asp-for="StayOrderFile" accept=".pdf,.jpg,.jpeg,.png" />
                                                @if (!string.IsNullOrEmpty(Model.CO_WP_StayOrderPath))
                                                {
                                                    <div class="mt-2 text-success">
                                                        <i class="bi bi-file-earmark-check-fill"></i> 
                                                        <a href="@Model.CO_WP_StayOrderPath" target="_blank" class="text-success text-decoration-underline small">View Uploaded Copy</a>
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Stay Remarks</label>
                                                <textarea class="form-control" asp-for="CO_WP_StayRemark" rows="2" placeholder="Enter remarks..."></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12 mt-4"><hr /></div>
                            
                            

                            <h6 class="small fw-bold border-bottom pb-2 mb-3 text-muted" id="headerReinstatement">Workman Reinstatement Details</h6>

                            <div class="col-md-4" id="divWorkmanReinstated">
                                <label class="form-label">Workman Reinstated?</label>
                                <select class="form-select" asp-for="CO_IsWorkmanReinstated" id="workmanReinstated">
                                    <option value="false">NO</option>
                                    <option value="true">YES</option>
                                </select>
                            </div>

                            <div class="col-12" id="reinstatementDetails" style="display:none;">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <div class="row g-3">
                                            <div class="col-md-4" id="divSubjectToWP">
                                                <label class="form-label">Reinstated Subject to WP?</label>
