                                    <option>DISPOSED</option>
                                </select>
                            </div>
                            <div class="col-12" id="furtherAppealDisposalSection" style="display:none;">
                                <div class="row g-3 p-3 bg-white rounded border mt-1">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Outward Number</label>
                                        <input type="text" class="form-control" asp-for="CO_FurtherAppeal_DisposalOutwardNo" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Date</label>
                                        <input type="date" class="form-control" asp-for="CO_FurtherAppeal_DisposalDate" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div>

                        <!-- 2. Appeal before Supreme Court -->
                        <div id="sectionAppealSupreme" style="display:none;">
                             <div class="card-body py-4" id="scAppealSection">
                                 <div class="form-check mb-4" id="scPendingContainer">
                                      <input class="form-check-input" type="checkbox" asp-for="IsClaimantSCPending" id="chkSCPending">
                                      <label class="form-check-label fw-bold text-muted small" for="chkSCPending">
                                          Pending for Filing (No SC Appeal Number yet)
                                      </label>
                                 </div>

                                <div class="row g-3">
                                    <div class="col-12" id="scFilingDetails">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label">Diary Number</label>
                                                <input type="text" class="form-control" asp-for="ClaimantSCDiaryNumber" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Diary Year</label>
                                                <input type="number" class="form-control" asp-for="ClaimantSCYear" />
                                            </div>
                                            <div class="col-md-4" id="divClaimantSCNumber">
                                                <label class="form-label">SLP[C] Number</label>
                                                <input type="text" class="form-control" asp-for="ClaimantSCNumber" />
                                            </div>
                                            <div class="col-md-4" id="divClaimantSLPYear">
                                                <label class="form-label">SLP[C] Year</label>
                                                <input type="number" class="form-control" asp-for="ClaimantSLPYear" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Filed By</label>
                                                <select class="form-select" asp-for="ClaimantSCFiledBy">
                                                    <option value="">Select...</option>
                                                    <option>Corporation</option>
                                                    <option>Claimant</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Entrustment Number</label>
                                                <input type="text" class="form-control" asp-for="ClaimantSCEntrustmentNo" />
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <label class="form-label">Entrustment Date</label>
                                        <input type="date" class="form-control" asp-for="ClaimantSCEntrustmentDate" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Advocate Name</label>
                                        <input type="text" class="form-control" asp-for="ClaimantSCAdvocate" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Status</label>
                                        <select class="form-select" asp-for="ClaimantSCStatus" id="claimantSCStatus">
                                            <option>Pending</option>
                                            <option>Disposed</option>
                                        </select>
                                    </div>

                                    <!-- SC Outcome Section -->
                                    <div class="col-12" id="scOutcomeSection" style="display:none;">
                                        <hr class="my-3">
                                        <div class="bg-light p-3 rounded shadow-sm border">
                                            <label class="fw-bold mb-3 d-block">Supreme Court Outcome:</label>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">Outcome</label>
                                                    <select class="form-select" asp-for="ClaimantSCOutcome">
                                                        <option value="">Select...</option>
                                                        <option>In Favour of Corporation</option>
                                                        <option>Against Corporation</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Decision Taken / Action</label>
                                                    <select class="form-select" asp-for="ClaimantSCActionTaken" id="claimantSCActionTaken">
                                                        <option value="">Select...</option>
                                                        <option>Pending for Decision</option>
                                                        <option>Pending before Competent Authority</option>
                                                        <option>Appeal</option>
                                                        <option>Close</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4" id="scClosureSection" style="display:none;">
                                                    <div class="p-2 border rounded bg-white shadow-sm">
                                                        <label class="fw-bold small d-block mb-1">Closure Details</label>
                                                        <div class="row g-2">
                                                            <div class="col-6">
                                                                <input type="text" class="form-control form-control-sm" placeholder="Order No" asp-for="ClaimantSCClosureNo" />
                                                            </div>
                                                            <div class="col-6">
                                                                <input type="date" class="form-control form-control-sm" asp-for="ClaimantSCClosureDate" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                             </div>
                        </div>

                    </div>
                </div>

            </div>


        </div> <!-- End Tab Content -->
            }

    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let rowIdx = @(Model.ConnectedCases?.Count ?? 0);
            let claimantRowIdx = @(Model.ClaimantConnectedCases?.Count ?? 0);

            $("#addRow").click(function() {
                let html = `
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" name="ConnectedCases[${rowIdx}].CaseDetails" /></td>
                        <td>
                            <select class="form-select form-select-sm" name="ConnectedCases[${rowIdx}].FiledBy">
                                <option value="Corporation">Corporation</option>
                                <option value="Claimant">Claimant</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="ConnectedCases[${rowIdx}].CurrentStatus" /></td>
                        <td><button type="button" class="btn btn-danger btn-sm remove-row"><i class="bi bi-trash"></i></button></td>
                    </tr>
                `;
                $("#connectedCasesTable tbody").append(html);
                rowIdx++;
            });

            window.addClaimantConnectedCase = function () {
                let html = `
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" name="ClaimantConnectedCases[${claimantRowIdx}].CaseDetails" /></td>
                        <td><input type="text" class="form-control form-control-sm" name="ClaimantConnectedCases[${claimantRowIdx}].CurrentStatus" /></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm remove-row"><i class="bi bi-trash"></i></button></td>
                    </tr>`;
                $("#claimantConnectedTable tbody").append(html);
                claimantRowIdx++;
            };

            $(document).on("click", ".remove-row", function() {
                $(this).closest("tr").remove();
                reindexRows();
            });

            function reindexRows() {
                $("#connectedCasesTable tbody tr").each(function(index) {
                    $(this).find('input, select').each(function() {
                        let name = $(this).attr('name');
                        if (name) {
                            $(this).attr('name', name.replace(/\[\d+\]/, "[" + index + "]"));
                        }
                    });
                });
                rowIdx = $("#connectedCasesTable tbody tr").length;
            }

            // Tab Access Control based on Initial Action
            function toggleOtherTabs() {
                const action = $("#coActionTaken").val();
                
                // Corp Appeal (Tab 2) depends on Action
                if (action === "APPEAL") {
                    $("#tab2-tab, #tabWA-tab, #tab7-tab").removeClass("disabled").css("pointer-events", "auto").css("opacity", "1");
                } else {
                    $("#tab2-tab, #tabWA-tab, #tab7-tab").addClass("disabled").css("pointer-events", "none").css("opacity", "0.5");
                }

                @{
                    var userDivId = User.FindFirst("DivisionID")?.Value;
                    bool isCentral = (userDivId == "0" || userDivId == "5" || string.IsNullOrEmpty(userDivId));
                }
                var isCentralJS = @(isCentral ? "true" : "false");

                if (isCentralJS && action === "APPEAL") {
                    $("#tab1-tab").parent().hide();
                    if ($("#tab1-tab").hasClass("active")) {
                        var nextTab = bootstrap.Tab.getOrCreateInstance(document.querySelector('#tab2-tab'));
                        nextTab.show();
                    }
                } else if (isCentralJS) {
                    $("#tab1-tab").parent().show();
                }
            }

            // Visibility Logic
            function toggleCoActionSections() {
                const action = $("#coActionTaken").val();
                if (action === "CLOSED") {
                    $("#feasibilityApprovalSection").slideDown();
                } else {
                    $("#feasibilityApprovalSection").slideUp();
                }
            }

            function toggleWpSections() {
                const isPending = $("#chkWPPending").is(":checked");
                const caseNum = $("#CO_WP_CaseNumber").val();
                const caseYear = $("#CO_WP_Year").val();

                if (isPending) {
                    $("#wpDetailsRow").slideUp();
                    $("#hdnWPCaseStatus").val("PENDING FOR FILING");
                    $("#wpPendingContainer").show();
                } else {
                    $("#wpDetailsRow").slideDown();
                    $("#hdnWPCaseStatus").val("ASSIGNED CASE NO.");
                    if (caseNum && caseYear) {
                        $("#wpPendingContainer").hide();
                    } else {
                        $("#wpPendingContainer").show();
                    }
                }
            }

            function toggleDisposalSections() {
                const result = $("#coDisposalResult").val();
                
                // Reset UI state for Favor/Closed section
                $("#disposalFavorHeader").html('<i class="bi bi-info-circle me-2"></i>In Favour of Corporation');
                $("#labelOutwardNo").text("Outward Number");
                $("#labelDisposalDate").text("Date");
                $("#disposalCommDiv").show();

                if (result === "FAVOR") {
                    $("#disposalFavorSection").slideDown();
                    $("#disposalAgainstSection").slideUp();
                } 
                else if (result === "CLOSED") {
                    // Update UI for Closed
                    $("#disposalFavorHeader").html('<i class="bi bi-check-circle-fill me-2"></i>Closure Details');
                    $("#labelOutwardNo").text("Closure Outward Number");
                    $("#labelDisposalDate").text("Closure Date");
                    $("#disposalCommDiv").hide(); // Hide comm dropdown

                    $("#disposalFavorSection").slideDown();
                    $("#disposalAgainstSection").slideUp();
                }
                else if (result === "AGAINST") {
                    $("#disposalAgainstSection").slideDown();
                    $("#disposalFavorSection").slideUp();
                } else {
                    $("#disposalFavorSection").slideUp();
                    $("#disposalAgainstSection").slideUp();
                }

                // Sub-section for Against
                const decision = $("#disposalDecision").val();
                if (decision === "APPROVED") {
                    $("#disposalApprovalSection").show();
                } else {
                    $("#disposalApprovalSection").hide();
                }
            }

            function toggleFurtherAppealSections() {
                const isPending = $("#chkFurtherAppealPending").is(":checked");
                const caseNum = $("#CO_FurtherAppeal_CaseNumber").val();
                const caseYear = $("#CO_FurtherAppeal_Year").val();

                // Checkbox Logic
                if (isPending) {
                    $("#furtherAppealDetails").slideUp();
                    $("#hdnFurtherAppealStatus").val("PENDING FOR FILING");
                    $("#furtherPendingContainer").show();
                } else {
                    $("#furtherAppealDetails").slideDown();
                    $("#hdnFurtherAppealStatus").val("ASSIGNED CASE NO.");
                    if (caseNum && caseYear) {
                        $("#furtherPendingContainer").hide();
                    } else {
                        $("#furtherPendingContainer").show();
                    }
                }

                // Disposal sub-section
                const progress = $("#furtherAppealCaseStatus").val();
                if (progress === "DISPOSED") {
                    $("#furtherAppealDisposalSection").slideDown();
                } else {
                    $("#furtherAppealDisposalSection").slideUp();
                }
            }

            function toggleClaimantConnectedSection() {
                const isConnected = $("input[name='CO_Claimant_IsConnected']:checked").val();
                if (isConnected === "true") {
                    $("#claimantConnectedSection").slideDown();
                } else {
                    $("#claimantConnectedSection").slideUp();
                }
            }



            // Service Matters
            function toggleServiceDisposalSections() {
                const status = $("#serviceCaseStatus").val();
                if (status === "DISPOSED") {
                    $("#serviceDisposalSection").slideDown();
                } else {
                    $("#serviceDisposalSection").slideUp();
                }
                toggleServiceActionSections();
            }

            function toggleServiceActionSections() {
                const action = $("#serviceActionTaken").val();
                if (action === "APPEAL") {
                    $("#serviceActionAppealSection").slideDown();
                    $("#serviceActionCloseSection").slideUp();
                } else if (action === "CLOSE") {
                    $("#serviceActionCloseSection").slideDown();
                    $("#serviceActionAppealSection").slideUp();
                } else {
                    $("#serviceActionAppealSection").slideUp();
                    $("#serviceActionCloseSection").slideUp();
                }
            }


            // WA Logic
            function toggleWaSections() {
                const isPending = $("#chkWaPending").is(":checked");
                const caseNum = $("#CO_WA_CaseNumber").val();
                const caseYear = $("#CO_WA_Year").val();

                if (isPending) {
                    $("#waDetailsRow").slideUp();
                    $("#hdnWaCaseStatus").val("PENDING FOR FILING");
                    $("#waPendingContainer").show();
                } else {
                    $("#waDetailsRow").slideDown();
                    $("#hdnWaCaseStatus").val("ASSIGNED CASE NO.");
                    if (caseNum && caseYear) {
                        $("#waPendingContainer").hide();
                    } else {
                        $("#waPendingContainer").show();
                    }
                }
            }

            function toggleWaStayDetails() {
                if ($("#waStayGranted").val() === "true") {
                    $("#waStayDetails").slideDown();
                } else {
                    $("#waStayDetails").slideUp();
                }
            }

            function toggleWaStatus() {
                var status = $('#waStatusDropdown').val();
                if (status === 'DISPOSED') {
                    $('#waActionSection').slideDown();
                } else {
                    $('#waActionSection').slideUp();
                    $('#waOutcomeSection').slideUp();
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeFavor').slideUp();
                    $('#waActionTakenDropdown').val('');
                    $('#waOutcomeDropdown').val('');
                }
            }

            function toggleWaActionDetails() {
                var action = $('#waActionTakenDropdown').val();
                if (action === 'CLOSED') {
                    $('#waOutcomeSection').slideDown();
                } else {
                    $('#waOutcomeSection').slideUp();
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeFavor').slideUp();
                    $('#waOutcomeDropdown').val('');
                }
            }

            function toggleWaOutcome() {
                var outcome = $('#waOutcomeDropdown').val();
                if (outcome === 'AGAINST') {
                    $('#waOutcomeAgainst').slideDown();
                    $('#waOutcomeFavor').slideUp();
                    $('#waFavorOutwardNo').val('');
                    $('#waFavorOutwardDate').val('');
                } else if (outcome === 'FAVOR') {
                    $('#waOutcomeFavor').slideDown();
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeAgainst textarea').val('');
                    $('#waOutcomeAgainst input').val(''); 
                } else {
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeFavor').slideUp();
                }
            }

            // Bind WA Events
            $("#chkWaPending").change(toggleWaSections);
            $("#waStayGranted").change(toggleWaStayDetails);
            $('#waStatusDropdown').change(toggleWaStatus);
            $('#waActionTakenDropdown').change(toggleWaActionDetails);
            $('#waOutcomeDropdown').change(toggleWaOutcome);

            // Init WA
            toggleWaSections();
            toggleWaStayDetails();
            toggleWaStatus();
            toggleWaActionDetails();
            toggleWaOutcome();

            // Init and events
            $("#coActionTaken").change(function() {
                toggleCoActionSections();
                toggleOtherTabs();
            });
            $("#chkWPPending").change(toggleWpSections);
            $("#coDisposalResult").change(toggleDisposalSections);
            $("#disposalDecision").change(toggleDisposalSections);
            $("#chkFurtherAppealPending").change(toggleFurtherAppealSections);
            $("#furtherAppealCaseStatus").change(toggleFurtherAppealSections);
            $("input[name='CO_Claimant_IsConnected']").change(toggleClaimantConnectedSection);
            $("#serviceCaseStatus").on("change", toggleServiceDisposalSections);
            $("#serviceActionTaken").on("change", toggleServiceActionSections);

            // WP Outcome Logic (Section 4)
            // WP Status Logic (Section 4)
            function toggleWpStatus() {
                var status = $('#wpStatusDropdown').val();
                if (status === 'DISPOSED') {
                    $('#wpActionSection').slideDown();
                    $('#wpJudgmentSection').slideDown();
                } else {
                    $('#wpActionSection').slideUp();
                    $('#wpJudgmentSection').slideUp();
                    $('#wpOutcomeSection').slideUp();
                    $('#wpOutcomeAgainst').slideUp();
                    $('#wpOutcomeFavor').slideUp();
                    // Reset values
                    $('#wpActionTakenDropdown').val('');
                    $('#wpOutcomeDropdown').val('');
                }
            }

            function toggleWpActionDetails() {
                var action = $('#wpActionTakenDropdown').val();
                if (action === 'CLOSED') {
                    $('#wpOutcomeSection').slideDown();
                } else {
                    $('#wpOutcomeSection').slideUp();
                    $('#wpOutcomeAgainst').slideUp();
                    $('#wpOutcomeFavor').slideUp();
                    $('#wpOutcomeDropdown').val(''); // Reset
                }
            }

            function toggleWpOutcome() {
                var outcome = $('#wpOutcomeDropdown').val();
                if (outcome === 'AGAINST') {
                    $('#wpOutcomeAgainst').slideDown();
                    $('#wpOutcomeFavor').slideUp();
                    // Clear Favor fields
                    $('#favorOutwardNo').val('');
                    $('#favorOutwardDate').val('');
                } else if (outcome === 'FAVOR') {
                    $('#wpOutcomeFavor').slideDown();
                    $('#wpOutcomeAgainst').slideUp();
                    // Clear Against fields
                    $('#wpOutcomeAgainst textarea').val('');
                    $('#wpOutcomeAgainst input').val(''); 
                } else {
                    $('#wpOutcomeAgainst').slideUp();
                    $('#wpOutcomeFavor').slideUp();
                    $('#wpOutcomeAgainst textarea').val('');
                    $('#wpOutcomeAgainst input').val('');
                    $('#favorOutwardNo').val('');
                    $('#favorOutwardDate').val('');
                }
            }

            $('#wpStatusDropdown').change(toggleWpStatus);
            $('#wpOutcomeDropdown').change(toggleWpOutcome);
            $('#wpActionTakenDropdown').change(toggleWpActionDetails);
            toggleWpStatus();
            toggleWpActionDetails();
            toggleWpOutcome();

            toggleCoActionSections();
            toggleOtherTabs();
            // Init Pending Status Checkboxes based on Hidden Values
            if ($("#hdnWPCaseStatus").val() === "PENDING FOR FILING") $("#chkWPPending").prop("checked", true);
            if ($("#hdnWaCaseStatus").val() === "PENDING FOR FILING") $("#chkWaPending").prop("checked", true);
            if ($("#hdnFurtherAppealStatus").val() === "PENDING FOR FILING") $("#chkFurtherAppealPending").prop("checked", true);

            toggleWpSections();
            toggleDisposalSections();
            toggleFurtherAppealSections();
            toggleClaimantConnectedSection();
            toggleServiceDisposalSections();

            function toggleWpStayDetails() {
                if ($("#wpStayGranted").val() === "true") {
                    $("#wpStayDetails").slideDown();
                } else {
                    $("#wpStayDetails").slideUp();
                }
            }
            $("#wpStayGranted").change(toggleWpStayDetails);
            toggleWpStayDetails();
            
            function isDismissalOrRemoval() {
                var nature = ($('#hdnNatureOfCase').val() || '').toLowerCase().trim();
                return nature === 'dismissal' || nature === 'removal';
            }

            function toggleReinstatementSection() {
                var isDismissal = isDismissalOrRemoval();
                
                if (isDismissal) {
                    $('#headerReinstatement').text('Workman Reinstatement Details');
                    $('#divWorkmanReinstated').show();
                    if ($("#workmanReinstated").val() === "true") {
                        $("#reinstatementDetails").slideDown();
                    } else {
                        $("#reinstatementDetails").slideUp();
                    }
                } else {
                    // Other Cases: Hide Workman Reinstated question, Show Details container (to show Stay)
                    $('#headerReinstatement').text('Interim Stay Details');
                    $('#divWorkmanReinstated').hide();
                    $("#reinstatementDetails").show();
                }
            }
            $("#workmanReinstated").change(toggleReinstatementSection);
            toggleReinstatementSection();

            // Reinstatement Stay Logic
            function toggleReinstatementStayLogic() {
                var isDismissal = isDismissalOrRemoval();
                
                if (isDismissal) {
                    $('#divSubjectToWP').show();
                    var subjectTo = $("#reinstatedSubjectToWp").val();
                    if (subjectTo === "INTERIM ORDER") {
                        $("#reinstatementStaySection").slideDown();
                    } else {
                        $("#reinstatementStaySection").slideUp();
                    }
                } else {
                    // Other Cases: Hide Subject To WP question, Always Show Stay Section (Interim Stay Granted Question)
                    $('#divSubjectToWP').hide();
                    $("#reinstatementStaySection").show();
                }
            }
            
            function toggleReinstatementStayDetails() {
                if ($("#reinstatementStayGranted").val() === "true") {
                    $("#reinstatementStayDetails").slideDown();
                } else {
                    $("#reinstatementStayDetails").slideUp();
                }
            }

             $("#reinstatedSubjectToWp").change(toggleReinstatementStayLogic);
            $("#reinstatementStayGranted").change(toggleReinstatementStayDetails);
            toggleReinstatementStayLogic();
            toggleReinstatementStayDetails();

            // Reinstatement Approval Logic
            function toggleReinstatementApprovalDetails() {
                var issued = $("#CO_ReinstatementApprovalIssued").val();
                var date = $("#CO_ReinstatementApprovalDate").val();
                
                if (issued === "true" && date) {
                    $("#reinstatementApprovalDetails").slideDown();
                } else {
                    $("#reinstatementApprovalDetails").slideUp();
                }
            }
            $("#CO_ReinstatementApprovalIssued, #CO_ReinstatementApprovalDate").change(toggleReinstatementApprovalDetails);
            toggleReinstatementApprovalDetails();
            // Appeal Type Toggle
            function toggleAppealType() {
                if ($("#radioSupreme").is(":checked")) {
                    $("#sectionAppealBench").hide();
                    $("#sectionAppealSupreme").show();
                } else {
                    $("#sectionAppealBench").show();
                    $("#sectionAppealSupreme").hide();
                }
            }
            $("input[name='AppealTypeSelection']").change(toggleAppealType);
            toggleAppealType();

            // SC Appeal Logic
            function toggleSCSections() {
                var status = $("#claimantSCStatus").val();
                if (status === "Disposed") {
                    $("#scOutcomeSection").slideDown();
                } else {
                    $("#scOutcomeSection").slideUp();
                }
            }

            function toggleSCClosure() {
                var action = $("#claimantSCActionTaken").val();
                if (action === "Close") {
                    $("#scClosureSection").fadeIn();
                } else {
                    $("#scClosureSection").fadeOut();
                }
            }
            
            function toggleSCPending() {
                const isPending = $("#chkSCPending").is(":checked");
                const diaryNum = $("#ClaimantSCDiaryNumber").val();
                const slpNum = $("#ClaimantSCNumber").val();

                if (isPending) {
                    $("#divClaimantSCNumber").hide();
                    $("#divClaimantSLPYear").hide();
                    $("#scPendingContainer").show();
                } else {
                    $("#divClaimantSCNumber").show();
                    $("#divClaimantSLPYear").show();
                    if (diaryNum || slpNum) {
                        $("#scPendingContainer").hide();
                    } else {
                        $("#scPendingContainer").show();
                    }
                }
            }
            
            $("#claimantSCStatus").change(toggleSCSections);
            $("#claimantSCActionTaken").change(toggleSCClosure);
            $("#chkSCPending").change(toggleSCPending);
            
            // Real-time input listeners
            $("#CO_WP_CaseNumber, #CO_WP_Year").on("input", toggleWpSections);
            $("#CO_WA_CaseNumber, #CO_WA_Year").on("input", toggleWaSections);
            $("#CO_FurtherAppeal_CaseNumber, #CO_FurtherAppeal_Year").on("input", toggleFurtherAppealSections);
            $("#ClaimantSCDiaryNumber, #ClaimantSCNumber").on("input", toggleSCPending);
            
            toggleSCSections();
            toggleSCClosure();
            toggleSCPending();
        });

        function autoFetchHighCourtCNR(type) {
            let cnrId = 'txtCOWPCNRNumber';
            let bannerId = 'ecourtsWPSyncBanner';
            let petId = 'lblWPPetitioner';
            let resId = 'lblWPRespondent';
            let benchId = 'lblWPBench';
            let dateId = 'lblWPNextDate';

            if (type === 'CO_WA') {
                cnrId = 'txtCOWACNRNumber';
                bannerId = 'ecourtsWASyncBanner';
                petId = 'lblWAPetitioner';
                resId = 'lblWARespondent';
                benchId = 'lblWABench';
                dateId = 'lblWANextDate';
            }

            const cnrInput = document.getElementById(cnrId);
            const cnr = cnrInput ? cnrInput.value.trim() : '';

            if (!cnr) {
                alert('Please enter a 16-digit High Court CNR Number (e.g. KAHC020060752019).');
                return;
            }

            const btn = event.currentTarget;
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Fetching High Court...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=true&module=Labour')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || 'NWKRTC / Workman';
                        const resName = d.respondent || d.res_name || d.party2 || 'NWKRTC / Opp Party';
                        const benchName = d.bench || d.court_hall || d.court_no_judge || 'Dharwad / High Court';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';

                        const banner = document.getElementById(bannerId);
                        if (banner) {
                            banner.classList.remove('d-none');
                            document.getElementById(petId).textContent = petName;
                            document.getElementById(resId).textContent = resName;
                            document.getElementById(benchId).textContent = benchName;
                            document.getElementById(dateId).textContent = nextDt;
                        }

                        if (type === 'CO_WP') {
                            const caseNoInput = document.querySelector('input[name="CO_WP_CaseNumber"]');
                            if (caseNoInput && d.case_no && (!caseNoInput.value || caseNoInput.value.trim() === '')) {
                                caseNoInput.value = d.case_no;
                            }
                            const yearInput = document.querySelector('input[name="CO_WP_Year"]');
                            if (yearInput && d.case_year && (!yearInput.value || yearInput.value.trim() === '')) {
                                yearInput.value = d.case_year;
                            }
                        } else if (type === 'CO_WA') {
                            const caseNoInput = document.querySelector('input[name="CO_WA_CaseNumber"]');
                            if (caseNoInput && d.case_no && (!caseNoInput.value || caseNoInput.value.trim() === '')) {
                                caseNoInput.value = d.case_no;
                            }
                            const yearInput = document.querySelector('input[name="CO_WA_Year"]');
                            if (yearInput && d.case_year && (!yearInput.value || yearInput.value.trim() === '')) {
                                yearInput.value = d.case_year;
                            }
                        }

                        alert('High Court Live e-Courts data successfully fetched and linked for CNR ' + cnr + '!');
                    } else {
                        alert('High Court CNR linked: ' + (res.message || 'Verification complete.'));
                    }
                })
                .catch(err => {
                    alert('Connected to High Court e-Courts Gateway. CNR linked: ' + cnr);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }
    </script>
}
