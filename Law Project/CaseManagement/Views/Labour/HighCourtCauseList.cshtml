@{
    ViewData["Title"] = "High Court Cause List & Appeals Analysis — Labour";
}

<style>
    .hc-page-container {
        width: 100%;
        max-width: 100%;
    }
    .hc-header-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
        color: #fff;
        border-radius: 14px;
    }
    .kpi-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.07) !important;
    }
    .animate-pulse {
        animation: pulse 1.8s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.65; transform: scale(1.03); }
        100% { opacity: 1; transform: scale(1); }
    }
    .hc-tab-btn {
        border-radius: 8px;
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.92rem;
        transition: all 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .hc-tab-btn.active {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
        color: #fff !important;
        border-color: #0369a1 !important;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
    }
    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }
</style>

<div class="container-fluid py-4 hc-page-container">
    <!-- Header Banner -->
    <div class="hc-header-banner p-4 mb-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1">
                    <i class="bi bi-shield-check me-1"></i>LABOUR HIGH COURT REGISTRY
                </span>
                <span class="badge bg-danger text-white font-monospace fw-bold px-2 py-1">
                    <i class="bi bi-broadcast me-1"></i>LIVE E-COURTS NAPIX GATEWAY
                </span>
            </div>
            <h3 class="fw-bold mb-1 text-white">
                <i class="bi bi-diagram-3-fill text-warning me-2"></i>High Court Appeals &amp; Cause List Analysis
            </h3>
            <p class="text-light text-opacity-75 small mb-0">
                Track Writ Petitions (WP), Writ Appeals (WA), Service Challenges &amp; Live Next Hearing Dates across Bengaluru, Dharwad &amp; Kalaburagi Benches.
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-warning btn-sm fw-bold shadow-sm px-3 py-2" type="button" id="btnSyncAll" onclick="syncAllVisibleCnrs()">
                <i class="bi bi-arrow-repeat me-1"></i> Sync All Visible CNRs
            </button>
            <button class="btn btn-outline-light btn-sm px-3 py-2" onclick="initTrackedCases(true)" title="Reload listings from database">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            <a href="/Labour/Index" class="btn btn-sm btn-outline-info px-3 py-2" title="Labour Cases Dashboard">
                <i class="bi bi-grid-fill me-1"></i> Labour Dashboard
            </a>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-3 shadow-sm border" id="hcTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link hc-tab-btn active py-2.5 px-4" id="tracked-tab" data-bs-toggle="tab" data-bs-target="#tracked-cases" type="button" role="tab">
                <i class="bi bi-building me-2"></i>Connected High Court Cases (<span id="badgeTotalCases">0</span>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link hc-tab-btn py-2.5 px-4" id="daily-tab" data-bs-toggle="tab" data-bs-target="#daily-causelist" type="button" role="tab" onclick="initDailyCauselist()">
                <i class="bi bi-calendar-event me-2"></i>Daily Court Hall Cause List (Official e-Courts)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="hcTabsContent">
        <!-- TAB 1: CONNECTED HIGH COURT CASES & ANALYSIS -->
        <div class="tab-pane fade show active" id="tracked-cases" role="tabpanel">
            
            <!-- Analysis KPI Summary Cards -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-3 mb-4" id="kpiContainer">
                <div class="col">
                    <div class="card border-0 shadow-sm border-start border-4 border-primary bg-white kpi-card h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted extra-small text-uppercase fw-bold">Total HC Appeals</span>
                                    <h3 class="fw-bold text-primary mb-0 mt-1" id="kpiTotal">0</h3>
                                </div>
                                <div class="bg-primary-subtle p-3 rounded-3 text-primary">
                                    <i class="bi bi-card-list fs-3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card border-0 shadow-sm border-start border-4 border-danger bg-white kpi-card h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted extra-small text-uppercase fw-bold">Listed Today</span>
                                    <h3 class="fw-bold text-danger mb-0 mt-1" id="kpiToday">0</h3>
                                </div>
                                <div class="bg-danger-subtle p-3 rounded-3 text-danger">
                                    <i class="bi bi-bell-fill fs-3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card border-0 shadow-sm border-start border-4 border-warning bg-white kpi-card h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted extra-small text-uppercase fw-bold">Next 7 Days</span>
                                    <h3 class="fw-bold text-warning mb-0 mt-1" id="kpiWeek">0</h3>
                                </div>
                                <div class="bg-warning-subtle p-3 rounded-3 text-warning">
                                    <i class="bi bi-calendar-week fs-3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card border-0 shadow-sm border-start border-4 border-success bg-white kpi-card h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted extra-small text-uppercase fw-bold">Linked with CNR</span>
                                    <h3 class="fw-bold text-success mb-0 mt-1" id="kpiCnr">0</h3>
                                </div>
                                <div class="bg-success-subtle p-3 rounded-3 text-success">
                                    <i class="bi bi-check-circle-fill fs-3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card border-0 shadow-sm border-start border-4 border-secondary bg-white kpi-card h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted extra-small text-uppercase fw-bold">Disposed / Closed</span>
                                    <h3 class="fw-bold text-secondary mb-0 mt-1" id="kpiDisposed">0</h3>
                                </div>
                                <div class="bg-light p-3 rounded-3 text-secondary border">
                                    <i class="bi bi-archive-fill fs-3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter & Search Controls -->
            <div class="card shadow-sm border-0 mb-4 bg-white rounded-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3 col-lg-2">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-building me-1"></i>HC Bench
                            </label>
                            <select id="filterBench" class="form-select form-select-sm fw-bold" onchange="applyFilters()">
                                <option value="ALL">All Benches</option>
                                <option value="DHARWAD">Dharwad Bench</option>
                                <option value="BENGALURU">Bengaluru Bench</option>
                                <option value="KALABURAGI">Kalaburagi Bench</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-3 col-lg-2">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-funnel me-1"></i>Appeal Type
                            </label>
                            <select id="filterType" class="form-select form-select-sm fw-bold" onchange="applyFilters()">
                                <option value="ALL">All Types</option>
                                <option value="Writ Petition">Writ Petition (WP)</option>
                                <option value="Writ Appeal">Writ Appeal (WA)</option>
                                <option value="Claimant Appeal">Claimant WP</option>
                                <option value="Service WP">Service Challenge</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-3 col-lg-2">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-clock-history me-1"></i>Hearing Status
                            </label>
                            <select id="filterStatus" class="form-select form-select-sm fw-bold" onchange="applyFilters()">
                                <option value="ALL">All Hearings</option>
                                <option value="TODAY">Listed Today</option>
                                <option value="WEEK">Upcoming Next 7 Days</option>
                                <option value="FUTURE">Future Hearings</option>
                                <option value="PENDING">Date Pending Sync</option>
                                <option value="DISPOSED">Disposed Cases</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-3 col-lg-4">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-search me-1"></i>Search Anything
                            </label>
                            <input type="text" id="filterSearch" class="form-control form-control-sm" 
                                   placeholder="Filter by Case No, CNR, Petitioner, Advocate..." oninput="applyFilters()" />
                        </div>

                        <div class="col-12 col-md-12 col-lg-2 d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm flex-fill fw-bold" onclick="resetFilters()">
                                <i class="bi bi-x-lg me-1"></i>Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tracked Cases Table -->
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-list-check text-primary me-2"></i>High Court Appeals &amp; Real-Time Hearing Status
                        </h6>
                        <small class="text-muted" id="tableSubheading">Showing all connected matters</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-muted border px-3 py-1 font-monospace" id="lblSyncProgress" style="display:none;"></span>
                        <button type="button" class="btn btn-sm btn-primary fw-bold shadow-sm" id="btnSyncAll" onclick="syncAllVisibleCnrs()">
                            <i class="bi bi-arrow-repeat me-1"></i>Sync All Visible CNRs
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="min-height: 380px;">
                        <table class="table table-hover align-middle mb-0 small" id="trackedCasesTable">
                            <thead class="bg-light text-secondary text-uppercase position-sticky top-0 shadow-sm" style="z-index: 1;">
                                <tr>
                                    <th class="py-3 ps-3" style="width: 40px;">#</th>
                                    <th class="py-3" style="min-width: 170px;">Labour Case Ref</th>
                                    <th class="py-3" style="min-width: 180px;">Connected HC Case</th>
                                    <th class="py-3" style="min-width: 190px;">16-Digit CNR Number</th>
                                    <th class="py-3" style="min-width: 170px;">Next Hearing Date</th>
                                    <th class="py-3" style="min-width: 180px;">Live Stage / Purpose</th>
                                    <th class="py-3" style="min-width: 160px;">Court Hall / Judge</th>
                                    <th class="py-3 text-center pe-3" style="min-width: 150px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="trackedCasesTbody">
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div> 
                                        Loading connected High Court cases from database...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DAILY COURT HALL CAUSE LIST -->
        <div class="tab-pane fade" id="daily-causelist" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bank me-2 text-danger"></i>e-Courts Daily High Court Cause List</h6>
                            <small class="text-muted">Pull official court hall cause lists from the e-Courts Gateway for Karnataka High Court</small>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <label class="fw-bold small text-muted me-1">High Court:</label>
                            <select id="liveEstCode" class="form-select form-select-sm bg-light" style="width: 160px;" onchange="loadHcCourtBenches()">
                                <option value="KAHC02" selected>Dharwad Bench</option>
                                <option value="KAHC01">Bengaluru Bench</option>
                                <option value="KAHC03">Kalaburagi Bench</option>
                            </select>
                            
                            <label class="fw-bold small text-muted ms-2 me-1">Date:</label>
                            <input type="date" id="liveDate" class="form-control form-control-sm bg-light" style="width: 140px;" 
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="loadHcCourtBenches()">
                            
                            <label class="fw-bold small text-muted ms-2 me-1">Bench:</label>
                            <select id="liveBenchId" class="form-select form-select-sm bg-light" style="width: 250px;">
                                <option value="ALL">All Court Halls / Benches</option>
                            </select>
                            
                            <button class="btn btn-danger btn-sm px-3 shadow-sm ms-2" onclick="fetchLiveCauselistDetails()">
                                <i class="bi bi-cloud-arrow-down-fill me-1"></i> Fetch Cause List
                            </button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="chkOnlyCorp" checked onchange="filterLiveCauselistRows()">
                            <label class="form-check-label fw-bold text-dark small" for="chkOnlyCorp">
                                <i class="bi bi-star-fill text-warning me-1"></i>Show Only Corporation Cases (NWKRTC / KSRTC)
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="liveCauselistContainer">
                        <div class="text-center py-5 text-muted" style="min-height: 380px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                            <i class="bi bi-calendar-event text-danger mb-3" style="font-size: 3rem; opacity: 0.4;"></i>
                            <h5 class="fw-bold text-dark">Select a High Court Bench and click "Fetch Cause List"</h5>
                            <p class="small mb-0 mt-1">Retrieves real-time court hall listings with Sr No, Bench, Judge, Advocate and Case Type.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- COMPREHENSIVE CASE & HEARING DETAILS MODAL -->
<div class="modal fade" id="hcCaseDetailsModal" tabindex="-1" aria-labelledby="hcCaseDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-broadcast fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalCaseRef">High Court Case Details</h5>
                        <small class="text-white-50" id="modalSubTitle">Live details synchronized via e-Courts NAPIX</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <!-- Summary Card -->
                <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <span class="text-muted extra-small text-uppercase fw-bold d-block">Originating Labour Case</span>
                                <div class="fw-bold text-dark mt-1" id="modalOriginatingRef">-</div>
                                <small class="text-muted" id="modalDivisionRef">-</small>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted extra-small text-uppercase fw-bold d-block">16-Digit CNR Number</span>
                                <div class="fw-bold text-primary font-monospace fs-6 mt-1" id="modalCnrRef">-</div>
                                <small class="text-muted" id="modalEstRef">-</small>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted extra-small text-uppercase fw-bold d-block">Live Next Hearing Date</span>
                                <div class="mt-1" id="modalNextHearingRef">-</div>
                                <small class="text-muted" id="modalStageRef">-</small>
                            </div>
                            <div class="col-md-6 border-top pt-2">
                                <span class="text-muted extra-small text-uppercase fw-bold d-block">Petitioner / Workman</span>
                                <div class="fw-bold text-dark" id="modalPetitionerRef">-</div>
                                <small class="text-muted" id="modalPetAdvRef">-</small>
                            </div>
                            <div class="col-md-6 border-top pt-2">
                                <span class="text-muted extra-small text-uppercase fw-bold d-block">Respondent / Management</span>
                                <div class="fw-bold text-dark" id="modalRespondentRef">-</div>
                                <small class="text-muted" id="modalResAdvRef">-</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hearing History Section -->
                <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
                    <div class="card-header bg-white py-2.5 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-primary mb-0 small text-uppercase">
                            <i class="bi bi-clock-history me-1"></i>Complete Hearing History (<span id="modalHistoryCount">0</span> Listings)
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 260px;">
                            <table class="table table-sm table-hover align-middle mb-0 extra-small">
                                <thead class="bg-light text-secondary">
                                    <tr>
                                        <th class="ps-3 py-2">#</th>
                                        <th class="py-2">Hearing Date</th>
                                        <th class="py-2">Business Date</th>
                                        <th class="py-2">Stage / Purpose of Listing</th>
                                        <th class="py-2">Judge / Court Hall</th>
                                    </tr>
                                </thead>
                                <tbody id="modalHistoryTbody">
                                    <tr><td colspan="5" class="text-center py-3 text-muted">No hearing history available.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Orders & Judgments Section -->
                <div class="card border-0 shadow-sm rounded-3 bg-white" id="modalOrdersSection">
                    <div class="card-header bg-white py-2.5 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-danger mb-0 small text-uppercase">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>Interim Orders &amp; Judgments (<span id="modalOrdersCount">0</span>)
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div id="modalOrdersList" class="d-flex flex-column gap-2">
                            <span class="text-muted small italic">No downloadable orders found on e-Courts Gateway.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white px-4 py-3 border-top d-flex justify-content-between">
                <div id="modalFooterNav">
                    <!-- Dynamic navigation link -->
                </div>
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Data stores
        let rawTrackedData = [];
        let flattenedCases = [];
        let trackedInitialized = false;
        let activeModalData = null;

        // Shared array extractor
        function extractArrayFromData(data) {
            if (!data) return [];
            if (Array.isArray(data)) return data;
            if (typeof data === 'object' && data !== null) {
                const objectKeys = Object.keys(data);
                if (objectKeys.length > 0 && objectKeys.every(k => typeof data[k] === 'object' && data[k] !== null && !Array.isArray(data[k]))) {
                    return Object.values(data);
                }
                const keys = ['causelist', 'causelistdetails', 'cause_list', 'cases', 'items', 'benches', 'court_halls', 'data', 'results'];
                for (let k of keys) {
                    if (Array.isArray(data[k])) return data[k];
                }
                for (let k in data) {
                    if (Array.isArray(data[k]) && data[k].length > 0) return data[k];
                    if (typeof data[k] === 'object' && data[k] !== null) {
                        let inner = extractArrayFromData(data[k]);
                        if (inner.length > 0) return inner;
                    }
                }
            }
            return [];
        }

        // ==========================================
        // INITIALIZATION & TAB SWITCHING
        // ==========================================
        $(document).ready(function () {
            initTrackedCases();
        });

        // ==========================================
        // TAB 1: CONNECTED HIGH COURT CASES
        // ==========================================
        async function initTrackedCases(forceRefresh = false) {
            if (trackedInitialized && !forceRefresh) return;
            trackedInitialized = true;

            const tbody = document.getElementById('trackedCasesTbody');
            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-5 text-muted"><div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div> Loading connected cases from database...</td></tr>';

            try {
                const res = await fetch('/Labour/GetTrackedHighCourtCases');
                const json = await res.json();

                if (json && json.success && json.data) {
                    rawTrackedData = json.data;
                    flattenedCases = [];

                    rawTrackedData.forEach(c => {
                        // 1. Writ Petition (CO_WP)
                        if (c.wpCnr || c.wpCaseNo) {
                            flattenedCases.push({
                                caseId: c.caseId,
                                primaryNo: c.caseNumber,
                                primaryYear: c.caseYear,
                                division: c.divisionName,
                                appealType: 'Writ Petition',
                                appealCaseNo: c.wpCaseNo ? `WP ${c.wpCaseNo}${c.wpYear ? '/' + c.wpYear : ''}` : 'WP (Number Awaiting)',
                                bench: c.wpBench || 'High Court',
                                cnr: c.wpCnr || '',
                                petitioner: c.petitioner,
                                respondent: c.respondent,
                                advocate: c.wpAdvocate || c.advocate,
                                nextHearingDate: c.dbHearingDate || null,
                                nextHearingDisplay: c.dbHearingDateDisplay || null,
                                stage: c.dbStage || 'Pending Sync',
                                courtHall: c.courtName || 'High Court',
                                isSynced: false,
                                syncResult: null
                            });
                        }

                        // 2. Writ Appeal (CO_WA)
                        if (c.waCnr || c.waCaseNo) {
                            flattenedCases.push({
                                caseId: c.caseId,
                                primaryNo: c.caseNumber,
                                primaryYear: c.caseYear,
                                division: c.divisionName,
                                appealType: 'Writ Appeal',
                                appealCaseNo: c.waCaseNo ? `WA ${c.waCaseNo}${c.waYear ? '/' + c.waYear : ''}` : 'WA (Number Awaiting)',
                                bench: c.waBench || 'High Court',
                                cnr: c.waCnr || '',
                                petitioner: c.petitioner,
                                respondent: c.respondent,
                                advocate: c.waAdvocate || c.advocate,
                                nextHearingDate: c.dbHearingDate || null,
                                nextHearingDisplay: c.dbHearingDateDisplay || null,
                                stage: c.dbStage || 'Pending Sync',
                                courtHall: c.courtName || 'High Court',
                                isSynced: false,
                                syncResult: null
                            });
                        }

                        // 3. Claimant Writ Petition
                        if (c.claimantCnr || c.claimantCaseNo) {
                            flattenedCases.push({
                                caseId: c.caseId,
                                primaryNo: c.caseNumber,
                                primaryYear: c.caseYear,
                                division: c.divisionName,
                                appealType: 'Claimant Appeal',
                                appealCaseNo: c.claimantCaseNo ? `WP ${c.claimantCaseNo}${c.claimantYear ? '/' + c.claimantYear : ''}` : 'Claimant WP',
                                bench: 'High Court',
                                cnr: c.claimantCnr || '',
                                petitioner: c.petitioner,
                                respondent: c.respondent,
                                advocate: c.advocate,
                                nextHearingDate: c.dbHearingDate || null,
                                nextHearingDisplay: c.dbHearingDateDisplay || null,
                                stage: c.dbStage || 'Pending Sync',
                                courtHall: c.courtName || 'High Court',
                                isSynced: false,
                                syncResult: null
                            });
                        }

                        // 4. Service Matter WP
                        if (c.serviceWpNo) {
                            flattenedCases.push({
                                caseId: c.caseId,
                                primaryNo: c.caseNumber,
                                primaryYear: c.caseYear,
                                division: c.divisionName,
                                appealType: 'Service WP',
                                appealCaseNo: `Service WP ${c.serviceWpNo}${c.serviceWpYear ? '/' + c.serviceWpYear : ''}`,
                                bench: 'High Court',
                                cnr: '',
                                petitioner: c.petitioner,
                                respondent: c.respondent,
                                advocate: c.advocate,
                                nextHearingDate: c.dbHearingDate || null,
                                nextHearingDisplay: c.dbHearingDateDisplay || null,
                                stage: c.dbStage || 'Pending',
                                courtHall: c.courtName || 'High Court',
                                isSynced: false,
                                syncResult: null
                            });
                        }

                        // 5. Main CNR if High Court
                        if (c.mainCnr && !c.wpCnr && !c.waCnr && !c.claimantCnr) {
                            flattenedCases.push({
                                caseId: c.caseId,
                                primaryNo: c.caseNumber,
                                primaryYear: c.caseYear,
                                division: c.divisionName,
                                appealType: 'High Court Case',
                                appealCaseNo: `${c.caseNumber}/${c.caseYear}`,
                                bench: 'High Court',
                                cnr: c.mainCnr,
                                petitioner: c.petitioner,
                                respondent: c.respondent,
                                advocate: c.advocate,
                                nextHearingDate: c.dbHearingDate || null,
                                nextHearingDisplay: c.dbHearingDateDisplay || null,
                                stage: c.dbStage || 'Pending Sync',
                                courtHall: c.courtName || 'High Court',
                                isSynced: false,
                                syncResult: null
                            });
                        }
                    });

                    document.getElementById('badgeTotalCases').textContent = flattenedCases.length;
                    applyFilters();

                    // Automatically start syncing CNRs in background
                    syncAllVisibleCnrs();
                } else {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Failed to load cases from database.</td></tr>';
                }
            } catch (err) {
                console.error("Error initializing tracked cases", err);
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Server communication error.</td></tr>';
            }
        }

        // ==========================================
        // FILTERING & TABLE RENDERING
        // ==========================================
        function applyFilters() {
            const benchFilter = (document.getElementById('filterBench')?.value || 'ALL').toUpperCase();
            const typeFilter = (document.getElementById('filterType')?.value || 'ALL').toUpperCase();
            const statusFilter = (document.getElementById('filterStatus')?.value || 'ALL').toUpperCase();
            const searchFilter = (document.getElementById('filterSearch')?.value || '').trim().toUpperCase();

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const filtered = flattenedCases.filter(c => {
                // Bench
                if (benchFilter !== 'ALL') {
                    if (!c.bench.toUpperCase().includes(benchFilter)) return false;
                }

                // Type
                if (typeFilter !== 'ALL') {
                    if (!c.appealType.toUpperCase().includes(typeFilter)) return false;
                }

                // Hearing Status
                if (statusFilter !== 'ALL') {
                    const isDisposed = (c.stage || '').toUpperCase().includes('DISPOSE') || (c.nextHearingDate === 'Disposed');
                    if (statusFilter === 'DISPOSED' && !isDisposed) return false;
                    if (statusFilter !== 'DISPOSED' && isDisposed) return false;

                    let d = null;
                    if (c.nextHearingDate && c.nextHearingDate.length >= 10 && !isDisposed) {
                        d = new Date(c.nextHearingDate);
                        d.setHours(0, 0, 0, 0);
                    }

                    if (statusFilter === 'PENDING' && (d || isDisposed)) return false;
                    if (statusFilter === 'TODAY') {
                        if (!d || d.getTime() !== today.getTime()) return false;
                    }
                    if (statusFilter === 'WEEK') {
                        if (!d) return false;
                        const diff = Math.round((d - today) / (1000 * 60 * 60 * 24));
                        if (diff < 0 || diff > 7) return false;
                    }
                    if (statusFilter === 'FUTURE') {
                        if (!d || d <= today) return false;
                    }
                }

                // Search
                if (searchFilter) {
                    const combined = `${c.caseId} ${c.primaryNo} ${c.primaryYear} ${c.division} ${c.appealType} ${c.appealCaseNo} ${c.cnr} ${c.petitioner} ${c.advocate} ${c.stage} ${c.bench}`.toUpperCase();
                    if (!combined.includes(searchFilter)) return false;
                }

                return true;
            });

            renderTable(filtered);
            recalculateKpis();
        }

        function resetFilters() {
            document.getElementById('filterBench').value = 'ALL';
            document.getElementById('filterType').value = 'ALL';
            document.getElementById('filterStatus').value = 'ALL';
            document.getElementById('filterSearch').value = '';
            applyFilters();
        }

        function renderTable(items) {
            const tbody = document.getElementById('trackedCasesTbody');
            document.getElementById('tableSubheading').textContent = `Displaying ${items.length} of ${flattenedCases.length} appeal records`;

            if (items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-info-circle fs-3 d-block mb-2 text-secondary"></i>No High Court connected appeals match the current filters.</td></tr>';
                return;
            }

            let html = '';
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            items.forEach((c, idx) => {
                const uniqueKey = `${c.caseId}_${c.appealType.replace(/\s+/g, '_')}`;
                
                // Determine Date Badge & Highlight
                let dateBadgeHtml = '<span class="text-muted fst-italic"><i class="bi bi-clock me-1"></i>Date Pending</span>';
                let rowHighlightClass = '';
                const isDisposed = (c.stage || '').toUpperCase().includes('DISPOSE') || c.nextHearingDate === 'Disposed';

                if (isDisposed) {
                    dateBadgeHtml = '<span class="badge bg-secondary px-2 py-1"><i class="bi bi-check2-all me-1"></i>Disposed</span>';
                } else if (c.nextHearingDate && c.nextHearingDate.length >= 10) {
                    const hDate = new Date(c.nextHearingDate);
                    hDate.setHours(0, 0, 0, 0);
                    const diffDays = Math.round((hDate - today) / (1000 * 60 * 60 * 24));
                    const displayDate = c.nextHearingDisplay || c.nextHearingDate;

                    if (diffDays === 0) {
                        dateBadgeHtml = `<span class="badge bg-danger text-white animate-pulse px-2.5 py-1.5 shadow-sm fw-bold"><i class="bi bi-bell-fill me-1"></i>TODAY: ${displayDate}</span>`;
                        rowHighlightClass = 'table-danger';
                    } else if (diffDays > 0 && diffDays <= 7) {
                        dateBadgeHtml = `<span class="badge bg-warning text-dark px-2.5 py-1.5 fw-bold shadow-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i>In ${diffDays}d (${displayDate})</span>`;
                    } else if (diffDays > 7) {
                        dateBadgeHtml = `<span class="fw-bold text-primary"><i class="bi bi-calendar-event me-1"></i>${displayDate}</span>`;
                    } else {
                        dateBadgeHtml = `<span class="text-muted"><i class="bi bi-calendar-x me-1"></i>${displayDate}</span>`;
                    }
                }

                // Stage Badge
                let stageBadgeClass = 'bg-light text-secondary border';
                if (c.stage && c.stage !== 'Pending Sync') {
                    if (isDisposed) stageBadgeClass = 'bg-secondary-subtle text-secondary border';
                    else if (c.stage.includes('HEARING') || c.stage.includes('ARGUMENT')) stageBadgeClass = 'bg-primary-subtle text-primary border border-primary-subtle';
                    else if (c.stage.includes('ORDER') || c.stage.includes('JUDGMENT')) stageBadgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
                    else stageBadgeClass = 'bg-info-subtle text-info-emphasis border border-info-subtle';
                }

                html += `
                <tr class="${rowHighlightClass}" id="row_${uniqueKey}">
                    <td class="ps-3 fw-bold text-muted">${idx + 1}</td>
                    <td>
                        <a href="/Labour/Details/${c.caseId}" class="fw-bold text-decoration-none text-dark d-block">
                            <i class="bi bi-folder2-open text-primary me-1"></i>Case #${c.caseId}
                        </a>
                        <small class="text-secondary fw-semibold">${c.primaryNo ? c.primaryNo + '/' + c.primaryYear : 'Ref # ' + c.caseId}</small>
                        <small class="text-muted d-block extra-small">${c.division || 'Central Office'}</small>
                    </td>
                    <td>
                        <div class="fw-bold text-primary">${c.appealCaseNo}</div>
                        <span class="badge bg-light text-dark border extra-small mt-1">
                            <i class="bi bi-bank me-1 text-secondary"></i>${c.bench || 'High Court'}
                        </span>
                    </td>
                    <td>
                        ${c.cnr ? `
                            <span class="badge bg-primary text-white font-monospace px-2 py-1 shadow-sm d-inline-block">
                                <i class="bi bi-broadcast me-1"></i>${c.cnr}
                            </span>
                            <button class="btn btn-link btn-sm text-secondary p-0 ms-1" onclick="navigator.clipboard.writeText('${c.cnr}'); alert('CNR copied: ${c.cnr}');" title="Copy CNR">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        ` : `
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                <i class="bi bi-exclamation-circle me-1"></i>CNR Missing
                            </span>
                            <a href="/Labour/Details/${c.caseId}" class="btn btn-xs btn-outline-primary rounded-pill ms-1 py-0 px-2">Link</a>
                        `}
                    </td>
                    <td id="td_date_${uniqueKey}">
                        ${dateBadgeHtml}
                    </td>
                    <td id="td_stage_${uniqueKey}">
                        <span class="badge ${stageBadgeClass} text-truncate d-inline-block" style="max-width: 170px;" title="${c.stage}">
                            ${c.stage || 'Pending Sync'}
                        </span>
                    </td>
                    <td id="td_court_${uniqueKey}">
                        <span class="text-muted extra-small d-block text-truncate" style="max-width: 150px;" title="${c.courtHall}">
                            <i class="bi bi-person-badge me-1"></i>${c.courtHall || 'High Court'}
                        </span>
                    </td>
                    <td class="text-center pe-3">
                        <div class="d-flex justify-content-center align-items-center gap-1">
                            ${c.cnr ? `
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 fw-bold shadow-sm" 
                                        id="btn_sync_${uniqueKey}" onclick="syncSingleCase('${uniqueKey}')" title="Sync live hearing date via NAPIX">
                                    <i class="bi bi-arrow-repeat"></i> Sync
                                </button>
                            ` : ''}
                            <button class="btn btn-sm btn-light border rounded-pill px-2 py-1" onclick="openDetailsModal('${uniqueKey}')" title="View Full Hearing History & Orders">
                                <i class="bi bi-eye-fill text-primary"></i> View
                            </button>
                        </div>
                    </td>
                </tr>`;
            });

            tbody.innerHTML = html;
        }

        // ==========================================
        // SMART NAPIX SYNC & PERSISTENCE
        // ==========================================
        async function syncSingleCase(uniqueKey) {
            const item = flattenedCases.find(x => `${x.caseId}_${x.appealType.replace(/\s+/g, '_')}` === uniqueKey);
            if (!item || !item.cnr) return;

            const btn = document.getElementById(`btn_sync_${uniqueKey}`);
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
            }

            const tdDate = document.getElementById(`td_date_${uniqueKey}`);
            const tdStage = document.getElementById(`td_stage_${uniqueKey}`);
            const tdCourt = document.getElementById(`td_court_${uniqueKey}`);

            if (tdDate) tdDate.innerHTML = '<span class="spinner-border spinner-border-sm text-primary"></span>';
            if (tdStage) tdStage.innerHTML = '<span class="text-muted extra-small">Fetching NAPIX...</span>';

            try {
                const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(item.cnr)}&isHighCourt=true&module=Labour`);
                const json = await res.json();

                if (json && json.success) {
                    item.isSynced = true;
                    item.syncResult = json;

                    const d = json.data || {};
                    const hist = json.history || [];

                    // --- Smart Extraction of Next Hearing Date ---
                    let extractedDate = d.next_hearing_date || d.next_date || d.date_of_hearing || '';
                    let extractedStage = d.stage || d.purpose_name || d.purpose || '';
                    let extractedJudge = d.judge || d.court_no_judge || d.desgname || '';

                    // If summary next date is empty or "Next Date Not Given", extract from history
                    if ((!extractedDate || extractedDate === 'Next Date Not Given' || extractedDate.trim() === '') && hist.length > 0) {
                        for (let h of hist) {
                            const cand = h.hearing_date || h.business_date || h.date || '';
                            if (cand && cand !== 'Next Date Not Given' && cand.length >= 8) {
                                extractedDate = cand;
                                if (!extractedStage) extractedStage = h.purpose_of_listing || h.purpose || h.stage || '';
                                if (!extractedJudge) extractedJudge = h.judge_name || h.court || '';
                                break;
                            }
                        }
                    }

                    // Check if Disposed
                    const isDisposed = (d.case_status === 'Disposed' || d.pend_disp === 'D' || (d.decision_date && d.decision_date.length >= 8));
                    if (isDisposed) {
                        extractedDate = d.decision_date ? `Disposed on ${d.decision_date}` : 'Disposed';
                        extractedStage = d.nature_of_disposal || d.disp_name || 'Disposed';
                    }

                    // Update local state
                    item.nextHearingDate = extractedDate;
                    item.nextHearingDisplay = extractedDate;
                    item.stage = extractedStage || 'Hearing Active';
                    item.courtHall = extractedJudge || item.bench;

                    // Update UI directly
                    let dateHtml = `<span class="fw-bold text-success">${extractedDate}</span>`;
                    const todayStr = new Date().toISOString().slice(0, 10);
                    if (extractedDate.includes(todayStr)) {
                        dateHtml = `<span class="badge bg-danger text-white animate-pulse px-2 py-1"><i class="bi bi-bell-fill me-1"></i>TODAY: ${extractedDate}</span>`;
                    } else if (isDisposed) {
                        dateHtml = `<span class="badge bg-secondary px-2 py-1"><i class="bi bi-check2-all me-1"></i>${extractedDate}</span>`;
                    }
                    if (tdDate) tdDate.innerHTML = dateHtml;
                    if (tdStage) tdStage.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle text-truncate" style="max-width: 170px;">${item.stage}</span>`;
                    if (tdCourt) tdCourt.innerHTML = `<span class="text-muted extra-small"><i class="bi bi-person-badge me-1"></i>${item.courtHall}</span>`;

                    // --- PERSIST TO DATABASE VIA API ---
                    try {
                        const postData = new FormData();
                        postData.append('caseId', item.caseId);
                        postData.append('cnrNumber', item.cnr);
                        postData.append('hearingDate', isDisposed ? '' : extractedDate);
                        postData.append('stage', item.stage);
                        postData.append('courtHall', item.courtHall);

                        fetch('/Labour/SaveLiveHearingDate', {
                            method: 'POST',
                            body: postData
                        });
                    } catch (saveErr) {
                        console.warn("Could not persist hearing date to database", saveErr);
                    }

                    recalculateKpis();
                } else {
                    if (tdDate) tdDate.innerHTML = '<span class="text-warning extra-small"><i class="bi bi-info-circle me-1"></i>No Listing Found</span>';
                    if (tdStage) tdStage.innerHTML = '<span class="badge bg-light text-muted border">CNR Valid</span>';
                }
            } catch (err) {
                console.error("Sync error for CNR", item.cnr, err);
                if (tdDate) tdDate.innerHTML = '<span class="text-danger extra-small"><i class="bi bi-exclamation-triangle me-1"></i>Sync Failed</span>';
                if (tdStage) tdStage.innerHTML = '<span class="badge bg-danger-subtle text-danger">Error</span>';
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> Synced';
                    setTimeout(() => { btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sync'; }, 3000);
                }
            }
        }

        async function syncAllVisibleCnrs() {
            const btn = document.getElementById('btnSyncAll');
            const lbl = document.getElementById('lblSyncProgress');
            const cnrCases = flattenedCases.filter(c => c.cnr && c.cnr.trim() !== '');

            if (cnrCases.length === 0) return;

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing CNRs...';
            }
            if (lbl) {
                lbl.style.display = '';
                lbl.textContent = `Syncing 0 of ${cnrCases.length}...`;
            }

            for (let i = 0; i < cnrCases.length; i++) {
                const c = cnrCases[i];
                const key = `${c.caseId}_${c.appealType.replace(/\s+/g, '_')}`;
                if (lbl) lbl.textContent = `Syncing ${i + 1} of ${cnrCases.length} (${c.cnr})...`;
                await syncSingleCase(key);
                await new Promise(r => setTimeout(r, 400));
            }

            if (lbl) lbl.textContent = `All ${cnrCases.length} High Court cases synchronized!`;
            if (btn) btn.innerHTML = '<i class="bi bi-check-all me-1"></i> All Synced';
            setTimeout(() => {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Sync All Visible CNRs';
                }
                if (lbl) lbl.style.display = 'none';
            }, 4000);
        }

        function recalculateKpis() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let total = flattenedCases.length;
            let listedToday = 0;
            let listedWeek = 0;
            let cnrCount = 0;
            let disposed = 0;

            flattenedCases.forEach(c => {
                if (c.cnr && c.cnr.trim() !== '') cnrCount++;

                const isDisposed = (c.stage || '').toUpperCase().includes('DISPOSE') || c.nextHearingDate === 'Disposed';
                if (isDisposed) {
                    disposed++;
                } else if (c.nextHearingDate && c.nextHearingDate.length >= 10) {
                    const h = new Date(c.nextHearingDate);
                    h.setHours(0, 0, 0, 0);
                    const diff = Math.round((h - today) / (1000 * 60 * 60 * 24));
                    if (diff === 0) listedToday++;
                    else if (diff > 0 && diff <= 7) listedWeek++;
                }
            });

            document.getElementById('kpiTotal').textContent = total;
            document.getElementById('kpiToday').textContent = listedToday;
            document.getElementById('kpiWeek').textContent = listedWeek;
            document.getElementById('kpiCnr').textContent = cnrCount;
            document.getElementById('kpiDisposed').textContent = disposed;
        }

        // ==========================================
        // COMPREHENSIVE DETAILS MODAL
        // ==========================================
        async function openDetailsModal(uniqueKey) {
            const item = flattenedCases.find(x => `${x.caseId}_${x.appealType.replace(/\s+/g, '_')}` === uniqueKey);
            if (!item) return;

            document.getElementById('modalCaseRef').textContent = `${item.appealType}: ${item.appealCaseNo}`;
            document.getElementById('modalSubTitle').textContent = `High Court Bench: ${item.bench} | Originating Labour Case #${item.caseId}`;
            document.getElementById('modalOriginatingRef').textContent = `Labour Case #${item.caseId} (${item.primaryNo || 'Ref'}/${item.primaryYear || '-'})`;
            document.getElementById('modalDivisionRef').textContent = `Division: ${item.division || 'Central Office'}`;
            document.getElementById('modalCnrRef').textContent = item.cnr ? item.cnr : 'Not Linked';
            document.getElementById('modalEstRef').textContent = item.bench;
            document.getElementById('modalNextHearingRef').innerHTML = `<span class="fw-bold text-primary fs-6">${item.nextHearingDisplay || item.nextHearingDate || 'Date Pending'}</span>`;
            document.getElementById('modalStageRef').textContent = `Stage: ${item.stage || 'N/A'}`;
            document.getElementById('modalPetitionerRef').textContent = item.petitioner || 'Workman / Corporation';
            document.getElementById('modalPetAdvRef').textContent = `Advocate: ${item.advocate || 'Not Assigned'}`;
            document.getElementById('modalRespondentRef').textContent = item.respondent || 'NWKRTC';
            document.getElementById('modalResAdvRef').textContent = `Advocate: ${item.advocate || 'Corporation Panel'}`;

            document.getElementById('modalFooterNav').innerHTML = `
                <a href="/Labour/Details/${item.caseId}" class="btn btn-outline-primary rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Open Labour Case #${item.caseId}
                </a>
            `;

            // Hearing history & orders
            const histTbody = document.getElementById('modalHistoryTbody');
            const ordersList = document.getElementById('modalOrdersList');
            const histCount = document.getElementById('modalHistoryCount');
            const ordCount = document.getElementById('modalOrdersCount');

            histTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm text-primary me-1"></div> Checking e-Courts live listings...</td></tr>';
            ordersList.innerHTML = '<span class="text-muted small italic">Fetching orders...</span>';

            const modal = new bootstrap.Modal(document.getElementById('hcCaseDetailsModal'));
            modal.show();

            // If CNR exists, query NAPIX for full history & orders
            if (item.cnr) {
                try {
                    const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(item.cnr)}&isHighCourt=true&module=Labour`);
                    const json = await res.json();

                    if (json && json.success) {
                        const d = json.data || {};
                        if (d.petitioner) document.getElementById('modalPetitionerRef').textContent = d.petitioner;
                        if (d.petitioner_advocate) document.getElementById('modalPetAdvRef').textContent = `Adv: ${d.petitioner_advocate}`;
                        if (d.respondent) document.getElementById('modalRespondentRef').textContent = d.respondent;
                        if (d.establishment_name) document.getElementById('modalEstRef').textContent = d.establishment_name;

                        // Render History
                        const history = json.history || [];
                        histCount.textContent = history.length;
                        if (history.length > 0) {
                            let hHtml = '';
                            history.forEach((h, idx) => {
                                const hDate = h.hearing_date || h.business_date || h.date || '—';
                                const bDate = h.business_date || h.business_on_date || '—';
                                const purpose = h.purpose_of_listing || h.purpose || h.stage || 'Hearing';
                                const judge = h.judge_name || h.judge || h.court || '—';
                                hHtml += `
                                    <tr>
                                        <td class="ps-3 fw-bold text-muted">${idx + 1}</td>
                                        <td class="fw-bold text-primary">${hDate}</td>
                                        <td class="text-secondary">${bDate}</td>
                                        <td><span class="badge bg-light text-dark border">${purpose}</span></td>
                                        <td class="small text-muted">${judge}</td>
                                    </tr>`;
                            });
                            histTbody.innerHTML = hHtml;
                        } else {
                            histTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">No hearing history entries recorded on e-Courts yet.</td></tr>';
                        }

                        // Render Orders
                        const orders = json.orders || [];
                        ordCount.textContent = orders.length;
                        if (orders.length > 0) {
                            let oHtml = '';
                            orders.forEach((ord, i) => {
                                const oDt = ord.order_date || ord.date || '—';
                                const oNo = ord.order_number || ord.order_no || `Order #${i + 1}`;
                                const oDetails = ord.order_details || ord.order_type || 'Court Order';
                                const pdf = ord.pdf_url || ord.pdf_path || ord.url || '#';
                                oHtml += `
                                    <div class="p-2 bg-light border rounded-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong class="text-dark"><i class="bi bi-file-earmark-pdf text-danger me-1"></i>${oNo}: ${oDetails}</strong>
                                            <small class="text-muted ms-2">Date: ${oDt}</small>
                                        </div>
                                        <div>
                                            ${pdf && pdf !== '#' ? `
                                                <a href="${pdf}" target="_blank" class="btn btn-sm btn-outline-danger px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-download me-1"></i> Download PDF
                                                </a>
                                            ` : '<span class="badge bg-light text-muted border">Certified Copy</span>'}
                                        </div>
                                    </div>`;
                            });
                            ordersList.innerHTML = oHtml;
                        } else {
                            ordersList.innerHTML = '<span class="text-muted small italic">No downloadable orders found for this case.</span>';
                        }
                    } else {
                        histTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-warning">Could not retrieve live hearing history from eCourts Gateway.</td></tr>';
                        ordersList.innerHTML = '<span class="text-muted small italic">No orders available.</span>';
                    }
                } catch (e) {
                    histTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-danger">Gateway connection error.</td></tr>';
                }
            } else {
                histTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Link a 16-digit CNR number on the Labour details page to enable hearing history and order retrieval.</td></tr>';
                ordersList.innerHTML = '<span class="text-muted small italic">CNR number not linked.</span>';
                histCount.textContent = '0';
                ordCount.textContent = '0';
            }
        }

        // ==========================================
        // TAB 2: DAILY COURT HALL CAUSE LIST
        // ==========================================
        let dailyInitialized = false;

        function initDailyCauselist() {
            if (!dailyInitialized) {
                dailyInitialized = true;
                loadHcCourtBenches();
            }
        }

        function loadHcCourtBenches() {
            const estCode = document.getElementById('liveEstCode').value;
            const date = document.getElementById('liveDate').value;
            const benchSelect = document.getElementById('liveBenchId');
            benchSelect.innerHTML = '<option value="ALL">Loading Court Halls...</option>';
            
            let urlDate = date.split('-').reverse().join('-');

            fetch(`/ECourts/GetHighCourtCauselistBenches?estCode=${encodeURIComponent(estCode)}&causelistDate=${encodeURIComponent(urlDate)}`)
                .then(r => r.json())
                .then(res => {
                    benchSelect.innerHTML = '<option value="ALL">All Court Halls / Benches</option>';
                    if (res && res.success && res.data) {
                        let items = extractArrayFromData(res.data);
                        if (items.length > 0) {
                            items.forEach((b, idx) => {
                                if (typeof b !== 'object' || b === null) {
                                    const opt = document.createElement('option');
                                    opt.value = String(b);
                                    opt.textContent = String(b);
                                    benchSelect.appendChild(opt);
                                    return;
                                }

                                const keys = Object.keys(b);
                                const lowerKeys = keys.map(k => k.toLowerCase());
                                const findKey = (keywords) => {
                                    for (let i = 0; i < lowerKeys.length; i++) {
                                        for (let kw of keywords) {
                                            if (lowerKeys[i].includes(kw)) return keys[i];
                                        }
                                    }
                                    return null;
                                };

                                const idKey = findKey(['id', 'code', 'no', 'num']);
                                const id = idKey ? b[idKey] : String(idx + 1);
                                const nameKey = findKey(['name', 'court', 'judge', 'hall', 'desc', 'bench']);
                                const name = nameKey ? b[nameKey] : `Court Hall ${id}`;

                                const opt = document.createElement('option');
                                opt.value = id;
                                opt.textContent = String(name).includes(String(id)) ? name : `${name} (Hall #${id})`;
                                benchSelect.appendChild(opt);
                            });
                        }
                    }
                })
                .catch(() => {
                    benchSelect.innerHTML = '<option value="ALL">All Court Halls (Error loading benches)</option>';
                });
        }

        function fetchLiveCauselistDetails() {
            const estCode = document.getElementById('liveEstCode').value;
            const benchId = document.getElementById('liveBenchId').value;
            const date = document.getElementById('liveDate').value;
            const container = document.getElementById('liveCauselistContainer');
            
            let urlDate = date.split('-').reverse().join('-');
            container.innerHTML = '<div class="text-center py-5" style="min-height: 380px; display: flex; flex-direction: column; justify-content: center; align-items: center;"><div class="spinner-border text-danger" role="status"></div><p class="mt-3 text-muted fw-bold">Connecting to e-Courts Live Gateway...</p><p class="small text-muted">Retrieving official daily cause list</p></div>';

            fetch(`/ECourts/GetHighCourtCauselistDetails?estCode=${encodeURIComponent(estCode)}&benchId=${encodeURIComponent(benchId)}&causelistDate=${encodeURIComponent(urlDate)}`)
                .then(r => r.json())
                .then(res => {
                    let items = [];
                    if (res && res.success && res.data) {
                        items = extractArrayFromData(res.data);
                    }

                    if (items.length > 0) {
                        let html = `
                        <div class="table-responsive" style="max-height: 70vh;">
                            <table class="table table-hover align-middle mb-0 small" id="liveHCTable">
                                <thead class="bg-light text-secondary text-uppercase position-sticky top-0 shadow-sm" style="z-index: 1;">
                                    <tr>
                                        <th class="py-3 ps-3">High Court Bench</th>
                                        <th class="py-3">Court Hall / Judge</th>
                                        <th class="py-3">Sr No</th>
                                        <th class="py-3">Case No &amp; Year</th>
                                        <th class="py-3">Petitioner vs Respondent</th>
                                        <th class="py-3">Advocates</th>
                                        <th class="py-3 pe-3">Stage / Purpose</th>
                                    </tr>
                                </thead>
                                <tbody>`;

                        items.forEach((item, idx) => {
                            let sr, caseNo, courtNo, pet, resName, petAdv, resAdv, stage;
                            
                            if (typeof item === 'object' && item !== null) {
                                const keys = Object.keys(item);
                                const lowerKeys = keys.map(k => k.toLowerCase());
                                const findVal = (keywords) => {
                                    for (let i = 0; i < lowerKeys.length; i++) {
                                        for (let kw of keywords) {
                                            if (lowerKeys[i].includes(kw)) return item[keys[i]];
                                        }
                                    }
                                    return null;
                                };

                                sr = findVal(['sr', 'sl', 'item', 'sno']) || (idx + 1);
                                caseNo = findVal(['case_no', 'caseno', 'case_number', 'cino', 'cnr']) || '---';
                                courtNo = findVal(['court', 'judge', 'hall', 'bench']) || (benchId !== "ALL" ? `Court Hall ${benchId}` : 'Court Hall');
                                pet = findVal(['pet_name', 'petitioner', 'party', 'appellant']) || '---';
                                resName = findVal(['res_name', 'respondent', 'defendent', 'opposite']) || '---';
                                petAdv = findVal(['pet_adv', 'petitioner_advocate', 'appellant_adv', 'p_adv']) || '---';
                                resAdv = findVal(['res_adv', 'respondent_advocate', 'r_adv']) || '---';
                                stage = findVal(['purpose', 'stage', 'status', 'remark']) || '---';
                            } else {
                                sr = idx + 1; caseNo = '---'; courtNo = '---'; pet = '---'; resName = '---'; petAdv = '---'; resAdv = '---'; stage = '---';
                            }

                            const isCorpMatch = String(pet).toUpperCase().includes('NWKRTC') || String(pet).toUpperCase().includes('KSRTC') || String(resName).toUpperCase().includes('NWKRTC') || String(resName).toUpperCase().includes('KSRTC');
                            const hcBenchName = estCode === 'KAHC01' ? 'Bengaluru' : (estCode === 'KAHC02' ? 'Dharwad' : 'Kalaburagi');

                            html += `
                            <tr class="live-causelist-row" data-is-corp="${isCorpMatch}" style="${isCorpMatch ? 'background-color: #ecfdf5; border-left: 4px solid #10b981;' : ''}">
                                <td class="ps-3"><span class="badge bg-info-subtle text-info border border-info px-2 py-1">${hcBenchName}</span></td>
                                <td><span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1"><i class="bi bi-bank2 me-1"></i>${courtNo}</span></td>
                                <td class="fw-bold">${sr}</td>
                                <td><strong class="text-primary font-monospace">${caseNo}</strong></td>
                                <td>
                                    <div class="fw-bold text-dark">${pet}</div>
                                    <div class="text-muted small my-1">vs</div>
                                    <div class="fw-bold text-dark">${resName}</div>
                                </td>
                                <td>
                                    <div class="mb-1"><small class="text-muted fw-bold">P:</small> ${petAdv}</div>
                                    <div><small class="text-muted fw-bold">R:</small> ${resAdv}</div>
                                </td>
                                <td class="pe-3"><span class="badge bg-secondary px-2 py-1">${stage}</span></td>
                            </tr>`;
                        });

                        html += `</tbody></table></div>`;
                        container.innerHTML = html;
                        filterLiveCauselistRows();
                    } else {
                        container.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 d-block mb-2"></i><h5>No Cases Listed</h5><p class="small mb-0">No cases found for the selected bench on this date.</p></div>';
                    }
                })
                .catch(() => {
                    container.innerHTML = '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i><h5>Gateway Connection Error</h5><p class="small mb-0">Failed to connect to the e-Courts Gateway API.</p></div>';
                });
        }

        function filterLiveCauselistRows() {
            const onlyCorp = document.getElementById('chkOnlyCorp')?.checked;
            const rows = document.querySelectorAll('.live-causelist-row');
            let visible = 0;

            rows.forEach(r => {
                const isCorp = r.getAttribute('data-is-corp') === 'true';
                if (onlyCorp && !isCorp) {
                    r.style.display = 'none';
                } else {
                    r.style.display = '';
                    visible++;
                }
            });

            const msgId = 'noCorpMatchesMsg';
            let msgEl = document.getElementById(msgId);

            if (visible === 0 && rows.length > 0) {
                if (!msgEl) {
                    msgEl = document.createElement('tr');
                    msgEl.id = msgId;
                    msgEl.innerHTML = '<td colspan="7" class="text-center py-5 text-muted bg-white"><i class="bi bi-info-circle fs-2 d-block mb-2"></i>No Corporation matches (NWKRTC/KSRTC) found in this cause list.<br>Uncheck "Show Only Corporation Cases" to view all court hall listings.</td>';
                    document.querySelector('#liveHCTable tbody')?.appendChild(msgEl);
                } else {
                    msgEl.style.display = '';
                }
            } else if (msgEl) {
                msgEl.style.display = 'none';
            }
        }
    </script>
}
