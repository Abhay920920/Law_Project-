@model MVCCaseManagement.Models.LabourEPViewModel

@{
    ViewData["Title"] = "Execution Petition Details";
    ViewData["HidePageHeader"] = true;
    ViewData["PageHeaderClass"] = "ep-details-header";
    var arisingApp = ViewBag.LinkedArisingApp as MVCCaseManagement.Models.ArisingApplication;
    var primaryCase = ViewBag.LinkedPrimaryCase as MVCCaseManagement.Models.LabourCase;
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 text-navy fw-bold"><i class="bi bi-file-earmark-text me-2"></i> EP Details: @Model.EPNumber / @Model.EPYear</h4>
            <span class="text-muted small">Arising from Application: <strong>@Model.ArisingFromCaseNo / @Model.ArisingFromCaseYear</strong></span>
        </div>
        <div class="d-flex gap-2">
            @if (arisingApp != null)
            {
                <a href="@Url.Action("DetailsArisingApplication", "Labour", new { id = arisingApp.ArisingID })" target="_blank" class="btn btn-info text-white rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Arising Application
                </a>
            }
            else if (primaryCase != null)
            {
                <a href="@Url.Action("Details", "Labour", new { id = primaryCase.CaseID })" target="_blank" class="btn btn-info text-white rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Primary Labour Case
                </a>
            }
            <a href="@Url.Action("Edit", "LabourEP", new { id = Model.EPID })" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Edit EP Record
            </a>
            <a href="@Url.Action("Index", "LabourEP")" class="btn btn-outline-secondary rounded-pill px-4">
                Back to List
            </a>
        </div>
    </div>

    <!-- Top Card 1: Linked Arising Application Information -->
    <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-info">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-info">
                <i class="bi bi-file-earmark-text fs-5 me-2"></i>Linked Arising Application Details
            </h6>
            @if (arisingApp != null)
            {
                <a href="@Url.Action("DetailsArisingApplication", "Labour", new { id = arisingApp.ArisingID })" target="_blank" class="btn btn-sm btn-info text-white rounded-pill px-3 fw-bold">
                    <i class="bi bi-box-arrow-up-right me-1"></i> View Full Application Details
                </a>
            }
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Arising Application No / Year</small>
                    <div class="fw-bold fs-6 text-dark">
                        @(arisingApp != null ? $"{arisingApp.CaseNumber} / {arisingApp.CaseYear}" : $"{Model.ArisingFromCaseNo} / {Model.ArisingFromCaseYear}")
                    </div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Labour Court / Tribunal</small>
                    <div class="fw-bold text-dark">@(arisingApp?.CourtName ?? Model.ArisingFromCourt ?? "Labour Court")</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Petitioner / Workman</small>
                    <div class="fw-bold text-dark">@(arisingApp?.PetitionerName ?? "Workman Claim")</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Disposal Status</small>
                    <div>
                        <span class="badge @(arisingApp?.DisposalResult == "Against" ? "bg-danger" : (arisingApp?.DisposalResult == "Favor" ? "bg-success" : "bg-warning text-dark"))">
                            @(arisingApp?.DisposalResult ?? arisingApp?.CaseStatus ?? Model.OriginalCaseStatus ?? "Pending")
                        </span>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(arisingApp?.FavorRemark) || !string.IsNullOrEmpty(arisingApp?.ClaimDetails))
            {
                <div class="mt-3 p-3 bg-light rounded-3 border small">
                    <strong class="text-dark d-block mb-1"><i class="bi bi-file-text me-1"></i>Arising Application Award / Remarks:</strong>
                    <span class="text-muted">@(arisingApp?.FavorRemark ?? arisingApp?.ClaimDetails)</span>
                </div>
            }
        </div>
    </div>

    <!-- Official e-Courts Live Gateway Linkage & Real-Time Tracking -->
    <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-info bg-primary-subtle bg-opacity-10 d-print-none">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-primary">
                <i class="bi bi-broadcast me-2 fs-5 text-danger animate-pulse"></i>Official e-Courts Live Gateway API Linkage
            </h6>
            @if (!string.IsNullOrEmpty(Model.CNRNumber))
            {
                <span class="badge bg-success text-white rounded-pill px-3 py-1 font-monospace"><i class="bi bi-wifi me-1"></i>CNR Linked (@Model.CNRNumber)</span>
            }
            else
            {
                <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-exclamation-triangle me-1"></i>CNR Unlinked</span>
            }
        </div>
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">16-Digit CNR Number</small>
                    <div class="fw-bold font-monospace text-primary fs-6">
                        @(string.IsNullOrEmpty(Model.CNRNumber) ? "Not Linked" : Model.CNRNumber)
                    </div>
                    @if (!string.IsNullOrEmpty(Model.EstCode))
                    {
                        <small class="text-muted">Est Code: <strong>@Model.EstCode</strong></small>
                    }
                </div>
                <div class="col-md-5">
                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Live e-Courts Status</small>
                    <div id="liveEcourtsInlineStatus" class="fw-bold text-dark">
                        <span class="badge bg-light text-secondary border">Click 'Fetch Live Status' to load e-Courts details</span>
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    <button type="button" class="btn btn-primary shadow-sm fw-bold w-100" id="btnFetchLiveDetails" onclick="fetchLiveECourtsDetails()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Fetch Live Status
                    </button>
                </div>
            </div>

            <!-- Dynamic Live Data Panel -->
            <div id="liveEcourtsContainer" class="mt-3 p-3 bg-white rounded-3 border border-primary-subtle d-none">
                <div class="row g-3 text-dark">
                    <div class="col-md-6 border-end">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Petitioner vs Respondent (e-Courts Live)</small>
                        <div class="fw-bold text-primary" id="lblLivePetitioner">—</div>
                        <div class="small text-muted mb-1">vs</div>
                        <div class="fw-bold text-dark" id="lblLiveRespondent">—</div>
                    </div>
                    <div class="col-md-3 border-end">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Current Stage &amp; Purpose</small>
                        <div class="badge bg-warning text-dark fw-bold px-2 py-1 mb-2 d-inline-block" id="lblLiveStage">Pending</div>
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Court Hall / Bench</small>
                        <div class="fw-bold text-secondary small" id="lblLiveCourtHall">—</div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Next Hearing Date</small>
                        <div class="fw-bold text-danger fs-6 mb-2" id="lblLiveNextDate">Not Scheduled</div>
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">First / Filing Date</small>
                        <div class="fw-bold text-dark small" id="lblLiveFilingDate">—</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Card 2: Linked Primary Labour Case Information -->
    @if (primaryCase != null)
    {
        <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-secondary">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-secondary">
                    <i class="bi bi-bank fs-5 me-2"></i>Linked Primary Labour Case Information
                </h6>
                <a href="@Url.Action("Details", "Labour", new { id = primaryCase.CaseID })" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold">
                    <i class="bi bi-box-arrow-up-right me-1"></i> View Main Labour Case
                </a>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Primary Case No / Year</small>
                        <div class="fw-bold fs-6 text-dark">
                            @primaryCase.CaseNumber / @primaryCase.CaseYear
                        </div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Labour Court</small>
                        <div class="fw-bold text-dark">@(primaryCase.CourtName ?? "Labour Court")</div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Petitioner / Workman</small>
                        <div class="fw-bold text-dark">@(primaryCase.PetitionerName ?? "N/A")</div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Disposal Status</small>
                        <div>
                            <span class="badge @(primaryCase.CaseStatus == "Disposed" ? (primaryCase.DisposalResult == "Against" ? "bg-danger" : "bg-success") : "bg-warning text-dark")">
                                @(primaryCase.DisposalResult ?? primaryCase.CaseStatus ?? "Pending")
                            </span>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(primaryCase.AwardDetails) || !string.IsNullOrEmpty(primaryCase.FavorRemark))
                {
                    <div class="mt-3 p-3 bg-light rounded-3 border small">
                        <strong class="text-dark d-block mb-1"><i class="bi bi-file-text me-1"></i>Primary Award Remarks:</strong>
                        <span class="text-muted">@(primaryCase.AwardDetails ?? primaryCase.FavorRemark)</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Case Identification & Award -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="card-title text-primary fw-bold mb-0">Case Identification</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">Division</label>
                            <div class="fw-bold fs-5">@(Model.DivisionName ?? "Not Available")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">EP Court</label>
                            <div class="fw-bold fs-5 text-primary">@(Model.EPCourt ?? "No Court Specified")</div>
                        </div>
                        <hr class="text-muted opacity-25" />
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">Entrustment Number</label>
                            <div class="fw-bold">@(Model.EP_EntrustmentNo ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">Entrustment Date</label>
                            <div class="fw-bold">@(Model.EP_EntrustmentDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                        <hr class="text-muted opacity-25" />
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">Current Status / Stage of EP</label>
                            <div class="badge bg-primary text-white rounded-pill px-3 py-2">@(Model.EPStatus ?? "Pending / In Progress")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">Status of Arising Application / Case</label>
                            <div class="badge bg-info-subtle text-info rounded-pill px-3 py-2">@(Model.OriginalCaseStatus ?? "Unknown")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Timeline & Hearing -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="card-title text-navy fw-bold mb-0">Hearing & Status</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small d-block mb-2">Next Hearing Date</label>
                        @if (Model.NextHearingDate.HasValue)
                        {
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                    <h4 class="mb-0">@Model.NextHearingDate.Value.Day</h4>
                                </div>
                                <div>
                                    <div class="fw-bold">@Model.NextHearingDate.Value.ToString("MMM yyyy")</div>
                                    <div class="text-muted small">@Model.NextHearingDate.Value.DayOfWeek</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted text-italic">No hearing date scheduled.</span>
                        }
                    </div>
                    <div>
                        <label class="text-muted small d-block mb-1">e-Courts Transcription</label>
                        <div class="bg-light p-3 rounded small text-muted border" style="min-height: 100px;">
                            @(Model.AsPerECourts ?? "No additional details logged.")
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .ep-details-header {
        background: linear-gradient(to right, #f8fafc, #f1f5f9);
        border-bottom: 1px solid #e2e8f0;
    }
@section Scripts {
    <script>
        function fetchLiveECourtsDetails() {
            let cnr = '@(Model.CNRNumber ?? "")';
            if (!cnr || cnr.trim() === '') {
                alert('No 16-digit CNR Number linked with this Execution Petition. Please edit the EP and set a CNR.');
                return;
            }

            const btn = document.getElementById('btnFetchLiveDetails');
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing Live e-Courts...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=false&module=Labour')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || d.claimant || d.workman || 'NWKRTC / Workman';
                        const resName = d.respondent || d.res_name || d.party2 || d.management || 'NWKRTC / Opp Party';
                        const stageName = d.stage || d.current_stage || d.case_stage || d.purpose_name || 'Pending';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';
                        const courtHall = d.court_no_judge || d.court_no || d.judge || '—';
                        const filingDt = d.date_of_filing || d.filing_date || '—';

                        const statusElem = document.getElementById('liveEcourtsInlineStatus');
                        if (statusElem) {
                            statusElem.innerHTML = '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Live Connected & Synced</span>';
                        }

                        const container = document.getElementById('liveEcourtsContainer');
                        if (container) {
                            container.classList.remove('d-none');
                            document.getElementById('lblLivePetitioner').textContent = petName;
                            document.getElementById('lblLiveRespondent').textContent = resName;
                            document.getElementById('lblLiveStage').textContent = stageName;
                            document.getElementById('lblLiveCourtHall').textContent = courtHall;
                            document.getElementById('lblLiveNextDate').textContent = nextDt;
                            document.getElementById('lblLiveFilingDate').textContent = filingDt;
                        }
                    } else {
                        const statusElem = document.getElementById('liveEcourtsInlineStatus');
                        if (statusElem) {
                            statusElem.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-info-circle me-1"></i>CNR Linked - Sync Complete</span>';
                        }
                    }
                })
                .catch(err => {
                    const statusElem = document.getElementById('liveEcourtsInlineStatus');
                    if (statusElem) {
                        statusElem.innerHTML = '<span class="badge bg-info"><i class="bi bi-broadcast me-1"></i>Gateway Responsive</span>';
                    }
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }

        document.addEventListener("DOMContentLoaded", function() {
            if ('@(Model.CNRNumber ?? "")' !== '') {
                fetchLiveECourtsDetails();
            }
        });
    </script>
}


