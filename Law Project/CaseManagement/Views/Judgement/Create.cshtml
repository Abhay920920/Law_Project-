@model MVCCaseManagement.Models.JudgementViewModel

@{
    ViewData["Title"] = "Upload Judgement / Circular";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-cloud-upload me-2"></i>Upload New Record</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-bold"></label>
                            <select asp-for="Category" class="form-select" required>
                                <option value="Judgement">Judgement</option>
                                <option value="Circular">Circular</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter Title or Reference Number" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Court" class="form-label fw-bold">Court / Issuing Authority</label>
                                <input asp-for="Court" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JudgementDate" class="form-label fw-bold">Date</label>
                                <input asp-for="JudgementDate" class="form-control" type="date" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remarks" class="form-label fw-bold"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Add remarks or key points about this judgement..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label asp-for="JudgementFile" class="form-label fw-bold"></label>
                            <input asp-for="JudgementFile" class="form-control" type="file" required />
                            <div class="form-text">Supported formats: PDF, DOC, DOCX. Max Size: 10MB</div>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a href="/Judgement" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">Upload & Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
