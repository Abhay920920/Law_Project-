            color: white;
        }

        /* Action Buttons */
        .btn-action {
            font-size: 0.75rem;
            padding: 0.35rem 0.85rem;
            border-radius: 4px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        /* Alleged Accident Row Highlight */
        .alleged-accident-row {
            background: linear-gradient(90deg, rgba(245, 158, 11, 0.09) 0%, rgba(254, 243, 199, 0.04) 35%, transparent 100%) !important;
            border-left: 4.5px solid #f59e0b !important;
        }
        .alleged-accident-row:hover {
            background: linear-gradient(90deg, rgba(245, 158, 11, 0.16) 0%, rgba(254, 243, 199, 0.09) 45%, rgba(240, 249, 255, 0.5) 100%) !important;
        }
    </style>
}
