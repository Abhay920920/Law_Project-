@model MVCCaseManagement.Models.MVCCaseViewModel

@{
    ViewData["Title"] = "Case Details - " + Model.MVCNo;
    ViewData["HidePageHeader"] = true;
}

<!-- ========================================== -->
<!-- OFFICIAL FEASIBILITY REPORT PRINT VIEW    -->
<!-- ========================================== -->
<div id="print-view" class="d-none d-print-block" style="font-family: 'Times New Roman', serif; font-size: 12pt;">
    
    <!-- Main Header -->
    <div class="text-center mb-4 fw-bold">
        <h4 class="mb-0 text-uppercase">NWKRTC - @Model.DivisionName</h4>
    </div>

    <div class="mb-3 text-center"><strong><u>DETAILS OF THE CASE</u></strong></div>
    
    <!-- Main Details Table -->
    <table class="table table-bordered border-dark" style="font-size: 11pt;">
        <tbody>
            <tr>
                <td style="width: 8%;"><strong>Sl No</strong></td>
                <td style="width: 42%;"><strong>DESCRIPTION</strong></td>
                <td style="width: 50%;"><strong>DETAILS OF THE CASE</strong></td>
            </tr>
            <tr>
                <td>01</td>
                <td>Name of the Division</td>
                <td>@Model.DivisionName</td>
            </tr>
            <tr>
                <td>02</td>
                <td>MACT Court</td>
                <td>@Model.MACTName</td>
            </tr>
            <tr>
                <td>03</td>
                <td>MVC No</td>
                <td>@Model.MVCNo/@Model.MVCYear</td>
            </tr>
            @if (!string.IsNullOrEmpty(Model.CNRNumber))
            {
                <tr class="table-info font-weight-bold">
                    <td>03a</td>
                    <td>eCourts 16-Digit CNR</td>
                    <td>
                        <span class="badge bg-primary fs-6 font-monospace"><i class="bi bi-broadcast me-1"></i> @Model.CNRNumber</span>
                    </td>
                </tr>
            }
            <tr>
                <td>04</td>
                <td>Date of Accident</td>
                <td>@Model.AccidentDate?.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td>05</td>
                <td>Accident vehicle No</td>
                <td>@Model.VehicleNo</td>
            </tr>
            <tr>
                <td>06</td>
                <td>Whether accident ST vehicle is insured with Insurance Company (Domestic/Volvo/other ST vehicle)</td>
                <td>@(Model.AdverseAward?.IsBusInsured == true ? "Insured - " + Model.AdverseAward.BusInsuranceDetails : "Self insured.")</td>
            </tr>
            <tr>
                <td>06a</td>
                <td>Whether claimant was passenger in ST Bus</td>
                <td>@(Model.IsSTPassenger == true ? "Yes" : "No")</td>
            </tr>

            <tr>
                <td>07</td>
                <td>Date of the claim petition</td>
                <td>@Model.AdverseAward?.ClaimPetitionDate?.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td>08</td>
                <td>Date of judgment</td>
                <td>@Model.AdverseAward?.AwardDate?.ToString("dd-MM-yyyy")</td>
            </tr>

            <tr>
                <td>10</td>
                <td>Details of claimant & amount claimed</td>
                <td>
                    @if (Model.Petitioners.Any())
                    {
                        @for (int i = 0; i < Model.Petitioners.Count; i++)
                        {
                            <div>@(i + 1)) @Model.Petitioners[i].PetitionerName (@(Model.Petitioners[i].Relationship == "Others" ? Model.Petitioners[i].RelationshipOthers : Model.Petitioners[i].Relationship))</div>
                        }
                        <div>TOTAL CLAIM AMOUNT: Rs. @(Model.ClaimAmount?.ToString("N2"))</div>
                    }
                </td>
            </tr>
            @if (Model.ThirdPartyFlag && Model.Respondents != null && Model.Respondents.Any())
            {
                <tr>
                    <td>10a</td>
                    <td>Respondent Details</td>
                    <td>
                        @for (int i = 0; i < Model.Respondents.Count; i++)
                        {
                            <div>@(i + 1)) @Model.Respondents[i].RespondentName @(!string.IsNullOrEmpty(Model.Respondents[i].Remarks) ? "- " + Model.Respondents[i].Remarks : "")</div>
                        }
                    </td>
                </tr>
            }
            <tr>
                <td>11</td>
                <td>Statement of objection filed or not (if not reason for not filing objection statement)</td>
                <td>@(Model.AdverseAward?.ObjectionFiled == true ? "Filed. " + Model.AdverseAward.ObjectionRemarks : "Not Filed")</td>
            </tr>
            <tr>
                <td>12</td>
                <td>Evidence adduced by petitioner (Including no of witness examined)</td>
                <td>
                    @if (Model.AdverseAward?.PetitionerPWNames?.Any() == true)
                    {
                        @string.Join(", ", Model.AdverseAward.PetitionerPWNames.Select((pw, idx) => $"PW {idx + 1} - {pw}"))
                    }
                </td>
            </tr>
            <tr>
                <td>13</td>
                <td>Whether doctor examined by the petitioner, if yes, name of the doctor</td>
                <td>
                    @if (Model.AdverseAward?.Doctors?.Any() == true)
                    {
                         @:Yes - @string.Join(", ", Model.AdverseAward.Doctors.Select(d => $"{d.DoctorName} (Treated: {(d.IsTreated ? "Yes" : "No")})"))
                    }
                    else
                    {
                        <text>No</text>
                    }
                </td>
            </tr>
            <tr>
                <td>14</td>
                <td>Driver examined or otherwise (if not reason for not examining the driver)</td>
                <td>
                    @if (Model.AdverseAward?.RWNames?.Any() == true)
                    {
                        @string.Join(", ", Model.AdverseAward.RWNames.Select((rw, idx) => $"RW {idx + 1}"))
                    }
                </td>
            </tr>
            <tr>
                <td>15</td>
                <td>Remarks of the unit head on T.R.18 (if ST driver is responsible, Name & punishment imposed against ST driver)</td>
                <td>@Model.AdverseAward?.TR18Remarks</td>
            </tr>
            <tr>
                <td>16</td>
                <td>Whether the name of the petitioner /deceased found in the TR 18 (list of injured/died)</td>
                <td>@(Model.Petitioners.Any() ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td>17</td>
                <td>Is it alleged Accident (if yes, whether investigation has been conducted)</td>
                <td>@(Model.AdverseAward?.IsAllegedAccident == true ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td>17a</td>
                <td>Whether FIR Filed against ST Driver</td>
                <td>@(Model.AdverseAward?.IsFIRFiled == true ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td>17a-i</td>
                <td>Whether Chargesheet filed against ST Driver</td>
                <td>@(Model.AdverseAward?.IsChargeSheetFiled == true ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td>17b</td>
                <td>Bus Camera Installed / Footage Produced / Photograph Produced</td>
                <td>
                    Camera: @(Model.AdverseAward?.IsBusCameraInstalled == true ? "Yes" : "No"), 
                    Footage: @(Model.AdverseAward?.IsCameraFootageProduced == true ? "Yes" : "No"), 
                    Photo: @(Model.AdverseAward?.IsPhotographProduced == true ? "Yes" : "No")
                </td>
            </tr>
            <tr>
                <td>17c</td>
                <td>Police Sketch Enclosed / Exhibit No</td>
                <td>@(Model.AdverseAward?.IsPoliceSketchEnclosed == true ? "Yes" : "No") @(!string.IsNullOrEmpty(Model.AdverseAward?.PoliceSketchExhibitNo) ? " (Ex No: " + Model.AdverseAward.PoliceSketchExhibitNo + ")" : "")</td>
            </tr>
            <tr>
                <td>17d</td>
                <td>Evidence based on Security Report</td>
                <td>
                    @(Model.AdverseAward?.IsEvidenceBasedOnSecurityReport == true ? "Yes" : "No")
                    @if (Model.AdverseAward?.IsEvidenceBasedOnSecurityReport == false && !string.IsNullOrEmpty(Model.AdverseAward?.SecurityReportNoEvidenceReason))
                    {
                        <div>Reason: @Model.AdverseAward.SecurityReportNoEvidenceReason</div>
                    }
                </td>
            </tr>
            <tr>
                <td>18</td>
                <td>Finding on issue of negligence & liability of corporation</td>
                <td>@Model.DisposalRemarks</td>
            </tr>
            <tr>
                <td>19</td>
                <td>Whether connected cases pending /disposed & details</td>
                <td>
                    @if (Model.ConnectedCases.Any() || (Model.AdverseAward?.ConnectedCases.Any() == true))
                    {
                        @* 1. Basic Linkages (Section E) *@
                        var uniqueCases = Model.ConnectedCases.GroupBy(c => new { c.ConnectedMVCNo, c.ConnectedYear }).Select(g => g.First());
                        foreach (var conn in uniqueCases)
                        {
                            <div class="mb-1"><strong>@conn.ConnectedMVCNo/@conn.ConnectedYear</strong> - @conn.Remarks</div>
                        }

                        @* 2. Adverse Award Details (Section G) *@
                        @if (Model.AdverseAward != null && Model.AdverseAward.ConnectedCases.Any())
                        {
                            <div class="mt-2 border-top pt-1 small"><strong>Award Details (Adverse):</strong></div>
                            @foreach (var adv in Model.AdverseAward.ConnectedCases)
                            {
                                <div class="mb-3 ps-2 border-start border-2">
                                    <div class="fw-bold" style="font-size: 10pt;">@adv.ConnectedMVCNo/@adv.ConnectedYear @(!string.IsNullOrEmpty(adv.MACT) ? "- " + adv.MACT : "") (@adv.Status)</div>
                                    <table class="w-100" style="font-size: 9pt; border-collapse: collapse;">
                                        <tr>
                                            <td style="width: 25%; padding: 1px;">Amt: <strong>@adv.AwardDetails?.AwardAmount</strong></td>
                                            <td style="width: 25%; padding: 1px;">Int: @adv.AwardDetails?.InterestRate%</td>
                                            <td style="width: 20%; padding: 1px;">Age: @adv.AwardDetails?.VictimAge</td>
                                            <td style="width: 30%; padding: 1px;">Occ: @adv.AwardDetails?.Occupation</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="padding: 1px;">Income: @adv.AwardDetails?.IncomeConsidered</td>
                                            <td colspan="2" style="padding: 1px;">Injury: @adv.AwardDetails?.InjuryDetails</td>
                                        </tr>
                                    </table>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <text>No</text>
                    }
                </td>
            </tr>
            <tr>
                <td>20</td>
                <td>Whether double petition filed, including in other MACT'S</td>
                <td>@(Model.DoubleClaimFlag ? "Yes - " + Model.AdverseAward?.DoubleClaimDetails : "No")</td>
            </tr>

            <tr>
                <td>21</td>
                <td>Whether Impleading Application filed by Corporation (if not, reason)</td>
                <td>
                    @(Model.AdverseAward?.IsImpleadingAppFiled == true ? "Yes" : "No")
                    @if (Model.AdverseAward?.IsImpleadingAppFiled == false && !string.IsNullOrEmpty(Model.AdverseAward?.ImpleadingAppNotFiledReason))
                    {
                        <div>Reason: @Model.AdverseAward.ImpleadingAppNotFiledReason</div>
                    }
                </td>
            </tr>
            <tr>
                <td>22</td>
                <td>Manner of Accident</td>
                <td>
                    <div>@(string.IsNullOrEmpty(Model.AdverseAward?.MannerOfAccident) ? "—" : Model.AdverseAward.MannerOfAccident)</div>
                    @if (!string.IsNullOrEmpty(Model.AdverseAward?.MannerOfAccidentRO))
                    {
                        <div class="text-muted extra-small mt-1"><em>RO Report:</em> @Model.AdverseAward.MannerOfAccidentRO</div>
                    }
                </td>
            </tr>
            <tr>
                <td>22</td>
                <td>Injury/Death</td>
                <td>@Model.CaseType</td>
            </tr>
            <tr>
                <td>23</td>
                <td>Security Investigation Conducted?</td>
                <td>@(Model.AdverseAward?.SecurityRequired == true ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td>24</td>
                <td>Whether there is delay in obtaining/sending CC and reasons for delay / EP Status</td>
                <td>
                    <div>Case decided on - @Model.AdverseAward?.AwardDate?.ToString("dd-MM-yyyy")</div>
                    @if (Model.AdverseAward?.IsEPFiled == true)
                    {
                        <div class="fw-bold text-primary mt-1">EP Filed: Yes</div>
                        <div>Amount Deposited in EP: @(Model.AdverseAward?.IsAmountDepositedInEP == true ? "Yes" : "No")</div>
                        @if (Model.AdverseAward?.IsAmountDepositedInEP == true && Model.AdverseAward?.EPDepositedAmount.HasValue == true)
                        {
                            <div class="fw-bold text-success mt-1">EP Deposited Amount: Rs. @Model.AdverseAward.EPDepositedAmount?.ToString("N2")</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.EPNumber))
                        {
                            <div class="mt-1 small"><strong>EP Number:</strong> @Model.AdverseAward.EPNumber</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.EPCourt))
                        {
                            <div class="mt-1 small"><strong>EP Court:</strong> @Model.AdverseAward.EPCourt</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.AsPerECourts))
                        {
                            <div class="mt-1 small"><strong>EP Status (As per e-Courts):</strong> @Model.AdverseAward.AsPerECourts</div>
                        }
                    }
                    else
                    {
                        <div class="mt-1">EP Filed: No</div>
                    }
                    <div class="mt-2 pt-1 border-top border-secondary small">
                        <div>Copy applied on - @Model.AdverseAward?.CopyAppliedDate?.ToString("dd-MM-yyyy")</div>
                        <div>copy ready on - @Model.AdverseAward?.CopyIssuedDate?.ToString("dd-MM-yyyy")</div>
                        <div>copy received at division - @Model.AdverseAward?.CopyReceivedDate?.ToString("dd-MM-yyyy")</div>
                        @if (Model.AdverseAward?.CopyDeliveredDate.HasValue == true)
                        {
                            <div>Copy Delivered on - @Model.AdverseAward?.CopyDeliveredDate?.ToString("dd-MM-yyyy")</div>
                        }
                    </div>
                </td>
            </tr>
            <tr>
                <td>25</td>
                <td>Compensation awarded:</td>
                <td>Rs. @(Model.AdverseAward?.AwardAmount?.ToString("N0")) @Model.AdverseAward?.InterestRate% Int.</td>
            </tr>
            <tr>
                <td></td>
                <td>a) Age of the Injury/Death</td>
                <td>@Model.CaseType - Age: @Model.AdverseAward?.VictimAge years</td>
            </tr>
            <tr>
                <td></td>
                <td>b) Occupation</td>
                <td>@Model.AdverseAward?.Occupation</td>
            </tr>
            <tr>
                <td></td>
                <td>c) Income</td>
                <td>Rs. @(Model.AdverseAward?.IncomeConsidered?.ToString("N2")) Per annum</td>
            </tr>
            <tr>
                <td></td>
                <td>d) Injuries suffered / Details of Damages / Breakdown</td>
                <td>
                    <div>@Model.AdverseAward?.InjuryDetails</div>
                    <div class="mt-2 small">
                        <table class="table table-sm table-bordered border-dark mb-0" style="font-size: 9pt;">
                            @if (Model.AdverseAward?.InjuryType == "Death")
                            {
                                <tr><td>Loss of dependency</td><td class="text-end">@Model.AdverseAward?.LossOfDependency?.ToString("N2")</td></tr>
                                <tr><td>Loss of consortium</td><td class="text-end">@Model.AdverseAward?.LossOfConsortium?.ToString("N2")</td></tr>
                                <tr><td>Loss of estate</td><td class="text-end">@Model.AdverseAward?.LossOfEstate?.ToString("N2")</td></tr>
                                <tr><td>Funeral expenses</td><td class="text-end">@Model.AdverseAward?.FuneralExpenses?.ToString("N2")</td></tr>
                                <tr><td>Loss of love & affection</td><td class="text-end">@Model.AdverseAward?.LossOfLoveAffection?.ToString("N2")</td></tr>
                                <tr><td>Medical & Other expense</td><td class="text-end">@Model.AdverseAward?.MedicalExpenseOther?.ToString("N2")</td></tr>
                            }
                            else
                            {
                                <tr><td>Pain & sufferings</td><td class="text-end">@Model.AdverseAward?.PainSufferings?.ToString("N2")</td></tr>
                                <tr><td>Conveyance, etc.</td><td class="text-end">@Model.AdverseAward?.ConveyanceAttendant?.ToString("N2")</td></tr>
                                <tr><td>Loss of future income</td><td class="text-end">@Model.AdverseAward?.LossOfFutureIncome?.ToString("N2")</td></tr>
                                <tr><td>Loss of income (laid up)</td><td class="text-end">@Model.AdverseAward?.LossOfIncomeLaidUp?.ToString("N2")</td></tr>
                                <tr><td>Loss of amenities</td><td class="text-end">@Model.AdverseAward?.LossOfAmenities?.ToString("N2")</td></tr>
                                <tr><td>Future medical exp.</td><td class="text-end">@Model.AdverseAward?.FutureMedicalExpenses?.ToString("N2")</td></tr>
                                <tr><td>Other expense</td><td class="text-end">@Model.AdverseAward?.InjuryOtherExpense?.ToString("N2")</td></tr>
                            }
                        </table>
                    </div>
                </td>
            </tr>
            <tr>
                <td></td>
                <td>e) Victim Status & Income Verification</td>
                <td>
                    Salaried: @(Model.AdverseAward?.IsVictimSalaried == true ? "Yes" : "No"),
                    Verified: @(Model.AdverseAward?.IsIncomeCrossVerified == true ? "Yes" : "No"),
                    Tallies with Docs: @(Model.AdverseAward?.DoesIncomeTallyWithDocuments == true ? "Yes" : "No")
                </td>
            </tr>
            <tr>
                <td>26</td>
                <td>Any other information about the claim, which not covered above (Copy Remarks)</td>
                <td>@Model.AdverseAward?.CertifiedCopyRemarks</td>
            </tr>
            @if (!string.IsNullOrEmpty(Model.AdverseAward?.FutureProspectus))
            {
                <tr>
                    <td>27</td>
                    <td>Future Prospectus</td>
                    <td>@Model.AdverseAward.FutureProspectus</td>
                </tr>
            }
            <tr>
                <td>28</td>
                <td>Details of the punishment imposed against the Vehicle driver/conductor, for causing accident</td>
                <td>@Model.AdverseAward?.DriverPunishmentStatus</td>
            </tr>
            <tr>
                <td>29</td>
                <td>How much Amount of Interim compensation is paid to the relatives of the deceased/injured</td>
                <td>@(Model.AdverseAward?.InterimCompAmount.HasValue == true ? "Rs. " + Model.AdverseAward.InterimCompAmount?.ToString("N2") : "No")</td>
            </tr>
            <tr>
                <td>30</td>
                <td>The said interim compensation paid is deducted by the MACT in the awarded amount or not. If not deducted give the details reasons</td>
                <td>@(Model.AdverseAward?.InterimCompDeducted == true ? "Yes, deducted" : "No")</td>
            </tr>
            <tr>
                <td>31</td>
                <td>Detailed opinion of the panel advocate</td>
                <td>@Model.AdverseAward?.AdvocateOpinion</td>
            </tr>
            <tr>
                <td>32</td>
                <td>Opinion of the L O</td>
                <td>@Model.AdverseAward?.LOOpinion</td>
            </tr>
            <tr>
                <td>33</td>
                <td>Opinion of the DC</td>
                <td>@Model.AdverseAward?.DCOpinion</td>
            </tr>
            @if(Model.LinkedAppeal != null)
            {
                <tr>
                    <td>34</td>
                    <td>Appeal & Compliance details</td>
                    <td>
                        <div><strong>Initial Action:</strong> @Model.LinkedAppeal.InitialAction @(Model.LinkedAppeal.ApprovalDate.HasValue ? "(Appr: " + Model.LinkedAppeal.ApprovalDate.Value.ToString("dd-MM-yyyy") + ")" : "")</div>
                        @if(!string.IsNullOrEmpty(Model.LinkedAppeal.CorpMFANumber))
                        {
                            <div><strong>Corp MFA:</strong> @Model.LinkedAppeal.CorpMFANumber/@Model.LinkedAppeal.CorpMFAYear (@Model.LinkedAppeal.CorpMFAStatus) - @Model.LinkedAppeal.HighCourtBench</div>
                        }
                        @if(!string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantMFANumber) || !string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantMVCNumber))
                        {
                            <div class="mt-1 border-top pt-1">
                                <strong>Claimant Appeal Workflow:</strong>
                                <br/>MFA No: @Model.LinkedAppeal.ClaimantMFANumber / @Model.LinkedAppeal.ClaimantMFAYear
                                <br/>Bench: @(Model.LinkedAppeal.HighCourtBench == "Others" ? Model.LinkedAppeal.OtherHighCourtBench : Model.LinkedAppeal.HighCourtBench) | Advocate: @Model.LinkedAppeal.ClaimantMFAAdvocate
                                <br/>Entrustment: @Model.LinkedAppeal.ClaimantMFAEntrustmentNo (@(Model.LinkedAppeal.ClaimantMFAEntrustmentDate?.ToString("dd-MM-yyyy") ?? "")) 
                                <br/>Decision: @Model.LinkedAppeal.ClaimantMFADecision | Action: @Model.LinkedAppeal.ClaimantActionTaken
                                @if(!string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantApprovalNo))
                                {
                                    <br/><text>Post-Decision Approval: @(Model.LinkedAppeal.ClaimantApprovalNo) (@(Model.LinkedAppeal.ClaimantApprovalDate?.ToString("dd-MM-yyyy") ?? ""))</text>
                                }
                            </div>
                        }
                        @if(Model.LinkedAppeal.IsClaimantSCAppeal)
                        {
                            <div class="mt-1 p-1 bg-light border">
                                <strong>Claimant SC Tracking:</strong> 
                                @if(!Model.LinkedAppeal.IsClaimantSCPending)
                                {
                                     <span>No: @Model.LinkedAppeal.ClaimantSCNumber / @Model.LinkedAppeal.ClaimantSCYear</span>
                                }
                                else { <span>(Pending Filing)</span> }
                                <br/>Status: @Model.LinkedAppeal.ClaimantSCStatus | Outcome: @Model.LinkedAppeal.ClaimantSCOutcome
                            </div>
                        }
                        <div class="mt-1 pt-1 border-top">
                            <strong>Final Compliance:</strong> @Model.LinkedAppeal.FinalComplianceStatus 
                            (Date: @Model.LinkedAppeal.FinalComplianceDate?.ToString("dd-MM-yyyy"))
                        </div>
                        @if(Model.LinkedAppeal.AmountDeposited.HasValue)
                        {
                            <div><strong>Amt Deposited:</strong> Rs. @Model.LinkedAppeal.AmountDeposited?.ToString("N2")</div>
                        }
                        <div class="small fst-italic">Remarks: @Model.LinkedAppeal.FinalRemarks</div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    
    <!-- Documents List -->
    <div class="mt-5">
        <div class="mb-2"><strong>LIST OF DOCUMENTS ENCLOSED</strong></div>
        <table class="table table-bordered border-dark" style="font-size: 11pt;">
            <thead>
                <tr>
                    <th style="width: 10%;" class="text-center">S.No</th>
                    <th>Description of Documents</th>
                    <th style="width: 15%;" class="text-center">Pages</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AdverseAward?.EnclosedDocuments != null && Model.AdverseAward.EnclosedDocuments.Any())
                {
                    int sno = 1;
                    foreach (var doc in Model.AdverseAward.EnclosedDocuments)
                    {
                        <tr>
                            <td class="text-center">@sno</td>
                            <td>@doc.DocName</td>
                            <td class="text-center">@(doc.PageCount?.ToString() ?? "-")</td>
                        </tr>
                        sno++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-3 italic">No documents identified at the time of registration.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ========================================== -->
<!-- WEB VIEW (Hidden in Print)                 -->
<div class="container-fluid px-3 px-md-4 px-xl-5 py-4 d-print-none">
    @{
        var aiDivId = User.FindFirst("DivisionID")?.Value;
        bool isAICentral = aiDivId == "0" || aiDivId == "5";
        bool isAIRole = User.IsInRole("Dy CLO") || User.IsInRole("DyCLO") || User.IsInRole("CLO") || User.IsInRole("MD");
    }
    @if (isAICentral && isAIRole)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-3 p-3" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.08), rgba(111, 66, 193, 0.08)); border-left: 4px solid #0d6efd !important;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center">
                    <div class="p-2 bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-robot fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Analyze Case with Nyaya Patha AI</h6>
                        <small class="text-muted">Instant strength/weakness analysis, contradiction detection, and precedent matching for MVC/@Model.MVCNo/@Model.MVCYear.</small>
                    </div>
                </div>
                <div>
                    <a href="/NyayaPatha?caseType=MVC&caseId=@Model.CaseID" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
