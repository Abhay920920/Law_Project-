@section Scripts {
    <script src="~/js/ecourts-details.js" asp-append-version="true"></script>
    <script>
        // Advance Payment Logic
        const caseId = @Model.CaseID;
        
        // Load payments on page load
        $(document).ready(function() {
            loadPayments();

            const cnr = '@(Model.CNRNumber ?? "")'.trim();

            const caseCollapseEl = document.getElementById('collapseCaseNapixSection');
            if (caseCollapseEl) {
                caseCollapseEl.addEventListener('show.bs.collapse', function () {
                    const icon = document.getElementById('iconToggleCaseNapix');
                    const text = document.getElementById('textToggleCaseNapix');
                    if (icon) { icon.classList.remove('bi-chevron-down'); icon.classList.add('bi-chevron-up'); }
                    if (text) { text.textContent = 'Hide NAPIX Details'; }
                });

                caseCollapseEl.addEventListener('hide.bs.collapse', function () {
                    const icon = document.getElementById('iconToggleCaseNapix');
                    const text = document.getElementById('textToggleCaseNapix');
                    if (icon) { icon.classList.remove('bi-chevron-up'); icon.classList.add('bi-chevron-down'); }
                    if (text) { text.textContent = 'View NAPIX Details'; }
                });
            }

            // If user selects the Orders tab, ensure orders are loaded/rendered
            const ordersTabBtn = document.getElementById('orders-tab');
            if (ordersTabBtn) {
                ordersTabBtn.addEventListener('shown.bs.tab', function () {
                    const activeCnr = (window.currentActiveCnr || cnr || '').trim();
                    const container = document.getElementById('live-orders-container');
                    if (container && (!container.querySelector('table') || container.innerText.includes('Querying'))) {
                        refreshCaseOrdersLive(activeCnr, @Model.CaseID);
                    }
                });
            }

            // Toggle for Corp MFA NAPIX collapse
            $(document).on('show.bs.collapse', '[id^="collapseCorpMfaNapix_"]', function () {
                const id = this.id.replace('collapseCorpMfaNapix_', '');
                const icon = document.getElementById('iconToggleCorpMfaNapix_' + id);
                const text = document.getElementById('textToggleCorpMfaNapix_' + id);
                if (icon) { icon.classList.remove('bi-chevron-down'); icon.classList.add('bi-chevron-up'); }
                if (text) { text.textContent = 'Hide NAPIX Details'; }
            });

            $(document).on('hide.bs.collapse', '[id^="collapseCorpMfaNapix_"]', function () {
                const id = this.id.replace('collapseCorpMfaNapix_', '');
                const icon = document.getElementById('iconToggleCorpMfaNapix_' + id);
                const text = document.getElementById('textToggleCorpMfaNapix_' + id);
                if (icon) { icon.classList.remove('bi-chevron-up'); icon.classList.add('bi-chevron-down'); }
                if (text) { text.textContent = 'View NAPIX Details'; }
            });

            // Toggle for Claimant MFA NAPIX collapse
            $(document).on('show.bs.collapse', '[id^="collapseClaimantMfaNapix_"]', function () {
                const id = this.id.replace('collapseClaimantMfaNapix_', '');
                const icon = document.getElementById('iconToggleClaimantMfaNapix_' + id);
                const text = document.getElementById('textToggleClaimantMfaNapix_' + id);
                if (icon) { icon.classList.remove('bi-chevron-down'); icon.classList.add('bi-chevron-up'); }
                if (text) { text.textContent = 'Hide NAPIX Details'; }
            });

            $(document).on('hide.bs.collapse', '[id^="collapseClaimantMfaNapix_"]', function () {
                const id = this.id.replace('collapseClaimantMfaNapix_', '');
                const icon = document.getElementById('iconToggleClaimantMfaNapix_' + id);
                const text = document.getElementById('textToggleClaimantMfaNapix_' + id);
                if (icon) { icon.classList.remove('bi-chevron-up'); icon.classList.add('bi-chevron-down'); }
                if (text) { text.textContent = 'View NAPIX Details'; }
            });

            // Manual MFA Live eCourts details are triggered via user button click (Rule 7: Database-only page load)
            
            // Show add payment modal
            $('#btnAddPayment').click(function() {
                $('#paymentForm')[0].reset();
                $('#paymentModal').modal('show');
            });
            
            // Save payment
            $('#btnSavePayment').click(function() {
                const payment = {
                    caseID: caseId,
                    amount: parseFloat($('#paymentAmount').val()),
                    paymentType: $('#paymentType').val(),
                    chequeNumber: $('#chequeNumber').val() || null,
                    chequeDate: $('#chequeDate').val() || null,
                    remarks: $('#paymentRemarks').val() || null
                };
                
                if (!payment.amount || payment.amount <= 0) {
                    alert('Please enter a valid amount');
                    return;
                }
                
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/Case/AddPayment',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        "RequestVerificationToken": token
                    },
                    data: JSON.stringify(payment),
                    success: function(response) {
                        if (response.success) {
                            $('#paymentModal').modal('hide');
                            loadPayments();
                        } else {
                            alert('Error: ' + (response.message || 'Failed to save payment'));
                        }
                    },
                    error: function(xhr) {
                        alert('Error saving payment. Please try again.');
                        console.error(xhr);
                    }
                });
            });
        });
        
        // Load payments function
        function loadPayments() {
            $.get('/Case/GetPayments', { caseId: caseId }, function(data) {
                if (Array.isArray(data)) {
                    renderPayments(data);
                } else {
                    console.error("Payment load error:", data);
                    const msg = data.message || "Unknown error";
                    $('#paymentsList').html('<div class="list-group-item text-danger small">Error: ' + msg + '</div>');
                }
            }).fail(function() {
                $('#paymentsList').html('<div class="list-group-item text-danger small">Network error loading payments</div>');
            });
        }
        
        // Render payments list
        function renderPayments(payments) {
            const container = $('#paymentsList');
            container.empty();
            
            if (payments.length === 0) {
                container.html('<div class="list-group-item text-muted small fst-italic">No payments recorded yet.</div>');
                $('#totalPayments').text('0.00');
                return;
            }
            
            let total = 0;
            payments.forEach(payment => {
                total += payment.amount;
                
                const date = payment.chequeDate ? 
                    new Date(payment.chequeDate).toLocaleDateString('en-IN') : 
                    new Date(payment.createdDate).toLocaleDateString('en-IN');
                
                const html = `
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="fw-bold text-success">₹ ${payment.amount.toLocaleString('en-IN', {minimumFractionDigits: 2})}</div>
                                <small class="text-muted d-block">
                                    ${payment.paymentType || 'Payment'} • ${date}
                                </small>
                                ${payment.chequeNumber ? '<small class="text-muted d-block">Cheque: ' + payment.chequeNumber + '</small>' : ''}
                                ${payment.remarks ? '<small class="text-muted d-block fst-italic">' + payment.remarks + '</small>' : ''}
                            </div>
                            ${payment.paymentID > 0 ? `
                                <button class="btn btn-sm btn-outline-danger" onclick="deletePayment(${payment.paymentID})" type="button">
                                    <i class="bi bi-trash"></i>
                                </button>
                            ` : `
                                <span class="badge bg-light text-muted border" title="Saved via Petty Bill (Read-Only)">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                            `}
                        </div>
                    </div>
                `;
                container.append(html);
            });
            
            $('#totalPayments').text(total.toLocaleString('en-IN', {minimumFractionDigits: 2}));
        }
        
        // Delete payment
        function deletePayment(paymentId) {
            if (!confirm('Are you sure you want to delete this payment record?')) {
                return;
            }
            
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Case/DeletePayment',
                type: 'POST',
                data: { paymentId: paymentId },
                headers: {
                    "RequestVerificationToken": token
                },
                success: function(response) {
                    if (response.success) {
                        loadPayments();
                    } else {
                        alert('Error deleting payment');
                    }
                },
                error: function() {
                    alert('Error deleting payment. Please try again.');
                }
            });
        }

        // CNR Number Update and Live Gateway Management
        window.currentActiveCnr = '@(Model.CNRNumber ?? "")';

        function onCnrInputChange(input) {
            input.value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            const val = input.value;
            const len = val.length;
            const countBadge = $('#cnrCharCount');
            const helper = $('#cnrHelperText');

            if (len === 0) {
                countBadge.removeClass('bg-success bg-warning bg-danger').addClass('bg-secondary').text('0 / 16 chars');
                helper.html('Format: 6-char establishment code + 6-digit case number + 4-digit year (e.g. <code>KADW200035312025</code>)');
            } else if (len === 16) {
                countBadge.removeClass('bg-secondary bg-warning bg-danger').addClass('bg-success').html('<i class="bi bi-check2"></i> 16 / 16 chars (Complete)');
                helper.html('<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Valid 16-character CNR length. Click <strong>Verify</strong> or <strong>Save & Link CNR</strong>.</span>');
                $('#verifyCnrResult').slideUp();
            } else {
                const remaining = 16 - len;
                countBadge.removeClass('bg-secondary bg-success').addClass('bg-warning text-dark').text(`${len} / 16 chars (${remaining} more needed)`);
                if (len >= 12 && val.endsWith('202')) {
                    helper.html('<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Year needs 4 digits (e.g. 2024, 2025, or 2026). Add the final digit of the year.</span>');
                } else {
                    helper.html(`Format: 6-char court/est code + 6-digit case no + 4-digit year. Need <strong>${remaining}</strong> more character(s).`);
                }
            }
        }

        function openUpdateCnrModal() {
            $('#verifyCnrResult').hide().empty();
            const input = document.getElementById('txtNewCnrNumber');
            if (input) onCnrInputChange(input);
            const modalEl = document.getElementById('updateCnrModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        async function verifyCnrLive() {
            const cnr = ($('#txtNewCnrNumber').val() || '').trim().toUpperCase();
            const resultBox = $('#verifyCnrResult');
            const btn = $('#btnVerifyCnr');

            if (!cnr || cnr.length !== 16) {
                const remaining = 16 - (cnr ? cnr.length : 0);
                resultBox.html(`
                    <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                        <div class="fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>Invalid CNR Length (${cnr.length}/16 characters)</div>
                        <div>A valid eCourts CNR must be exactly 16 characters. You entered <code>${cnr}</code> (${cnr.length} chars).</div>
                        <div class="mt-1">Please add the remaining <strong>${remaining}</strong> character(s) (such as the last digit of the year, e.g. 2024, 2025, or 2026).</div>
                    </div>
                `).slideDown();
                return;
            }

            const isHc = cnr.startsWith('KAHC') || cnr.includes('HC');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Verifying...');
            resultBox.html('<div class="text-muted small py-1"><span class="spinner-border spinner-border-sm text-primary me-1"></span>Checking live eCourts NAPIX Gateway...</div>').slideDown();

            try {
                const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=${isHc}`);
                const data = await res.json();
                if (data.success && data.data) {
                    const s = data.data;
                    resultBox.html(`
                        <div class="alert alert-success py-2 px-3 small mb-0 rounded-3 shadow-sm">
                            <div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i>Verified on eCourts!</div>
                            <div><strong>Court:</strong> ${s.establishment_name || s.court_no_judge || 'eCourts'}</div>
                            <div><strong>Case:</strong> ${s.case_type || ''} ${s.case_number || ''} | <strong>Stage:</strong> ${s.stage || 'N/A'}</div>
                            ${s.next_hearing_date ? `<div><strong>Next Date:</strong> ${s.next_hearing_date}</div>` : ''}
                        </div>
                    `).slideDown();
                } else {
                    resultBox.html(`<div class="alert alert-warning py-2 px-3 small mb-0 rounded-3"><i class="bi bi-exclamation-circle me-1"></i>${data.message || 'Valid 16-digit CNR format, but not yet indexed on live eCourts.'}</div>`).slideDown();
                }
            } catch (e) {
                resultBox.html('<div class="alert alert-info py-2 px-3 small mb-0 rounded-3"><i class="bi bi-info-circle me-1"></i>Gateway test completed. Format is valid. You can save and link.</div>').slideDown();
            } finally {
                btn.prop('disabled', false).html('<i class="bi bi-shield-check me-1"></i> Verify');
            }
        }

        async function submitUpdateCnr() {
            const caseId = $('#updateCnrCaseId').val();
            const cnr = ($('#txtNewCnrNumber').val() || '').trim().toUpperCase();
            const btn = $('#btnSaveCnr');
            const resultBox = $('#verifyCnrResult');

            if (cnr && cnr.length !== 16) {
                const remaining = 16 - cnr.length;
                resultBox.html(`
                    <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                        <div class="fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>CNR Number must be exactly 16 characters</div>
                        <div>You entered <code>${cnr}</code> which is only <strong>${cnr.length}</strong> characters.</div>
                        <div class="mt-1">Please enter the missing <strong>${remaining}</strong> character(s) (e.g. 4-digit filing year like 2024, 2025, or 2026).</div>
                    </div>
                `).slideDown();
                return;
            }

            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

            const token = $('input[name="__RequestVerificationToken"]').first().val();

            try {
                const formData = new FormData();
                formData.append('caseId', caseId);
                formData.append('cnrNumber', cnr);
                if (token) formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Case/UpdateCnr', {
                    method: 'POST',
                    body: formData
                });

                if (res.redirected || (res.url && res.url.includes('/Account/Login'))) {
                    resultBox.html(`
                        <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Your session expired. Please <a href="/Account/Login" class="alert-link fw-bold">Login again</a> to save changes.
                        </div>
                    `).slideDown();
                    return;
                }

                if (!res.ok) {
                    const errorText = await res.text();
                    resultBox.html(`
                        <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Server error (${res.status}): ${errorText || res.statusText}
                        </div>
                    `).slideDown();
                    return;
                }

                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    const rawText = await res.text();
                    if (rawText.includes('login') || rawText.includes('Login') || rawText.includes('<!DOCTYPE')) {
                        resultBox.html(`
                            <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Your session expired. Please <a href="/Account/Login" class="alert-link fw-bold">Login again</a>.
                            </div>
                        `).slideDown();
                        return;
                    }
                    throw new Error('Unexpected response format from server.');
                }

                const json = await res.json();

                if (json.success) {
                    window.currentActiveCnr = json.cnrNumber || '';
                    $('#txtNewCnrNumber').val(window.currentActiveCnr);

                    const modalEl = document.getElementById('updateCnrModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();

                    if (json.cnrNumber) {
                        $('#details-cnr-badge').html(`
                            <span class="badge bg-success font-monospace fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center text-nowrap">
                                <i class="bi bi-broadcast me-1"></i> CNR: ${json.cnrNumber}
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Copy CNR Number" onclick="event.stopPropagation(); navigator.clipboard.writeText('${json.cnrNumber}'); alert('CNR Number copied to clipboard: ${json.cnrNumber}');">
                                <i class="bi bi-clipboard"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                                <i class="bi bi-pencil-square me-1"></i>Update CNR
                            </button>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" id="btnRefreshCaseLive" onclick="event.stopPropagation(); triggerFetchCaseLiveStatus()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status
                            </button>
                        `);
                        triggerFetchCaseLiveStatus();
                    } else {
                        $('#details-cnr-badge').html(`
                            <span class="badge bg-warning text-dark px-3 py-2">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> CNR Not Linked
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                                <i class="bi bi-pencil-square me-1"></i>Update CNR
                            </button>
                        `);
                        fetchLiveCnrDetails('', caseId);
                    }

                    alert(json.message || 'CNR Number updated successfully!');
                } else {
                    resultBox.html(`
                        <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i>${json.message || 'Unable to update CNR Number.'}
                        </div>
                    `).slideDown();
                }
            } catch (e) {
                resultBox.html(`
                    <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>An error occurred: ${e.message || e}
                    </div>
                `).slideDown();
            } finally {
                btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Save & Link CNR');
            }
        }

        function unlinkCnrNumber() {
            if (!confirm('Are you sure you want to unlink the CNR Number from this case?')) return;
            $('#txtNewCnrNumber').val('');
            submitUpdateCnr();
        }

        function triggerFetchCaseLiveStatus() {
            const cnr = (window.currentActiveCnr || '@(Model.CNRNumber ?? "")').trim();
            if (!cnr || cnr === '') {
                openUpdateCnrModal();
                return;
            }
            const caseCollapseEl = document.getElementById('collapseCaseNapixSection');
            if (caseCollapseEl && !caseCollapseEl.classList.contains('show')) {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(caseCollapseEl, { toggle: false });
                bsCollapse.show();
            }
            // 1. Immediately fetch live CNR details to dynamically update top card, hearing history, and orders
            if (typeof fetchLiveCnrDetails === 'function') {
                fetchLiveCnrDetails(cnr, @Model.CaseID);
            }
            // 2. Also register priority sync in background engine
            queueManualSync(cnr, @Model.CaseID, 'MVC');
        }

        function queueManualSync(cnr, caseId, module) {
            const msgElem = document.getElementById('live-sync-msg');
            if (msgElem) {
                msgElem.innerHTML = '<span class="text-primary"><span class="spinner-border spinner-border-sm me-1"></span> Queuing sync with priority...</span>';
            }

            const formData = new FormData();
            formData.append('caseId', caseId);
            formData.append('cnrNumber', cnr);
            formData.append('module', module || 'MVC');

            fetch('/ECourts/QueueCaseSync', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    if (msgElem) msgElem.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> ' + (data.message || 'Failed to queue sync') + '</span>';
                    return;
                }

                if (msgElem) {
                    msgElem.innerHTML = '<span class="text-info"><span class="spinner-border spinner-border-sm me-1"></span> Sync queued (' + data.status + '). Processing in background...</span>';
                }

                let attempts = 0;
                const pollInterval = setInterval(() => {
                    attempts++;
                    if (attempts > 30) {
                        clearInterval(pollInterval);
                        if (msgElem) msgElem.innerHTML = '<span class="text-warning"><i class="bi bi-clock-history me-1"></i> Sync is taking longer than expected. Refresh page later.</span>';
                        return;
                    }

                    fetch('/ECourts/GetQueueStatus?queueId=' + (data.queueId || 0) + '&caseId=' + caseId + '&module=' + (module || 'MVC'))
                    .then(r => r.json())
                    .then(statusData => {
                        if (statusData.status === 'Success') {
                            clearInterval(pollInterval);
                            if (msgElem) {
                                msgElem.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Synced with e-Courts Gateway!</span>';
                            }
                            if (typeof fetchLiveCnrDetails === 'function') {
                                fetchLiveCnrDetails(cnr, caseId);
                            }
                        } else if (statusData.status === 'Failed') {
                            clearInterval(pollInterval);
                            if (msgElem) {
                                msgElem.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Sync Failed: ' + (statusData.error || 'e-Courts error') + '</span>';
                            }
                        } else if (msgElem) {
                            msgElem.innerHTML = '<span class="text-info"><span class="spinner-border spinner-border-sm me-1"></span> ' + statusData.status + '... (Attempt ' + attempts + ')</span>';
                        }
                    })
                    .catch(() => {});
                }, 2000);
            })
            .catch(err => {
                if (msgElem) msgElem.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Error connecting to sync queue</span>';
            });
        }

        function ensureMfaSectionOpen(appealId) {
            const rawId = String(appealId || '').replace('_claimant', '');
            const el = document.getElementById('collapseCorpMfaNapix_' + rawId) || 
                       document.getElementById('collapseClaimantMfaNapix_' + rawId) ||
                       document.getElementById('collapseCorpMfaNapix_' + appealId) || 
                       document.getElementById('collapseClaimantMfaNapix_' + appealId);
            if (el && !el.classList.contains('show')) {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
                bsCollapse.show();
            }
        }
    </script>
}
