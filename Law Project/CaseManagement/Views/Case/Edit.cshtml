        function addDynamicConnectedCase() {
            addAdverseConnectedRow('', '', '', '');
        }

        function syncAdverseConnectedCases() {
            if ($("#adverseWorkflowContainer").is(":hidden")) return;

            $("#connectedCasesTable tbody tr").each(function() {
                let mvcNo = $(this).find('input[name*=".ConnectedMVCNo"]').val();
                let mvcYear = $(this).find('input[name*=".ConnectedYear"]').val();
                let mact = $(this).find('input[name*=".MACT"]').val();
                
                if (!mvcNo || !mvcYear) return;

                let exists = false;
                $("#adverseConnTable tbody tr").each(function() {
                    let advMvc = $(this).find('input[name*="ConnectedMVCNo"]').val();
                    let advYear = $(this).find('input[name*="ConnectedYear"]').val();
                    if (String(advMvc).trim() === String(mvcNo).trim() && String(advYear).trim() === String(mvcYear).trim()) {
                        exists = true;
                        return false;
                    }
                });

                if (!exists) {
                    addAdverseConnectedRow(mvcNo, mvcYear, mact, "Pending");
                }
            });
        }

        function clearAndHideStaticRow(btn) {
            var tr = $(btn).closest('tr');
            tr.find('input[type="number"]').val('');
            tr.hide();
            calculateLiableAmount();
        }

        function addCustomHead(type) {
            const tbodyId = type === 'death' ? 'dynamicDeathHeadsBody' : (type === 'damage' ? 'dynamicDamageHeadsBody' : 'dynamicInjuryHeadsBody');
            const headClass = type === 'death' ? 'death-head' : (type === 'damage' ? 'damage-head' : 'injury-head');
            
            let tr = `
            <tr class="dynamic-head-row" data-type="${type}">
                <td class="ps-4">
                    <input type="text" name="AdverseAward.CustomCompensationHeads[${dynamicHeadIndex}].HeadName" class="form-control form-control-sm head-name-input" placeholder="Enter Custom Head Name" required />
                </td>
                <td class="pe-4">
                    <input type="number" name="AdverseAward.CustomCompensationHeads[${dynamicHeadIndex}].Amount" class="form-control form-control-sm text-end head-input ${headClass}" step="0.01" placeholder="0.00" required oninput="calculateLiableAmount()" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm text-danger border-0 p-1" onclick="this.closest('tr').remove(); updateDynamicHeadIndices(); calculateLiableAmount();">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
            `;
            $('#' + tbodyId).append(tr);
            dynamicHeadIndex++;
            updateDynamicHeadIndices();
        }

        function updateDynamicHeadIndices() {
            let idx = 0;
            $('.dynamic-head-row').each(function() {
                const nameInput = $(this).find('.head-name-input');
                const amountInput = $(this).find('.head-input');
                nameInput.attr('name', `AdverseAward.CustomCompensationHeads[${idx}].HeadName`);
                amountInput.attr('name', `AdverseAward.CustomCompensationHeads[${idx}].Amount`);
                idx++;
            });
            dynamicHeadIndex = idx;
        }

        function toggleInterimSection(el) {
            const $el = $(el);
            const $container = $el.closest('.compensation-table-wrapper, #deathCompensationTable, #injuryCompensationTable, #damageCompensationTable, .card').find('.interim-container');
            if ($el.is(':checked')) {
                $container.slideDown();
            } else {
                $container.slideUp();
                $container.find('input').val('');
                calculateLiableAmount();
            }
        }

        function calculateLiableAmount() {
            const type = $("#injuryTypeSelect").val();
            let subtotal = 0;
            
            if (type === "Death") {
                $(".death-head:visible").each(function() {
                    subtotal += parseFloat($(this).val()) || 0;
                });
            } else if (type === "Injury") {
                $(".injury-head:visible").each(function() {
                    subtotal += parseFloat($(this).val()) || 0;
                });
            } else if (type === "Damage") {
                $(".damage-head:visible").each(function() {
                    subtotal += parseFloat($(this).val()) || 0;
                });
            }

            const interimAmount = parseFloat($(".interim-input:visible").val()) || 0;
            const isManualEntry = $(document.activeElement).attr('id') === "AdverseAward_AwardAmount" || $(document.activeElement).attr('id') === "roundOffAmt";
            
            if (subtotal > 0 && !isManualEntry) {
                let totalAfterDeduction = Math.max(0, subtotal - interimAmount);
                $("#AdverseAward_AwardAmount").val(totalAfterDeduction.toFixed(2));
            }

            const roundOff = parseFloat($("#roundOffAmt").val()) || 0;
            $("#roundOffAmtHidden").val(roundOff !== 0 ? roundOff.toFixed(2) : "");
            const baseAward = parseFloat($("#AdverseAward_AwardAmount").val()) || 0;
            const finalAward = baseAward + roundOff;

            $("#deathTotal").val(finalAward.toFixed(2));
            $("#injuryTotal").val(finalAward.toFixed(2));

            const percentage = parseFloat($("#AdverseAward_LiabilityPercentage").val()) || 0;
            let liableAmount = (finalAward * percentage) / 100;
            liableAmount = Math.round(liableAmount);
            
            $('[name="AdverseAward.LiableAmount"]').val(liableAmount.toFixed(2));
            $("#deathLiable").val(liableAmount.toFixed(2));
            $("#injuryLiable").val(liableAmount.toFixed(2));

            $("#liableAmountDisplay").text("₹ " + liableAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
        }

        function handleInjuryTypeChange() {
            const type = $("#injuryTypeSelect").val();
            const container = $("#compensationContainer");
            
            if (type === "Death") {
                container.show();
                $("#paragraphContainer").show();
                $("#deathCompensationTable").show();
                $("#injuryCompensationTable").hide();
                $("#damageCompensationTable").hide();
                $("#injuryRemarkCol").hide();
                $(".death-only").show();
                $(".injury-only").hide();
            } else if (type === "Injury") {
                container.show();
                $("#paragraphContainer").show();
                $("#deathCompensationTable").hide();
                $("#injuryCompensationTable").show();
                $("#damageCompensationTable").hide();
                $("#injuryRemarkCol").show();
                $(".death-only").hide();
                $(".injury-only").show();
            } else if (type === "Damage") {
                container.show();
                $("#paragraphContainer").hide();
                $("#deathCompensationTable").hide();
                $("#injuryCompensationTable").hide();
                $("#damageCompensationTable").show();
                $("#injuryRemarkCol").show();
                $(".death-only").hide();
                $(".injury-only").hide();
            } else {
                container.hide();
                $("#injuryRemarkCol").hide();
            }
            calculateLiableAmount();
        }

        function onMvcStateChange() {
            const stateCode = document.getElementById('mvc-ecourts-state').value;
            ECourtsCascade.loadDistricts(stateCode, 'mvc-ecourts-dist');
        }

        function onMvcDistChange() {
            const stateCode = document.getElementById('mvc-ecourts-state').value;
            const distCode = document.getElementById('mvc-ecourts-dist').value;
            ECourtsCascade.loadCourtComplexes(stateCode, distCode, 'mvc-ecourts-est');
            ECourtsCascade.loadCaseTypes('', 'mvc-ecourts-type', false, stateCode, distCode);
        }

        function onMvcEstChange() {
            const stateCode = document.getElementById('mvc-ecourts-state').value;
            const distCode = document.getElementById('mvc-ecourts-dist').value;
            const estCode = document.getElementById('mvc-ecourts-est').value;
            ECourtsCascade.loadCaseTypes(estCode, 'mvc-ecourts-type', false, stateCode, distCode);
            triggerMvcCnrDiscovery();
        }

        function onCnrInputChange(val) {
            if (!val) return;
            const cleanCnr = val.trim().toUpperCase();
            if (cleanCnr.length === 16) {
                triggerMvcCnrDiscovery();
            }
        }

        async function triggerMvcCnrDiscovery() {
            const cnrElem = document.getElementById('mvc-cnr-number');
            const cnrVal = cnrElem ? cnrElem.value.trim().toUpperCase() : '';
            const statusElem = document.getElementById('cnr-status-badge');

            if (cnrVal.length === 16) {
                if (statusElem) statusElem.innerHTML = '<span class="badge bg-info text-dark"><i class="bi bi-hourglass-split"></i> Auto-Linking CNR on eCourts Gateway...</span>';
                
                const parsedEstCode = cnrVal.substring(0, 6);
                const estElem = document.getElementById('mvc-ecourts-est');
                if (estElem) {
                    for (let i = 0; i < estElem.options.length; i++) {
                        if (estElem.options[i].value === parsedEstCode) {
                            estElem.selectedIndex = i;
                            break;
                        }
                    }
                }

                try {
                    const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnrVal)}`);
                    const json = await res.json();
                    if (json.success) {
                        if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Linked Live CNR: ${cnrVal}</span>`;
                        if (json.data) populateFormFromEcourtsData(json.data);
                        else if (json.regNo) {
                            const regNoElem = document.getElementById('MVCNo') || document.querySelector('[name="MVCNo"]');
                            if (regNoElem && (!regNoElem.value || regNoElem.value.trim() === '')) regNoElem.value = json.regNo;
                            const regYearElem = document.getElementById('MVCYear') || document.querySelector('[name="MVCYear"]');
                            if (regYearElem && (!regYearElem.value || regYearElem.value.trim() === '')) regYearElem.value = json.regYear;
                        }
                    } else {
                        if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> eCourts CNR Linked: ${cnrVal}</span>`;
                    }
                } catch (e) {
                    if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Linked CNR: ${cnrVal}</span>`;
                }
                return;
            }

            const estElem = document.getElementById('mvc-ecourts-est');
            const estCode = estElem ? estElem.value : '';
            const caseTypeElem = document.getElementById('mvc-ecourts-type');
            const caseType = (caseTypeElem && caseTypeElem.value) ? caseTypeElem.value : '47';

            const regNoElem = document.getElementById('MVCNo') || document.querySelector('[name="MVCNo"]');
            const regNo = regNoElem ? regNoElem.value.trim() : '';

            const regYearElem = document.getElementById('MVCYear') || document.querySelector('[name="MVCYear"]');
            const regYear = regYearElem ? regYearElem.value.trim() : '';

            if (!estCode && !cnrVal) {
                if (statusElem) statusElem.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Please select Court Establishment or enter 16-Digit CNR</span>';
                return;
            }

            if (!regNo || !regYear) {
                if (statusElem) statusElem.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Enter MVC No. & Year OR paste 16-Digit CNR</span>';
                return;
            }

            ECourtsCascade.autoDiscoverCNR(estCode, caseType, regNo, regYear, 'mvc-cnr-number', 'cnr-status-badge');
        }

        function populateFormFromEcourtsData(data) {
            if (!data) return;

            let realRegNo = data.reg_no || data.case_no || data.registration_no || data.case_number || '';
            let realRegYear = data.reg_year || data.case_year || data.year || '';

            if (realRegNo) {
                const regNoElem = document.getElementById('MVCNo') || document.querySelector('[name="MVCNo"]');
                if (regNoElem && (!regNoElem.value || regNoElem.value.trim() === '' || regNoElem.dataset.autoFilled === "true")) {
                    regNoElem.value = String(realRegNo).trim();
                    regNoElem.dataset.autoFilled = "true";
                }
            }

            if (realRegYear) {
                const regYearElem = document.getElementById('MVCYear') || document.querySelector('[name="MVCYear"]');
                if (regYearElem && (!regYearElem.value || regYearElem.value.trim() === '' || regYearElem.dataset.autoFilled === "true")) {
                    regYearElem.value = String(realRegYear).trim();
                    regYearElem.dataset.autoFilled = "true";
                }
            }

            let petName = data.pet_name || data.petitioner_name || data.petitioner || '';
            if (petName && typeof petName === 'string') {
                const petTable = document.getElementById('petitionersTable');
                if (petTable) {
                    const tbody = petTable.querySelector('tbody');
                    if (tbody) {
                        let nameInputs = tbody.querySelectorAll('input[name*="Name"]');
                        if (nameInputs.length === 0) {
                            const addBtn = document.getElementById('btnAddPetitioner');
                            if (addBtn) addBtn.click();
                            nameInputs = tbody.querySelectorAll('input[name*="Name"]');
                        }
                        if (nameInputs.length > 0) {
                            nameInputs[0].value = petName.trim();
                        }
                    }
                }
            }

            let filingDate = data.filing_date || data.date_of_filing || data.dt_of_filing || '';
            if (filingDate) {
                const claimDateElem = document.querySelector('[name="AdverseAward.ClaimPetitionDate"]');
                if (claimDateElem) {
                    let formattedDate = filingDate;
                    if (filingDate.includes('-')) {
                        const parts = filingDate.split('-');
                        if (parts.length === 3 && parts[2].length === 4) {
                            formattedDate = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                        }
                    }
                    claimDateElem.value = formattedDate;
                }
            }
        }
    </script>
}
