@model MVCCaseManagement.Models.MVCCaseViewModel
@{
    ViewData["Title"] = "Update Digital MVC Case File";
    ViewData["HidePageHeader"] = true;
}

<style>
    /* User Rule: Black border for radio/checkbox across all modules */
    .form-check-input {
        border: 2px solid #000 !important;
        cursor: pointer;
    }
    .form-check-input:checked {
        background-color: #000 !important;
        border-color: #000 !important;
        box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.1) !important;
    }
    .adverse-header-banner {
        background: linear-gradient(135deg, #0d6efd 0%, #052c65 100%);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.15);
    }
</style>

<div class="case-file-container row justify-content-center">
    <div class="col-xl-10">
        <form asp-action="Edit" method="post" id="caseEntryForm" enctype="multipart/form-data">
            <input type="hidden" asp-for="CaseID" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="AdverseAward.TR18UploadPath" />
            <input type="hidden" asp-for="AdverseAward.PunishmentOrderUploadPath" />
            <input type="hidden" asp-for="AdverseAward.SecurityUploadPath" />
            <input type="hidden" asp-for="AdverseAward.GovIDProofUploadPath" />
            <input type="hidden" asp-for="AdverseAward.AdverseJudgmentUploadPath" />
            <input type="hidden" asp-for="AdverseAward.DelayApplicationPath" />
            <input type="hidden" asp-for="AdverseAward.DelayCondonedOrderPath" />
            <input type="hidden" asp-for="AdverseAward.AgeProofUploadPath" />
            <input type="hidden" asp-for="InterimOrderFilePath" />

            <div class="d-flex align-items-center mb-4">
                <div class="icon-box bg-primary-subtle p-3 rounded-3 me-3">
                    <i class="bi bi-folder-plus fs-2 text-primary"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold text-dark">Update Digital Case File</h3>
                    <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i> Update case registration, eCourts CNR details, and award proceedings.</p>
                </div>
                <div class="ms-auto">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-save me-2"></i> Update Case File
                    </button>
                </div>
            </div>

            <!-- UNIFIED CASE REGISTRATION SECTION -->
            <div class="case-section-card silent-blue mb-4 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center">
                    <span class="official-badge-id me-2">FILE MASTER</span>
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-file-earmark-text me-2 text-primary"></i>UNIFIED CASE REGISTRATION</h5>
                </div>
                <div class="card-body">
                    <!-- PART 1: CASE IDENTIFICATION -->
                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-fingerprint me-2"></i>1. CASE IDENTIFICATION</h6>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CaseType" class="form-label fw-bold text-primary text-uppercase">Case Type</label>
                            <select asp-for="CaseType" class="form-select border-primary" required>
                                <option value="Pending">Pending</option>
                                <option value="Disposed">Disposed</option>
                                <option value="DNP">DNP (Dismissed For Non-Prosecution)</option>
                                <option value="Ex-parte">Ex-parte</option>
                            </select>
                            <span asp-validation-for="CaseType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DivisionID" class="form-label text-uppercase"></label>
                            <input type="hidden" asp-for="DivisionID" required />
                            <input class="form-control" value="@Model.DivisionName" readonly required />
                            <span asp-validation-for="DivisionID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MVCNo" class="form-label text-uppercase"></label>
                            <input asp-for="MVCNo" class="form-control border-primary-subtle" placeholder="e.g. 550" required />
                            <span asp-validation-for="MVCNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MVCYear" class="form-label text-uppercase"></label>
                            <input asp-for="MVCYear" class="form-control border-primary-subtle" type="number" required />
                            <span asp-validation-for="MVCYear" class="text-danger small"></span>
                        </div>
                        <input type="hidden" asp-for="MACTID" />

                        <!-- ECOURTS NAPIX LIVE LINKAGE BOX -->
                        <div class="col-12">
                            <div class="card bg-light border-info shadow-sm p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-info mb-0"><i class="bi bi-broadcast me-2"></i>eCourts NAPIX Live Gateway Auto-Linkage</h6>
                                    <span id="cnr-status-badge"></span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label for="mvc-ecourts-state" class="form-label small font-weight-bold">State</label>
                                        <select id="mvc-ecourts-state" class="form-select form-select-sm" onchange="onMvcStateChange()">
                                            <option value="">Loading States...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="mvc-ecourts-dist" class="form-label small font-weight-bold">District</label>
                                        <select id="mvc-ecourts-dist" class="form-select form-select-sm" onchange="onMvcDistChange()">
                                            <option value="">Select District</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="mvc-ecourts-est" class="form-label small font-weight-bold">eCourts Establishment</label>
                                        <select id="mvc-ecourts-est" class="form-select form-select-sm" asp-for="EstCode" data-initial-val="@Model.EstCode" onchange="onMvcEstChange()">
                                            <option value="">Select Establishment</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="mvc-ecourts-est" class="form-label small font-weight-bold">Case Type Code</label>
                                        <select id="mvc-ecourts-type" class="form-select form-select-sm" asp-for="CaseTypeCode" data-initial-val="@Model.CaseTypeCode" onchange="triggerMvcCnrDiscovery()">
                                            <option value="">Select Type Code</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mt-2">
                                        <label for="mvc-cnr-number" class="form-label small font-weight-bold">16-Digit CNR Number</label>
                                        <input asp-for="CNRNumber" id="mvc-cnr-number" class="form-control form-control-sm font-monospace" placeholder="16-Digit CNR (e.g. KADW220012342020)" oninput="onCnrInputChange(this.value)" onchange="onCnrInputChange(this.value)" />
                                    </div>
                                    <div class="col-md-6 mt-2 d-flex align-items-end">
                                        <button type="button" class="btn btn-sm btn-info text-white w-100" onclick="triggerMvcCnrDiscovery()">
                                            <i class="bi bi-search"></i> Auto-Discover CNR from eCourts
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                             <label class="form-label d-block fw-bold text-secondary small text-uppercase">Vehicle Type</label>
                             <div class="form-check form-check-inline mt-1">
                                 <input class="form-check-input" type="radio" asp-for="VehicleType" value="Corporation" id="vtCorp">
                                 <label class="form-check-label" for="vtCorp">Corporation (NWKRTC)</label>
                             </div>
                             <div class="form-check form-check-inline mt-1">
                                 <input class="form-check-input" type="radio" asp-for="VehicleType" value="Private" id="vtPrivate">
                                 <label class="form-check-label" for="vtPrivate">Private / Hired / Other</label>
                             </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label d-block fw-bold text-secondary small text-uppercase">Petition filed under</label>
                            <div class="input-group">
                                <select id="PetitionFiledForSelect" class="form-select flex-grow-1 others-dropdown" 
                                        data-others-target="PetitionFiledForManual" 
                                        data-others-hidden="PetitionFiledForHidden" required>
                                    <option value="">-- Choose Section --</option>
                                    <option value="SECTION 163(A)">SECTION 163(A)</option>
                                    <option value="SECTION 164">SECTION 164</option>
                                    <option value="SECTION 166">SECTION 166</option>
                                    <option value="Others">Others</option>
                                </select>
                                <input type="text" id="PetitionFiledForManual" class="form-control others-manual" 
                                       data-others-select="PetitionFiledForSelect"
                                       placeholder="Type custom section" style="display:none; flex-grow: 2;" />
                                <input type="hidden" asp-for="PetitionFiledFor" id="PetitionFiledForHidden" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VehicleNo" class="form-label text-uppercase"></label>
                            <input asp-for="VehicleNo" class="form-control" id="vehicleNoInput" placeholder="KA-XX-F-XXXX" required pattern="^KA-\d{2}-F-\d{4}$" />
                            <span asp-validation-for="VehicleNo" class="text-danger small"></span>
                            <div class="form-text small" id="vehicleHint">Pattern: KA-XX-F-XXXX</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase">Opposite Vehicle Numbers</label>
                            <div id="oppositeVehiclesContainer">
                                @if (Model.OppositeVehicleNumbers != null && Model.OppositeVehicleNumbers.Count > 0)
                                {
                                    for (int i = 0; i < Model.OppositeVehicleNumbers.Count; i++)
                                    {
                                        <div class="input-group mb-2">
                                            <input name="OppositeVehicleNumbers[@i]" value="@Model.OppositeVehicleNumbers[i]" class="form-control op-vehicle-input" placeholder="XX-XX-XX-XXXX" title="Format: XX-XX-XX-XXXX" pattern="^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$" />
                                            @if (i == 0)
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-add-op-vehicle" id="btnAddOppositeVehicle"><i class="bi bi-plus-lg"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-remove-op-vehicle"><i class="bi bi-trash"></i></button>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="input-group mb-2">
                                        <input name="OppositeVehicleNumbers[0]" class="form-control op-vehicle-input" placeholder="XX-XX-XX-XXXX" title="Format: XX-XX-XX-XXXX" pattern="^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$" />
                                        <button type="button" class="btn btn-outline-primary btn-add-op-vehicle" id="btnAddOppositeVehicle"><i class="bi bi-plus-lg"></i></button>
                                    </div>
                                }
                            </div>
                            <div class="form-text small">Optional. Add multiple opposite vehicle numbers. Pattern: XX-XX-XX-XXXX</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AccidentDate" class="form-label text-uppercase"></label>
                            <input asp-for="AccidentDate" class="form-control" type="date" required />
                        </div>
                    </div>
                    <hr class="my-5" />

                    <!-- PART 2: FURTHER CASE DETAILS & LINKAGES -->
                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-collection-fill me-2"></i>2. FURTHER CASE DETAILS & LINKAGES</h6>
                    
                    <div class="mb-4">
                        <!-- Sub-section: Petitioner Details -->
                        <h6 class="fw-bold text-secondary mb-3 small text-uppercase"><i class="bi bi-people-fill me-2"></i>Petitioner Details</h6>
                        <div class="dynamic-table-container mb-4">
                            <table class="table table-sm table-hover mb-0 dynamic-table" id="petitionersTable">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase">Petitioner Name</th>
                                        <th class="text-uppercase">Relationship</th>
                                        <th style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Petitioners.Count; i++)
                                    {
                                        var standardRelationships = new List<string> { "Self", "Father", "Mother", "Son", "Daughter", "Husband", "Wife", "Brother", "Sister", "Father-in-law", "Mother-in-law", "Brother-in-law", "Sister-in-law", "Son-in-law", "Daughter-in-law", "Guardian" };
                                        bool isStandard = string.IsNullOrEmpty(Model.Petitioners[i].Relationship) || standardRelationships.Contains(Model.Petitioners[i].Relationship ?? "");
                                        <tr>
                                            <td><input asp-for="Petitioners[i].PetitionerName" class="form-control form-control-sm" required /></td>
                                            <td>
                                                <select asp-for="Petitioners[i].Relationship" class="form-select form-select-sm petitioner-relationship-select">
                                                    <option value="">-- Select --</option>
                                                    @foreach (var rel in standardRelationships)
                                                    {
                                                        <option value="@rel">@rel</option>
                                                    }
                                                    <option value="Others" selected="@(!isStandard ? "selected" : null)">Others</option>
                                                </select>
                                                <input asp-for="Petitioners[i].RelationshipOthers" 
                                                       class="form-control form-control-sm mt-1 petitioner-relationship-others" 
                                                       placeholder="Type relationship..." 
                                                       style="@(isStandard ? "display:none;" : "")" />
                                            </td>
                                            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="p-2">
                                            <button type="button" class="btn btn-sm btn-link text-decoration-none" id="btnAddPetitioner">
                                                <i class="bi bi-person-plus-fill me-1"></i> Add Petitioner
                                            </button>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <hr class="my-4 border-dashed" />

                        <!-- Sub-section: Nature of Claim -->
                        <h6 class="fw-bold text-secondary mb-3 small text-uppercase"><i class="bi bi-shield-exclamation me-2"></i>Nature of Claim</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ClaimType" class="form-label text-uppercase"></label>
                                <select asp-for="ClaimType" class="form-select" required>
                                    <option value="">-- Choose Type --</option>
                                    <option value="Injury">Injury</option>
                                    <option value="Death">Death</option>
                                    <option value="Property Damage">Property Damage</option>
                                    <option value="Vehicle Damage">Vehicle Damage</option>
                                    <option value="Animal Injured">Animal Injured</option>
                                    <option value="Animal death">Animal death</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AdverseAward.ClaimPetitionDate" class="form-label text-uppercase">Date of Claim Petition</label>
                                <input asp-for="AdverseAward.ClaimPetitionDate" class="form-control" type="date" />
                                <input type="hidden" asp-for="ClaimPetitionDate" id="ClaimPetitionDateHidden" />
                            </div>
                        </div>

                        <hr class="my-4 border-dashed" />

                        <!-- Sub-section: Accident & Additional Details -->
                        <h6 class="fw-bold text-secondary mb-3 small text-uppercase"><i class="bi bi-info-square me-2"></i>Accident & Additional Details</h6>
                        <div class="row g-4 mb-4">
                            <!-- Row: ST Passenger -->
                            <div class="col-md-4">
                                <label class="form-label d-block fw-bold text-uppercase">Whether deceased/injured was passenger in ST bus?</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="true" asp-for="IsSTPassenger" id="isSTPassengerYes">
                                    <label class="form-check-label" for="isSTPassengerYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="false" asp-for="IsSTPassenger" id="isSTPassengerNo">
                                    <label class="form-check-label" for="isSTPassengerNo">No</label>
                                </div>
                            </div>

                            <!-- Row: Medical Expenses -->
                            <div class="col-md-4">
                                <label class="form-label d-block fw-bold text-uppercase">Medical expenses paid?</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="true" asp-for="IsMedicalExpensesPaid" id="isMedicalPaidYes">
                                    <label class="form-check-label" for="isMedicalPaidYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="false" asp-for="IsMedicalExpensesPaid" id="isMedicalPaidNo">
                                    <label class="form-check-label" for="isMedicalPaidNo">No</label>
                                </div>
                            </div>
                            <div class="col-md-4 medicalDetails" style="display:none;">
                                <label asp-for="MedicalPaidAmount" class="form-label fw-bold text-uppercase">Medical Amount Paid</label>
                                <input asp-for="MedicalPaidAmount" class="form-control" type="number" step="0.01" />
                            </div>

                            <!-- Row: ARF -->
                            <div class="col-md-4">
                                <label class="form-label d-block fw-bold text-uppercase">ARF amount paid?</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="true" asp-for="IsARFAmountPaid" id="isARFPaidYes">
                                    <label class="form-check-label" for="isARFPaidYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="false" asp-for="IsARFAmountPaid" id="isARFPaidNo">
                                    <label class="form-check-label" for="isARFPaidNo">No</label>
                                </div>
                            </div>
                            <div class="col-md-4 arfDetails" style="display:none;">
                                <label asp-for="ARFPaidAmount" class="form-label fw-bold text-uppercase">ARF Total Amount Paid</label>
                                <input asp-for="ARFPaidAmount" class="form-control" type="number" step="0.01" />
                            </div>
                            <!-- Inmate/Pillion Rider -->
                            <div class="col-md-12">
                                <label class="form-label d-block fw-bold text-uppercase">Whether the claimant / deceased was a pillion rider or inmate of the opposite vehicle?</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="true" asp-for="IsOppositeVehicleInmate" id="isInmateYes">
                                    <label class="form-check-label" for="isInmateYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="false" asp-for="IsOppositeVehicleInmate" id="isInmateNo">
                                    <label class="form-check-label" for="isInmateNo">No</label>
                                </div>
                            </div>

                            <!-- ST Bus Insurance -->
                            <div class="col-md-4">
                                <label class="form-label d-block small fw-bold text-uppercase">Is ST Vehicle Insured</label>
                                <div class="d-flex gap-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsBusInsured" id="isBusInsuredYes">
                                        <label class="form-check-label" for="isBusInsuredYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsBusInsured" id="isBusInsuredNo">
                                        <label class="form-check-label" for="isBusInsuredNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8" id="busInsuranceDetailsCol" style="display:none;">
                                <label asp-for="AdverseAward.BusInsuranceDetails" class="form-label small fw-bold text-uppercase">ST Vehicle Insurance Details</label>
                                <input asp-for="AdverseAward.BusInsuranceDetails" class="form-control" placeholder="Policy No / Insurance Company" />
                            </div>

                            <!-- Impleading Section (Conditional) -->
                            <div id="impleadingSection" class="col-md-12 mt-2" style="display:none;">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label d-block fw-bold text-uppercase">Impleading Filed?</label>
                                        <div class="form-check form-check-inline">
                                             <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsImpleadingAppFiled" id="impleadYes">
                                             <label class="form-check-label" for="impleadYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                             <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsImpleadingAppFiled" id="impleadNo">
                                             <label class="form-check-label" for="impleadNo">No</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8" id="impleadReasonCol" style="display:none;">
                                        <label asp-for="AdverseAward.ImpleadingAppNotFiledReason" class="form-label fw-bold text-uppercase">Reason for not filing</label>
                                        <input asp-for="AdverseAward.ImpleadingAppNotFiledReason" class="form-control" placeholder="Provide reason..." />
                                    </div>
                                </div>
                            </div>

                            <!-- Alleged Accident -->
                            <div class="col-md-12">
                                <label class="form-label d-block fw-bold text-uppercase">Alleged Accident</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsAllegedAccident" id="isAllegedYes">
                                    <label class="form-check-label" for="isAllegedYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsAllegedAccident" id="isAllegedNo">
                                    <label class="form-check-label" for="isAllegedNo">No</label>
                                </div>
                            </div>

                            <!-- Security Investigation -->
                            <div class="col-md-6" id="securityQuestionCol" style="@(Model.AdverseAward.IsAllegedAccident == true ? "" : "display:none;")">
                                <label class="form-label d-block fw-bold text-uppercase">Security Investigation Conducted?</label>
                                <div class="d-flex gap-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.SecurityRequired" id="securityYes">
                                        <label class="form-check-label" for="securityYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.SecurityRequired" id="securityNo">
                                        <label class="form-check-label" for="securityNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" id="securityReportCol" style="@(Model.AdverseAward.IsAllegedAccident == true && Model.AdverseAward.SecurityRequired == true ? "" : "display:none;")">
                                <label for="SecurityDocFile" class="form-label fw-bold text-uppercase">Investigation Report</label>
                                <input asp-for="AdverseAward.SecurityDocFile" type="file" id="SecurityDocFile" class="form-control" />
                                @if (!string.IsNullOrEmpty(Model.AdverseAward.SecurityUploadPath))
                                {
                                    <a href="@Model.AdverseAward.SecurityUploadPath" target="_blank" class="small text-decoration-none ms-1 mt-1 d-inline-block"><i class="bi bi-file-earmark-pdf text-danger"></i> View Existing Report</a>
                                }
                            </div>

                            <!-- Manner of Accident -->
                            <div class="col-md-12">
                                <label asp-for="AdverseAward.MannerOfAccident" class="form-label fw-bold text-uppercase">Manner of Accident (Claim/Award)</label>
                                <textarea asp-for="AdverseAward.MannerOfAccident" class="form-control" rows="3" placeholder="Description as per claim petition or award..."></textarea>
                            </div>
                        </div>

                        <hr class="my-4 border-dashed" />

                        <!-- Sub-section: Financial & Advocate Details -->
                        <h6 class="fw-bold text-secondary mb-3 small text-uppercase"><i class="bi bi-person-lines-fill me-2"></i>Financial & Advocate Details</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ClaimAmount" class="form-label text-uppercase"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="ClaimAmount" class="form-control" type="number" placeholder="0.00" />
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="AdvocateName" class="form-label text-uppercase"></label>
                                <div class="input-group">
                                    <select id="AdvocateSelect" class="form-select flex-grow-1 others-dropdown" 
                                            data-others-target="AdvocateManualEntry" 
                                            data-others-hidden="AdvocateNameHidden">
                                        <option value="">-- Loading Advocates... --</option>
                                    </select>
                                    <input type="text" id="AdvocateManualEntry" class="form-control others-manual" 
                                           data-others-select="AdvocateSelect"
                                           placeholder="Type Advocate Name" style="display:none; flex-grow: 2;" />
                                    <input type="hidden" asp-for="AdvocateName" id="AdvocateNameHidden" />
                                </div>
                                <span asp-validation-for="AdvocateName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EntrustmentNo" class="form-label text-uppercase"></label>
                                <input asp-for="EntrustmentNo" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EntrustmentDate" class="form-label text-uppercase"></label>
                                <input asp-for="EntrustmentDate" class="form-control" type="date" required />
                            </div>
                        </div>

                        <hr class="my-4 border-dashed" />

                        <!-- Sub-section: Case Linkages -->
                        <h6 class="fw-bold text-secondary mb-3 small text-uppercase"><i class="bi bi-link-45deg me-2"></i>Case Linkages</h6>
                        <div class="dynamic-table-container">
                            <table class="table table-sm table-hover mb-0 dynamic-table" id="connectedCasesTable">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase">Connected MVC No</th>
                                        <th class="text-uppercase">Year</th>
                                        <th class="text-uppercase">MACT</th>
                                        <th class="text-uppercase">Double Claim?</th>
                                        <th class="text-uppercase">Current Stage</th>
                                        <th style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ConnectedCases.Count; i++)
                                    {
                                        <tr>
                                            <td><input asp-for="ConnectedCases[i].ConnectedMVCNo" class="form-control form-control-sm" required /></td>
                                            <td><input asp-for="ConnectedCases[i].ConnectedYear" type="number" class="form-control form-control-sm" required /></td>
                                            <td><input asp-for="ConnectedCases[i].MACT" class="form-control form-control-sm" /></td>
                                            <td class="text-center">
                                                <input class="form-check-input" type="checkbox" asp-for="ConnectedCases[i].IsDoubleClaim" />
                                            </td>
                                            <td><input asp-for="ConnectedCases[i].CurrentStage" class="form-control form-control-sm" /></td>
                                            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <hr class="my-4 border-dashed" />

                        <!-- Sub-section: Limitation & Delay Details -->
                        <h6 class="fw-bold text-secondary mb-3 small text-uppercase"><i class="bi bi-calendar-check me-2"></i>Limitation & Delay Details</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-uppercase">Whether the claim petition is filed within the time period of limitation?</label>
                                <div class="d-flex gap-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" value="true" asp-for="IsWithinLimitation" id="limitationYes">
                                        <label class="form-check-label" for="limitationYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" value="false" asp-for="IsWithinLimitation" id="limitationNo">
                                        <label class="form-check-label" for="limitationNo">No</label>
                                    </div>
                                </div>
                                <input asp-for="LimitationRemark" class="form-control form-control-sm" placeholder="Limitation Remark" />
                            </div>

                            <!-- IA Form Section -->
                            <div class="col-md-12 limitationAdverseDetails" style="display:none;">
                                <div class="p-3 border rounded bg-light">
                                    <p class="small fw-bold text-danger mb-2">Claim petition is barred by limitation. Provide IA details:</p>
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-uppercase">IA for Condonation filed?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsDelayApplicationFiled" id="iaFiledYes">
                                                    <label class="form-check-label" for="iaFiledYes">Yes</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsDelayApplicationFiled" id="iaFiledNo">
                                                    <label class="form-check-label" for="iaFiledNo">No</label>
                                                </div>
                                            </div>
                                            <div id="iaUploadDiv" style="display:none;" class="mt-3">
                                                <label class="form-label small fw-bold text-uppercase">Upload IA Copy</label>
                                                <input asp-for="AdverseAward.IAFile" type="file" class="form-control form-control-sm" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-uppercase">Is delay condoned?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsDelayCondonedAdverse" id="delayCondonedYesAdverse">
                                                    <label class="form-check-label" for="delayCondonedYesAdverse">Yes</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsDelayCondonedAdverse" id="delayCondonedNoAdverse">
                                                    <label class="form-check-label" for="delayCondonedNoAdverse">No</label>
                                                </div>
                                            </div>
                                            <div id="delayCCUploadDiv" style="display:none;" class="mt-3">
                                                <label class="form-label small fw-bold text-uppercase">Upload Order Sheet CC</label>
                                                <input asp-for="AdverseAward.DelayOrderFile" type="file" class="form-control form-control-sm" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5" />

                    <!-- PART 3: CASE PROGRESS -->
                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-graph-up-arrow me-2"></i>3. CASE PROGRESS</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="NextHearingDate" class="form-label text-uppercase"></label>
                            <input asp-for="NextHearingDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CurrentStage" class="form-label text-uppercase"></label>
                            <input asp-for="CurrentStage" class="form-control" placeholder="e.g. Evidence / Arguments" />
                        </div>

                        <!-- Document Sent -->
                        <div class="col-md-4">
                            <label class="form-label d-block fw-bold text-uppercase">Document Sent?</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" value="true" asp-for="IsDocumentSent" id="isDocSentYes">
                                <label class="form-check-label" for="isDocSentYes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" value="false" asp-for="IsDocumentSent" id="isDocSentNo">
                                <label class="form-check-label" for="isDocSentNo">No</label>
                            </div>
                        </div>
                        <div class="col-md-8" id="documentDetails" style="@(Model.IsDocumentSent ? "" : "display:none;")">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label asp-for="DocumentOutwardNo" class="form-label text-uppercase">Document Outward No</label>
                                    <input asp-for="DocumentOutwardNo" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DocumentOutwardDate" class="form-label text-uppercase">Document Outward Date</label>
                                    <input asp-for="DocumentOutwardDate" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>

                        <!-- Objection Filed -->
                        <div class="col-md-4">
                            <label class="form-label d-block fw-bold text-uppercase">Objection verified & sent?</label>
                            <div class="form-check form-check-inline">
                                 <input class="form-check-input" type="radio" value="true" asp-for="IsObjectionFiled" id="isObjFiledYes">
                                 <label class="form-check-label" for="isObjFiledYes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                 <input class="form-check-input" type="radio" value="false" asp-for="IsObjectionFiled" id="isObjFiledNo">
                                 <label class="form-check-label" for="isObjFiledNo">No</label>
                            </div>
                        </div>
                        <div class="col-md-8" id="objectionDateDiv" style="@(Model.IsObjectionFiled ? "" : "display:none;")">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="ObjectionOutwardNo" class="form-label fw-bold text-uppercase">Objection Outward Number</label>
                                    <input asp-for="ObjectionOutwardNo" class="form-control" placeholder="Enter Outward No." />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ObjectionFiledDate" class="form-label fw-bold text-uppercase">Objection Filed Date</label>
                                    <input asp-for="ObjectionFiledDate" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>

                        <!-- Evidence Filed -->
                        <div class="col-md-4">
                            <label class="form-label d-block fw-bold text-uppercase">Evidence Filed?</label>
                            <div class="form-check form-check-inline">
                                 <input class="form-check-input" type="radio" value="true" asp-for="IsEvidenceFiled" id="isEvidFiledYes">
                                 <label class="form-check-label" for="isEvidFiledYes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                 <input class="form-check-input" type="radio" value="false" asp-for="IsEvidenceFiled" id="isEvidFiledNo">
                                 <label class="form-check-label" for="isEvidFiledNo">No</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5" />

                    <!-- PART 4: DISPOSAL STATUS -->
                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-shield-lock-fill me-2"></i>4. DISPOSAL STATUS</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DisposalStatus" class="form-label text-uppercase">Disposal Status</label>
                            <select asp-for="DisposalStatus" class="form-select" id="disposalStatusSelect">
                                <option value="">-- Choose Status --</option>
                                <option value="Pending">Pending</option>
                                <option value="Disposed">Disposed</option>
                                <option value="DNP">DNP</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="disposalResultCol" style="@(Model.DisposalStatus == "Disposed" ? "" : "display:none;")">
                            <label asp-for="DisposalResult" class="form-label text-uppercase">Disposal Result</label>
                            <select asp-for="DisposalResult" class="form-select" id="disposalResultSelect">
                                <option value="">-- Choose Result --</option>
                                <option value="Favor">Favor</option>
                                <option value="Against">Against</option>
                                <option value="Settled">Settled</option>
                                <option value="Dismissed">Dismissed</option>
                            </select>
                        </div>
                        <div class="col-md-12" id="remarksContainer" style="@(Model.DisposalStatus == "Disposed" && (Model.DisposalResult == "Favor" || Model.DisposalResult == "Settled" || Model.DisposalResult == "Dismissed") ? "" : "display: none;")">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label asp-for="DisposalRemarks" class="form-label text-uppercase"></label>
                                    <textarea asp-for="DisposalRemarks" class="form-control" rows="2" placeholder="Provide disposal remarks / details..."></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ClosureDate" class="form-label fw-bold text-uppercase">Closure Date</label>
                                    <input asp-for="ClosureDate" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden fields to preserve existing adverse files if not re-uploaded -->
                    <input type="hidden" asp-for="AdverseAward.TR18UploadPath" />
                    <input type="hidden" asp-for="AdverseAward.PunishmentOrderUploadPath" />
                    <input type="hidden" asp-for="AdverseAward.SecurityUploadPath" />
                    <input type="hidden" asp-for="AdverseAward.GovIDProofUploadPath" />
                    <input type="hidden" asp-for="AdverseAward.AdverseJudgmentUploadPath" />
                    <input type="hidden" asp-for="AdverseAward.DelayApplicationPath" />
                    <input type="hidden" asp-for="AdverseAward.DelayCondonedOrderPath" />
                    <input type="hidden" asp-for="AdverseAward.AgeProofUploadPath" />

                    <!-- ADVERSE AWARD WORKFLOW -->
                    <div id="adverseWorkflowContainer" style="@(Model.DisposalResult == "Against" ? "" : "display: none;")">
                        <!-- Section Header Banner -->
                        <div class="adverse-header-banner p-4 mb-4 d-flex align-items-center text-white rounded-3" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                            <div class="icon-circle bg-white bg-opacity-25 p-3 rounded-circle me-3">
                                <i class="bi bi-shield-lock-fill fs-3"></i>
                            </div>
                            <div>
                                <h4 class="mb-1 fw-bold text-uppercase tracking-wider">Adverse Award Workflow</h4>
                                <p class="mb-0 opacity-75 small"><i class="bi bi-info-circle me-1"></i> Post-disposal procedures & corporation liability assessment</p>
                            </div>
                            <div class="ms-auto death-only" style="display:none;">
                                <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-exclamation-octagon me-1"></i> HIGH PRIORITY: DEATH CASE</span>
                            </div>
                        </div>

                        <!-- B. WORK AFTER DISPOSAL -->
                        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-wrench-adjustable me-2"></i>B. WORK AFTER DISPOSAL</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4 mb-4">
                                    <div class="col-md-4">
                                        <label asp-for="AdverseAward.AwardDate" class="form-label small fw-bold text-uppercase">Date of Award</label>
                                        <input asp-for="AdverseAward.AwardDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label d-block small fw-bold text-uppercase">FIR Filed Against ST Driver?</label>
                                        <div class="d-flex gap-4 mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsFIRFiled" id="firYes">
                                                <label class="form-check-label" for="firYes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsFIRFiled" id="firNo">
                                                <label class="form-check-label" for="firNo">No</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label d-block small fw-bold text-uppercase">Chargesheet Filed Against ST Driver?</label>
                                        <div class="d-flex gap-4 mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsChargeSheetFiled" id="chargeSheetYes">
                                                <label class="form-check-label" for="chargeSheetYes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsChargeSheetFiled" id="chargeSheetNo">
                                                <label class="form-check-label" for="chargeSheetNo">No</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4 mt-2">
                                    <div class="col-md-4">
                                        <label class="form-label d-block small fw-bold text-uppercase">Objection Filed?</label>
                                        <div class="d-flex gap-4 mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.ObjectionFiled" id="objYes">
                                                <label class="form-check-label" for="objYes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.ObjectionFiled" id="objNo">
                                                <label class="form-check-label" for="objNo">No</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8" id="objRemarksCol" style="@(Model.AdverseAward?.ObjectionFiled == false ? "" : "display:none;")">
                                        <label asp-for="AdverseAward.ObjectionRemarks" class="form-label small fw-bold text-uppercase">Objection Remarks</label>
                                        <input asp-for="AdverseAward.ObjectionRemarks" class="form-control" placeholder="Provide remarks if objection not filed" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- C. EVIDENCE DETAILS -->
                        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-shield-check me-2"></i>C. EVIDENCE DETAILS</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3 mb-4">
                                    <!-- 1. Petitioner Evidence -->
                                    <div class="col-md-12">
                                        <h6 class="small fw-bold text-secondary text-uppercase mb-2">1. Petitioner Evidence</h6>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label d-block small fw-bold text-uppercase">PW Name(s)</label>
                                        <div id="pwList">
                                            @for (int i = 0; i < (Model.AdverseAward?.PetitionerPWNames?.Count ?? 0); i++)
                                            {
                                                <div class="input-group input-group-sm mb-2">
                                                    <input name="AdverseAward.PetitionerPWNames[@i]" value="@Model.AdverseAward.PetitionerPWNames[i]" class="form-control" placeholder="Enter Name" required />
                                                    <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
                                                </div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addDynamicInput('pwList', 'AdverseAward.PetitionerPWNames')">
                                            <i class="bi bi-plus"></i> Add PW
                                        </button>
                                    </div>

                                    <!-- 2. Medical Evidence -->
                                    <div class="col-md-12">
                                        <h6 class="small fw-bold text-secondary text-uppercase mb-2">2. Medical Evidence</h6>
                                    </div>
                                    <div class="col-md-8 mb-3">
                                        <label class="form-label d-block small fw-bold text-uppercase">Doctor PW name and treatment status</label>
                                        <div id="docList">
                                            @for (int i = 0; i < (Model.AdverseAward?.Doctors?.Count ?? 0); i++)
                                            {
                                                <div class="border p-2 mb-2 rounded bg-light">
                                                    <div class="row g-2 align-items-center">
                                                        <div class="col-md-6">
                                                            <input name="AdverseAward.Doctors[@i].DoctorName" value="@Model.AdverseAward.Doctors[i].DoctorName" class="form-control form-control-sm" placeholder="Doctor Name" required />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="d-flex gap-2">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="radio" name="AdverseAward.Doctors[@i].IsTreated" value="true" id="treatedYes_@i" @(Model.AdverseAward.Doctors[i].IsTreated ? "checked" : "")>
                                                                    <label class="form-check-label small" for="treatedYes_@i">Yes</label>
                                                                </div>
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="radio" name="AdverseAward.Doctors[@i].IsTreated" value="false" id="treatedNo_@i" @(!Model.AdverseAward.Doctors[i].IsTreated ? "checked" : "")>
                                                                    <label class="form-check-label small" for="treatedNo_@i">No</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2 text-end">
                                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.border').remove()"><i class="bi bi-x"></i></button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addDoctorInput()">
                                            <i class="bi bi-plus"></i> Add Doctor
                                        </button>
                                    </div>

                                    <!-- 3. Corporation Evidence -->
                                    <div class="col-md-12">
                                        <h6 class="small fw-bold text-secondary text-uppercase mb-2">3. Corporation Evidence</h6>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="AdverseAward.RWType" class="form-label d-block small fw-bold text-uppercase">RW Type</label>
                                        <select asp-for="AdverseAward.RWType" id="rwTypeSelect" class="form-select mb-2">
                                            <option value="">-- Choose Type --</option>
                                            <option value="Driver">Driver</option>
                                            <option value="Conductor">Conductor</option>
                                            <option value="DcumC">DcumC</option>
                                            <option value="Others">Others</option>
                                        </select>
                                        <div id="rwList">
                                            @for (int i = 0; i < (Model.AdverseAward?.RWNames?.Count ?? 0); i++)
                                            {
                                                <div class="input-group input-group-sm mb-2">
                                                    <input name="AdverseAward.RWNames[@i]" value="@Model.AdverseAward.RWNames[i]" class="form-control" placeholder="Name" required />
                                                    <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
                                                </div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addRWInput()">
                                            <i class="bi bi-plus"></i> Add RW Name
                                        </button>
                                    </div>

                                    <!-- 4. Internal Remarks & TR18 -->
                                    <div class="col-md-12">
                                        <h6 class="small fw-bold text-secondary text-uppercase mb-2">4. Internal Remarks</h6>
                                    </div>
                                    <div class="col-md-8">
                                        <label asp-for="AdverseAward.TR18Remarks" class="form-label d-block small fw-bold text-uppercase"></label>
                                        <textarea asp-for="AdverseAward.TR18Remarks" class="form-control form-control-sm mb-2" rows="2"></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="TR18File" class="form-label d-block small fw-bold text-uppercase">Upload TR-18 Document</label>
                                        <input asp-for="AdverseAward.TR18File" type="file" id="TR18File" class="form-control form-control-sm" />
                                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.TR18UploadPath))
                                        {
                                            <div class="mt-1">
                                                <a href="@Model.AdverseAward.TR18UploadPath" target="_blank" class="small text-decoration-none text-primary">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> View Existing TR-18
                                                </a>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="AdverseAward.MannerOfAccidentRO" class="form-label d-block small fw-bold text-uppercase">Manner of Accident (Departmental RO Report)</label>
                                        <textarea asp-for="AdverseAward.MannerOfAccidentRO" class="form-control form-control-sm mb-2" rows="2" placeholder="Description as per RO's report..."></textarea>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label d-block small fw-bold text-uppercase">Whether names of deceased/injured are found in TR-18?</label>
                                        <div class="d-flex gap-3 mt-1">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsDeceasedInTR18" id="deceasedTR18Yes">
                                                <label class="form-check-label small" for="deceasedTR18Yes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsDeceasedInTR18" id="deceasedTR18No">
                                                <label class="form-check-label small" for="deceasedTR18No">No</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label d-block small fw-bold text-uppercase">Whether petitioner claimed Medical Insurance</label>
                                        <div class="d-flex gap-3 mt-1">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsMedicalInsuranceClaimed" id="medInsYes">
                                                <label class="form-check-label small" for="medInsYes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsMedicalInsuranceClaimed" id="medInsNo">
                                                <label class="form-check-label small" for="medInsNo">No</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="AdverseAward.InterimCompAmount" class="form-label d-block small fw-bold text-uppercase">Interim Comp. Amount</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light text-muted">₹</span>
                                            <input asp-for="AdverseAward.InterimCompAmount" class="form-control" type="number" step="0.01" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <span class="form-label d-block small fw-bold text-uppercase">Interim Compensation deducted?</span>
                                        <div class="d-flex gap-3 mt-1">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.InterimCompDeducted" id="interimCompYes">
                                                <label class="form-check-label small" for="interimCompYes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.InterimCompDeducted" id="interimCompNo">
                                                <label class="form-check-label small" for="interimCompNo">No</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="punishmentStatusSelect" class="form-label small fw-bold text-uppercase">Driver Punishment Status</label>
                                        <select asp-for="AdverseAward.DriverPunishmentStatus" class="form-select border-primary-subtle" id="punishmentStatusSelect">
                                            <option value="">-- SELECT STATUS --</option>
                                            <option value="Pending">PENDING</option>
                                            <option value="No Action">NO ACTION TAKEN</option>
                                            <option value="Order Issued">ORDER ISSUED / PUNISHMENT IMPOSED</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3 mb-3 punishment-details" style="@(Model.AdverseAward?.DriverPunishmentStatus == "Order Issued" ? "" : "display:none;")">
                                        <label for="PunishmentOrderFile" class="form-label small fw-bold text-uppercase">Punishment Order</label>
                                        <input asp-for="AdverseAward.PunishmentOrderFile" id="PunishmentOrderFile" type="file" class="form-control" />
                                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.PunishmentOrderUploadPath))
                                        {
                                            <div class="mt-1">
                                                <a href="@Model.AdverseAward.PunishmentOrderUploadPath" target="_blank" class="small text-decoration-none text-primary">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> View Existing Punishment Order
                                                </a>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-3 mb-3 punishment-details" style="@(Model.AdverseAward?.DriverPunishmentStatus == "Order Issued" ? "" : "display:none;")">
                                        <label asp-for="AdverseAward.PunishmentRemarks" class="form-label small fw-bold text-uppercase">Punishment Remarks</label>
                                        <input asp-for="AdverseAward.PunishmentRemarks" class="form-control" placeholder="REMARKS..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- D. MULTIMEDIA & CONNECTED CASE DETAILS -->
                        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-stack me-2"></i>D. MULTIMEDIA & CONNECTED CASE DETAILS</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    <h6 class="small fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-camera-video me-2"></i>5. Additional Evidence & Reports</h6>
                                    <div class="row g-4">
                                        <div class="col-md-3">
                                            <label class="form-label d-block small fw-bold text-uppercase">Bus Camera Installed?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsBusCameraInstalled" id="busCamYes">
                                                    <label class="form-check-label" for="busCamYes">Yes</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsBusCameraInstalled" id="busCamNo">
                                                    <label class="form-check-label" for="busCamNo">No</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3" id="camFootageQuestionCol" style="@(Model.AdverseAward?.IsBusCameraInstalled == true ? "" : "display:none;")">
                                            <label class="form-label d-block small fw-bold text-uppercase">Footage Produced?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsCameraFootageProduced" id="camFootageYes">
                                                    <label class="form-check-label" for="camFootageYes">Yes</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsCameraFootageProduced" id="camFootageNo">
                                                    <label class="form-check-label" for="camFootageNo">No</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label d-block small fw-bold text-uppercase">Photography/Video produced?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsPhotographProduced" id="photoYes">
                                                    <label class="form-check-label" for="photoYes">Yes</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsPhotographProduced" id="photoNo">
                                                    <label class="form-check-label" for="photoNo">No</label>
                                                </div>
                                            </div>
                                            <div id="photoReasonCol" style="@(Model.AdverseAward?.IsPhotographProduced == false ? "" : "display:none;")" class="mt-2">
                                                <input asp-for="AdverseAward.PhotographNotProducedReason" class="form-control form-control-sm" placeholder="REASON FOR NO PHOTO..." />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label d-block small fw-bold text-uppercase">Police Sketch Enclosed?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsPoliceSketchEnclosed" id="policeSketchYes">
                                                    <label class="form-check-label" for="policeSketchYes">Yes</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsPoliceSketchEnclosed" id="policeSketchNo">
                                                    <label class="form-check-label" for="policeSketchNo">No</label>
                                                </div>
                                            </div>
                                            <div id="policeSketchExhibitCol" style="@(Model.AdverseAward?.IsPoliceSketchEnclosed == true ? "" : "display:none;")" class="mt-2">
                                                <input asp-for="AdverseAward.PoliceSketchExhibitNo" class="form-control form-control-sm" placeholder="EXHIBIT NO..." />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Connected MVC Cases (Adverse) -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="small fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-link-45deg me-2"></i>Connected MVC Cases (Adverse Details)</h6>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDynamicConnectedCase()">
                                            <i class="bi bi-plus"></i> Add Connected Case
                                        </button>
                                    </div>
                                    <div class="border rounded-3 overflow-hidden">
                                        <table class="table table-sm table-hover mb-0" id="adverseConnTable">
                                            <thead class="bg-light">
                                                <tr class="small text-uppercase">
                                                    <th class="ps-3 py-2">Connected MVC No</th>
                                                    <th class="py-2">Year</th>
                                                    <th class="py-2">MACT Name</th>
                                                    <th class="py-2">Status</th>
                                                    <th class="pe-3 py-2 text-center">Judgement Details</th>
                                                    <th style="width: 50px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < (Model.AdverseAward?.ConnectedCases?.Count ?? 0); i++)
                                                {
                                                    <tr>
                                                        <td><input name="AdverseAward.ConnectedCases[@i].ConnectedMVCNo" value="@Model.AdverseAward.ConnectedCases[i].ConnectedMVCNo" class="form-control form-control-sm" required /></td>
                                                        <td><input name="AdverseAward.ConnectedCases[@i].ConnectedYear" value="@Model.AdverseAward.ConnectedCases[i].ConnectedYear" type="number" class="form-control form-control-sm" required /></td>
                                                        <td><input name="AdverseAward.ConnectedCases[@i].MACT" value="@Model.AdverseAward.ConnectedCases[i].MACT" class="form-control form-control-sm" required /></td>
                                                        <td><input name="AdverseAward.ConnectedCases[@i].Status" value="@Model.AdverseAward.ConnectedCases[i].Status" class="form-control form-control-sm" /></td>
                                                        <td class="text-center">
                                                             <div class="form-check form-switch d-flex justify-content-center">
                                                                <input class="form-check-input btn-toggle-details" type="checkbox" role="switch" data-target="#advDetailsRow_@i">
                                                            </div>
                                                        </td>
                                                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row" onclick="$(this).closest('tr').next('.table-active').remove(); $(this).closest('tr').remove();"><i class="bi bi-trash"></i></button></td>
                                                    </tr>
                                                    <tr id="advDetailsRow_@i" class="table-active" style="display:none;">
                                                        <td colspan="6">
                                                            <div class="p-3 border rounded bg-light">
                                                                <h6 class="small fw-bold text-primary mb-3">Award Details for Connected Case (Adverse)</h6>
                                                                <div class="row g-3">
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">Award Amount</label>
                                                                        <input type="number" name="AdverseAward.ConnectedCases[@i].AwardDetails.AwardAmount" value="@Model.AdverseAward.ConnectedCases[i].AwardDetails?.AwardAmount" class="form-control form-control-sm" step="0.01" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">Interest %</label>
                                                                        <input type="number" name="AdverseAward.ConnectedCases[@i].AwardDetails.InterestRate" value="@Model.AdverseAward.ConnectedCases[i].AwardDetails?.InterestRate" class="form-control form-control-sm" step="0.01" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">Victim Age</label>
                                                                        <input type="number" name="AdverseAward.ConnectedCases[@i].AwardDetails.VictimAge" value="@Model.AdverseAward.ConnectedCases[i].AwardDetails?.VictimAge" class="form-control form-control-sm" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">Occupation</label>
                                                                        <input type="text" name="AdverseAward.ConnectedCases[@i].AwardDetails.Occupation" value="@Model.AdverseAward.ConnectedCases[i].AwardDetails?.Occupation" class="form-control form-control-sm" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">Income</label>
                                                                        <input type="number" name="AdverseAward.ConnectedCases[@i].AwardDetails.IncomeConsidered" value="@Model.AdverseAward.ConnectedCases[i].AwardDetails?.IncomeConsidered" class="form-control form-control-sm" step="0.01" />
                                                                    </div>
                                                                    <div class="col-md-9">
                                                                         <label class="form-label small">Injury Details / Remarks</label>
                                                                         <textarea name="AdverseAward.ConnectedCases[@i].AwardDetails.InjuryDetails" class="form-control form-control-sm" rows="1">@Model.AdverseAward.ConnectedCases[i].AwardDetails?.InjuryDetails</textarea>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Section 3: Execution Petition (EP) Details -->
                                    <div class="pt-4 border-top mt-4">
                                        <div class="row g-4 mb-4">
                                            <div class="col-md-12">
                                                <div class="p-2 px-3 bg-light rounded-3 border border-light-subtle d-inline-block">
                                                    <span class="form-label d-block small fw-bold text-uppercase text-secondary mb-1">Whether EP filed?</span>
                                                    <div class="d-flex gap-4">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsEPFiled" id="epFiledYes">
                                                            <label class="form-check-label fw-bold" for="epFiledYes">YES</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsEPFiled" id="epFiledNo">
                                                            <label class="form-check-label fw-bold" for="epFiledNo">NO</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="p-4 bg-light rounded-4 border border-dashed border-primary border-opacity-25 mb-4" id="epDetailsRow" style="@(Model.AdverseAward?.IsEPFiled == true ? "" : "display:none;")">
                                            <div class="row g-4 mb-4">
                                                <div class="col-md-6">
                                                    <label asp-for="AdverseAward.EPNumber" class="form-label small fw-bold text-uppercase">EP Number</label>
                                                    <input asp-for="AdverseAward.EPNumber" class="form-control border-primary-subtle" placeholder="EP NO..." />
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="AdverseAward.EPStage" class="form-label small fw-bold text-uppercase">Current Stage of EP</label>
                                                    <input asp-for="AdverseAward.EPStage" class="form-control border-primary-subtle" placeholder="CURRENT STAGE..." />
                                                </div>
                                            </div>

                                            <div class="row g-4 align-items-center">
                                                <div class="col-md-8">
                                                    <span class="form-label d-block small fw-bold text-uppercase text-primary mb-2">EP / ATTACHMENT WARRANT STATUS</span>
                                                    <p class="small text-muted mb-3">Whether any amount is deposited in view of EP / attachment warrant?</p>
                                                    <div class="d-flex gap-4">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsAmountDepositedInEP" id="epAmountYes">
                                                            <label class="form-check-label fw-bold text-success" for="epAmountYes"><i class="bi bi-check-circle me-1"></i>YES, AMOUNT DEPOSITED</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsAmountDepositedInEP" id="epAmountNo">
                                                            <label class="form-check-label fw-bold text-danger" for="epAmountNo"><i class="bi bi-x-circle me-1"></i>NO, NOT DEPOSITED</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4" id="epAmountValCol" style="@(Model.AdverseAward?.IsAmountDepositedInEP == true ? "" : "display:none;")">
                                                    <div class="bg-white p-3 rounded-3 shadow-sm border border-success border-opacity-25">
                                                        <label asp-for="AdverseAward.EPDepositedAmount" class="form-label small fw-bold text-uppercase">Deposited Amount</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-success-subtle border-success-subtle text-success">₹</span>
                                                            <input asp-for="AdverseAward.EPDepositedAmount" class="form-control border-success-subtle fw-bold" type="number" step="0.01" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- E. CERTIFIED COPY DETAILS -->
                        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-file-earmark-text me-2"></i>E. CERTIFIED COPY DETAILS</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4 mb-4">
                                    <div class="col-md-3">
                                        <label asp-for="AdverseAward.DisposedOnDate" class="form-label small fw-bold text-uppercase">Copy Disposed On</label>
                                        <input asp-for="AdverseAward.DisposedOnDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AdverseAward.CopyAppliedDate" class="form-label small fw-bold text-uppercase">Copy Applied On</label>
                                        <input asp-for="AdverseAward.CopyAppliedDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AdverseAward.CopyIssuedDate" class="form-label small fw-bold text-uppercase">Copy Ready On</label>
                                        <input asp-for="AdverseAward.CopyIssuedDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AdverseAward.CopyDeliveredDate" class="form-label small fw-bold text-uppercase">Copy Delivered On</label>
                                        <input asp-for="AdverseAward.CopyDeliveredDate" class="form-control" type="date" />
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-3">
                                        <label asp-for="AdverseAward.CopyReceivedDate" class="form-label small fw-bold text-uppercase">Copy Received At Division</label>
                                        <input asp-for="AdverseAward.CopyReceivedDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-9">
                                        <label asp-for="AdverseAward.CertifiedCopyRemarks" class="form-label small fw-bold text-uppercase">Certified Copy Remarks</label>
                                        <input asp-for="AdverseAward.CertifiedCopyRemarks" class="form-control" placeholder="Provide any additional remarks regarding the certified copy..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- F. AWARD DETAILS & ASSESSMENT -->
                        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-currency-rupee me-2"></i>F. AWARD DETAILS & ASSESSMENT</h6>
                            </div>
                            <div class="card-body p-4">
                                <!-- Injury Type Selection -->
                                <div class="row g-4 mb-4">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-uppercase">Injury / Damage Type</label>
                                        <select asp-for="AdverseAward.InjuryType" class="form-select border-primary border-opacity-25" id="injuryTypeSelect">
                                            <option value="">-- SELECT STATUS --</option>
                                            <option value="Injury">INJURY CASE</option>
                                            <option value="Damage">DAMAGE CASE</option>
                                            <option value="Death">DEATH CASE</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8" id="injuryRemarkCol" style="@(Model.AdverseAward?.InjuryType == "Injury" || Model.AdverseAward?.InjuryType == "Damage" ? "" : "display:none;")">
                                        <label asp-for="AdverseAward.InjuryDetails" class="form-label small fw-bold text-uppercase">Injury / Damage Specifics</label>
                                        <input asp-for="AdverseAward.InjuryDetails" class="form-control" placeholder="Provide specific details regarding injury or damage..." />
                                    </div>
                                </div>

                                <div id="compensationContainer" style="@(string.IsNullOrEmpty(Model.AdverseAward?.InjuryType) ? "display:none;" : "")">
                                    <!-- MACT Assessment Paragraph -->
                                    <div class="p-4 rounded-3 border bg-light mb-4 shadow-none" id="paragraphContainer">
                                        <div class="d-flex align-items-center mb-3 text-primary">
                                            <i class="bi bi-quote fs-4 me-2"></i>
                                            <h6 class="fw-bold mb-0">MACT ASSESSMENT SUMMARY</h6>
                                        </div>
                                        <div class="compensation-paragraph text-dark" style="line-height: 2.5; font-size: 1.1rem; text-align: justify;">
                                            The <span class="badge bg-white text-primary border fw-bold injury-only">INJURED PETITIONER</span><span class="badge bg-white text-danger border fw-bold death-only">DECEASED VICTIM</span> was 
                                            <span class="inline-input-wrapper ms-1">
                                                <input asp-for="AdverseAward.VictimAge" class="compensation-input text-center bg-white" style="width: 70px;" type="number" placeholder="AGE" />
                                            </span>
                                            years old at the time of accident and was working as 
                                            <span class="inline-input-wrapper mx-1">
