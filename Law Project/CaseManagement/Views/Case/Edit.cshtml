                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsIncomeCrossVerified" id="incomeVerifiedYes">
                                                    <label class="form-check-label fw-bold py-1" for="incomeVerifiedYes">YES</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsIncomeCrossVerified" id="incomeVerifiedNo">
                                                    <label class="form-check-label fw-bold py-1" for="incomeVerifiedNo">NO</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border border-light-subtle h-100">
                                            <label class="form-label d-block small fw-bold text-uppercase text-secondary">Tally with Documents?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.DoesIncomeTallyWithDocuments" id="incomeTallyYes">
                                                    <label class="form-check-label fw-bold py-1" for="incomeTallyYes">YES</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.DoesIncomeTallyWithDocuments" id="incomeTallyNo">
                                                    <label class="form-check-label fw-bold py-1" for="incomeTallyNo">NO</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="p-3 bg-light rounded-3 border border-light-subtle h-100">
                                            <label class="form-label d-block small fw-bold text-uppercase text-secondary">Medical bills verified?</label>
                                            <div class="d-flex gap-4 mt-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsMedicalBillsVerified" id="medBillsVerifiedYes">
                                                    <label class="form-check-label fw-bold py-1" for="medBillsVerifiedYes">YES</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsMedicalBillsVerified" id="medBillsVerifiedNo">
                                                    <label class="form-check-label fw-bold py-1" for="medBillsVerifiedNo">NO</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-3 bg-light rounded-3 border border-light-subtle h-100">
                                            <label asp-for="AdverseAward.AgeProofFile" class="form-label d-block small fw-bold text-uppercase text-secondary">Age Proof Verification</label>
                                            <input asp-for="AdverseAward.AgeProofFile" class="form-control" type="file" accept=".pdf" />
                                            @if (!string.IsNullOrEmpty(Model.AdverseAward?.AgeProofUploadPath))
                                            {
                                                <div class="mt-1">
                                                    <a href="@Model.AdverseAward.AgeProofUploadPath" target="_blank" class="small text-decoration-none text-primary">
                                                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i> View Existing Age Proof Document
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                        <!-- I. OPINIONS & FINAL STATUS -->
                        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-chat-right-dots me-2"></i>I. OPINIONS & FINAL STATUS</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4 mb-4">
                                    <div class="col-md-4">
                                        <label asp-for="AdverseAward.AdvocateOpinion" class="form-label small fw-bold text-uppercase">Advocate's Opinion</label>
                                        <textarea asp-for="AdverseAward.AdvocateOpinion" class="form-control" rows="3" placeholder="PROVIDE DETAILED LEGAL OPINION..."></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AdverseAward.LOOpinion" class="form-label small fw-bold text-uppercase">Law Officer's Opinion</label>
                                        <textarea asp-for="AdverseAward.LOOpinion" class="form-control" rows="3" placeholder="PROVIDE LO COMMENTS..."></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AdverseAward.DCOpinion" class="form-label small fw-bold text-uppercase">DC's Final Decision</label>
                                        <textarea asp-for="AdverseAward.DCOpinion" class="form-control" rows="3" placeholder="PROVIDE DC REMARKS..."></textarea>
                                    </div>
                                </div>

                                <div class="row g-4 align-items-end mb-4">
                                    <div class="col-md-4">
                                        <label for="forwardStatusSelect" class="form-label small fw-bold text-uppercase text-primary">Final Forwarding Status</label>
                                        <select asp-for="AdverseAward.ForwardingStatus" class="form-select border-primary fw-bold text-primary bg-primary bg-opacity-10" id="forwardStatusSelect">
                                            <option value="Pending">PENDING</option>
                                            <option value="Closed at Division">CLOSED AT DIVISION LEVEL</option>
                                            <option value="Sent to Central Office">SENT TO CENTRAL OFFICE</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="AdverseJudgmentFile" class="form-label small fw-bold text-uppercase">Upload Final Judgment</label>
                                        <input asp-for="AdverseAward.AdverseJudgmentFile" type="file" id="AdverseJudgmentFile" class="form-control" />
                                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.AdverseJudgmentUploadPath))
                                        {
                                            <div class="mt-1">
                                                <a href="@Model.AdverseAward.AdverseJudgmentUploadPath" target="_blank" class="small text-decoration-none text-primary">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> View Existing Judgment
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="row g-4 mb-4" id="closureRemarksRow" style="@(Model.AdverseAward?.ForwardingStatus == "Closed at Division" ? "" : "display:none;")">
                                    <div class="col-md-8">
                                        <div class="p-3 bg-light rounded-3 border border-light-subtle">
                                            <div class="row g-2">
                                                <div class="col-md-8">
                                                    <label asp-for="AdverseAward.ClosureRemarks" class="form-label small fw-bold text-uppercase">Closure Remarks</label>
                                                    <input asp-for="AdverseAward.ClosureRemarks" class="form-control" placeholder="REASON..." />
                                                </div>
                                                <div class="col-md-4">
                                                    <label asp-for="AdverseAward.ClosureDate" class="form-label small fw-bold text-uppercase">Closure Date</label>
                                                    <input asp-for="AdverseAward.ClosureDate" class="form-control" type="date" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4 mt-2 co-only" style="@(Model.AdverseAward?.ForwardingStatus == "Sent to Central Office" ? "" : "display:none;")">
                                    <div class="col-md-4">
                                        <label asp-for="AdverseAward.OutwardNumber" class="form-label small fw-bold text-uppercase">Outward Number</label>
                                        <input asp-for="AdverseAward.OutwardNumber" class="form-control border-primary border-opacity-25" placeholder="E.G. NW/DV/LAW/123" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AdverseAward.OutwardDate" class="form-label small fw-bold text-uppercase">Outward Date</label>
                                        <input asp-for="AdverseAward.OutwardDate" class="form-control border-primary border-opacity-25" type="date" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="alert alert-warning py-3 mb-0 border-0 h-100 d-flex align-items-center shadow-sm rounded-4">
                                            <i class="bi bi-info-circle-fill me-3 fs-3"></i>
                                            <span class="small fw-semibold">Case will automatically reflect in <strong class="text-dark">Central Office login</strong> for further monitoring.</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 pt-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold small mb-0 text-secondary text-uppercase"><i class="bi bi-paperclip me-2 text-primary"></i>Enclose Documents</h6>
                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="addEnclosedDocInput()">
                                            <i class="bi bi-plus-lg me-1"></i> ADD NEW DOCUMENT
                                        </button>
                                    </div>
                                    <div id="enclosedDocsList" class="d-flex flex-wrap gap-2 mb-3">
                                        @for (int i = 0; i < (Model.AdverseAward?.EnclosedDocuments?.Count ?? 0); i++)
                                        {
                                            <div class="input-group input-group-sm mb-2 shadow-sm" style="max-width: 400px;">
                                                <span class="input-group-text bg-white p-1 pe-2 border-end-0"><i class="bi bi-file-earmark ms-1"></i></span>
                                                <input name="AdverseAward.EnclosedDocuments[@i].DocName" value="@Model.AdverseAward.EnclosedDocuments[i].DocName" class="form-control border-start-0 ps-1" placeholder="Document description..." required />
                                                <span class="input-group-text bg-white border-start-0 border-end-0">Pages:</span>
                                                <input name="AdverseAward.EnclosedDocuments[@i].PageCount" value="@Model.AdverseAward.EnclosedDocuments[i].PageCount" type="number" class="form-control" style="max-width: 80px;" placeholder="#" />
                                                <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-trash"></i></button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-save me-2"></i> Update Case File
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/ecourts-cascade.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            ECourtsCascade.loadStates('mvc-ecourts-state');
        });

        $(document).ready(function () {
            const existingCnr = '@(Model.CNRNumber ?? "")';
            if (existingCnr.length === 16) {
                const statusElem = document.getElementById('cnr-status-badge');
                if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Linked Live CNR: ${existingCnr}</span>`;
            }

            // 2. Load Division Advocates via AJAX
            const currentAdvName = '@Html.Raw(Model.AdvocateName ?? "")';
            const userDivId = $('#DivisionID').val();

            if (userDivId) {
                $.getJSON('/Master/GetAdvocatesByDivision', { divisionId: userDivId }, function (data) {
                    const $select = $('#AdvocateSelect');
                    $select.empty().append('<option value="">-- Choose Advocate --</option>');
                    
                    let found = false;
                    $.each(data, function (i, item) {
                        const name = item.advocateName || item.AdvocateName;
                        if (name) {
                            $select.append($('<option>', { value: name, text: name }));
                            if (name.toLowerCase() === currentAdvName.toLowerCase()) {
                                found = true;
                            }
                        }
                    });
                    $select.append('<option value="Others">Others</option>');

                    if (found) {
                        $select.val(currentAdvName);
                    } else if (currentAdvName) {
                        $select.val('Others');
                        $('#AdvocateManualEntry').show().val(currentAdvName);
                    }
                    $('#AdvocateNameHidden').val(currentAdvName);
                });
            }

            // 3. Petition Filed For "Others" Initialization
            const initialPFF = '@Html.Raw(Model.PetitionFiledFor ?? "")';
            if (initialPFF) {
                if (["SECTION 163(A)", "SECTION 164", "SECTION 166"].includes(initialPFF)) {
                    $('#PetitionFiledForSelect').val(initialPFF);
                } else {
                    $('#PetitionFiledForSelect').val('Others');
                    $('#PetitionFiledForManual').show().val(initialPFF);
                }
                $('#PetitionFiledForHidden').val(initialPFF);
            }

            // 4. "Others" Dropdown Generic Toggle Handler
            $(document).on('change', '.others-dropdown', function () {
                const targetId = $(this).data('others-target');
                const hiddenId = $(this).data('others-hidden');
                const val = $(this).val();

                if (val === 'Others') {
                    $('#' + targetId).show().val('');
                    if (hiddenId) $('#' + hiddenId).val('');
                } else {
                    $('#' + targetId).hide().val('');
                    if (hiddenId) $('#' + hiddenId).val(val);
                }
            });

            $(document).on('input change', '.others-manual', function () {
                const selectId = $(this).data('others-select');
                const hiddenId = $('#' + selectId).data('others-hidden');
                if ($('#' + selectId).val() === 'Others' && hiddenId) {
                    $('#' + hiddenId).val($(this).val());
                }
            });

            // 5. Dynamic Petitioner Rows
            $('#btnAddPetitioner').click(function () {
                const rowIdx = $('#petitionersTable tbody tr').length;
                const tr = `
                    <tr>
                        <td><input name="Petitioners[${rowIdx}].PetitionerName" class="form-control form-control-sm" required /></td>
                        <td>
                            <select name="Petitioners[${rowIdx}].Relationship" class="form-select form-select-sm petitioner-relationship-select">
                                <option value="">-- Select --</option>
                                <option value="Self">Self</option>
                                <option value="Father">Father</option>
                                <option value="Mother">Mother</option>
                                <option value="Son">Son</option>
                                <option value="Daughter">Daughter</option>
                                <option value="Husband">Husband</option>
                                <option value="Wife">Wife</option>
                                <option value="Brother">Brother</option>
                                <option value="Sister">Sister</option>
                                <option value="Others">Others</option>
                            </select>
                            <input name="Petitioners[${rowIdx}].RelationshipOthers" class="form-control form-control-sm mt-1 petitioner-relationship-others" placeholder="Type relationship..." style="display:none;" />
                        </td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="bi bi-trash"></i></button></td>
                    </tr>`;
                $('#petitionersTable tbody').append(tr);
            });

            $(document).on('change', '.petitioner-relationship-select', function () {
                const $otherInput = $(this).closest('td').find('.petitioner-relationship-others');
                if ($(this).val() === 'Others') {
                    $otherInput.show();
                } else {
                    $otherInput.hide().val('');
                }
            });

            $(document).on('click', '.btn-remove-row', function () {
                $(this).closest('tr').remove();
            });

            // 6. Dynamic Opposite Vehicle Rows
            $(document).on('click', '.btn-add-op-vehicle', function () {
                const idx = $('#oppositeVehiclesContainer .input-group').length;
                const html = `
                    <div class="input-group mb-2">
                        <input name="OppositeVehicleNumbers[${idx}]" class="form-control op-vehicle-input" placeholder="XX-XX-XX-XXXX" title="Format: XX-XX-XX-XXXX" pattern="^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$" />
                        <button type="button" class="btn btn-outline-danger btn-remove-op-vehicle"><i class="bi bi-trash"></i></button>
                    </div>`;
                $('#oppositeVehiclesContainer').append(html);
            });

            $(document).on('click', '.btn-remove-op-vehicle', function () {
                $(this).closest('.input-group').remove();
            });

            // 7. Toggle Handlers for Medical, ARF, Impleading, Alleged Accident, Bus Insured, Limitation
            $('input[name="IsMedicalExpensesPaid"]').change(function() {
                if ($(this).val() === 'true') $('.medicalDetails').slideDown();
                else $('.medicalDetails').slideUp().find('input').val('');
            });
            if ($('input[name="IsMedicalExpensesPaid"]:checked').val() === 'true') $('.medicalDetails').show();

            $('input[name="IsARFAmountPaid"]').change(function() {
                if ($(this).val() === 'true') $('.arfDetails').slideDown();
                else $('.arfDetails').slideUp().find('input').val('');
            });
            if ($('input[name="IsARFAmountPaid"]:checked').val() === 'true') $('.arfDetails').show();

            $('input[name="IsOppositeVehicleInmate"]').change(function() {
                if ($('#isInmateYes').is(':checked')) $('#impleadingSection').slideDown();
                else $('#impleadingSection').slideUp();
            });
            if ($('#isInmateYes').is(':checked')) $('#impleadingSection').show();

            $('input[name="AdverseAward.IsBusInsured"]').change(function() {
                if ($(this).val() === 'true') $('#busInsuranceDetailsCol').slideDown();
                else $('#busInsuranceDetailsCol').slideUp().find('input').val('');
            });
            if ($('input[name="AdverseAward.IsBusInsured"]:checked').val() === 'true') $('#busInsuranceDetailsCol').show();

            function toggleSecurity() {
                const isAlleged = $('input[name="AdverseAward.IsAllegedAccident"]:checked').val() === "true";
                const isSecReq = $('input[name="AdverseAward.SecurityRequired"]:checked').val() === "true";
                if (isAlleged) {
                    $('#securityQuestionCol').slideDown();
                    if (isSecReq) $('#securityReportCol').slideDown();
                    else $('#securityReportCol').slideUp();
                } else {
                    $('#securityQuestionCol').slideUp();
                    $('#securityReportCol').slideUp();
                }
            }
            $('input[name="AdverseAward.IsAllegedAccident"], input[name="AdverseAward.SecurityRequired"]').change(toggleSecurity);
            toggleSecurity();

            $('input[name="IsWithinLimitation"]').change(function() {
                if ($(this).val() === 'false') $('.limitationAdverseDetails').slideDown();
                else $('.limitationAdverseDetails').slideUp();
            });
            if ($('input[name="IsWithinLimitation"]:checked').val() === 'false') $('.limitationAdverseDetails').show();

            $('input[name="AdverseAward.IsDelayApplicationFiled"]').change(function() {
                if ($(this).val() === 'true') $('#iaUploadDiv').slideDown();
                else $('#iaUploadDiv').slideUp();
            });
            if ($('input[name="AdverseAward.IsDelayApplicationFiled"]:checked').val() === 'true') $('#iaUploadDiv').show();

            $('input[name="AdverseAward.IsDelayCondonedAdverse"]').change(function() {
                if ($(this).val() === 'true') $('#delayCCUploadDiv').slideDown();
                else $('#delayCCUploadDiv').slideUp();
            });
            if ($('input[name="AdverseAward.IsDelayCondonedAdverse"]:checked').val() === 'true') $('#delayCCUploadDiv').show();

            // Sync ClaimPetitionDate hidden field
            $('input[name="AdverseAward.ClaimPetitionDate"]').on('input change', function() {
                $('#ClaimPetitionDateHidden').val($(this).val());
                checkLimitation();
            });
            $('#AccidentDate').on('input change', checkLimitation);

            function checkLimitation() {
                var accidentDateVal = $('#AccidentDate').val();
                var petitionDateVal = $('input[name="AdverseAward.ClaimPetitionDate"]').val();
                if (accidentDateVal && petitionDateVal) {
                    var accidentDate = new Date(accidentDateVal);
                    var petitionDate = new Date(petitionDateVal);
                    var limitationDate = new Date(accidentDate);
                    limitationDate.setMonth(limitationDate.getMonth() + 6);
                    if (petitionDate <= limitationDate) {
                        $('#limitationYes').prop('checked', true).trigger('change');
                    } else {
                        $('#limitationNo').prop('checked', true).trigger('change');
                    }
                }
            }

            // Part 3 Progress Toggles
            function toggleDocumentSent() {
                if ($('#isDocSentYes').is(':checked')) {
                    $("#documentDetails").slideDown();
                } else {
                    $("#documentDetails").slideUp();
                }
            }
            $('input[name="IsDocumentSent"]').change(toggleDocumentSent);
            toggleDocumentSent();

            function toggleObjectionFiled() {
                if ($('#isObjFiledYes').is(':checked')) {
                    $("#objectionDateDiv").slideDown();
                } else {
                    $("#objectionDateDiv").slideUp();
                }
            }
            $('input[name="IsObjectionFiled"]').change(toggleObjectionFiled);
            toggleObjectionFiled();

            // Part 4 Disposal Status & Result Toggles
            function updateDisposalState() {
                const status = $("#disposalStatusSelect").val();
                const result = $("#disposalResultSelect").val();

                if (status === "Disposed") {
                    $("#disposalResultCol").slideDown();
                    if (result === "Against") {
                        $("#remarksContainer").slideUp();
                        $("#adverseWorkflowContainer").slideDown(function() {
                            syncAdverseConnectedCases();
                        });
                    } else if (result === "Favor" || result === "Settled" || result === "Dismissed") {
                        $("#remarksContainer").slideDown();
                        if (result === "Favor") {
                            $("#favorUploadCol").show();
                        } else {
                            $("#favorUploadCol").hide();
                        }
                        $("#adverseWorkflowContainer").slideUp();
                    } else {
                        $("#remarksContainer").slideUp();
                        $("#adverseWorkflowContainer").slideUp();
                    }
                } else {
                    $("#disposalResultCol").slideUp();
                    $("#remarksContainer").slideUp();
                    $("#adverseWorkflowContainer").slideUp();
                }
            }

            $("#disposalStatusSelect, #disposalResultSelect").change(updateDisposalState);
            updateDisposalState();

            // Adverse Objection Remarks toggle
            function toggleAdverseObjection() {
                if ($('#objNo').is(':checked')) {
                    $("#objRemarksCol").slideDown();
                } else {
                    $("#objRemarksCol").slideUp();
                }
            }
            $('input[name="AdverseAward.ObjectionFiled"]').change(toggleAdverseObjection);
            toggleAdverseObjection();

            // Forwarding Logic
            $("#forwardStatusSelect").change(function () {
                const val = $(this).val();
                if (val === "Sent to Central Office") {
                    $(".co-only").slideDown();
                    $("#closureRemarksRow").slideUp();
                } else if (val === "Closed at Division") {
                    $(".co-only").slideUp();
                    $("#closureRemarksRow").slideDown();
                } else {
                    $(".co-only").slideUp();
                    $("#closureRemarksRow").slideUp();
                }
            });
            $("#forwardStatusSelect").trigger('change');

            // Driver punishment
            $("#punishmentStatusSelect").change(function () {
                if ($(this).val() === "Order Issued") {
                    $(".punishment-details").slideDown();
                } else {
                    $(".punishment-details").slideUp();
                }
            });
            if ($("#punishmentStatusSelect").val() === "Order Issued") $(".punishment-details").show();

            // EP Filed Toggle
            function toggleEPDetails() {
                var isFiled = $('input[name="AdverseAward.IsEPFiled"]:checked').val() === "true";
                if (isFiled) {
                    $('#epDetailsRow').slideDown();
                    if ($('input[name="AdverseAward.IsAmountDepositedInEP"]:checked').val() === 'true') {
                        $('#epAmountValCol').show();
                    } else {
                        $('#epAmountValCol').hide();
                    }
                } else {
                    $('#epDetailsRow').slideUp();
                }
            }
            $('input[name="AdverseAward.IsEPFiled"]').change(toggleEPDetails);
            $('input[name="AdverseAward.IsAmountDepositedInEP"]').change(function() {
                if ($(this).val() === 'true') {
                    $('#epAmountValCol').slideDown();
                } else {
                    $('#epAmountValCol').slideUp();
                }
            });
            toggleEPDetails();

            // Date sync
            $('input[name="AdverseAward.AwardDate"]').change(function () {
                $('input[name="AdverseAward.DisposedOnDate"]').val($(this).val());
            });

            // Photo & Police sketch
            $('input[name="AdverseAward.IsPhotographProduced"]').change(function() {
                if ($(this).val() === 'false') $('#photoReasonCol').slideDown();
                else $('#photoReasonCol').slideUp();
            });
            if ($('input[name="AdverseAward.IsPhotographProduced"]:checked').val() === 'false') $('#photoReasonCol').show();

            $('input[name="AdverseAward.IsPoliceSketchEnclosed"]').change(function() {
                if ($(this).val() === 'true') $('#policeSketchExhibitCol').slideDown();
                else $('#policeSketchExhibitCol').slideUp();
            });
            if ($('input[name="AdverseAward.IsPoliceSketchEnclosed"]:checked').val() === 'true') $('#policeSketchExhibitCol').show();

            // Bus camera
            function toggleBusCamera() {
                if ($('input[name="AdverseAward.IsBusCameraInstalled"]:checked').val() === "true") {
                    $('#camFootageQuestionCol').slideDown();
                } else {
                    $('#camFootageQuestionCol').slideUp();
                }
            }
            $('input[name="AdverseAward.IsBusCameraInstalled"]').change(toggleBusCamera);
            toggleBusCamera();

            // Impleading Application
            $('input[name="AdverseAward.IsImpleadingAppFiled"]').change(function() {
                if ($(this).val() === 'false') $('#impleadReasonCol').slideDown();
                else $('#impleadReasonCol').slideUp();
            });
            if ($('input[name="AdverseAward.IsImpleadingAppFiled"]:checked').val() === 'false') $('#impleadReasonCol').show();

            // RW Type Select
            $('#rwTypeSelect').change(function() {
                if ($(this).val() === 'Others') {
                    $('.rw-designation-container').show();
                } else {
                    $('.rw-designation-container').hide();
                    $('.rw-designation-container input').val('');
                }
            });
            if ($('#rwTypeSelect').val() === 'Others') $('.rw-designation-container').show();

            // Injury Type Change & Calculation hooks
            $("#injuryTypeSelect").on("change", handleInjuryTypeChange);
            $(document).on("input change", ".death-head, .injury-head, .damage-head, #AdverseAward_LiabilityPercentage, #AdverseAward_AwardAmount, #roundOffAmt, .interim-input", calculateLiableAmount);
            handleInjuryTypeChange();
            calculateLiableAmount();
        });

        // Helper counters
        let counter = { 
            'pwList': parseInt('@(Model.AdverseAward?.PetitionerPWNames?.Count ?? 0)') || 0, 
            'docList': parseInt('@(Model.AdverseAward?.Doctors?.Count ?? 0)') || 0, 
            'rwList': parseInt('@(Model.AdverseAward?.RWNames?.Count ?? 0)') || 0, 
            'enclosedDocsList': parseInt('@(Model.AdverseAward?.EnclosedDocuments?.Count ?? 0)') || 0 
        };
        let advConnIndex = parseInt('@(Model.AdverseAward?.ConnectedCases?.Count ?? 0)') || 0;
        let dynamicHeadIndex = parseInt('@(Model.AdverseAward?.CustomCompensationHeads?.Count ?? 0)') || 0;

