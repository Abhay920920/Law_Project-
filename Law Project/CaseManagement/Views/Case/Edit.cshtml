        function addAdverseConnectedRow(mvcNo, mvcYear, mact, status) {
            let row = `<tr>
                <td><input name="AdverseAward.ConnectedCases[${advConnIndex}].ConnectedMVCNo" class="form-control form-control-sm" value="${mvcNo||''}" aria-label="Connected MVC No" required /></td>
                <td><input name="AdverseAward.ConnectedCases[${advConnIndex}].ConnectedYear" type="number" class="form-control form-control-sm" value="${mvcYear||new Date().getFullYear()}" aria-label="Connected Year" required /></td>
                <td><input name="AdverseAward.ConnectedCases[${advConnIndex}].MACT" class="form-control form-control-sm" value="${mact||''}" aria-label="MACT" required /></td>
                <td><input name="AdverseAward.ConnectedCases[${advConnIndex}].Status" class="form-control form-control-sm" value="${status||''}" aria-label="Status" /></td>
                <td class="text-center">
                     <div class="form-check form-switch d-flex justify-content-center">
                        <input class="form-check-input btn-toggle-details" type="checkbox" role="switch" data-target="#advDetailsRow_${advConnIndex}">
