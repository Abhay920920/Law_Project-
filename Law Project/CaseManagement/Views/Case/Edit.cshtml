                            <div class="col-md-3">
                                <label class="form-label small">Award Amount</label>
                                <input type="number" name="AdverseAward.ConnectedCases[${advConnIndex}].AwardDetails.AwardAmount" class="form-control form-control-sm" step="0.01" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Interest %</label>
                                <input type="number" name="AdverseAward.ConnectedCases[${advConnIndex}].AwardDetails.InterestRate" class="form-control form-control-sm" step="0.01" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Victim Age</label>
                                <input type="number" name="AdverseAward.ConnectedCases[${advConnIndex}].AwardDetails.VictimAge" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Occupation</label>
                                <input type="text" name="AdverseAward.ConnectedCases[${advConnIndex}].AwardDetails.Occupation" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Income</label>
                                <input type="number" name="AdverseAward.ConnectedCases[${advConnIndex}].AwardDetails.IncomeConsidered" class="form-control form-control-sm" step="0.01" />
                            </div>
                            <div class="col-md-9">
                                 <label class="form-label small">Injury Details / Remarks</label>
                                 <textarea name="AdverseAward.ConnectedCases[${advConnIndex}].AwardDetails.InjuryDetails" class="form-control form-control-sm" rows="1"></textarea>
