    <script>
        function onCnrInputChange(val) {
            if (!val) return;
            const cleanCnr = val.trim().toUpperCase();
            if (cleanCnr.length === 16) {
                triggerMvcCnrDiscovery();
            }
        }

        async function triggerMvcCnrDiscovery() {
            const cnrElem = document.getElementById('mvc-cnr-number');
            const cnrVal = cnrElem ? cnrElem.value.trim().toUpperCase() : '';
            const statusElem = document.getElementById('cnr-status-badge');

            if (!cnrVal || cnrVal.length !== 16) {
                if (statusElem) statusElem.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Please enter a valid 16-Digit CNR Number</span>';
                return;
            }

            // Direct 16-Digit CNR Auto-Fetch & Auto-Link Mode
            if (statusElem) statusElem.innerHTML = '<span class="badge bg-info text-dark"><i class="bi bi-hourglass-split"></i> Auto-Linking CNR on eCourts Gateway...</span>';
            
            const parsedEstCode = cnrVal.substring(0, 6);
            const estHidden = document.getElementById('mvc-ecourts-est');
            if (estHidden) estHidden.value = parsedEstCode;

            try {
                const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnrVal)}`);
                const json = await res.json();
                if (json.success) {
                    if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Linked Live CNR: ${cnrVal}</span>`;
                    if (json.data) populateFormFromEcourtsData(json.data);
                    else if (json.regNo) {
                        const regNoElem = document.getElementById('MVCNo') || document.querySelector('[name="MVCNo"]');
                        if (regNoElem && (!regNoElem.value || regNoElem.value.trim() === '')) regNoElem.value = json.regNo;
                        const regYearElem = document.getElementById('MVCYear') || document.querySelector('[name="MVCYear"]');
                        if (regYearElem && (!regYearElem.value || regYearElem.value.trim() === '')) regYearElem.value = json.regYear;
                    }
                } else {
                    if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> eCourts CNR Linked: ${cnrVal}</span>`;
                }
            } catch (e) {
                if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Linked CNR: ${cnrVal}</span>`;
            }
        }

        function populateFormFromEcourtsData(data) {
            if (!data) return;

            // 0. Real MVC Registration No. & Year Auto-Population from API Payload
            let realRegNo = data.reg_no || data.case_no || data.registration_no || data.case_number || '';
            let realRegYear = data.reg_year || data.case_year || data.year || '';

            if (realRegNo) {
                const regNoElem = document.getElementById('MVCNo') || document.querySelector('[name="MVCNo"]');
                if (regNoElem && (!regNoElem.value || regNoElem.value.trim() === '' || regNoElem.dataset.autoFilled === "true")) {
                    regNoElem.value = String(realRegNo).trim();
                    regNoElem.dataset.autoFilled = "true";
                }
            }

            if (realRegYear) {
                const regYearElem = document.getElementById('MVCYear') || document.querySelector('[name="MVCYear"]');
                if (regYearElem && (!regYearElem.value || regYearElem.value.trim() === '' || regYearElem.dataset.autoFilled === "true")) {
                    regYearElem.value = String(realRegYear).trim();
                    regYearElem.dataset.autoFilled = "true";
                }
            }

            // 1. Petitioner / Claimant Name Auto-Population
            let petName = data.pet_name || data.petitioner_name || data.petitioner || '';
            if (petName && typeof petName === 'string') {
                const petTable = document.getElementById('petitionersTable');
                if (petTable) {
                    const tbody = petTable.querySelector('tbody');
                    if (tbody) {
                        let nameInputs = tbody.querySelectorAll('input[name*="Name"]');
                        if (nameInputs.length === 0) {
                            const addBtn = document.getElementById('btnAddPetitioner');
                            if (addBtn) addBtn.click();
                            nameInputs = tbody.querySelectorAll('input[name*="Name"]');
                        }
                        if (nameInputs.length > 0) {
                            nameInputs[0].value = petName.trim();
                        }
                    }
                }
            }

            // 2. Filing Date / Claim Petition Date Auto-Population
            let filingDate = data.filing_date || data.date_of_filing || data.dt_of_filing || '';
            if (filingDate) {
                const claimDateElem = document.querySelector('[name="AdverseAward.ClaimPetitionDate"]');
                if (claimDateElem) {
                    let formattedDate = filingDate;
                    if (filingDate.includes('-')) {
                        const parts = filingDate.split('-');
                        if (parts.length === 3 && parts[2].length === 4) {
                            formattedDate = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                        }
                    }
                    claimDateElem.value = formattedDate;
                }
            }
        }
    </script>
