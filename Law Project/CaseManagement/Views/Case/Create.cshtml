@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            let petIndex = @Model.Petitioners.Count;
            let caseIndex = @Model.ConnectedCases.Count;
            // advConnIndex is defined globally below

            // Load Advocates on Page Load
            const divisionId = $("#DivisionID").val();
            if (divisionId) {
                loadAdvocates(divisionId);
            }

            function loadAdvocates(divId) {
                const $dropdown = $("#AdvocateSelect");
                $dropdown.empty().append('<option value="">Loading...</option>');

                $.get('/Case/GetAdvocates?divisionId=' + divId, function (data) {
                    $dropdown.empty().append('<option value="">-- Choose Advocate --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, Name) {
                            $dropdown.append($('<option>', {
                                value: Name,
                                text: Name
                            }));
                        });
                    }
                    $dropdown.append('<option value="Others">Others</option>');
                }).fail(function () {
                    $dropdown.empty().append('<option value="">Error loading</option><option value="Others">Others</option>');
                });
            }



            $("#btnAddPetitioner").click(function () {
                let row = `<tr>
                    <td><input name="Petitioners[${petIndex}].PetitionerName" class="form-control form-control-sm" aria-label="Petitioner Name" required /></td>
                    <td>
                        <select name="Petitioners[${petIndex}].Relationship" 
                                class="form-select form-select-sm others-dropdown" 
                                data-others-target="pet_rel_others_${petIndex}" aria-label="Relationship" required>
                            <option value="">-- Select --</option>
                            <option value="Self">Self</option>
                            <option value="Father">Father</option>
                            <option value="Mother">Mother</option>
                            <option value="Son">Son</option>
                            <option value="Daughter">Daughter</option>
                            <option value="Husband">Husband</option>
                            <option value="Wife">Wife</option>
                            <option value="Brother">Brother</option>
                            <option value="Sister">Sister</option>
                            <option value="Father-in-law">Father-in-law</option>
                            <option value="Mother-in-law">Mother-in-law</option>
                            <option value="Brother-in-law">Brother-in-law</option>
                            <option value="Sister-in-law">Sister-in-law</option>
                            <option value="Son-in-law">Son-in-law</option>
                            <option value="Daughter-in-law">Daughter-in-law</option>
                            <option value="Guardian">Guardian</option>
                            <option value="Others">Others</option>
                        </select>
                        <input type="text" id="pet_rel_others_${petIndex}" name="Petitioners[${petIndex}].RelationshipOthers" 
                               class="form-control form-control-sm mt-1 others-manual" 
                               placeholder="Type relationship..." style="display:none;" />
                    </td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="bi bi-trash"></i></button></td>
                </tr>`;
                $("#petitionersTable tbody").append(row);
                petIndex++;
            });



            let opVehicleIndex = 1;
            $("#btnAddOppositeVehicle").click(function () {
                let row = `
                <div class="input-group mb-2">
                    <input name="OppositeVehicleNumbers[${opVehicleIndex}]" class="form-control op-vehicle-input" placeholder="XX-XX-XX-XXXX" title="Format: XX-XX-XX-XXXX" pattern="^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$" />
                    <button type="button" class="btn btn-outline-danger btn-remove-op-vehicle"><i class="bi bi-trash"></i></button>
                </div>`;
                $("#oppositeVehiclesContainer").append(row);
                opVehicleIndex++;
            });

            $(document).on("click", ".btn-remove-op-vehicle", function () {
                $(this).closest(".input-group").remove();
            });

            // Auto-Linkage Logic (Hardened)

            function fetchLinkedCases() {
                const vehicleNo = $("#VehicleNo").val();
                const accidentDate = $("#AccidentDate").val();

                if (vehicleNo && accidentDate) {
                    $.get(`/Case/GetLinkedCases?vehicleNo=${vehicleNo}&accidentDate=${accidentDate}`, function (data) {
                        console.log("Linked Cases Data Received:", data);
                        if (data && data.length > 0) {
                            let existingKeys = new Set();
                            const normalize = (val) => val ? String(val).trim().toLowerCase() : "";

                            $("#connectedCasesTable tbody tr").each(function() {
                                let mvc = $(this).find('input[name*=".ConnectedMVCNo"]').val();
                                let year = $(this).find('input[name*=".ConnectedYear"]').val();
                                if(mvc && year) existingKeys.add(`${normalize(mvc)}-${normalize(year)}`);
                            });

                            let inputMvc = $("#MVCNo").val();
                            let inputYear = $("#MVCYear").val();
                            if(inputMvc && inputYear) existingKeys.add(`${normalize(inputMvc)}-${normalize(inputYear)}`);

                            let newItemsAdded = false;

