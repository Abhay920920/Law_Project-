            // Vehicle Number Validation Logic
            function updateVehicleValidation() {
                const type = $('input[name="VehicleType"]:checked').val();
                const input = $('#vehicleNoInput');
                const hint = $('#vehicleHint');
                
                if (type === 'Corporation') {
                    input.attr('placeholder', 'KA-XX-F-XXXX');
                    hint.text('Pattern: KA-XX-F-XXXX');
                    input.attr('pattern', '^KA-\\d{2}-F-\\d{4}$');
                } else {
                    input.attr('placeholder', 'XX-XX-XX-XXXX');
                    hint.text('Pattern: XX-XX-XX-XXXX');
                    input.attr('pattern', '^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$');
                }
                validateVehicleNo();
            }

            function validateVehicleNo() {
                const type = $('input[name="VehicleType"]:checked').val();
                let $input = $('#vehicleNoInput');
                let val = $input.val().toUpperCase().replace(/[^A-Z0-9]/g, '');
                let formatted = "";

                if (type === 'Corporation') {
                    // Force start with KA
                    if (val.length > 0) {
                        if (!val.startsWith('KA')) {
                            val = 'KA' + val;
                        }
                        formatted = "KA";
                        let rest = val.substring(2);
                        if (rest.length > 0) {
                            formatted += "-" + rest.substring(0, 2);
                            if (rest.length > 2) {
                                // Skip F if typed manually
                                let afterDigits = rest.substring(2);
                                if (afterDigits.startsWith('F')) {
                                    afterDigits = afterDigits.substring(1);
                                }
                                formatted += "-F-" + afterDigits.substring(0, 4);
                            }
                        }
                    }
                } else {
                    // Format: XX-XX-XX-XXXX
                    if (val.length > 0) {
                        formatted += val.substring(0, 2);
                        if (val.length > 2) {
                            formatted += "-" + val.substring(2, 4);
                            if (val.length > 4) {
                                formatted += "-" + val.substring(4, 6);
                                if (val.length > 6) {
                                    formatted += "-" + val.substring(6, 10);
                                }
                            }
                        }
                    }
                }

                $input.val(formatted);
                
                const corpRegex = /^KA-\d{2}-F-\d{4}$/;
                const otherRegex = /^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$/;
                
                let isValid = (type === 'Corporation') ? corpRegex.test(formatted) : (formatted === "" || otherRegex.test(formatted));
                
                if (formatted !== "" && !isValid) {
                    let msg = (type === 'Corporation') ? "Format: KA-XX-F-XXXX (e.g. KA-25-F-1234)" : "Format: XX-XX-XX-XXXX (e.g. KA-01-AB-1234)";
                    $input[0].setCustomValidity(msg);
                } else {
                    $input[0].setCustomValidity("");
                }
            }

            function validateOpVehicle(el) {
                let $input = $(el);
                let val = $input.val().toUpperCase().replace(/[^A-Z0-9]/g, '');
                let formatted = "";

                // Format: XX-XX-XX-XXXX
                if (val.length > 0) {
                    formatted += val.substring(0, 2);
                    if (val.length > 2) {
                        formatted += "-" + val.substring(2, 4);
                        if (val.length > 4) {
                            formatted += "-" + val.substring(4, 6);
                            if (val.length > 6) {
                                formatted += "-" + val.substring(6, 10);
                            }
                        }
                    }
                }
                $input.val(formatted);

                const regex = /^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{4}$/;
                if (formatted !== "" && !regex.test(formatted)) {
                    $input[0].setCustomValidity("Format: XX-XX-XX-XXXX");
                } else {
                    $input[0].setCustomValidity("");
                }
            }



