@model MVCCaseManagement.Models.EPViewModel

@{
    ViewData["Title"] = "Update Execution Petition Details";
    ViewData["PageHeaderClass"] = "ep-edit-header";
}

<div class="container-fluid px-4 py-4">
    <form asp-action="Edit" method="post" id="epForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EPID" />
        <input type="hidden" asp-for="CaseID" id="CaseID" />
        <input type="hidden" asp-for="DivisionID" />

        <div class="form-container">
            <div asp-validation-summary="All" class="alert alert-danger shadow-sm border-start border-danger border-4 small mb-4"></div>

            <!-- Section A: Basic EP Identification -->
            <div class="section-card border-left-primary mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-primary-subtle text-primary">
                        <i class="bi bi-file-earmark-medical"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-primary">Section A: Basic EP Identification</h5>
                        <small class="text-muted">Basic Case Identification</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label text-primary fw-semibold">Division</label>
                            <input asp-for="DivisionName" class="form-control bg-light" readonly />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="EPNumber" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="EPNumber" class="form-control" placeholder="EP No" />
                            <span asp-validation-for="EPNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="EPYear" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="EPYear" class="form-control" placeholder="Year" />
                            <span asp-validation-for="EPYear" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EPCourt" class="form-label text-primary fw-semibold">EP Court</label>
                            <select asp-for="EPCourt" class="form-select select2" id="EPCourt" data-placeholder="-- Select MACT --">
                                <option value="">-- Select MACT --</option>
                                @if (ViewBag.MACTs != null)
                                {
                                    foreach (var mact in ViewBag.MACTs)
                                    {
                                        <option value="@mact.MACTName">@mact.MACTName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="EPCourt" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ArisingFromMVCNo" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="ArisingFromMVCNo" class="form-control" placeholder="Arising MVC no" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="ArisingFromMVCYear" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="ArisingFromMVCYear" class="form-control" placeholder="Year" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ArisingFromMACT" class="form-label text-primary fw-semibold"></label>
                            <select id="ArisingFromMACTID" class="form-select select2" data-placeholder="-- Select MACT --">
                                <option value="">-- Select MACT --</option>
                                @if (ViewBag.MACTs != null)
                                {
                                    foreach (var mact in ViewBag.MACTs)
                                    {
                                        <option value="@mact.MACTID">@mact.MACTName</option>
                                    }
                                }
                            </select>
                            <input type="hidden" asp-for="ArisingFromMACT" id="ArisingFromMACTName" />
                        </div>
                        <div class="col-md-12 text-end">
                            <button type="button" id="btnViewMVCDetails" class="btn btn-info rounded-pill px-4 text-white shadow-sm">
                                <i class="bi bi-eye me-1"></i> View MVC Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Section B: Entrustment & Advocate Details -->
            <div class="section-card border-left-info mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-info-subtle text-info">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-info">Section B: Entrustment & Advocate Details</h5>
                        <small class="text-muted">Advocate assignment and entrustment details</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="AdvocateID" class="form-label text-info fw-semibold">Advocate</label>
                            <select asp-for="AdvocateID" class="form-select select2" id="AdvocateID" data-placeholder="-- Select Advocate --">
                                <option value="">-- Select Advocate --</option>
                                @if (ViewBag.Advocates != null)
                                {
                                    foreach (var adv in ViewBag.Advocates)
                                    {
                                        <option value="@adv.AdvocateID">@adv.AdvocateName</option>
                                    }
                                }
                            </select>
                            <input type="hidden" asp-for="AdvocateName" id="AdvocateName" />
                            <span asp-validation-for="AdvocateID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EP_EntrustmentNo" class="form-label text-info fw-semibold">Entrustment No.</label>
                            <input asp-for="EP_EntrustmentNo" class="form-control" placeholder="Entrustment No" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EP_EntrustmentDate" class="form-label text-info fw-semibold">Entrustment Date</label>
                            <input asp-for="EP_EntrustmentDate" class="form-control" type="date" />
                        </div>
                    </div>
                </div>
            </div>


            <!-- Section C: Case Status & Stage -->
            <div class="section-card border-left-warning mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-warning-subtle text-warning">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-warning">Section C: Case Status & Stage</h5>
                        <small class="text-muted">Current status and next hearing details of EP</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-12">
                            <label asp-for="OriginalMVCStatus" class="form-label text-warning fw-semibold">Current Status of MVC</label>
                            <input asp-for="OriginalMVCStatus" class="form-control bg-light" readonly />
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EPStatus" class="form-label text-warning fw-semibold">Current Status / Stage of EP</label>
                            <input asp-for="EPStatus" class="form-control" placeholder="Current Status / Stage of EP (e.g. Pending, Notice Issued, Warrant Issued, Disposed)" />
                            <span asp-validation-for="EPStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NextHearingDate" class="form-label text-warning fw-semibold">Next Date of Hearing</label>
                            <input asp-for="NextHearingDate" class="form-control" type="date" />
                            <span asp-validation-for="NextHearingDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Section D: Case Outcome / Result -->
            <div class="section-card border-left-success mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-success-subtle text-success">
                        <i class="bi bi-trophy"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-success">Section D: Case Outcome / Result</h5>
                        <small class="text-muted">Final disposal details and outcome of the petition</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="CaseOutcome" class="form-label text-success fw-semibold">Case Outcome</label>
                            <select asp-for="CaseOutcome" class="form-select border-success-subtle fw-bold" id="ddlCaseOutcome">
                                <option value="Pending">Pending</option>
                                <option value="Disposed">Disposed</option>
                            </select>
                        </div>
                        <div class="col-md-9" id="divDisposalDetails" style="display:none;">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="DisposalDate" class="form-label text-success fw-semibold">Date of Disposal</label>
                                    <input asp-for="DisposalDate" class="form-control border-success-subtle" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ClosureDate" class="form-label text-success fw-semibold">Closure Date</label>
                                    <input asp-for="ClosureDate" class="form-control border-success-subtle" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="DisposalRemarks" class="form-label text-success fw-semibold">Closure Remarks</label>
                                    <textarea asp-for="DisposalRemarks" class="form-control border-success-subtle" rows="1" placeholder="Closure remarks..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Form Actions -->
            <div class="d-flex justify-content-end gap-2 mt-4 mb-5">
                <a href="@Url.Action("Index", "EP")" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" id="btnUpdate" class="btn btn-primary rounded-pill px-5 shadow-sm">
                    <i class="bi bi-save me-1"></i> <span>Update EP Details</span>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- MVC Details Modal -->
<div class="modal fade" id="mvcDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold">MVC Case Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="mvcDetailsContent" class="p-4">
                    <p class="text-center text-muted py-5">No MVC data searched yet.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .ep-edit-header {
        background: linear-gradient(135deg, #fef3c7 0%, #ffffff 100%);
        border-bottom: 1px solid #fde68a;
    }

    .section-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        overflow: hidden;
        border: 1px solid #edf2f7;
    }

    .section-header {
        padding: 1.25rem 1.5rem;
        background: #f8fafc;
        border-bottom: 1px solid #edf2f7;
    }

    .section-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .border-left-primary { border-left: 5px solid #3b82f6 !important; }
    .border-left-info { border-left: 5px solid #0ea5e9 !important; }
    .border-left-warning { border-left: 5px solid #f59e0b !important; }
    .border-left-success { border-left: 5px solid #10b981 !important; }
    .border-left-danger { border-left: 5px solid #ef4444 !important; }

    .form-label { font-size: 0.9rem; margin-bottom: 0.5rem; }
    .form-control, .form-select {
        border-radius: 8px;
        padding: 0.6rem 1rem;
        border-color: #e2e8f0;
    }

    .form-control:focus, .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }
</style>

@section Scripts {
<script>
    $(document).ready(function() {
        var mvcData = null;

        function renderMVCDetails(data) {
            var html = `
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="text-primary fw-bold mb-3 d-flex align-items-center"><i class="bi bi-info-circle me-2"></i>Basic Information</h6>
                        <div class="bg-light p-3 rounded rounded-3">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><th class="text-muted" width="40%">MVC Number</th><td class="fw-bold">${data.mvcNo || 'N/A'}</td></tr>
                                <tr><th class="text-muted">Year</th><td class="fw-bold">${data.mvcYear || 'N/A'}</td></tr>
                                <tr><th class="text-muted">MACT</th><td class="fw-bold">${data.mactName || 'N/A'}</td></tr>
                                <tr><th class="text-muted">Division</th><td class="fw-bold">${data.divisionName || 'N/A'}</td></tr>
                                <tr><th class="text-muted">Status</th><td><span class="badge ${data.disposalResult === 'Against' ? 'bg-danger' : (data.disposalResult === 'Favor' ? 'bg-success' : 'bg-secondary')}">${data.disposalResult || 'Pending'}</span></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary fw-bold mb-3 d-flex align-items-center"><i class="bi bi-car-front me-2"></i>Accident & Claim</h6>
                        <div class="bg-light p-3 rounded rounded-3">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><th class="text-muted" width="40%">Accident Date</th><td class="fw-bold">${data.accidentDate ? new Date(data.accidentDate).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) : 'N/A'}</td></tr>
                                <tr><th class="text-muted">Vehicle No</th><td class="fw-bold text-primary">${data.vehicleNo || 'N/A'}</td></tr>
                                <tr><th class="text-muted">Claim Amount</th><td class="fw-bold text-success">₹ ${data.claimAmount ? data.claimAmount.toLocaleString('en-IN', {minimumFractionDigits: 2}) : '0.00'}</td></tr>
                            </table>
                        </div>
                    </div>
                    
                    <div class="col-md-12">
                         <h6 class="text-primary fw-bold mb-3 d-flex align-items-center"><i class="bi bi-people me-2"></i>Petitioners Information</h6>
                         <div class="table-responsive rounded border">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th class="ps-3">#</th><th>Petitioner Name</th><th>Relationship</th></tr></thead>
                                <tbody>
                                    ${data.petitioners && data.petitioners.length > 0 ? 
                                        data.petitioners.map((p, i) => `<tr><td class="ps-3">${i+1}</td><td>${p.petitionerName}</td><td>${p.relationship || '-'}</td></tr>`).join('') : 
                                        '<tr><td colspan="3" class="text-center py-2 text-muted italic">No petitioners listed</td></tr>'
                                    }
                                </tbody>
                            </table>
                         </div>
                    </div>

                    ${data.adverseAward ? `
                    <div class="col-md-12">
                        <h6 class="text-danger fw-bold mb-3 d-flex align-items-center"><i class="bi bi-hammer me-2"></i>Award Particulars (Adverse)</h6>
                        <div class="card border-danger border-opacity-25 bg-danger bg-opacity-10">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Award Amount</small>
                                        <span class="fw-bold text-danger fs-5">₹ ${data.adverseAward.awardAmount ? data.adverseAward.awardAmount.toLocaleString('en-IN', {minimumFractionDigits: 2}) : '0.00'}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Interest Rate</small>
                                        <span class="fw-bold">${data.adverseAward.interestRate || 0}%</span>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Award Date</small>
                                        <span class="fw-bold">${data.adverseAward.awardDate ? new Date(data.adverseAward.awardDate).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) : 'N/A'}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    ` : ''}

                    ${data.linkedAppeal ? `
                    <div class="col-md-12">
                        <h6 class="text-warning fw-bold mb-3 d-flex align-items-center"><i class="bi bi-shield-check me-2"></i>Appeal & Compliance Status</h6>
                        <div class="bg-warning bg-opacity-10 p-3 rounded border border-warning border-opacity-25">
                            <div class="row g-3">
                                <div class="col-md-4"><small class="text-muted d-block">Corporation MFA</small> <strong>${data.linkedAppeal.corpMFANumber ? data.linkedAppeal.corpMFANumber + '/' + data.linkedAppeal.corpMFAYear : 'Not Filed'}</strong></div>
                                <div class="col-md-4"><small class="text-muted d-block">Compliance</small> <span class="badge bg-success">${data.linkedAppeal.finalComplianceStatus || 'Pending'}</span></div>
                                <div class="col-md-4"><small class="text-muted d-block">Amt Deposited</small> <span class="fw-bold text-success">₹ ${data.linkedAppeal.amountDeposited ? data.linkedAppeal.amountDeposited.toLocaleString('en-IN') : '0.00'}</span></div>
                            </div>
                        </div>
                    </div>
                    ` : ''}
                </div>
            `;
            return html;
        }

        $('#btnViewMVCDetails').on('click', function() {
            var mvcNo = ($('#ArisingFromMVCNo').val() || '').trim();
            var mvcYear = ($('#ArisingFromMVCYear').val() || '').trim();
            var mactId = $('#ArisingFromMACTID').val();

            if (!mvcNo || !mvcYear || !mactId) {
                alert("Please provide MVC Number, Year, and MACT Tribunal to view details.");
                return;
            }

            $('#mvcDetailsContent').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Fetching details...</p></div>');
            $('#mvcDetailsModal').modal('show');

            $.ajax({
                url: '/Appeal/GetMVCDetails',
                type: 'GET',
                data: { mvcNo: mvcNo, mvcYear: mvcYear, mactId: mactId },
                success: function(data) {
                    if (data) {
                        mvcData = data;
                        $('#mvcDetailsContent').html(renderMVCDetails(data));
                        fetchCaseStatus();
                    } else {
                        $('#mvcDetailsContent').html('<div class="alert alert-warning m-4"><i class="bi bi-exclamation-triangle me-2"></i>No matching case found with the provided details.</div>');
                    }
                },
                error: function() {
                    $('#mvcDetailsContent').html('<div class="alert alert-danger m-4"><i class="bi bi-bug me-2"></i>Error occurred while fetching case details.</div>');
                }
            });
        });

        function fetchCaseStatus() {
            var mvcNo = ($('#ArisingFromMVCNo').val() || '').trim();
            var mvcYear = ($('#ArisingFromMVCYear').val() || '').trim();
            var mactId = $('#ArisingFromMACTID').val();

            if (mvcNo && mvcYear && mactId) {
                $.ajax({
                    url: '@Url.Action("GetCaseStatus", "EP")',
                    type: 'GET',
                    data: { mvcNo: mvcNo, mvcYear: mvcYear, mactId: mactId },
                    success: function(data) {
                        if (data) {
                            $('#OriginalMVCStatus').val(data.status);
                            $('#CaseID').val(data.caseId);
                        } else {
                            $('#OriginalMVCStatus').val('');
                            $('#CaseID').val('0');
                        }
                    }
                });
            }
        }

        $('#EPCourt, #ArisingFromMACTID, #AdvocateID').select2({
            theme: 'bootstrap-5',
            width: '100%',
            allowClear: true,
            placeholder: function() {
                return $(this).data('placeholder') || '-- SELECT --';
            }
        });

        $('#AdvocateID').on('change select2:select', function() {
            $('#AdvocateName').val($(this).find('option:selected').text());
        });

        function toggleDisposalDetails() {
            var val = $('#ddlCaseOutcome').val();
            if (val === 'Disposed') {
                $('#divDisposalDetails').slideDown(200);
            } else {
                $('#divDisposalDetails').slideUp(200);
            }
        }
        $('#ddlCaseOutcome').on('change', toggleDisposalDetails);
        toggleDisposalDetails();

        $('#ArisingFromMACTID').on('change select2:select', function() {
            $('#ArisingFromMACTName').val($(this).find('option:selected').text());
        });

        // Initialize MACT dropdown
        var currentMactName = $('#ArisingFromMACTName').val();
        if (currentMactName) {
            $("#ArisingFromMACTID option").each(function() {
                if ($(this).text() == currentMactName) $(this).prop('selected', true);
            });
        }

        $('#epForm').on('submit', function() {
            var $btn = $('#btnUpdate');
            if ($btn.hasClass('disabled')) return false;

            $btn.addClass('disabled').html('<span class="spinner-border spinner-border-sm me-2"></span>Updating...');
            return true;
        });
    });
</script>
    <partial name="_ValidationScriptsPartial" />
}