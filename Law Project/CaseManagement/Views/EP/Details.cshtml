@model MVCCaseManagement.Models.EPViewModel

@{
    ViewData["Title"] = "Execution Petition Details";
    ViewData["HidePageHeader"] = true;
    ViewData["PageHeaderClass"] = "ep-details-header";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 text-navy fw-bold"><i class="bi bi-file-earmark-text me-2"></i> EP Details: @Model.EPNumber / @Model.EPYear</h4>
            <span class="text-muted small">Arising from MVC Case: <strong>@Model.ArisingFromMVCNo / @Model.ArisingFromMVCYear</strong></span>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", "EP", new { id = Model.EPID })" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Edit EP Record
            </a>
            <a href="@Url.Action("Index", "EP")" class="btn btn-outline-secondary rounded-pill px-4">
                Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Section A: Basic EP Identification -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4 h-100 rounded-4 overflow-hidden border-start border-4 border-primary">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title text-primary fw-bold mb-0">
                        <i class="bi bi-file-earmark-medical me-2"></i>Section A: Basic EP Identification
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Division</small>
                            <div class="fw-bold fs-6">@(Model.DivisionName ?? "Not Available")</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">EP Court</small>
                            <div class="fw-bold fs-6 text-primary">@(Model.EPCourt ?? "No Court Specified")</div>
                        </div>
                        <hr class="text-muted opacity-25" />
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Arising MVC No / Year</small>
                            <div class="fw-bold fs-6 text-dark">@Model.ArisingFromMVCNo / @Model.ArisingFromMVCYear</div>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">MACT Tribunal</small>
                            <div class="fw-bold text-dark">@(Model.ArisingFromMACT ?? "MACT")</div>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Original MVC Status</small>
                            <div>
                                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">@(Model.OriginalMVCStatus ?? "Unknown")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section B: Entrustment & Advocate Details -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4 h-100 rounded-4 overflow-hidden border-start border-4 border-info">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title text-info fw-bold mb-0">
                        <i class="bi bi-person-badge me-2"></i>Section B: Entrustment & Advocate
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Assigned Advocate</small>
                        <div class="fw-bold text-dark fs-6">@(Model.AdvocateName ?? "Not Assigned")</div>
                    </div>
                    <hr class="text-muted opacity-25" />
                    <div class="row g-3">
                        <div class="col-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Entrustment No.</small>
                            <div class="fw-bold text-dark">@(Model.EP_EntrustmentNo ?? "-")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Entrustment Date</small>
                            <div class="fw-bold text-dark">@(Model.EP_EntrustmentDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section C: Case Status & Stage -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 mb-4 h-100 rounded-4 overflow-hidden border-start border-4 border-warning">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title text-warning fw-bold mb-0">
                        <i class="bi bi-activity me-2"></i>Section C: Case Status & Stage
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Current Status / Stage of EP</small>
                            <div class="fw-bold fs-6 text-dark mb-2">@(Model.EPStatus ?? "Pending")</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-2" style="font-size: 0.65rem;">Next Date of Hearing</small>
                            @if (Model.NextHearingDate.HasValue)
                            {
                                <div class="d-flex align-items-center">
                                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 45px; height: 45px;">
                                        <span>@Model.NextHearingDate.Value.Day</span>
                                    </div>
                                    <div>
                                        <div class="fw-bold">@Model.NextHearingDate.Value.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">@Model.NextHearingDate.Value.DayOfWeek</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted italic">No hearing date scheduled</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section D: Case Outcome / Result -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 mb-4 h-100 rounded-4 overflow-hidden border-start border-4 border-success">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title text-success fw-bold mb-0">
                        <i class="bi bi-trophy me-2"></i>Section D: Case Outcome / Result
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Case Outcome</small>
                            <span class="badge @(Model.CaseOutcome == "Disposed" ? "bg-success" : "bg-warning text-dark") fs-6 px-3 py-2">
                                @(Model.CaseOutcome ?? "Pending")
                            </span>
                        </div>
                        @if (Model.CaseOutcome == "Disposed")
                        {
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Date of Disposal</small>
                                <div class="fw-bold">@(Model.DisposalDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Closure Date</small>
                                <div class="fw-bold">@(Model.ClosureDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.DisposalRemarks))
                            {
                                <div class="col-12 mt-2">
                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Closure Remarks</small>
                                    <div class="bg-light p-2 rounded small text-muted border">@Model.DisposalRemarks</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .ep-details-header {
        background: linear-gradient(to right, #f8fafc, #f1f5f9);
        border-bottom: 1px solid #e2e8f0;
    }
    .text-navy { color: #1e3a8a; }
</style>
