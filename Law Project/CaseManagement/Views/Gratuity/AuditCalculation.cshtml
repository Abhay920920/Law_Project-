@{
    ViewData["Title"] = "Gratuity Audit / Interest Calculator";
    ViewData["PageHeaderClass"] = "audit-create-header";
    ViewData["HidePageHeader"] = true;
}

<div class="container-fluid px-4 py-4">
    <div class="form-container">
        <!-- Header -->
        <div class="section-card mb-4 border-0 shadow-sm overflow-hidden">
            <div class="bg-primary bg-opacity-10 p-3 border-bottom border-primary border-opacity-25">
                <h5 class="mb-0 fw-bold text-primary">
                    <i class="bi bi-calculator me-2"></i>
                    Gratuity Interest & Audit Calculator
                </h5>
                <small class="text-muted">Standalone Calculator Tool</small>
            </div>
        </div>

        <!-- Essential Audit Fields -->
        <div class="section-card border-left-primary mb-4 shadow-sm">
            <div class="section-header">
                <h6 class="mb-0 text-primary fw-bold">Case & Award Details</h6>
            </div>
            <div class="section-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark">PGA Number / Case Ref</label>
                        <input type="text" id="PGANumber" class="form-control" placeholder="Optional Case Reference" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark">Employee Name</label>
                        <input type="text" id="EmployeeName" class="form-control" placeholder="Optional Employee Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark">Calculation Method</label>
                        <select id="CalculationMethod" class="form-select">
                            <option value="InterestDeduction">Interest Deduction (Payment covers Interest first)</option>
                            <option value="PrincipalDeduction" selected>Principal Deduction (Payment reduced from Principal first)</option>
                        </select>
                    </div>
                </div>
                
                <!-- Search Status Alert -->
                <div id="caseSearchStatus" class="alert alert-info d-none mb-3 py-2">
                    <i class="bi bi-info-circle me-2"></i><span id="caseSearchMsg"></span>
                </div>
                
                <div id="caseDetailsBox" class="d-none mb-4">
                    <div class="card border-info shadow-sm">
                        <div class="card-header bg-info bg-opacity-10 text-info fw-bold d-flex justify-content-between align-items-center py-2">
                            <span><i class="bi bi-file-earmark-person me-2"></i>Linked Case Information</span>
                            <span class="badge bg-info text-dark" id="lblCaseStatus">-</span>
                        </div>
                        <div class="card-body p-3 bg-light">
                            <div class="row g-2 small">
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Court</span>
                                    <strong id="lblCourtType" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Designation</span>
                                    <strong id="lblDesignation" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Working Status</span>
                                    <strong id="lblWorkingStatus" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Service Period</span>
                                    <strong id="lblServicePeriod" class="text-dark">-</strong>
                                </div>
                                
                                <div class="col-12"><hr class="my-1 border-secondary opacity-25"></div>
                                
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Amount Claimed</span>
                                    <strong id="lblAmountClaimed" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Date of Appointment</span>
                                    <strong id="lblAppointmentDate" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Entrustment No & Date</span>
                                    <strong class="text-dark"><span id="lblEntrustmentNo">-</span> / <span id="lblEntrustmentDate">-</span></strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Advocate</span>
                                    <strong id="lblAdvocate" class="text-dark">-</strong>
                                </div>

                                <div class="col-12"><hr class="my-1 border-secondary opacity-25"></div>

                                <div class="col-md-3">
                                    <span class="text-muted d-block">Current Stage</span>
                                    <strong id="lblCurrentStage" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Next Hearing Date</span>
                                    <strong id="lblNextHearingDate" class="text-dark">-</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Default Interest Rate</span>
                                    <strong class="text-danger"><span id="lblInterestRate">-</span>%</strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Ordered Amount (CA)</span>
                                    <strong class="text-success fw-bold">₹ <span id="lblOrderedCA">-</span></strong>
                                </div>

                                <div class="col-12"><hr class="my-1 border-secondary opacity-25"></div>

                                <div class="col-md-3">
                                    <span class="text-muted d-block">Gratuity Corp (Reg/Act)</span>
                                    <strong class="text-dark">₹ <span id="lblCorpReg">-</span> / ₹ <span id="lblCorpAct">-</span></strong>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted d-block">Gratuity CA (Reg/Act)</span>
                                    <strong class="text-dark">₹ <span id="lblCAReg">-</span> / ₹ <span id="lblCAAct">-</span></strong>
                                </div>
                                <div class="col-md-6">
                                    <span class="text-muted d-block">Total Actual Paid (Corp / CA)</span>
                                    <strong class="text-primary">₹ <span id="lblPaidCorp">-</span> / ₹ <span id="lblPaidCA">-</span></strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-danger">Diff Amt *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input type="number" id="AwardAmount" class="form-control" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-danger">CA Award Amount</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input type="number" id="FinalAmount" class="form-control" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-danger">Date of Retirement *</label>
                        <input type="date" id="PetitionDate" class="form-control" />
                        <small class="text-muted">Date from which interest is calculated</small>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-danger">Rate of Interest *</label>
                        <div class="input-group">
                            <input type="number" id="InterestRate" class="form-control" placeholder="10.00" />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Calculation End Date / Realization Date</label>
                        <input type="date" id="RealizationDate" class="form-control" />
                        <small class="text-muted">Leave blank to calculate up to today</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Details -->
        <div class="section-card border-left-info mb-4 shadow-sm">
            <div class="section-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 text-info fw-bold">Payments Made</h6>
                <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-3" id="btnAddPayment">
                    <i class="bi bi-plus-lg me-1"></i> Add Payment
                </button>
            </div>
            <div class="section-body p-0">
                <div class="table-responsive">
                    <table class="table table-flush align-middle mb-0" id="paymentsTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Amount (₹)</th>
                                <th>Date Paid</th>
                                <th>Cheque/Ref No</th>
                                <th>Remarks</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="empty-placeholder">
                                <td colspan="5" class="text-center py-4 text-muted fst-italic">
                                    No payment records. Click "Add Payment" to log partial payments.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Calculation Summary -->
        <div class="section-card border-left-warning mb-4 shadow-sm" id="calculationSection">
            <div class="section-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 text-warning fw-bold">
                    <i class="bi bi-calculator me-2"></i>Calculation Summary
                </h6>
                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3" onclick="printCalculation()">
                    <i class="bi bi-printer me-1"></i> Print Report
                </button>
            </div>
            <div class="section-body p-4">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted">CA Award Amount</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input type="text" id="calcAwardAmount" class="form-control bg-light" readonly />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted">Diff Amt</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input type="text" id="calcDiffAmount" class="form-control bg-light" readonly />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-muted">Total Interest Accrued</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input type="text" id="calcInterestAmount" class="form-control bg-light" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-primary">Total Paid</label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary-subtle text-primary">₹</span>
                            <input type="text" id="calcTotalPaid" class="form-control bg-primary-subtle fw-bold" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-danger">Balance Due</label>
                        <div class="input-group">
                            <span class="input-group-text bg-danger-subtle text-danger">₹</span>
                            <input type="text" id="calcBalanceDue" class="form-control bg-danger-subtle fw-bold" readonly />
                        </div>
                    </div>
                </div>
                
                <div class="row g-3 mt-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted">
                            <i class="bi bi-receipt me-1"></i>Step-by-Step Breakdown
                        </label>
                        <div id="paymentBreakdown" class="p-3 bg-light rounded border" style="max-height: 400px; overflow-y: auto;">
                            <p class="text-muted small mb-0 text-center">Enter award details and dates to generate calculation</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .audit-create-header {
        background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
        border-bottom: 1px solid #dcfce7;
    }
    .section-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
    }
    .section-header {
        padding: 1rem 1.5rem;
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }
    .section-body {
        background: white;
    }
    .border-left-primary { border-left: 5px solid #3b82f6 !important; }
    .border-left-primary .section-header { background-color: #eff6ff; }
    
    .border-left-info { border-left: 5px solid #0ea5e9 !important; }
    .border-left-info .section-header { background-color: #f0f9ff; }
    
    .border-left-warning { border-left: 5px solid #f59e0b !important; }
    .border-left-warning .section-header { background-color: #fffbeb; }
    
    .border-left-success { border-left: 5px solid #10b981 !important; }
    .border-left-success .section-header { background-color: #f0fdf4; }

    .table-flush td, .table-flush th {
        border-top: none;
        padding: 0.75rem 0.5rem;
    }
</style>

@section Scripts {
    <script>
    var auditSteps = [];
    $(document).ready(function () {
        let rowCount = 0;

        // Auto-fetch Case Details based on PGA Number
        $('#PGANumber').on('change', function() {
            const pgaNo = $(this).val();

            if (pgaNo && pgaNo.trim() !== '') {
                $('#caseSearchStatus').removeClass('d-none alert-success alert-danger').addClass('alert-info');
                $('#caseSearchMsg').html('<span class="spinner-border spinner-border-sm me-2"></span>Searching for case details...');
                $('#caseDetailsBox').addClass('d-none');
                
                $.get('/Gratuity/FindCaseDetails', { pgaNumber: pgaNo })
                    .done(function(data) {
                        $('#caseSearchStatus').removeClass('alert-info alert-danger').addClass('alert-success');
                        $('#caseSearchMsg').html(`<strong>Case Found!</strong> Linked to Employee: ${data.employeeName}`);
                        
                        // Populate details box
                        $('#lblCaseStatus').text(data.caseStatus || 'N/A');
                        $('#lblCourtType').text(data.courtType || 'N/A');
                        $('#lblDesignation').text(data.designation || 'N/A');
                        $('#lblWorkingStatus').text(data.workingStatus || 'N/A');
                        $('#lblServicePeriod').text(data.totalServicePeriod || 'N/A');
                        $('#lblAmountClaimed').text(data.amountClaimed || 'N/A');
                        $('#lblAppointmentDate').text(data.appointmentDate || 'N/A');
                        $('#lblEntrustmentNo').text(data.entrustmentNo || 'N/A');
                        $('#lblEntrustmentDate').text(data.entrustmentDate || 'N/A');
                        $('#lblAdvocate').text(data.advocateName || 'N/A');
                        $('#lblCurrentStage').text(data.currentStage || 'N/A');
                        $('#lblNextHearingDate').text(data.nextHearingDate || 'N/A');
                        $('#lblInterestRate').text(data.interestRate || '0');
                        
                        $('#lblOrderedCA').text(data.orderedCA || '0.00');
                        $('#lblCorpReg').text(data.gratuityCorpReg || '0.00');
                        $('#lblCorpAct').text(data.gratuityCorpAct || '0.00');
                        $('#lblCAReg').text(data.gratuityCAReg || '0.00');
                        $('#lblCAAct').text(data.gratuityCAAct || '0.00');
                        $('#lblPaidCorp').text(data.actualPaid || '0.00');
                        $('#lblPaidCA').text(data.actualPaidCA || '0.00');

                        $('#caseDetailsBox').removeClass('d-none');

                        // Auto-populate form fields
                        if(data.employeeName) $('#EmployeeName').val(data.employeeName);
                        if(data.awardAmount > 0) $('#AwardAmount').val(data.awardAmount);
                        if(data.interestRate) $('#InterestRate').val(data.interestRate);
                        if(data.retirementDate) $('#PetitionDate').val(data.retirementDate);

                        // Auto-populate payments
                        $('#paymentsTable tbody').empty();
                        rowCount = 0;
                        if (data.payments && data.payments.length > 0) {
                            data.payments.forEach(function(p) {
                                const newRow = `
                                    <tr>
                                        <td class="ps-4">
                                            <input type="number" step="0.01" name="Payments[${rowCount}].Amount" class="form-control form-control-sm" value="${p.amount || ''}" required />
                                        </td>
                                        <td>
                                            <input type="date" name="Payments[${rowCount}].ChequeDate" class="form-control form-control-sm" value="${p.chequeDate || ''}" required />
                                        </td>
                                        <td>
                                            <input type="text" name="Payments[${rowCount}].ChequeNumber" class="form-control form-control-sm" value="${p.chequeNumber || ''}" />
                                        </td>
                                        <td>
                                            <input type="text" name="Payments[${rowCount}].Remarks" class="form-control form-control-sm" value="${p.remarks || ''}" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm border-0 remove-row">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                `;
                                $('#paymentsTable tbody').append(newRow);
                                rowCount++;
                            });
                        } else {
                            $('#paymentsTable tbody').append(`
                                <tr class="empty-placeholder">
                                    <td colspan="5" class="text-center py-4 text-muted fst-italic">
                                        No payment records found. Click "Add Payment" to log partial payments.
                                    </td>
                                </tr>
                            `);
                        }
                        
                        // Trigger calc
                        calculateAudit();
                    })
                    .fail(function() {
                        $('#caseSearchStatus').removeClass('alert-info alert-success').addClass('alert-danger');
                        $('#caseSearchMsg').html('<strong>No matching case found.</strong> Please verify the PGA Number.');
                        $('#caseDetailsBox').addClass('d-none');
                    })
                    .always(function() {
                        $('#caseSearchStatus').removeClass('d-none');
                    });
            } else {
                $('#caseSearchStatus').addClass('d-none');
                $('#caseDetailsBox').addClass('d-none');
            }
        });

        $('#btnAddPayment').click(function () {
            $('.empty-placeholder').remove();
            
            const newRow = `
                <tr>
                    <td class="ps-4">
                        <input type="number" step="0.01" name="Payments[${rowCount}].Amount" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <input type="date" name="Payments[${rowCount}].ChequeDate" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <input type="text" name="Payments[${rowCount}].ChequeNumber" class="form-control form-control-sm" />
                    </td>
                    <td>
                        <input type="text" name="Payments[${rowCount}].Remarks" class="form-control form-control-sm" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm border-0 remove-row">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            
            $('#paymentsTable tbody').append(newRow);
            rowCount++;
        });

        $(document).on('click', '.remove-row', function () {
            $(this).closest('tr').remove();
            reindexRows();
            calculateAudit();
        });

        function reindexRows() {
            rowCount = 0;
            $('#paymentsTable tbody tr').each(function () {
                if ($(this).hasClass('empty-placeholder')) return;
                
                $(this).find('input').each(function () {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace(/\[\d+\]/, `[${rowCount}]`));
                    }
                });
                rowCount++;
            });

            if (rowCount === 0) {
                $('#paymentsTable tbody').append(`
                    <tr class="empty-placeholder">
                        <td colspan="5" class="text-center py-4 text-muted fst-italic">
                            No payment records. Click "Add Payment" to log partial payments.
                        </td>
                    </tr>
                `);
            }
        }

        // Audit Calculation Logic
        function calculateAudit() {
            auditSteps = []; // Reset steps

            // Get input values
            const awardAmount = parseFloat($('#AwardAmount').val()) || 0;
            const finalAmount = parseFloat($('#FinalAmount').val()) || parseFloat($('#AwardAmount').val()) || 0;
            const interestRate = parseFloat($('#InterestRate').val()) || 0;
            const petitionDate = $('#PetitionDate').val();
            const realizationDate = $('#RealizationDate').val();
            const calcMethod = $('#CalculationMethod').val(); 

            if (finalAmount <= 0) {
                $('#paymentBreakdown').html('<p class="text-muted small mb-0 text-center">Please enter a valid Final Amount</p>');
                clearSummaries();
                return;
            }
            if (!petitionDate) {
                 $('#paymentBreakdown').html('<p class="text-muted small mb-0 text-center">Please enter the Interest Start Date</p>');
                 clearSummaries();
                 return;
            }

            let payments = [];
            $('#paymentsTable tbody tr:not(.empty-placeholder)').each(function() {
                const amount = parseFloat($(this).find('input[name*="Amount"]').val()) || 0;
                const chequeDate = $(this).find('input[name*="ChequeDate"]').val();
                const chequeNo = $(this).find('input[name*="ChequeNumber"]').val() || '';
                
                if (amount > 0 && chequeDate) {
                    payments.push({
                        amount: amount,
                        date: new Date(chequeDate),
                        chequeNo: chequeNo
                    });
                }
            });

            payments.sort((a, b) => a.date - b.date);

            let currentPrincipal = finalAmount;
            let balanceInterest = 0; 
            let totalPaid = 0;
            let totalInterestAccrued = 0;
            let paymentBreakdownHtml = '';
            
            let lastDate = new Date(petitionDate);
            const endDate = realizationDate ? new Date(realizationDate) : new Date();
            
            lastDate.setHours(12, 0, 0, 0);
            endDate.setHours(12, 0, 0, 0);

            const renderStep = (title, amount, desc, isNegative = false) => {
                 const colorClass = isNegative ? "text-danger" : "text-success";
                 const bgClass = isNegative ? "bg-danger-subtle" : "bg-white";
                 const sign = isNegative ? "- " : "+ ";
                 
                 const totalDue = Math.max(0, currentPrincipal + balanceInterest);
                 
                 auditSteps.push({
                     title: title.replace(/<br>/g, ' '),
                     desc: desc ? desc.replace(/<br>/g, ' ') : '',
                     amount: (isNegative ? -1 : 1) * amount,
                     totalDue: totalDue
                 });

                 return `
                    <div class="p-2 ${bgClass} border-bottom">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">
                                ${title}
                                ${desc ? `<br><small class="text-primary">${desc}</small>` : ''}
                            </span>
                            <span class="${colorClass} small fw-bold">${sign}₹ ${amount.toFixed(2)}</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1 pt-1 border-top">
                            <span class="fw-semibold small">Net Payable</span>
                            <span class="fw-bold">₹ ${totalDue.toFixed(2)}</span>
                        </div>
                    </div>
                 `;
            };
            
            paymentBreakdownHtml += `
                <div class="p-2 bg-light border-bottom border-primary">
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold text-primary">CA Award Amount</span>
                        <span class="fw-bold text-primary">₹ ${currentPrincipal.toFixed(2)}</span>
                    </div>
                     <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted small">Method</span>
                        <span class="fw-bold small text-info">${calcMethod === 'PrincipalDeduction' ? 'Principal Deduction' : 'Interest Deduction'}</span>
                    </div>
                </div>`;

            let isFirstPeriod = true;
            payments.forEach((payment, index) => {
                const paymentDate = payment.date;
                paymentDate.setHours(12, 0, 0, 0);

                if (currentPrincipal > 0) {
                    const timeDiff = paymentDate - lastDate;
                    const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
                    
                    if (days > 0) {
                        const interest = (currentPrincipal * interestRate * days) / (365 * 100);
                        balanceInterest += interest;
                        totalInterestAccrued += interest;
                        
                        let displayFrom = new Date(lastDate);
                        if (!isFirstPeriod) displayFrom.setDate(displayFrom.getDate() + 1);
                        isFirstPeriod = false;

                        paymentBreakdownHtml += renderStep(
                            `Interest @@ ${interestRate}% on ₹ ${currentPrincipal.toFixed(2)}`, 
                            interest, 
                            `From: ${displayFrom.toLocaleDateString('en-IN')} To: ${paymentDate.toLocaleDateString('en-IN')} (${days} days)`
                        );
                    }
                }

                totalPaid += payment.amount;
                let remainingPayment = payment.amount;
                let interestPaid = 0;
                let principalPaid = 0;

                if (calcMethod === 'InterestDeduction') {
                    if (balanceInterest > 0) {
                        interestPaid = Math.min(balanceInterest, remainingPayment);
                        balanceInterest -= interestPaid;
                        remainingPayment -= interestPaid;
                    }
                    if (remainingPayment > 0) {
                        principalPaid = remainingPayment;
                        currentPrincipal -= principalPaid;
                    }
                } else {
                    if (currentPrincipal > 0) {
                        principalPaid = Math.min(currentPrincipal, remainingPayment);
                        currentPrincipal -= principalPaid;
                        remainingPayment -= principalPaid;
                    }
                    if (remainingPayment > 0 && balanceInterest > 0) {
                        interestPaid = Math.min(balanceInterest, remainingPayment);
                        balanceInterest -= interestPaid;
                        remainingPayment -= interestPaid;
                    }
                }

                paymentBreakdownHtml += renderStep(
                    `Payment ${index + 1}${payment.chequeNo ? ' (Ref: ' + payment.chequeNo + ')' : ''}`, 
                    payment.amount, 
                    `Date: ${paymentDate.toLocaleDateString('en-IN')} <br> (Interest Adj: ₹${interestPaid.toFixed(2)}, Principal Adj: ₹${principalPaid.toFixed(2)})`, 
                    true
                );
                
                lastDate = paymentDate;
            });

            const hasDiffAmt = !isNaN(parseFloat($('#AwardAmount').val())) && parseFloat($('#AwardAmount').val()) > 0;
            if (hasDiffAmt && awardAmount !== finalAmount) {
                currentPrincipal = awardAmount;
                paymentBreakdownHtml += `
                    <div class="p-2 bg-light border-bottom border-info">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold text-info">Diff Amt Applied</span>
                            <span class="fw-bold text-info">₹ ${currentPrincipal.toFixed(2)}</span>
                        </div>
                    </div>`;
            }

            if (currentPrincipal > 0) {
                 const timeDiff = endDate - lastDate;
                 const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
                 
                 if (days > 0) {
                    const interest = (currentPrincipal * interestRate * days) / (365 * 100);
                    balanceInterest += interest;
                    totalInterestAccrued += interest;
                    
                    let displayFrom = new Date(lastDate);
                    if (!isFirstPeriod) displayFrom.setDate(displayFrom.getDate() + 1);

                    paymentBreakdownHtml += renderStep(
                        `${hasDiffAmt ? 'Interest on Diff Amt' : 'Interest'} @@ ${interestRate}% on ₹ ${currentPrincipal.toFixed(2)}`, 
                        interest, 
                        `From: ${displayFrom.toLocaleDateString('en-IN')} To: ${endDate.toLocaleDateString('en-IN')} (${days} days)`
                    );
                 }
            } else if (currentPrincipal <= 0 && balanceInterest <= 0) {
                 paymentBreakdownHtml += `
                    <div class="p-2 bg-success-subtle border-bottom">
                        <div class="text-center">
                            <span class="text-success fw-bold small">
                                <i class="bi bi-check-circle me-1"></i>Fully Paid
                            </span>
                        </div>
                    </div>
                `;
            }

            const finalTotalDue = Math.max(0, currentPrincipal + balanceInterest);

            $('#calcAwardAmount').val(finalAmount.toFixed(2));
            $('#calcDiffAmount').val(awardAmount > 0 ? awardAmount.toFixed(2) : '0.00');
            $('#calcInterestAmount').val(totalInterestAccrued.toFixed(2));
            $('#calcTotalPaid').val(totalPaid.toFixed(2));
            $('#calcBalanceDue').val(finalTotalDue.toFixed(2));
            
            if (paymentBreakdownHtml) {
                $('#paymentBreakdown').html(paymentBreakdownHtml);
            }
        }

        function clearSummaries() {
            $('#calcAwardAmount').val('');
            $('#calcDiffAmount').val('');
            $('#calcInterestAmount').val('');
            $('#calcTotalPaid').val('');
            $('#calcBalanceDue').val('');
        }

        $('#AwardAmount, #InterestRate, #PetitionDate, #RealizationDate, #CalculationMethod').on('input change', calculateAudit);
        $(document).on('input change', 'input[name*="Amount"], input[name*="ChequeDate"]', calculateAudit);

        // Print Calculation Function
        window.printCalculation = function() {
            const pgaNo = $('#PGANumber').val() || 'N/A';
            const empName = $('#EmployeeName').val() || 'N/A';
            const petitionDate = $('#PetitionDate').val() ? new Date($('#PetitionDate').val()).toLocaleDateString('en-IN') : 'N/A';
            const realizationDate = $('#RealizationDate').val() ? new Date($('#RealizationDate').val()).toLocaleDateString('en-IN') : 'N/A';
            const interestRate = $('#InterestRate').val() || '0';
            const calcMethod = $('#CalculationMethod option:selected').text();
            
            let breakdownTableHtml = `
                <table class="breakdown-table">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Particulars / Period</th>
                            <th style="text-align: right;">Amount (₹)</th>
                            <th style="text-align: right;">Net Payable (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            if (auditSteps.length > 0) {
                auditSteps.forEach(step => {
                    const isCredit = step.amount < 0;
                    breakdownTableHtml += `
                        <tr>
                            <td>
                                <strong>${step.title}</strong><br>
                                <small>${step.desc}</small>
                            </td>
                            <td style="text-align: right; color: ${isCredit ? '#dc3545' : '#198754'};">
                                ${isCredit ? '-' : '+'} ₹${Math.abs(step.amount).toFixed(2)}
                            </td>
                            <td style="text-align: right; font-weight: bold;">
                                ₹${step.totalDue.toFixed(2)}
                            </td>
                        </tr>
                    `;
                });
            } else {
                breakdownTableHtml += '<tr><td colspan="3" style="text-align: center;">No calculation steps recorded.</td></tr>';
            }
            breakdownTableHtml += '</tbody></table>';

            const printContent = `
                <html>
                <head>
                    <title>Gratuity Audit Calculation - ${pgaNo}</title>
                    <style>
                        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px; color: #333; }
                        .container { max-width: 800px; margin: 0 auto; }
                        h2 { text-align: center; color: #2c3e50; margin-bottom: 5px; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; }
                        .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; background: #f8f9fa; padding: 15px; border-radius: 5px; }
                        .meta-item { display: flex; flex-direction: column; }
                        .meta-label { font-size: 0.85em; color: #666; font-weight: bold; text-transform: uppercase; }
                        .meta-value { font-size: 1em; color: #000; font-weight: 500; }
                        
                        h4 { color: #2c3e50; margin-top: 25px; margin-bottom: 10px; border-left: 4px solid #0d6efd; padding-left: 10px; }
                        
                        table { width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 0.95em; }
                        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #dee2e6; }
                        th { background-color: #e9ecef; font-weight: 600; color: #495057; }
                        td { color: #212529; }
                        
                        .summary-table td:last-child { text-align: right; font-family: Consolas, monospace; font-weight: 600; }
                        .summary-table th:last-child { text-align: right; }
                        .total-row { background-color: #e8f5e9; font-weight: bold; font-size: 1.05em; }
                        
                        .breakdown-container { border: none; }
                        .breakdown-table { width: 100%; border: 1px solid #dee2e6; }
                        .breakdown-table th { background-color: #f8f9fa; border: 1px solid #dee2e6; }
                        .breakdown-table td { border: 1px solid #dee2e6; vertical-align: top; }
                        
                        .footer { margin-top: 40px; text-align: center; font-size: 0.8em; color: #999; border-top: 1px solid #eee; padding-top: 10px; }
                        
                        @@media print { 
                            .no-print { display: none !important; } 
                            body { font-size: 12pt; }
                            .meta-grid { border: 1px solid #ccc; }
                            h2 { border-bottom: 1px solid #000; }
                        }
                    </style>
                </head>
                <body>
                    <div class="container">
                        <h2>Gratuity Audit Calculation Report</h2>
                        
                        <div class="meta-grid">
                            <div class="meta-item"><span class="meta-label">PGA/Case Number</span><span class="meta-value">${pgaNo}</span></div>
                            <div class="meta-item"><span class="meta-label">Employee Name</span><span class="meta-value">${empName}</span></div>
                            <div class="meta-item"><span class="meta-label">Interest Start Date</span><span class="meta-value">${petitionDate}</span></div>
                            <div class="meta-item"><span class="meta-label">Calculation End Date</span><span class="meta-value">${realizationDate}</span></div>
                            <div class="meta-item"><span class="meta-label">Rate of Interest</span><span class="meta-value">${interestRate}%</span></div>
                            <div class="meta-item" style="grid-column: 1 / -1; border-top: 1px dashed #ccc; padding-top: 5px; margin-top: 5px;">
                                <span class="meta-label">Calculation Strategy</span>
                                <span class="meta-value">${calcMethod}</span>
                            </div>
                        </div>
                        
                        <h4>Financial Summary</h4>
                        <table class="summary-table">
                            <tr><th>Particulars</th><th>Amount (₹)</th></tr>
                            <tr><td>CA Award Amount</td><td>${$('#calcAwardAmount').val()}</td></tr>

                            <tr><td>Total Interest Accrued</td><td>${$('#calcInterestAmount').val()}</td></tr>
                            <tr class="total-row"><td>Total Amount Due (Before Payments)</td><td>${(parseFloat($('#calcAwardAmount').val()) + parseFloat($('#calcInterestAmount').val())).toFixed(2)}</td></tr>
                            <tr><td>Total Amount Paid</td><td>${$('#calcTotalPaid').val()}</td></tr>
                            <tr class="total-row" style="color: #dc3545;"><td>Balance Due</td><td>${$('#calcBalanceDue').val()}</td></tr>
                        </table>
                        
                        <h4>Detailed Calculation Breakdown</h4>
                        <div class="breakdown-container">
                            ${breakdownTableHtml}
                        </div>
                        
                        <div class="footer">
                            Generated on ${new Date().toLocaleString('en-IN')}
                        </div>
                        
                        <div class="no-print" style="text-align: center; margin-top: 30px;">
                            <button onclick="window.print()" style="padding: 10px 20px; cursor: pointer; background: #0d6efd; color: white; border: none; border-radius: 4px; font-size: 16px;">Print Report</button>
                            <button onclick="window.close()" style="padding: 10px 20px; cursor: pointer; background: #6c757d; color: white; border: none; border-radius: 4px; font-size: 16px; margin-left: 10px;">Close</button>
                        </div>
                    </div>
                </body>
                </html>
            `;
            
            const printWindow = window.open('', '_blank', 'width=900,height=800');
            printWindow.document.write(printContent);
            printWindow.document.close();
        };
    });
    </script>
}
