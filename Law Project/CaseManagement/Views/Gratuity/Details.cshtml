@model MVCCaseManagement.Models.GratuityCase

@{
    ViewData["Title"] = "Gratuity Case Details - " + Model.PGANumber;
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userDiv = User.FindFirst("DivisionID")?.Value;
    bool isCO = string.IsNullOrEmpty(userDiv) || userDiv == "0" || userDiv == "5";
}

<div class="d-print-none">
<div class="container-fluid fade-in py-3 py-md-4 px-2 px-md-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4 gratuity-header">
        <div class="w-100 w-md-auto">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Gratuity")" class="text-decoration-none">Gratuity Module</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("CaseList", "Gratuity")" class="text-decoration-none">Cases</a></li>
                    <li class="breadcrumb-item active text-muted">@Model.PGANumber</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <h1 class="h4 h3-md mb-0 text-gray-800 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-cash-coin text-gratuity"></i>@Model.PGANumber
                </h1>
                <span class="badge @(Model.DisposalResult == "Against" ? "bg-danger" : (Model.CaseStatus == "Disposed" ? "bg-success" : "bg-warning text-dark")) rounded-pill px-3 py-1.5 shadow-sm">
                    @(string.IsNullOrEmpty(Model.DisposalResult) ? (Model.CaseStatus ?? "Active / Pending") : Model.DisposalResult)
                </span>
                @if (!string.IsNullOrEmpty(Model.ForwardingStatus))
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                        <i class="bi bi-send me-1"></i>@Model.ForwardingStatus
                    </span>
                }
            </div>
            <div class="text-muted small mt-1 d-flex flex-wrap gap-3">
                <span><i class="bi bi-geo-alt me-1 text-secondary"></i>Division: <strong>@ViewBag.DivisionName</strong></span>
                <span><i class="bi bi-bank me-1 text-secondary"></i>Court: <strong>@(string.IsNullOrEmpty(Model.CourtType) ? "Controlling Authority" : Model.CourtType)</strong></span>
                @if (Model.NextHearingDate.HasValue && Model.CaseStatus != "Disposed")
                {
                    <span class="text-danger fw-bold"><i class="bi bi-calendar-event me-1"></i>Next Hearing: @Model.NextHearingDate.Value.ToShortDateString()</span>
                }
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 gratuity-header-actions w-100 w-md-auto">
            @if (ViewBag.IsCentralOffice == true || User.IsInRole("MD"))
            {
                var statusClean = (Model.ActionTaken ?? "").Trim().ToUpper();
                bool isPendingMD = statusClean == "PENDING BEFORE COMPETENT AUTHORITY" || statusClean == "PENDING AT CA";
                bool isApprovedOrRejected = statusClean == "APPROVED" || statusClean == "REJECTED" || statusClean == "CLOSED" || statusClean == "CLOSE";

                if (User.IsInRole("CLO"))
                {
                    if (!isPendingMD && !isApprovedOrRejected)
                    {
                        <a href="@Url.Action("CLOAction", "Gratuity", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill gratuity-action-btn">
                            <i class="bi bi-lightning-charge me-1"></i> ACTION
                        </a>
                    }
                    else if (isPendingMD)
                    {
                        <span class="badge bg-info text-dark p-2 px-3 rounded-pill gratuity-action-btn"><i class="bi bi-hourglass-split me-1"></i> Pending at MD level</span>
                    }
                }
                else if (User.IsInRole("MD"))
                {
                    if (!isApprovedOrRejected)
                    {
                        <a href="@Url.Action("Action", "Gratuity", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill border border-white border-2 gratuity-action-btn">
                            <i class="bi bi-lightning-charge me-1"></i> TAKE MD ACTION
                        </a>
                    }
                }
                else
                {
                    if (!isPendingMD && !isApprovedOrRejected)
                    {
                        <a href="@Url.Action("Action", "Gratuity", new { id = Model.CaseID })" class="btn btn-warning shadow-sm rounded-pill gratuity-action-btn">
                            <i class="bi bi-lightning-charge me-1"></i> ACTION
                        </a>
                    }
                }
            }
            @if (!isCO && Model.ForwardingStatus != "Sent to Central Office" && !User.IsInRole("Division Controller") && !User.IsInRole("DC"))
            {
                <a href="@Url.Action("Edit", "Gratuity", new { id = Model.CaseID })" class="btn btn-primary shadow-sm rounded-pill gratuity-action-btn">
                    <i class="bi bi-pencil-square me-1"></i> EDIT
                </a>
            }
            <a href="@Url.Action("AuditCalculation", "Gratuity", new { id = Model.CaseID })" class="btn btn-outline-info shadow-sm rounded-pill gratuity-action-btn">
                <i class="bi bi-calculator me-1"></i> Audit Sheet
            </a>
            <button type="button" class="btn btn-outline-primary shadow-sm rounded-pill gratuity-action-btn" data-bs-toggle="modal" data-bs-target="#gratuityFullDetailsModal">
                <i class="bi bi-journal-text me-1"></i> Full Record
            </button>
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm rounded-pill gratuity-action-btn">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- SUMMARY METRICS GRID -->
    <div class="row row-cols-2 row-cols-md-4 g-2 g-md-3 mb-3 mb-md-4 gratuity-summary-grid">
        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-2.5 p-md-3">
                    <small class="text-muted text-uppercase fw-bold xs d-block mb-1">Employee / Claimant</small>
                    <div class="fw-bold text-dark text-truncate" title="@Model.ClaimantName">@Model.ClaimantName</div>
                    <div class="small text-muted text-truncate" title="@Model.ClaimantDesignation">@(Model.ClaimantDesignation ?? "-")</div>
                    <div class="extra-small text-secondary mt-1">Status: <strong>@(Model.WorkingStatus ?? "Retired")</strong></div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100 @(Model.DisposalResult == "Against" ? "bg-danger text-white" : (Model.CaseStatus == "Disposed" ? "bg-success text-white" : "bg-warning text-dark"))">
                <div class="card-body p-2.5 p-md-3">
                    <small class="text-uppercase fw-bold xs d-block mb-1 opacity-75">Disposal & Stage</small>
                    <div class="fw-bold text-truncate" title="@(!string.IsNullOrEmpty(Model.DisposalResult) ? Model.DisposalResult : (Model.CaseStatus ?? "Pending"))">
                        @(!string.IsNullOrEmpty(Model.DisposalResult) ? Model.DisposalResult : (Model.CaseStatus ?? "Pending"))
                    </div>
                    @if (Model.DisposalDate.HasValue)
                    {
                        <div class="small text-truncate">Disposed: @Model.DisposalDate.Value.ToShortDateString()</div>
                    }
                    else if (!string.IsNullOrEmpty(Model.CurrentStage))
                    {
                        <div class="small text-truncate opacity-75">Stage: @Model.CurrentStage</div>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-2.5 p-md-3">
                    <small class="text-white-50 text-uppercase fw-bold xs d-block mb-1">CO Decision Tracking</small>
                    <div class="fw-bold text-truncate" title="@(!string.IsNullOrEmpty(Model.ForwardingStatus) ? Model.ForwardingStatus : "Internal")">
                        @(!string.IsNullOrEmpty(Model.ForwardingStatus) ? Model.ForwardingStatus : "Internal")
                    </div>
                    <div class="small text-white-50 text-truncate" title="Action: @(Model.ActionTaken ?? "None")">
                        Action: <strong>@(Model.ActionTaken ?? "None")</strong>
                    </div>
                    @if (Model.ApprovalDate.HasValue)
                    {
                        <div class="extra-small text-white-50 mt-0.5">Approved: @Model.ApprovalDate.Value.ToShortDateString()</div>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body p-2.5 p-md-3">
                    <small class="text-white-50 text-uppercase fw-bold xs d-block mb-1">Claim vs Order</small>
                    <div class="small text-truncate" title="Claimed: @(Model.AmountClaimed ?? "-")">
                        Claim: <strong>@(string.IsNullOrEmpty(Model.AmountClaimed) ? "-" : Model.AmountClaimed)</strong>
                    </div>
                    <div class="fw-bold text-truncate fs-6" title="Ordered: &#8377; @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")">
                        Ordered: &#8377; @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")
                    </div>
                    @if (Model.ActualPaidAmount.HasValue && Model.ActualPaidAmount > 0)
                    {
                        <div class="extra-small text-white-50">Paid: &#8377; @Model.ActualPaidAmount.Value.ToString("N2")</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN LAYOUT -->
    <div class="row g-3 g-md-4">
        <!-- LEFT COLUMN: Primary Financials, Assessments, Connected Appeals -->
        <div class="col-lg-8">
            <!-- Financial Assessment Card -->
            <div class="card border-0 shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-white py-2.5 py-md-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-gratuity d-flex align-items-center">
                        <i class="bi bi-calculator me-2"></i>Financial Assessment Summary
                    </h6>
                    <span class="badge bg-light text-dark border small">Assessment Comparison</span>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3 mb-3 mb-md-4">
                        <!-- Corporation Calculations -->
                        <div class="col-12 col-md-6 border-md-end pb-3 pb-md-0 border-bottom border-bottom-md-0">
                            <div class="p-2.5 rounded-3 bg-light border mb-2">
                                <h6 class="text-uppercase small fw-bold text-primary mb-2 d-flex align-items-center">
                                    <i class="bi bi-building me-1.5"></i> Corporation Assessment
                                </h6>
                                <div class="row g-2 small">
                                    <div class="col-6 text-muted">Qualifying Service:</div>
                                    <div class="col-6 fw-bold text-end">@(string.IsNullOrEmpty(Model.QualifyingService_Corp) ? (Model.TotalServicePeriod ?? "-") : Model.QualifyingService_Corp)</div>
                                    <div class="col-6 text-muted">Last Drawn Pay:</div>
                                    <div class="col-6 fw-bold text-end font-monospace">&#8377; @((Model.LastDrawnPay ?? (Model.LastDrawnBasic ?? 0) + (Model.LastDrawnBDA ?? 0) + (Model.LastDrawnDA ?? 0)).ToString("N2"))</div>
                                    <div class="col-6 text-muted extra-small ps-3">- Basic / BDA / DA:</div>
                                    <div class="col-6 text-end extra-small font-monospace">&#8377; @(Model.LastDrawnBasic?.ToString("N0") ?? "0") / @(Model.LastDrawnBDA?.ToString("N0") ?? "0") / @(Model.LastDrawnDA?.ToString("N0") ?? "0")</div>
                                </div>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <small class="text-muted d-block extra-small">As per Act</small>
                                    <h6 class="fw-bold mb-0 text-truncate font-monospace">&#8377; @(Model.GratuityAmount_Corp_Act?.ToString("N2") ?? "0.00")</h6>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block extra-small">As per Regulation</small>
                                    <h6 class="fw-bold mb-0 text-truncate font-monospace">&#8377; @(Model.GratuityAmount_Corp_Reg?.ToString("N2") ?? "0.00")</h6>
                                </div>
                            </div>
                            @if (Model.DeductionAmount.HasValue && Model.DeductionAmount > 0)
                            {
                                <div class="mt-2.5 p-2 bg-white rounded border border-warning-subtle small">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Corporation Deductions:</span>
                                        <span class="fw-bold text-danger font-monospace">&#8377; @Model.DeductionAmount.Value.ToString("N2")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.DeductionDetails))
                                    {
                                        <small class="text-secondary d-block mt-1 fst-italic">@Model.DeductionDetails</small>
                                    }
                                </div>
                            }
                        </div>
                        
                        <!-- Controlling Authority Calculations -->
                        <div class="col-12 col-md-6 pt-2 pt-md-0">
                            <div class="p-2.5 rounded-3 bg-light border mb-2">
                                <h6 class="text-uppercase small fw-bold text-danger mb-2 d-flex align-items-center">
                                    <i class="bi bi-bank me-1.5"></i> Controlling Authority (ALC)
                                </h6>
                                <div class="row g-2 small">
                                    <div class="col-6 text-muted">Qualifying Service:</div>
                                    <div class="col-6 fw-bold text-end">@(string.IsNullOrEmpty(Model.QualifyingService_CA) ? "-" : Model.QualifyingService_CA)</div>
                                    <div class="col-6 text-muted">Last Drawn Pay (CA):</div>
                                    <div class="col-6 fw-bold text-end font-monospace">&#8377; @((Model.LastDrawnPay_CA ?? (Model.LastDrawnBasic_CA ?? 0) + (Model.LastDrawnBDA_CA ?? 0) + (Model.LastDrawnDA_CA ?? 0)).ToString("N2"))</div>
                                    <div class="col-6 text-muted extra-small ps-3">- Basic / BDA / DA:</div>
                                    <div class="col-6 text-end extra-small font-monospace">&#8377; @(Model.LastDrawnBasic_CA?.ToString("N0") ?? "0") / @(Model.LastDrawnBDA_CA?.ToString("N0") ?? "0") / @(Model.LastDrawnDA_CA?.ToString("N0") ?? "0")</div>
                                </div>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <small class="text-muted d-block extra-small">As per Act</small>
                                    <h6 class="fw-bold mb-0 text-danger text-truncate font-monospace">&#8377; @(Model.GratuityAmount_CA_Act?.ToString("N2") ?? "0.00")</h6>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block extra-small">As per Regulation</small>
                                    <h6 class="fw-bold mb-0 text-danger text-truncate font-monospace">&#8377; @(Model.GratuityAmount_CA_Reg?.ToString("N2") ?? "0.00")</h6>
                                </div>
                            </div>
                            @if (Model.DeductionAmount_CA.HasValue && Model.DeductionAmount_CA > 0)
                            {
                                <div class="mt-2.5 p-2 bg-white rounded border border-danger-subtle small">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">CA Deductions:</span>
                                        <span class="fw-bold text-danger font-monospace">&#8377; @Model.DeductionAmount_CA.Value.ToString("N2")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.DeductionDetails_CA))
                                    {
                                        <small class="text-secondary d-block mt-1 fst-italic">@Model.DeductionDetails_CA</small>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Final Ordered Amount & Interest Banner -->
                    <div class="p-3 bg-white rounded-3 border-start border-4 border-gratuity shadow-sm">
                        <div class="row align-items-center g-3">
                            <div class="col-12 col-md-auto border-md-end pe-md-4 pb-2 pb-md-0 border-bottom border-bottom-md-0">
                                <small class="text-muted d-block text-uppercase fw-bold xs mb-1">Final Ordered Amount</small>
                                <h3 class="fw-bold text-gratuity mb-0 font-monospace">&#8377; @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")</h3>
                                @if (Model.IsInterestPayable || (Model.InterestRate.HasValue && Model.InterestRate > 0))
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle mt-1.5 small">
                                        <i class="bi bi-percent me-1"></i>Interest: @(Model.InterestRate?.ToString("0.##") ?? "10")% p.a.
                                    </span>
                                }
                            </div>
                            <div class="col-12 col-md">
                                @if (!string.IsNullOrEmpty(Model.Remarks) || !string.IsNullOrEmpty(Model.InterestRemarks))
                                {
                                    <div class="p-2.5 px-3 bg-light rounded-3 border-start border-3 border-warning small">
                                        <div class="fw-bold text-dark mb-1 small text-uppercase ls-1"><i class="bi bi-info-circle-fill text-warning me-1"></i> Order Remarks & Interest:</div>
                                        <div class="text-muted italic text-break" style="line-height: 1.4; font-size: 0.85rem;">
                                            @Model.Remarks
                                            @if (!string.IsNullOrEmpty(Model.InterestRemarks))
                                            {
                                                <div class="mt-1 text-dark"><strong>Controlling Authority Ruling:</strong> @Model.InterestRemarks</div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fst-italic">Controlling Authority order details recorded without special stipulations.</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Actual Payments History (Corporation) -->
                    <div class="mt-3.5 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="small fw-bold text-secondary mb-0 text-uppercase">
                                <i class="bi bi-check2-circle text-success me-1.5"></i> Actual Payments by Corporation
                            </h6>
                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace">
                                Total Paid: &#8377; @((Model.ActualPaidAmount ?? Model.Payments?.Sum(p => p.Amount ?? 0) ?? 0).ToString("N2"))
                            </span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover table-bordered mb-0 small text-center align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Amount</th>
                                        <th>Cheque / RTGS No</th>
                                        <th>Cheque Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Payments != null && Model.Payments.Any())
                                    {
                                        int pIdx = 1;
                                        foreach (var p in Model.Payments)
                                        {
                                            <tr>
                                                <td>@(pIdx++)</td>
                                                <td class="fw-bold text-success font-monospace">&#8377; @(p.Amount?.ToString("N2") ?? "0.00")</td>
                                                <td>@(string.IsNullOrEmpty(p.ChequeNumber) ? "-" : p.ChequeNumber)</td>
                                                <td>@(p.ChequeDate?.ToShortDateString() ?? "-")</td>
                                            </tr>
                                        }
                                    }
                                    else if (Model.ActualPaidAmount.HasValue && Model.ActualPaidAmount > 0)
                                    {
                                        <tr>
                                            <td>1</td>
                                            <td class="fw-bold text-success font-monospace">&#8377; @Model.ActualPaidAmount.Value.ToString("N2")</td>
                                            <td>@(Model.ChequeNumber ?? "-")</td>
                                            <td>@(Model.ChequeDate?.ToShortDateString() ?? "-")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-muted italic py-2">No payment transactions recorded</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Interest Payments History (If Any) -->
                    @if (Model.InterestPayments != null && Model.InterestPayments.Any())
                    {
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="small fw-bold text-danger mb-0 text-uppercase">
                                    <i class="bi bi-clock-history text-danger me-1.5"></i> Statutory Interest Payments
                                </h6>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace">
                                    Total Interest: &#8377; @(Model.InterestPayments.Sum(ip => ip.Amount ?? 0).ToString("N2"))
                                </span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover table-bordered mb-0 small text-center align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Interest Rate</th>
                                            <th>Amount</th>
                                            <th>Period</th>
                                            <th>Cheque No</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int ipIdx = 1; }
                                        @foreach (var ip in Model.InterestPayments)
                                        {
                                            <tr>
                                                <td>@(ipIdx++)</td>
                                                <td>@(ip.InterestRate?.ToString("0.##") ?? "10")%</td>
                                                <td class="fw-bold text-danger font-monospace">&#8377; @(ip.Amount?.ToString("N2") ?? "0.00")</td>
                                                <td class="small">@(ip.FromDate?.ToShortDateString() ?? "-") to @(ip.ToDate?.ToShortDateString() ?? "-")</td>
                                                <td>@(string.IsNullOrEmpty(ip.ChequeNumber) ? "-" : ip.ChequeNumber)</td>
                                                <td>@(ip.ChequeDate?.ToShortDateString() ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Appellate Authority Card (if any appeal recorded or proposed) -->
            @if (!string.IsNullOrEmpty(Model.AppealNumber) || !string.IsNullOrEmpty(Model.AppealCourt) || (Model.AppealComplianceAmount.HasValue && Model.AppealComplianceAmount > 0) || Model.ForwardingStatus == "Appeal before Appellant Authority" || Model.ForwardingStatus_Appeal == "Sent to Central Office")
            {
                <div class="card border-0 shadow-sm mb-3 mb-md-4 border-start border-4 border-success">
                    <div class="card-header bg-white py-2.5 py-md-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-success d-flex align-items-center">
                            <i class="bi bi-journal-bookmark me-2"></i>Appellate Authority (AA) Appeal
                        </h6>
                        @if (!string.IsNullOrEmpty(Model.ForwardingStatus_Appeal))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.ForwardingStatus_Appeal</span>
                        }
                    </div>
                    <div class="card-body p-3 p-md-4 small">
                        <div class="row g-2.5">
                            <div class="col-12 col-md-6">
                                <div class="p-2.5 bg-light rounded-3 h-100">
                                    <small class="text-muted d-block">Appeal / CR Number & Year</small>
                                    <div class="fw-bold text-dark text-break">
                                        @(string.IsNullOrEmpty(Model.AppealNumber) ? "Pending Allotment" : $"{Model.AppealNumber} / {Model.AppealYear}")
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.AppealArisingNo))
                                    {
                                        <small class="text-secondary d-block mt-1">Arising from: <strong>@Model.AppealArisingNo / @Model.AppealArisingYear</strong></small>
                                    }
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="p-2.5 bg-light rounded-3 h-100">
                                    <small class="text-muted d-block">Appellate Court & Advocate</small>
                                    <div class="fw-bold text-dark text-break">@(Model.AppealCourt ?? "-")</div>
                                    <small class="text-secondary d-block mt-1">Advocate: <strong>@(Model.AppealAdvocate ?? "-")</strong></small>
                                </div>
                            </div>

                            @if (Model.AppealComplianceAmount.HasValue && Model.AppealComplianceAmount > 0)
                            {
                                <div class="col-12 mt-1">
                                    <div class="p-2.5 bg-success-subtle rounded-3 border border-success-subtle d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="text-success fw-bold me-2"><i class="bi bi-shield-check me-1"></i>Compliance Deposit:</span>
                                            <span class="fw-bold fs-6 text-dark font-monospace">&#8377; @Model.AppealComplianceAmount.Value.ToString("N2")</span>
                                        </div>
                                        <div class="small text-muted">
                                            Chq No: <strong>@(Model.AppealComplianceChequeNumber ?? "-")</strong> | Date: <strong>@(Model.AppealComplianceChequeDate?.ToShortDateString() ?? "-")</strong>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.AppealDisposalDate.HasValue || !string.IsNullOrEmpty(Model.AppealAwardDetails))
                            {
                                <div class="col-12 mt-1">
                                    <div class="p-2.5 bg-light rounded-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <small class="text-muted">AA Disposal Date:</small>
                                            <span class="fw-bold text-success">@(Model.AppealDisposalDate?.ToShortDateString() ?? "Pending")</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.AppealAwardDetails))
                                        {
                                            <small class="text-muted d-block">Award Details:</small>
                                            <div class="text-dark mt-0.5 text-break">@Model.AppealAwardDetails</div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Certified Copy Lifecycle -->
                            @if (Model.AppealCopyAppliedDate.HasValue || Model.AppealCopyReadyDate.HasValue || Model.AppealCopyDeliveredDate.HasValue || Model.AppealCopyReceivedDate.HasValue)
                            {
                                <div class="col-12 mt-1">
                                    <div class="p-2.5 bg-light rounded-3">
                                        <small class="text-muted d-block mb-1.5 fw-bold text-uppercase xs">Certified Copy Status (Appellate Authority)</small>
                                        <div class="row g-2 text-center xs">
                                            <div class="col-3 border-end">
                                                <span class="text-muted d-block">Applied</span>
                                                <strong class="text-dark">@(Model.AppealCopyAppliedDate?.ToShortDateString() ?? "-")</strong>
                                            </div>
                                            <div class="col-3 border-end">
                                                <span class="text-muted d-block">Ready</span>
                                                <strong class="text-dark">@(Model.AppealCopyReadyDate?.ToShortDateString() ?? "-")</strong>
                                            </div>
                                            <div class="col-3 border-end">
                                                <span class="text-muted d-block">Delivered</span>
                                                <strong class="text-dark">@(Model.AppealCopyDeliveredDate?.ToShortDateString() ?? "-")</strong>
                                            </div>
                                            <div class="col-3">
                                                <span class="text-muted d-block">Received</span>
                                                <strong class="text-dark">@(Model.AppealCopyReceivedDate?.ToShortDateString() ?? "-")</strong>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.AppealDelayRemarks))
                                        {
                                            <small class="text-danger d-block mt-2 fst-italic">Delay: @Model.AppealDelayRemarks</small>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.OutwardNumber_Appeal) || Model.OutwardDate_Appeal.HasValue)
                            {
                                <div class="col-12 mt-1 text-muted xs">
                                    <span>Appeal Forwarding Outward No: <strong>@(Model.OutwardNumber_Appeal ?? "-")</strong></span>
                                    <span class="ms-2">Date: <strong>@(Model.OutwardDate_Appeal?.ToShortDateString() ?? "-")</strong></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Pre-Disposal & Evidence Details -->
            <div class="card border-0 shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-white py-2.5 py-md-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark d-flex align-items-center">
                        <i class="bi bi-file-earmark-person me-2 text-info"></i>Pre-Disposal, Objections & Evidence
                    </h6>
                    <span class="badge bg-light text-muted border">Trial Profile</span>
                </div>
                <div class="card-body p-3 p-md-4 small">
                    <div class="row g-2.5">
                        <div class="col-12 col-md-6">
                            <div class="p-2.5 bg-light rounded-3 h-100">
                                <small class="text-muted d-block mb-1">Objection / Statement of Defense</small>
                                <div>
                                    Objection Filed: 
                                    <strong class="@(Model.IsObjectionFiled ? "text-success" : "text-muted")">
                                        @(Model.IsObjectionFiled ? "Yes" : "No")
                                    </strong>
                                </div>
                                @if (Model.IsObjectionFiled)
                                {
                                    <div class="extra-small text-muted mt-1">
                                        Date: <strong>@(Model.ObjectionFiledDate?.ToShortDateString() ?? "-")</strong> | Outward: <strong>@(Model.ObjectionOutwardNo ?? "-")</strong>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-2.5 bg-light rounded-3 h-100">
                                <small class="text-muted d-block mb-1">Evidence & Witness</small>
                                <div>
                                    Evidence Filed: 
                                    <strong class="@(Model.IsEvidenceFiled ? "text-success" : "text-muted")">
                                        @(Model.IsEvidenceFiled ? "Yes" : "No")
                                    </strong>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.EvidenceWitnessName))
                                {
                                    <div class="extra-small text-dark mt-1">
                                        Witness: <strong>@Model.EvidenceWitnessName</strong> (@(Model.EvidenceWitnessDesignation ?? "-"))
                                    </div>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.EvidenceRemarks))
                        {
                            <div class="col-12">
                                <div class="p-2.5 bg-white border rounded-3 text-secondary text-break fst-italic">
                                    <span class="fw-bold text-dark not-italic">Evidence Remarks:</span> @Model.EvidenceRemarks
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Higher Courts Litigation (High Court / Supreme Court) -->
            @if (!string.IsNullOrEmpty(Model.CorpWPNumber) || !string.IsNullOrEmpty(Model.ClaimantWPNumber) || Model.IsClaimantSCAppeal || Model.IsPendingForFiling)
            {
                <div class="card border-0 shadow-sm mb-3 mb-md-4">
                    <div class="card-header bg-white py-2.5 py-md-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-primary d-flex align-items-center">
                            <i class="bi bi-bank2 me-2"></i>Higher Courts Litigation
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">High Court / Supreme Court</span>
                    </div>
                    <div class="card-body p-3 p-md-4 small">
                        <!-- Corporation WP -->
                        @if (!string.IsNullOrEmpty(Model.CorpWPNumber) || Model.IsPendingForFiling)
                        {
                            <div class="p-2.5 rounded-3 bg-light border-start border-4 border-primary mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-primary text-uppercase small">High Court WP (Corporation)</strong>
                                    <span class="badge bg-primary">@(Model.CorpWPStatus ?? "Filed")</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-sm-6">
                                        <span class="text-muted">WP Number:</span> 
                                        <strong>@(Model.IsPendingForFiling ? "Pending for Filing" : $"{Model.CorpWPNumber} / {Model.CorpWPYear}")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Bench:</span> 
                                        <strong>@(Model.HighCourtBench ?? "Dharwad") @Model.OtherHighCourtBench</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Advocate:</span> 
                                        <strong>@(Model.CorpWPAdvocate ?? "-")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Stay Granted:</span> 
                                        <strong class="@(Model.StayGranted ? "text-success" : "text-muted")">@(Model.StayGranted ? "Yes" : "No")</strong>
                                        @if (Model.StayGranted && !string.IsNullOrEmpty(Model.StayComplianceOutwardNo))
                                        {
                                            <span class="extra-small text-muted">(@Model.StayComplianceOutwardNo)</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.CorpWPOutcome))
                                    {
                                        <div class="col-12 mt-1">
                                            <span class="text-muted">Outcome / Decision:</span> 
                                            <strong class="text-dark">@Model.CorpWPOutcome (@(Model.CorpWPActionTaken ?? "-"))</strong>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Claimant High Court WP -->
                        @if (!string.IsNullOrEmpty(Model.ClaimantWPNumber))
                        {
                            <div class="p-2.5 rounded-3 bg-light border-start border-4 border-info mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-info text-uppercase small">High Court WP (Claimant)</strong>
                                    <span class="badge bg-info text-dark">Claimant Appeal</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-sm-6">
                                        <span class="text-muted">WP Number:</span> 
                                        <strong>@Model.ClaimantWPNumber / @Model.ClaimantWPYear</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Bench:</span> 
                                        <strong>@(Model.ClaimantHighCourtBench ?? "Dharwad")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Advocate:</span> 
                                        <strong>@(Model.ClaimantWPAdvocate ?? "-")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Decision:</span> 
                                        <strong>@(Model.ClaimantWPDecision ?? "-")</strong>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Supreme Court Appeal -->
                        @if (Model.IsClaimantSCAppeal)
                        {
                            <div class="p-2.5 rounded-3 bg-light border-start border-4 border-dark">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark text-uppercase small">Supreme Court Appeal</strong>
                                    <span class="badge bg-dark">@Model.ClaimantSCStatus</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-sm-6">
                                        <span class="text-muted">Diary No / Year:</span> 
                                        <strong>@(Model.ClaimantSCDiaryNumber ?? "-") / @(Model.ClaimantSCYear?.ToString() ?? "-")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">SLP No / Year:</span> 
                                        <strong>@(Model.ClaimantSCNumber ?? "-") / @(Model.ClaimantSLPYear?.ToString() ?? "-")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Advocate:</span> 
                                        <strong>@(Model.ClaimantSCAdvocate ?? "-")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Outcome:</span> 
                                        <strong>@(Model.ClaimantSCOutcome ?? "-")</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Enclosed Supporting Documents -->
            @if (Model.EnclosedDocuments != null && Model.EnclosedDocuments.Any())
            {
                <div class="card border-0 shadow-sm mb-3 mb-md-4">
                    <div class="card-header bg-white py-2.5 py-md-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark d-flex align-items-center">
                            <i class="bi bi-paperclip me-2 text-primary"></i>Enclosed Supporting Documents
                        </h6>
                        <span class="badge bg-secondary rounded-pill">@Model.EnclosedDocuments.Count</span>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush small">
                            @foreach (var doc in Model.EnclosedDocuments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-3">
                                    <span class="text-break"><i class="bi bi-file-earmark-text text-secondary me-2"></i>@doc.DocName</span>
                                    <span class="badge bg-light text-dark border font-monospace">@doc.PageCount pages</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT COLUMN: Sidebar (Legal, Entrustment, CO Tracking, Opinions, Downloads) -->
        <div class="col-lg-4">
            <!-- Legal Representation & Entrustment -->
            <div class="card border-0 shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-white py-2.5 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-badge me-2 text-primary"></i>Legal Entrustment</h6>
                </div>
                <div class="card-body small p-3">
                    <div class="mb-2.5 p-2 bg-light rounded-3">
                        <small class="text-muted d-block">Entrustment No & Date</small>
                        <div class="fw-bold text-dark">
                            @(string.IsNullOrEmpty(Model.EntrustmentNo) ? "-" : Model.EntrustmentNo)
                            @if (Model.EntrustmentDate.HasValue)
                            {
                                <span class="text-muted fw-normal">(@Model.EntrustmentDate.Value.ToShortDateString())</span>
                            }
                        </div>
                    </div>
                    <div class="mb-2.5">
                        <small class="text-muted d-block">Assigned Advocate:</small>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.AdvocateName) ? "-" : Model.AdvocateName)</strong>
                    </div>
                    <div class="mb-2.5">
                        <small class="text-muted d-block">Court & Bench:</small>
                        <strong class="text-dark">@(Model.CourtType ?? "Controlling Authority")</strong>
                    </div>
                    <div class="mb-0">
                        <small class="text-muted d-block">Current Stage:</small>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@(Model.CurrentStage ?? "Disposed")</span>
                    </div>
                </div>
            </div>

            <!-- Central Office Tracking & Approvals -->
            <div class="card border-0 shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-white py-2.5 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-building-check me-2 text-success"></i>Central Office Review</h6>
                </div>
                <div class="card-body small p-3">
                    <div class="mb-2.5 p-2 bg-light rounded-3">
                        <small class="text-muted d-block">Action Taken:</small>
                        <strong class="text-dark text-break">@(string.IsNullOrEmpty(Model.ActionTaken) ? "None" : Model.ActionTaken)</strong>
                        @if (Model.FeasibilityReceiptDate.HasValue)
                        {
                            <div class="extra-small text-muted mt-0.5">Judgement Received: @Model.FeasibilityReceiptDate.Value.ToShortDateString()</div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.InitialActionRemarks))
                    {
                        <div class="mb-2.5">
                            <small class="text-muted d-block">Initial Action Remarks:</small>
                            <div class="fst-italic text-secondary">@Model.InitialActionRemarks</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ApprovalOutwardNo) || Model.ApprovalDate.HasValue)
                    {
                        <div class="mb-2.5">
                            <small class="text-muted d-block">Approval Outward / Date:</small>
                            <strong>@(Model.ApprovalOutwardNo ?? "-") / @(Model.ApprovalDate?.ToShortDateString() ?? "-")</strong>
                        </div>
                    }
                    <div class="mb-0">
                        <small class="text-muted d-block">Division Outward / Date:</small>
                        <span>@(Model.OutwardNumber ?? "-") / @(Model.OutwardDate?.ToShortDateString() ?? "-")</span>
                    </div>
                </div>
            </div>

            <!-- Opinions & Recommendations -->
            <div class="card border-0 shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-white py-2.5 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-chat-left-quote me-2 text-warning"></i>Opinions & Advice</h6>
                </div>
                <div class="card-body small p-3">
                    <div class="mb-2.5">
                        <small class="text-muted d-block fw-bold xs text-uppercase">Opinion of Advocate:</small>
                        <div class="p-2 bg-light rounded-2 text-secondary fst-italic mt-0.5">
                            @(string.IsNullOrEmpty(Model.AdvocateOpinion) ? "No opinion recorded" : Model.AdvocateOpinion)
                        </div>
                    </div>
                    <div class="mb-2.5">
                        <small class="text-muted d-block fw-bold xs text-uppercase">Opinion of ALO / LO:</small>
                        <div class="p-2 bg-light rounded-2 text-secondary fst-italic mt-0.5">
                            @(string.IsNullOrEmpty(Model.LOOpinion) ? "No opinion recorded" : Model.LOOpinion)
                        </div>
                    </div>
                    <div class="mb-0">
                        <small class="text-muted d-block fw-bold xs text-uppercase">Opinion of DC:</small>
                        <div class="p-2 bg-light rounded-2 text-secondary fst-italic mt-0.5">
                            @(string.IsNullOrEmpty(Model.DCOpinion) ? "No opinion recorded" : Model.DCOpinion)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Downloadable Action Documents -->
            <div class="card border-0 shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-white py-2.5 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-folder2-open me-2 text-primary"></i>Uploaded Case Files</h6>
                </div>
                <div class="list-group list-group-flush small">
                    @if (!string.IsNullOrEmpty(Model.AdverseJudgmentPath))
                    {
                        <a href="@Model.AdverseJudgmentPath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3">
                            <span><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Controlling Auth Judgment Copy</span>
                            <i class="bi bi-box-arrow-up-right text-muted"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.AppealJudgmentPath))
                    {
                        <a href="@Model.AppealJudgmentPath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3">
                            <span><i class="bi bi-file-earmark-pdf text-primary me-2"></i>Appeal Judgment Copy</span>
                            <i class="bi bi-box-arrow-up-right text-muted"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.InitialActionPath1))
                    {
                        var docTitle1 = "Noting Sheet 1";
                        if (Model.ActionTaken == "Close" || Model.ActionTaken == "Closed") docTitle1 = "Approval Copy";
                        else if (Model.ActionTaken == "Appeal") docTitle1 = "Appeal Copy";

                        <a href="@Model.InitialActionPath1" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3">
                            <span><i class="bi bi-file-earmark-check text-success me-2"></i>@docTitle1</span>
                            <i class="bi bi-box-arrow-up-right text-muted"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.InitialActionPath2))
                    {
                        <a href="@Model.InitialActionPath2" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3">
                            <span><i class="bi bi-file-earmark-check text-success me-2"></i>Noting Sheet 2</span>
                            <i class="bi bi-box-arrow-up-right text-muted"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.StayOrderPath1))
                    {
                        <a href="@Model.StayOrderPath1" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3">
                            <span><i class="bi bi-file-earmark-lock text-warning me-2"></i>Stay Order Document 1</span>
                            <i class="bi bi-box-arrow-up-right text-muted"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.StayOrderPath2))
                    {
                        <a href="@Model.StayOrderPath2" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3">
                            <span><i class="bi bi-file-earmark-lock text-warning me-2"></i>Stay Order Document 2</span>
                            <i class="bi bi-box-arrow-up-right text-muted"></i>
                        </a>
                    }
                    @if (string.IsNullOrEmpty(Model.AdverseJudgmentPath) && string.IsNullOrEmpty(Model.AppealJudgmentPath) && string.IsNullOrEmpty(Model.InitialActionPath1) && string.IsNullOrEmpty(Model.InitialActionPath2) && string.IsNullOrEmpty(Model.StayOrderPath1) && string.IsNullOrEmpty(Model.StayOrderPath2))
                    {
                        <div class="p-3 text-muted fst-italic text-center">No action documents attached</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FULL DETAILS MODAL -->
<div class="modal fade" id="gratuityFullDetailsModal" tabindex="-1" aria-labelledby="gratuityFullDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-2.5 px-3">
                <h5 class="modal-title fw-bold fs-6 fs-md-5 d-flex align-items-center" id="gratuityFullDetailsModalLabel">
                    <i class="bi bi-info-circle-fill me-2"></i>Comprehensive Gratuity Case Record: @Model.PGANumber
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2.5 p-md-4 bg-light">
                <div class="row g-3">
                    <!-- Column 1: Employee & Service Profile -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header bg-white py-2 fw-bold text-primary">Employee & Service Profile</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-5 text-muted">Claimant Name:</div><div class="col-7 fw-bold text-break">@Model.ClaimantName</div>
                                    <div class="col-5 text-muted">Designation:</div><div class="col-7 fw-bold text-break">@(Model.ClaimantDesignation ?? "-")</div>
                                    <div class="col-5 text-muted">Working Status:</div><div class="col-7 fw-bold">@(Model.WorkingStatus ?? "-")</div>
                                    <div class="col-5 text-muted">DOB:</div><div class="col-7 fw-bold">@(Model.DateOfBirth?.ToShortDateString() ?? "-")</div>
                                    <div class="col-5 text-muted">Appointment (Corp):</div><div class="col-7 fw-bold">@(Model.AppointmentDate?.ToShortDateString() ?? "-")</div>
                                    <div class="col-5 text-muted">Appointment (CA):</div><div class="col-7 fw-bold">@(Model.AppointmentDate_CA?.ToShortDateString() ?? "-")</div>
                                    @if (!string.IsNullOrEmpty(Model.CA_AppointmentRemark))
                                    {
                                        <div class="col-5 text-muted">Appt Remark (CA):</div><div class="col-7 text-secondary">@Model.CA_AppointmentRemark</div>
                                    }
                                    <div class="col-5 text-muted">Retirement (Corp):</div><div class="col-7 fw-bold">@(Model.RetirementDate?.ToShortDateString() ?? "-")</div>
                                    <div class="col-5 text-muted">Retirement (CA):</div><div class="col-7 fw-bold">@(Model.RetirementDate_CA?.ToShortDateString() ?? "-")</div>
                                    <div class="col-5 text-muted">Total Service:</div><div class="col-7 fw-bold text-primary">@(Model.TotalServicePeriod ?? "-")</div>
                                    <div class="col-5 text-muted">SPE/LWA (Corp):</div><div class="col-7">@(Model.Period_SPE_LWA_ABS ?? "-")</div>
                                    <div class="col-5 text-muted">SPE/LWA (CA):</div><div class="col-7">@(Model.Period_SPE_LWA_ABS_CA ?? "-")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Financial Assessment Comparison Table -->
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header bg-white py-2 fw-bold text-primary">Financial Assessment Comparison</div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0 small text-center align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Factor</th>
                                                <th>Corporation</th>
                                                <th>Controlling Authority</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="text-start">Qualifying Service</td>
                                                <td>@(Model.QualifyingService_Corp ?? Model.TotalServicePeriod ?? "-")</td>
                                                <td>@(Model.QualifyingService_CA ?? "-")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-start">Basic / BDA / DA</td>
                                                <td>&#8377; @(Model.LastDrawnBasic?.ToString("N0") ?? "0") / @(Model.LastDrawnBDA?.ToString("N0") ?? "0") / @(Model.LastDrawnDA?.ToString("N0") ?? "0")</td>
                                                <td>&#8377; @(Model.LastDrawnBasic_CA?.ToString("N0") ?? "0") / @(Model.LastDrawnBDA_CA?.ToString("N0") ?? "0") / @(Model.LastDrawnDA_CA?.ToString("N0") ?? "0")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-start">Total Last Drawn Pay</td>
                                                <td class="fw-bold font-monospace">&#8377; @((Model.LastDrawnPay ?? (Model.LastDrawnBasic ?? 0) + (Model.LastDrawnBDA ?? 0) + (Model.LastDrawnDA ?? 0)).ToString("N2"))</td>
                                                <td class="fw-bold font-monospace">&#8377; @((Model.LastDrawnPay_CA ?? (Model.LastDrawnBasic_CA ?? 0) + (Model.LastDrawnBDA_CA ?? 0) + (Model.LastDrawnDA_CA ?? 0)).ToString("N2"))</td>
                                            </tr>
                                            <tr>
                                                <td class="text-start">Gratuity (Act)</td>
                                                <td class="font-monospace">&#8377; @(Model.GratuityAmount_Corp_Act?.ToString("N2") ?? "0.00")</td>
                                                <td class="font-monospace text-danger">&#8377; @(Model.GratuityAmount_CA_Act?.ToString("N2") ?? "0.00")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-start">Gratuity (Regulation)</td>
                                                <td class="font-monospace">&#8377; @(Model.GratuityAmount_Corp_Reg?.ToString("N2") ?? "0.00")</td>
                                                <td class="font-monospace text-danger">&#8377; @(Model.GratuityAmount_CA_Reg?.ToString("N2") ?? "0.00")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-start">Deductions</td>
                                                <td class="font-monospace">&#8377; @(Model.DeductionAmount?.ToString("N2") ?? "0.00")</td>
                                                <td class="font-monospace text-danger">&#8377; @(Model.DeductionAmount_CA?.ToString("N2") ?? "0.00")</td>
                                            </tr>
                                            <tr class="table-info fw-bold">
                                                <td class="text-start">Final Gratuity / Ordered</td>
                                                <td class="font-monospace">&#8377; @((Model.GratuityAmount_Corp_Act ?? Model.GratuityAmount_Corp_Reg ?? 0).ToString("N2"))</td>
                                                <td class="font-monospace text-danger">&#8377; @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Trial & Evidence Recording -->
                        <div class="card shadow-sm border-0 mb-3 border-start border-4 border-info">
                            <div class="card-header bg-white py-2 fw-bold text-info">Pre-Disposal & Evidence</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-5 text-muted">Objection Filed:</div><div class="col-7 fw-bold">@(Model.IsObjectionFiled ? "Yes (" + Model.ObjectionFiledDate?.ToShortDateString() + ", Outward: " + Model.ObjectionOutwardNo + ")" : "No")</div>
                                    <div class="col-5 text-muted">Evidence Filed:</div><div class="col-7 fw-bold">@(Model.IsEvidenceFiled ? "Yes" : "No")</div>
                                    <div class="col-5 text-muted">Witness Details:</div><div class="col-7 fw-bold">@(string.IsNullOrEmpty(Model.EvidenceWitnessName) ? "-" : Model.EvidenceWitnessName + " (" + Model.EvidenceWitnessDesignation + ")")</div>
                                    <div class="col-5 text-muted">Evidence Remarks:</div><div class="col-7 text-secondary">@(Model.EvidenceRemarks ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Legal, Appeals & Tracking -->
                    <div class="col-lg-6">
                        <!-- Legal & Entrustment Details -->
                        <div class="card shadow-sm border-0 mb-3 bg-warning-subtle border-start border-4 border-warning">
                            <div class="card-header bg-white py-2 fw-bold text-warning">Legal & Entrustment Details</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-5 text-muted">Entrustment No:</div><div class="col-7 fw-bold">@(Model.EntrustmentNo ?? "-")</div>
                                    <div class="col-5 text-muted">Entrustment Date:</div><div class="col-7 fw-bold">@(Model.EntrustmentDate?.ToShortDateString() ?? "-")</div>
                                    <div class="col-5 text-muted">Advocate Name:</div><div class="col-7 fw-bold">@(Model.AdvocateName ?? "-")</div>
                                    <div class="col-5 text-muted">Current Stage:</div><div class="col-7 fw-bold text-primary">@(Model.CurrentStage ?? "-")</div>
                                    <div class="col-5 text-muted">Disposal Date:</div><div class="col-7 fw-bold">@(Model.DisposalDate?.ToShortDateString() ?? "-")</div>
                                    <div class="col-5 text-muted">Disposal Result:</div><div class="col-7 fw-bold">@(Model.DisposalResult ?? "-")</div>
                                    @if (!string.IsNullOrEmpty(Model.DelayRemarks))
                                    {
                                        <div class="col-5 text-muted">Delay Remarks:</div><div class="col-7 text-danger">@Model.DelayRemarks</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Opinions & Advice -->
                        <div class="card shadow-sm border-0 mb-3 bg-info-subtle border-start border-4 border-info">
                            <div class="card-header bg-white py-2 fw-bold text-info">Opinions & Recommendations</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-5 text-muted">Advocate Opinion:</div><div class="col-7">@(Model.AdvocateOpinion ?? "-")</div>
                                    <div class="col-5 text-muted">ALO / LO Opinion:</div><div class="col-7">@(Model.LOOpinion ?? "-")</div>
                                    <div class="col-5 text-muted">DC Opinion:</div><div class="col-7">@(Model.DCOpinion ?? "-")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Certified Copy Lifecycle -->
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header bg-white py-2 fw-bold">Disposal Certified Copy Lifecycle</div>
                            <div class="card-body small">
                                <div class="row g-2">
                                    <div class="col-6"><span class="text-muted">Copy Applied:</span> <strong>@(Model.CopyAppliedDate?.ToShortDateString() ?? "-")</strong></div>
                                    <div class="col-6"><span class="text-muted">Copy Issued:</span> <strong>@(Model.CopyIssuedDate?.ToShortDateString() ?? "-")</strong></div>
                                    <div class="col-6"><span class="text-muted">Copy Delivered:</span> <strong>@(Model.CopyDeliveredDate?.ToShortDateString() ?? "-")</strong></div>
                                    <div class="col-6"><span class="text-muted">Copy Received:</span> <strong>@(Model.CopyReceivedDate?.ToShortDateString() ?? "-")</strong></div>
                                </div>
                            </div>
                        </div>

                        <!-- Higher Courts Summary -->
                        @if (!string.IsNullOrEmpty(Model.CorpWPNumber) || !string.IsNullOrEmpty(Model.ClaimantWPNumber) || Model.IsClaimantSCAppeal)
                        {
                            <div class="card shadow-sm border-0 mb-3 border-start border-4 border-primary">
                                <div class="card-header bg-white py-2 fw-bold text-primary">Higher Court References</div>
                                <div class="card-body small">
                                    <div class="row g-2">
                                        @if (!string.IsNullOrEmpty(Model.CorpWPNumber))
                                        {
                                            <div class="col-5 text-muted">Corporation WP:</div>
                                            <div class="col-7 fw-bold">@Model.CorpWPNumber / @Model.CorpWPYear (@Model.HighCourtBench) - @Model.CorpWPStatus</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.ClaimantWPNumber))
                                        {
                                            <div class="col-5 text-muted">Claimant WP:</div>
                                            <div class="col-7 fw-bold">@Model.ClaimantWPNumber / @Model.ClaimantWPYear (@Model.ClaimantHighCourtBench)</div>
                                        }
                                        @if (Model.IsClaimantSCAppeal)
                                        {
                                            <div class="col-5 text-muted">Supreme Court:</div>
                                            <div class="col-7 fw-bold">Diary: @Model.ClaimantSCDiaryNumber / @Model.ClaimantSCYear (@Model.ClaimantSCStatus)</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-2.5">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
</div>

<!-- PRINT ONLY SECTION (Standard Official Format) -->
<div class="d-none d-print-block p-4" id="printSection">
    <div class="text-center mb-4">
        <div class="d-flex justify-content-center align-items-center mb-2 text-dark">
            <h4 class="fw-bold mb-0">@OrgService.GetCurrentSettings().OrganizationNameKannada</h4>
        </div>
        <h5 class="fw-bold mb-1 text-dark">@OrgService.GetCurrentSettings().OrganizationNameEnglish</h5>
        <h6 class="mb-0 text-dark">@(OrgService.GetCurrentSettings().Address ?? "à²•à³‡à²‚à²¦à³à²° à²•à²šà³‡à²°à²¿ : à²¹à³à²¬à³à²¬à²³à³à²³à²¿ / Central Office : Hubballi")</h6>
        <div class="border-bottom border-2 border-dark mt-2 mb-3"></div>
        <h5 class="fw-bold text-decoration-underline text-dark text-uppercase">GRATUITY CASE DETAILS</h5>
    </div>

    <table class="table table-bordered border-dark align-middle print-table">
        <thead>
            <tr class="text-center bg-light text-dark">
                <th style="width: 8%;">SL NO.</th>
                <th style="width: 32%;">DETAILS OF THE INFORMATION</th>
                <th style="width: 60%;">DETAILS OF THE CASE</th>
            </tr>
        </thead>
        <tbody class="text-dark">
            <tr>
                <td class="text-center">1</td>
                <td>DIVISION</td>
                <td>@ViewBag.DivisionName</td>
            </tr>
            <tr>
                <td class="text-center">2</td>
                <td>NAME & DESIGNATION</td>
                <td>@Model.ClaimantName, @(Model.ClaimantDesignation ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center">3</td>
                <td>CLAIM DETAILS</td>
                <td>@(string.IsNullOrEmpty(Model.AmountClaimed) ? "-" : Model.AmountClaimed)</td>
            </tr>
            <tr>
                <td class="text-center">4</td>
                <td>DATE OF BIRTH</td>
                <td>@(Model.DateOfBirth?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">5</td>
                <td rowspan="2">DATE OF APPOINTMENT</td>
                <td><strong>AS PER CORPORATION:</strong> @(Model.AppointmentDate?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.AppointmentDate_CA?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">6</td>
                <td rowspan="2">DATE OF RETIREMENT / DISMISSED / DEATH / VRS</td>
                <td><strong>AS PER CORPORATION:</strong> @(Model.RetirementDate?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.RetirementDate_CA?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">7</td>
                <td rowspan="2">TOTAL PERIOD OF SERVICE</td>
                <td><strong>AS PER CORPORATION:</strong> @(Model.TotalServicePeriod ?? "-")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.QualifyingService_CA ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">8</td>
                <td rowspan="2">TOTAL PERIOD OF SPE / LWA / ABS</td>
                <td><strong>AS PER CORPORATION:</strong> @(Model.Period_SPE_LWA_ABS ?? "-")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.Period_SPE_LWA_ABS_CA ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">9</td>
                <td rowspan="2">CALCULATION OF QUALIFYING SERVICE</td>
                <td><strong>AS PER CORPORATION:</strong> @(Model.QualifyingService_Corp ?? "-")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY:</strong> @(Model.QualifyingService_CA ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center">10</td>
                <td>DETAILS IF ANY (REMARKS / AWARD)</td>
                <td>
                    @if (!string.IsNullOrEmpty(Model.Remarks)) { <div><strong>Remarks:</strong> @Model.Remarks</div> }
                    @if (!string.IsNullOrEmpty(Model.AppealAwardDetails)) { <div class="@(!string.IsNullOrEmpty(Model.Remarks) ? "mt-1" : "")"><strong>Award Details:</strong> @Model.AppealAwardDetails</div> }
                    @if (string.IsNullOrEmpty(Model.Remarks) && string.IsNullOrEmpty(Model.AppealAwardDetails)) { <span>--</span> }
                </td>
            </tr>
            <tr>
                <td class="text-center" rowspan="3">11</td>
                <td rowspan="3">LAST DRAWN (SALARY DETAILS)</td>
                <td><strong>BASIC PAY:</strong> &#8377; @(Model.LastDrawnBasic?.ToString("N0") ?? "0")</td>
            </tr>
            <tr>
                <td><strong>BDA:</strong> &#8377; @(Model.LastDrawnBDA?.ToString("N0") ?? "0")</td>
            </tr>
            <tr>
                <td><strong>DA:</strong> &#8377; @(Model.LastDrawnDA?.ToString("N0") ?? "0")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="4">12</td>
                <td rowspan="4">GRATUITY AMOUNT CALCULATED</td>
                <td><strong>AS PER CORPORATION (ACT):</strong> &#8377; @(Model.GratuityAmount_Corp_Act?.ToString("N2") ?? "0.00")</td>
            </tr>
            <tr>
                <td><strong>AS PER CORPORATION (REGULATION):</strong> &#8377; @(Model.GratuityAmount_Corp_Reg?.ToString("N2") ?? "0.00")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY (ACT):</strong> &#8377; @(Model.GratuityAmount_CA_Act?.ToString("N2") ?? "0.00")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY (REGULATION):</strong> &#8377; @(Model.GratuityAmount_CA_Reg?.ToString("N2") ?? "0.00")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="2">13</td>
                <td rowspan="2">DEDUCTIONS MADE FROM GRATUITY AMOUNT</td>
                <td><strong>AS PER CORPORATION:</strong> &#8377; @(Model.DeductionAmount?.ToString("N2") ?? "0.00") @(string.IsNullOrEmpty(Model.DeductionDetails) ? "" : $"({Model.DeductionDetails})")</td>
            </tr>
            <tr>
                <td><strong>AS PER CONTROLLING AUTHORITY:</strong> &#8377; @(Model.DeductionAmount_CA?.ToString("N2") ?? "0.00") @(string.IsNullOrEmpty(Model.DeductionDetails_CA) ? "" : $"({Model.DeductionDetails_CA})")</td>
            </tr>
            <tr>
                <td class="text-center">14</td>
                <td>CONTROLLING AUTHORITY HELD DEDUCTION PERMISSIBILITY / INTEREST</td>
                <td>@(Model.InterestRemarks ?? "--")</td>
            </tr>
            <tr>
                <td class="text-center" rowspan="3">15</td>
                <td rowspan="3">ACTUAL AMOUNT PAID BY CORPORATION</td>
                <td><strong>AMOUNT:</strong> &#8377; @((Model.ActualPaidAmount ?? Model.Payments?.Sum(p => p.Amount ?? 0) ?? 0).ToString("N2"))</td>
            </tr>
            <tr>
                <td><strong>CHQ NO:</strong> @(Model.ChequeNumber ?? Model.Payments?.OrderByDescending(p => p.ChequeDate).FirstOrDefault()?.ChequeNumber ?? "-")</td>
            </tr>
            <tr>
                <td><strong>DATE:</strong> @(Model.ChequeDate?.ToShortDateString() ?? Model.Payments?.OrderByDescending(p => p.ChequeDate).FirstOrDefault()?.ChequeDate?.ToShortDateString() ?? "-")</td>
            </tr>
            <tr>
                <td class="text-center">16</td>
                <td>FINAL ORDERED AMOUNT (ALC)</td>
                <td><strong>&#8377; @(Model.OrderedAmount_CA?.ToString("N2") ?? "0.00")</strong> @(Model.IsInterestPayable ? $"with {Model.InterestRate ?? 10}% statutory interest" : "")</td>
            </tr>
            <tr>
                <td class="text-center">17</td>
                <td>DETAILS OF OBTAINING CERTIFIED COPY OF THE AWARD</td>
                <td>
                    @(Model.CopyAppliedDate.HasValue ? "Applied: " + Model.CopyAppliedDate.Value.ToShortDateString() : "") 
                    @(Model.CopyReceivedDate.HasValue ? " | Received: " + Model.CopyReceivedDate.Value.ToShortDateString() : "")
                    @if (!Model.CopyAppliedDate.HasValue && !Model.CopyReceivedDate.HasValue) { <span>--</span> }
                </td>
            </tr>
            <tr>
                <td class="text-center">18</td>
                <td>OPINION OF ADVOCATE</td>
                <td>@(Model.AdvocateOpinion ?? "--")</td>
            </tr>
            <tr>
                <td class="text-center">19</td>
                <td>OPINION OF ALO / LO</td>
                <td>@(Model.LOOpinion ?? "--")</td>
            </tr>
            <tr>
                <td class="text-center">20</td>
                <td>OPINION OF DC</td>
                <td>@(Model.DCOpinion ?? "--")</td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    .text-gratuity { color: #C2185B !important; }
    .bg-gratuity { background-color: #C2185B !important; }
    .border-gratuity { border-color: #C2185B !important; }
    .xs { font-size: 0.75rem; }
    .extra-small { font-size: 0.70rem; }
    .italic { font-style: italic; }
    .ls-1 { letter-spacing: 0.5px; }

    /* Action buttons & header layout */
    .gratuity-header-actions .btn {
        white-space: nowrap;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.5rem 1.1rem;
        transition: all 0.2s ease-in-out;
    }
    .gratuity-header-actions .btn:hover {
        transform: translateY(-1px);
    }

    .gratuity-summary-grid .card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .gratuity-summary-grid .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.08) !important;
    }

    @@media (min-width: 768px) {
        .border-md-end {
            border-right: 1px solid var(--bs-border-color, #dee2e6) !important;
        }
        .border-bottom-md-0 {
            border-bottom: 0 !important;
        }
    }

    @@media (max-width: 767.98px) {
        .container-fluid {
            padding-left: 0.75rem !important;
            padding-right: 0.75rem !important;
        }
        .gratuity-header-actions {
            width: 100% !important;
            display: grid !important;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem !important;
        }
        .gratuity-header-actions .btn,
        .gratuity-header-actions .badge {
            width: 100% !important;
            padding: 0.5rem 0.65rem !important;
            font-size: 0.8rem !important;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .gratuity-summary-grid .card-body {
            padding: 0.65rem !important;
        }
    }

    @@media (max-width: 420px) {
        .gratuity-header-actions {
            grid-template-columns: 1fr;
        }
    }

    /* Print styles */
    @@media print {
        .d-print-none { display: none !important; }
        .d-print-block { display: block !important; }
        .container-fluid { padding: 0 !important; }
        .card { border: 1px solid #dee2e6 !important; box-shadow: none !important; margin-bottom: 10px !important; }
        
        .print-table th, .print-table td {
            border: 1px solid #000 !important;
            padding: 8px !important;
            font-size: 11pt !important;
        }
        
        .print-container {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        
        @@page {
            size: auto;
            margin: 15mm;
        }
    }
</style>