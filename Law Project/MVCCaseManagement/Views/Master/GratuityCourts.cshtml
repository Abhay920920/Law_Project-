@model IEnumerable<MVCCaseManagement.Models.GratuityCourt>

@{
    ViewData["Title"] = "Gratuity Courts Master";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Masters</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Gratuity Courts</li>
                </ol>
            </nav>
            <h1>Gratuity Courts List</h1>
        </div>
        <a asp-action="GratuityCourtCreate" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Court</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Court Name</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.CourtName</td>
                                <td>@item.Location</td>
                                <td>
                                    @if(item.IsActive) { <span class="badge bg-success">Active</span> }
                                    else { <span class="badge bg-danger">Inactive</span> }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="GratuityCourtEdit" asp-route-id="@item.CourtID" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="GratuityCourtDelete" asp-route-id="@item.CourtID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this court?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No courts found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
