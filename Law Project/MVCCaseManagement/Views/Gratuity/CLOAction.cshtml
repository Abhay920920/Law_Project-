@model MVCCaseManagement.Models.GratuityCase

@{
    ViewData["Title"] = "CLO Action - " + Model.PGANumber;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-shield-check me-2"></i>CLO Action (Gratuity)</h3>
            <p class="text-secondary mb-0">Recording decision for PGA No: <strong class="text-dark">@Model.PGANumber</strong></p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.CaseID" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Details
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="glass-card p-4 border-0 shadow-sm">
                <form asp-action="CLOAction" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CaseID" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Action Taken</label>
                        <select asp-for="DisposalResult" class="form-select form-select-lg border-primary border-opacity-25" required>
                            <option value="">-- Select Action --</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                        <span asp-validation-for="DisposalResult" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Approval Date</label>
                        <input type="date" asp-for="ApprovalDate" class="form-control form-control-lg border-primary border-opacity-25" value="@(Model.ApprovalDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="ApprovalDate" class="text-danger small"></span>
                    </div>



                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            <i class="bi bi-check-circle me-2"></i>Submit Action
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 20px;
    }
    .form-control-lg, .form-select-lg {
        border-radius: 12px;
        font-size: 1rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
</style>
