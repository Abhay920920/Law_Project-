@model MVCCaseManagement.Models.GratuityViewModel

@{
    ViewData["Title"] = (Model.CaseID > 0 ? "Edit" : "New") + " Gratuity Case";
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
             <h2 class="fw-bold text-gratuity mb-1">
                <i class="bi bi-file-earmark-plus-fill me-2"></i> @ViewData["Title"]
            </h2>
             <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i> Enter complete details for gratuity proceedings and assessment</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill shadow-sm bg-white">
                <i class="bi bi-arrow-left me-2"></i> Dashboard
            </a>
            <a href="@Url.Action("CaseList")" class="btn btn-outline-gratuity rounded-pill shadow-sm bg-white">
                <i class="bi bi-list-ul me-2"></i> Case List
            </a>
        </div>
    </div>

    <div class="alert alert-warning border-0 shadow-sm rounded-pill mb-4 px-4 py-3 fade-in d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
        <div>
            <span class="fw-bold text-dark">Required Fields Check:</span> Please ensure all mandatory fields marked with a red asterisk (<span class="text-danger">*</span>) are filled correctly before saving.
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="All" class="text-danger alert alert-danger py-2 mb-4 shadow-sm border-0 border-start border-4 border-danger fade-in" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")">
        <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-octagon-fill me-2"></i> Please fix the following errors:</h6>
    </div>

    <form asp-action="@(Model.CaseID > 0 ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        @if (Model.CaseID > 0)
        {
            <input type="hidden" asp-for="CaseID" />
            <input type="hidden" id="hdnActionTaken" value="@Model.ActionTaken" />
            <input type="hidden" id="hdnAppealOutwardNo" value="@Model.AppealActionOutwardNo" />
            <input type="hidden" id="hdnAppealDate" value="@(Model.AppealActionDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" asp-for="AppealJudgmentPath" />
            <input type="hidden" asp-for="AdverseJudgmentPath" />
            <input type="hidden" asp-for="InitialActionPath1" />
            <input type="hidden" asp-for="InitialActionPath2" />
            <input type="hidden" asp-for="StayOrderPath1" />
            <input type="hidden" asp-for="StayOrderPath2" />

             @* Data Lock Fields (Preserve specialized data entered in Action/Claimant Appeal pages) *@
             <input type="hidden" asp-for="ActionTaken" />
             <input type="hidden" asp-for="IsFeasibilityReceived" />
             <input type="hidden" asp-for="FeasibilityReceiptDate" />
             <input type="hidden" asp-for="ApprovalOutwardNo" />
             <input type="hidden" asp-for="ApprovalDate" />
             <input type="hidden" asp-for="AppealActionOutwardNo" />
             <input type="hidden" asp-for="AppealActionDate" />
             <input type="hidden" asp-for="InitialActionRemarks" />
             <input type="hidden" asp-for="FinalRemarks" />

             <input type="hidden" asp-for="IsPendingForFiling" />
             <input type="hidden" asp-for="HighCourtBench" />
             <input type="hidden" asp-for="OtherHighCourtBench" />
             <input type="hidden" asp-for="StayGranted" />
             <input type="hidden" asp-for="StayComplianceOutwardNo" />
             <input type="hidden" asp-for="StayComplianceDate" />
             <input type="hidden" asp-for="CorpWPNumber" />
             <input type="hidden" asp-for="CorpWPYear" />
             <input type="hidden" asp-for="CorpWPAdvocate" />
             <input type="hidden" asp-for="CorpWPEntrustmentNo" />
             <input type="hidden" asp-for="CorpWPEntrustmentDate" />
             <input type="hidden" asp-for="CorpWPStatus" />
             <input type="hidden" asp-for="RestorationFiled" />
             <input type="hidden" asp-for="RestorationDate" />
             <input type="hidden" asp-for="RestorationStatus" />
             <input type="hidden" asp-for="CorpWPOutcome" />
             <input type="hidden" asp-for="CorpWPActionTaken" />
             <input type="hidden" asp-for="ClosureOutwardNo" />

             <input type="hidden" asp-for="IsClaimantSCAppeal" />
             <input type="hidden" asp-for="IsClaimantSCPending" />
             <input type="hidden" asp-for="ClaimantSCDiaryNumber" />
             <input type="hidden" asp-for="ClaimantSCYear" />
             <input type="hidden" asp-for="ClaimantSCNumber" />
             <input type="hidden" asp-for="ClaimantSLPYear" />
             <input type="hidden" asp-for="ClaimantSCFiledBy" />
             <input type="hidden" asp-for="ClaimantSCEntrustmentNo" />
             <input type="hidden" asp-for="ClaimantSCEntrustmentDate" />
             <input type="hidden" asp-for="ClaimantSCAdvocate" />
             <input type="hidden" asp-for="ClaimantSCStatus" />
             <input type="hidden" asp-for="ClaimantSCOutcome" />
             <input type="hidden" asp-for="ClaimantSCActionTaken" />
             <input type="hidden" asp-for="ClaimantSCClosureNo" />
             <input type="hidden" asp-for="ClaimantSCClosureDate" />

             <input type="hidden" asp-for="ClaimantDivisionID" />
             <input type="hidden" asp-for="ClaimantArisingWPNumber" />
             <input type="hidden" asp-for="ClaimantArisingWPYear" />
             <input type="hidden" asp-for="ClaimantMVCCurrentStatus" />
             <input type="hidden" asp-for="ClaimantWPNumber" />
             <input type="hidden" asp-for="ClaimantWPYear" />
             <input type="hidden" asp-for="ClaimantHighCourtBench" />
             <input type="hidden" asp-for="ClaimantOtherHighCourtBench" />
             <input type="hidden" asp-for="ClaimantWPEntrustmentNo" />
             <input type="hidden" asp-for="ClaimantWPEntrustmentDate" />
             <input type="hidden" asp-for="ClaimantWPAdvocate" />
             <input type="hidden" asp-for="ClaimantWPStatus" />
             <input type="hidden" asp-for="ClaimantWPDecision" />
             <input type="hidden" asp-for="ClaimantActionTaken" />
             <input type="hidden" asp-for="ClaimantApprovalNo" />
             <input type="hidden" asp-for="ClaimantApprovalDate" />

             <input type="hidden" asp-for="ComplianceStatus" />
             <input type="hidden" asp-for="FinalAmount" />
             <input type="hidden" asp-for="TotalServicePeriod" />
             <input type="hidden" asp-for="IsViewedByCO" />
        }

        <div class="card border-0 shadow-lg main-form-card">
            <div class="card-header bg-white border-bottom p-0 overflow-hidden">
                <ul class="nav nav-tabs nav-justified modern-tabs" id="gratuityTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(Model.CaseID > 0 && (Model.ActionTaken == "Appeal" || Model.ForwardingStatus == "Appeal before Appellant Authority") ? "" : "active")" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">
                            <i class="bi bi-info-square me-2"></i><span>1. Basic Details</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="outcome-tab" data-bs-toggle="tab" data-bs-target="#outcome" type="button" role="tab">
                            <i class="bi bi-calculator me-2"></i><span>2. Outcome & Assessment</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation" id="appeal-tab-container">
                        <button class="nav-link @(Model.CaseID > 0 && (Model.ActionTaken == "Appeal" || Model.ForwardingStatus == "Appeal before Appellant Authority") ? "active" : "")" id="appeal-tab" data-bs-toggle="tab" data-bs-target="#appeal" type="button" role="tab">
                            <i class="bi bi-gavel me-2"></i><span>3. Appeal Details</span>
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="card-body p-4">
                <div class="tab-content" id="gratuityTabsContent">
                    
                    <!-- TAB 1: Basic Details -->
                    <div class="tab-pane fade @(Model.CaseID > 0 && (Model.ActionTaken == "Appeal" || Model.ForwardingStatus == "Appeal before Appellant Authority") ? "" : "show active")" id="basic" role="tabpanel">
                        <h5 class="fw-bold text-gratuity mb-3 section-heading">Case Information</h5>
                        <div class="row g-3">
                            <div class="col-md-3">
                                @if (ViewBag.IsCentralOffice == true)
                                {
                                    <label asp-for="DivisionCode" class="form-label">Division</label>
                                    <select asp-for="DivisionCode" asp-items="Model.DivisionList" class="form-select">
                                        <option value="">-- Select Division --</option>
                                    </select>
                                }
                                else
                                {
                                    <label for="DisplayDivisionName" class="form-label">Division</label>
                                    <input type="hidden" name="DivisionCode" value="@Model.DivisionCode" id="hdnDivisionCode" />
                                    <input id="DisplayDivisionName" name="DisplayDivisionName" class="form-control" value="@ViewBag.UserDivisionName" readonly />
                                }
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CaseStatus" class="form-label">Case Status</label>
                                <select asp-for="CaseStatus" asp-items="Model.StatusList" class="form-select">
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CourtType" class="form-label">Court</label>
                                <input asp-for="CourtType" class="form-control" value="@(string.IsNullOrEmpty(Model.CourtType) ? "Controlling Authority" : Model.CourtType)" readonly />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="PGANumber" class="form-label">PGA / CR Number <span class="text-danger">*</span></label>
                                <input asp-for="PGANumber" class="form-control" required />
                                <span asp-validation-for="PGANumber" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-4">
                                <label asp-for="ClaimantName" class="form-label">Claimant Name <span class="text-danger">*</span></label>
                                <input asp-for="ClaimantName" class="form-control" required />
                                <span asp-validation-for="ClaimantName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                            </div>
                            <div class="col-md-4">
                                <label for="DesignationSelect" class="form-label">Designation</label>
                                <select id="DesignationSelect" class="form-select others-dropdown" 
                                        data-others-target="DesignationManual" 
                                        data-others-hidden="ClaimantDesignationHidden"
                                        asp-items="Model.DesignationList">
                                    <option value="">-- Select Designation --</option>
                                </select>
                                <input type="text" id="DesignationManual" class="form-control others-manual mt-2" 
                                       data-others-select="DesignationSelect" placeholder="Enter Designation" aria-label="Enter Custom Designation" style="display:none;" />
                                <input type="hidden" asp-for="ClaimantDesignation" id="ClaimantDesignationHidden" />
                            </div>
                             <div class="col-md-4">
                                <label for="WorkingStatusSelect" class="form-label">Working Status</label>
                                <select id="WorkingStatusSelect" class="form-select others-dropdown" 
                                        data-others-target="WorkingStatusManual" 
                                        data-others-hidden="WorkingStatusHidden"
                                        asp-items="Model.WorkingStatusList">
                                     <option value="">-- Select Status --</option>
                                </select>
                                <input type="text" id="WorkingStatusManual" class="form-control others-manual mt-2" 
                                       data-others-select="WorkingStatusSelect" placeholder="Enter Status" aria-label="Enter Custom Working Status" style="display:none;" />
                                <input type="hidden" asp-for="WorkingStatus" id="WorkingStatusHidden" />
                            </div>

                            <!-- VRS Additional Benefits Section -->
                            <div class="col-md-8" id="vrsBenefitSection">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label d-block">Any additional benefits given? (if VRS)</label>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" asp-for="IsAdditionalBenefitsGiven" value="true" id="vrsBenefitYes">
                                            <label class="form-check-label" for="vrsBenefitYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" asp-for="IsAdditionalBenefitsGiven" value="false" id="vrsBenefitNo">
                                            <label class="form-check-label" for="vrsBenefitNo">No</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6" id="vrsAmountDiv">
                                        <label asp-for="AdditionalBenefitsAmount" class="form-label">Additional Benefits Amount</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="AdditionalBenefitsAmount" class="form-control" placeholder="0.00" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="EntrustmentNo" class="form-label">Entrustment No <span class="text-danger">*</span></label>
                                <input asp-for="EntrustmentNo" class="form-control" required />
                                <span asp-validation-for="EntrustmentNo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EntrustmentDate" class="form-label">Entrustment Date <span class="text-danger">*</span></label>
                                <input asp-for="EntrustmentDate" type="date" class="form-control" required />
                                <span asp-validation-for="EntrustmentDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AdvocateName" class="form-label">Advocate Name</label>
                                <input asp-for="AdvocateName" class="form-control" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="AmountClaimed" class="form-label text-uppercase fw-bold text-gratuity">CLAIM DETAILS</label>
                                <textarea asp-for="AmountClaimed" class="form-control border-gratuity border-2" rows="1" placeholder="Enter claim details..."></textarea>
                            </div>
                        </div>

                        <h5 class="fw-bold text-gratuity mb-3 section-heading">Case Progress</h5>
                        <div class="row g-3 mb-4 border-bottom pb-4">
                            <!-- Document Sent -->
                            <div class="col-md-4">
                                <label class="form-label d-block">Document Sent?</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="true" asp-for="IsDocumentSent" id="isDocSentYes">
                                    <label class="form-check-label" for="isDocSentYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" value="false" asp-for="IsDocumentSent" id="isDocSentNo">
                                    <label class="form-check-label" for="isDocSentNo">No</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DocumentOutwardNo" class="form-label">Document Outward Number</label>
                                <input asp-for="DocumentOutwardNo" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DocumentOutwardDate" class="form-label">Document Outward Date</label>
                                <input asp-for="DocumentOutwardDate" class="form-control" type="date" />
                            </div>

                            <!-- Objection Filed -->
                            <div class="col-md-4">
                                <label class="form-label d-block">Objection Filed?</label>
                                <div class="form-check form-check-inline">
                                     <input class="form-check-input" type="radio" value="true" asp-for="IsObjectionFiled" id="isObjFiledYes">
                                     <label class="form-check-label" for="isObjFiledYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                     <input class="form-check-input" type="radio" value="false" asp-for="IsObjectionFiled" id="isObjFiledNo">
                                     <label class="form-check-label" for="isObjFiledNo">No</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ObjectionOutwardNo" class="form-label">Objection Outward No</label>
                                <input asp-for="ObjectionOutwardNo" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ObjectionFiledDate" class="form-label">Objection Filed Date</label>
                                <input asp-for="ObjectionFiledDate" class="form-control" type="date" />
                            </div>

                            <!-- Evidence Filed -->
                            <div class="col-md-4">
                                <label class="form-label d-block">Evidence Filed?</label>
                                <div class="form-check form-check-inline">
                                     <input class="form-check-input" type="radio" value="true" asp-for="IsEvidenceFiled" id="isEvidFiledYes">
                                     <label class="form-check-label" for="isEvidFiledYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                     <input class="form-check-input" type="radio" value="false" asp-for="IsEvidenceFiled" id="isEvidFiledNo">
                                     <label class="form-check-label" for="isEvidFiledNo">No</label>
                                </div>
                            </div>

                            <!-- Stage & Hearing -->
                            <div class="col-md-4">
                                <label asp-for="CurrentStage" class="form-label">Current Stage</label>
                                <input asp-for="CurrentStage" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NextHearingDate" class="form-label">Next Date of Hearing</label>
                                <input asp-for="NextHearingDate" class="form-control" type="date" />
                            </div>
                        </div>
                        <h5 class="fw-bold text-gratuity mb-3 section-heading">Case Outcome</h5>
                        <div class="row g-3 mb-4 border-bottom pb-4">
                            <div class="col-md-6">
                                <label asp-for="DisposalResult" class="form-label">Result</label>
                                <select asp-for="DisposalResult" class="form-select">
                                    <option value="">-- Select Result --</option>
                                    <option value="In Favour of Corporation">In Favour of Corporation</option>
                                    <option value="Against Corporation">Against Corporation</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DisposalDate" class="form-label">Case Disposed On</label>
                                <input asp-for="DisposalDate" type="date" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: Outcome & Work After Disposal -->
                    <div class="tab-pane fade" id="outcome" role="tabpanel">

                        <h5 class="fw-bold text-gratuity mb-3 section-heading">Work After Disposal (Claim & Service Particulars)</h5>
                        <div class="row g-3 mb-4">
                             <!-- Common Service Dates removed, moved to respective columns -->

                        </div>

                        <!-- Comparative Assessment -->
                        <div class="row g-4">
                            <!-- Corporation Assessment -->
                            <div class="col-md-6 border-end">
                                <div class="assessment-box corp h-100">
                                    <h6 class="fw-bold text-gratuity mb-4 border-bottom pb-2"><i class="bi bi-building-fill me-2"></i>Corporation Assessment as per SR</h6>
                                    
                                     <div class="mb-3">
                                        <label asp-for="AppointmentDate" class="form-label">Date of Appointment</label>
                                        <input asp-for="AppointmentDate" type="date" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="RetirementDate" class="form-label">Date of Retirement / Dismissal / VRS / Death</label>
                                        <input asp-for="RetirementDate" type="date" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Break in Service (SPE/LWA/ABS)</label>
                                        <div class="row g-2">
                                            <div class="col-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" id="break_years" class="form-control" min="0" placeholder="0" aria-label="Break in Service Years" />
                                                    <span class="input-group-text">Yrs</span>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" id="break_months" class="form-control" min="0" max="11" placeholder="0" aria-label="Break in Service Months" />
                                                    <span class="input-group-text">Mon</span>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" id="break_days" class="form-control" min="0" max="30" placeholder="0" aria-label="Break in Service Days" />
                                                    <span class="input-group-text">Days</span>
                                                </div>
                                            </div>
                                        </div>
                                        <input asp-for="Period_SPE_LWA_ABS" type="hidden" id="Period_SPE_LWA_ABS" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Qualifying Service (Length)</label>
                                        <div class="row g-2">
                                            <div class="col-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" id="qs_years" class="form-control" min="0" placeholder="0" aria-label="Qualifying Service Years" />
                                                    <span class="input-group-text">Yrs</span>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" id="qs_months" class="form-control" min="0" max="11" placeholder="0" aria-label="Qualifying Service Months" />
                                                    <span class="input-group-text">Mon</span>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" id="qs_days" class="form-control" min="0" max="30" placeholder="0" aria-label="Qualifying Service Days" />
                                                    <span class="input-group-text">Days</span>
                                                </div>
                                            </div>
                                        </div>
                                        <input asp-for="QualifyingService_Corp" type="hidden" id="QualifyingService_Corp" />
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-4">
                                            <label asp-for="LastDrawnBasic" class="form-label">Last Drawn Basic</label>
                                            <div class="input-group">
                                                <span class="input-group-text">₹</span>
                                                <input asp-for="LastDrawnBasic" class="form-control text-end" placeholder="0.00" />
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <label asp-for="LastDrawnBDA" class="form-label">BDA</label>
                                            <div class="input-group">
                                                <span class="input-group-text">₹</span>
                                                <input asp-for="LastDrawnBDA" class="form-control text-end" placeholder="0.00" />
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <label asp-for="LastDrawnDA" class="form-label">DA</label>
                                            <div class="input-group">
                                                <span class="input-group-text">₹</span>
                                                <input asp-for="LastDrawnDA" class="form-control text-end" placeholder="0.00" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="GratuityAmount_Corp_Act" class="form-label">Gratuity Amount (As per Act)</label>
                                        <input asp-for="GratuityAmount_Corp_Act" class="form-control border-gratuity" />
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="GratuityAmount_Corp_Reg" class="form-label">Gratuity Amount (As per Regulation)</label>
                                        <input asp-for="GratuityAmount_Corp_Reg" class="form-control border-gratuity" />
                                    </div>
                                </div>
                            </div>

                            <!-- ALC Assessment -->
                            <div class="col-md-6">
                                <div class="assessment-box ca h-100">
                                    <h6 class="fw-bold text-primary mb-4 border-bottom pb-2"><i class="bi bi-journal-check me-2"></i>Controlling authority assessment</h6>
                                    
