@section Scripts {
    <script>
        $(document).ready(function() {
            function toggleDeductionDetails() {
                if ($('#chkDeduction').is(':checked')) {
                    $('#divDeductionDetails').slideDown();
                } else {
                    $('#divDeductionDetails').slideUp();
                }
            }

            function toggleDeductionDetailsCA() {
                if ($('#chkDeduction_CA').is(':checked')) {
                    $('#divDeductionDetails_CA').slideDown();
                } else {
                    $('#divDeductionDetails_CA').slideUp();
                }
            }



            // Function to handle PGA Label based on Court selection
            function updatePGALabel() {
                var court = $('#CourtType option:selected').text();
                if (court && court.indexOf('Appellate Authority') !== -1) {
                     $('label[for="PGANumber"]').text('PGA / Appeal CR Number');
                } else {
                     $('label[for="PGANumber"]').text('PGA / CR Number');
                }
            }

            // Initial check
            toggleDeductionDetails();
            toggleDeductionDetailsCA();
            updatePGALabel();

            // Sync Disposal Date between Basic Details (Tab 1) and Certified Copy (Tab 2)
            $('#DisposalDate').on('input change', function() {
                $('#DisposalDate_Copy').val($(this).val());
            });
            $('#DisposalDate_Copy').on('input change', function() {
                $('#DisposalDate').val($(this).val());
            });
            if ($('#DisposalDate').val()) {
                $('#DisposalDate_Copy').val($('#DisposalDate').val());
            }

            // On change
            $('#chkDeduction').change(toggleDeductionDetails);
            $('#chkDeduction_CA').change(toggleDeductionDetailsCA);
            $('#CourtType').change(updatePGALabel);

            // Ensure all sections remain visible without arbitrary collapse
            function toggleForwardingDetails() {
                var status = $('#forwardStatusSelect').val();
                if (status === "Sent to Central Office") {
                    $('.co-only').addClass('border-primary');
                } else {
                    $('.co-only').removeClass('border-primary');
                }
            }

            $('#forwardStatusSelect').change(toggleForwardingDetails);
            
            function toggleVRSBenefits() {
                var status = $('#WorkingStatusSelect').val();
                if (status === "VRS") {
                    $('#vrsBenefitSection').fadeIn(200);
                }
            }

            $('#WorkingStatusSelect').change(toggleVRSBenefits);

            // Initial call
            toggleForwardingDetails();
            toggleVRSBenefits();

            // Populate Breakdown Fields from Saved String (Edit Mode)
            function populateServiceBreakdown(val, yrsId, monId, daysId) {
                if (!val || val === '-' || val === '') return;
                const yMatch = val.match(/(\d+)\s*Yrs/i);
                const mMatch = val.match(/(\d+)\s*Mon/i);
                const dMatch = val.match(/(\d+)\s*Days/i);
                if (yMatch) $('#' + yrsId).val(yMatch[1]);
                if (mMatch) $('#' + monId).val(mMatch[1]);
                if (dMatch) $('#' + daysId).val(dMatch[1]);
            }

            const corpBreak = $('#Period_SPE_LWA_ABS').val();
            const corpQS = $('#QualifyingService_Corp').val();
            const caBreak = $('#Period_SPE_LWA_ABS_CA').val();
            const caQS = $('#QualifyingService_CA').val();

            populateServiceBreakdown(corpBreak, 'break_years', 'break_months', 'break_days');
            populateServiceBreakdown(corpQS, 'qs_years', 'qs_months', 'qs_days');
            populateServiceBreakdown(caBreak, 'break_years_ca', 'break_months_ca', 'break_days_ca');
            populateServiceBreakdown(caQS, 'qs_years_ca', 'qs_months_ca', 'qs_days_ca');

            // Trigger initial calculations
            calculateGratuity();

            // Dynamic Payment Rows
            $('#btnAddPayment').click(function() {
                var index = $('#paymentTable tbody tr').length;
                var newRow = `
                    <tr>
                        <td>
                            <input type="number" name="Payments[${index}].Amount" class="form-control form-control-sm" placeholder="0.00" step="0.01" required />
                        </td>
                        <td>
                            <input type="text" name="Payments[${index}].ChequeNumber" class="form-control form-control-sm" placeholder="Cheque No" />
                        </td>
                        <td>
                            <input type="date" name="Payments[${index}].ChequeDate" class="form-control form-control-sm" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-link text-danger p-0 btnRemovePayment"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`;
                $('#paymentTable tbody').append(newRow);
            });

            $(document).on('click', '.btnRemovePayment', function() {
                $(this).closest('tr').remove();
                reindexPayments();
            });

            function reindexPayments() {
                $('#paymentTable tbody tr').each(function(index) {
                    $(this).find('input').each(function() {
                        var name = $(this).attr('name');
                        if (name) {
                            var newName = name.replace(/\[\d+\]/, '[' + index + ']');
                            $(this).attr('name', newName);
                        }
                    });
                });
            }



            // Retirement Date Auto-calculation
            $('#DateOfBirth').change(function() {
                var dobValue = $(this).val();
                if (dobValue) {
                    var dob = new Date(dobValue);
                    if (!isNaN(dob.getTime())) {
                        var retirementDate = new Date(dob);
                        retirementDate.setFullYear(dob.getFullYear() + 60);
                        
                        // Modified logic for date of retirement calculation:
                        // 1. If date of retirement is the 1st of any month, the retirement date is the last date of the previous month.
                        // 2. If it is after the 1st of any month, the retirement date is the last date of that same month.
                        var day = retirementDate.getDate();
                        if (day === 1) {
                            // Set to last day of previous month
                            retirementDate.setDate(0); 
                        } else {
                            // Set to last day of current month
                            retirementDate.setMonth(retirementDate.getMonth() + 1);
                            retirementDate.setDate(0);
                        }

                        // Format to YYYY-MM-DD for date input
                        var year = retirementDate.getFullYear();
                        var month = ('0' + (retirementDate.getMonth() + 1)).slice(-2);
                        var dayFormatted = ('0' + retirementDate.getDate()).slice(-2);
                        var formattedDate = year + '-' + month + '-' + dayFormatted;
                        
                        $('#RetirementDate').val(formattedDate).trigger('change');
                        $('#RetirementDate_CA').val(formattedDate).trigger('change');
                    }
                }
            });

            function calculateService(startId, endId, bYId, bMId, bDId, tYId, tMId, tDId) {
                const startStr = $('#' + startId).val();
                const endStr = $('#' + endId).val();
                
                if (!startStr || !endStr) return;

                let start = new Date(startStr);
                let end = new Date(endStr);

                if (isNaN(start.getTime()) || isNaN(end.getTime()) || end < start) {
                    $('#' + tYId).val(0);
                    $('#' + tMId).val(0);
                    $('#' + tDId).val(0);
                    return;
                }

                // Calculate initial difference
                let years = end.getFullYear() - start.getFullYear();
                let months = end.getMonth() - start.getMonth();
                let days = end.getDate() - start.getDate();

                if (days < 0) {
                    months--;
                    let prevMonth = new Date(end.getFullYear(), end.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }

                // Subtract Break in Service
                const breakY = parseInt($('#' + bYId).val()) || 0;
                const breakM = parseInt($('#' + bMId).val()) || 0;
                const breakD = parseInt($('#' + bDId).val()) || 0;

                years -= breakY;
                months -= breakM;
                days -= breakD;

                if (days < 0) {
                    months--;
                    days += 30; // Approximation for normalized subtraction
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }
                
                if (years < 0) { years = 0; months = 0; days = 0; }

                $('#' + tYId).val(years);
                $('#' + tMId).val(months);
                $('#' + tDId).val(days);
                
                calculateGratuity();
            }

            // Bind calculation to relevant inputs
            const fieldsToBind = [
                '#AppointmentDate', '#RetirementDate', '#break_years', '#break_months', '#break_days',
                '#AppointmentDate_CA', '#RetirementDate_CA', '#break_years_ca', '#break_months_ca', '#break_days_ca'
            ];

            $(fieldsToBind.join(',')).on('input change', function() {
                if (this.id.includes('_ca') || this.id.includes('_CA')) {
                    calculateService('AppointmentDate_CA', 'RetirementDate_CA', 'break_years_ca', 'break_months_ca', 'break_days_ca', 'qs_years_ca', 'qs_months_ca', 'qs_days_ca');
                } else {
                    calculateService('AppointmentDate', 'RetirementDate', 'break_years', 'break_months', 'break_days', 'qs_years', 'qs_months', 'qs_days');
                }
            });

            // Gratuity Calculation Logic (Act & Regulation)



            function calculateGratuity() {
                // --- 1. Corporation Assessment ---
                const basic = parseFloat($('#LastDrawnBasic').val()) || 0;
                const bda = parseFloat($('#LastDrawnBDA').val()) || 0;
                const da = parseFloat($('#LastDrawnDA').val()) || 0;
                
                const qsYears = parseInt($('#qs_years').val()) || 0;
                const qsMonths = parseInt($('#qs_months').val()) || 0;

                // A. Act Calculation
                // Rule: If > 6 months, count as next year
                let actYears = qsYears;
                if (qsMonths > 6) {
                    actYears += 1;
                }
                const totalPayAct = basic + bda + da;
                
                if (totalPayAct > 0 && actYears > 0) {
                    // Formula: (Basic+BDA+DA) * 15 * (Years / 26)
                    const gratuityAct = totalPayAct * 15 * (actYears / 26);
                    $('#GratuityAmount_Corp_Act').val(gratuityAct.toFixed(2));
                }

                // B. Regulation Calculation
                // Formula: (Basic + BDA) * (Years + Months / 12)
                const totalPayReg = basic + bda;
                if (totalPayReg > 0) {
                    const gratuityReg = (totalPayReg * qsYears) + (totalPayReg * qsMonths / 12.0);
                    $('#GratuityAmount_Corp_Reg').val(gratuityReg.toFixed(2));
                }


                // --- 2. ALC (Controlling Authority) Assessment ---
                const basicCA = parseFloat($('#LastDrawnBasic_CA').val()) || 0;
                const bdaCA = parseFloat($('#LastDrawnBDA_CA').val()) || 0;
                const daCA = parseFloat($('#LastDrawnDA_CA').val()) || 0;
                
                const qsYearsCA = parseInt($('#qs_years_ca').val()) || 0;
                const qsMonthsCA = parseInt($('#qs_months_ca').val()) || 0;

                // A. Act Calculation (CA)
                let actYearsCA = qsYearsCA;
                if (qsMonthsCA > 6) {
                    actYearsCA += 1;
                }
                const totalPayActCA = basicCA + bdaCA + daCA;

                if (totalPayActCA > 0 && actYearsCA > 0) {
                     const gratuityActCA = totalPayActCA * 15 * (actYearsCA / 26);
                     $('#GratuityAmount_CA_Act').val(gratuityActCA.toFixed(2));
                }

                // B. Regulation Calculation (CA)
                // Formula: (Basic + BDA) * (Years + Months / 12)
                const totalPayRegCA = basicCA + bdaCA;
                if (totalPayRegCA > 0) {
                    const gratuityRegCA = (totalPayRegCA * qsYearsCA) + (totalPayRegCA * qsMonthsCA / 12.0);
                    $('#GratuityAmount_CA_Reg').val(gratuityRegCA.toFixed(2));
                }
                updateDifferenceAmount();
            }

            function updateDifferenceAmount() {
                let actualPaid = parseFloat($('#ActualPaidAmount_CA').val()) || 0;
                if (actualPaid === 0 && $('#paymentTable').length > 0) {
                    let sumPayments = 0;
                    $('#paymentTable tbody tr input[name*=".Amount"]').each(function() {
                        sumPayments += parseFloat($(this).val()) || 0;
                    });
                    if (sumPayments > 0) {
                        actualPaid = sumPayments;
                    }
                }

                let selectedMode = $('input[name="diffAmountMode"]:checked').val() || 'reg';

                let baselineGratuity = 0;
                let labelTitle = "";
                let subDetail = "";

                if (selectedMode === 'reg') {
                    let caReg = parseFloat($('#GratuityAmount_CA_Reg').val()) || 0;
                    let corpReg = parseFloat($('#GratuityAmount_Corp_Reg').val()) || 0;
                    baselineGratuity = caReg > 0 ? caReg : corpReg;
                    
                    labelTitle = "Difference (Regulation - Actual Paid)";
                    subDetail = caReg > 0 
                        ? "Comparing against Controlling Auth Regulation (₹ " + caReg.toLocaleString('en-IN', {minimumFractionDigits: 2}) + ")" 
                        : "Comparing against Corporation Regulation (₹ " + corpReg.toLocaleString('en-IN', {minimumFractionDigits: 2}) + ")";
                } else {
                    let caAct = parseFloat($('#GratuityAmount_CA_Act').val()) || 0;
                    let corpAct = parseFloat($('#GratuityAmount_Corp_Act').val()) || 0;
                    baselineGratuity = caAct > 0 ? caAct : corpAct;

                    labelTitle = "Difference (Act - Actual Paid)";
                    subDetail = caAct > 0 
                        ? "Comparing against Controlling Auth Act (₹ " + caAct.toLocaleString('en-IN', {minimumFractionDigits: 2}) + ")" 
                        : "Comparing against Corporation Act (₹ " + corpAct.toLocaleString('en-IN', {minimumFractionDigits: 2}) + ")";
                }

                let diff = baselineGratuity - actualPaid;

                $('#diffModeLabel').text(labelTitle);
                $('#diffSubDetail').text(subDetail);
                $('#diffAmountDisplay').text("₹ " + Math.abs(diff).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}));

                let $display = $('#diffAmountDisplay');
                let $badge = $('#diffBadgeText');

                if (diff > 0) {
                    $display.removeClass('text-success text-dark text-primary').addClass('text-danger');
                    $badge.removeClass('bg-secondary-subtle text-secondary-emphasis bg-success-subtle text-success-emphasis')
                          .addClass('bg-danger-subtle text-danger-emphasis')
                          .text("Shortage / Excess Liability: ₹ " + diff.toLocaleString('en-IN', {minimumFractionDigits: 2}));
                } else if (diff < 0) {
                    $display.removeClass('text-danger text-dark text-primary').addClass('text-success');
                    $badge.removeClass('bg-secondary-subtle text-secondary-emphasis bg-danger-subtle text-danger-emphasis')
                          .addClass('bg-success-subtle text-success-emphasis')
                          .text("Overpaid: ₹ " + Math.abs(diff).toLocaleString('en-IN', {minimumFractionDigits: 2}));
                } else {
                    $display.removeClass('text-danger text-success text-primary').addClass('text-dark');
                    $badge.removeClass('bg-danger-subtle text-danger-emphasis bg-success-subtle text-success-emphasis')
                          .addClass('bg-secondary-subtle text-secondary-emphasis')
                          .text("Fully Settled (₹ 0.00)");
                }
            }

            // Bind calculation to relevant inputs
            $('#LastDrawnBasic, #LastDrawnBDA, #LastDrawnDA, #qs_years, #qs_months').on('input change', calculateGratuity);
            $('#LastDrawnBasic_CA, #LastDrawnBDA_CA, #LastDrawnDA_CA, #qs_years_ca, #qs_months_ca').on('input change', calculateGratuity);
            $(document).on('input change', '#ActualPaidAmount_CA, #GratuityAmount_CA_Reg, #GratuityAmount_CA_Act, #GratuityAmount_Corp_Reg, #GratuityAmount_Corp_Act, input[name="diffAmountMode"], #paymentTable input', updateDifferenceAmount);
            $(document).ready(updateDifferenceAmount);

            // Interest Payments Table Logic
            $('#btnAddInterestPayment').click(function() {
                var index = $('#interestPaymentTable tbody tr').length;
                var row = '<tr>' +
                    '<td><div class="input-group input-group-sm"><span class="input-group-text">₹</span><input type="number" name="InterestPayments[' + index + '].Amount" class="form-control form-control-sm text-end interest-amount-input" placeholder="0.00" step="0.01" /></div></td>' +
                    '<td><input type="date" name="InterestPayments[' + index + '].FromDate" class="form-control form-control-sm" /></td>' +
                    '<td><input type="date" name="InterestPayments[' + index + '].ToDate" class="form-control form-control-sm" /></td>' +
                    '<td class="text-center"><button type="button" class="btn btn-link text-danger p-0 btnRemoveInterestPayment"><i class="bi bi-trash fs-6"></i></button></td>' +
                    '</tr>';
                $('#interestPaymentTable tbody').append(row);
                updateInterestTotal();
            });

            $(document).on('click', '.btnRemoveInterestPayment', function() {
                if ($('#interestPaymentTable tbody tr').length > 1) {
                    $(this).closest('tr').remove();
                    reindexInterestPayments();
                    updateInterestTotal();
                } else {
                    $(this).closest('tr').find('input').val('');
                    updateInterestTotal();
                }
            });

            function reindexInterestPayments() {
                $('#interestPaymentTable tbody tr').each(function(i, tr) {
                    $(tr).find('input[name*="InterestPayments"]').each(function() {
                        var name = $(this).attr('name');
                        if (name) {
                            var newName = name.replace(/InterestPayments\[\d+\]/, 'InterestPayments[' + i + ']');
                            $(this).attr('name', newName);
                        }
                    });
                });
            }

            function updateInterestTotal() {
                var total = 0;
                $('#interestPaymentTable tbody tr .interest-amount-input').each(function() {
                    var val = parseFloat($(this).val()) || 0;
                    total += val;
                });
                if (total > 0) {
                    $('#OrderedAmount_CA').val(total.toFixed(2));
                }
            }

            $(document).on('input change', '#interestPaymentTable tbody input', updateInterestTotal);
            $(document).ready(updateInterestTotal);

            // Auto-populate Year from Case Number fields (e.g., 123/2023 -> 2023)
            function setupYearAutoPopulate(numberId, yearId, stripFromSource) {
                $('#' + numberId).on('input blur', function(e) {
                    let val = $(this).val();
                    if (val) {
                        // Match separator and 4-digit year at the end
                        const match = val.match(/([\/\-]?(20\d{2}|19\d{2}))$/);
                        if (match) {
                            const yearMatch = match[0];
                            const year = yearMatch.replace(/[\/\-]/, '');
                            $('#' + yearId).val(year);
                            
                            // Optional: Strip year from source (e.g., for Arising No)
                            // Only strip on blur or automated trigger to prevent typing issues
                            if (stripFromSource && (e.type === 'blur' || e.isTrigger)) {
                                $(this).val(val.replace(yearMatch, '').trim());
                            }
                        }
                    }
                });
            }

            setupYearAutoPopulate('AppealNumber', 'AppealYear');
            setupYearAutoPopulate('AppealArisingNo', 'AppealArisingYear', true);
            
            // Auto-populate Arising Out of PGA/CR No from the original PGA / CR Number field
            $('#PGANumber').on('input blur', function() {
                $('#AppealArisingNo').val($(this).val()).trigger('input');
            });

            // Initial Triggers for Edit Mode / Prefilled values
            $(document).ready(function() {
                // If Arising Number is empty, mirror from main PGA field
                if (!$('#AppealArisingNo').val() && $('#PGANumber').val()) {
                    $('#AppealArisingNo').val($('#PGANumber').val());
                }
                
                // Trigger year extraction for all relevant fields on load
                $('#AppealNumber').trigger('input');
                $('#AppealArisingNo').trigger('input');
            });

            // --- Others Dropdown: Witness Designation ---
            (function() {
                var $select = $('#WitnessDesignationSelect');
                var $manual = $('#WitnessDesignationManual');
                var $hidden = $('#WitnessDesignationHidden');

                function syncWitnessDesignation() {
                    var val = $select.val();
                    if (val === 'Others') {
                        $manual.slideDown(200);
                        $hidden.val($manual.val());
                    } else {
                        $manual.slideUp(200);
                        $hidden.val(val);
                    }
                }

                // On load: if saved value is not in the list, treat as 'Others'
                var savedVal = $hidden.val();
                var inList = $select.find('option').filter(function() {
                    return $(this).val() === savedVal && $(this).val() !== '';
                }).length > 0;

                if (savedVal && !inList) {
                    $select.val('Others');
                    $manual.val(savedVal).show();
                } else if (savedVal) {
                    $select.val(savedVal);
                }

                $select.on('change', syncWitnessDesignation);
                $manual.on('input', function() {
                    $hidden.val($(this).val());
                });
            })();

        });

        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('.needs-validation');
            if (form) {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                        
                        // If invalid, show the first tab with an error
                        const firstInvalid = form.querySelector(':invalid');
                        if (firstInvalid) {
                            const tabPane = firstInvalid.closest('.tab-pane');
                            if (tabPane) {
                                const tabId = tabPane.id;
                                const tabButton = document.querySelector(`[data-bs-target="#${tabId}"]`);
                                if (tabButton) {
                                    bootstrap.Tab.getOrCreateInstance(tabButton).show();
                                }
                            }
                        }
                    }
                    form.classList.add('was-validated');
                    updateHiddenServiceFields();
                }, false);

                function updateHiddenServiceFields() {
                    // Combine Corporation Break in Service
                    const breakYears = document.getElementById('break_years')?.value || '0';
                    const breakMonths = document.getElementById('break_months')?.value || '0';
                    const breakDays = document.getElementById('break_days')?.value || '0';
                    let breakValue = '';
                    if (breakYears != '0') breakValue += breakYears + ' Yrs ';
                    if (breakMonths != '0') breakValue += breakMonths + ' Mon ';
                    if (breakDays != '0') breakValue += breakDays + ' Days';
                    const periodField = document.getElementById('Period_SPE_LWA_ABS');
                    if(periodField) periodField.value = breakValue.trim() || '-';
                    
                    // Combine Corporation Qualifying Service
                    const qsYears = document.getElementById('qs_years')?.value || '0';
                    const qsMonths = document.getElementById('qs_months')?.value || '0';
                    const qsDays = document.getElementById('qs_days')?.value || '0';
                    let qsValue = '';
                    if (qsYears != '0') qsValue += qsYears + ' Yrs ';
                    if (qsMonths != '0') qsValue += qsMonths + ' Mon ';
                    if (qsDays != '0') qsValue += qsDays + ' Days';
                    const qsField = document.getElementById('QualifyingService_Corp');
                    if(qsField) qsField.value = qsValue.trim() || '-';
                    
                    // Combine CA Break in Service
                    const breakYearsCa = document.getElementById('break_years_ca')?.value || '0';
                    const breakMonthsCa = document.getElementById('break_months_ca')?.value || '0';
                    const breakDaysCa = document.getElementById('break_days_ca')?.value || '0';
                    let breakValueCa = '';
                    if (breakYearsCa != '0') breakValueCa += breakYearsCa + ' Yrs ';
                    if (breakMonthsCa != '0') breakValueCa += breakMonthsCa + ' Mon ';
                    if (breakDaysCa != '0') breakValueCa += breakDaysCa + ' Days';
                    const periodFieldCa = document.getElementById('Period_SPE_LWA_ABS_CA');
                    if(periodFieldCa) periodFieldCa.value = breakValueCa.trim() || '-';
                    
                    // Combine CA Qualifying Service
                    const qsYearsCa = document.getElementById('qs_years_ca')?.value || '0';
                    const qsMonthsCa = document.getElementById('qs_months_ca')?.value || '0';
                    const qsDaysCa = document.getElementById('qs_days_ca')?.value || '0';
                    let qsValueCa = '';
                    if (qsYearsCa != '0') qsValueCa += qsYearsCa + ' Yrs ';
                    if (qsMonthsCa != '0') qsValueCa += qsMonthsCa + ' Mon ';
                    if (qsDaysCa != '0') qsValueCa += qsDaysCa + ' Days';
                    const qsFieldCa = document.getElementById('QualifyingService_CA');
                    if(qsFieldCa) qsFieldCa.value = qsValueCa.trim() || '-';
                }

                // Attach listeners to update hidden fields on change
                const serviceInputs = document.querySelectorAll('#break_years, #break_months, #break_days, #qs_years, #qs_months, #qs_days, #break_years_ca, #break_months_ca, #break_days_ca, #qs_years_ca, #qs_months_ca, #qs_days_ca');
                serviceInputs.forEach(input => {
                    input.addEventListener('input', updateHiddenServiceFields);
                    input.addEventListener('change', updateHiddenServiceFields);
                });

                // Claimant Appeal Toggles
                function toggleClaimantOutcome() {
                    const status = $("#claimantWPStatus").val();
                    if (status === "Pending" || !status) {
                        $("#claimantOutcomeMainSection").slideUp(300);
                        $("#claimantClosureSection").slideUp(300);
                    } else {
                        $("#claimantOutcomeMainSection").slideDown(300);
                        toggleClaimantClosureSection();
                    }
                }

                function toggleClaimantClosureSection() {
                    const actionTaken = $("#claimantActionTaken").val();
                    if (actionTaken === 'Close') {
                        $("#claimantClosureSection").slideDown(300);
                    } else {
                        $("#claimantClosureSection").slideUp(300);
                    }
                }

                $("#claimantWPStatus").on("change", toggleClaimantOutcome);
                $("#claimantActionTaken").on("change", toggleClaimantClosureSection);
                
                // Initial call
                toggleClaimantOutcome();
            }
        });

        // Standardized Document Management
        $(document).on('click', '.btn-add-enclosed-doc', function() {
            var container = $('#enclosedDocsContainer');
            var row = `
                <div class="input-group mb-2 enclosed-doc-row" style="display:none;">
                    <span class="input-group-text bg-white"><i class="bi bi-file-earmark-text text-primary"></i></span>
                    <input type="text" name="EnclosedDocuments[X].DocName" class="form-control" placeholder="e.g. Appointment Letter, Service Record...">
                    <span class="input-group-text bg-white text-muted small">Pages</span>
                    <input type="number" name="EnclosedDocuments[X].PageCount" class="form-control" style="max-width:80px;" min="1" placeholder="0">
                    <button type="button" class="btn btn-outline-danger btn-sm remove-doc-row"><i class="bi bi-trash"></i></button>
                </div>`;
            var $row = $(row);
            container.append($row);
            $row.slideDown(200);
            reindexDocs();
        });

        $(document).on('click', '.remove-doc-row', function() {
            var $row = $(this).closest('.enclosed-doc-row');
            if ($('#enclosedDocsContainer .enclosed-doc-row').length > 1) {
                $row.slideUp(200, function() {
                    $(this).remove();
                    reindexDocs();
                });
            } else {
                $row.find('input').val('');
            }
        });

        function reindexDocs() {
            $('#enclosedDocsContainer .enclosed-doc-row').each(function(i) {
                $(this).find('input[name*="DocName"]').attr('name', 'EnclosedDocuments[' + i + '].DocName');
                $(this).find('input[name*="PageCount"]').attr('name', 'EnclosedDocuments[' + i + '].PageCount');
            });
        }

        function toggleOutwardFields(selectElement) {
            // Outward fields remain visible and permanently accessible in responsive grid
        }

        // Initialize on load & setup guaranteed tab navigation
        $(document).ready(function() {
             // Robust tab switching handler supporting Bootstrap 5 & jQuery
             $('#gratuityTabs button[data-bs-toggle="tab"]').on('click', function(e) {
                 e.preventDefault();
                 var targetSelector = $(this).attr('data-bs-target');
                 if (targetSelector) {
                     if (typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                         var tabTrigger = new bootstrap.Tab(this);
                         tabTrigger.show();
                     }
                     $('#gratuityTabs button').removeClass('active').attr('aria-selected', 'false');
                     $(this).addClass('active').attr('aria-selected', 'true');
                     $('#gratuityTabsContent > .tab-pane').removeClass('show active').css('display', '');
                     $(targetSelector).addClass('show active').fadeIn(150);
                 }
             });
        });
    </script>
}

<style>
     /* Premium Design Tokens */
     :root {
         --gratuity-primary: #C2185B;
         --gratuity-gradient: linear-gradient(135deg, #C2185B 0%, #E91E63 100%);
         --gratuity-bg-soft: #fdf2f8;
         --glass-shadow: 0 10px 30px rgba(194, 24, 91, 0.12);
     }

     .fade-in { animation: fadeIn 0.5s ease-out; }
     @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

     /* Modern Card Styling */
     .main-form-card {
         border-radius: 20px !important;
         border: 1px solid rgba(194, 24, 91, 0.1);
         overflow: hidden;
         box-shadow: var(--glass-shadow) !important;
     }
     
     .card-body {
         background: #ffffff;
         padding: 2.5rem !important;
     }
     
     /* Navigation Tabs Enhancements */
     .modern-tabs {
         background-color: #f8fafc;
         border: none;
     }
     
     .modern-tabs .nav-link {
         border: none;
         padding: 1.25rem;
         font-weight: 700;
         color: #64748b;
         text-transform: uppercase;
         font-size: 0.85rem;
         letter-spacing: 0.5px;
         transition: all 0.3s;
         display: flex;
         align-items: center;
         justify-content: center;
         border-bottom: 3px solid transparent;
     }
     
     .modern-tabs .nav-link:hover {
         color: var(--gratuity-primary);
         background-color: var(--gratuity-bg-soft);
     }
     
     .modern-tabs .nav-link.active {
         background-color: #fff;
         color: var(--gratuity-primary) !important;
         border-bottom-color: var(--gratuity-primary) !important;
     }

     /* Section Headings */
     .section-heading {
         font-size: 1rem;
         font-weight: 800;
         color: var(--gratuity-primary);
         border-left: 5px solid var(--gratuity-primary);
         padding: 0.75rem 1.25rem;
         background: linear-gradient(90deg, var(--gratuity-bg-soft) 0%, rgba(255,255,255,0) 100%);
         margin: 2rem 0 1.5rem 0;
         border-radius: 0 8px 8px 0;
         display: flex;
         align-items: center;
     }

     .section-heading::after {
         content: '';
         flex-grow: 1;
         height: 1px;
         background: linear-gradient(90deg, rgba(194, 24, 91, 0.2) 0%, transparent 100%);
         margin-left: 1rem;
     }

     /* Form Controls Styling */
     .form-label {
         font-weight: 700;
         color: #334155;
         font-size: 0.8rem;
         text-transform: uppercase;
         letter-spacing: 0.5px;
         margin-bottom: 0.5rem;
     }

     .form-control, .form-select {
         border: 2px solid #e2e8f0;
         border-radius: 12px;
         padding: 0.75rem 1rem;
         font-weight: 500;
         font-size: 0.95rem;
         transition: all 0.3s;
         background-color: #fff;
     }

     .form-control:focus, .form-select:focus {
         border-color: var(--gratuity-primary);
         box-shadow: 0 0 0 4px rgba(194, 24, 91, 0.1);
         transform: translateY(-2px);
     }

     .form-control[readonly] {
         background-color: #f8fafc;
         border-style: dashed;
     }

     /* Stats & Highlighting */
     .bg-soft-gratuity { background-color: var(--gratuity-bg-soft); }
     .border-gratuity { border-color: var(--gratuity-primary) !important; }
     
     /* Compact Tables */
     .table { font-size: 0.85rem; }
     .table th { font-weight: 700; color: #64748b; background-color: #f8fafc; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #f1f5f9; }
     
     /* Assessment Box */
     .assessment-box {
         padding: 1.75rem;
         border-radius: 18px;
         transition: all 0.3s;
         border: 2px solid transparent;
     }
     
     .assessment-box.corp { background-color: #fff9fc; border-color: #fce7f3; }
     .assessment-box.ca { background-color: #f0f7ff; border-color: #e0f2fe; }
     
     .assessment-box:hover {
         transform: scale(1.01);
         box-shadow: 0 10px 20px rgba(0,0,0,0.05);
     }

     /* Action Buttons */
     .btn-gratuity {
         background: var(--gratuity-gradient);
         color: white;
         border: none;
         font-weight: 700;
         padding: 1rem 2.5rem;
         transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
         box-shadow: 0 5px 15px rgba(194, 24, 91, 0.3);
     }

     .btn-gratuity:hover {
         transform: scale(1.05) translateY(-2px);
         box-shadow: 0 8px 25px rgba(194, 24, 91, 0.4);
         color: white;
     }

     .btn-outline-gratuity {
         color: var(--gratuity-primary);
         border: 2px solid var(--gratuity-primary);
         background: transparent;
         font-weight: 600;
     }

     .btn-outline-gratuity:hover {
         background: var(--gratuity-primary);
         color: white;
     }

     /* Radio/Checkbox Improvements */
     .form-check-input:checked { background-color: var(--gratuity-primary); border-color: var(--gratuity-primary); }

     /* Remove green highlight for valid fields */
     .was-validated .form-control:valid, 
     .was-validated .form-select:valid {
         border-color: #e2e8f0 !important;
         background-image: none !important;
