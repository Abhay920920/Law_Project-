@model MVCCaseManagement.Models.Audit.ActivityLogPagedResult
@{
    ViewData["Title"] = "Case Operations & Activity Log Sheet";
    var divisions = ViewBag.Divisions as IEnumerable<MVCCaseManagement.Models.Division> ?? Enumerable.Empty<MVCCaseManagement.Models.Division>();
    bool isDivisionRestricted = ViewBag.IsDivisionRestricted == true;
    var f = Model.Filter;
}

<style>
    /* Executive Audit Dashboard Styling */
    .audit-hero {
        background: radial-gradient(135% 120% at 95% 10%, rgba(59, 130, 246, 0.18) 0%, transparent 50%),
                    radial-gradient(100% 100% at 5% 90%, rgba(99, 102, 241, 0.22) 0%, transparent 60%),
                    linear-gradient(135deg, #090d16 0%, #0f172a 50%, #1e1b4b 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4);
    }
    
    .live-pulse {
        display: inline-block;
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 0 rgba(16, 185, 129, 0.6);
        animation: pulseAnimation 1.8s infinite;
    }
    @@keyframes pulseAnimation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .kpi-card-lux {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .kpi-card-lux:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px -8px rgba(15, 23, 42, 0.12);
        border-color: #cbd5e1;
    }
    .kpi-card-lux::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }
    .kpi-card-primary::before { background: linear-gradient(90deg, #3b82f6, #6366f1); }
    .kpi-card-success::before { background: linear-gradient(90deg, #10b981, #059669); }
    .kpi-card-info::before    { background: linear-gradient(90deg, #06b6d4, #0284c7); }
    .kpi-card-warning::before { background: linear-gradient(90deg, #f59e0b, #ef4444); }

    .module-pill-tab {
        border-radius: 2rem;
        padding: 0.35rem 0.9rem;
        font-size: 0.76rem;
        font-weight: 600;
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .module-pill-tab:hover {
        background: #e2e8f0;
        color: #0f172a;
    }
    .module-pill-tab.active {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: #ffffff;
        border-color: #0f172a;
        box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.35);
    }

    .table-audit thead th {
        background-color: #0f172a !important;
        color: #f8fafc !important;
        font-size: 0.72rem;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        font-weight: 700;
        border-bottom: 2px solid #334155 !important;
        padding: 0.65rem 0.75rem;
    }
    .table-audit tbody tr {
        transition: background-color 0.15s ease;
    }
    .table-audit tbody tr:hover {
        background-color: rgba(59, 130, 246, 0.04) !important;
    }
    .table-audit td {
        padding: 0.65rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .vehicle-tag {
        font-family: 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
        border-radius: 4px;
        padding: 0.15rem 0.4rem;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .ip-tag {
        font-family: 'SF Mono', Consolas, monospace;
        font-size: 0.64rem;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 0.1rem 0.35rem;
    }
</style>

<div class="container-fluid px-3 py-3">

    <!-- Hero Header Banner with Live Telemetry -->
    <div class="audit-hero p-3 p-md-4 mb-3 text-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge" style="background: rgba(234, 179, 8, 0.15); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.35); font-weight: 700; letter-spacing: 0.5px; font-size: 0.68rem;">
                        <i class="bi bi-shield-shaded me-1"></i>NWKRTC CENTRAL DIRECTORATE
                    </span>
                    <span class="d-inline-flex align-items-center gap-1.5 px-2.5 py-0.5 rounded-pill" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.68rem; color: #6ee7b7;">
                        <span class="live-pulse"></span>
                        <span class="fw-semibold">LIVE AUDIT TELEMETRY ACTIVE</span>
                    </span>
                    <span class="badge bg-white bg-opacity-10 text-white-50 border border-white border-opacity-15 px-2.5 py-1 rounded-pill d-none d-sm-inline-flex align-items-center gap-1" style="font-size: 0.68rem;">
                        <kbd class="bg-dark text-warning border border-secondary px-1.5 py-0 rounded" style="font-size: 0.66rem;">Ctrl + Shift + Q</kbd>
                        <span>Global Shortcut</span>
                    </span>
                </div>
                <h3 class="fw-bold mb-1 tracking-tight" style="letter-spacing: -0.4px;">Case Operations & Activity Log Sheet</h3>
                <p class="text-light text-opacity-75 small mb-0" style="max-width: 820px; font-size: 0.78rem;">
                    Full chronological audit stream tracking case entries, edits, field transitions, transfer dispatches, compensation disbursements, and legal notings across all NWKRTC operating divisions.
                </p>
            </div>

            <!-- Header Quick Actions -->
            <div class="d-flex align-items-center gap-2 d-print-none">
                <a href="@Url.Action("ExportCsv", "ActivityLog", f)" class="btn btn-sm text-white rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5" style="background: linear-gradient(135deg, #059669, #10b981); border: 1px solid #34d399;">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                    <span>Export CSV</span>
                </a>
                <button onclick="window.print()" class="btn btn-sm btn-outline-light rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5" style="border-color: rgba(255,255,255,0.25); background: rgba(255,255,255,0.06);">
                    <i class="bi bi-printer"></i>
                    <span>Print Sheet</span>
                </button>
                <a href="@Url.Action("Index", "ActivityLog")" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5 fw-semibold text-dark">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Refresh</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Executive KPI Metric Cards -->
    <div class="row g-2 mb-3">
        <!-- KPI 1 -->
        <div class="col-6 col-md-3">
            <div class="kpi-card-lux kpi-card-primary p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Today's Operations</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.KpiSummary.TotalToday</div>
                        <div class="small text-muted" style="font-size: 0.72rem;">All legal recorded actions</div>
                    </div>
                    <div class="p-2.5 rounded-3 d-flex align-items-center justify-content-center" style="background: rgba(59, 130, 246, 0.12); color: #2563eb;">
                        <i class="bi bi-lightning-charge-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- KPI 2 -->
        <div class="col-6 col-md-3">
            <div class="kpi-card-lux kpi-card-success p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Cases Entered Today</div>
                        <div class="fs-3 fw-bold text-success mt-1">@Model.KpiSummary.CreatedToday</div>
                        <div class="small text-muted" style="font-size: 0.72rem;">New filings & registrations</div>
                    </div>
                    <div class="p-2.5 rounded-3 d-flex align-items-center justify-content-center" style="background: rgba(16, 185, 129, 0.12); color: #059669;">
                        <i class="bi bi-folder-plus fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- KPI 3 -->
        <div class="col-6 col-md-3">
            <div class="kpi-card-lux kpi-card-info p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Cases Edited Today</div>
                        <div class="fs-3 fw-bold text-info mt-1">@Model.KpiSummary.UpdatedToday</div>
                        <div class="small text-muted" style="font-size: 0.72rem;">Stages, hearings & updates</div>
                    </div>
                    <div class="p-2.5 rounded-3 d-flex align-items-center justify-content-center" style="background: rgba(6, 182, 212, 0.12); color: #0891b2;">
                        <i class="bi bi-pencil-square fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- KPI 4 -->
        <div class="col-6 col-md-3">
            <div class="kpi-card-lux kpi-card-warning p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Transfers & Removals</div>
                        <div class="fs-3 fw-bold text-warning-emphasis mt-1">@Model.KpiSummary.DeletedTransferredToday</div>
                        <div class="small text-muted" style="font-size: 0.72rem;">Division shifts & deletions</div>
                    </div>
                    <div class="p-2.5 rounded-3 d-flex align-items-center justify-content-center" style="background: rgba(245, 158, 11, 0.12); color: #d97706;">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Module Quick Switcher Pill Tabs -->
    <div class="d-flex flex-wrap align-items-center gap-1.5 mb-2.5 d-print-none">
        <span class="text-muted fw-bold me-1 text-uppercase" style="font-size: 0.66rem; letter-spacing: 0.5px;">Quick Filter:</span>
        <a href="@Url.Action("Index", "ActivityLog", new { Module = "all", ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, SearchTerm = f.SearchTerm })" 
           class="module-pill-tab @(string.IsNullOrEmpty(f.Module) || f.Module.ToLower() == "all" ? "active" : "")">
            <i class="bi bi-collection"></i>All Modules
        </a>
        <a href="@Url.Action("Index", "ActivityLog", new { Module = "MVC", ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, SearchTerm = f.SearchTerm })" 
           class="module-pill-tab @(f.Module?.ToUpper() == "MVC" ? "active" : "")">
            <i class="bi bi-car-front"></i>MVC Claims
        </a>
        <a href="@Url.Action("Index", "ActivityLog", new { Module = "LABOUR", ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, SearchTerm = f.SearchTerm })" 
           class="module-pill-tab @(f.Module?.ToUpper() == "LABOUR" ? "active" : "")">
            <i class="bi bi-briefcase"></i>Labour / KID
        </a>
        <a href="@Url.Action("Index", "ActivityLog", new { Module = "ARISING", ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, SearchTerm = f.SearchTerm })" 
           class="module-pill-tab @(f.Module?.ToUpper() == "ARISING" ? "active" : "")">
            <i class="bi bi-diagram-3"></i>Arising Apps
        </a>
        <a href="@Url.Action("Index", "ActivityLog", new { Module = "APPEAL", ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, SearchTerm = f.SearchTerm })" 
           class="module-pill-tab @(f.Module?.ToUpper() == "APPEAL" ? "active" : "")">
            <i class="bi bi-building"></i>High Court Appeals
        </a>
        <a href="@Url.Action("Index", "ActivityLog", new { Module = "EP", ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, SearchTerm = f.SearchTerm })" 
           class="module-pill-tab @(f.Module?.ToUpper() == "EP" ? "active" : "")">
            <i class="bi bi-shield-check"></i>EP Petitions
        </a>
    </div>

    <!-- Filter Control Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white d-print-none" style="border: 1px solid #e2e8f0 !important;">
        <div class="card-body p-2.5">
            <form method="get" action="@Url.Action("Index", "ActivityLog")" id="filterForm">
                <input type="hidden" name="Module" id="formModule" value="@f.Module" />
                <div class="row g-2 align-items-center">
                    
                    <!-- Search Input -->
                    <div class="col-12 col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" value="@f.SearchTerm" class="form-control border-start-0 shadow-none" placeholder="Search Case, Vehicle, Officer..." />
                        </div>
                    </div>

                    <!-- Action Type Filter -->
                    <div class="col-6 col-md-2">
                        <select name="ActionType" class="form-select form-select-sm shadow-none" onchange="this.form.submit()">
                            <option value="all" selected="@(f.ActionType == "all" ? "selected" : null)">⚡ All Operations</option>
                            <option value="CREATED" selected="@(f.ActionType?.ToUpper() == "CREATED" ? "selected" : null)">🟢 Entered (Created)</option>
                            <option value="UPDATED" selected="@(f.ActionType?.ToUpper() == "UPDATED" ? "selected" : null)">🔵 Edited (Updated)</option>
                            <option value="TRANSFERRED" selected="@(f.ActionType?.ToUpper() == "TRANSFERRED" ? "selected" : null)">🟣 Transferred</option>
                            <option value="DELETED" selected="@(f.ActionType?.ToUpper() == "DELETED" ? "selected" : null)">🔴 Deleted</option>
                            <option value="PAYMENT_ADDED" selected="@(f.ActionType?.ToUpper() == "PAYMENT_ADDED" ? "selected" : null)">💵 Payment Added</option>
                            <option value="PAYMENT_DELETED" selected="@(f.ActionType?.ToUpper() == "PAYMENT_DELETED" ? "selected" : null)">💸 Payment Removed</option>
                            <option value="NOTING_ADDED" selected="@(f.ActionType?.ToUpper() == "NOTING_ADDED" ? "selected" : null)">📝 Noting Added</option>
                            <option value="NOTING_DELETED" selected="@(f.ActionType?.ToUpper() == "NOTING_DELETED" ? "selected" : null)">🗑️ Noting Deleted</option>
                        </select>
                    </div>

                    <!-- Division Filter -->
                    <div class="col-6 col-md-3">
                        @if (isDivisionRestricted)
                        {
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input type="text" class="form-control bg-light" value="@(divisions.FirstOrDefault(d => d.DivisionID == f.DivisionID)?.DivisionNameEnglish ?? "Assigned Division")" readonly />
                                <input type="hidden" name="DivisionID" value="@f.DivisionID" />
                            </div>
                        }
                        else
                        {
                            <select name="DivisionID" class="form-select form-select-sm shadow-none" onchange="this.form.submit()">
                                <option value="">🏢 All Operating Divisions</option>
                                @foreach (var d in divisions)
                                {
                                    <option value="@d.DivisionID" selected="@(f.DivisionID == d.DivisionID ? "selected" : null)">@d.DivisionNameEnglish (@d.DivisionCode)</option>
                                }
                            </select>
                        }
                    </div>

                    <!-- Date Preset Filter -->
                    <div class="col-6 col-md-2">
                        <select name="DatePreset" class="form-select form-select-sm shadow-none" onchange="handleDatePreset(this.value)">
                            <option value="all" selected="@(f.DatePreset == "all" ? "selected" : null)">📅 All Time</option>
                            <option value="today" selected="@(f.DatePreset == "today" ? "selected" : null)">Today</option>
                            <option value="yesterday" selected="@(f.DatePreset == "yesterday" ? "selected" : null)">Yesterday</option>
                            <option value="week" selected="@(f.DatePreset == "week" ? "selected" : null)">Last 7 Days</option>
                            <option value="month" selected="@(f.DatePreset == "month" ? "selected" : null)">This Month</option>
                            <option value="custom" selected="@(f.DatePreset == "custom" ? "selected" : null)">Custom Date Range</option>
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-6 col-md-2 d-flex gap-1.5">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1 shadow-sm d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-funnel"></i>
                            <span>Filter</span>
                        </button>
                        <a href="@Url.Action("Index", "ActivityLog")" class="btn btn-outline-secondary btn-sm shadow-sm" title="Reset All Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    </div>
                </div>

                <!-- Custom Date Range Row -->
                <div id="customDateRow" class="row g-2 mt-1.5 pt-2 border-top @(f.DatePreset == "custom" ? "" : "d-none")">
                    <div class="col-md-3 offset-md-5 d-flex align-items-center gap-2">
                        <span class="small text-muted text-nowrap fw-semibold">Start:</span>
                        <input type="date" name="DateFrom" value="@(f.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3 d-flex align-items-center gap-2">
                        <span class="small text-muted text-nowrap fw-semibold">End:</span>
                        <input type="date" name="DateTo" value="@(f.DateTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-outline-primary btn-sm w-100">Set</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Main Activity Log Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white" style="border: 1px solid #e2e8f0 !important;">
        <div class="card-header bg-white py-2.5 px-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-dark" style="font-size: 0.85rem;">
                    <i class="bi bi-list-check text-primary me-1"></i>Audit Trail Log
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.7rem;">
                    @Model.TotalCount Event Records
                </span>
            </div>
            <div class="text-muted small" style="font-size: 0.72rem;">
                Showing Page <span class="fw-bold text-dark">@Model.Page</span> of <span class="fw-bold text-dark">@(Model.TotalPages > 0 ? Model.TotalPages : 1)</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-audit align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 155px;">Timestamp & Age</th>
                        <th style="width: 210px;">Officer / Actor</th>
                        <th style="width: 125px;">Operation</th>
                        <th style="width: 200px;">Case Reference</th>
                        <th>Activity Summary & Field Changes</th>
                        <th style="width: 95px;" class="text-end">Inspect</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs == null || !Model.Logs.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-check display-5 d-block mb-2 text-secondary opacity-50"></i>
                                <div class="fw-bold fs-6 text-dark">No activity records match the current filter criteria</div>
                                <p class="small text-muted mb-3" style="font-size: 0.75rem;">Try switching module tabs or clearing the date range filter.</p>
                                <a href="@Url.Action("Index", "ActivityLog")" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-arrow-repeat me-1"></i>View All Historical Activity
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model.Logs)
                        {
                            var timeAgo = GetRelativeTime(log.Timestamp);
                            <tr>
                                <!-- Timestamp -->
                                <td>
                                    <div class="d-flex align-items-center gap-1.5">
                                        <i class="bi bi-clock text-secondary opacity-75" style="font-size: 0.75rem;"></i>
                                        <div class="fw-bold text-dark" style="font-size: 0.76rem;">@log.Timestamp.ToString("dd-MMM-yyyy")</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5 text-muted ps-3.5" style="font-size: 0.7rem;">
                                        <span>@log.Timestamp.ToString("hh:mm tt")</span>
                                        <span class="badge bg-light text-secondary border rounded px-1" style="font-size: 0.6rem;">@timeAgo</span>
                                    </div>
                                </td>

                                <!-- Officer / Actor -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-sm bg-gradient text-white fw-bold flex-shrink-0 d-flex align-items-center justify-content-center shadow-xs" 
                                             style="width: 30px; height: 30px; border-radius: 50%; font-size: 0.72rem; background: linear-gradient(135deg, #1e293b, #475569);">
                                            @(string.IsNullOrEmpty(log.UserFullName) ? log.Username.Substring(0, 1).ToUpper() : log.UserFullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div class="text-truncate">
                                            <div class="fw-bold text-dark text-truncate" style="font-size: 0.78rem;" title="@(log.UserFullName ?? log.Username)">
                                                @(log.UserFullName ?? log.Username)
                                            </div>
                                            <div class="d-flex flex-wrap align-items-center gap-1 mt-0.5" style="font-size: 0.64rem;">
                                                <span class="badge bg-secondary-subtle text-secondary py-0 px-1.5 rounded">@(log.UserRole ?? "User")</span>
                                                <span class="text-muted text-truncate" style="max-width: 100px;" title="@log.DivisionName">@(log.DivisionName ?? "Central Office")</span>
                                                @if (!string.IsNullOrEmpty(log.IpAddress) && log.IpAddress != "127.0.0.1")
                                                {
                                                    <span class="ip-tag">@log.IpAddress</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Action Badge -->
                                <td>
                                    @switch (log.ActionType)
                                    {
                                        case "CREATED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-success border border-success-subtle" style="background: rgba(16, 185, 129, 0.1); font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-plus-circle-fill me-1"></i>Entered
                                            </span>
                                            break;
                                        case "UPDATED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-primary border border-primary-subtle" style="background: rgba(59, 130, 246, 0.1); font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-pencil-fill me-1"></i>Edited
                                            </span>
                                            break;
                                        case "DELETED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-danger border border-danger-subtle" style="background: rgba(239, 68, 68, 0.1); font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-trash-fill me-1"></i>Deleted
                                            </span>
                                            break;
                                        case "TRANSFERRED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-dark border border-warning-subtle" style="background: rgba(245, 158, 11, 0.15); font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-arrow-left-right me-1"></i>Transferred
                                            </span>
                                            break;
                                        case "PAYMENT_ADDED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-teal border border-teal-subtle" style="background: rgba(20, 184, 166, 0.12); color: #0d9488; font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-cash-stack me-1"></i>Payment +
                                            </span>
                                            break;
                                        case "PAYMENT_DELETED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-danger border border-danger-subtle" style="background: rgba(239, 68, 68, 0.1); font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-cash me-1"></i>Payment -
                                            </span>
                                            break;
                                        case "NOTING_ADDED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-indigo border border-indigo-subtle" style="background: rgba(99, 102, 241, 0.12); color: #4f46e5; font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-journal-plus me-1"></i>Noting +
                                            </span>
                                            break;
                                        case "NOTING_DELETED":
                                            <span class="badge rounded-pill px-2.5 py-1 text-danger border border-danger-subtle" style="background: rgba(239, 68, 68, 0.1); font-size: 0.68rem; font-weight: 600;">
                                                <i class="bi bi-journal-x me-1"></i>Noting -
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1" style="font-size: 0.68rem;">
                                                @log.ActionType
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Case Reference -->
                                <td>
                                    <div class="d-flex align-items-center gap-1.5 mb-1">
                                        <span class="badge text-dark rounded px-1.5 py-0.5 border" style="background: #f1f5f9; font-size: 0.62rem; font-weight: 700;">
                                            @log.Module
                                        </span>
                                        @if (log.CaseID.HasValue && log.CaseID > 0)
                                        {
                                            string targetUrl = log.Module == "LABOUR" 
                                                ? Url.Action("Details", "Labour", new { id = log.CaseID }) 
                                                : Url.Action("Details", "Case", new { id = log.CaseID });
                                            <a href="@targetUrl" class="fw-bold text-primary text-decoration-none text-truncate" title="Open Case Record" style="font-size: 0.78rem;">
                                                @log.CaseNumber
                                                <i class="bi bi-box-arrow-up-right small ms-0.5 opacity-75" style="font-size: 0.62rem;"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark text-truncate" style="font-size: 0.78rem;">@log.CaseNumber</span>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-1">
                                        @if (!string.IsNullOrEmpty(log.VehicleNo))
                                        {
                                            <span class="vehicle-tag" title="Vehicle Number">
                                                <i class="bi bi-truck" style="font-size: 0.65rem;"></i>@log.VehicleNo
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(log.CourtName))
                                        {
                                            <span class="text-muted text-truncate" style="font-size: 0.67rem; max-width: 140px;" title="@log.CourtName">
                                                <i class="bi bi-bank me-0.5 opacity-75"></i>@log.CourtName
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Activity Summary & Modifications -->
                                <td>
                                    <div class="text-dark fw-medium" style="font-size: 0.76rem; line-height: 1.35;">
                                        @log.ActionSummary
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.ChangedFieldsSummary))
                                    {
                                        <div class="mt-1 d-flex flex-wrap align-items-center gap-1">
                                            <span class="badge text-secondary border rounded-pill px-2 py-0.5" style="background: #f8fafc; font-size: 0.64rem;">
                                                <i class="bi bi-pencil me-1"></i>@log.ChangedFieldsSummary
                                            </span>
                                        </div>
                                    }
                                </td>

                                <!-- Inspect Diff Button -->
                                <td class="text-end">
                                    @if (!string.IsNullOrEmpty(log.OldValuesJson) || !string.IsNullOrEmpty(log.NewValuesJson))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5 btn-inspect-diff shadow-xs" 
                                                data-id="@log.LogID" 
                                                data-caseno="@log.CaseNumber" 
                                                data-action="@log.ActionType"
                                                title="View Before & After Comparison" 
                                                style="font-size: 0.7rem; font-weight: 600;">
                                            <i class="bi bi-diff me-1"></i>Diff
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.68rem;">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-2.5 px-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 d-print-none">
                <div class="small text-muted" style="font-size: 0.74rem;">
                    Showing records <span class="fw-bold text-dark">@(((Model.Page - 1) * Model.PageSize) + 1)</span> to <span class="fw-bold text-dark">@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))</span> of <span class="fw-bold text-dark">@Model.TotalCount</span> total
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start" href="@Url.Action("Index", "ActivityLog", new { Page = Model.Page - 1, SearchTerm = f.SearchTerm, Module = f.Module, ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, DateFrom = f.DateFrom, DateTo = f.DateTo })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "ActivityLog", new { Page = p, SearchTerm = f.SearchTerm, Module = f.Module, ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, DateFrom = f.DateFrom, DateTo = f.DateTo })">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-end" href="@Url.Action("Index", "ActivityLog", new { Page = Model.Page + 1, SearchTerm = f.SearchTerm, Module = f.Module, ActionType = f.ActionType, DivisionID = f.DivisionID, DatePreset = f.DatePreset, DateFrom = f.DateFrom, DateTo = f.DateTo })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Field-by-Field Change Inspector -->
<div class="modal fade" id="diffModal" tabindex="-1" aria-labelledby="diffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="modal-header py-3 px-3 text-white" style="background: linear-gradient(135deg, #090d16 0%, #0f172a 60%, #1e1b4b 100%);">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="p-2 rounded-3 text-info" style="background: rgba(6, 182, 212, 0.15);">
                        <i class="bi bi-diff fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold mb-0 text-white" id="diffModalLabel">Audit State Comparison</h6>
                        <span class="small text-white-50" id="diffModalSubtitle" style="font-size: 0.72rem;">Field Modifications</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="diffLoadingSpinner" class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="small text-muted mt-2">Computing historical snapshot differences...</div>
                </div>
                <div id="diffContentArea" class="d-none">
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.78rem;">
                            <thead class="table-light text-uppercase text-muted" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                <tr>
                                    <th style="width: 28%;" class="ps-3">Field / Attribute</th>
                                    <th style="width: 36%;" class="bg-danger bg-opacity-10 text-danger">Previous State (Before)</th>
                                    <th style="width: 36%;" class="bg-success bg-opacity-10 text-success pe-3">Updated State (After)</th>
                                </tr>
                            </thead>
                            <tbody id="diffTableBody">
                                <!-- Populated dynamically via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="diffEmptyState" class="text-center py-4 d-none text-muted">
                    <i class="bi bi-info-circle fs-3 text-secondary d-block mb-1"></i>
                    <div>No specific property changes detected between snapshots.</div>
                </div>
            </div>
            <div class="modal-footer py-2 px-3 bg-light border-top">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function handleDatePreset(preset) {
        if (preset === 'custom') {
            $('#customDateRow').removeClass('d-none');
        } else {
            $('#customDateRow').addClass('d-none');
            $('#filterForm').submit();
        }
    }

    $(document).on('click', '.btn-inspect-diff', function () {
        const logId = $(this).data('id');
        const caseNo = $(this).data('caseno');
        const action = $(this).data('action');

        $('#diffModalSubtitle').text(`${action} on ${caseNo} (Log #${logId})`);
        $('#diffLoadingSpinner').removeClass('d-none');
        $('#diffContentArea').addClass('d-none');
        $('#diffEmptyState').addClass('d-none');
        $('#diffTableBody').empty();

        const diffModal = new bootstrap.Modal(document.getElementById('diffModal'));
        diffModal.show();

        $.getJSON('/ActivityLog/GetDiff/' + logId, function (diffs) {
            $('#diffLoadingSpinner').addClass('d-none');

            if (!diffs || diffs.length === 0) {
                $('#diffEmptyState').removeClass('d-none');
                return;
            }

            $('#diffContentArea').removeClass('d-none');
            diffs.forEach(function (d) {
                const oldVal = d.oldValue || '--';
                const newVal = d.newValue || '--';
                const row = `
                    <tr>
                        <td class="fw-semibold text-dark ps-3">${escapeHtml(d.displayName || d.fieldName)}</td>
                        <td class="bg-danger bg-opacity-10 text-dark font-monospace">${escapeHtml(oldVal)}</td>
                        <td class="bg-success bg-opacity-10 text-dark font-monospace fw-semibold pe-3">${escapeHtml(newVal)}</td>
                    </tr>
                `;
                $('#diffTableBody').append(row);
            });
        }).fail(function () {
            $('#diffLoadingSpinner').addClass('d-none');
            $('#diffEmptyState').removeClass('d-none').html('<span class="text-danger">Failed to load diff comparison.</span>');
        });
    });

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
}

@functions {
    public static string GetRelativeTime(DateTime dt)
    {
        var ts = DateTime.Now - dt;
        if (ts.TotalMinutes < 1) return "Just now";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m ago";
        if (ts.TotalHours < 24) return $"{(int)ts.TotalHours}h ago";
        if (ts.TotalDays < 7) return $"{(int)ts.TotalDays}d ago";
        return dt.ToString("dd-MMM");
    }
}
