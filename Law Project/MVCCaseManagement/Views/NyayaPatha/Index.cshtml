        });

        $('#userPromptInput').on('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        function sendMessage(customQuickAction = null, customPrompt = null) {
            if (isRequestActive) return;

            const text = customPrompt || $('#userPromptInput').val().trim();
            if (!text && !customQuickAction) return;

            isRequestActive = true;
            $('#btnSendMessage').prop('disabled', true);
            $('#btnSendText').addClass('d-none');
            $('#btnSendSpinner').removeClass('d-none');

            // Append User Bubble
            appendMessage('user', text || `Action: ${customQuickAction}`);
            $('#userPromptInput').val('');

            // Append AI Thinking Placeholder
            const thinkingId = 'ai-thinking-' + Date.now();
            appendThinkingPlaceholder(thinkingId);

            const includeWebSelected = $('#chkIncludeWeb').is(':checked');

            const payload = {
                message: text || `Execute legal analysis: ${customQuickAction}`,
                conversationId: currentConversationId > 0 ? currentConversationId : null,
                caseType: activeCaseType,
                caseId: activeCaseId > 0 ? activeCaseId : null,
                quickAction: customQuickAction,
                includeWeb: includeWebSelected
            };

            const token = $('input[name="__RequestVerificationToken"]').val() || '';
            const reqHeaders = {};
            if (token) {
                reqHeaders['RequestVerificationToken'] = token;
            }

            $.ajax({
                url: '/NyayaPatha/Chat',
                type: 'POST',
                contentType: 'application/json',
                headers: reqHeaders,
                data: JSON.stringify(payload),
                success: function (res) {
                    $(`#${thinkingId}`).remove();
                    if (res && res.success) {
                        currentConversationId = res.conversationId;
                        appendMessage('assistant', res.reply, res.citations, res.model, res.executionTimeMs, res.sourcesSearched, res.conflicts, res.routeCategory, res.followUpContext);
                        if (res.citations && res.citations.length > 0) {
                            renderSourcesPanel({ citations: res.citations });
                        }
                    } else {
                        const err = (res && res.errorMessage) ? res.errorMessage : 'Unable to process legal research query.';
                        appendMessage('assistant', `⚠️ **Error:** ${err}`);
                    }
                },
                error: function (xhr, status, errorThrown) {
                    $(`#${thinkingId}`).remove();
                    let errMsg = 'Failed to communicate with Nyaya Patha AI service.';
                    if (xhr.status === 401 || xhr.status === 403) {
                        errMsg = 'Access Denied (' + xhr.status + '): Please ensure your NWKRTC session is active and authenticated.';
                    } else if (xhr.responseJSON && xhr.responseJSON.errorMessage) {
                        errMsg = xhr.responseJSON.errorMessage;
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errMsg = xhr.responseJSON.message;
                    } else if (xhr.status === 500) {
                        errMsg = 'Internal Processing Error (500): The legal retrieval engine encountered an issue while querying case repositories.';
                    } else if (xhr.status === 0) {
                        errMsg = 'Network connectivity error or server unavailable. Please verify NWKRTC network connection.';
                    }
                    appendMessage('assistant', `⚠️ **Security / System Error:** ${errMsg}`);
                },
                complete: function () {
                    isRequestActive = false;
                    $('#btnSendMessage').prop('disabled', false);
                    $('#btnSendText').removeClass('d-none');
                    $('#btnSendSpinner').addClass('d-none');
                    $('#userPromptInput').focus();
                }
            });
        }

