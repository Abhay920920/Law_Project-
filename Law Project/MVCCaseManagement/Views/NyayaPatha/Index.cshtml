        // Highlight Legal Taxonomies and parse GitHub-Flavored Markdown into rich tables & structure
        function formatLegalText(raw) {
            if (!raw) return '';

            // 1. Highlight legal taxonomy tags with official badges
            let text = raw
                .replace(/\[VERIFIED INTERNAL RECORD\]/gi, '<span class="badge bg-success-subtle text-success border border-success-subtle me-1">[VERIFIED INTERNAL RECORD]</span>')
                .replace(/\[VERIFIED E-COURTS RECORD\]/gi, '<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle me-1">[VERIFIED E-COURTS RECORD]</span>')
                .replace(/\[EXTERNAL LEGAL SOURCE\]/gi, '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1">[EXTERNAL LEGAL SOURCE]</span>')
                .replace(/\[AI ANALYSIS \/ INFERENCE\]/gi, '<span class="badge bg-purple-subtle text-purple border border-purple-subtle me-1" style="background:#f3e8ff; color:#7e22ce;">[AI INFERENCE]</span>')
                .replace(/\[UNVERIFIED OR INSUFFICIENT INFORMATION\]/gi, '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle me-1">[UNVERIFIED / INSUFFICIENT]</span>')
                .replace(/\[INTERNAL LEGAL OPINION\]/gi, '<span class="badge bg-warning-subtle text-warning border border-warning-subtle me-1">[INTERNAL OPINION]</span>')
                .replace(/\[VERIFIED FACT\]/gi, '<span class="badge bg-success-subtle text-success border border-success-subtle me-1">[VERIFIED FACT]</span>')
                .replace(/\[COURT FINDING\]/gi, '<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">[COURT FINDING]</span>')
                .replace(/\[INTERNAL OPINION\]/gi, '<span class="badge bg-warning-subtle text-warning border border-warning-subtle me-1">[INTERNAL OPINION]</span>')
                .replace(/\[LEGAL AUTHORITY\]/gi, '<span class="badge bg-info-subtle text-info border border-info-subtle me-1">[LEGAL AUTHORITY]</span>')
                .replace(/\[POTENTIAL OPPOSING ARGUMENT\]/gi, '<span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1">[OPPOSING ARGUMENT]</span>')
                .replace(/\[UNKNOWN \/ EVIDENCE GAP\]/gi, '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle me-1">[EVIDENCE GAP]</span>')
                .replace(/\[Unknown\]/gi, '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle me-1">[Unknown]</span>');

            // 2. Parse Markdown (using marked library if loaded, or robust native parser)
            let parsedHtml = '';
            if (typeof marked !== 'undefined' && marked.parse) {
                try {
                    marked.setOptions({
                        gfm: true,
                        breaks: true
                    });
                    parsedHtml = marked.parse(text);
                } catch (e) {
                    console.warn('Marked.js failed, using fallback parser', e);
                    parsedHtml = parseMarkdownFallback(text);
                }
            } else {
                parsedHtml = parseMarkdownFallback(text);
            }

            // 3. Inject responsive container and legal table styling into all generated tables
            parsedHtml = parsedHtml.replace(/<table>/gi, '<div class="table-responsive my-2"><table class="table table-bordered table-sm table-hover legal-brief-table mb-0">');
            parsedHtml = parsedHtml.replace(/<\/table>/gi, '</table></div>');

            return parsedHtml;
        }

        // Robust Native Markdown Table & Structure Parser (Guarantees tables work even offline)
        function parseMarkdownFallback(text) {
            if (!text) return '';
            const lines = text.split('\n');
            let html = '';
            let inTable = false;
            let tableHeaders = [];
            let tableRows = [];
            let inList = false;
            let listType = 'ul';

            function flushTable() {
                if (!inTable) return '';
                let tHtml = '<div class="table-responsive my-2"><table class="table table-bordered table-sm table-hover legal-brief-table mb-0">';
                if (tableHeaders.length > 0) {
                    tHtml += '<thead><tr>';
                    tableHeaders.forEach(h => {
                        tHtml += `<th>${inlineFormat(h)}</th>`;
                    });
                    tHtml += '</tr></thead>';
                }
                if (tableRows.length > 0) {
                    tHtml += '<tbody>';
                    tableRows.forEach(r => {
                        tHtml += '<tr>';
                        r.forEach(c => {
                            tHtml += `<td>${inlineFormat(c)}</td>`;
                        });
                        tHtml += '</tr>';
                    });
                    tHtml += '</tbody>';
                }
                tHtml += '</table></div>';
                inTable = false;
                tableHeaders = [];
                tableRows = [];
                return tHtml;
            }

            function flushList() {
                if (!inList) return '';
                let lHtml = `</${listType}>`;
                inList = false;
                return lHtml;
            }

            function inlineFormat(str) {
                if (!str) return '';
                return str
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/`([^`]+)`/g, '<code class="bg-light px-1 rounded text-dark" style="font-size:0.75rem;">$1</code>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="text-primary text-decoration-none fw-bold">$1 <i class="bi bi-box-arrow-up-right" style="font-size:0.6rem;"></i></a>');
            }

            for (let i = 0; i < lines.length; i++) {
                let line = lines[i].trim();

                // Markdown Table Row detection
                if (line.startsWith('|') && line.endsWith('|')) {
                    const cells = line.split('|').slice(1, -1).map(c => c.trim());
                    const isSeparator = cells.every(c => /^[-:\s]+$/.test(c));
                    if (isSeparator) {
                        continue;
                    }
                    if (!inTable) {
                        html += flushList();
                        inTable = true;
                        tableHeaders = cells;
                    } else {
                        tableRows.push(cells);
                    }
                    continue;
                } else if (inTable) {
                    html += flushTable();
                }

                // Horizontal Rule
                if (/^(\-{3,}|\*{3,}|_{3,})$/.test(line)) {
                    html += flushList();
                    html += '<hr class="legal-divider" />';
                    continue;
                }

                // Headings
                if (line.startsWith('### ')) {
                    html += flushList();
                    html += `<h4 class="legal-heading-4">${inlineFormat(line.substring(4))}</h4>`;
                    continue;
                }
                if (line.startsWith('## ')) {
                    html += flushList();
                    html += `<h3 class="legal-heading-3">${inlineFormat(line.substring(3))}</h3>`;
                    continue;
                }
                if (line.startsWith('# ')) {
                    html += flushList();
                    html += `<h2 class="legal-heading-2">${inlineFormat(line.substring(2))}</h2>`;
                    continue;
                }

                // Blockquote / Alert
                if (line.startsWith('> ')) {
                    html += flushList();
                    html += `<div class="legal-callout">${inlineFormat(line.substring(2))}</div>`;
                    continue;
                }

                // Unordered List
                if (/^[-*]\s+/.test(line)) {
                    if (!inList || listType !== 'ul') {
                        html += flushList();
                        html += '<ul class="ps-3 mb-1.5">';
                        inList = true;
                        listType = 'ul';
                    }
                    html += `<li class="mb-0.5">${inlineFormat(line.replace(/^[-*]\s+/, ''))}</li>`;
                    continue;
                }

                // Ordered List
                if (/^\d+\.\s+/.test(line)) {
                    if (!inList || listType !== 'ol') {
                        html += flushList();
                        html += '<ol class="ps-3 mb-1.5">';
                        inList = true;
                        listType = 'ol';
                    }
                    html += `<li class="mb-0.5">${inlineFormat(line.replace(/^\d+\.\s+/, ''))}</li>`;
                    continue;
                }

                // Regular Paragraph
                html += flushList();
                if (line.length > 0) {
                    html += `<p class="mb-1">${inlineFormat(line)}</p>`;
                }
            }

            html += flushTable();
            html += flushList();
            return html;
        }

        // Copy raw briefing text handler
        $(document).on('click', '.btn-copy-msg', function () {
            const $btn = $(this);
            const $card = $btn.closest('.card');
            const rawText = $card.attr('data-raw-text') || $card.find('.message-content').text();
            
            // Decode HTML entities
            const txt = document.createElement('textarea');
            txt.innerHTML = rawText;
            const decoded = txt.value;

            navigator.clipboard.writeText(decoded).then(function () {
                const orig = $btn.html();
                $btn.html('<i class="bi bi-check2 text-success me-1"></i>Copied!');
                setTimeout(() => $btn.html(orig), 2000);
            }).catch(function () {
                alert('Copied to clipboard.');
            });
        });

