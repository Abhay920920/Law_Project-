@model IEnumerable<MVCCaseManagement.Models.EPViewModel>

@{
    ViewData["Title"] = "Audit & Payment Processing";
    ViewData["PageHeaderClass"] = "audit-header";
}

<div class="container-fluid px-4 py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row g-4 mb-4">
        <!-- Summary Cards -->
        <div class="col-md-3">
            <div class="stat-card total shadow-sm">
                <div class="stat-content">
                    <span class="stat-label">Total EPs</span>
                    <h2 class="stat-value">@Model.Count()</h2>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card pending shadow-sm">
                <div class="stat-content">
                    <span class="stat-label">Awaiting Account Dept</span>
                    <h2 class="stat-value">@Model.Count(x => !x.IsSentToAccounts)</h2>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-bank"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card disposed shadow-sm">
                <div class="stat-content">
                    <span class="stat-label">Fully Paid</span>
                    <h2 class="stat-value">@Model.Count(x => x.ComplianceStatus == "Paid")</h2>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card against shadow-sm">
                <div class="stat-content">
                    <span class="stat-label">Pending Compliance</span>
                    <h2 class="stat-value">@Model.Count(x => x.ComplianceStatus == "Pending")</h2>
                </div>
                <div class="stat-icon-bg">
                    <i class="bi bi-clipboard-x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="gov-card shadow-sm">
        <div class="gov-card-header d-flex justify-content-between align-items-center bg-white py-3">
            <div class="header-title fs-5 fw-bold text-primary">
                <i class="bi bi-layers me-2"></i>
                Execution Petitions for Audit
            </div>
            <a href="@Url.Action("Create", "Audit")" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Audit Entry
            </a>
        </div>
        <div class="gov-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">MVC Details</th>
                            <th>Court / MACT</th>
                            <th>Accounts Status</th>
                            <th>Compliance</th>
                            <th>Payment Info</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                                    No records available for audit processing.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">MVC: @item.ArisingFromMVCNo / @item.ArisingFromMVCYear</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@item.ArisingFromMACT</div>
                                    </td>
                                    <td>
                                        @if (item.IsSentToAccounts)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 rounded-pill">
                                                <i class="bi bi-check2-all me-1"></i> Sent to Accounts
                                            </span>
                                            <div class="x-small text-muted mt-1 ms-1">@item.DateSentToAccounts?.ToString("dd-MMM-yyyy")</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 rounded-pill">
                                                <i class="bi bi-hourglass me-1"></i> Yet to Send
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var compClass = item.ComplianceStatus switch
                                            {
                                                "Paid" => "bg-success text-white",
                                                "Partially Paid" => "bg-warning text-dark",
                                                "Pending" => "bg-danger text-white",
                                                _ => "bg-light text-dark border"
                                            };
                                        }
                                        <span class="badge @compClass px-3 rounded-pill">
                                            @(item.ComplianceStatus ?? "Pending")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.AmountPaid.HasValue && item.AmountPaid > 0)
                                        {
                                            <div class="fw-bold text-success">₹ @item.AmountPaid.Value.ToString("N2")</div>
                                            <div class="x-small text-muted">Chq: @item.ChequeNumber</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">No Payment Recorded</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Manage", "Audit", new { id = item.EPID })" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm">
                                            <i class="bi bi-pencil-square me-1"></i> Manage Audit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .audit-header {
        background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
        border-bottom: 1px solid #dcfce7;
    }
    .x-small { font-size: 0.75rem; }
    
    .stat-card {
        padding: 1rem !important;
        min-height: 120px !important;
        max-width: 95%;
        margin: 0 auto;
    }
    .stat-value {
        font-size: 1.75rem !important;
        margin: 0.25rem 0 !important;
    }
    .stat-label {
        font-size: 0.85rem !important;
        font-weight: 700;
        display: block;
        min-height: 2.5rem;
    }
    .stat-icon-bg, .stat-icon {
        font-size: 2.5rem !important;
        opacity: 0.1 !important;
        position: absolute;
        bottom: 5px;
        right: 10px;
    }
</style>
