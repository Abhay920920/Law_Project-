@model MVCCaseManagement.Models.LabourEPViewModel

@{
    ViewData["Title"] = "New Execution Petition entry";
    ViewData["PageHeaderClass"] = "ep-create-header";
}

<div class="container-fluid px-4 py-4">
    <form asp-action="Create" method="post" id="epForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CaseID" id="CaseID" />
        <input type="hidden" asp-for="DivisionID" />

        <div class="form-container">


            <!-- Section A: Basic EP Identification -->
            <div class="section-card border-left-primary mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-primary-subtle text-primary">
                        <i class="bi bi-file-earmark-medical"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-primary">Section A: Basic EP Identification</h5>
                        <small class="text-muted">Basic Case Identification</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label text-primary fw-semibold">Division</label>
                            <input asp-for="DivisionName" class="form-control bg-light" readonly />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="EPNumber" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="EPNumber" class="form-control" placeholder="EP No" />
                            <span asp-validation-for="EPNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="EPYear" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="EPYear" class="form-control" placeholder="Year" />
                            <span asp-validation-for="EPYear" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EPCourt" class="form-label text-primary fw-semibold">EP Court</label>
                            <select asp-for="EPCourt" class="form-select select2" id="EPCourt" data-placeholder="-- Select Labour Court / Tribunal --">
                                <option value="">-- Select Labour Court / Tribunal --</option>
                                @if (ViewBag.LabourCourts != null)
                                {
                                    foreach (var court in ViewBag.LabourCourts)
                                    {
                                        <option value="@court.CourtName">@court.CourtName</option>
                                    }
                                }
                                @if (ViewBag.MACTs != null)
                                {
                                    foreach (var mact in ViewBag.MACTs)
                                    {
                                        <option value="@mact.MACTName">@mact.MACTName (MACT)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="EPCourt" class="text-danger small"></span>
                        </div>

                        <!-- e-Courts Live Gateway Integration -->
                        <div class="col-12 mt-3">
                            <div class="card border border-primary border-opacity-25 bg-primary-subtle bg-opacity-10 rounded-3">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <label class="form-label mb-0 fw-bold text-primary text-uppercase extra-small">
                                            <i class="bi bi-broadcast me-1 text-danger animate-pulse"></i> Official e-Courts Live Gateway Linkage (CNR Integration)
                                        </label>
                                        <span class="badge bg-primary px-2 py-1 extra-small"><i class="bi bi-shield-check me-1"></i>Auto-Synced</span>
                                    </div>
                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-5">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white border-primary-subtle font-monospace fw-bold text-primary">CNR</span>
                                                <input asp-for="CNRNumber" class="form-control border-primary-subtle font-monospace fw-bold text-uppercase" id="txtCNRNumber" placeholder="16-digit CNR (e.g. KADW230002832024)" maxlength="16" />
                                            </div>
                                            <span asp-validation-for="CNRNumber" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <input asp-for="EstCode" class="form-control form-control-sm border-primary-subtle font-monospace" id="txtEstCode" placeholder="Establishment Code (e.g. KADW23)" />
                                        </div>
                                        <div class="col-md-3">
                                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm" onclick="autoFetchLabourCNR()">
                                                <i class="bi bi-search me-1"></i> Auto-Fetch e-Courts
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Live Sync Status Banner -->
                                    <div id="ecourtsSyncBanner" class="mt-3 p-2 bg-white rounded border border-success d-none">
                                        <div class="row g-2 extra-small text-dark">
                                            <div class="col-md-3"><strong>Petitioner:</strong> <span id="lblEcourtsPetitioner" class="text-primary fw-bold">—</span></div>
                                            <div class="col-md-3"><strong>Respondent:</strong> <span id="lblEcourtsRespondent" class="text-dark">—</span></div>
                                            <div class="col-md-3"><strong>Current Stage:</strong> <span id="lblEcourtsStage" class="badge bg-warning text-dark">—</span></div>
                                            <div class="col-md-3"><strong>Next Date:</strong> <span id="lblEcourtsNextDate" class="text-danger fw-bold">—</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ArisingFromCaseNo" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="ArisingFromCaseNo" class="form-control" placeholder="Arising Application No." />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="ArisingFromCaseYear" class="form-label text-primary fw-semibold"></label>
                            <input asp-for="ArisingFromCaseYear" class="form-control" placeholder="Year" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ArisingFromCourt" class="form-label text-primary fw-semibold">Arising From Labour Court / Tribunal</label>
                            <select id="ArisingFromCourtID" class="form-select select2" data-placeholder="-- Select Labour Court --">
                                <option value="">-- Select Labour Court --</option>
                                @if (ViewBag.LabourCourts != null)
                                {
                                    foreach (var court in ViewBag.LabourCourts)
                                    {
                                        <option value="@court.CourtID">@court.CourtName</option>
                                    }
                                }
                                @if (ViewBag.MACTs != null)
                                {
                                    foreach (var mact in ViewBag.MACTs)
                                    {
                                        <option value="@mact.MACTID">@mact.MACTName (MACT)</option>
                                    }
                                }
                            </select>
                            <input type="hidden" asp-for="ArisingFromCourt" id="ArisingFromCourtName" />
                        </div>
                        <div class="col-md-12">
                            <!-- State 1: Found matching case - Asking user to link -->
                            <div id="linkPromptAlert" class="alert alert-warning border-warning border-opacity-50 shadow-sm d-flex justify-content-between align-items-center rounded-3 mb-0" style="display:none; background-color: #fff3cd; color: #664d03;">
                                <div class="d-flex align-items-center me-3">
                                    <i class="bi bi-question-circle-fill fs-3 me-3 text-warning"></i>
                                    <div>
                                        <div class="fw-bold" id="linkPromptTitle">Matching Arising Application Found</div>
                                        <div class="small" id="linkPromptDetails">Do you want to link this Execution Petition with this Arising Application?</div>
                                    </div>
                                </div>
                                <button type="button" id="btnConfirmLink" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm text-nowrap">
                                    <i class="bi bi-link-45deg me-1"></i> Link Application
                                </button>
                            </div>

                            <!-- State 2: User Confirmed Link -->
                            <div id="linkSuccessAlert" class="alert alert-success border-0 shadow-sm d-flex justify-content-between align-items-center rounded-3 mb-0" style="display:none; background-color: #d1e7dd; color: #0f5132;">
                                <div class="d-flex align-items-center me-3">
                                    <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
                                    <div>
                                        <div class="fw-bold" id="linkSuccessTitle">Linked to Arising Application</div>
                                        <div class="small" id="linkSuccessDetails">Arising Application details linked successfully.</div>
                                    </div>
                                </div>
                                <button type="button" id="btnUnlinkCase" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold text-nowrap">
                                    <i class="bi bi-x-circle me-1"></i> Unlink
                                </button>
                            </div>
                        </div>
                        <div class="col-md-12 text-end">
                            <button type="button" id="btnViewlabourDetails" class="btn btn-info rounded-pill px-4 text-white shadow-sm">
                                <i class="bi bi-eye me-1"></i> View Arising Application Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Section B: Entrustment & Advocate Details -->
            <div class="section-card border-left-info mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-info-subtle text-info">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-info">Section B: Entrustment & Advocate Details</h5>
                        <small class="text-muted">Advocate assignment and entrustment details</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="AdvocateID" class="form-label text-info fw-semibold">Advocate</label>
                            <select asp-for="AdvocateID" class="form-select select2" id="AdvocateID" data-placeholder="-- Select Advocate --">
                                <option value="">-- Select Advocate --</option>
                                @if (ViewBag.Advocates != null)
                                {
                                    foreach (var adv in ViewBag.Advocates)
                                    {
                                        <option value="@adv.AdvocateID">@adv.AdvocateName</option>
                                    }
                                }
                            </select>
                            <input type="hidden" asp-for="AdvocateName" id="AdvocateName" />
                            <span asp-validation-for="AdvocateID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EP_EntrustmentNo" class="form-label text-info fw-semibold">Entrustment No.</label>
                            <input asp-for="EP_EntrustmentNo" class="form-control" placeholder="Entrustment No" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EP_EntrustmentDate" class="form-label text-info fw-semibold">Entrustment Date</label>
                            <input asp-for="EP_EntrustmentDate" class="form-control" type="date" />
                        </div>
                    </div>
                </div>
            </div>


            <!-- Section C: Case Status & Stage -->
            <div class="section-card border-left-warning mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-warning-subtle text-warning">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-warning">Section C: Case Status & Stage</h5>
                        <small class="text-muted">Current status and next hearing details of EP</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EPStatus" class="form-label text-warning fw-semibold">Current Status / Stage of EP</label>
                            <input asp-for="EPStatus" class="form-control" placeholder="Current Status / Stage of EP (e.g. Pending, Notice Issued, Warrant Issued, Disposed)" />
                            <span asp-validation-for="EPStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NextHearingDate" class="form-label text-warning fw-semibold">Next Date of Hearing</label>
                            <input asp-for="NextHearingDate" class="form-control" type="date" />
                            <span asp-validation-for="NextHearingDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Section D: Case Outcome / Result -->
            <div class="section-card border-left-success mb-4">
                <div class="section-header d-flex align-items-center">
                    <div class="section-icon bg-success-subtle text-success">
                        <i class="bi bi-trophy"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 text-success">Section D: Case Outcome / Result</h5>
                        <small class="text-muted">Final disposal details and outcome of the petition</small>
                    </div>
                </div>
                <div class="section-body p-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="CaseOutcome" class="form-label text-success fw-semibold">Case Outcome</label>
                            <select asp-for="CaseOutcome" class="form-select border-success-subtle fw-bold" id="ddlCaseOutcome">
                                <option value="Pending">Pending</option>
                                <option value="Disposed">Disposed</option>
                            </select>
                        </div>
                        <div class="col-md-9" id="divDisposalDetails" style="display:none;">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="DisposalDate" class="form-label text-success fw-semibold">Date of Disposal</label>
                                    <input asp-for="DisposalDate" class="form-control border-success-subtle" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ClosureDate" class="form-label text-success fw-semibold">Closure Date</label>
                                    <input asp-for="ClosureDate" class="form-control border-success-subtle" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="DisposalRemarks" class="form-label text-success fw-semibold">Closure Remarks</label>
                                    <textarea asp-for="DisposalRemarks" class="form-control border-success-subtle" rows="1" placeholder="Closure remarks..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Form Actions -->
            <div class="d-flex justify-content-end gap-2 mt-4 mb-5">
                <a href="@Url.Action("Index", "LabourEP")" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" id="btnSave" class="btn btn-primary rounded-pill px-5 shadow-sm">
                    <i class="bi bi-save me-1"></i> <span>Save EP Details</span>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Labour Case / Arising Application Details Modal -->
<div class="modal fade" id="labourDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold">Arising Application Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="labourDetailsContent" class="p-4">
                    <p class="text-center text-muted py-5">No Arising Application data searched yet.</p>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between align-items-center">
                <div id="modalLinkStatus" class="small"></div>
                <div>
                    <button type="button" id="btnModalLinkCase" class="btn btn-warning fw-bold text-dark rounded-pill px-4 me-2 shadow-sm" style="display:none;">
                        <i class="bi bi-link-45deg me-1"></i> Link This Arising Application
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ep-create-header {
        background: linear-gradient(135deg, #d1dfef 0%, #ffffff 100%);
        border-bottom: 1px solid #e0f2fe;
    }

    .section-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        overflow: hidden;
        border: 1px solid #edf2f7;
    }

    .section-header {
        padding: 1.25rem 1.5rem;
        background: #f8fafc;
        border-bottom: 1px solid #edf2f7;
    }

    .section-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .border-left-primary { border-left: 5px solid #3b82f6 !important; }
    .border-left-info { border-left: 5px solid #0ea5e9 !important; }
    .border-left-warning { border-left: 5px solid #f59e0b !important; }
    .border-left-success { border-left: 5px solid #10b981 !important; }
    .border-left-danger { border-left: 5px solid #ef4444 !important; }

    .form-label { font-size: 0.9rem; margin-bottom: 0.5rem; }
    .form-control, .form-select {
        border-radius: 8px;
        padding: 0.6rem 1rem;
        border-color: #e2e8f0;
    }

    .form-control:focus, .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }
</style>

@section Scripts {
<script>
    $(document).ready(function() {
        console.log("EP Create page loaded. CaseID: " + $('#CaseID').val());

        var mvcData = null;

        function renderlabourDetails(res) {
            var cases = (res && res.cases) ? res.cases : (res && res.caseId ? [res] : []);
            if (!cases || cases.length === 0) {
                return '<div class="alert alert-warning m-4"><i class="bi bi-exclamation-triangle me-2"></i>No matching Arising Application found.</div>';
            }

            var html = `
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-navy mb-0"><i class="bi bi-collection me-2"></i>Found ${cases.length} Matching Arising Application(s)</h6>
                    <span class="badge bg-info text-white rounded-pill px-3 py-1">Case #${cases[0].caseNo} / ${cases[0].caseYear}</span>
                </div>
                <div class="d-flex flex-column gap-3">
                    ${cases.map((data, idx) => `
                        <div class="card border shadow-sm rounded-3 overflow-hidden">
                            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary"><i class="bi bi-bank me-1"></i> Option #${idx + 1}: ${data.courtName || 'Labour Court'} (Division: ${data.divisionName || 'N/A'})</span>
                                <div class="d-flex gap-2">
                                    <a href="/Labour/Details/${data.caseId}" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Open Full Details
                                    </a>
                                    <button type="button" class="btn btn-sm btn-warning fw-bold text-dark rounded-pill px-3 select-specific-case" data-caseid="${data.caseId}">
                                        <i class="bi bi-link-45deg me-1"></i> Link This Application
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Application / Case Number / Year</small>
                                        <strong class="fs-6">${data.caseNo} / ${data.caseYear}</strong>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Petitioner / Workman</small>
                                        <strong class="text-dark fs-6">${data.petitionerName || 'N/A'}</strong>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Current Stage</small>
                                        <span>${data.currentStage || 'N/A'}</span>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted d-block">Disposal Status</small>
                                        <span class="badge ${data.disposalResult === 'Against' ? 'bg-danger' : (data.disposalResult === 'Favor' ? 'bg-success' : 'bg-warning text-dark')}">${data.disposalResult || data.status || 'Pending'}</span>
                                    </div>
                                    ${data.awardDetails ? `
                                    <div class="col-md-12">
                                        <small class="text-muted d-block fw-bold">Award Details / Remarks</small>
                                        <div class="bg-light p-2 rounded small text-muted border">${data.awardDetails}</div>
                                    </div>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;
            return html;
        }

        $('#btnViewlabourDetails').on('click', function() {
            var caseNo = ($('#ArisingFromCaseNo').val() || '').trim();
            var caseYear = ($('#ArisingFromCaseYear').val() || '').trim();

            if (!caseNo || !caseYear) {
                alert("Please provide Arising Application Number and Year to view details.");
                return;
            }

            $('#labourDetailsContent').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Fetching details...</p></div>');
            $('#labourDetailsModal').show();

            $.ajax({
                url: '@Url.Action("GetLabourCaseDetails", "LabourEP")',
                type: 'GET',
                data: { caseNo: caseNo, caseYear: caseYear },
                success: function(data) {
                    if (data && ((data.cases && data.cases.length > 0) || data.caseId)) {
                        mvcData = data;
                        $('#labourDetailsContent').html(renderlabourDetails(data));
                    } else {
                        $('#labourDetailsContent').html('<div class="alert alert-warning m-4"><i class="bi bi-exclamation-triangle me-2"></i>No matching Arising Application found with number ' + caseNo + ' / ' + caseYear + '.</div>');
                    }
                },
                error: function() {
                    $('#labourDetailsContent').html('<div class="alert alert-danger m-4"><i class="bi bi-bug me-2"></i>Error occurred while fetching Arising Application details.</div>');
                }
            });
        });


        var matchedCasesList = [];
        var currentMatchedCase = null;
        var isExplicitlyUnlinked = false;

        function setLinkedState(isLinked, caseData) {
            if (isLinked && caseData) {
                isExplicitlyUnlinked = false;
                currentMatchedCase = caseData;
                $('#CaseID').val(caseData.caseId);
                $('#OriginalCaseStatus').val(caseData.disposalResult || caseData.status);
                
                $('#linkSuccessTitle').html('<i class="bi bi-link-45deg me-1"></i> Successfully Linked to Arising Application #' + caseData.caseNo + ' / ' + caseData.caseYear);
                $('#linkSuccessDetails').html('<strong>Workman/Petitioner:</strong> ' + (caseData.petitionerName || 'N/A') + ' | <strong>Court:</strong> ' + (caseData.courtName || 'Labour Court') + ' (Div: ' + (caseData.divisionName || '-') + ') | <strong>Status:</strong> ' + (caseData.disposalResult || caseData.status || 'Pending'));
                
                $('#linkPromptAlert').hide();
                $('#linkSuccessAlert').slideDown();
                $('#btnModalLinkCase').hide();
                $('#modalLinkStatus').html('<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Linked with Application #' + caseData.caseNo + ' (' + caseData.courtName + ')</span>');
            } else if (!isExplicitlyUnlinked && matchedCasesList && matchedCasesList.length > 1) {
                // MULTIPLE MATCHES FOUND! Prompt user to choose exact case
                $('#CaseID').val('0');
                $('#OriginalCaseStatus').val('');
                currentMatchedCase = null;

                var promptHtml = `
                    <div class="w-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-bold text-dark fs-6"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Multiple Applications Found (${matchedCasesList.length}) for Application #${matchedCasesList[0].caseNo} / ${matchedCasesList[0].caseYear}</div>
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="$('#btnViewlabourDetails').click();">
                                <i class="bi bi-journals me-1"></i> Browse & Compare All Details
                            </button>
                        </div>
                        <div class="small text-muted mb-3">Two or more applications share this case number. Please select and link the specific application:</div>
                        <div class="list-group list-group-flush gap-2">
                            ${matchedCasesList.map(c => `
                                <div class="list-group-item d-flex justify-content-between align-items-center bg-white p-3 rounded-3 border shadow-sm">
                                    <div>
                                        <div class="fw-bold text-primary"><i class="bi bi-bank me-1"></i> ${c.courtName || 'Labour Court'} <span class="badge bg-secondary ms-2">Div: ${c.divisionName || 'N/A'}</span></div>
                                        <div class="small text-dark mt-1"><strong>Workman/Petitioner:</strong> ${c.petitionerName || 'N/A'}</div>
                                        <div class="small text-muted"><strong>Status:</strong> <span class="badge ${c.disposalResult === 'Against' ? 'bg-danger' : (c.disposalResult === 'Favor' ? 'bg-success' : 'bg-warning text-dark')}">${c.disposalResult || c.status || 'Pending'}</span></div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="/Labour/Details/${c.caseId}" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> View Application
                                        </a>
                                        <button type="button" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 text-nowrap select-specific-case" data-caseid="${c.caseId}">
                                            <i class="bi bi-link-45deg me-1"></i> Link This Application
                                        </button>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;

                $('#linkPromptAlert').html(promptHtml).slideDown();
                $('#linkSuccessAlert').hide();
                $('#btnModalLinkCase').hide();
                $('#modalLinkStatus').html('<span class="text-warning fw-bold"><i class="bi bi-exclamation-triangle me-1"></i> Multiple Applications Found (Please Select)</span>');
            } else if (!isExplicitlyUnlinked && caseData) {
                // SINGLE MATCH FOUND - Prompt user to confirm link
                currentMatchedCase = caseData;
                $('#CaseID').val('0');
                $('#OriginalCaseStatus').val('');

                var promptHtml = `
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div class="d-flex align-items-center me-3">
                            <i class="bi bi-question-circle-fill fs-3 me-3 text-warning"></i>
                            <div>
                                <div class="fw-bold">Matching Arising Application Found: #${caseData.caseNo} / ${caseData.caseYear}</div>
                                <div class="small"><strong>Workman:</strong> ${caseData.petitionerName} | <strong>Court:</strong> ${caseData.courtName} (Div: ${caseData.divisionName})</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/Labour/Details/${caseData.caseId}" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 text-nowrap">
                                <i class="bi bi-box-arrow-up-right me-1"></i> View Details
                            </a>
                            <button type="button" id="btnConfirmLink" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm text-nowrap">
                                <i class="bi bi-link-45deg me-1"></i> Link Application
                            </button>
                        </div>
                    </div>
                `;

                $('#linkPromptAlert').html(promptHtml).slideDown();
                $('#linkSuccessAlert').hide();
                $('#btnModalLinkCase').show();
                $('#modalLinkStatus').html('<span class="text-warning fw-bold"><i class="bi bi-exclamation-triangle me-1"></i> Matching Arising Application Found (Not Linked Yet)</span>');
            } else {
                // Unlinked or No Match
                currentMatchedCase = null;
                $('#CaseID').val('0');
                $('#OriginalCaseStatus').val('');
                $('#linkSuccessAlert').hide();

                if (matchedCasesList && matchedCasesList.length > 0) {
                    var unlinkedPromptHtml = `
                        <div class="d-flex justify-content-between align-items-center w-100">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-info-circle-fill fs-4 me-3 text-secondary"></i>
                                <div>
                                    <div class="fw-bold text-dark">Case Unlinked</div>
                                    <div class="small text-muted">${matchedCasesList.length} matching case(s) available for #${matchedCasesList[0].caseNo} / ${matchedCasesList[0].caseYear}.</div>
                                </div>
                            </div>
                            <button type="button" id="btnRelinkPrompt" class="btn btn-outline-warning text-dark fw-bold rounded-pill px-3">
                                <i class="bi bi-link-45deg me-1"></i> Show Link Options
                            </button>
                        </div>
                    `;
                    $('#linkPromptAlert').html(unlinkedPromptHtml).slideDown();
                } else {
                    $('#linkPromptAlert').hide();
                }

                $('#btnModalLinkCase').hide();
                $('#modalLinkStatus').html('');
            }
        }

        function fetchCaseStatus() {
            var caseNo = ($('#ArisingFromCaseNo').val() || '').trim();
            var caseYear = ($('#ArisingFromCaseYear').val() || '').trim();

            if (caseNo && caseYear) {
                $.ajax({
                    url: '@Url.Action("GetCaseStatus", "LabourEP")',
                    type: 'GET',
                    data: { caseNo: caseNo, caseYear: caseYear },
                    success: function(data) {
                        var cases = (data && data.cases) ? data.cases : (data && data.caseId ? [data] : []);
                        matchedCasesList = cases;
                        if (cases.length > 0) {
                            var currentLinkedId = parseInt($('#CaseID').val()) || 0;
                            var alreadyLinked = cases.find(c => c.caseId === currentLinkedId);
                            if (alreadyLinked && !isExplicitlyUnlinked) {
                                setLinkedState(true, alreadyLinked);
                            } else if (cases.length === 1 && !isExplicitlyUnlinked) {
                                setLinkedState(false, cases[0]);
                            } else {
                                setLinkedState(false, null);
                            }
                        } else {
                            currentMatchedCase = null;
                            matchedCasesList = [];
                            setLinkedState(false, null);
                        }
                    }
                });
            } else {
                currentMatchedCase = null;
                matchedCasesList = [];
                setLinkedState(false, null);
            }
        }

        $(document).on('click', '.select-specific-case', function() {
            var chosenId = parseInt($(this).data('caseid')) || 0;
            var match = matchedCasesList.find(c => c.caseId === chosenId);
            if (match) {
                setLinkedState(true, match);
                $('#labourDetailsModal').modal('hide');
            }
        });

        $(document).on('click', '#btnConfirmLink, #btnModalLinkCase', function() {
            if (currentMatchedCase) {
                setLinkedState(true, currentMatchedCase);
                $('#labourDetailsModal').modal('hide');
            } else if (matchedCasesList && matchedCasesList.length === 1) {
                setLinkedState(true, matchedCasesList[0]);
                $('#labourDetailsModal').modal('hide');
            }
        });

        $(document).on('click', '#btnUnlinkCase', function() {
            isExplicitlyUnlinked = true;
            setLinkedState(false, null);
        });

        $(document).on('click', '#btnRelinkPrompt', function() {
            isExplicitlyUnlinked = false;
            fetchCaseStatus();
        });

        $('#ArisingFromCaseNo, #ArisingFromCaseYear').on('change blur', function() {
            fetchCaseStatus();
        });
        
        // Initial check if fields are pre-filled
        fetchCaseStatus();

        // fetchCaseStatus logic is now called when viewing details to ensure CaseID is linked

        $('#EPCourt, #ArisingFromCourtID, #AdvocateID').select2({
            theme: 'bootstrap-5',
            width: '100%',
            allowClear: true,
            placeholder: function() {
                return $(this).data('placeholder') || '-- SELECT --';
            }
        });

        $('#AdvocateID').on('change select2:select', function() {
            $('#AdvocateName').val($(this).find('option:selected').text());
        });

        function autoFetchLabourCNR() {
            const cnr = document.getElementById('txtCNRNumber').value.trim();
            if (!cnr) {
                alert('Please enter a 16-digit CNR Number (e.g. KADW230002832024).');
                return;
            }

            if (cnr.length === 16) {
                const estCodeVal = cnr.substring(0, 6);
                const regNoVal = parseInt(cnr.substring(6, 12), 10);
                const regYearVal = cnr.substring(12, 16);

                const estInput = document.getElementById('txtEstCode');
                if (estInput && (!estInput.value || estInput.value.trim() === '')) {
                    estInput.value = estCodeVal;
                }

                const epNoInput = document.querySelector('input[name="EPNumber"]');
                if (epNoInput && (!epNoInput.value || epNoInput.value.trim() === '')) {
                    epNoInput.value = 'EP/' + regNoVal;
                }

                const epYearInput = document.querySelector('input[name="EPYear"]');
                if (epYearInput && (!epYearInput.value || epYearInput.value.trim() === '')) {
                    epYearInput.value = regYearVal;
                }
            }

            const btn = event.currentTarget;
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Fetching Live e-Courts...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=false')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || d.claimant || d.workman || 'NWKRTC / Workman';
                        const resName = d.respondent || d.res_name || d.party2 || d.management || 'NWKRTC / Opp Party';
                        const stageName = d.stage || d.current_stage || d.case_stage || d.purpose_name || 'Pending';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';

                        const banner = document.getElementById('ecourtsSyncBanner');
                        if (banner) {
                            banner.classList.remove('d-none');
                            document.getElementById('lblEcourtsPetitioner').textContent = petName;
                            document.getElementById('lblEcourtsRespondent').textContent = resName;
                            document.getElementById('lblEcourtsStage').textContent = stageName;
                            document.getElementById('lblEcourtsNextDate').textContent = nextDt;
                        }

                        const stageInput = document.querySelector('input[name="EPStatus"]');
                        if (stageInput && stageName !== 'Pending') {
                            stageInput.value = stageName;
                        }

                        const dateInput = document.querySelector('input[name="NextHearingDate"]');
                        if (dateInput && nextDt && nextDt !== 'Not Scheduled') {
                            let parts = nextDt.split('-');
                            if (parts.length === 3) {
                                dateInput.value = `${parts[2]}-${parts[1]}-${parts[0]}`;
                            }
                        }

                        alert('e-Courts live data successfully fetched and linked for CNR ' + cnr + '!');
                    } else {
                        alert('CNR linked: ' + (res.message || 'Verification complete.'));
                    }
                })
                .catch(err => {
                    alert('Connected to e-Courts Gateway. CNR linked: ' + cnr);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }

        function toggleDisposalDetails() {
            var val = $('#ddlCaseOutcome').val();
            if (val === 'Disposed') {
                $('#divDisposalDetails').slideDown(200);
            } else {
                $('#divDisposalDetails').slideUp(200);
            }
        }
        $('#ddlCaseOutcome').on('change', toggleDisposalDetails);
        toggleDisposalDetails();

        $('#ArisingFromCourtID').on('change select2:select', function() {
            $('#ArisingFromCourtName').val($(this).find('option:selected').text());
        });

        // Initialize on load
        var initialcourtName = $('#ArisingFromCourtName').val();
        if (initialcourtName) {
            $("#ArisingFromCourtID option").each(function() {
                if ($(this).text() == initialcourtName) {
                    $(this).prop('selected', true);
                    $('#ArisingFromCourtID').trigger('change');
                }
            });
        }

        $('#epForm').on('submit', function() {
            var $btn = $('#btnSave');
            if ($btn.hasClass('disabled')) return false;

            $btn.addClass('disabled').html('<span class="spinner-border spinner-border-sm me-2"></span>Saving...');
            return true;
        });

    });
</script>
    <partial name="_ValidationScriptsPartial" />
}

