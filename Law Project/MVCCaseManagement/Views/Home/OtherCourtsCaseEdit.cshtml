@model MVCCaseManagement.Models.OtherCourtsCase
@{
    Layout = "~/Views/Shared/_OtherCourtsLayout.cshtml";
    string courtName = Model.CaseType switch {
        "PSC" => "P & SC",
        "CC" => "Criminal Case",
        "Consumer" => "Consumer Complaint",
        "LAC" => "Land Acquisition",
        "OS" => "Original Suit",
        "ECA" => "ECA Case",
        _ => Model.CaseType
    };
    ViewData["Title"] = $"Edit {courtName} - {Model.CaseNumber}";
}

<style>
    .gov-card {
        background: white;
        border-radius: 24px;
        border: 1px solid rgba(232, 219, 179, 0.4);
        transition: all 0.3s ease;
        overflow: hidden;
    }
    .gov-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px -5px rgba(191, 70, 70, 0.2) !important;
    }
    .gov-card-header {
        background: linear-gradient(135deg, #3D45AA 0%, #2D3380 100%) !important;
        padding: 1.25rem 1.5rem !important;
    }
    .gov-card-header h6 {
        color: white !important;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
    .bg-light-premium {
        background-color: #FFFDEB !important;
        border: 1px solid rgba(232, 219, 179, 0.5) !important;
    }
</style>

<div class="container-fluid py-4" style="max-width: 1600px;">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 col-xl-2 d-print-none">
            @await Html.PartialAsync("_OtherCourtsSidebar")
        </div>

        <!-- Main Form Area -->
        <div class="col-lg-9 col-xl-10">
            <div id="otherCourtsForm" class="text-start">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-pill px-4 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-pill px-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form id="mainForm" enctype="multipart/form-data" method="post" action="@Url.Action("UpdateOtherCourtsCase", "Home")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CaseID" value="@Model.CaseID" />
            <input type="hidden" name="CaseType" value="@Model.CaseType" />
            <input type="hidden" name="LitigantType" value="@Model.LitigantType" />
            
            <!-- Section 1: Basic Case Information -->
            <div class="gov-card shadow-sm mb-4">
                <div class="gov-card-header">
                    <h6 class="fw-bold mb-0"><i class="bi bi-person-badge-fill me-2"></i>SECTION 1: BASIC CASE INFORMATION</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Division</label>
                            <input type="text" class="form-control bg-light text-muted fw-bold" value="@Model.DivisionName" readonly tabindex="-1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Case Type</label>
                            <select class="form-select" name="CaseStage">
                                <option value="">-- Choose Stage --</option>
                                <option value="pending" selected="@(Model.CaseStage == "pending")">pending</option>
                                <option value="disposed" selected="@(Model.CaseStage == "disposed")">disposed</option>
                                <option value="dnp" selected="@(Model.CaseStage == "dnp")">dnp</option>
                                <option value="ex-parte" selected="@(Model.CaseStage == "ex-parte")">ex-parte</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Case Number</label>
                            <input type="text" class="form-control" name="CaseNumber" value="@Model.CaseNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Case Year</label>
                            <input type="number" class="form-control" name="CaseYear" value="@Model.CaseYear" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Court</label>
                            <input type="text" class="form-control" name="Court" value="@Model.Court" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Case Nature</label>
                            <input type="text" class="form-control" name="CaseNature" value="@Model.CaseNature" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Claim Details</label>
                            <input type="text" class="form-control" name="ClaimDetails" value="@Model.ClaimDetails" />
                        </div>

                        @if (Model.CaseType == "ECA")
                        {
                            <div class="col-md-4">
                                <label class="form-label">Any vehicle involved?</label>
                                <select class="form-select" id="IsVehicleInvolved" name="IsVehicleInvolved">
                                    <option value="no" selected="@(Model.IsVehicleInvolved == "no")">No</option>
                                    <option value="yes" selected="@(Model.IsVehicleInvolved == "yes")">Yes</option>
                                </select>
                            </div>

                            <div class="col-md-4 vehicle-fields" style="@(Model.IsVehicleInvolved == "yes" ? "" : "display:none;")">
                                <label class="form-label">Vehicle Type</label>
                                <select class="form-select" name="VehicleType">
                                    <option value="">-- Choose Type --</option>
                                    <option value="Corporation" selected="@(Model.VehicleType == "Corporation")">Corporation (NWKRTC)</option>
                                    <option value="Private" selected="@(Model.VehicleType == "Private")">Private / Hired / Other</option>
                                </select>
                            </div>

                            <div class="col-md-4 vehicle-fields" style="@(Model.IsVehicleInvolved == "yes" ? "" : "display:none;")">
                                <label class="form-label">Vehicle Number</label>
                                <input type="text" class="form-control" name="VehicleNumber" value="@Model.VehicleNumber" placeholder="KA-XX-F-XXXX" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Date of Incident</label>
                                <input type="date" class="form-control" name="DateOfAccident" value="@(Model.DateOfAccident?.ToString("yyyy-MM-dd"))" />
                            </div>
                            
                            <div class="col-md-4">
                                <label class="form-label">Manner of Incident</label>
                                <input type="text" class="form-control" name="MannerOfIncident" value="@Model.MannerOfIncident" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Is petitioner corp employee?</label>
                                <div class="d-flex gap-3 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="IsCorporationEmployee" id="isCorpEmpYes" value="Yes" @(Model.IsCorporationEmployee == "Yes" ? "checked" : "")>
                                        <label class="form-check-label" for="isCorpEmpYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="IsCorporationEmployee" id="isCorpEmpNo" value="No" @(Model.IsCorporationEmployee != "Yes" ? "checked" : "")>
                                        <label class="form-check-label" for="isCorpEmpNo">No</label>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="col-md-12">
                            <div class="p-3 bg-light rounded border border-primary border-opacity-25 shadow-sm">
                                <label class="form-label fw-bold text-primary mb-3"><i class="bi bi-people-fill me-1"></i> Petitioner / Claimant Details</label>
                                <div id="respondentList">
                                    @if (Model.Respondents != null && Model.Respondents.Any())
                                    {
                                        for (int i = 0; i < Model.Respondents.Count; i++)
                                        {
                                            <div class="row g-2 mb-2 respondent-row align-items-center">
                                                <div class="col-md-5">
                                                    <input type="text" class="form-control" name="Respondents[@i].Name" value="@Model.Respondents[i].Name" placeholder="Name of petitioner..." />
                                                </div>
                                                <div class="col-md-5">
                                                    <input type="text" class="form-control" name="Respondents[@i].Remark" value="@Model.Respondents[i].Remark" placeholder="Remark for this name..." />
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    @if (i == 0) {
                                                        <button type="button" class="btn btn-outline-primary add-respondent w-100"><i class="bi bi-plus-lg me-1"></i>Row</button>
                                                    } else {
                                                        <button type="button" class="btn btn-outline-danger remove-respondent w-100"><i class="bi bi-trash"></i></button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="row g-2 mb-2 respondent-row align-items-center">
                                            <div class="col-md-5">
                                                <input type="text" class="form-control" name="Respondents[0].Name" value="@Model.PetitionerName" placeholder="Name..." />
                                            </div>
                                            <div class="col-md-5">
                                                <input type="text" class="form-control" name="Respondents[0].Remark" placeholder="Remark..." />
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <button type="button" class="btn btn-outline-primary add-respondent w-100"><i class="bi bi-plus-lg me-1"></i>Row</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Entrustment Number</label>
                            <input type="text" class="form-control" name="EntrustmentNumber" value="@Model.EntrustmentNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Entrustment Date</label>
                            <input type="date" class="form-control" name="EntrustmentDate" value="@(Model.EntrustmentDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Advocate Name</label>
                            <select class="form-select" name="AdvocateName">
                                <option value="">Select Advocate...</option>
                                @if (ViewBag.Advocates != null)
                                {
                                    foreach (var advocate in ViewBag.Advocates)
                                    {
                                        <option value="@advocate.AdvocateName" selected="@(Model.AdvocateName == advocate.AdvocateName)">@advocate.AdvocateName</option>
                                    }
                                }
                                <option value="Others" selected="@(Model.AdvocateName == "Others")">Others</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CASE PROGRESS -->
            <div class="gov-card shadow-sm mb-4">
                <div class="gov-card-header">
                    <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow me-2"></i>CASE PROGRESS</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Document Sent?</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="DocumentSent" id="docSentYes" value="Yes" @(Model.DocumentSent == "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="docSentYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="DocumentSent" id="docSentNo" value="No" @(Model.DocumentSent != "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="docSentNo">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-8" id="docSentFields" style="@(Model.DocumentSent == "Yes" ? "" : "display:none;")">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Outward Number</label>
                                    <input type="text" class="form-control" name="InitialOutwardNumber" value="@Model.InitialOutwardNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Outward Date</label>
                                    <input type="date" class="form-control" name="InitialOutwardDate" value="@(Model.InitialOutwardDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Objection verified and sent?</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ObjectionVerified" id="objYes" value="Yes" @(Model.ObjectionVerified == "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="objYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ObjectionVerified" id="objNo" value="No" @(Model.ObjectionVerified != "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="objNo">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-8" id="objVerifiedFields" style="@(Model.ObjectionVerified == "Yes" ? "" : "display:none;")">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Objection Outward Number</label>
                                    <input type="text" class="form-control" name="ObjectionOutwardNumber" value="@Model.ObjectionOutwardNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Objection Filed Date</label>
                                    <input type="date" class="form-control" name="ObjectionFiledDate" value="@(Model.ObjectionFiledDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Evidence Filed?</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="EvidenceFiled" id="evYes" value="Yes" @(Model.EvidenceFiled == "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="evYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="EvidenceFiled" id="evNo" value="No" @(Model.EvidenceFiled != "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="evNo">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Current Stage</label>
                            <input type="text" class="form-control" name="CaseStatus" value="@Model.CaseStatus" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Next Date of Hearing</label>
                            <input type="date" class="form-control" name="NextDateOfHearing" value="@(Model.NextDateOfHearing?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Disposal & Closure -->
            <div class="gov-card shadow-sm mb-4">
                <div class="gov-card-header">
                    <h6 class="fw-bold mb-0"><i class="bi bi-check-circle-fill me-2"></i>SECTION 3: DISPOSAL & CLOSURE</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Disposal Status</label>
                            <select class="form-select fw-bold border-primary" name="DisposalStatus" id="disposalStatusSelect">
                                <option value="">Select Status...</option>
                                <option value="DISPOSED" selected="@(Model.DisposalStatus == "DISPOSED")">DISPOSED</option>
                                <option value="DNP" selected="@(Model.DisposalStatus == "DNP")">DNP</option>
                            </select>
                        </div>
                        <div class="col-md-4" id="resultSection" style="@(Model.DisposalStatus == "DISPOSED" || Model.DisposalStatus == "DNP" ? "" : "display:none;")">
                            <label class="form-label">Result</label>
                            <select class="form-select fw-bold border-info" name="Result" id="resultSelect">
                                <option value="">Select Result...</option>
                                <option value="FAVOR" selected="@(Model.Result == "FAVOR")">FAVOR</option>
                                <option value="AGAINST" selected="@(Model.Result == "AGAINST")">AGAINST</option>
                            </select>
                        </div>

                        <div class="col-md-12" id="favorSection" style="@(Model.Result == "FAVOR" ? "" : "display:none;")">
                            <div class="row g-3 p-3 bg-light-premium rounded-4 border">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold text-success">Disposal Remarks</label>
                                    <textarea class="form-control" name="ClosureRemark" rows="2">@Model.ClosureRemark</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-success">Closure Date</label>
                                    <input type="date" class="form-control" name="ClosureDate" value="@(Model.ClosureDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-success">Upload Judgment Copy</label>
                                    <input type="file" class="form-control" name="FinalJudgmentFile" accept=".pdf" />
                                    @if (!string.IsNullOrEmpty(Model.FinalJudgmentFilePath)) {
                                        <div class="mt-2"><a href="@Model.FinalJudgmentFilePath" target="_blank" class="small"><i class="bi bi-file-pdf text-danger"></i> Existing File</a></div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- EVIDENCE DETAILS -->
            <div class="gov-card shadow-sm mb-4" id="evidenceSection" style="@(Model.Result == "AGAINST" ? "" : "display:none;")">
                <div class="gov-card-header bg-primary">
                    <h6 class="fw-bold mb-0 text-white"><i class="bi bi-journal-text me-2"></i>SECTION 4: EVIDENCE DETAILS</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold text-primary">Objection Filed?</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="IsObjectionFiled" id="objFiledYes" value="Yes" @(Model.IsObjectionFiled == "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="objFiledYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="IsObjectionFiled" id="objFiledNo" value="No" @(Model.IsObjectionFiled != "Yes" ? "checked" : "")>
                                    <label class="form-check-label" for="objFiledNo">No</label>
                                </div>
                            </div>
                            <div class="mt-3 p-3 bg-light rounded border" id="objNoFields" style="@(Model.IsObjectionFiled == "No" ? "" : "display:none;")">
                                <label class="form-label small fw-bold">Objection Remarks</label>
                                <textarea class="form-control" name="ObjectionRemarks" rows="1">@Model.ObjectionRemarks</textarea>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold"><i class="bi bi-people me-1"></i> Petitioner Evidence</label>
                            <div id="respEvidenceList">
                                @if (Model.RespondentEvidence != null && Model.RespondentEvidence.Any())
                                {
                                    for (int i = 0; i < Model.RespondentEvidence.Count; i++)
                                    {
                                        <div class="row g-2 mb-2 resp-evidence-row align-items-center">
                                            <div class="col-md-5">
                                                <input type="text" class="form-control" name="RespondentEvidence[@i].Name" value="@Model.RespondentEvidence[i].Name" placeholder="Name..." />
                                            </div>
                                            <div class="col-md-5">
                                                <input type="text" class="form-control" name="RespondentEvidence[@i].Remark" value="@Model.RespondentEvidence[i].Remark" placeholder="Remark..." />
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <button type="button" class="btn btn-outline-danger remove-resp-ev w-100"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    }
                                }
                                <button type="button" class="btn btn-outline-primary btn-sm add-resp-ev mt-1"><i class="bi bi-plus-lg me-1"></i>Add Row</button>
                            </div>
                        </div>

                        <div class="col-md-12 mt-4">
                            <label class="form-label fw-bold"><i class="bi bi-building me-1"></i> Corporation Evidence</label>
                            <div id="corpEvidenceList">
                                @if (Model.CorpEvidence != null && Model.CorpEvidence.Any())
                                {
                                    for (int i = 0; i < Model.CorpEvidence.Count; i++)
                                    {
                                        <div class="row g-2 mb-2 corp-evidence-row align-items-center">
                                            <div class="col-md-5">
                                                <input type="text" class="form-control" name="CorpEvidence[@i].Name" value="@Model.CorpEvidence[i].Name" placeholder="Name..." />
                                            </div>
                                            <div class="col-md-5">
                                                <input type="text" class="form-control" name="CorpEvidence[@i].Designation" value="@Model.CorpEvidence[i].Designation" placeholder="Designation..." />
                                            </div>
                                            <div class="col-md-2 text-end">
                                                <button type="button" class="btn btn-outline-danger remove-corp-ev w-100"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    }
                                }
                                <button type="button" class="btn btn-outline-primary btn-sm add-corp-ev mt-1"><i class="bi bi-plus-lg me-1"></i>Add Row</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CERTIFIED COPY DETAILS -->
            <div class="gov-card shadow-sm mb-4" id="ccDetailsSection" style="@(Model.Result == "AGAINST" ? "" : "display:none;")">
                <div class="gov-card-header bg-success">
                    <h6 class="fw-bold mb-0 text-white"><i class="bi bi-file-earmark-check me-2"></i>SECTION 5: CERTIFIED COPY DETAILS</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Copy Disposed On</label>
                            <input type="date" class="form-control" name="CopyDisposedOn" value="@(Model.CopyDisposedOn?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Copy Applied On</label>
                            <input type="date" class="form-control" name="CopyAppliedOn" value="@(Model.CopyAppliedOn?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Copy Ready On</label>
                            <input type="date" class="form-control" name="CopyReadyOn" value="@(Model.CopyReadyOn?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Copy Delivered On</label>
                            <input type="date" class="form-control" name="CopyDeliveredOn" value="@(Model.CopyDeliveredOn?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Copy Received at Division</label>
                            <input type="date" class="form-control" name="CopyReceivedAtDivision" value="@(Model.CopyReceivedAtDivision?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Certified Copy Remarks</label>
                            <textarea class="form-control" name="CertifiedCopyRemarks" rows="2">@Model.CertifiedCopyRemarks</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- OPINIONS & FINAL STATUS -->
            <div class="gov-card shadow-sm mb-4" id="opinionsSection" style="@(Model.Result == "AGAINST" ? "" : "display:none;")">
                <div class="gov-card-header bg-secondary">
                    <h6 class="fw-bold mb-0 text-white"><i class="bi bi-chat-left-text-fill me-2"></i>SECTION 6: OPINIONS & FINAL STATUS</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Award Details</label>
                            <textarea class="form-control" rows="3" name="AwardDetails">@Model.AwardDetails</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Advocate's Opinion</label>
                            <textarea class="form-control" name="AdvocateOpinion" rows="3">@Model.AdvocateOpinion</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Law Officer's Opinion</label>
                            <textarea class="form-control" name="LawOfficerOpinion" rows="3">@Model.LawOfficerOpinion</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">DC's Final Decision</label>
                            <textarea class="form-control" name="DCFinalDecision" rows="3">@Model.DCFinalDecision</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Final Forwarding Status</label>
                            <select class="form-select border-secondary" name="FinalForwardingStatus" id="finalForwardSelect">
                                <option value="PENDING" selected="@(Model.FinalForwardingStatus == "PENDING")">PENDING</option>
                                <option value="FORWARDED TO CO" selected="@(Model.FinalForwardingStatus == "FORWARDED TO CO")">FORWARDED TO CO</option>
                                <option value="APPEAL" selected="@(Model.FinalForwardingStatus == "APPEAL")">APPEAL</option>
                                <option value="CLOSED" selected="@(Model.FinalForwardingStatus == "CLOSED")">CLOSED</option>
                            </select>
                        </div>
                        
                        <div class="col-md-12" id="finalForwardCOFields" style="@(Model.FinalForwardingStatus == "FORWARDED TO CO" ? "" : "display:none;")">
                            <div class="row g-3 p-3 bg-light rounded border border-warning">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-warning">Outward Number</label>
                                    <input type="text" class="form-control" name="OutwardNumber" value="@Model.OutwardNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-warning">Outward Date</label>
                                    <input type="date" class="form-control" name="OutwardDate" value="@(Model.OutwardDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12" id="finalClosedFields" style="@(Model.FinalForwardingStatus == "CLOSED" ? "" : "display:none;")">
                            <div class="row g-3 p-3 bg-light rounded border border-danger">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-danger">Closure Number</label>
                                    <input type="text" class="form-control" name="ClosureNumber" value="@Model.ClosureNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-danger">Closure Date</label>
                                    <input type="date" class="form-control" name="ClosureDate" value="@(Model.ClosureDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- APPEAL DETAILS -->
            <div id="appealDetailsSection" style="@(Model.FinalForwardingStatus == "APPEAL" ? "" : "display:none;")" class="mb-4">
                <div class="gov-card shadow-sm">
                    <div class="gov-card-header bg-primary">
                        <h6 class="fw-bold mb-0 text-white"><i class="bi bi-box-arrow-up-right me-2"></i>SECTION 7: APPEAL DETAILS</h6>
                    </div>
                    <div class="gov-card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Appeal Number</label>
                                <input type="text" class="form-control" name="AppealNumber" value="@Model.AppealNumber">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Appeal Year</label>
                                <input type="number" class="form-control" name="AppealYear" value="@Model.AppealYear">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Arising Out OS Number</label>
                                <input type="text" class="form-control" name="ArisingOutOSNumber" value="@Model.ArisingOutOSNumber">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">OS Year</label>
                                <input type="number" class="form-control" name="OSYear" value="@Model.OSYear">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Appeal Entrustment Number</label>
                                <input type="text" class="form-control" name="AppealEntrustmentNumber" value="@Model.AppealEntrustmentNumber">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Appeal Entrustment Date</label>
                                <input type="date" class="form-control" name="AppealEntrustmentDate" value="@(Model.AppealEntrustmentDate?.ToString("yyyy-MM-dd"))">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Court (Appellate Auth)</label>
                                <input type="text" class="form-control" name="CourtAppellateAuth" value="@Model.CourtAppellateAuth">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Appeal Advocate Name</label>
                                <select class="form-select" name="AppealAdvocateName">
                                    <option value="">Select Advocate...</option>
                                    @if (ViewBag.Advocates != null)
                                    {
                                        foreach (var advocate in ViewBag.Advocates)
                                        {
                                            <option value="@advocate.AdvocateName" selected="@(Model.AppealAdvocateName == advocate.AdvocateName)">@advocate.AdvocateName</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-12 mt-4"><h6 class="text-primary fw-bold border-bottom pb-2 mb-3">Compliance for Appeal</h6></div>
                            <div class="col-md-4">
                                <label class="form-label">Compliance Amount</label>
                                <input type="number" step="0.01" class="form-control" name="AppealComplianceAmount" value="@Model.AppealComplianceAmount">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Cheque Number</label>
                                <input type="text" class="form-control" name="AppealChequeNumber" value="@Model.AppealChequeNumber">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Cheque Date</label>
                                <input type="date" class="form-control" name="AppealChequeDate" value="@(Model.AppealChequeDate?.ToString("yyyy-MM-dd"))">
                            </div>

                            <div class="col-md-12 mt-4"><h6 class="text-primary fw-bold border-bottom pb-2 mb-3">After Disposal of Appeal</h6></div>
                            <div class="col-md-12">
                                <label class="form-label">Award Details</label>
                                <textarea class="form-control" name="AppealAwardDetails" rows="2">@Model.AppealAwardDetails</textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Case Disposed On</label>
                                <input type="date" class="form-control" name="AppealCaseDisposedOn" value="@(Model.AppealCaseDisposedOn?.ToString("yyyy-MM-dd"))">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Forwarding Status</label>
                                <select class="form-select" name="AppealForwardingStatus" id="appealForwardSelect">
                                    <option value="PENDING" selected="@(Model.AppealForwardingStatus == "PENDING")">PENDING</option>
                                    <option value="FORWARDED TO CO" selected="@(Model.AppealForwardingStatus == "FORWARDED TO CO")">FORWARDED TO CO</option>
                                    <option value="CLOSED" selected="@(Model.AppealForwardingStatus == "CLOSED")">CLOSED</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Upload Appeal Judgment</label>
                                <input type="file" class="form-control" name="AppealJudgmentCopy" accept=".pdf">
                                @if (!string.IsNullOrEmpty(Model.AppealJudgmentCopyPath)) {
                                    <div class="mt-2"><a href="@Model.AppealJudgmentCopyPath" target="_blank" class="small"><i class="bi bi-file-pdf text-danger"></i> Existing File</a></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ENCLOSED DOCUMENTS -->
            <div class="gov-card shadow-sm mb-4">
                <div class="gov-card-header bg-dark">
                    <h6 class="fw-bold mb-0 text-white"><i class="bi bi-file-earmark-plus me-2"></i>SECTION 8: ENCLOSED DOCUMENTS</h6>
                </div>
                <div class="gov-card-body p-4">
                    <div id="enclosedDocsList">
                        @if (Model.EnclosedDocuments != null && Model.EnclosedDocuments.Any())
                        {
                            for (int i = 0; i < Model.EnclosedDocuments.Count; i++)
                            {
                                <div class="row g-2 mb-2 doc-row align-items-center">
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" name="EnclosedDocuments[@i].DocName" value="@Model.EnclosedDocuments[i].DocName" placeholder="Document Description...">
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control" name="EnclosedDocuments[@i].PageCount" value="@Model.EnclosedDocuments[i].PageCount" placeholder="Pages...">
                                    </div>
                                    <div class="col-md-1 text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-doc-row w-100"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <button type="button" class="btn btn-outline-dark btn-sm btn-add-enclosed-doc mt-2"><i class="bi bi-plus-lg me-1"></i>Add Document</button>
                </div>
            </div>

            <div class="col-12 text-center mt-4 mb-5">
                <button type="submit" class="btn btn-primary px-5 shadow-sm rounded-pill py-2">
                    <i class="bi bi-check2-circle me-2"></i>UPDATE CASE DETAILS
                </button>
                <a href="@Url.Action("OtherCourtsCaseDetails", "Home", new { id = Model.CaseID })" class="btn btn-outline-secondary px-5 rounded-pill py-2 ms-2">
                    Cancel
                </a>
            </div>
        </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Case Progress: Document Sent Radio Toggle
            $('input[name="DocumentSent"]').change(function() {
                if ($(this).val() === 'Yes') $('#docSentFields').slideDown(300);
                else $('#docSentFields').slideUp(300);
            });

            // Objection Verified Radio Toggle
            $('input[name="ObjectionVerified"]').change(function() {
                if ($(this).val() === 'Yes') $('#objVerifiedFields').slideDown(300);
                else $('#objVerifiedFields').slideUp(300);
            });

            // Vehicle Involved Toggle
            $('#IsVehicleInvolved').change(function() {
                if ($(this).val() === 'yes') $('.vehicle-fields').slideDown(300);
                else $('.vehicle-fields').slideUp(300);
            });

            // Objection Filed Toggle
            $('input[name="IsObjectionFiled"]').change(function() {
                if ($(this).val() === 'No') $('#objNoFields').slideDown(300);
                else $('#objNoFields').slideUp(300);
            });

            // Disposal Status dropdown
            $('#disposalStatusSelect').change(function() {
                var val = $(this).val();
                if (val === 'DISPOSED' || val === 'DNP') {
                    $('#resultSection').slideDown(300);
                } else {
                    $('#resultSection').slideUp(300);
                    $('#favorSection').slideUp(300);
                    $('#evidenceSection').slideUp(300);
                    $('#ccDetailsSection').slideUp(300);
                    $('#opinionsSection').slideUp(300);
                }
            });

            // Result dropdown (FAVOR/AGAINST)
            $('#resultSelect').change(function() {
                var val = $(this).val();
                if (val === 'AGAINST') {
                    $('#evidenceSection').slideDown(300);
                    $('#ccDetailsSection').slideDown(300);
                    $('#opinionsSection').slideDown(300);
                    $('#favorSection').slideUp(300);
                } else if (val === 'FAVOR') {
                    $('#favorSection').slideDown(300);
                    $('#evidenceSection').slideUp(300);
                    $('#ccDetailsSection').slideUp(300);
                    $('#opinionsSection').slideUp(300);
                } else {
                    $('#favorSection').slideUp(300);
                    $('#evidenceSection').slideUp(300);
                    $('#ccDetailsSection').slideUp(300);
                    $('#opinionsSection').slideUp(300);
                }
            });

            // Final Forwarding Status dropdown
            $('#finalForwardSelect').change(function() {
                var val = $(this).val();
                $('#finalForwardCOFields').slideUp(200);
                $('#finalClosedFields').slideUp(200);
                $('#appealDetailsSection').slideUp(200);
                
                if (val === 'FORWARDED TO CO') $('#finalForwardCOFields').slideDown(300);
                else if (val === 'CLOSED') $('#finalClosedFields').slideDown(300);
                else if (val === 'APPEAL') $('#appealDetailsSection').slideDown(300);
            });

            // Internal Appeal Forwarding Status toggle
            $('#appealForwardSelect').change(function() {
                var val = $(this).val();
                // We don't have separate fields for Appeal Forwarded/Closed yet in this view, 
                // but the logic can be added if needed.
            });

            // Dynamic Respondent List Management (Wait, the UI calls them Petitioners but property is Respondents)
            let petIndex = @(Model.Respondents?.Count ?? 0);
            $(document).on('click', '.add-respondent', function() {
                const row = `
                    <div class="row g-2 mb-2 respondent-row align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="Respondents[${petIndex}].Name" placeholder="Name..." />
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="Respondents[${petIndex}].Remark" placeholder="Remark..." />
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-danger remove-respondent w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#respondentList').append(row);
                petIndex++;
            });

            $(document).on('click', '.remove-respondent', function() {
                $(this).closest('.respondent-row').remove();
                reindexRespondents();
            });

            function reindexRespondents() {
                let idx = 0;
                $('#respondentList .respondent-row').each(function() {
                    $(this).find('input[name*=".Name"]').attr('name', `Respondents[${idx}].Name`);
                    $(this).find('input[name*=".Remark"]').attr('name', `Respondents[${idx}].Remark`);
                    idx++;
                });
                petIndex = idx;
            }

            // Respondent Evidence Management
            let respEvIndex = @(Model.RespondentEvidence?.Count ?? 0);
            $(document).on('click', '.add-resp-ev', function() {
                const row = `
                    <div class="row g-2 mb-2 resp-evidence-row align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="RespondentEvidence[${respEvIndex}].Name" placeholder="Name..." />
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="RespondentEvidence[${respEvIndex}].Remark" placeholder="Remark..." />
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-danger remove-resp-ev w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#respEvidenceList').append(row);
                respEvIndex++;
            });

            $(document).on('click', '.remove-resp-ev', function() {
                $(this).closest('.resp-evidence-row').remove();
                reindexRespEvidence();
            });

            function reindexRespEvidence() {
                let idx = 0;
                $('#respEvidenceList .resp-evidence-row').each(function() {
                    $(this).find('input[name*=".Name"]').attr('name', `RespondentEvidence[${idx}].Name`);
                    $(this).find('input[name*=".Remark"]').attr('name', `RespondentEvidence[${idx}].Remark`);
                    idx++;
                });
                respEvIndex = idx;
            }

            // Corp Evidence Management
            let corpEvIndex = @(Model.CorpEvidence?.Count ?? 0);
            $(document).on('click', '.add-corp-ev', function() {
                const row = `
                    <div class="row g-2 mb-2 corp-evidence-row align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="CorpEvidence[${corpEvIndex}].Name" placeholder="Name..." />
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="CorpEvidence[${corpEvIndex}].Designation" placeholder="Designation..." />
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-danger remove-corp-ev w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#corpEvidenceList').append(row);
                corpEvIndex++;
            });

            $(document).on('click', '.remove-corp-ev', function() {
                $(this).closest('.corp-evidence-row').remove();
                reindexCorpEvidence();
            });

            function reindexCorpEvidence() {
                let idx = 0;
                $('#corpEvidenceList .corp-evidence-row').each(function() {
                    $(this).find('input[name*=".Name"]').attr('name', `CorpEvidence[${idx}].Name`);
                    $(this).find('input[name*=".Designation"]').attr('name', `CorpEvidence[${idx}].Designation`);
                    idx++;
                });
                corpEvIndex = idx;
            }

            // Enclosed Documents Management
            let docIndex = @(Model.EnclosedDocuments?.Count ?? 0);
            $(document).on('click', '.btn-add-enclosed-doc', function() {
                const row = `
                    <div class="row g-2 mb-2 doc-row align-items-center">
                        <div class="col-md-8">
                            <input type="text" class="form-control" name="EnclosedDocuments[${docIndex}].DocName" placeholder="Description...">
                        </div>
                        <div class="col-md-3">
                            <input type="number" class="form-control" name="EnclosedDocuments[${docIndex}].PageCount" placeholder="Pages...">
                        </div>
                        <div class="col-md-1 text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-doc-row w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#enclosedDocsList').append(row);
                docIndex++;
            });

            $(document).on('click', '.remove-doc-row', function() {
                $(this).closest('.doc-row').remove();
                reindexDocs();
            });

            function reindexDocs() {
                let idx = 0;
                $('#enclosedDocsList .doc-row').each(function() {
                    $(this).find('input[name*=".DocName"]').attr('name', `EnclosedDocuments[${idx}].DocName`);
                    $(this).find('input[name*=".PageCount"]').attr('name', `EnclosedDocuments[${idx}].PageCount`);
                    idx++;
                });
                docIndex = idx;
            }
        });
    </script>
}
