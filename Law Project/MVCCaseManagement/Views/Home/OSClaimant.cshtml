@model MVCCaseManagement.Models.DashboardStatsViewModel
@{
    Layout = "~/Views/Shared/_OtherCourtsLayout.cshtml";
    ViewData["Title"] = "O.S Claimant Dashboard";
}

<div class="container-fluid pt-2 pb-4" style="max-width: 1600px;">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 col-xl-2 d-print-none">
            @await Html.PartialAsync("_OtherCourtsSidebar")
        </div>

        <!-- Main Dashboard Area -->
        <div class="col-lg-9 col-xl-10">
            <!-- Header section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold text-primary mb-1"><i class="bi bi-speedometer2 me-2"></i>O.S Claimant Dashboard</h4>
                    <p class="text-muted small mb-0">Overview of active lawsuits and upcoming hearings</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("OSClaimantForm", "Home")" class="btn btn-primary shadow-sm rounded-pill px-4">
                        <i class="bi bi-plus-lg me-1"></i> New Registration
                    </a>
                </div>
            </div>

            <!-- Stat Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card card-bold-total p-3 border-0 shadow-sm rounded-4 h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-white bg-opacity-25 rounded-3 p-2 me-3 shadow-sm">
                                <i class="bi bi-briefcase fs-4"></i>
                            </div>
                            <h6 class="mb-0 small fw-bold">Total Cases</h6>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <h3 class="fw-bold mb-0">@Model.TotalCases</h3>
                            <span class="ms-2 text-success small"><i class="bi bi-arrow-up"></i> 12%</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card card-bold-pending p-3 border-0 shadow-sm rounded-4 h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-white bg-opacity-25 rounded-3 p-2 me-3 shadow-sm">
                                <i class="bi bi-clock-history fs-4"></i>
                            </div>
                            <h6 class="mb-0 small fw-bold">Pending Cases</h6>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <h3 class="fw-bold mb-0">@Model.PendingCases</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card card-bold-disposed p-3 border-0 shadow-sm rounded-4 h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-white bg-opacity-25 rounded-3 p-2 me-3 shadow-sm">
                                <i class="bi bi-check-circle fs-4"></i>
                            </div>
                            <h6 class="mb-0 small fw-bold">Disposed Cases</h6>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <h3 class="fw-bold mb-0">@Model.CloseCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card card-bold-hearings p-3 border-0 shadow-sm rounded-4 h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-white bg-opacity-25 rounded-3 p-2 me-3 shadow-sm">
                                <i class="bi bi-calendar-event fs-4"></i>
                            </div>
                            <h6 class="mb-0 small fw-bold">Hearings Today</h6>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <h3 class="fw-bold mb-0">@Model.HearingsToday</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tables Row -->
            <div class="row g-4">
                <!-- Upcoming Hearings -->
                <div class="col-xl-8">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-check me-2"></i>Upcoming Hearing Schedule</h6>
                            <a href="@Url.Action("OtherCourtsCaseList", "Home", new { activeCourt = "OS", litigantType = "Claimant" })" class="btn btn-sm btn-light rounded-pill px-3">View All</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light bg-opacity-50">
                                        <tr>
                                            <th class="ps-4">Case Details</th>
                                            <th>Court</th>
                                            <th>Current Stage</th>
                                            <th>Hearing Date</th>
                                            <th class="text-end pe-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RecentCases != null && Model.RecentCases.Any())
                                        {
                                            foreach (var caseItem in Model.RecentCases)
                                            {
                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="fw-bold text-dark">OS @caseItem.MVCNo</div>
                                                        <div class="xsmall text-muted">Created: @caseItem.CreatedAt.ToString("dd MMM yyyy")</div>
                                                    </td>
                                                    <td>
                                                        <span class="small">@caseItem.MACTName</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-soft-primary text-primary border rounded-pill px-3">@caseItem.DisposalResult</span>
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold">@caseItem.NextHearingDate?.ToString("dd-MM-yyyy")</div>
                                                        @if (caseItem.NextHearingDate?.Date == DateTime.Today)
                                                        {
                                                            <div class="xsmall text-danger fw-bold animate-pulse"><i class="bi bi-alarm-fill me-1"></i>TODAY</div>
                                                        }
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <a href="@Url.Action("EditOtherCourtsCase", "Home", new { id = caseItem.CaseID })" class="btn btn-icon btn-light rounded-circle shadow-sm">
                                                            <i class="bi bi-pencil-square text-primary"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-5">
                                                    <div class="text-muted">
                                                        <i class="bi bi-inbox fs-1 mb-3 d-block opacity-25"></i>
                                                        No upcoming hearings found for this module.
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Quick Info / Recent Activity -->
                <div class="col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-activity me-2"></i>Quick Summary</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="small text-muted">Favor Percentage</span>
                                    <span class="small fw-bold">65%</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 65%" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="small text-muted">Against Percentage</span>
                                    <span class="small fw-bold">35%</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 6px;">
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: 35%" aria-valuenow="35" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            <hr class="opacity-10">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-soft-warning p-2 rounded-3 me-3">
                                    <i class="bi bi-exclamation-triangle text-warning"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small">Compliance Pending</div>
                                    <div class="xsmall text-muted">@Model.ComplianceDueCount items require attention</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .bg-soft-primary { background-color: #eef2ff; }
    .btn-white {
        background: white;
    }
    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .xsmall { font-size: 0.75rem; }
    .fw-800 { font-weight: 800; }
</style>
