@model IEnumerable<MVCCaseManagement.Models.GlobalCaseViewModel>

@{
    ViewData["Title"] = "Critical Delays Analysis";
    var totalCount = Model?.Count() ?? 0;
    var recentCount = Model?.Count(c => c.DaysOverdue > 0 && c.DaysOverdue <= 30) ?? 0;
    var extendedCount = Model?.Count(c => c.DaysOverdue > 30 && c.DaysOverdue <= 180) ?? 0;
    var staleCount = Model?.Count(c => c.DaysOverdue > 180) ?? 0;
    var cnrLinkedCount = Model?.Count(c => !string.IsNullOrEmpty(c.CNRNumber) && c.CNRNumber.Length == 16) ?? 0;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-danger mb-1">
                <i class="bi bi-clock-history me-2"></i>Critical Delays & Overdue Hearings
            </h2>
            <p class="text-muted mb-0 small">
                Live multi-module tracking of pending cases with past scheduled hearing dates across NWKRTC.
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <form method="get" class="d-flex align-items-center me-2">
                <label class="me-2 text-muted small fw-bold text-uppercase">Module:</label>
                <select name="module" class="form-select rounded-pill shadow-sm border-0 px-3" style="min-width: 170px; height: 40px;" onchange="this.form.submit()">
                    <option value="All" selected="@(ViewBag.SelectedModule == "All")">All Modules</option>
                    <option value="MVC" selected="@(ViewBag.SelectedModule == "MVC")">MVC Claims</option>
                    <option value="Labour" selected="@(ViewBag.SelectedModule == "Labour")">Labour Disputes</option>
                    <option value="Gratuity" selected="@(ViewBag.SelectedModule == "Gratuity")">Gratuity</option>
                    <option value="Other" selected="@(ViewBag.SelectedModule == "Other")">Other Courts</option>
                </select>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm px-4" style="height: 40px; display: flex; align-items: center;">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-danger h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Total Critical Delays</div>
                        <h3 class="fw-bold text-danger mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-info-circle me-1"></i>Overdue pending court appearances
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-warning h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Recent (&le; 30 Days)</div>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@recentCount</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-bell me-1"></i>Requires stage/advocate update
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-secondary h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Stale / Dormant (&gt; 180d)</div>
                        <h3 class="fw-bold text-secondary mb-0 mt-1">@staleCount</h3>
                    </div>
                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-3">
                        <i class="bi bi-archive-fill fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-arrow-repeat me-1"></i>e-Courts sync or file audit needed
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-primary h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">e-Courts CNR Linked</div>
                        <h3 class="fw-bold text-primary mb-0 mt-1">@cnrLinkedCount</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="bi bi-cloud-check-fill fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-lightning-fill text-warning me-1"></i>NAPIX Auto-Sync capable
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Tool Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="small fw-bold text-muted text-uppercase me-1">Filter Delay:</span>
                <button type="button" class="btn btn-sm btn-outline-danger active rounded-pill px-3 filter-btn" data-filter="all">All (@totalCount)</button>
                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 filter-btn" data-filter="recent">Recent &le;30d (@recentCount)</button>
                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 filter-btn" data-filter="extended">31-180d (@extendedCount)</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-btn" data-filter="stale">Stale &gt;180d (@staleCount)</button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 filter-btn" data-filter="cnr">CNR Linked (@cnrLinkedCount)</button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="tableSearchInput" class="form-control bg-light border-0" placeholder="Search case, court, CNR...">
                </div>
            </div>
        </div>
    </div>

    <!-- Main Delays Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="delaysTable">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Module</th>
                            <th>Case Number</th>
                            <th>Court / Bench</th>
                            <th>Stage / Purpose</th>
                            <th>Overdue Hearing Date</th>
                            <th>Days Overdue</th>
                            <th>e-Courts CNR</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var days = item.DaysOverdue;
                                var severityClass = days <= 30 ? "recent" : (days <= 180 ? "extended" : "stale");
                                var hasCnr = !string.IsNullOrEmpty(item.CNRNumber) && item.CNRNumber.Length == 16;
                                
                                <tr class="delay-row" data-severity="@severityClass" data-hascnr="@(hasCnr ? "true" : "false")" id="row-@item.ModuleName-@item.CaseID">
                                    <td class="ps-4">
                                        @if (item.ModuleName == "MVC")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-truck-front-fill me-1"></i>MVC</span>
                                        }
                                        else if (item.ModuleName == "Labour")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-people-fill me-1"></i>Labour</span>
                                        }
                                        else if (item.ModuleName == "Labour Service")
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-bank me-1"></i>High Court</span>
                                        }
                                        else if (item.ModuleName == "Gratuity")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-cash-coin me-1"></i>Gratuity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark bg-opacity-10 text-dark border rounded-pill px-3 py-1">@item.ModuleName</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.CaseNo</div>
                                    </td>
                                    <td>
                                        <div class="text-dark small">@item.CourtOrAuthority</div>
                                        @if (!string.IsNullOrEmpty(item.CourtHall))
                                        {
                                            <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@item.CourtHall</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 small">
                                            @(string.IsNullOrEmpty(item.Stage) ? "Pending Hearing" : item.Stage)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.NextHearingDate.HasValue)
                                        {
                                            <span class="fw-bold text-danger"><i class="bi bi-calendar-x me-1"></i>@item.NextHearingDate.Value.ToString("dd-MM-yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not Scheduled</span>
                                        }
                                    </td>
                                    <td>
                                        @if (days <= 30)
                                        {
                                            <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 px-2 py-1">
                                                @days days
                                            </span>
                                        }
                                        else if (days <= 180)
                                        {
                                            <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2 py-1">
                                                @days days
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                                @days days
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (hasCnr)
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <code class="text-primary small fw-bold">@item.CNRNumber</code>
                                                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.72rem;" 
                                                        title="Synchronize live status from e-Courts NAPIX Gateway"
                                                        onclick="syncLiveCnr(this, '@item.CNRNumber', @item.CaseID, '@item.ModuleName', @(item.IsHighCourt ? "true" : "false"))">
                                                    <i class="bi bi-cloud-arrow-down"></i> Sync
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Not Linked</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@item.DetailsUrl" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            View Details <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-check-circle fs-1 d-block mb-3 opacity-50 text-success"></i>
                                        <h5>No Critical Delays</h5>
                                        <p>There are no pending cases with overdue scheduled hearing dates.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Client-side filtering & search
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('tableSearchInput');
        const filterButtons = document.querySelectorAll('.filter-btn');
        const rows = document.querySelectorAll('.delay-row');

        let activeFilter = 'all';

        function applyFilter() {
            const query = (searchInput.value || '').toLowerCase().trim();

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const severity = row.getAttribute('data-severity');
                const hasCnr = row.getAttribute('data-hascnr') === 'true';

                let matchFilter = true;
                if (activeFilter === 'recent') matchFilter = (severity === 'recent');
                else if (activeFilter === 'extended') matchFilter = (severity === 'extended');
                else if (activeFilter === 'stale') matchFilter = (severity === 'stale');
                else if (activeFilter === 'cnr') matchFilter = hasCnr;

                const matchSearch = query === '' || text.includes(query);

                row.style.display = (matchFilter && matchSearch) ? '' : 'none';
            });
        }

        filterButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                filterButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                activeFilter = this.getAttribute('data-filter');
                applyFilter();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', applyFilter);
        }
    });

    // One-Click NAPIX Live e-Courts Synchronizer
    async function syncLiveCnr(buttonElement, cnrNumber, caseId, moduleName, isHighCourt) {
        const originalHtml = buttonElement.innerHTML;
        buttonElement.disabled = true;
        buttonElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

        try {
            const response = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnrNumber)}&isHighCourt=${isHighCourt}`);
            const result = await response.json();

            if (result && result.success && result.data) {
                const data = result.data;
                const nextDate = data.next_date || data.next_hearing_date || data.date_next_list;
                const stage = data.stage || data.stage_name || data.purpose_next;
                const isDisposed = data.is_disposed === true || data.pend_disp === 'D';

                // Post to SaveLiveHearingDate
                const postUrl = (moduleName === 'Labour' || moduleName === 'Labour Service')
                    ? '/Labour/SaveLiveHearingDate'
                    : '/Case/SaveLiveHearingDate';

                try {
                    await fetch(postUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({
                            caseId: caseId,
                            hearingDate: nextDate || '',
                            stage: isDisposed ? `Disposed (${data.disposal_type || 'DISPOSED'})` : (stage || ''),
                            courtHall: data.coram_name || data.court_no || ''
                        })
                    });
                } catch (e) {
                    console.warn('Auto-save live date failed:', e);
                }

                buttonElement.innerHTML = '<i class="bi bi-check2 text-success"></i> Synced';
                buttonElement.classList.remove('btn-outline-primary');
                buttonElement.classList.add('btn-success', 'text-white');

                alert(`e-Courts Synced Successfully!\n\nCNR: ${cnrNumber}\nStatus: ${isDisposed ? 'DISPOSED' : 'PENDING'}\nNext Date: ${nextDate || 'Not Scheduled'}\nStage: ${stage || 'N/A'}`);
            } else {
                buttonElement.innerHTML = '<i class="bi bi-exclamation-circle text-warning"></i> Error';
                alert(result?.message || 'Unable to retrieve live details from e-Courts NAPIX Gateway.');
                setTimeout(() => {
                    buttonElement.innerHTML = originalHtml;
                    buttonElement.disabled = false;
                }, 3000);
            }
        } catch (err) {
            console.error('NAPIX Sync error:', err);
            buttonElement.innerHTML = '<i class="bi bi-x-circle text-danger"></i> Failed';
            setTimeout(() => {
                buttonElement.innerHTML = originalHtml;
                buttonElement.disabled = false;
            }, 3000);
        }
    }
</script>
