@using System.Security.Claims
@{
    Layout = "~/Views/Shared/_OtherCourtsLayout.cshtml";
    ViewData["Title"] = "ECA Case Details";
    var divName = User.FindFirstValue("DivisionName");
}

@section Styles {
    <style>
        /* Form Canvas Styling */
        .form-workspace {
            animation: fadeIn 0.6s ease-out forwards;
        }

        /* Glassmorphism Header */
        .eca-header-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(5, 150, 105, 0.1);
            border-radius: 24px;
            padding: 2.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px -5px rgba(6, 78, 59, 0.05);
            position: relative;
            overflow: hidden;
        }

        .eca-header-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-brand), var(--court-hover), var(--accent-vibrant));
        }

        /* Creative Sectioning */
        .form-section-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #f1f5f9;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
            margin-bottom: 2rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .form-section-card:hover {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
            border-color: rgba(56, 82, 180, 0.2);
            transform: translateY(-2px);
        }

        .section-badge {
            background: #eff6ff;
            color: var(--primary-brand);
            padding: 0.5rem 1rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            margin-bottom: 1rem;
            display: inline-block;
        }

        /* Input Group Refinement */
        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.1rem;
            transition: color 0.2s;
        }

        .input-icon-wrapper .form-control, 
        .input-icon-wrapper .form-select {
            padding-left: 3.25rem !important;
        }

        .input-icon-wrapper .form-control:focus + i,
        .input-icon-wrapper .form-select:focus + i {
            color: var(--primary-brand);
        }

        /* Dynamic Row Styling */
        .petitioner-row {
            background: #f8fafc;
            padding: 1rem;
            border-radius: 16px;
            margin-bottom: 0.75rem !important;
            border: 1px solid #f1f5f9;
            transition: all 0.2s;
        }

        .petitioner-row:hover {
            background: #f1f5f9;
            border-color: #e2e8f0;
        }

        /* Conditional Section Animations */
        #docSentFields, #objVerifiedFields {
            background: #f8fafc;
            padding: 1.5rem;
            border-radius: 16px;
            border: 1px dashed var(--accent-soft);
            margin-top: 1rem;
        }

        /* Submit Button Premium */
        .btn-register {
            background: linear-gradient(135deg, var(--primary-brand) 0%, var(--primary-dark) 100%);
            color: white;
            padding: 1rem 3rem;
            border-radius: 18px;
            font-weight: 800;
            font-size: 1.1rem;
            border: none;
            box-shadow: 0 10px 25px -5px rgba(56, 82, 180, 0.4);
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn-register:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 20px 30px -10px rgba(56, 82, 180, 0.6);
            color: white;
        }

        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stagger-1 { animation-delay: 0.1s; }
        .stagger-2 { animation-delay: 0.2s; }
        .stagger-3 { animation-delay: 0.3s; }
        .stagger-4 { animation-delay: 0.4s; }

        /* Custom Scrollbar for sidebars/lists */
        .petitioner-scroll {
            max-height: 400px;
            overflow-y: auto;
            padding-right: 5px;
        }
        .petitioner-scroll::-webkit-scrollbar { width: 5px; }
        .petitioner-scroll::-webkit-scrollbar-track { background: #f1f5f9; }
        .petitioner-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
}

<div class="container-fluid py-4 form-workspace" style="max-width: 1600px;">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 col-xl-2 d-print-none">
            @await Html.PartialAsync("_OtherCourtsSidebar")
        </div>

        <!-- Main Form Area -->
        <div class="col-lg-9 col-xl-10">


            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible border-0 shadow-sm rounded-4 px-4 py-3 mb-4 fade show" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                        <div>
                            <strong class="d-block">Registration Successful!</strong>
                            <span class="small">@TempData["SuccessMessage"]</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form id="ecaCaseForm" method="post" action="@Url.Action("SaveOtherCourtsCase", "Home")" class="text-start" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CaseType" value="ECA" />
                <input type="hidden" name="LitigantType" value="Claimant" />
                <input type="hidden" name="IsPendingForFiling" value="false" />

                <!-- 1. Case Registry Identity -->
                <div class="form-section-card stagger-1">
                    <div class="p-4 border-bottom bg-light bg-opacity-25">
                        <span class="section-badge">SECTION 01</span>
                        <h6 class="fw-bold text-primary mb-0">1. CASE REGISTRY IDENTITY & INCIDENT DETAILS</h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Case Type / ಪ್ರಕರಣದ ಹಂತ</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-activity"></i>
                                    <select class="form-select border-primary" name="CaseStage" required>
                                        <option value="">-- Choose Type --</option>
                                        <option value="pending">pending</option>
                                        <option value="disposed">disposed</option>
                                        <option value="dnp">dnp</option>
                                        <option value="ex-parte">ex-parte</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Division</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-geo-alt"></i>
                                    <input type="text" class="form-control bg-light" value="@divName" readonly tabindex="-1" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ECA Number</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-hash"></i>
                                    <input type="text" class="form-control" name="CaseNumber" placeholder="Enter ECA Number" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ECA Year</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-calendar3"></i>
                                    <input type="number" class="form-control" name="CaseYear" placeholder="YYYY" required />
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Court</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-bank"></i>
                                    <input type="text" class="form-control" name="Court" placeholder="Name and Location of Court" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Any vehicle involved?</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-question-circle"></i>
                                    <select class="form-select" id="IsVehicleInvolved" name="IsVehicleInvolved">
                                        <option value="no">No</option>
                                        <option value="yes">Yes</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4" id="vehicleTypeContainer" style="display: none;">
                                <label class="form-label">Vehicle Type</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-tag"></i>
                                    <select class="form-select" id="VehicleType" name="VehicleType">
                                        <option value="">-- Choose Type --</option>
                                        <option value="Corporation">Corporation (NWKRTC)</option>
                                        <option value="Private">Private / Hired / Other</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4" id="vehicleNumberContainer" style="display: none;">
                                <label class="form-label">Vehicle Number</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-truck"></i>
                                    <input type="text" class="form-control" id="VehicleNumber" name="VehicleNumber" placeholder="Enter Vehicle Number" />
                                </div>
                                <div class="small text-muted mt-1 ps-1" id="vehicleNumberHint">Pattern: KA-XX-F-XXXX</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date of Incident</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-calendar-event"></i>
                                    <input type="date" class="form-control" name="DateOfAccident" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Petitioner & Claim Details -->
                <div class="form-section-card stagger-3">
                    <div class="p-4 border-bottom bg-light bg-opacity-25 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="section-badge">SECTION 02</span>
                            <h6 class="fw-bold text-primary mb-0">2. FURTHER CASE DETAILS & LINKAGES</h6>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm rounded-3 add-petitioner shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i> Add Petitioner
                        </button>
                    </div>
                    <div class="p-4">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Is petitioner corporation employee?</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="IsCorporationEmployee" id="isCorpEmpYes" value="Yes">
                                        <label class="form-check-label" for="isCorpEmpYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="IsCorporationEmployee" id="isCorpEmpNo" value="No" checked>
                                        <label class="form-check-label" for="isCorpEmpNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h6 class="small fw-bold text-muted text-uppercase mb-3">Petitioner Details</h6>
                        <div id="petitionerList" class="petitioner-scroll">
                            <div class="row g-3 petitioner-row align-items-center">
                                <div class="col-md-5">
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-person"></i>
                                        <input type="text" class="form-control" name="Petitioners[0].Name" placeholder="Petitioner Name..." />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-chat-left-dots"></i>
                                        <input type="text" class="form-control" name="Petitioners[0].Remark" placeholder="REMARKS..." />
                                    </div>
                                </div>
                                <div class="col-md-1 text-end">
                                    <!-- Default row can't be deleted or has a special icon -->
                                    <i class="bi bi-check2-circle text-success fs-4"></i>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 opacity-25">

                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Nature of Claim</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-file-earmark-medical"></i>
                                    <input type="text" class="form-control" name="CaseNature" placeholder="Describe the claim nature..." />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Manner of Incident</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-info-circle"></i>
                                    <input type="text" class="form-control" name="MannerOfIncident" placeholder="Describe how the incident occurred..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Date of Claim Petition</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-calendar-check"></i>
                                    <input type="date" class="form-control" name="DateOfClaimPetition" />
                                </div>
                            </div>
                            
                            <div class="col-md-12"><h6 class="small fw-bold text-muted text-uppercase mb-2 mt-2">Financial & Advocate Details</h6></div>
                            
                            <div class="col-md-3">
                                <label class="form-label text-success">Claim Amount (₹)</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-currency-rupee text-success"></i>
                                    <input type="number" step="0.01" class="form-control border-success text-success fw-bold" name="ClaimAmount" placeholder="0.00" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Claim Remarks</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-chat-left-text"></i>
                                    <input type="text" class="form-control" name="ClaimRemarks" placeholder="Remarks regarding claim amount or details..." />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Advocate Name</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-person-badge"></i>
                                    <select class="form-select" name="AdvocateName">
                                        <option value="">-- Choose Advocate --</option>
                                        @if(ViewBag.Advocates != null)
                                        {
                                            foreach(var adv in ViewBag.Advocates)
                                            {
                                                <option value="@adv.AdvocateName">@adv.AdvocateName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Entrustment No & Date</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" name="EntrustmentNumber" placeholder="No..." />
                                    <input type="date" class="form-control" name="EntrustmentDate" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Progress Tracking -->
                <div class="form-section-card stagger-4">
                    <div class="p-4 border-bottom bg-light bg-opacity-25">
                        <span class="section-badge">SECTION 03</span>
                        <h6 class="fw-bold text-primary mb-0">3. CASE PROGRESS</h6>
                    </div>
                    <div class="p-4">
                        <div class="row g-4 align-items-center">
                            <div class="col-md-6 border-end">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label mb-0 fw-800">Initial Document Sent?</label>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <input type="radio" class="btn-check" name="DocumentSent" id="docSentYes" value="Yes" autocomplete="off">
                                        <label class="btn btn-outline-success px-3" for="docSentYes">Yes</label>
                                        <input type="radio" class="btn-check" name="DocumentSent" id="docSentNo" value="No" checked autocomplete="off">
                                        <label class="btn btn-outline-secondary px-3" for="docSentNo">No</label>
                                    </div>
                                </div>
                                <div id="docSentFields" style="display:none;">
                                    <div class="row g-2 mt-1">
                                        <div class="col-6">
                                            <label class="xsmall text-muted mb-1 d-block">Outward Number</label>
                                            <input type="text" class="form-control form-control-sm doc-sent-input" name="InitialOutwardNumber" placeholder="Outward No..." disabled />
                                        </div>
                                        <div class="col-6">
                                            <label class="xsmall text-muted mb-1 d-block">Outward Date</label>
                                            <input type="date" class="form-control form-control-sm doc-sent-input" name="InitialOutwardDate" disabled />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label mb-0 fw-800">objection verified and sent?</label>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <input type="radio" class="btn-check" name="ObjectionVerified" id="objYes" value="Yes" autocomplete="off">
                                        <label class="btn btn-outline-success px-3" for="objYes">Yes</label>
                                        <input type="radio" class="btn-check" name="ObjectionVerified" id="objNo" value="No" checked autocomplete="off">
                                        <label class="btn btn-outline-secondary px-3" for="objNo">No</label>
                                    </div>
                                </div>
                                <div id="objVerifiedFields" style="display:none;">
                                    <div class="row g-2 mt-1">
                                        <div class="col-6">
                                            <label class="xsmall text-muted mb-1 d-block">Number</label>
                                            <input type="text" class="form-control form-control-sm obj-verified-input" name="ObjectionOutwardNumber" placeholder="Number..." disabled />
                                        </div>
                                        <div class="col-6">
                                            <label class="xsmall text-muted mb-1 d-block">Objection Verified Date</label>
                                            <input type="date" class="form-control form-control-sm obj-verified-input" name="ObjectionFiledDate" disabled />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12"><hr class="my-2 opacity-10"></div>

                            <div class="col-md-4">
                                <label class="form-label">Evidence Filed?</label>
                                <div class="d-flex gap-3 mt-1">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="EvidenceFiled" id="evYes" value="Yes">
                                        <label class="form-check-label fw-bold" for="evYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="EvidenceFiled" id="evNo" value="No" checked>
                                        <label class="form-check-label fw-bold" for="evNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-warning">Current Stage</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-flag text-warning"></i>
                                    <input type="text" class="form-control border-warning" name="CaseStatus" placeholder="Current proceedings..." />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Next Hearing Date</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-clock-history"></i>
                                    <input type="date" class="form-control" name="NextDateOfHearing" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. Final Closure -->
                <div class="form-section-card border-danger-subtle bg-danger bg-opacity-10 border-dashed stagger-4">
                    <div class="p-4 border-bottom border-danger-subtle d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <span class="section-badge bg-danger text-white">SECTION 04</span>
                            <h6 class="fw-bold text-danger mb-0 ms-3 uppercase">4. DISPOSAL STATUS (INTERNAL ONLY)</h6>
                        </div>
                        <p class="text-danger small mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Terminal Action: Closing a case file is irreversible and locks all previous entries.</p>
                    </div>
                    <div class="p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label text-danger">Final Status</label>
                                <select class="form-select border-danger text-danger fw-bold" name="DisposalStatus">
                                    <option value="">-- Choose Status --</option>
                                    <option value="DISPOSED">DISPOSED / ಪರಿಹರಿಸಲಾಗಿದೆ</option>
                                    <option value="DNP">DNP / ಮುಂದುವರಿಸಲಾಗಿಲ್ಲ</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-danger">Judgement Result</label>
                                <select class="form-select border-danger text-danger fw-bold" name="Result">
                                    <option value="">Select Result...</option>
                                    <option value="FAVOR">FAVOR (ವಕಾಲತ್ತು ಪರ)</option>
                                    <option value="AGAINST">AGAINST (ವಕಾಲತ್ತು ವಿರುದ್ಧ)</option>
                                </select>
                            </div>
                        </div>

                        <div id="favorFields" style="display:none;" class="mt-4 pt-3 border-top bg-light bg-opacity-10 p-3 rounded-3">
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Disposal Remarks</label>
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-chat-dots"></i>
                                        <textarea class="form-control" name="ClosureRemark" rows="2" placeholder="Provide details about the favor..."></textarea>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Closure Date</label>
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-calendar-event"></i>
                                        <input type="date" class="form-control" name="ClosureDate" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-primary">Upload Judgment Copy</label>
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-file-earmark-arrow-up text-primary"></i>
                                        <input type="file" class="form-control border-primary" name="FinalJudgmentFile" accept=".pdf,.doc,.docx" />
                                    </div>
                                    <div class="xsmall text-muted mt-1"><i class="bi bi-info-circle me-1"></i>PDF or Word document only.</div>
                                </div>
                            </div>
                        </div>

                        <div id="againstFields" style="display:none;" class="mt-4 pt-3 border-top">
                            <div class="gov-card p-4 mb-4 shadow-sm border-0" id="evidenceSection" style="background-color: rgb(252, 252, 252);">
                                <div class="d-flex align-items-center mb-4 border-bottom pb-2">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-journal-text fs-5"></i>
                                    </div>
                                    <h4 class="mb-0 text-dark fw-bold">C. EVIDENCE DETAILS</h4>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-12 mb-4 border-bottom pb-4">
                                        <label class="form-label fw-bold d-block text-primary"><i class="bi bi-question-circle me-1"></i> Objection Filed?</label>
                                        <div class="d-flex gap-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="IsObjectionFiled" id="objFiledYes" value="Yes">
                                                <label class="form-check-label fw-bold" for="objFiledYes">Yes</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="IsObjectionFiled" id="objFiledNo" value="No" checked="">
                                                <label class="form-check-label fw-bold" for="objFiledNo">No</label>
                                            </div>
                                        </div>

                                        <!-- If NO then show Yes/No fields -->
                                        <div class="mt-3 p-3 bg-white rounded border border-warning" id="objNoFields" style="display:none;">
                                            <label class="form-label small fw-bold text-warning mb-2">If NO, then:</label>
                                            <div class="row g-3">
                                                <div class="col-md-12">
                                                    <label class="form-label small fw-bold">Objection Remarks</label>
                                                    <textarea class="form-control obj-no-remarks" name="ObjectionRemarks" rows="1" placeholder="Provide details for no objection..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="p-3 bg-white rounded border mb-3 shadow-sm">
                                            <label class="form-label fw-bold text-primary mb-3"><i class="bi bi-people me-1"></i> 1. Petitioner Evidence</label>
                                            <div id="respEvidenceList">
                                                <div class="row g-2 mb-2 resp-evidence-row align-items-center">
                                                    <div class="col-md-5">
                                                        <input type="text" class="form-control" name="RespondentEvidence[0].Name" placeholder="Petitioner Name(s)...">
                                                    </div>
                                                    <div class="col-md-5">
                                                        <input type="text" class="form-control" name="RespondentEvidence[0].Remark" placeholder="Remark...">
                                                    </div>
                                                    <div class="col-md-2 text-end">
                                                        <button type="button" class="btn btn-outline-primary add-resp-ev w-100"><i class="bi bi-plus-lg me-1"></i>Row</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="p-3 bg-white rounded border shadow-sm">
                                            <label class="form-label fw-bold text-primary mb-3"><i class="bi bi-building me-1"></i> 2. Corporation Evidence</label>
                                            <div id="corpEvidenceList">
                                                <div class="row g-2 mb-2 corp-evidence-row align-items-center">
                                                    <div class="col-md-5">
                                                        <input type="text" class="form-control" name="CorpEvidence[0].Name" placeholder="Corporation Witness Name...">
                                                    </div>
                                                    <div class="col-md-5">
                                                        <input type="text" class="form-control" name="CorpEvidence[0].Designation" placeholder="Designation...">
                                                    </div>
                                                    <div class="col-md-2 text-end">
                                                        <button type="button" class="btn btn-outline-primary add-corp-ev w-100"><i class="bi bi-plus-lg me-1"></i>Row</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="gov-card p-4 mb-4 shadow-sm border-0" id="ccDetailsSection" style="background-color: rgb(248, 253, 248);">
                                <div class="d-flex align-items-center mb-4 border-bottom pb-2">
                                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-file-earmark-check fs-5"></i>
                                    </div>
                                    <h4 class="mb-0 text-dark fw-bold">CERTIFIED COPY DETAILS</h4>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Copy Disposed On</label>
                                        <input type="date" class="form-control" name="CopyDisposedOn">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Copy Applied On</label>
                                        <input type="date" class="form-control" name="CopyAppliedOn">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Copy Ready On</label>
                                        <input type="date" class="form-control" name="CopyReadyOn">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Copy Delivered On</label>
                                        <input type="date" class="form-control" name="CopyDeliveredOn">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Copy Received at Division</label>
                                        <input type="date" class="form-control" name="CopyReceivedAtDivision">
                                    </div>
                                    <div class="col-md-12 mt-3">
                                        <label class="form-label small fw-bold">Certified Copy Remarks</label>
                                        <textarea class="form-control" name="CertifiedCopyRemarks" rows="2" placeholder="Enter notes regarding certified copies..."></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="gov-card p-4 mb-4 shadow-sm border-0" id="opinionSection" style="background-color: rgb(255, 252, 248);">
                                <div class="d-flex align-items-center mb-4 border-bottom pb-2">
                                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-shield-check fs-5"></i>
                                    </div>
                                    <h4 class="mb-0 text-dark fw-bold">I. OPINIONS & FINAL STATUS</h4>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label class="form-label fw-bold">Award Details</label>
                                        <textarea class="form-control" name="AwardDetails" rows="2" placeholder="Enter findings, award amount, or general context..."></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Advocate's Opinion</label>
                                        <textarea class="form-control" name="AdvocateOpinion" rows="2" placeholder="PROVIDE DETAILED LEGAL OPINION..."></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Law Officer's Opinion</label>
                                        <textarea class="form-control" name="LawOfficerOpinion" rows="2" placeholder="PROVIDE LO COMMENTS..."></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">DC's Final Decision</label>
                                        <textarea class="form-control" name="DCFinalDecision" rows="2" placeholder="PROVIDE DC REMARKS..."></textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Final Forwarding Status</label>
                                        <select class="form-select" name="FinalForwardingStatus">
                                            <option value="PENDING">PENDING</option>
                                            <option value="FORWARDED">FORWARDED</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Upload Final Judgment</label>
                                        <input type="file" class="form-control" name="FinalJudgmentFile">
                                    </div>

                                    <div class="col-md-12 mt-4">
                                        <div class="p-3 bg-white rounded border shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <label class="form-label fw-bold text-primary mb-0"><i class="bi bi-file-earmark-plus me-1"></i> Required Supporting Documents</label>
                                                <button type="button" class="btn btn-outline-primary btn-sm btn-add-enclosed-doc"><i class="bi bi-plus-lg me-1"></i>Add new document</button>
                                            </div>
                                            <div id="enclosedDocsList">
                                                <div class="row g-2 mb-2 doc-row align-items-center">
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" name="EnclosedDocuments[0].DocName" placeholder="Document Description...">
                                                    </div>
                                                    <div class="col-md-3">
                                                        <input type="number" class="form-control" name="EnclosedDocuments[0].PageCount" placeholder="Pages...">
                                                    </div>
                                                    <div class="col-md-1 text-end">
                                                        <i class="bi bi-check2-circle text-success fs-5"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-5 mb-5">
                    <button type="submit" class="btn-register">
                        <i class="bi bi-shield-check fs-4"></i> REGISTER ECA CASE FILE
                    </button>
                    <p class="small text-muted mt-3">Verifying information helps in accurate legal reporting.</p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Document Sent Radio Toggle
            $('input[name="DocumentSent"]').change(function() {
                if ($(this).val() === 'Yes') {
                    $('.doc-sent-input').prop('disabled', false);
                    $('#docSentFields').slideDown(300);
                } else {
                    $('#docSentFields').slideUp(300);
                    $('.doc-sent-input').prop('disabled', true).val('');
                }
            });

            // Objection Verified Radio Toggle
            $('input[name="ObjectionVerified"]').change(function() {
                if ($(this).val() === 'Yes') {
                    $('.obj-verified-input').prop('disabled', false);
                    $('#objVerifiedFields').slideDown(300);
                } else {
                    $('#objVerifiedFields').slideUp(300);
                    $('.obj-verified-input').prop('disabled', true).val('');
                }
            });

            // Dynamic Petitioner Management
            let petitionerIndex = 1;
            $(document).on('click', '.add-petitioner', function() {
                const row = `
                    <div class="row g-2 mb-2 petitioner-row align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="Petitioners[${petitionerIndex}].Name" placeholder="Petitioner Name..." />
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="Petitioners[${petitionerIndex}].Remark" placeholder="REMARKS..." />
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-danger remove-petitioner w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#petitionerList').append(row);
                petitionerIndex++;
            });

            $(document).on('click', '.remove-petitioner', function() {
                $(this).closest('.petitioner-row').remove();
                reindexPetitioners();
            });

            function reindexPetitioners() {
                petitionerIndex = 0;
                $('#petitionerList .petitioner-row').each(function() {
                    $(this).find('input[name*=".Name"]').attr('name', `Petitioners[${petitionerIndex}].Name`);
                    $(this).find('input[name*=".Remark"]').attr('name', `Petitioners[${petitionerIndex}].Remark`);
                    petitionerIndex++;
                });
            }

            // Vehicle Involvement Toggle
            $('#IsVehicleInvolved').change(function() {
                if ($(this).val() === 'yes') {
                    $('#vehicleTypeContainer').slideDown(300);
                } else {
                    $('#vehicleTypeContainer').slideUp(300);
                    $('#vehicleNumberContainer').slideUp(300);
                    $('#VehicleType').val('');
                    $('#VehicleNumber').val('');
                }
            });

            // Vehicle Type Mask/Pattern Update
            $('#VehicleType').change(function() {
                const type = $(this).val();
                if (type) {
                    $('#vehicleNumberContainer').slideDown(300);
                    if (type === 'Corporation') {
                        $('#VehicleNumber').attr('placeholder', 'KA-XX-F-XXXX');
                        $('#vehicleNumberHint').text('Pattern: KA-XX-F-XXXX');
                    } else {
                        $('#VehicleNumber').attr('placeholder', 'XX-XX-XX-XXXX');
                        $('#vehicleNumberHint').text('Pattern: XX-XX-XX-XXXX');
                    }
                } else {
                    $('#vehicleNumberContainer').slideUp(300);
                }
            });

            // Judgement Result Toggle
            $('select[name="Result"]').change(function() {
                const val = $(this).val();
                if (val === 'FAVOR') {
                    $('#favorFields').slideDown(300);
                    $('#againstFields').slideUp(300);
                } else if (val === 'AGAINST') {
                    $('#againstFields').slideDown(300);
                    $('#favorFields').slideUp(300);
                } else {
                    $('#favorFields').slideUp(300);
                    $('#againstFields').slideUp(300);
                    $('#favorFields, #againstFields').find('input, textarea').val('');
                }
            });

            // Objection Filed Toggle
            $('input[name="IsObjectionFiled"]').change(function() {
                if ($(this).val() === 'No') {
                    $('#objNoFields').slideDown(300);
                } else {
                    $('#objNoFields').slideUp(300);
                    $('#objNoFields').find('textarea').val('');
                }
            });

            // Dynamic Respondent Evidence
            let respEvIndex = 1;
            $(document).on('click', '.add-resp-ev', function() {
                const row = `
                    <div class="row g-2 mb-2 resp-evidence-row align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="RespondentEvidence[${respEvIndex}].Name" placeholder="Petitioner Name(s)...">
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="RespondentEvidence[${respEvIndex}].Remark" placeholder="Remark...">
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-danger remove-resp-ev w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#respEvidenceList').append(row);
                respEvIndex++;
            });

            $(document).on('click', '.remove-resp-ev', function() {
                $(this).closest('.resp-evidence-row').remove();
                reindexRespEvidence();
            });

            function reindexRespEvidence() {
                let idx = 0;
                $('#respEvidenceList .resp-evidence-row').each(function() {
                    $(this).find('input[name*=".Name"]').attr('name', `RespondentEvidence[${idx}].Name`);
                    $(this).find('input[name*=".Remark"]').attr('name', `RespondentEvidence[${idx}].Remark`);
                    idx++;
                });
                respEvIndex = idx;
            }

            // Dynamic Corp Evidence
            let corpEvIndex = 1;
            $(document).on('click', '.add-corp-ev', function() {
                const row = `
                    <div class="row g-2 mb-2 corp-evidence-row align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="CorpEvidence[${corpEvIndex}].Name" placeholder="Corporation Witness Name...">
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control" name="CorpEvidence[${corpEvIndex}].Designation" placeholder="Designation...">
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-danger remove-corp-ev w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#corpEvidenceList').append(row);
                corpEvIndex++;
            });

            $(document).on('click', '.remove-corp-ev', function() {
                $(this).closest('.corp-evidence-row').remove();
                reindexCorpEvidence();
            });

            function reindexCorpEvidence() {
                let idx = 0;
                $('#corpEvidenceList .corp-evidence-row').each(function() {
                    $(this).find('input[name*=".Name"]').attr('name', `CorpEvidence[${idx}].Name`);
                    $(this).find('input[name*=".Designation"]').attr('name', `CorpEvidence[${idx}].Designation`);
                    idx++;
                });
                corpEvIndex = idx;
            }

            // Dynamic Supporting Documents
            let docIndex = 1;
            $(document).on('click', '.btn-add-enclosed-doc', function() {
                const row = `
                    <div class="row g-2 mb-2 doc-row align-items-center">
                        <div class="col-md-8">
                            <input type="text" class="form-control" name="EnclosedDocuments[${docIndex}].DocName" placeholder="Document Description...">
                        </div>
                        <div class="col-md-3">
                            <input type="number" class="form-control" name="EnclosedDocuments[${docIndex}].PageCount" placeholder="Pages...">
                        </div>
                        <div class="col-md-1 text-end">
                            <button type="button" class="btn btn-outline-danger remove-doc-row w-100"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>`;
                $('#enclosedDocsList').append(row);
                docIndex++;
            });

            $(document).on('click', '.remove-doc-row', function() {
                $(this).closest('.doc-row').remove();
                reindexDocs();
            });

            function reindexDocs() {
                let idx = 0;
                $('#enclosedDocsList .doc-row').each(function() {
                    $(this).find('input[name*=".DocName"]').attr('name', `EnclosedDocuments[${idx}].DocName`);
                    $(this).find('input[name*=".PageCount"]').attr('name', `EnclosedDocuments[${idx}].PageCount`);
                    idx++;
                });
                docIndex = idx;
            }
        });
    </script>
}
