@model MVCCaseManagement.Models.AppealViewModel

@{
    ViewData["Title"] = "Manage Claimant Appeal - " + Model.MVCNo;
    ViewData["HidePageHeader"] = true;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">Claimant Appeal Details</h2>
            <p class="text-muted">Case: @(string.IsNullOrEmpty(Model.MVCNo) ? "N/A" : Model.MVCNo + " / " + Model.MVCYear) | Division: @Model.DivisionName (MACT: @Model.MACTName)</p>
        </div>
        <a asp-action="ClaimantList" class="btn btn-outline-secondary">Back to Registry</a>
    </div>

    <form asp-action="SaveClaimant" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CaseID" />
        <input type="hidden" asp-for="MVCNo" />
        <input type="hidden" asp-for="DivisionName" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white"><h6 class="mb-0 fw-bold">Appeal Filed by Claimant / Petitioner</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Division Name</label>
                        <select class="form-select" asp-for="ClaimantDivisionID" asp-items="@(new SelectList(ViewBag.Divisions, "DivisionID", "DivisionNameEnglish"))">
                            <option value="">Select Division</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tribunal</label>
                        <input type="text" class="form-control" value="MACT" readonly />
                    </div>
                    
                    <div class="col-12"><hr class="my-2"/></div>
                    <div class="col-12"><label class="fw-bold text-primary">Arising out of MVC Record:</label></div>
                    
                    <div class="col-md-4">
                        <label class="form-label">MVC Number</label>
                        <input type="text" class="form-control" asp-for="ClaimantMVCNumber" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">MVC Year</label>
                        <input type="number" class="form-control" asp-for="ClaimantMVCYear" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Current Status of MVC</label>
                        <input type="text" class="form-control bg-light" asp-for="ClaimantMVCCurrentStatus" readonly />
                    </div>
                    
                    <div class="col-12"><hr class="my-3"/></div>
                    <div class="col-12"><label class="fw-bold text-primary">MFA (High Court) Details:</label></div>

                    <div class="col-md-5">
                        <label class="form-label fw-bold">MFA Number</label>
                        <input type="text" class="form-control" asp-for="ClaimantMFANumber" id="txtClaimantMFANo" placeholder="e.g. 100298" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Year</label>
                        <input type="number" class="form-control" asp-for="ClaimantMFAYear" id="txtClaimantMFAYear" placeholder="2019" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-info w-100 fw-bold" id="btnSyncEcourtsClaimant" onclick="syncClaimantECourts()">
                            <i class="bi bi-cloud-arrow-down-fill me-1"></i> e-Courts Sync
                        </button>
                    </div>

                    <!-- Direct CNR Entry -->
                    <div class="col-12 mt-1">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-info text-white fw-bold">
                                <i class="bi bi-upc-scan me-1"></i> Direct CNR
                            </span>
                            <input type="text" class="form-control font-monospace fw-bold text-uppercase" id="directClaimantCnrInput"
                                   name="ClaimantMFACNRNumber"
                                   asp-for="ClaimantMFACNRNumber"
                                   placeholder="e.g. KAHC020060752019 (Enter CNR to sync directly)"
                                   maxlength="20" />
                            <button class="btn btn-info text-white fw-bold btn-sm" type="button" onclick="syncClaimantECourts()">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Direct Sync
                            </button>
                        </div>
                    </div>

                    <!-- Live e-Courts Status Card -->
                    <div class="col-12 mt-2" id="claimantEcourtsCard" style="@(string.IsNullOrEmpty(Model?.ClaimantMFACNRNumber) ? "display:none;" : "")">
                        <div class="card border-info border-start border-4 bg-light shadow-sm">
                            <div class="card-body py-2 px-3">
                                <h6 class="text-info fw-bold mb-1"><i class="bi bi-wifi me-1"></i> e-Courts Live Data</h6>
                                <div class="row text-sm">
                                    <div class="col-md-3"><strong>CNR:</strong> <span id="lblClaimantCNR" class="font-monospace text-primary fw-bold">@(Model?.ClaimantMFACNRNumber ?? "—")</span></div>
                                    <div class="col-md-3"><strong>Next Hearing:</strong> <span id="lblClaimantNextHearing" class="fw-bold">—</span></div>
                                    <div class="col-md-3"><strong>Stage:</strong> <span id="lblClaimantStage" class="badge bg-info text-dark">—</span></div>
                                    <div class="col-md-3"><strong>Status:</strong> <span class="badge bg-success">Verified</span></div>

                                    <!-- Expand Button for Full Dossier -->
                                    <div class="col-12 mt-2 pt-2 border-top">
                                        <button class="btn btn-sm btn-info text-white w-100 fw-bold shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#claimantFullDossier">
                                            <i class="bi bi-journal-richtext me-1"></i> View Full e-Courts Dossier — History (<span id="claimantCountHistory">0</span>), Orders & Judgments (<span id="claimantCountOrders">0</span>)
                                        </button>
                                    </div>
                                </div>

                                <!-- Collapsible Full Dossier Tabs -->
                                <div class="collapse mt-3" id="claimantFullDossier">
                                    <div class="card card-body bg-white border shadow-sm p-3">
                                        <ul class="nav nav-tabs nav-fill mb-3" role="tablist">
                                            <li class="nav-item">
                                                <button type="button" class="nav-link active fw-bold small" data-bs-toggle="tab" data-bs-target="#claimantTabHistory">
                                                    <i class="bi bi-clock-history me-1 text-primary"></i> Hearing History (<span id="claimantTabCountHistory">0</span>)
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button type="button" class="nav-link fw-bold small" data-bs-toggle="tab" data-bs-target="#claimantTabOrders">
                                                    <i class="bi bi-file-earmark-pdf me-1 text-danger"></i> Orders & Judgments (<span id="claimantTabCountOrders">0</span>)
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button type="button" class="nav-link fw-bold small" data-bs-toggle="tab" data-bs-target="#claimantTabParties">
                                                    <i class="bi bi-info-circle me-1 text-info"></i> Full Case Details
                                                </button>
                                            </li>
                                        </ul>

                                        <div class="tab-content">
                                            <!-- 1. Hearing History Tab -->
                                            <div class="tab-pane fade show active" id="claimantTabHistory">
                                                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                                    <table class="table table-sm table-hover align-middle extra-small border mb-0">
                                                        <thead class="bg-light sticky-top">
                                                            <tr>
                                                                <th>#</th>
                                                                <th>Hearing Date</th>
                                                                <th>Purpose / Stage</th>
                                                                <th>Bench / Judge</th>
                                                                <th>Business On Date / Remarks</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="claimantTbodyHistory">
                                                            <tr><td colspan="5" class="text-center text-muted py-3">No hearing history loaded. Click Direct Sync.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 2. Orders & Judgments Tab -->
                                            <div class="tab-pane fade" id="claimantTabOrders">
                                                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                                    <table class="table table-sm table-hover align-middle extra-small border mb-0">
                                                        <thead class="bg-light sticky-top">
                                                            <tr>
                                                                <th>#</th>
                                                                <th>Order Date</th>
                                                                <th>Order Type / Details</th>
                                                                <th>Bench / Judge</th>
                                                                <th>Action / PDF</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="claimantTbodyOrders">
                                                            <tr><td colspan="5" class="text-center text-muted py-3">No orders/judgments loaded. Click Direct Sync.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 3. Full Case Details Tab -->
                                            <div class="tab-pane fade" id="claimantTabParties">
                                                <div class="row g-2 extra-small">
                                                    <div class="col-md-6 border-bottom pb-1"><strong>Petitioner(s):</strong> <span id="claimantFullPetitioner" class="text-dark fw-bold">—</span></div>
                                                    <div class="col-md-6 border-bottom pb-1"><strong>Respondent(s):</strong> <span id="claimantFullRespondent" class="text-dark fw-bold">—</span></div>
                                                    <div class="col-md-6 border-bottom pb-1"><strong>Petitioner Advocate:</strong> <span id="claimantFullPetAdv">—</span></div>
                                                    <div class="col-md-6 border-bottom pb-1"><strong>Respondent Advocate:</strong> <span id="claimantFullResAdv">—</span></div>
                                                    <div class="col-md-4"><strong>Filing Date:</strong> <span id="claimantFullFilingDate">—</span></div>
                                                    <div class="col-md-4"><strong>Registration Date:</strong> <span id="claimantFullRegDate">—</span></div>
                                                    <div class="col-md-4"><strong>Disposal Date:</strong> <span id="claimantFullDisposalDate">—</span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Initial Action taken by Corporation</label>
                        <select class="form-select" asp-for="InitialAction" id="initialAction">
                            <option>Select...</option>
                            <option>Pending for Decision</option>
                            <option>Pending before Competent Authority</option>
                            <option>Appeal</option>
                            <option>Close</option>
                        </select>
                    </div>
                    <div class="col-md-6" id="initialRemarksSection" style="display:none;">
                        <label class="form-label small fw-bold">Initial Action Remarks</label>
                        <input type="text" class="form-control" asp-for="InitialActionRemarks" placeholder="Enter remarks..." />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Initial Action Documents (Max 2)</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="file" class="form-control" asp-for="InitialActionFile1" />
                                @if (!string.IsNullOrEmpty(Model.InitialActionPath1))
                                {
                                    <a href="@Model.InitialActionPath1" target="_blank" class="small text-decoration-none mt-1 d-block"><i class="bi bi-file-earmark-pdf text-danger"></i> View Document 1</a>
                                }
                            </div>
                            <div class="col-md-6">
                                <input type="file" class="form-control" asp-for="InitialActionFile2" />
                                @if (!string.IsNullOrEmpty(Model.InitialActionPath2))
                                {
                                    <a href="@Model.InitialActionPath2" target="_blank" class="small text-decoration-none mt-1 d-block"><i class="bi bi-file-earmark-pdf text-danger"></i> View Document 2</a>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-2"/></div>

                    <div class="col-md-4">
                        <label class="form-label">High Court Bench</label>
                        <select class="form-select" asp-for="HighCourtBench" id="highCourtBench">
                            <option value="">Select Bench...</option>
                            <option>Dharwad</option>
                            <option>Kalaburagi</option>
                            <option>Bangalore</option>
                            <option>Others</option>
                        </select>
                        <input type="text" class="form-control mt-2" asp-for="OtherHighCourtBench" id="otherBenchInput" placeholder="Enter Bench Name" style="display:none;" />
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label">Entrustment Number</label>
                        <input type="text" class="form-control" asp-for="ClaimantMFAEntrustmentNo" /> 
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Entrustment Date</label>
                        <input type="date" class="form-control" asp-for="ClaimantMFAEntrustmentDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Advocate Name</label>
                        <select class="form-select" asp-for="ClaimantMFAAdvocate">
                            <option value="">Select Advocate...</option>
                            @if(ViewBag.HCAdvocates != null)
                            {
                                foreach(var adv in (IEnumerable<MVCCaseManagement.Models.HighCourtAdvocate>)ViewBag.HCAdvocates)
                                {
                                    <option value="@adv.AdvocateName">@adv.AdvocateName (@adv.Bench)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status of MFA</label>
                        <select class="form-select" asp-for="ClaimantMFAStatus" id="claimantMFAStatus">
                            <option>Pending</option>
                            <option>Disposed</option>
                            <option>DNP</option>
                        </select>
                    </div>

                    <div class="col-12" id="claimantOutcomeMainSection" style="display:none;">
                        <hr class="my-3"/>
                        <div class="bg-light p-3 rounded shadow-sm border">
                            <label class="fw-bold mb-3 d-block">Outcome & Decision:</label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nature of Decision</label>
                                    <select class="form-select" asp-for="ClaimantMFADecision">
                                        <option value="">Select...</option>
                                        <option>In Favour of Corporation</option>
                                        <option>Against Corporation</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Decision Taken / Action</label>
                                    <select class="form-select" asp-for="ClaimantActionTaken" id="claimantActionTaken">
                                        <option value="">Select...</option>
                                        <option>Pending for Decision</option>
                                        <option>Pending before Competent Authority</option>
                                        <option>Appeal</option>
                                        <option>Close</option>
                                    </select>
                                </div>
                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small">Award / Judgment Details (Remark)</label>
                                    <textarea class="form-control" asp-for="ClaimantMFARemarks" rows="3" placeholder="Enter details of the judgment or award..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12" id="claimantClosureSection" style="display:none;">
                        <div class="bg-warning bg-opacity-10 p-3 rounded border border-warning border-opacity-25 mt-2 shadow-sm">
                            <h6 class="small fw-bold text-dark"><i class="bi bi-info-circle me-1"></i> Closure Approval</h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small">Approval Outward Number</label>
                                    <input type="text" class="form-control" asp-for="ClaimantApprovalNo" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Approval Date</label>
                                    <input type="date" class="form-control" asp-for="ClaimantApprovalDate" />
                                </div>
                                <div class="col-md-12 mt-2">
                                    <label class="form-label small fw-bold">Upload Approval Copy (PDF/IMG)</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="file" class="form-control form-control-sm" asp-for="ApprovalCopyFile" />
                                        @if (!string.IsNullOrEmpty(Model.ApprovalCopyPath))
                                        {
                                            <a href="@Model.ApprovalCopyPath" target="_blank" class="btn btn-sm btn-outline-danger text-nowrap">
                                                <i class="bi bi-file-earmark-pdf"></i> View Saved Copy
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>




        <div id="divSCAppealCard" style="display:none;">
            <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Supreme Court Appeal (If Any)</h6>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" asp-for="IsClaimantSCAppeal" id="chkSCAppeal">
                    <label class="form-check-label text-white small" for="chkSCAppeal">Active</label>
                </div>
            </div>
            <div class="card-body" id="scAppealSection" style="display:none;">
                 <div class="form-check mb-3" id="scPendingContainer">
                     <input class="form-check-input" type="checkbox" asp-for="IsClaimantSCPending" id="chkSCPending">
                     <label class="form-check-label fw-bold text-muted small" for="chkSCPending">
                         Pending for Filing (No SC Appeal Number yet)
                     </label>
                </div>

                <div class="row g-3">
                    <div class="col-12" id="scFilingDetails">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Diary Number</label>
                                <input type="text" class="form-control" asp-for="ClaimantSCDiaryNumber" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Diary Year</label>
                                <input type="number" class="form-control" asp-for="ClaimantSCYear" />
                            </div>
                            <div class="col-md-4" id="divClaimantSCNumber">
                                <label class="form-label">SLP[C] Number</label>
                                <input type="text" class="form-control" asp-for="ClaimantSCNumber" />
                            </div>
                            <div class="col-md-4" id="divClaimantSLPYear">
                                <label class="form-label">SLP[C] Year</label>
                                <input type="number" class="form-control" asp-for="ClaimantSLPYear" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Filed By</label>
                                <select class="form-select" asp-for="ClaimantSCFiledBy">
                                    <option value="">Select...</option>
                                    <option>Corporation</option>
                                    <option>Claimant</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Entrustment Number</label>
                                <input type="text" class="form-control" asp-for="ClaimantSCEntrustmentNo" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label">Entrustment Date</label>
                        <input type="date" class="form-control" asp-for="ClaimantSCEntrustmentDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Advocate Name</label>
                        <input type="text" class="form-control" asp-for="ClaimantSCAdvocate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select class="form-select" asp-for="ClaimantSCStatus" id="claimantSCStatus">
                            <option>Pending</option>
                            <option>Disposed</option>
                        </select>
                    </div>

                    <!-- SC Outcome Section -->
                    <div class="col-12" id="scOutcomeSection" style="display:none;">
                        <hr class="my-3"/>
                        <div class="bg-light p-3 rounded shadow-sm border">
                            <label class="fw-bold mb-3 d-block">Supreme Court Outcome:</label>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Outcome</label>
                                    <select class="form-select" asp-for="ClaimantSCOutcome">
                                        <option value="">Select...</option>
                                        <option>In Favour of Corporation</option>
                                        <option>Against Corporation</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Decision Taken / Action</label>
                                    <select class="form-select" asp-for="ClaimantSCActionTaken" id="claimantSCActionTaken">
                                        <option value="">Select...</option>
                                        <option>Pending for Decision</option>
                                        <option>Pending before Competent Authority</option>
                                        <option>Appeal</option>
                                        <option>Close</option>
                                    </select>
                                </div>
                                <div class="col-md-4" id="scClosureSection" style="display:none;">
                                    <div class="p-2 border rounded bg-white shadow-sm">
                                        <label class="fw-bold small d-block mb-1">Closure Details</label>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <input type="text" class="form-control form-control-sm" asp-for="ClaimantSCClosureNo" placeholder="Order No" />
                                            </div>
                                            <div class="col-6">
                                                <input type="date" class="form-control form-control-sm" asp-for="ClaimantSCClosureDate" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary btn-lg px-5 shadow"><i class="bi bi-check2-circle me-1"></i> Update Claimant Appeal</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function toggleClaimantOutcome() {
                const status = $("#claimantMFAStatus").val();
                if (status === "Pending") {
                    $("#claimantOutcomeMainSection").slideUp(300);
                } else {
                    $("#claimantOutcomeMainSection").slideDown(300);
                }
            }

            function toggleClaimantClosure() {
                const action = $("#claimantActionTaken").val();
                if (action === "Close") {
                    $("#claimantClosureSection").slideDown(300);
                } else {
                    $("#claimantClosureSection").slideUp(300);
                }

                if (action === "Appeal") {
                    $("#divSCAppealCard").slideDown(300);
                    // Also auto-check the active switch if not checked
                    if (!$("#chkSCAppeal").is(":checked")) {
                        $("#chkSCAppeal").prop('checked', true).trigger('change');
                    }
                } else {
                    $("#divSCAppealCard").slideUp(300);
                }
            }

            function toggleSCSection() {
                if($("#chkSCAppeal").is(":checked")) {
                    $("#scAppealSection").slideDown(300);
                } else {
                    $("#scAppealSection").slideUp(300);
                }
            }

            function toggleSCPending() {
                const isPending = $("#chkSCPending").is(":checked");
                const diaryNum = $("#ClaimantSCDiaryNumber").val();
                const diaryYear = $("#ClaimantSCYear").val();
                const slpNum = $("#ClaimantSCNumber").val();

                if (isPending) {
                    $("#divClaimantSCNumber").hide();
                    $("#divClaimantSLPYear").hide();
                    $("#scPendingContainer").show();
                } else {
                    $("#divClaimantSCNumber").show();
                    $("#divClaimantSLPYear").show();
                    if ((diaryNum && diaryYear) || slpNum) {
                        $("#scPendingContainer").hide();
                    } else {
                        $("#scPendingContainer").show();
                    }
                }
            }

            function toggleSCOutcome() {
                const status = $("#claimantSCStatus").val();
                if (status === "Disposed") {
                    $("#scOutcomeSection").slideDown(300);
                } else {
                    $("#scOutcomeSection").slideUp(300);
                }
            }

            function toggleSCClosure() {
                const action = $("#claimantSCActionTaken").val();
                if (action === "Close") {
                    $("#scClosureSection").slideDown(300);
                } else {
                    $("#scClosureSection").slideUp(300);
                }
            }

            function toggleInitialAction() {
                const action = $("#initialAction").val();
                if (action === "Pending for Decision") {
                    $("#initialRemarksSection").slideDown(300);
                } else {
                    $("#initialRemarksSection").slideUp(300);
                }
            }

            function toggleBench() {
                if ($("#highCourtBench").val() === "Others") {
                    $("#otherBenchInput").slideDown(300);
                } else {
                    $("#otherBenchInput").slideUp(300);
                }
            }



            $("#claimantMFAStatus").change(toggleClaimantOutcome);
            $("#claimantActionTaken").change(toggleClaimantClosure);
            $("#chkSCAppeal").change(toggleSCSection);
            $("#chkSCPending").change(toggleSCPending);
            $("#claimantSCStatus").change(toggleSCOutcome);
            $("#claimantSCActionTaken").change(toggleSCClosure);
            $("#initialAction").change(toggleInitialAction);
            $("#highCourtBench").change(toggleBench);

            
            // Real-time input listeners
            $("#ClaimantSCDiaryNumber, #ClaimantSCYear, #ClaimantSCNumber").on("input", toggleSCPending);

            // Initial state
            toggleClaimantOutcome();
            toggleClaimantClosure();
            toggleSCSection();
            toggleSCPending();
            toggleSCOutcome();
            toggleSCClosure();
            toggleInitialAction();
            toggleBench();

        });

        window.syncClaimantECourts = function(isAuto) {
            const directCnr = $("#directClaimantCnrInput").val() ? $("#directClaimantCnrInput").val().trim().toUpperCase() : "";
            const mfaNo = $("#txtClaimantMFANo").val() ? $("#txtClaimantMFANo").val().trim() : "";
            const mfaYear = $("#txtClaimantMFAYear").val() ? $("#txtClaimantMFAYear").val().trim() : "";
            const bench = $("#highCourtBench").val() || "Dharwad";

            let estCode = "KAHC02";
            if (bench.indexOf("Kalaburagi") !== -1 || bench.indexOf("Gulbarga") !== -1) estCode = "KAHC03";
            else if (bench.indexOf("Bangalore") !== -1 || bench.indexOf("Bengaluru") !== -1) estCode = "KAHC01";

            const btn = $("#btnSyncEcourtsClaimant");
            if (!isAuto) btn.prop("disabled", true).html('<i class="bi bi-hourglass-split me-1"></i> Fetching...');

            if (directCnr && directCnr.length >= 12) {
                $("#ClaimantMFACNRNumber").val(directCnr);
                fetchCnrDetails(directCnr);
                return;
            }

            if (!mfaNo || !mfaYear) {
                if (!isAuto) alert("Please enter Claimant MFA Number and Year (or direct CNR Number).");
                if (!isAuto) btn.prop("disabled", false).html('<i class="bi bi-cloud-arrow-down-fill me-1"></i> e-Courts Sync');
                return;
            }

            $.get(`/ECourts/AutoDiscoverCNR?estCode=${estCode}&caseType=MFA&regNo=${mfaNo}&regYear=${mfaYear}&isHighCourt=true`)
                .done(function(res) {
                    if (res && res.success && res.cnr) {
                        const foundCnr = res.cnr;
                        $("#ClaimantMFACNRNumber").val(foundCnr);
                        $("#directClaimantCnrInput").val(foundCnr);
                        fetchCnrDetails(foundCnr);
                    } else {
                        if (!isAuto) alert(res && res.message ? res.message : "MFA case not found in e-Courts High Court portal.");
                        if (!isAuto) btn.prop("disabled", false).html('<i class="bi bi-cloud-arrow-down-fill me-1"></i> e-Courts Sync');
                    }
                })
                .fail(function() {
                    if (!isAuto) alert("Failed to connect to e-Courts live gateway.");
                    if (!isAuto) btn.prop("disabled", false).html('<i class="bi bi-cloud-arrow-down-fill me-1"></i> e-Courts Sync');
                });

            function fetchCnrDetails(cnr) {
                $.get(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=true`)
                    .done(function(res) {
                        if (res && res.success) {
                            const d = res.data || {};
                            $("#lblClaimantCNR").text(cnr);
                            $("#lblClaimantNextHearing").text(d.next_hearing_date || d.next_hearing || "—");
                            $("#lblClaimantStage").text(d.stage || d.case_status || d.status || "—");

                            // Render History
                            const history = res.history || [];
                            $("#claimantCountHistory").text(history.length);
                            $("#claimantTabCountHistory").text(history.length);
                            if (history.length === 0) {
                                $("#claimantTbodyHistory").html('<tr><td colspan="5" class="text-center text-muted py-3">No hearing history returned by e-Courts gateway.</td></tr>');
                            } else {
                                let hHtml = '';
                                history.forEach(function(item, idx) {
                                    const dt = item.business_date || item.hearing_date || item.date || item.srno_date || item.next_date || '—';
                                    const purpose = item.purpose_name || item.stage || item.next_purpose || item.purposeName || '—';
                                    const judge = item.judge || item.desgname || item.judge_name || item.court_no_judge || '—';
                                    const business = item.business || item.remarks || item.court_business || item.cause_remarks || item.business_details || '—';
                                    hHtml += `<tr>
                                        <td>${idx + 1}</td>
                                        <td class="fw-bold text-dark">${dt}</td>
                                        <td><span class="badge bg-light text-primary border">${purpose}</span></td>
                                        <td>${judge}</td>
                                        <td class="fst-italic text-secondary">${business}</td>
                                    </tr>`;
                                });
                                $("#claimantTbodyHistory").html(hHtml);
                            }

                            // Render Orders & Judgments
                            const orders = res.orders || [];
                            $("#claimantCountOrders").text(orders.length);
                            $("#claimantTabCountOrders").text(orders.length);
                            if (orders.length === 0) {
                                $("#claimantTbodyOrders").html('<tr><td colspan="5" class="text-center text-muted py-3">No orders/judgments returned by e-Courts gateway.</td></tr>');
                            } else {
                                let oHtml = '';
                                orders.forEach(function(item, idx) {
                                    const dt = item.order_date || item.orderDate || item.date || item.decision_date || '—';
                                    const type = item.order_type || item.order_number || item.title || item.order_details || item.order_no || 'Order / Judgment';
                                    const judge = item.judge || item.desgname || item.judge_name || '—';
                                    const pdfUrl = item.pdf_path || item.pdf_url || item.display_pdf_url || item.order_pdf || item.order_link || item.link || item.pdf || item.order_copy || '';

                                    let actionBtn = `<a href="/ECourts/ViewOrderPdf?cnr=${encodeURIComponent(cnr)}&title=${encodeURIComponent(type)}&date=${encodeURIComponent(dt)}" target="_blank" class="btn btn-xs btn-outline-danger py-0 px-2 fw-bold"><i class="bi bi-file-pdf-fill me-1"></i> View Order PDF</a>`;
                                    if (pdfUrl) {
                                        let targetUrl = pdfUrl;
                                        if (!pdfUrl.startsWith('/ECourts/ViewOrderPdf')) {
                                            targetUrl = `/ECourts/ViewOrderPdf?url=${encodeURIComponent(pdfUrl)}&cnr=${encodeURIComponent(cnr)}&title=${encodeURIComponent(type)}&date=${encodeURIComponent(dt)}`;
                                        }
                                        actionBtn = `<a href="${targetUrl}" target="_blank" class="btn btn-xs btn-danger py-0 px-2 fw-bold text-white shadow-sm"><i class="bi bi-file-pdf-fill me-1"></i> Open Order PDF</a>`;
                                    }

                                    oHtml += `<tr>
                                        <td>${idx + 1}</td>
                                        <td class="fw-bold text-dark">${dt}</td>
                                        <td><strong class="text-dark">${type}</strong></td>
                                        <td>${judge}</td>
                                        <td>${actionBtn}</td>
                                    </tr>`;
                                });
                                $("#claimantTbodyOrders").html(oHtml);
                            }

                            // Render Full Case Details
                            $("#claimantFullPetitioner").text(d.petitioner || '—');
                            $("#claimantFullRespondent").text(d.respondent || '—');
                            $("#claimantFullPetAdv").text(d.petitioner_advocate || d.pet_adv || '—');
                            $("#claimantFullResAdv").text(d.respondent_advocate || d.res_adv || '—');
                            $("#claimantFullFilingDate").text(d.filing_date || d.date_of_filing || '—');
                            $("#claimantFullRegDate").text(d.dt_regis || d.registration_date || '—');
                            $("#claimantFullDisposalDate").text(d.date_of_decision || d.disposal_date || '—');

                            $("#claimantEcourtsCard").slideDown(300);
                            if (!isAuto) alert("Claimant MFA e-Courts data & full dossier fetched successfully!");
                        } else {
                            $("#lblClaimantCNR").text(cnr);
                            $("#claimantEcourtsCard").slideDown(300);
                            if (!isAuto) alert("CNR " + cnr + " linked with appeal.");
                        }
                    })
                    .always(function() {
                        if (!isAuto) btn.prop("disabled", false).html('<i class="bi bi-cloud-arrow-down-fill me-1"></i> e-Courts Sync');
                    });
            }
        };

        // Auto-run on load if CNR or MFA No exists
        $(document).ready(function() {
            setTimeout(function() {
                if ($("#directClaimantCnrInput").val() || $("#txtClaimantMFANo").val()) {
                    window.syncClaimantECourts(true);
                }
            }, 300);
        });
    </script>
}
