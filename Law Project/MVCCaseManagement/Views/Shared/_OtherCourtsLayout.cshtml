<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NWKRTC</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="~/css/cdn.css" rel="stylesheet" />
    <link href="~/css/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        :root {
            --nav-bg: rgba(255, 255, 255, 0.98);
            --court-primary: #3D45AA; /* Primary Deep Blue */
            --court-hover: #2D3380;   
            --primary-brand: #3D45AA;
            --primary-dark: #1D2255;
            --accent-vibrant: #4C51BF; 
            --accent-soft: #E8DBB3;    /* Muted Gold/Tan */
            --bg-page: #f0f2ff;        /* Light Blue-Gray Background */
            --glass-bg: rgba(240, 242, 255, 0.95);
            --card-bg: #ffffff;
            --label-color: #1a202c;
        }

        body {
            background: radial-gradient(circle at top right, #f0f2ff 0%, #e0e7ff 100%);
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            color: #333;
        }
        
        /* Official Header Branding */
        .branding-header {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.5rem 2rem;
            display: flex;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .branding-logo {
            height: 48px;
            width: auto;
            margin-right: 1.25rem;
            padding-right: 1.25rem;
            border-right: 2px solid #e2e8f0;
        }

        .branding-text h1 {
            font-size: 1.1rem;
            font-weight: 800;
            margin: 0;
            color: #0f172a;
            font-family: 'Outfit', sans-serif;
        }

        .branding-text .kannada {
            font-size: 0.9rem;
            color: #475569;
            font-weight: 600;
        }

        .user-profile-badge {
            background: #f1f5f9;
            color: #0f172a;
            padding: 0.35rem 1rem;
            border-radius: 2rem;
            font-weight: 600;
            font-size: 0.85rem;
            border: 1px solid #e2e8f0;
        }

        .logout-btn {
            background: #fff0f2;
            color: #e11d48;
            padding: 0.35rem 1rem;
            border-radius: 2rem;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            border: 1px solid #ffe4e6;
            margin-left: 10px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: #e11d48;
            color: white;
        }

        /* Sub-Header Navigation Bar */
        .court-nav-bar {
            background: var(--nav-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.4);
            padding: 0 2rem;
            display: flex;
            align-items: center;
            box-shadow: 0 10px 20px -10px rgba(0,0,0,0.08);
            position: relative;
            z-index: 99;
        }

        .court-nav-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            width: 100%;
        }

        .court-nav-item {
            position: relative;
        }

        .court-nav-link {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 1.25rem 1.5rem;
            color: #475569;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            position: relative;
        }

        .court-nav-link i {
            font-size: 1.2rem;
            opacity: 0.8;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .court-nav-link:hover, .court-nav-link.active {
            color: var(--court-primary);
            background: linear-gradient(to top, rgba(56, 82, 180, 0.05), transparent);
        }

        .court-nav-link:hover i, .court-nav-link.active i {
            transform: scale(1.15) translateY(-2px);
            opacity: 1;
        }

        .court-nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--court-primary);
            border-radius: 4px 4px 0 0;
            transform: scaleX(0);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform-origin: bottom right;
        }

        .court-nav-link:hover::after {
            transform: scaleX(1);
            transform-origin: bottom left;
        }

        .court-nav-link.active::after {
            transform: scaleX(1);
        }

        /* Home link special treatment */
        .home-link {
            color: #0f172a;
            border-right: 1px solid #e2e8f0;
            margin-right: 0.5rem;
        }

        /* Main Setup */
        .system-canvas {
            flex-grow: 1;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 0.5rem 2rem 2rem 2rem;
            position: relative;
            overflow: hidden;
        }

        /* Abstract Backdrops */
        .glow-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            opacity: 0.4;
            animation: float 15s ease-in-out infinite;
        }

        .glow-1 { top: -10%; left: -5%; width: 500px; height: 500px; background: #3D45AA; opacity: 0.15; }
        .glow-2 { bottom: -10%; right: -5%; width: 600px; height: 600px; background: #9F7AEA; opacity: 0.15; animation-delay: -7s; }

        /* The Dashboard Hub View */
        .central-hub {
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            box-shadow: 0 25px 50px -12px rgba(61, 69, 170, 0.15), 0 0 0 1px rgba(61, 69, 170, 0.05);
            max-width: 850px;
            width: 100%;
            padding: 2.25rem 2.5rem;
            border-radius: 40px;
            text-align: center;
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            margin: 2rem auto;
            border: 1px solid rgba(61, 69, 170, 0.1);
        }

        .hub-icon-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 85px;
            height: 85px;
            background: linear-gradient(135deg, #f0f2ff 0%, #e0e7ff 100%);
            border: 1px solid rgba(61, 69, 170, 0.2);
            border-radius: 24px;
            box-shadow: 0 15px 35px -5px rgba(61, 69, 170, 0.2);
            margin-bottom: 1rem;
            transform: rotate(-3deg);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .hub-icon-wrapper:hover {
            transform: rotate(0deg) scale(1.1);
            box-shadow: 0 20px 45px -5px rgba(61, 69, 170, 0.3);
            border-color: var(--court-primary);
        }

        .hub-icon-wrapper i {
            font-size: 2.5rem;
            color: var(--primary-brand);
        }

        .central-hub h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 2.75rem;
            font-weight: 900;
            color: #0f172a;
            margin-bottom: 0.5rem;
            letter-spacing: -2px;
            line-height: 1.1;
        }

        .central-hub p {
            font-size: 1.1rem;
            color: #475569;
            margin-bottom: 1.5rem;
            line-height: 1.8;
            max-width: 650px;
            margin-left: auto;
            margin-right: auto;
            font-weight: 500;
        }

        #osSelectionArea {
            border-top: 1px solid rgba(61, 69, 170, 0.1) !important;
            padding-top: 1.5rem !important;
            margin-top: 1.5rem !important;
        }

        #osSelectionArea h5 {
            font-family: 'Outfit', sans-serif;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: #64748b !important;
            font-weight: 800 !important;
        }

        .action-indicator {
            display: inline-flex;
            align-items: center;
            background: #eff6ff;
            padding: 0.75rem 1.5rem;
            border-radius: 2rem;
            color: var(--court-primary);
            font-weight: 800;
            font-size: 0.95rem;
            box-shadow: 0 4px 15px rgba(56, 82, 180, 0.1);
            animation: pulseSoft 2s infinite;
        }

        /* Forms & Inputs */
        .form-control, .form-select {
            border-radius: 14px !important;
            border: 1.5px solid #e2e8f0 !important;
            padding: 0.75rem 1.25rem !important;
            font-size: 0.95rem !important;
            transition: all 0.2s ease !important;
            background-color: #fdfdfd !important;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-brand) !important;
            box-shadow: 0 0 0 4px rgba(56, 82, 180, 0.1) !important;
            background-color: #ffffff !important;
        }

        .form-label {
            font-weight: 800 !important;
            color: var(--label-color) !important;
            font-size: 0.85rem !important;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.6rem !important;
            margin-left: 4px;
            display: flex;
            align-items: center;
        }

        .form-label::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 12px;
            background: var(--court-primary);
            margin-right: 8px;
            border-radius: 2px;
        }

        /* Buttons */
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-brand) 0%, var(--court-hover) 100%) !important;
            border: none !important;
            padding: 12px 48px !important;
            border-radius: 50px !important;
            font-weight: 700 !important;
            letter-spacing: 0.5px;
            box-shadow: 0 8px 15px -3px rgba(56, 82, 180, 0.3) !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }

        .btn-primary:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 25px -5px rgba(5, 150, 105, 0.4) !important;
        }

        .btn-outline-secondary {
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            color: #64748b !important;
            border-radius: 50px !important;
            transition: all 0.2s ease !important;
        }

        .btn-outline-secondary:hover {
            background: #f8fafc !important;
            color: var(--primary-brand) !important;
            border-color: var(--primary-brand) !important;
            transform: translateX(-3px);
        }

        /* Utilities */
        .text-primary { color: var(--primary-brand) !important; }
        .text-accent { color: var(--accent-vibrant) !important; }
        .bg-primary { background-color: var(--primary-brand) !important; }
        .border-primary { border-color: var(--primary-brand) !important; }

        /* Modern Soft Utility Colors */
        .bg-indigo-soft { background: rgba(79, 70, 229, 0.1) !important; color: #4F46E5 !important; }
        .bg-amber-soft { background: rgba(245, 158, 11, 0.1) !important; color: #D97706 !important; }
        .bg-emerald-soft { background: rgba(16, 185, 129, 0.1) !important; color: #059669 !important; }
        .bg-rose-soft { background: rgba(236, 72, 153, 0.1) !important; color: #DB2777 !important; }
        .bg-sky-soft { background: rgba(14, 165, 233, 0.1) !important; color: #0284C7 !important; }
        .bg-violet-soft { background: rgba(139, 92, 246, 0.1) !important; color: #7C3AED !important; }

        /* Premium Card Gradients */
        .card-premium-violet { background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%) !important; border: 1px solid rgba(191, 70, 70, 0.3) !important; }
        .card-premium-amber { background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%) !important; border: 1px solid rgba(232, 219, 179, 0.4) !important; }
        .card-premium-emerald { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%) !important; border: 1px solid rgba(16, 185, 129, 0.2) !important; }
        .card-premium-sky { background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%) !important; border: 1px solid rgba(191, 70, 70, 0.3) !important; }
        .card-premium-indigo { background: linear-gradient(135deg, #3D45AA 0%, #2D3380 100%) !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; color: white !important; }
        .card-premium-rose { background: linear-gradient(135deg, #4C51BF 0%, #3D45AA 100%) !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; color: white !important; }

        /* Cream Stat Cards */
        .card-cream-total { background: linear-gradient(135deg, #ffffff 0%, #fdfbf0 100%) !important; border: 1px solid rgba(232, 219, 179, 0.5) !important; }
        .card-cream-pending { background: linear-gradient(135deg, #fffcf0 0%, #fef5d4 100%) !important; border: 1px solid rgba(232, 219, 179, 0.5) !important; }
        .card-cream-disposed { background: linear-gradient(135deg, #fdf8e6 0%, #f9f1d0 100%) !important; border: 1px solid rgba(232, 219, 179, 0.5) !important; }
        .card-cream-hearings { background: linear-gradient(135deg, #f9f4e8 0%, #f2ead3 100%) !important; border: 1px solid rgba(232, 219, 179, 0.5) !important; }

        /* Bold Stat Cards */
        .card-bold-total { background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%) !important; border: none !important; color: white !important; }
        .card-bold-pending { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important; border: none !important; color: white !important; }
        .card-bold-disposed { background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; border: none !important; color: white !important; }
        .card-bold-hearings { background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%) !important; border: none !important; color: white !important; }
        
        .card-bold-total h6, .card-bold-total h3, .card-bold-total i,
        .card-bold-pending h6, .card-bold-pending h3, .card-bold-pending i,
        .card-bold-disposed h6, .card-bold-disposed h3, .card-bold-disposed i,
        .card-bold-hearings h6, .card-bold-hearings h3, .card-bold-hearings i {
            color: white !important;
        }

        .stat-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
            border-color: var(--court-primary) !important;
        }
        
        .selection-btn {
            border-radius: 20px;
            padding: 18px 40px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
            font-weight: 700;
        }

        .selection-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -10px rgba(191, 70, 70, 0.3);
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-30px) scale(1.05); }
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes pulseSoft {
            0%, 100% { transform: scale(1); box-shadow: 0 4px 15px rgba(56, 82, 180, 0.1); }
            50% { transform: scale(1.02); box-shadow: 0 8px 25px rgba(56, 82, 180, 0.2); }
        }

        .animate-pulse {
            animation: pulse-red 2s infinite;
        }

        @@keyframes pulse-red {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }

        /* Mobile Scroll */
        @@media (max-width: 991px) {
            .court-nav-list {
                overflow-x: auto;
                padding-bottom: 5px;
            }
            .court-nav-link {
                white-space: nowrap;
                padding: 1rem;
            }
            .central-hub h2 { font-size: 2.2rem; }
            .central-hub { padding: 2.5rem 1.5rem; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Header -->
    <header class="branding-header d-print-none">
        <div class="d-flex align-items-center">
            <img src="~/images/logo.jpg" alt="NWKRTC Logo" class="branding-logo" />
            <div class="branding-text">
                <span class="kannada fw-bold text-dark opacity-75">ವಾಯವ್ಯ ಕರ್ನಾಟಕ ರಸ್ತೆ ಸಾರಿಗೆ ಸಂಸ್ಥೆ</span>
                <h1 class="mb-0">North Western Karnataka Road Transport Corporation</h1>
            </div>
        </div>
        <div class="ms-auto d-flex align-items-center d-none d-md-flex">
            <div class="user-profile-badge">
                <i class="bi bi-person-fill text-primary me-1"></i>
                @User.FindFirst("FullName")?.Value
            </div>
            <a href="/Account/Logout" class="logout-btn">
                <i class="bi bi-power"></i> Exit
            </a>
        </div>
    </header>

    <!-- The Horizontal Court Navigation Bar -->
    <nav class="court-nav-bar">
        <ul class="court-nav-list">
            <li class="court-nav-item">
                <a href="@Url.Action("Index", "Home")" class="court-nav-link home-link">
                    <i class="bi bi-house-door-fill text-primary"></i> Home
                </a>
            </li>
            <li class="court-nav-item">
                <a href="@Url.Action("OtherCourts", "Home", new { activeCourt = "OS" })" class="court-nav-link @(ViewBag.ActiveCourt == "OS" || ViewBag.ActiveCourt == null ? "active" : "")" data-court="O.S">
                    <i class="bi bi-bank2"></i> O.S
                </a>
            </li>
            <li class="court-nav-item">
                <a href="@Url.Action("OtherCourts", "Home", new { activeCourt = "PSC" })" class="court-nav-link @(ViewBag.ActiveCourt == "PSC" ? "active" : "")" data-court="P &amp; SC">
                    <i class="bi bi-shield-exclamation text-danger"></i> P &amp; SC
                </a>
            </li>
            <li class="court-nav-item">
                <a href="@Url.Action("OtherCourts", "Home", new { activeCourt = "CC" })" class="court-nav-link @(ViewBag.ActiveCourt == "CC" ? "active" : "")" data-court="CC">
                    <i class="bi bi-shield-exclamation text-danger"></i> CC
                </a>
            </li>
            <li class="court-nav-item">
                <a href="@Url.Action("OtherCourts", "Home", new { activeCourt = "ECA" })" class="court-nav-link @(ViewBag.ActiveCourt == "ECA" ? "active" : "")" data-court="ECA">
                    <i class="bi bi-briefcase-fill text-success"></i> ECA
                </a>
            </li>
            <li class="court-nav-item">
                <a href="@Url.Action("OtherCourts", "Home", new { activeCourt = "Consumer" })" class="court-nav-link @(ViewBag.ActiveCourt == "Consumer" ? "active" : "")" data-court="Consumer Complaint">
                    <i class="bi bi-person-badge-fill text-warning"></i> Consumer Complaint
                </a>
            </li>
            <li class="court-nav-item">
                <a href="@Url.Action("OtherCourts", "Home", new { activeCourt = "LAC" })" class="court-nav-link @(ViewBag.ActiveCourt == "LAC" ? "active" : "")" data-court="LAC">
                    <i class="bi bi-map-fill text-info"></i> LAC
                </a>
            </li>
        </ul>
    </nav>

    <!-- Content Workspace -->
    <main class="system-canvas">
        <div class="glow-orb glow-1"></div>
        <div class="glow-orb glow-2"></div>
        @RenderBody()
    </main>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
