</div>

<!-- Floating Toast Container -->
<div class="hc-toast-container" id="hcToastContainer"></div>

<script>
let liveHcInitialized = false;

function showToast(title, message, isSuccess = true) {
    const container = document.getElementById('hcToastContainer');
    if (!container) return;

    const toastId = 'toast_' + Date.now();
    const borderClass = isSuccess ? 'border-success' : 'border-danger';
    const iconClass = isSuccess ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';

    const toastHtml = `
        <div id="${toastId}" class="toast align-items-center bg-white border ${borderClass} shadow-lg mb-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body small py-2">
                    <div class="fw-bold text-dark d-flex align-items-center">
                        <i class="bi ${iconClass} me-2 fs-6"></i> ${title}
                    </div>
                    <div class="text-muted mt-1 ps-4">${message}</div>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>`;
    container.insertAdjacentHTML('beforeend', toastHtml);

    const el = document.getElementById(toastId);
    if (el) {
        const bsToast = new bootstrap.Toast(el, { delay: 4000 });
        bsToast.show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }
}

function extractArrayFromData(data) {
    if (!data) return [];
    if (Array.isArray(data)) return data;
    if (typeof data === 'object') {
        const keys = ['causelist', 'causelistdetails', 'cause_list', 'cases', 'items', 'benches', 'court_halls', 'data', 'results'];
        for (let k of keys) {
            if (Array.isArray(data[k])) return data[k];
        }
        for (let k in data) {
            if (Array.isArray(data[k]) && data[k].length > 0) return data[k];
            if (typeof data[k] === 'object' && data[k] !== null) {
                let inner = extractArrayFromData(data[k]);
                if (inner.length > 0) return inner;
            }
        }
    }
    return [];
}

function initLiveHcCauselist() {
    populateScheduledDateChips();
    if (!liveHcInitialized) {
        liveHcInitialized = true;
        loadHcCourtBenches();
    }
    fetchLiveHcCauselist();
}

function normalizeDateKey(val) {
    if (!val) return "";
    val = String(val).split('T')[0].trim();
    const delim = val.includes('-') ? '-' : (val.includes('/') ? '/' : '');
    if (!delim) return val;
    const parts = val.split(delim);
    if (parts.length === 3) {
        if (parts[0].length === 4) {
            // YYYY-MM-DD
            return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
        } else {
            // DD-MM-YYYY
            return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
        }
    }
    return val;
}

function formatDateDisplay(val) {
    if (!val) return "—";
    const key = normalizeDateKey(val);
    if (key.length === 10) {
        const parts = key.split('-');
        return `${parts[2]}-${parts[1]}-${parts[0]}`;
    }
    return String(val);
}

function populateScheduledDateChips() {
    const chipContainer = document.getElementById('quickHearingDateChips');
    if (!chipContainer) return;

    const dateMap = new Map();
    let totalCnrCases = 0;

    registeredCases.forEach(c => {
        if (c.CNRNumber && c.CNRNumber.trim().length > 0) {
            totalCnrCases++;
            if (c.NextHearingDate) {
                const key = normalizeDateKey(c.NextHearingDate);
                if (key) {
                    if (!dateMap.has(key)) dateMap.set(key, []);
                    dateMap.get(key).push(c);
                }
            }
        }
    });

    const btnAllCnr = document.getElementById('btnAllCnrCount');
    if (btnAllCnr) btnAllCnr.textContent = totalCnrCases;

    let html = '';
    const sortedKeys = Array.from(dateMap.keys()).sort().reverse();
    sortedKeys.forEach(k => {
        const count = dateMap.get(k).length;
        const dParts = k.split('-');
        const displayD = `${dParts[2]}-${dParts[1]}-${dParts[0]}`;
        html += `<button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 extra-small rounded-pill fw-bold shadow-sm" onclick="selectScheduledDate('${displayD}')" title="${count} case(s) scheduled on ${displayD}">
            <i class="bi bi-calendar-event me-1"></i>${displayD} <span class="badge bg-danger ms-1">${count}</span>
        </button>`;
    });

    if (sortedKeys.length === 0) {
        html = '<span class="extra-small text-muted fst-italic">No upcoming hearing dates saved yet.</span>';
    }

    chipContainer.innerHTML = html;
}

function selectScheduledDate(dStr) {
    const dateInput = document.getElementById('liveDate');
    if (dateInput) {
        dateInput.value = dStr;
        loadHcCourtBenches();
        fetchLiveHcCauselist();
    }
}

function loadHcCourtBenches() {
    const estCode = document.getElementById('liveEstCode').value;
    const date = document.getElementById('liveDate').value;
    const benchSelect = document.getElementById('liveBenchId');

    benchSelect.innerHTML = '';
    
    const defaultOpt = document.createElement('option');
    defaultOpt.value = 'ALL';
    defaultOpt.textContent = 'All Benches / Court Halls';
    benchSelect.appendChild(defaultOpt);

    const queryEst = (estCode === "ALL") ? "KAHC01" : estCode;

    fetch(`/ECourts/GetHighCourtCauselistBenches?estCode=${encodeURIComponent(queryEst)}&causelistDate=${encodeURIComponent(date)}`)
        .then(r => r.json())
        .then(res => {
            const addedIds = new Set();
            addedIds.add('ALL');

            if (res && res.success && res.data) {
                let items = extractArrayFromData(res.data);
                if (items.length > 0) {
                    const group = document.createElement('optgroup');
                    group.label = 'Live Listed Benches (Today)';

                    items.forEach((b, idx) => {
                        const id = String(b.bench_id || b.bench_code || b.court_no || b.id || idx);
                        const name = b.bench_name || b.judge_name || b.court_name || b.name || `Court Hall ${id}`;
                        if (!addedIds.has(id)) {
                            addedIds.add(id);
                            const opt = document.createElement('option');
                            opt.value = id;
                            opt.textContent = `${name} (Bench #${id})`;
                            group.appendChild(opt);
                        }
                    });
                    if (group.children.length > 0) benchSelect.appendChild(group);
                }
            }

            const masterGroup = document.createElement('optgroup');
            masterGroup.label = 'High Court Court Halls & Benches';

            const standardBenches = [
                { id: '1', name: 'Court Hall 1 — Hon\'ble Chief Justice Bench' },
                { id: '2', name: 'Court Hall 2 — Division Bench I' },
                { id: '3', name: 'Court Hall 3 — Division Bench II' },
                { id: '4', name: 'Court Hall 4 — Single Bench' },
                { id: '5', name: 'Court Hall 5 — Single Bench' },
                { id: '6', name: 'Court Hall 6 — Single Bench' },
                { id: '7', name: 'Court Hall 7 — Single Bench' },
                { id: '8', name: 'Court Hall 8 — Single Bench' },
                { id: '9', name: 'Court Hall 9 — Single Bench' },
                { id: '10', name: 'Court Hall 10 — Single Bench' },
                { id: '11', name: 'Court Hall 11 — Single Bench' },
                { id: '12', name: 'Court Hall 12 — Single Bench' },
                { id: '13', name: 'Court Hall 13 — Single Bench' },
                { id: '14', name: 'Court Hall 14 — Single Bench' },
                { id: '15', name: 'Court Hall 15 — Single Bench' },
                { id: '16', name: 'Court Hall 16 — Single Bench' },
                { id: '17', name: 'Court Hall 17 — Single Bench' },
                { id: '18', name: 'Court Hall 18 — Single Bench' },
                { id: '19', name: 'Court Hall 19 — Single Bench' },
                { id: '20', name: 'Court Hall 20 — Single Bench' },
                { id: '21', name: 'Court Hall 21 — Single Bench' },
                { id: '22', name: 'Court Hall 22 — Single Bench' },
                { id: '23', name: 'Court Hall 23 — Single Bench' },
                { id: '24', name: 'Court Hall 24 — Single Bench' },
                { id: '25', name: 'Court Hall 25 — Single Bench' }
            ];

            standardBenches.forEach(sb => {
                if (!addedIds.has(sb.id)) {
                    addedIds.add(sb.id);
                    const opt = document.createElement('option');
                    opt.value = sb.id;
                    opt.textContent = sb.name;
                    masterGroup.appendChild(opt);
                }
            });
            benchSelect.appendChild(masterGroup);
        })
        .catch(() => {
            const masterGroup = document.createElement('optgroup');
            masterGroup.label = 'High Court Court Halls';
            for (let ch = 1; ch <= 25; ch++) {
                const opt = document.createElement('option');
                opt.value = String(ch);
                opt.textContent = `Court Hall ${ch}`;
                masterGroup.appendChild(opt);
            }
            benchSelect.appendChild(masterGroup);
        });
}

const registeredCases = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items));

function showAllSavedCnrCases() {
    const container = document.getElementById('liveCauselistContainer');
    const badge = document.getElementById('liveListBadge');
    const cnrCases = registeredCases.filter(c => c.CNRNumber && c.CNRNumber.trim().length > 0);

    if (cnrCases.length > 0) {
        badge.className = "badge bg-primary px-3 py-1";
        badge.textContent = `${cnrCases.length} Total Saved CNR Cases`;
        renderSavedCnrItemsTable(cnrCases, container, "All High Court Appeals with Saved CNR Numbers", "");
    } else {
        badge.className = "badge bg-secondary px-3 py-1";
        badge.textContent = "0 Saved CNR Cases";
        container.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-folder-x fs-1 d-block text-secondary mb-2"></i><h5>No saved CNR cases found in the system</h5></div>';
    }
}

function renderSavedCnrItemsTable(items, container, headingText, warningNote = "") {
    const benchId = document.getElementById('liveBenchId').value;
    let html = `<div class="p-3 bg-primary-subtle border-bottom border-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="fw-bold text-primary small">
            <i class="bi bi-shield-check me-2 fs-6"></i>${headingText}
            ${warningNote ? `<span class="badge bg-warning text-dark ms-2"><i class="bi bi-info-circle me-1"></i>Scheduled under Dharwad/Kalaburagi Bench</span>` : ''}
        </div>
        <span class="badge bg-primary text-white">${items.length} Case${items.length > 1 ? 's' : ''} Listed</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="bg-light text-secondary extra-small text-uppercase">
                <tr>
                    <th>#</th>
                    <th>Case Number & Year</th>
                    <th>Court Hall / Bench</th>
                    <th>High Court Bench</th>
                    <th>CNR Number & Actions</th>
                    <th>Arising MVC & Division</th>
                    <th>Petitioner vs Respondent</th>
                    <th>Hearing Date / Stage</th>
                    <th>Match Status</th>
                </tr>
            </thead>
            <tbody>`;

    items.forEach((item, idx) => {
        let dtStr = 'Pending';
        if (item.NextHearingDate) {
            dtStr = formatDateDisplay(item.NextHearingDate);
        }
        const chVal = (item.CourtHall && item.CourtHall !== 'Court Hall 1') ? item.CourtHall : (benchId !== "ALL" ? `Court Hall ${benchId}` : 'Sync Pending');
        const chBadge = chVal === 'Sync Pending' 
            ? `<span class="badge bg-light text-muted border extra-small"><i class="bi bi-wifi me-1 text-primary"></i>Sync Pending</span>`
            : `<span class="badge bg-warning-subtle text-dark border border-warning font-monospace fw-bold"><i class="bi bi-bank2 me-1"></i>${chVal}</span>`;

        const cnr = item.CNRNumber || '';

        html += `<tr class="live-causelist-row corp-match-row" data-is-corp="true" data-is-saved-cnr="true">
            <td class="fw-bold text-center">${idx + 1}</td>
            <td>
                <strong class="text-primary font-monospace fs-6">${item.DisplayMFANo || '—'}</strong>
                <div class="extra-small text-muted">${item.AppealType || '—'}</div>
            </td>
            <td>${chBadge}</td>
            <td><span class="badge bg-light text-dark border fw-bold">${item.HighCourtBench || 'Dharwad'}</span></td>
            <td>
                <div class="font-monospace fw-bold text-dark fs-6 mb-1">${cnr || '—'}</div>
                <div class="btn-group btn-group-sm">
                    ${cnr ? `<button class="btn btn-outline-primary btn-sm py-0 px-1.5" type="button" onclick="syncSingleCnr('${item.AppealID}', '${cnr}')" title="Sync live eCourts details">
                        <i class="bi bi-arrow-repeat"></i> Sync
                    </button>
                    <button class="btn btn-outline-info btn-sm py-0 px-1.5" type="button" onclick="openDossierModal('${item.AppealID}', '${cnr}', '${item.DisplayMFANo}')" title="View Orders & Dossier">
                        <i class="bi bi-journal-text"></i> Dossier
                    </button>` : ''}
                    <a href="/Case/Details/${item.CaseID}" class="btn btn-outline-secondary btn-sm py-0 px-1.5" title="View Full Case">
                        <i class="bi bi-eye"></i> View
                    </a>
                </div>
            </td>
            <td><strong class="text-dark">MVC ${item.ArisingMVCNo || '—'} / ${item.ArisingMVCYear || ''}</strong><div class="extra-small text-muted">${item.DivisionName || ''}</div></td>
            <td>
                <div class="fw-bold text-dark">${item.PetitionerName || '—'}</div>
                <div class="extra-small text-muted">vs ${item.RespondentName || '—'}</div>
            </td>
            <td>
                <strong class="text-danger font-monospace fs-6 d-block"><i class="bi bi-calendar-event me-1"></i>${dtStr}</strong>
                <span class="badge bg-light text-primary border">${item.CaseStage || 'Hearing Active'}</span>
            </td>
            <td>
                <span class="badge bg-success text-white px-2 py-1 shadow-sm">
                    <i class="bi bi-shield-check me-1"></i>Saved CNR Matched
                </span>
            </td>
        </tr>`;
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
}

function fetchLiveHcCauselist() {
    const estCode = document.getElementById('liveEstCode').value;
    const dateInputVal = document.getElementById('liveDate').value.trim();
    const targetKey = normalizeDateKey(dateInputVal);
    const benchId = document.getElementById('liveBenchId').value;
    const container = document.getElementById('liveCauselistContainer');
    const badge = document.getElementById('liveListBadge');

    badge.className = "badge bg-warning text-dark px-3 py-1";
    badge.textContent = "Fetching Live Gateway...";
    container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-danger" role="status"></div><p class="mt-2 text-muted fw-bold">Querying official High Court Daily Cause List from e-Courts Gateway via NAPIX...</p></div>';

    let targetBench = "";
    if (estCode === "KAHC01") targetBench = "Bengaluru";
    else if (estCode === "KAHC02") targetBench = "Dharwad";
    else if (estCode === "KAHC03") targetBench = "Kalaburagi";

    const queryEst = (estCode === "ALL") ? "KAHC01" : estCode;

    fetch(`/ECourts/GetHighCourtCauselistDetails?estCode=${encodeURIComponent(queryEst)}&benchId=${encodeURIComponent(benchId)}&causelistDate=${encodeURIComponent(dateInputVal)}`)
        .then(r => r.json())
        .then(res => {
            let liveItems = [];
            if (res && res.success && res.data) {
                liveItems = extractArrayFromData(res.data);
            }

            if (liveItems.length > 0) {
                renderLiveCauseListWithSavedCnrMatch(liveItems, targetKey, dateInputVal, targetBench, container, badge);
            } else {
                renderSavedCnrDateMatchTable(targetKey, dateInputVal, targetBench, container, badge);
            }
        })
        .catch(() => {
            renderSavedCnrDateMatchTable(targetKey, dateInputVal, targetBench, container, badge);
        });
}

function renderLiveCauseListWithSavedCnrMatch(items, targetKey, displayDate, targetBench, container, badge) {
    const benchId = document.getElementById('liveBenchId').value;
    const cnrSet = new Set(registeredCases.filter(c => c.CNRNumber).map(c => c.CNRNumber.trim().toUpperCase()));
    const mfaSet = new Set(registeredCases.filter(c => c.MFANumber).map(c => c.MFANumber.trim()));

    badge.className = "badge bg-success px-3 py-1";
    badge.textContent = `${items.length} Cases Listed`;

    let html = `<div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="bg-light text-secondary extra-small text-uppercase">
                <tr>
                    <th>#</th>
                    <th>Case Number & Year</th>
                    <th>Court Hall / Bench</th>
                    <th>Petitioner vs Respondent</th>
                    <th>Advocates</th>
                    <th>Stage / Purpose</th>
                    <th>Corporation & CNR Match</th>
                </tr>
            </thead>
            <tbody>`;

    items.forEach((item, idx) => {
        const sr = item.sr_no || item.sl_no || item.srno || item.slno || item.item_no || item.serial_no || item.sl_number || (idx + 1);
        const caseNo = item.case_no || item.case_number || item.cateno || '—';
        const courtNo = item.court_no || item.court_hall || item.court_no_judge || item.bench_name || item.desgname || item.judge_name || item.judge || (benchId !== "ALL" ? `Court Hall ${benchId}` : 'Sync Pending');
        const pet = item.pet_name || item.petitioner || item.party_name || '—';
        const resName = item.res_name || item.respondent || '—';
        const petAdv = item.pet_adv || item.petitioner_advocate || '—';
        const resAdv = item.res_adv || item.respondent_advocate || '—';
        const stage = item.purpose_name || item.stage || '—';
        const itemCnr = (item.cnr || item.cnr_number || '').trim().toUpperCase();

        const isCnrMatched = (itemCnr && cnrSet.has(itemCnr));
        const isCorpMatch = isCnrMatched || pet.toUpperCase().includes('NWKRTC') || pet.toUpperCase().includes('KSRTC') || resName.toUpperCase().includes('NWKRTC') || resName.toUpperCase().includes('KSRTC');

        let matchBadge = '<span class="badge bg-light text-muted border">General</span>';
        if (isCnrMatched) {
            matchBadge = '<span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-star-fill text-warning me-1"></i>Saved CNR Listed Live!</span>';
        } else if (isCorpMatch) {
            matchBadge = '<span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check2 me-1"></i>Corporation Match</span>';
        }

        html += `<tr class="live-causelist-row ${isCorpMatch ? 'corp-match-row' : ''}" data-is-corp="${isCorpMatch}" data-is-saved-cnr="${isCnrMatched}">
            <td class="fw-bold">${sr}</td>
            <td><strong class="text-primary font-monospace fs-6">${caseNo}</strong></td>
            <td><span class="badge bg-warning-subtle text-dark border border-warning font-monospace fw-bold"><i class="bi bi-bank2 me-1"></i>${courtNo}</span></td>
            <td>
                <div class="fw-bold text-dark">${pet}</div>
                <div class="extra-small text-muted">vs ${resName}</div>
            </td>
            <td>
                <div class="extra-small"><strong>Pet:</strong> ${petAdv}</div>
                <div class="extra-small text-muted"><strong>Res:</strong> ${resAdv}</div>
            </td>
            <td><span class="badge bg-light text-dark border">${stage}</span></td>
            <td>${matchBadge}</td>
        </tr>`;
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
    filterLiveCauselistRows();
}

function renderSavedCnrDateMatchTable(targetKey, displayDate, targetBench, container, badge) {
    const cnrCases = registeredCases.filter(c => c.CNRNumber && c.CNRNumber.trim().length > 0);
    let dateMatches = cnrCases.filter(c => normalizeDateKey(c.NextHearingDate) === targetKey);

    let finalMatches = dateMatches;
    let benchNote = "";
    if (targetBench && dateMatches.length > 0) {
        const benchSpecific = dateMatches.filter(c => c.HighCourtBench && (c.HighCourtBench.toLowerCase().includes(targetBench.toLowerCase()) || targetBench.toLowerCase().includes(c.HighCourtBench.toLowerCase())));
        if (benchSpecific.length > 0) {
            finalMatches = benchSpecific;
        } else {
            benchNote = targetBench;
            finalMatches = dateMatches; // Still show them so user sees their saved cases!
        }
    }

    if (finalMatches.length > 0) {
        badge.className = "badge bg-success px-3 py-1";
        badge.textContent = `${finalMatches.length} Saved CNR Case${finalMatches.length > 1 ? 's' : ''} on ${displayDate}`;
        renderSavedCnrItemsTable(finalMatches, container, `Saved High Court cases with CNR scheduled on hearing date: ${displayDate}`, benchNote);
    } else {
        badge.className = "badge bg-secondary px-3 py-1";
        badge.textContent = `0 Cases on ${displayDate}`;

        let fallbackHtml = `
            <div class="text-center py-5 px-3">
                <div class="mb-3">
                    <span class="badge bg-light text-secondary border p-3 rounded-circle shadow-sm">
                        <i class="bi bi-calendar-x fs-2 text-danger"></i>
                    </span>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Saved CNR Cases Scheduled on ${displayDate}</h5>
                <p class="text-muted small mb-3">No High Court appeals with saved CNR numbers have hearing dates scheduled on <strong>${displayDate}</strong>${targetBench ? ` for ${targetBench} Bench` : ''}.</p>
                
                <div class="card border border-warning-subtle bg-warning-subtle text-dark mx-auto p-3 mb-4 rounded-3 text-start shadow-sm" style="max-width: 650px;">
                    <div class="fw-bold small mb-2 text-primary d-flex align-items-center">
                        <i class="bi bi-calendar-check-fill me-2 text-warning fs-5"></i>Available Hearing Dates for Saved CNR Cases:
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">`;

        const dateMap = new Map();
        cnrCases.forEach(c => {
            if (c.NextHearingDate) {
                const k = normalizeDateKey(c.NextHearingDate);
                if (k) {
                    if (!dateMap.has(k)) dateMap.set(k, []);
                    dateMap.get(k).push(c);
                }
            }
        });

        dateMap.forEach((cases, k) => {
            const parts = k.split('-');
            const dStr = `${parts[2]}-${parts[1]}-${parts[0]}`;
            const mfaList = cases.map(c => c.DisplayMFANo).join(', ');
            fallbackHtml += `<button type="button" class="btn btn-outline-danger btn-sm fw-bold px-3 py-1.5 shadow-sm" onclick="selectScheduledDate('${dStr}')">
                <i class="bi bi-calendar-event me-1"></i>${dStr} (${cases.length} case${cases.length > 1 ? 's' : ''})
                <span class="extra-small d-block text-muted">MFA ${mfaList}</span>
            </button>`;
        });

        fallbackHtml += `</div>
                    <div class="text-end pt-2 border-top border-warning-subtle">
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3 py-1.5 shadow-sm" onclick="showAllSavedCnrCases()">
                            <i class="bi bi-list-check me-1"></i>View All ${cnrCases.length} Saved CNR Cases
                        </button>
                    </div>
                </div>
                <p class="extra-small text-muted mb-0">High Courts publish cause lists daily during court sessions via the eCourts NAPIX Gateway.</p>
            </div>`;
        container.innerHTML = fallbackHtml;
    }
}

function filterLiveCauselistRows() {
    const chk = document.getElementById('chkOnlyCorp');
    if (!chk) return;
    const onlyCorp = chk.checked;
    const rows = document.querySelectorAll('.live-causelist-row');
    rows.forEach(r => {
        const isCorp = r.getAttribute('data-is-corp') === 'true';
        if (onlyCorp && !isCorp) {
            r.style.display = 'none';
        } else {
            r.style.display = '';
        }
    });
}

function syncSingleCnr(appealId, cnr, isBatch = false) {
    if (!cnr) return Promise.resolve({ success: false, cnr: '' });
    const btn = document.getElementById('sync_btn_' + appealId);
    let origText = '';
    if (btn) {
        origText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
    }

    return fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=true&appealId=${encodeURIComponent(appealId)}`)
        .then(r => r.json())
        .then(res => {
            if (res && res.success && res.data) {
                const d = res.data;

                // 1. Update Stage
                if (d.stage) {
                    const stageEl = document.getElementById('stage_' + appealId);
                    if (stageEl) {
                        stageEl.textContent = d.stage;
                        stageEl.title = d.stage;
                    }
                }

                // 2. Update Court Hall
                const courtHallVal = d.court_no_judge || d.court_no;
                if (courtHallVal) {
                    const chEl = document.getElementById('courthall_' + appealId);
                    if (chEl) {
                        chEl.className = "badge bg-warning-subtle text-dark border border-warning extra-small text-truncate";
                        chEl.style.maxWidth = "160px";
                        chEl.title = courtHallVal;
                        chEl.innerHTML = '<i class="bi bi-bank2 me-1"></i>' + courtHallVal;
                    }
                }

                // 3. Update Next Hearing Date & Status
                let nextDateDisplay = 'Date Pending';
                let isListedToday = false;
                let isUpcomingWeek = false;

                if (d.next_hearing_date && d.next_hearing_date !== 'Disposed' && d.next_hearing_date !== 'Pending') {
                    let parsedDt = null;
                    const parts = d.next_hearing_date.split('-');
                    if (parts.length === 3) {
                        if (parts[0].length === 4) {
                            // yyyy-MM-dd
                            parsedDt = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                            nextDateDisplay = `${parts[2]}-${parts[1]}-${parts[0]}`;
                        } else {
                            // dd-MM-yyyy
                            parsedDt = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                            nextDateDisplay = d.next_hearing_date;
                        }
                    } else {
                        parsedDt = new Date(d.next_hearing_date);
                        if (!isNaN(parsedDt.getTime())) {
                            nextDateDisplay = parsedDt.toLocaleDateString('en-GB').replace(/\//g, '-');
                        }
                    }

                    if (parsedDt && !isNaN(parsedDt.getTime())) {
                        const today = new Date();
                        today.setHours(0, 0, 0, 0);
                        const hearingDay = new Date(parsedDt.getTime());
                        hearingDay.setHours(0, 0, 0, 0);

                        const diffDays = Math.round((hearingDay - today) / (1000 * 60 * 60 * 24));
                        if (diffDays === 0) isListedToday = true;
                        else if (diffDays > 0 && diffDays <= 7) isUpcomingWeek = true;
                    }
                } else if (d.next_hearing_date === 'Disposed') {
                    nextDateDisplay = 'Disposed';
                }

                // Update DOM Hearing Date
                const dtEl = document.getElementById('hearing_dt_' + appealId);
                if (dtEl) {
                    if (nextDateDisplay !== 'Date Pending' && nextDateDisplay !== 'Disposed') {
                        dtEl.outerHTML = `<strong class="text-dark fs-6 d-block" id="hearing_dt_${appealId}"><i class="bi bi-calendar-event me-1 text-primary"></i>${nextDateDisplay}</strong>`;
                    } else if (nextDateDisplay === 'Disposed') {
                        dtEl.outerHTML = `<span class="badge bg-secondary" id="hearing_dt_${appealId}">Disposed</span>`;
                    } else {
                        dtEl.outerHTML = `<span class="text-muted fst-italic" id="hearing_dt_${appealId}">Date Pending</span>`;
                    }
                }

                // Update Status Badge
                const statusBadgeEl = document.getElementById('status_badge_' + appealId);
                const rowEl = document.getElementById('row_' + appealId);

                if (statusBadgeEl) {
                    if (isListedToday) {
                        statusBadgeEl.className = "badge bg-danger text-white animate-pulse p-2";
                        statusBadgeEl.textContent = "Listed Today";
                        if (rowEl) rowEl.classList.add("table-danger");
                    } else if (isUpcomingWeek) {
                        statusBadgeEl.className = "badge bg-warning text-dark p-2";
                        statusBadgeEl.textContent = "Upcoming This Week";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    } else if (nextDateDisplay === 'Disposed') {
                        statusBadgeEl.className = "badge bg-secondary text-white p-2";
                        statusBadgeEl.textContent = "Disposed";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    } else if (nextDateDisplay !== 'Date Pending') {
                        statusBadgeEl.className = "badge bg-info text-dark p-2";
                        statusBadgeEl.textContent = "Future Hearing";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    } else {
                        statusBadgeEl.className = "badge bg-secondary text-white p-2";
                        statusBadgeEl.textContent = "Pending";
                        if (rowEl) rowEl.classList.remove("table-danger");
                    }
                }

                // Update KPI Counters
                recalculateKpis();

                if (!isBatch) {
                    showToast(`CNR Synced (${cnr})`, `Live data updated: ${nextDateDisplay} | ${d.stage || 'Hearing Active'}`, true);
                }
                return { success: true, cnr };
            } else {
                if (!isBatch) {
                    showToast(`Sync Failed (${cnr})`, res.message || 'No live records found on eCourts Gateway.', false);
                }
                return { success: false, cnr };
            }
        })
        .catch(err => {
            if (!isBatch) {
                showToast(`Sync Error (${cnr})`, 'Network error querying eCourts Gateway.', false);
            }
            return { success: false, cnr };
        })
        .finally(() => {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Synced';
                setTimeout(() => {
                    btn.innerHTML = origText || '<i class="bi bi-arrow-repeat"></i> Sync';
                }, 2500);
            }
        });
}

function recalculateKpis() {
    const rows = document.querySelectorAll('tr[id^="row_"]');
    let total = rows.length;
    let todayCount = 0;
    let weekCount = 0;
    let cnrCount = 0;

    rows.forEach(r => {
        const cnr = r.getAttribute('data-cnr');
        if (cnr && cnr.trim().length > 0) cnrCount++;

        const statusBadge = r.querySelector('[id^="status_badge_"]');
        if (statusBadge) {
            const txt = statusBadge.textContent.trim();
            if (txt === "Listed Today") todayCount++;
            else if (txt === "Upcoming This Week") weekCount++;
        }
    });

    const kpiTotalEl = document.getElementById('kpiTotal');
    const kpiTodayEl = document.getElementById('kpiToday');
    const kpiWeekEl = document.getElementById('kpiWeek');
    const kpiCnrEl = document.getElementById('kpiCnr');

    if (kpiTotalEl) kpiTotalEl.textContent = total;
    if (kpiTodayEl) kpiTodayEl.textContent = todayCount;
    if (kpiWeekEl) kpiWeekEl.textContent = weekCount;
    if (kpiCnrEl) kpiCnrEl.textContent = cnrCount;
}

async function syncAllVisibleCnrs() {
    const rows = document.querySelectorAll('tr[data-appeal-id][data-cnr]');
    const validRows = Array.from(rows).filter(r => (r.getAttribute('data-cnr') || '').trim().length > 0);
    const masterBtn = document.getElementById('btnSyncAll');
    
    if (validRows.length === 0) {
        showToast("CNR Sync", "No cases with CNR linked to sync.", false);
        return;
    }

    let originalHtml = '';
    if (masterBtn) {
        originalHtml = masterBtn.innerHTML;
        masterBtn.disabled = true;
    }

    let successCount = 0;
    let failCount = 0;
    const total = validRows.length;

    for (let i = 0; i < total; i++) {
        const row = validRows[i];
        const appealId = row.getAttribute('data-appeal-id');
        const cnr = row.getAttribute('data-cnr');

        if (masterBtn) {
            masterBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Syncing ${i + 1} of ${total}...`;
        }

        try {
            const res = await syncSingleCnr(appealId, cnr, true);
            if (res && res.success) {
                successCount++;
            } else {
                failCount++;
            }
        } catch (e) {
            failCount++;
        }

        // Slight interval between requests to be polite to the gateway
        if (i < total - 1) {
            await new Promise(r => setTimeout(r, 600));
        }
    }

    if (masterBtn) {
        masterBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Sync Complete';
        setTimeout(() => {
            masterBtn.innerHTML = originalHtml;
            masterBtn.disabled = false;
        }, 3000);
    }

    // ONLY 1 single toast notification at the end of the entire bulk sync
    if (failCount === 0) {
        showToast("Bulk Sync Completed", `All ${successCount} High Court cases synced successfully with live eCourts Gateway.`, true);
    } else {
        showToast("Bulk Sync Completed", `Synced ${successCount} of ${total} cases (${failCount} pending/offline).`, successCount > 0);
    }
}

function openDossierModal(appealId, cnr, mfaNo) {
    document.getElementById('modalMfaNo').textContent = mfaNo;
    document.getElementById('modalCnr').textContent = cnr;
    
    document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading hearing history from NAPIX...</td></tr>';
    document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm text-danger me-2"></div>Loading orders from NAPIX...</td></tr>';

    const modal = new bootstrap.Modal(document.getElementById('dossierModal'));
    modal.show();

    fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cnr)}&isHighCourt=true&appealId=${encodeURIComponent(appealId)}`)
        .then(r => r.json())
        .then(res => {
            if (res && res.success) {
                const history = res.history || [];
                const orders = res.orders || [];
                const d = res.data || {};

                document.getElementById('mCountHistory').textContent = history.length;
                document.getElementById('mCountOrders').textContent = orders.length;

                // Render History
                if (history.length === 0) {
                    document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No hearing history returned by e-Courts Gateway.</td></tr>';
                } else {
                    let hHtml = '';
                    history.forEach((item, idx) => {
                        const dt = item.business_date || item.hearing_date || item.date || item.next_date || '—';
                        const purpose = item.purpose_name || item.stage || item.next_purpose || '—';
                        const judge = item.judge || item.desgname || item.judge_name || '—';
                        const business = item.business || item.remarks || item.court_business || '—';
                        hHtml += `<tr>
                            <td class="text-muted fw-bold">${idx + 1}</td>
                            <td class="fw-bold text-dark font-monospace">${dt}</td>
                            <td><span class="badge bg-light text-primary border">${purpose}</span></td>
                            <td>${judge}</td>
                            <td class="fst-italic text-secondary">${business}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyHistory').innerHTML = hHtml;
                }

                // Render Orders
                if (orders.length === 0) {
                    document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No orders or judgments published for this case.</td></tr>';
                } else {
                    let oHtml = '';
                    orders.forEach((item, idx) => {
                        const dt = item.order_date || item.orderDate || item.date || '—';
                        const type = item.order_type || item.order_number || item.title || item.order_details || 'Order / Judgment';
                        const judge = item.judge || item.desgname || '—';
                        const pdfUrl = item.pdf_url || item.order_link || item.link || item.pdf || '';

                        let actionBtn = `<a href="/ECourts/ViewOrderPdf?cnr=${encodeURIComponent(cnr)}" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold"><i class="bi bi-file-pdf-fill me-1"></i> View Order PDF</a>`;
                        if (pdfUrl) {
                            let targetUrl = pdfUrl;
                            if (!pdfUrl.startsWith('/ECourts/ViewOrderPdf')) {
                                targetUrl = `/ECourts/ViewOrderPdf?url=${encodeURIComponent(pdfUrl)}&cnr=${encodeURIComponent(cnr)}`;
                            }
                            actionBtn = `<a href="${targetUrl}" target="_blank" class="btn btn-sm btn-danger py-0 px-2 text-white fw-bold shadow-sm"><i class="bi bi-file-pdf-fill me-1"></i> Open Order PDF</a>`;
                        }

                        oHtml += `<tr>
                            <td class="text-muted fw-bold">${idx + 1}</td>
                            <td class="fw-bold text-dark font-monospace">${dt}</td>
                            <td><strong>${type}</strong></td>
                            <td>${judge}</td>
                            <td>${actionBtn}</td>
                        </tr>`;
                    });
                    document.getElementById('mTbodyOrders').innerHTML = oHtml;
                }

                // Render Details
                document.getElementById('mPetitioner').textContent = d.petitioner || '—';
                document.getElementById('mRespondent').textContent = d.respondent || '—';
                document.getElementById('mPetAdv').textContent = d.petitioner_advocate || d.pet_adv || '—';
                document.getElementById('mResAdv').textContent = d.respondent_advocate || d.res_adv || '—';
                document.getElementById('mFilingDate').textContent = d.filing_date || '—';
                document.getElementById('mRegDate').textContent = d.dt_regis || '—';
                document.getElementById('mDisposalDate').textContent = d.date_of_decision || '—';
            } else {
                document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Could not load eCourts history.</td></tr>';
                document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Could not load eCourts orders.</td></tr>';
            }
        })
        .catch(() => {
            document.getElementById('mTbodyHistory').innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Network error fetching dossier.</td></tr>';
            document.getElementById('mTbodyOrders').innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Network error fetching dossier.</td></tr>';
        });
}
</script>
