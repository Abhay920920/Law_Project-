@model MVCCaseManagement.Models.LabourCase
@{
    ViewData["Title"] = "Edit Labour Case - " + Model.CaseNumber;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HidePageHeader"] = true;
    var courts = ViewBag.Courts as IEnumerable<MVCCaseManagement.Models.LabourCourt>;
}

<style>
    .shadow-xs { box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05) !important; }
    .transition { transition: all 0.2s ease-in-out !important; }
    .hover-shadow-sm:hover { box-shadow: 0 .25rem .75rem rgba(0,0,0,.05) !important; transform: translateY(-2px); }
    .cursor-pointer { cursor: pointer; }
    .border-dashed { border-style: dashed !important; }
</style>

<div class="case-file-container row justify-content-center">
    <div class="col-xl-10">
        <form asp-action="Edit" method="post" id="labourCaseForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CaseID" />
            <input type="hidden" asp-for="DE_HistorySheetPath" />
            <input type="hidden" asp-for="LokAdalatDocumentPath" />
            <input type="hidden" asp-for="Against_PunishmentCopyPath" />
            <input type="hidden" asp-for="CO_ClosedDocumentPath" />
            <input type="hidden" asp-for="CO_WP_StayOrderPath" />
            <input type="hidden" asp-for="CO_Reinstatement_StayOrderPath" />
            <input type="hidden" asp-for="CO_Reinstatement_ApprovalCopyPath" />
            <input type="hidden" asp-for="CO_WA_StayOrderPath" />
            <input type="hidden" asp-for="CO_Claimant_PetitionCopyPath" />
            <input type="hidden" asp-for="CO_Service_PetitionCopyPath" />
            <input type="hidden" asp-for="CO_Service_ApprovalCopyPath" />
            <input type="hidden" asp-for="JudgmentCopyPath" />
            <input type="hidden" asp-for="CO_StayComplianceFilePath" />
            <input type="hidden" asp-for="IsArisingApplication" />
            
             @* Data Lock Fields (Preserve data from CO Action / Claimant Appeal / SC Pages) *@
             <input type="hidden" asp-for="CO_FeasibilityReceived" />
             <input type="hidden" asp-for="CO_FeasibilityDate" />
             <input type="hidden" asp-for="CO_ActionTaken" />
             <input type="hidden" asp-for="CO_ApprovalOutwardNo" />
             <input type="hidden" asp-for="CO_ApprovalDate" />

             <input type="hidden" asp-for="CO_WP_CaseStatus_Option" />
             <input type="hidden" asp-for="CO_WP_CaseNumber" />
             <input type="hidden" asp-for="CO_WP_Year" />
             <input type="hidden" asp-for="CO_WP_HighCourtBench" />
             <input type="hidden" asp-for="CO_WP_EntrustmentNo" />
             <input type="hidden" asp-for="CO_WP_EntrustmentDate" />
             <input type="hidden" asp-for="CO_WP_AdvocateName" />
             <input type="hidden" asp-for="CO_WP_StayGranted" />
             <input type="hidden" asp-for="CO_WP_StayApprovalNo" />
             <input type="hidden" asp-for="CO_WP_StayNature" />
             <input type="hidden" asp-for="CO_WP_StayDate" />
             <input type="hidden" asp-for="CO_WP_StayRemark" />
             <input type="hidden" asp-for="CO_WP_Status" />
             <input type="hidden" asp-for="CO_WP_Outcome" />
             <input type="hidden" asp-for="CO_WP_OutcomeRemark" />
             <input type="hidden" asp-for="CO_WP_OutcomeOutwardNo" />
             <input type="hidden" asp-for="CO_WP_OutcomeOutwardDate" />
             <input type="hidden" asp-for="CO_WP_ActionTaken" />

             <input type="hidden" asp-for="CO_WA_CaseStatus_Option" />
             <input type="hidden" asp-for="CO_WA_CaseNumber" />
             <input type="hidden" asp-for="CO_WA_Year" />
             <input type="hidden" asp-for="CO_WA_HighCourtBench" />
             <input type="hidden" asp-for="CO_WA_EntrustmentNo" />
             <input type="hidden" asp-for="CO_WA_EntrustmentDate" />
             <input type="hidden" asp-for="CO_WA_AdvocateName" />
             <input type="hidden" asp-for="CO_WA_StayGranted" />
             <input type="hidden" asp-for="CO_WA_StayApprovalNo" />
             <input type="hidden" asp-for="CO_WA_StayNature" />
             <input type="hidden" asp-for="CO_WA_StayDate" />
             <input type="hidden" asp-for="CO_WA_StayRemark" />
             <input type="hidden" asp-for="CO_WA_Status" />
             <input type="hidden" asp-for="CO_WA_Outcome" />
             <input type="hidden" asp-for="CO_WA_OutcomeRemark" />
             <input type="hidden" asp-for="CO_WA_OutcomeOutwardNo" />
             <input type="hidden" asp-for="CO_WA_OutcomeOutwardDate" />
             <input type="hidden" asp-for="CO_WA_ActionTaken" />

             <input type="hidden" asp-for="CO_IsWorkmanReinstated" />
             <input type="hidden" asp-for="CO_ReinstatedSubjectToWP" />
             <input type="hidden" asp-for="CO_Reinstatement_StayGranted" />
             <input type="hidden" asp-for="CO_Reinstatement_StayApprovalNo" />
             <input type="hidden" asp-for="CO_Reinstatement_StayNature" />
             <input type="hidden" asp-for="CO_Reinstatement_StayDate" />
             <input type="hidden" asp-for="CO_Reinstatement_StayRemark" />
             <input type="hidden" asp-for="CO_ReinstatementApprovalIssued" />
             <input type="hidden" asp-for="CO_ReinstatementApprovalDate" />
             <input type="hidden" asp-for="CO_Reinstatement_ApprovalNo" />

             <input type="hidden" asp-for="CO_OverallCaseStatus" />
             <input type="hidden" asp-for="CO_Disposal_Nature" />
             <input type="hidden" asp-for="CO_Disposal_CommSentToDivision" />
             <input type="hidden" asp-for="CO_Disposal_OutwardNo" />
             <input type="hidden" asp-for="CO_Disposal_Date" />
             <input type="hidden" asp-for="CO_Disposal_Decision" />
             <input type="hidden" asp-for="CO_Disposal_ApprovalOutwardNo" />
             <input type="hidden" asp-for="CO_Disposal_ApprovalDate" />

             <input type="hidden" asp-for="CO_FurtherAppeal_Status_Option" />
             <input type="hidden" asp-for="CO_FurtherAppeal_CaseNumber" />
             <input type="hidden" asp-for="CO_FurtherAppeal_Year" />
             <input type="hidden" asp-for="CO_FurtherAppeal_EntrustmentNo" />
             <input type="hidden" asp-for="CO_FurtherAppeal_EntrustmentDate" />
             <input type="hidden" asp-for="CO_FurtherAppeal_AdvocateName" />
             <input type="hidden" asp-for="CO_FurtherAppeal_CaseStatus" />
             <input type="hidden" asp-for="CO_FurtherAppeal_DisposalOutwardNo" />
             <input type="hidden" asp-for="CO_FurtherAppeal_DisposalDate" />

             <input type="hidden" asp-for="CO_Claimant_DivisionName" />
             <input type="hidden" asp-for="CO_Claimant_ArisingOutOf" />
             <input type="hidden" asp-for="CO_Claimant_Court" />
             <input type="hidden" asp-for="CO_Claimant_CaseNumber" />
             <input type="hidden" asp-for="CO_Claimant_CaseYear" />
             <input type="hidden" asp-for="CO_Claimant_HighCourtBench" />
             <input type="hidden" asp-for="CO_Claimant_OriginalCaseStatus" />
             <input type="hidden" asp-for="CO_Claimant_IsConnected" />
             <input type="hidden" asp-for="CO_Claimant_EntrustmentNo" />
             <input type="hidden" asp-for="CO_Claimant_EntrustmentDate" />
             <input type="hidden" asp-for="CO_Claimant_AdvocateName" />
             <input type="hidden" asp-for="CO_Claimant_CaseStatus" />

             <input type="hidden" asp-for="CO_Service_Division" />
             <input type="hidden" asp-for="CO_Service_WPNumber" />
             <input type="hidden" asp-for="CO_Service_WPYear" />
             <input type="hidden" asp-for="CO_Service_PetitionerName" />
             <input type="hidden" asp-for="CO_Service_CaseNature" />
             <input type="hidden" asp-for="CO_Service_Prayer" />
             <input type="hidden" asp-for="CO_Service_IsEmployee" />
             <input type="hidden" asp-for="CO_Service_StayGranted" />
             <input type="hidden" asp-for="CO_Service_StayVacateFiled" />
             <input type="hidden" asp-for="CO_Service_Status" />
             <input type="hidden" asp-for="CO_Service_DisposalDate" />
             <input type="hidden" asp-for="CO_Service_ActionTaken" />
             <input type="hidden" asp-for="CO_Service_ApprovalSentDetails" />
             <input type="hidden" asp-for="CO_Service_OutwardNo" />
             <input type="hidden" asp-for="CO_Service_OutwardDate" />
             <input type="hidden" asp-for="CO_Service_AppealFiledBefore" />
             <input type="hidden" asp-for="CO_Service_AppealType" />
             <input type="hidden" asp-for="CO_Service_AppealEntrustmentDate" />
             <input type="hidden" asp-for="CO_Service_AppealAdvocate" />
             <input type="hidden" asp-for="CO_Service_AppealStatus" />
             <input type="hidden" asp-for="CO_Service_StayCompliance" />
             <input type="hidden" asp-for="CO_Service_ApprovalOutwardNo" />
             <input type="hidden" asp-for="CO_Service_ApprovalDate" />
             <input type="hidden" asp-for="CO_Service_EntrustmentNo" />
             <input type="hidden" asp-for="CO_Service_EntrustmentDate" />

             <input type="hidden" asp-for="IsClaimantSCPending" />
             <input type="hidden" asp-for="ClaimantSCDiaryNumber" />
             <input type="hidden" asp-for="ClaimantSCYear" />
             <input type="hidden" asp-for="ClaimantSCNumber" />
             <input type="hidden" asp-for="ClaimantSLPYear" />
             <input type="hidden" asp-for="ClaimantSCFiledBy" />
             <input type="hidden" asp-for="ClaimantSCEntrustmentNo" />
             <input type="hidden" asp-for="ClaimantSCEntrustmentDate" />
             <input type="hidden" asp-for="ClaimantSCAdvocate" />
             <input type="hidden" asp-for="ClaimantSCStatus" />
             <input type="hidden" asp-for="ClaimantSCOutcome" />
             <input type="hidden" asp-for="ClaimantSCActionTaken" />
             <input type="hidden" asp-for="ClaimantSCClosureNo" />
             <input type="hidden" asp-for="ClaimantSCClosureDate" />

             <input type="hidden" asp-for="IsViewedByCO" />
             <input type="hidden" asp-for="Opinion_CLO" />
            
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            
            <div class="d-flex align-items-center mb-4">
                <div class="icon-box bg-warning-subtle p-3 rounded-3 me-3">
                    <i class="bi bi-pencil-square fs-2 text-warning"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold text-dark">Update Labour Case</h3>
                    <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i> Modifying Case: <strong class="text-dark">@Model.CaseNumber</strong> (@Model.CaseYear)</p>
                </div>
                <div class="ms-auto">
                    <button type="submit" class="btn btn-warning text-dark btn-lg shadow-sm px-4">
                        <i class="bi bi-check-circle-fill me-2"></i> Update Changes
                    </button>
                </div>
            </div>



            <div class="accordion official-accordion mb-5" id="labourSections">
                
                <!-- SECTION 1: CASE IDENTIFICATION & BASIC DETAILS -->
                <div class="accordion-item shadow-sm border-0 mb-3">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#sec1">
                            <span class="badge bg-primary me-2 rounded-pill">1</span>
                            <span class="fw-bold text-dark">Case Identification & Basic Details</span>
                        </button>
                    </h2>
                    <div id="sec1" class="accordion-collapse collapse show" data-bs-parent="#labourSections">
                        <div class="accordion-body bg-light-subtle">
                            <div class="row g-3">
                                <!-- Row 1: Basic Status -->
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold text-uppercase">Division</label>
                                    <input type="hidden" asp-for="DivisionID" />
                                    <input type="text" class="form-control bg-light" readonly 
                                           value="@(ViewBag.Divisions != null ? ((IEnumerable<MVCCaseManagement.Models.Division>)ViewBag.Divisions).FirstOrDefault(d => d.DivisionID == Model.DivisionID)?.DivisionNameEnglish ?? "Not Set" : "Not Set")" />
                                    <span class="text-muted small">Division from case record</span>
                                </div>
                                <div class="col-md-4">
                                     <label class="form-label text-muted small fw-bold text-uppercase">Case Status</label>
                                    <select asp-for="CaseStatus" class="form-select border-primary-subtle fw-bold">
                                        <option value="Pending">Pending</option>
                                        <option value="Disposed">Disposed</option>
                                        <option value="DNP">DNP</option>
                                        <option value="Ex-parte">Ex-parte</option>
                                    </select>
                                    <span asp-validation-for="CaseStatus" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold text-uppercase">Case Type</label>
                                    <select asp-for="CaseType" class="form-select border-primary-subtle fw-bold" id="CaseType">
                                        <option value="">Select Type</option>
                                        <option value="REFERENCE(DISMISSAL/REMOVAL)">REFERENCE(DISMISSAL/REMOVAL)</option>
                                        <option value="REFERENCE(PUNISHMENT)">REFERENCE(PUNISHMENT)</option>
                                        <option value="ID PUNISHMENTS">ID PUNISHMENTS</option>
                                        <option value="Section 33C2">Section 33C2</option>
                                        <option value="KID/ID(DISMISSAL/REMOVAL)">KID/ID(DISMISSAL/REMOVAL)</option>
                                        <option value="Direct Application">Direct Application</option>
                                        <option value="Complaint">Complaint</option>
                                        <option value="Arising Application">Arising Application</option>
                                    </select>
                                    <span asp-validation-for="CaseType" class="text-danger small"></span>
                                </div>

                                <!-- Row 2: e-Courts Live Gateway Linkage -->
                                <div class="col-12">
                                    <div class="card border border-primary border-opacity-25 bg-primary-subtle bg-opacity-10 rounded-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <label class="form-label mb-0 fw-bold text-primary text-uppercase extra-small">
                                                    <i class="bi bi-broadcast me-1 text-danger animate-pulse"></i> Official e-Courts Live Gateway Linkage (CNR Integration)
                                                </label>
                                                @if (!string.IsNullOrEmpty(Model.CNRNumber))
                                                {
                                                    <span class="badge bg-success px-2 py-1 extra-small"><i class="bi bi-wifi me-1"></i>CNR Linked (@Model.CNRNumber)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark px-2 py-1 extra-small"><i class="bi bi-exclamation-triangle me-1"></i>Unlinked</span>
                                                }
                                            </div>
                                            <div class="row g-3 align-items-center">
                                                <div class="col-md-5">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-white border-primary-subtle font-monospace fw-bold text-primary">CNR</span>
                                                        <input asp-for="CNRNumber" class="form-control border-primary-subtle font-monospace fw-bold text-uppercase" id="txtCNRNumber" placeholder="16-digit CNR (e.g. KADW010012342024)" maxlength="16" />
                                                    </div>
                                                    <span asp-validation-for="CNRNumber" class="text-danger small"></span>
                                                </div>
                                                <div class="col-md-4">
                                                    <input asp-for="EstCode" class="form-control form-control-sm border-primary-subtle font-monospace" id="txtEstCode" placeholder="Establishment Code (e.g. KADW01)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm" onclick="autoFetchLabourCNR()">
                                                        <i class="bi bi-broadcast me-1"></i> Sync from e-Courts
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Live Sync Status Banner -->
                                            <div id="ecourtsSyncBanner" class="mt-3 p-2 bg-white rounded border border-success d-none">
                                                <div class="row g-2 extra-small text-dark">
                                                    <div class="col-md-3"><strong>Petitioner:</strong> <span id="lblEcourtsPetitioner" class="text-primary fw-bold">—</span></div>
                                                    <div class="col-md-3"><strong>Respondent:</strong> <span id="lblEcourtsRespondent" class="text-dark">—</span></div>
                                                    <div class="col-md-3"><strong>Current Stage:</strong> <span id="lblEcourtsStage" class="badge bg-warning text-dark">—</span></div>
                                                    <div class="col-md-3"><strong>Next Date:</strong> <span id="lblEcourtsNextDate" class="text-danger fw-bold">—</span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Row 3: Court Details -->
                                <div class="col-md-4">
                                    <label asp-for="CaseNumber" class="form-label small fw-bold text-uppercase">Case Number</label>
                                    <input asp-for="CaseNumber" class="form-control" placeholder="e.g. 101" />
                                    <span asp-validation-for="CaseNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CaseYear" class="form-label small fw-bold text-uppercase">Year</label>
                                    <input asp-for="CaseYear" class="form-control" type="number" />
                                    <span asp-validation-for="CaseYear" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CourtID" class="form-label small fw-bold text-uppercase">Court</label>
                                    <select asp-for="CourtID" class="form-select select2" id="ddlCourt" data-placeholder="-- Select Court --">
                                        <option value="">-- Select Court --</option>
                                        @if (courts != null)
                                        {
                                            foreach (var court in courts)
                                            {
                                                <option value="@court.CourtID">@court.CourtName (@court.Location)</option>
                                            }
                                        }
                                        <option value="0">Other (Manual Entry)</option>
                                    </select>
                                </div>
                                <div class="col-md-12" id="otherCourtDiv" style="display:none;">
                                    <input asp-for="OtherCourtDetails" class="form-control" placeholder="Enter Court Name & Location manually" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ARISING APPLICATION DETAILS (CONDITIONAL) -->
                <div id="divArisingDetails" style="display:none;" class="mb-5">
                    <div class="card border-0 shadow-sm overflow-hidden bg-light bg-opacity-50">
                        <div class="card-header bg-warning bg-opacity-10 py-3 border-bottom border-warning border-opacity-20 d-flex align-items-center">
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-diagram-3-fill me-2 text-warning"></i>ARISING APPLICATION DETAILS</h6>
                            <span class="badge bg-warning text-dark ms-2 small">Linked Case Required</span>
                        </div>
                        <div class="card-body p-4">
                            <!-- Search Original Case -->
                            <div class="bg-white p-4 rounded-4 shadow-sm border border-light mb-4">
                                <div class="row g-4 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-uppercase text-muted">Original Case Number</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-warning-subtle text-warning"><i class="bi bi-hash"></i></span>
                                            <input asp-for="Arising_OriginalCaseNumber" class="form-control border-warning-subtle" placeholder="e.g. 101" id="arisingCaseNo" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-uppercase text-muted">Case Year</label>
                                        <input asp-for="Arising_OriginalCaseYear" class="form-control border-warning-subtle" type="number" placeholder="YYYY" id="arisingCaseYear" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-uppercase text-muted">Jurisdiction Court</label>
                                        <select asp-for="Arising_OriginalCourt" class="form-select border-warning-subtle" id="arisingCourt">
                                            <option value="">-- SELECT COURT --</option>
                                            @if (courts != null)
                                            {
                                                foreach (var court in courts)
                                                {
                                                    <option value="@court.CourtName">@court.CourtName (@court.Location)</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-warning fw-bold w-100 shadow-sm py-2" id="btnSearchArisingCase" onclick="searchArisingCase()">
                                            <i class="bi bi-search me-2"></i>FIND ORIGINAL CASE
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Search Result Preview -->
                            <div id="arisingSearchResult" class="mb-4" style="display:none;">
                                <div id="arisingSearchError" class="alert alert-danger d-flex align-items-center small rounded-3" style="display:none;">
                                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i><span id="arisingErrorText"></span>
                                </div>
                                <div id="arisingSearchSuccess" style="display:none;">
                                    <div class="card border-success border-opacity-25 shadow-sm rounded-4 overflow-hidden">
                                        <div class="card-header bg-success bg-opacity-10 border-0 py-3 d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-link-45deg me-2 text-success"></i>Original Case Found</h6>
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold shadow-sm" onclick="showArisingCaseModal()">
                                                <i class="bi bi-info-circle me-1"></i> VIEW FULL FILE
                                            </button>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-borderless mb-0">
                                                    <tbody>
                                                        <tr class="border-bottom border-light">
                                                            <td class="ps-4 py-3 text-muted small fw-bold text-uppercase" style="width:20%;">Identity</td>
                                                            <td class="py-3 fw-bold text-dark" id="previewCaseNoYear"></td>
                                                            <td class="text-muted small fw-bold text-uppercase" style="width:15%;">Status</td>
                                                            <td class="py-3" id="previewStatus"></td>
                                                        </tr>
                                                        <tr class="border-bottom border-light">
                                                            <td class="ps-4 py-3 text-muted small fw-bold text-uppercase">Workman Name</td>
                                                            <td class="py-3 fw-bold text-dark" id="previewPetitioner"></td>
                                                            <td class="text-muted small fw-bold text-uppercase">Division</td>
                                                            <td class="py-3" id="previewDivision"></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Additional Status -->
                            <div class="row g-4 pt-2">
                                <div class="col-md-6">
                                    <label asp-for="Arising_ApplicationStatus" class="form-label small fw-bold text-muted text-uppercase">Application Status (Current)</label>
                                    <select asp-for="Arising_ApplicationStatus" class="form-select border-light shadow-xs">
                                        <option value="Pending">Pending</option>
                                        <option value="Stay Granted">Stay Granted</option>
                                        <option value="Stay Vacated">Stay Vacated</option>
                                        <option value="Disposed">Disposed</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Arising_CurrentStatus" class="form-label small fw-bold text-muted text-uppercase">Brief Status Remark</label>
                                    <input asp-for="Arising_CurrentStatus" class="form-control border-light shadow-xs" placeholder="e.g. Awaiting hearing..." />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: CASE NATURE & EMPLOYEE DETAILS -->
                 <div class="accordion-item shadow-sm border-0 mb-3">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sec2">
                             <span class="badge bg-secondary me-2 rounded-pill">2</span>
                             <span class="fw-bold text-dark">Case Nature & Employee Details</span>
                        </button>
                    </h2>
                    <div id="sec2" class="accordion-collapse collapse" data-bs-parent="#labourSections">
                        <div class="accordion-body bg-light-subtle">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="PetitionerName" class="form-label small fw-bold text-uppercase">Petitioner / Workman Name</label>
                                    <input asp-for="PetitionerName" class="form-control" />
