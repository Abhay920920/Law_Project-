                                     <div class="table-responsive border rounded bg-white shadow-sm">
                                         <table class="table table-bordered mb-0">
                                             <thead class="table-light">
                                                 <tr>
                                                     <th style="width: 25%;" class="small fw-bold text-muted">CURRENT STAGE</th>
                                                     <th style="width: 20%;" class="small fw-bold text-muted">NEXT HEARING DATE</th>
                                                     <th style="width: 55%;" class="small fw-bold text-muted">REMARKS / UPDATES</th>
                                                 </tr>
                                             </thead>
                                             <tbody>
                                                 <tr>
                                                     <td>
                                                         <input asp-for="CurrentStage" class="form-control border-0" placeholder="e.g. Evidence" />
                                                     </td>
                                                     <td>
                                                         <input asp-for="NextHearingDate" class="form-control border-0" type="date" value="@Model.NextHearingDate?.ToString("yyyy-MM-dd")" />
                                                     </td>
                                                     <td>
                                                         <textarea asp-for="CaseHistory" class="form-control border-0" rows="2" placeholder="Enter chronological updates...">@Model.CaseHistory</textarea>
                                                     </td>
                                                 </tr>
                                             </tbody>
                                         </table>
                                     </div>
                                     <small class="text-muted fst-italic mt-2 d-block">* These fields track the latest status of the case.</small>
                                 </div>
                             </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 4: DISPOSAL DETAILS -->
                <div class="accordion-item shadow-sm border-0 mb-3">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sec4">
                             <span class="badge bg-secondary me-2 rounded-pill">4</span>
                             <span class="fw-bold text-dark">Disposal Details</span>
                        </button>
                    </h2>
                    <div id="sec4" class="accordion-collapse collapse" data-bs-parent="#labourSections">
                        <div class="accordion-body bg-light-subtle">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="DisposalMode" class="form-label small fw-bold text-uppercase">Mode of Disposal</label>
                                    <select asp-for="DisposalMode" class="form-select" id="DisposalMode">
                                        <option value="">Select Mode</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Disposed-Merits">Disposed</option>
                                        <option value="DNP">DNP</option>
                                        <option value="Lok Adalat">Lok Adalat</option>
                                        <option value="Withdrawn">Withdrawn</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                     <label asp-for="DisposalDate" class="form-label small fw-bold text-uppercase">Disposal Date</label>
                                     <input asp-for="DisposalDate" class="form-control" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="DisposalResult" class="form-label small fw-bold text-uppercase">Outcome / Result</label>
                                    <select asp-for="DisposalResult" class="form-select" id="DisposalResult" onchange="toggleDisposalWorkflows(this)">
                                         <option value="">Select Result</option>
                                         <option value="Favor">In Favour of Corporation</option>
                                         <option value="Against">Against Corporation</option>
                                     </select>
                                </div>
                                
                                <!-- Favor Outcome Details -->
                                <div class="col-12" id="divFavorOutcome" style="@(Model.DisposalResult == "Favor" || Model.DisposalMode == "Lok Adalat" ? "" : "display:none;")">
                                    <div class="p-3 bg-success-subtle rounded border border-success">
                                        <h6 class="small fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-2"></i>Outcome Details (In Favour)</h6>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label asp-for="FavorRemark" class="form-label small fw-bold">Favor Remarks</label>
                                                <textarea asp-for="FavorRemark" class="form-control" rows="1"></textarea>
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="FavorOutwardDate" class="form-label small fw-bold">Outward Date</label>
                                                <input asp-for="FavorOutwardDate" class="form-control" type="date" />
                                            </div>
                                            <div class="col-md-12">
