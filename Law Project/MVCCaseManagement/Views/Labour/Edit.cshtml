                                 </div>
                                 <div class="col-md-4">
                                     <label asp-for="Against_PunishmentNo" class="form-label small fw-bold">Punishment No</label>
                                     <input asp-for="Against_PunishmentNo" class="form-control" />
                                 </div>
                                 <div class="col-md-4">
                                     <label asp-for="Against_PunishmentDate" class="form-label small fw-bold">Punishment Date</label>
                                     <input asp-for="Against_PunishmentDate" class="form-control" type="date" />
                                 </div>
                             </div>

                             <!-- 5.2 Departmental Enquiry -->
                             <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3 mt-4"><i class="bi bi-mortarboard me-2"></i>5.B DEPARTMENTAL ENQUIRY (DE) STATUS</h6>
                             <div class="row g-3 mb-4">

                                   <!-- Logic for DE Details -->
                                   <div class="col-md-4">
                                       <div class="p-3 bg-light rounded-3 border h-100 shadow-sm border-secondary border-opacity-10">
                                           <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Objections Filed (DE)?</label>
                                           <div class="d-flex gap-4 py-1">
                                               <div class="form-check">
                                                   <input class="form-check-input" type="radio" name="DE_ObjectionsFiled" value="true" id="de_obj_yes" @(Model.DE_ObjectionsFiled ? "checked" : "") onchange="toggleRemarkField('de_obj_no', 'divObjectionsRemark')">
                                                   <label class="form-check-label small fw-bold" for="de_obj_yes">YES</label>
                                               </div>
                                               <div class="form-check">
                                                   <input class="form-check-input" type="radio" name="DE_ObjectionsFiled" value="false" id="de_obj_no" @(!Model.DE_ObjectionsFiled ? "checked" : "") onchange="toggleRemarkField('de_obj_no', 'divObjectionsRemark')">
                                                   <label class="form-check-label small fw-bold" for="de_obj_no">NO</label>
                                               </div>
                                           </div>
                                           <div id="divObjectionsRemark" class="mt-3" style="@(Model.DE_ObjectionsFiled ? "" : "display:none;")">
                                               <textarea asp-for="DE_ObjectionsRemark" class="form-control form-control-sm border-secondary-subtle" rows="2" placeholder="Remarks on objections..."></textarea>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="col-md-4">
                                       <div class="p-3 bg-light rounded-3 border h-100 shadow-sm border-secondary border-opacity-10">
                                           <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Documents Marked (DE)?</label>
                                           <div class="d-flex gap-4 py-1">
                                               <div class="form-check">
                                                   <input class="form-check-input" type="radio" name="DE_DocumentsMarked" value="true" id="de_doc_yes" @(Model.DE_DocumentsMarked ? "checked" : "") onchange="toggleRemarkField('de_doc_no', 'divDocumentsRemark')">
                                                   <label class="form-check-label small fw-bold" for="de_doc_yes">YES</label>
                                               </div>
                                               <div class="form-check">
                                                   <input class="form-check-input" type="radio" name="DE_DocumentsMarked" value="false" id="de_doc_no" @(!Model.DE_DocumentsMarked ? "checked" : "") onchange="toggleRemarkField('de_doc_no', 'divDocumentsRemark')">
                                                   <label class="form-check-label small fw-bold" for="de_doc_no">NO</label>
                                               </div>
                                           </div>
                                           <div id="divDocumentsRemark" class="mt-3" style="@(Model.DE_DocumentsMarked ? "" : "display:none;")">
                                               <textarea asp-for="DE_DocumentsRemark" class="form-control form-control-sm border-secondary-subtle" rows="2" placeholder="Remarks on documents..."></textarea>
                                           </div>
                                       </div>
                                   </div>

                                   
                                    
                                   <div class="col-12">
                                       <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-2">
                                           <div class="card-header bg-secondary bg-opacity-10 border-0 py-3">
                                               <h6 class="mb-0 fw-bold text-secondary text-uppercase small"><i class="bi bi-people-fill me-2"></i>Witness & Evidence Details</h6>
                                           </div>
                                            <div class="card-body p-4">
                                                 <div class="p-3 bg-light rounded-3 border mb-4 shadow-sm border-secondary border-opacity-10" id="divEditEnquiryFindings">
                                                     <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-light pb-3">
                                                         <div class="d-flex flex-column">
                                                             <label asp-for="DE_Order" class="form-label small fw-bold mb-0 d-block text-muted text-uppercase">Findings On DE</label>
                                                             <div class="form-text small mt-1 mb-0"><i class="bi bi-info-circle me-1"></i>Final outcome of the enquiry.</div>
                                                         </div>
                                                         <div class="w-50">
                                                                 <select asp-for="DE_Order" class="form-select border-secondary-subtle fw-bold">
                                                                 <option value="">Select Finding</option>
                                                                 <option value="Affirmative(proved)">Affirmative (Proved)</option>
                                                                 <option value="Negative(not proved)">Negative (Not Proved)</option>
                                                             </select>
                                                         </div>
                                                     </div>
                                                     <div class="d-flex align-items-center justify-content-between">
                                                         <div class="d-flex flex-column">
                                                             <label asp-for="ChargesStatus" class="form-label small fw-bold mb-0 d-block text-muted text-uppercase">Charges Status</label>
                                                             <div class="form-text small mt-1 mb-0"><i class="bi bi-shield-check me-1"></i>Status of the charges.</div>
                                                         </div>
                                                         <div class="w-50">
                                                                 <select asp-for="ChargesStatus" class="form-select border-secondary-subtle fw-bold">
                                                                 <option value="">Select Status</option>
                                                                 <option value="Proved">Proved</option>
                                                                 <option value="Not Proved">Not Proved</option>
                                                             </select>
                                                         </div>
                                                     </div>
                                                 </div>
                                               <div class="row g-4">
                                                    <!-- EO Evidence -->
                                                   <div class="col-md-4" id="divEOEvidence">
                                                       <div class="p-3 border rounded-4 bg-white h-100 hover-shadow-sm transition">
                                                           <div class="d-flex flex-column gap-2 mb-3">
                                                               <label class="small text-secondary fw-bold text-uppercase mb-0">Enquiry Officer Evidence</label>
                                                               <div class="form-check form-switch bg-light p-2 rounded-3 border border-dashed text-center">
                                                                   <input class="form-check-input ms-0" type="checkbox" asp-for="DE_EO_IsBasedOnDocuments" id="toggle_EO_Docs" onchange="toggleWitnessRemark(this, 'div_EO_DocsRemark')" />
                                                                   <label class="form-check-label small text-muted text-uppercase fw-bold ms-2 cursor-pointer" for="toggle_EO_Docs" style="font-size: 0.65rem;">EVIDENCE BASED ON DOCUMENTS</label>
                                                               </div>
                                                               <div class="mt-2" id="div_EO_DocsRemark" style="display:@(Model.DE_EO_IsBasedOnDocuments ? "block" : "none");">
                                                                   <input asp-for="DE_EO_BasedOnDocsRemark" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Evidence Remarks..." />
                                                               </div>
                                                           </div>
                                                           <div class="row g-2 mt-auto">
                                                               <div class="col-12"><input asp-for="DE_EO_Name" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Officer Name" /></div>
                                                               <div class="col-12"><input asp-for="DE_EO_Designation" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Designation" /></div>
                                                           </div>
                                                       </div>
                                                   </div>
                                                   
                                                   <!-- Reporter Evidence -->
                                                   <div class="col-md-4" id="divReporterEvidence">
                                                       <div class="p-3 border rounded-4 bg-white h-100 hover-shadow-sm transition">
                                                           <div class="d-flex flex-column gap-2 mb-3">
                                                               <label class="small text-secondary fw-bold text-uppercase mb-0">Reporter Evidence</label>
                                                               <div class="form-check form-switch bg-light p-2 rounded-3 border border-dashed text-center">
                                                                   <input class="form-check-input ms-0" type="checkbox" asp-for="DE_Reporter_IsBasedOnDocuments" id="toggle_Reporter_Docs" onchange="toggleWitnessRemark(this, 'div_Reporter_DocsRemark')" />
                                                                   <label class="form-check-label small text-muted text-uppercase fw-bold ms-2 cursor-pointer" for="toggle_Reporter_Docs" style="font-size: 0.65rem;">EVIDENCE BASED ON DOCUMENTS</label>
                                                               </div>
                                                               <div class="mt-2" id="div_Reporter_DocsRemark" style="display:@(Model.DE_Reporter_IsBasedOnDocuments ? "block" : "none");">
                                                                   <input asp-for="DE_Reporter_BasedOnDocsRemark" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Evidence Remarks..." />
                                                               </div>
                                                           </div>
                                                           <div class="row g-2 mt-auto">
                                                               <div class="col-12"><input asp-for="DE_Reporter_Name" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Reporter Name" /></div>
                                                               <div class="col-12"><input asp-for="DE_Reporter_Designation" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Designation" /></div>
                                                           </div>
                                                       </div>
                                                   </div>
                                                   
                                                   <!-- Other Testimony -->
                                                   <div class="col-md-4" id="divOtherTestimony">
                                                       <div class="p-3 border rounded-4 bg-white h-100 hover-shadow-sm transition">
                                                           <div class="d-flex flex-column gap-2 mb-3">
                                                               <label class="small text-secondary fw-bold text-uppercase mb-0">Other Testimony</label>
                                                               <div class="form-check form-switch bg-light p-2 rounded-3 border border-dashed text-center">
                                                                   <input class="form-check-input ms-0" type="checkbox" asp-for="DE_Other_IsBasedOnDocuments" id="toggle_Other_Docs" onchange="toggleWitnessRemark(this, 'div_Other_DocsRemark')" />
                                                                   <label class="form-check-label small text-muted text-uppercase fw-bold ms-2 cursor-pointer" for="toggle_Other_Docs" style="font-size: 0.65rem;">EVIDENCE BASED ON DOCUMENTS</label>
                                                               </div>
                                                               <div class="mt-2" id="div_Other_DocsRemark" style="display:@(Model.DE_Other_IsBasedOnDocuments ? "block" : "none");">
                                                                   <input asp-for="DE_Other_BasedOnDocsRemark" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Evidence Remarks..." />
                                                               </div>
                                                           </div>
                                                           <div class="row g-2 mt-auto">
                                                               <div class="col-12"><input asp-for="DE_Other_Name" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Witness Name" /></div>
                                                               <div class="col-12"><input asp-for="DE_Other_Designation" class="form-control form-control-sm border-secondary-subtle shadow-xs" placeholder="Designation" /></div>
                                                           </div>
                                                       </div>
                                                   </div>
                                               </div>
                                           </div>
                                       </div>
                                   </div>
                             </div>

                             <!-- 5.3 Certified Copy -->
                             <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3"><i class="bi bi-file-earmark-check me-2"></i>5.C Certified Copy Details</h6>
                             <div class="row g-3 mb-4">
                                 <div class="col-md-3">
                                     <label asp-for="CC_CaseDisposedDate" class="form-label small fw-bold">Case Disposed On</label>
                                     <input asp-for="CC_CaseDisposedDate" class="form-control form-control-sm" type="date" />
                                 </div>
                                 <div class="col-md-3">
