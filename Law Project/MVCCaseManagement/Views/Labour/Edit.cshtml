                                                {
                                                    <div class="mt-2 text-end">
                                                        <a href="@Model.JudgmentCopyPath" target="_blank" class="btn btn-xs btn-outline-success">
                                                            <i class="bi bi-file-earmark-pdf me-1"></i>View Current Judgment
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Lok Adalat Logic -->
                                <div class="col-12" id="lokAdalatSection" style="display:none;">
                                    <div class="p-3 bg-white rounded border">
                                        <h6 class="small fw-bold text-dark mb-2">Lok Adalat Settlement</h6>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-bold mb-2 d-block">CO Approved?</label>
                                                <div class="d-flex gap-3">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="LokAdalat_COApprovalRequired" value="true" id="la_co_yes" onchange="toggleProgressDetails(this, 'divLokAdalatDetails')" @(Model.LokAdalat_COApprovalRequired ? "checked" : "")>
                                                        <label class="form-check-label small" for="la_co_yes">Yes</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="LokAdalat_COApprovalRequired" value="false" id="la_co_no" onchange="toggleProgressDetails(this, 'divLokAdalatDetails')" @(!Model.LokAdalat_COApprovalRequired ? "checked" : "")>
                                                        <label class="form-check-label small" for="la_co_no">No</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-8" id="divLokAdalatDetails" style="@(Model.LokAdalat_COApprovalRequired ? "" : "display:none;")">
