                    <h2 class="accordion-header">
                        <button class="accordion-button bg-danger-subtle text-danger fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#sec5">
                             <span class="badge bg-danger me-2 rounded-pill">5</span>
                             <span>Compulsory Actions (Against Corporation)</span>
                        </button>
                    </h2>
                    <div id="sec5" class="accordion-collapse collapse show" data-bs-parent="#labourSections">
                        <div class="accordion-body bg-white">
                            
                            <!-- 5.1 Work After Disposal -->
                             <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3 mt-2"><i class="bi bi-person-x-fill me-2"></i>5.A Work After Disposal</h6>
                             <div class="row g-3 mb-4">

                                  <div class="col-md-4">
                                     <label asp-for="Against_PunishmentImposed" class="form-label small fw-bold">Punishment Imposed</label>
