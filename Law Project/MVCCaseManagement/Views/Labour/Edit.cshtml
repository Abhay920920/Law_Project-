                                                        <div class="col-md-4">
                                                            <label asp-for="LokAdalat_OutwardNo" class="form-label small fw-bold text-muted text-uppercase">CO Outward No</label>
                                                            <input asp-for="LokAdalat_OutwardNo" class="form-control form-control-sm" />
                                                        </div>
                                                        <div class="col-md-4">
                                                             <label asp-for="LokAdalat_Date" class="form-label small fw-bold text-muted text-uppercase">Approval Date</label>
                                                             <input asp-for="LokAdalat_Date" class="form-control form-control-sm" type="date" />
                                                         </div>
                                                        <div class="col-md-4">
                                                            <label asp-for="LokAdalatDocumentFile" class="form-label small fw-bold text-muted text-uppercase">Upload Document</label>
                                                            <input asp-for="LokAdalatDocumentFile" class="form-control form-control-sm" type="file" />
                                                            @if (!string.IsNullOrEmpty(Model.LokAdalatDocumentPath))
                                                            {
                                                                <div class="mt-1">
                                                                    <a href="@Model.LokAdalatDocumentPath" target="_blank" class="small text-decoration-underline">View Document</a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 5: ADVERSE OUTCOME WORKFLOW (Conditional) -->
