                                        <option value="">Select Category</option>
                                        <option value="ABS">ABS</option>
                                        <option value="DFL">DFL</option>
                                        <option value="NINC">NINC</option>
                                        <option value="NIAC">NIAC</option>
                                        <option value="ACDT">ACDT</option>
                                        <option value="MISBEHAVE">MISBEHAVE</option>
                                        <option value="ALCOHOL">Alcohol</option>
                                        <option value="OTHERS">OTHERS</option>
                                    </select>
                                </div>
                                <div class="col-md-8" id="divEditBriefFacts">
                                    <label asp-for="NatureOfMisconduct" class="form-label small fw-bold text-uppercase">Nature of Misconduct / Brief Facts</label>
                                    <textarea asp-for="NatureOfMisconduct" class="form-control" rows="1"></textarea>
                                </div>
                                <div class="col-md-3" id="divEditPunishNature">
                                     <label asp-for="NatureOfCase" class="form-label small fw-bold text-uppercase">Punishment Imposed</label>
                                     <input asp-for="NatureOfCase" class="form-control" placeholder="Enter Punishment Imposed" id="NatureOfCase" />
                                </div>
                                <div class="row g-4 mt-2" id="divClaimDetailsRow" style="display:none;">
                                     <div class="col-md-12">
                                         <label class="form-label small fw-bold text-uppercase">Claim Details</label>
                                         <textarea asp-for="ClaimDetails" class="form-control" rows="3" placeholder="Enter specific claim details for 33(C)(2) or Direct Application..."></textarea>
                                     </div>
                                 </div>
                                <div class="col-md-2" id="divEditOrderNo">
                                    <label asp-for="Against_PunishmentNo" class="form-label small fw-bold text-uppercase">Order No</label>
                                    <input asp-for="Against_PunishmentNo" class="form-control" />
                                </div>
                                <div class="col-md-2" id="divEditOrderDate">
                                    <label asp-for="Against_PunishmentDate" class="form-label small fw-bold text-uppercase">Order Date</label>
                                    <input asp-for="Against_PunishmentDate" class="form-control" type="date" />
                                </div>
                                 <div class="col-md-5" id="divEditPunishCopy">
                                     <label asp-for="Against_PunishmentCopyFile" class="form-label small fw-bold text-uppercase">Upload Punishment Copy</label>
                                     <input asp-for="Against_PunishmentCopyFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                                     <input type="hidden" asp-for="Against_PunishmentCopyPath" />
                                     <input type="hidden" asp-for="ClaimPetitionPath" />
                                     @if (!string.IsNullOrEmpty(Model.Against_PunishmentCopyPath))
                                     {
                                         <div class="mt-1">
                                             <a href="@Model.Against_PunishmentCopyPath" target="_blank" class="small text-decoration-underline text-success">
                                                 <i class="bi bi-file-earmark-pdf me-1"></i>View Current Punishment Copy
                                             </a>
                                         </div>
                                     }
                                 </div>
                                 <div class="col-12"><hr class="my-3 border-secondary border-opacity-25" /></div>
                                 <div class="col-md-8">
                                     <label asp-for="AdvocateID" class="form-label small fw-bold text-uppercase">Advocate Name</label>
                                     <select asp-for="AdvocateID" class="form-select select2">
                                         <option value="">-- Select Advocate --</option>
                                         @if (ViewBag.Advocates != null)
                                         {
                                             foreach (var adv in (IEnumerable<MVCCaseManagement.Models.LabourAdvocate>)ViewBag.Advocates)
                                             {
                                                 <option value="@adv.AdvocateID">@adv.AdvocateName</option>
                                             }
                                         }
                                     </select>
                                     <input type="hidden" asp-for="AdvocateName" id="hdnAdvocateName" />
                                 </div>
                                 <div class="col-md-4 d-flex align-items-end flex-column">
                                     <div class="form-check form-switch mb-2 align-self-start">
                                        <input class="form-check-input" type="checkbox" asp-for="IsDoubleClaim" />
                                        <label class="form-check-label fw-bold" asp-for="IsDoubleClaim">Double Claim?</label>
                                    </div>
                                    <div id="divDoubleClaimRemarks" class="w-100" style="display:none;">
                                        <input asp-for="DoubleClaimRemarks" class="form-control form-control-sm" placeholder="Remarks for Double Claim" />
                                    </div>
                                 </div>
                                 <div class="col-md-6">
                                     <label asp-for="EntrustmentNo" class="form-label small fw-bold text-uppercase">Entrustment No</label>
                                     <input asp-for="EntrustmentNo" class="form-control" />
                                 </div>
                                 <div class="col-md-6">
                                     <label asp-for="EntrustmentDate" class="form-label small fw-bold text-uppercase">Entrustment Date</label>
                                     <input asp-for="EntrustmentDate" class="form-control" type="date" />
                                 </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: CASE PROGRESS -->
                <div class="accordion-item shadow-sm border-0 mb-3">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sec3">
                             <span class="badge bg-success me-2 rounded-pill shadow-sm">3</span>
                             <i class="bi bi-graph-up-arrow me-2 text-success"></i>
                             <span class="fw-bold text-dark">Case Progress</span>
                        </button>
                    </h2>
                    <div id="sec3" class="accordion-collapse collapse" data-bs-parent="#labourSections">
                        <div class="accordion-body bg-light-subtle">
                             <div class="row g-3">
                                <!-- Progress Checkboxes & Details -->
                                <div class="col-md-12">
                                    <div class="row">
                                        <!-- Document Sent -->
                                        <div class="col-md-4 mt-3">
                                            <div class="p-3 bg-light rounded-3 border h-100 shadow-sm border-success border-opacity-10">
                                                <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Document Sent?</label>
                                                <div class="d-flex gap-3">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="IsDocumentSent" value="true" id="doc_yes" onchange="toggleProgressDetails(this, 'divDocumentSentDetails')" @(Model.IsDocumentSent ? "checked" : "")>
                                                        <label class="form-check-label small fw-bold" for="doc_yes">YES</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="IsDocumentSent" value="false" id="doc_no" onchange="toggleProgressDetails(this, 'divDocumentSentDetails')" @(!Model.IsDocumentSent ? "checked" : "")>
                                                        <label class="form-check-label small fw-bold" for="doc_no">NO</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8 mt-3" id="divDocumentSentDetails" style="@(Model.IsDocumentSent ? "" : "display:none;")">
                                            <div class="p-3 border rounded-3 bg-white h-100 shadow-sm border-success border-opacity-10 border-dashed">
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                         <label class="form-label small fw-bold text-muted text-uppercase">Outward No</label>
                                                         <input asp-for="DocumentSent_OutwardNo" class="form-control border-success-subtle shadow-xs" placeholder="Outward No" />
                                                    </div>
                                                    <div class="col-md-6">
                                                         <label class="form-label small fw-bold text-muted text-uppercase">Outward Date</label>
                                                         <input asp-for="DocumentSent_OutwardDate" class="form-control border-success-subtle shadow-xs" type="date" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Objection Filed -->
                                        <div class="col-md-4 mt-3">
                                            <div class="p-3 bg-light rounded-3 border h-100 shadow-sm border-success border-opacity-10">
                                                <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Objection Filed?</label>
                                                <div class="d-flex gap-3">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="IsObjectionFiled" value="true" id="obj_yes" onchange="toggleProgressDetails(this, 'divObjectionFiledDetails')" @(Model.IsObjectionFiled ? "checked" : "")>
                                                        <label class="form-check-label small fw-bold" for="obj_yes">YES</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="IsObjectionFiled" value="false" id="obj_no" onchange="toggleProgressDetails(this, 'divObjectionFiledDetails')" @(!Model.IsObjectionFiled ? "checked" : "")>
                                                        <label class="form-check-label small fw-bold" for="obj_no">NO</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8 mt-3" id="divObjectionFiledDetails" style="@(Model.IsObjectionFiled ? "" : "display:none;")">
                                            <div class="p-3 border rounded-3 bg-white h-100 shadow-sm border-success border-opacity-10 border-dashed">
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                         <label class="form-label small fw-bold text-muted text-uppercase">Outward No</label>
                                                         <input asp-for="ObjectionFiled_OutwardNo" class="form-control border-success-subtle shadow-xs" placeholder="Outward No" />
                                                    </div>
                                                    <div class="col-md-6">
                                                         <label class="form-label small fw-bold text-muted text-uppercase">Outward Date</label>
                                                         <input asp-for="ObjectionFiled_OutwardDate" class="form-control border-success-subtle shadow-xs" type="date" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Evidence Details -->
                                        <div class="col-md-12 mt-3">
                                            <div class="row g-3">
                                                <!-- Enquiry Officer Evidence -->
                                                <div class="col-md-4">
                                                    <div class="p-2 bg-light rounded border h-100">
                                                        <label class="form-label fw-bold small mb-2 d-block">Enquiry Officer Evidence?</label>
                                                        <div class="d-flex gap-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" asp-for="IsEnquiryOfficerEvidence" value="true" id="eo_ev_yes" />
                                                                <label class="form-check-label small" for="eo_ev_yes">Yes</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" asp-for="IsEnquiryOfficerEvidence" value="false" id="eo_ev_no" />
                                                                <label class="form-check-label small" for="eo_ev_no">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Reporter Evidence -->
                                                <div class="col-md-4">
                                                    <div class="p-2 bg-light rounded border h-100">
                                                        <label class="form-label fw-bold small mb-2 d-block">Reporter Evidence?</label>
                                                        <div class="d-flex gap-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" asp-for="IsReporterEvidence" value="true" id="rep_ev_yes" />
                                                                <label class="form-check-label small" for="rep_ev_yes">Yes</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" asp-for="IsReporterEvidence" value="false" id="rep_ev_no" />
                                                                <label class="form-check-label small" for="rep_ev_no">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Other Evidence -->
                                                <div class="col-md-4">
                                                    <div class="p-2 bg-light rounded border h-100">
                                                        <label class="form-label fw-bold small mb-2 d-block">Other Evidence?</label>
                                                        <div class="d-flex gap-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" asp-for="IsOtherEvidence" value="true" id="oth_ev_yes" />
                                                                <label class="form-check-label small" for="oth_ev_yes">Yes</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" asp-for="IsOtherEvidence" value="false" id="oth_ev_no" />
                                                                <label class="form-check-label small" for="oth_ev_no">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                 <!-- Claim Petition, Delay & Limitation Details -->
                                 <div class="col-md-12 mt-4" id="divClaimPetitionRow">
                                     <div class="p-4 rounded-4 border shadow-sm bg-white">
                                         <h6 class="text-primary fw-bold text-uppercase small mb-3"><i class="bi bi-file-earmark-text me-2"></i>Claim Petition &amp; Filing Details</h6>
                                         <div class="row g-3">
                                             <div class="col-md-12">
                                                 <label asp-for="ClaimPetitionFile" class="form-label small fw-bold text-uppercase">Claim Petition upload</label>
                                                 <input asp-for="ClaimPetitionFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                                                 @if (!string.IsNullOrEmpty(Model.ClaimPetitionPath))
                                                 {
                                                     <div class="mt-1">
                                                         <a href="@Model.ClaimPetitionPath" target="_blank" class="small text-decoration-underline text-success">
                                                             <i class="bi bi-file-earmark-pdf me-1"></i>View Current Claim Petition
                                                         </a>
                                                     </div>
                                                 }
                                             </div>
                                             <div class="col-md-6">
                                                 <label class="form-label small fw-bold text-uppercase">Claim Filed On</label>
                                                 <input asp-for="ClaimFiledOn" class="form-control" type="date" />
                                             </div>
                                             <div class="col-md-6">
                                                 <label class="form-label small fw-bold text-uppercase">Delay In Filing</label>
                                                 <input asp-for="DelayInFiling" class="form-control" />
                                             </div>
                                         </div>
                                     </div>
                                 </div>

                                 <!-- Limitation & Delay Details -->
                                 <div class="col-md-12 mt-4">
                                     <div class="p-4 rounded-4 border shadow-sm" style="background: #fffafa; border: 1px solid #fee2e2 !important;">
                                         <h6 class="text-danger fw-bold text-uppercase small mb-4">
                                             <i class="bi bi-clock-history me-2"></i>Limitation & Delay Details
                                         </h6>
                                         <div class="row g-4">
                                             <div class="col-md-4">
                                                 <label class="form-label small fw-bold text-secondary text-uppercase mb-2 d-block">Filed within Limitation?</label>
                                                 <div class="d-flex gap-4 p-2 bg-white rounded border border-danger-subtle shadow-sm px-3">
                                                     <div class="form-check">
                                                         <input class="form-check-input" type="radio" asp-for="IsFiledWithinLimitation" value="true" id="limitation_yes" onchange="document.getElementById('divLimitationRemark').style.display='none'; document.getElementById('divDelayRadio').style.display='none'; document.getElementById('divDelayRemark').style.display='none';" />
                                                         <label class="form-check-label fw-semibold text-success ms-1" for="limitation_yes">YES</label>
                                                     </div>
                                                     <div class="form-check">
                                                         <input class="form-check-input" type="radio" asp-for="IsFiledWithinLimitation" value="false" id="limitation_no" onchange="document.getElementById('divLimitationRemark').style.display='block'; document.getElementById('divDelayRadio').style.display='block';" />
                                                         <label class="form-check-label fw-semibold text-danger ms-1" for="limitation_no">NO</label>
                                                     </div>
                                                 </div>
                                             </div>
                                             <div class="col-md-8" id="divLimitationRemark" style="display:@(Model.IsFiledWithinLimitation == false ? "block" : "none");">
                                                 <label asp-for="LimitationRemark" class="form-label small fw-bold text-secondary text-uppercase mb-2">Limitation Remark</label>
                                                 <input asp-for="LimitationRemark" class="form-control shadow-sm border-danger-subtle" placeholder="Enter remarks regarding limitation..." />
                                             </div>

                                             <div class="col-md-4" id="divDelayRadio" style="display:@(Model.IsFiledWithinLimitation == false ? "block" : "none");">
                                                 <label class="form-label small fw-bold text-secondary text-uppercase mb-2 d-block">Delay condoned?</label>
                                                 <div class="d-flex gap-4 p-2 bg-white rounded border border-danger-subtle shadow-sm px-3">
                                                     <div class="form-check">
                                                         <input class="form-check-input" type="radio" asp-for="IsDelayCondoned" value="true" id="delay_yes" onchange="document.getElementById('divDelayRemark').style.display='none'" />
                                                         <label class="form-check-label fw-semibold text-success ms-1" for="delay_yes">YES</label>
                                                     </div>
                                                     <div class="form-check">
                                                         <input class="form-check-input" type="radio" asp-for="IsDelayCondoned" value="false" id="delay_no" onchange="document.getElementById('divDelayRemark').style.display='block'" />
                                                         <label class="form-check-label fw-semibold text-danger ms-1" for="delay_no">NO</label>
                                                     </div>
                                                 </div>
                                             </div>
                                             <div class="col-md-8" id="divDelayRemark" style="display:@(Model.IsDelayCondoned == false && Model.IsFiledWithinLimitation == false ? "block" : "none");">
                                                 <label asp-for="DelayCondonationRemark" class="form-label small fw-bold text-secondary text-uppercase mb-2">Delay Condonation Remark</label>
                                                 <input asp-for="DelayCondonationRemark" class="form-control shadow-sm border-danger-subtle" placeholder="Enter remarks regarding delay condonation..." />
                                             </div>
                                         </div>
                                     </div>
                                 </div>

                                <!-- History Sheet Prepared Section -->
                                <div class="col-md-12 mt-4" id="divEditHistorySheet">
                                    <div class="p-4 rounded-4 border shadow-sm" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                                        <h6 class="text-primary fw-bold text-uppercase small mb-4">
                                            <i class="bi bi-file-earmark-person me-2"></i>History Sheet Details
                                        </h6>
                                        <div class="row g-4">
                                            <div class="col-md-4">
                                                  <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Any history sheet available?</label>
                                                <div class="d-flex gap-4 p-2 bg-white rounded border border-primary-subtle shadow-sm px-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="DE_HistorySheet" value="true" id="de_hs_yes" onchange="toggleProgressDetails(this, 'divHistorySheetUpload')" @(Model.DE_HistorySheet ? "checked" : "")>
                                                        <label class="form-check-label fw-semibold text-success ms-1" for="de_hs_yes">YES</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="DE_HistorySheet" value="false" id="de_hs_no" onchange="toggleProgressDetails(this, 'divHistorySheetUpload')" @(!Model.DE_HistorySheet ? "checked" : "")>
                                                        <label class="form-check-label fw-semibold text-danger ms-1" for="de_hs_no">NO</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-8" id="divHistorySheetUpload" style="@(Model.DE_HistorySheet ? "" : "display:none;")">
                                                <div class="p-3 bg-white rounded-3 border border-dashed h-100 shadow-sm border-secondary border-opacity-10">
                                                    <label asp-for="HistorySheetFile" class="form-label small fw-bold text-muted text-uppercase mb-2">Upload History Sheet (Scan)</label>
                                                    <div class="input-group">
                                                         <span class="input-group-text bg-light"><i class="bi bi-cloud-arrow-up text-primary"></i></span>
                                                         <input asp-for="HistorySheetFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(Model.DE_HistorySheetPath))
                                                    {
                                                        <div class="mt-2 text-end">
                                                            <a href="@Model.DE_HistorySheetPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                                                <i class="bi bi-file-earmark-pdf me-1"></i>View Current History Sheet
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6 mt-4" id="divTerminalBenefits">
                                                <div class="p-3 bg-white rounded-3 border border-primary-subtle shadow-sm h-100">
                                                    <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Any Terminal Benefits paid</label>
                                                    <input asp-for="TerminalBenefitsPaid" class="form-control form-control-sm shadow-sm border-primary-subtle" placeholder="Details of benefits paid..." />
                                                </div>
                                            </div>
                                            <div class="col-md-6 mt-4" id="divSerialApp">
                                                <div class="p-3 bg-white rounded-3 border border-primary-subtle shadow-sm h-100">
                                                    <label class="form-label fw-bold small mb-2 d-block text-muted text-uppercase">Serial Application Case Details</label>
                                                    <input asp-for="SerialApplicationDetails" class="form-control form-control-sm shadow-sm border-primary-subtle" placeholder="Serial application summary..." />
                                                </div>
                                            </div>

                                            <div class="col-md-6 mt-4" id="divRepeatDismissal">
