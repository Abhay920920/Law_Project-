                                            <i class="bi bi-file-earmark-text me-2"></i>Serial Application Case Details
                                        </h6>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label asp-for="SerialApp_CaseNumber" class="form-label small fw-bold text-secondary text-uppercase">Case Number</label>
                                                <input asp-for="SerialApp_CaseNumber" class="form-control shadow-sm border-primary-subtle" placeholder="Enter case number..." />
                                            </div>
                                            <div class="col-md-8">
                                                <label asp-for="SerialApp_CurrentStage" class="form-label small fw-bold text-secondary text-uppercase">Current Stage</label>
                                                <input asp-for="SerialApp_CurrentStage" class="form-control shadow-sm border-primary-subtle" placeholder="Enter current stage..." />
                                            </div>
                                        </div>
                                    </div>
