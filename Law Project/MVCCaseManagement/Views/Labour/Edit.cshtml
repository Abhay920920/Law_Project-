                                 <div class="col-md-3">
                                     <label asp-for="CC_IssuedDate" class="form-label small fw-bold">Copy Issued</label>
                                     <input asp-for="CC_IssuedDate" class="form-control form-control-sm" type="date" />
                                 </div>
                                 <div class="col-md-3">
                                     <label asp-for="CC_DeliveredDate" class="form-label small fw-bold">Copy Delivered</label>
                                     <input asp-for="CC_DeliveredDate" class="form-control form-control-sm" type="date" />
                                 </div>
                                 <div class="col-md-3">
                                     <label asp-for="CC_ReceivedDate" class="form-label small fw-bold">Copy Received</label>
                                     <input asp-for="CC_ReceivedDate" class="form-control form-control-sm" type="date" />
                                 </div>
                                 <div class="col-md-6">
                                     <label asp-for="CC_Remarks" class="form-label small fw-bold">Remarks</label>
                                     <input asp-for="CC_Remarks" class="form-control form-control-sm" />
                                 </div>
                             </div>

                             <!-- 5.4 Opinion & CO -->
                             <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3"><i class="bi bi-chat-left-text me-2"></i>5.D Award details</h6>
                             <div class="row g-3">
                                 <div class="col-12">
                                     <label asp-for="AwardDetails" class="form-label small fw-bold">Award Details</label>
                                     <input asp-for="AwardDetails" class="form-control" />
                                 </div>
                                 <div class="col-md-4">
                                     <label asp-for="Opinion_Advocate" class="form-label small fw-bold">Opinion of Advocate</label>
                                     <textarea asp-for="Opinion_Advocate" class="form-control" rows="2"></textarea>
                                 </div>
                                 <div class="col-md-4">
                                     <label asp-for="Opinion_LO" class="form-label small fw-bold">Asst/Law Officer (LO) Opinion</label>
                                     <textarea asp-for="Opinion_LO" class="form-control" rows="2"></textarea>
                                 </div>
                                 <div class="col-md-4">
                                     <label asp-for="Opinion_DC" class="form-label small fw-bold">Opinion of DC</label>
                                     <textarea asp-for="Opinion_DC" class="form-control" rows="2"></textarea>
                                 </div>

                                 <div class="col-md-12 mt-3">
                                     <label asp-for="JudgmentCopyFile" class="form-label small fw-bold">Upload Judgment / Order Copy</label>
                                     <input asp-for="JudgmentCopyFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                                     <div class="form-text">Attach the final judgment or order copy here.</div>
                                     @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath))
                                     {
                                         <div class="mt-2 text-success">
                                             <i class="bi bi-check-circle-fill"></i> <strong>Current File:</strong> 
                                             <a href="@Model.JudgmentCopyPath" target="_blank" class="text-success text-decoration-underline ms-1">
                                                View Uploaded Judgment Copy
                                             </a>
                                         </div>
                                     }
                                 </div>
                                 
                                 <div class="col-md-8 mt-4">
                                     <label class="form-label small fw-bold">Action Taken</label>
                                     <select asp-for="SentToCO" class="form-select" id="ddlCOAction">
                                         <option value="">STILL PENDING AT DIVISION</option>
                                         <option value="true">Sent to Central Office</option>
                                     </select>
                                 </div>
                                 
                                 <!-- Closed at Division -->
                                 <div class="col-md-8 mt-4" id="divClosedAtDivision">
                                     <label asp-for="CO_Remarks" class="form-label small fw-bold">Remarks / Pending Details</label>
                                     <textarea asp-for="CO_Remarks" class="form-control" rows="1"></textarea>
                                 </div>

                                 <!-- Sent to CO -->
                                 <div class="col-md-8 mt-4" id="divSentToCO" style="display:none;">
                                     <div class="row g-3">
                                         <div class="col-md-6">
                                             <label asp-for="CO_OutwardNo" class="form-label small fw-bold">CO Outward No</label>
                                             <input asp-for="CO_OutwardNo" class="form-control" />
                                         </div>
                                         <div class="col-md-6">
                                             <label asp-for="CO_OutwardDate" class="form-label small fw-bold">CO Outward Date</label>
                                             <input asp-for="CO_OutwardDate" class="form-control" type="date" />
                                         </div>
                                     </div>
                                 </div>
                             </div>

                        </div>
                    </div>
                </div>

                <!-- SECTION 6: ARISING APPLICATION -->
                <div class="accordion-item shadow-sm border-0 mb-3" id="arisingSection" style="display:none;">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-warning-subtle text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#sec6">
                             <span class="badge bg-warning text-dark me-2 rounded-pill">6</span>
                             <span class="fw-bold">Arising / Non-Compliance Details</span>
                        </button>
                    </h2>
                    <div id="sec6" class="accordion-collapse collapse show" data-bs-parent="#labourSections">
                        <div class="accordion-body bg-light-subtle">
                             <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="Arising_OriginalCaseNumber" class="form-label small fw-bold">Original Case No</label>
                                    <input asp-for="Arising_OriginalCaseNumber" class="form-control" placeholder="Original KID/ID No" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Arising_OriginalCaseYear" class="form-label small fw-bold">Original Year</label>
                                    <input asp-for="Arising_OriginalCaseYear" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Arising_OriginalCourt" class="form-label small fw-bold">Original Court</label>
                                    <input asp-for="Arising_OriginalCourt" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Arising_CurrentStatus" class="form-label small fw-bold">Status of Arising Case</label>
                                    <input asp-for="Arising_CurrentStatus" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Arising_ApplicationStatus" class="form-label small fw-bold">Status of Application (e-Courts)</label>
                                    <input asp-for="Arising_ApplicationStatus" class="form-control" />
                                </div>
                             </div>
                        </div>
                    </div>
                </div>

                 <!-- SECTION 7: FULL CASE HISTORY & ACTION TRACKING (Read-Only) -->
                 @if (Model.CaseID > 0 && (Model.SentToCO == true || !string.IsNullOrEmpty(Model.CO_WP_CaseNumber) || !string.IsNullOrEmpty(Model.CO_WA_CaseNumber) || Model.CO_IsWorkmanReinstated))
                 {
                    <div class="accordion-item shadow-sm border-0 mb-3 overflow-hidden">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-dark text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#secHistory">
                                 <span class="badge bg-primary me-2 rounded-pill">7</span>
                                 <i class="bi bi-journal-text me-2"></i>
                                 <span>Full Case History & Action Tracking (Read-Only)</span>
                            </button>
                        </h2>
                        <div id="secHistory" class="accordion-collapse collapse" data-bs-parent="#labourSections">
                            <div class="accordion-body p-0">
                                <div class="accordion accordion-flush" id="nestedHistory">
                                    <!-- A. Initial CO Action -->
                                    <div class="accordion-item">
                                        <h2 class="accordion-header"><button class="accordion-button py-2 small fw-bold" data-bs-toggle="collapse" data-bs-target="#hist1">1. Initial CO Action & Feasibility</button></h2>
                                        <div id="hist1" class="accordion-collapse collapse show" data-bs-parent="#nestedHistory">
                                            <div class="accordion-body small bg-light">
                                                <div class="row g-3">
                                                    <div class="col-md-4"><label class="text-muted d-block">Action Taken</label><div class="fw-bold">@Model.CO_ActionTaken</div></div>
                                                    <div class="col-md-4"><label class="text-muted d-block">Feasibility Received?</label><div class="fw-bold">@(Model.CO_FeasibilityReceived == true ? "Yes" : "No") (@Model.CO_FeasibilityDate?.ToShortDateString())</div></div>
                                                    <div class="col-md-4"><label class="text-muted d-block">Approval No/Date</label><div class="fw-bold">@Model.CO_ApprovalOutwardNo / @Model.CO_ApprovalDate?.ToShortDateString()</div></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- B. High Court WP (Corp) -->
                                    @if (!string.IsNullOrEmpty(Model.CO_WP_CaseNumber) || Model.CO_WP_CaseStatus_Option == "Pending for Filing")
                                    {
                                        <div class="accordion-item">
                                            <h2 class="accordion-header"><button class="accordion-button collapsed py-2 small fw-bold" data-bs-toggle="collapse" data-bs-target="#hist2">2. Writ Petition (HC - Corporation)</button></h2>
                                            <div id="hist2" class="accordion-collapse collapse" data-bs-parent="#nestedHistory">
                                                <div class="accordion-body small bg-white">
                                                    <div class="row g-3">
                                                        <div class="col-md-4"><label class="text-muted d-block">WP Number</label><div class="fw-bold">@(Model.CO_WP_CaseStatus_Option == "Pending for Filing" ? "Pending for Filing" : Model.CO_WP_CaseNumber + " / " + Model.CO_WP_Year)</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Advocate</label><div class="fw-bold">@Model.CO_WP_AdvocateName</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Status</label><div class="fw-bold text-primary">@Model.CO_WP_Status (@Model.CO_WP_Outcome)</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Stay Granted?</label><div class="fw-bold">@(Model.CO_WP_StayGranted == true ? "Yes" : "No") (@Model.CO_WP_StayNature)</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Stay Date</label><div class="fw-bold">@Model.CO_WP_StayDate?.ToShortDateString()</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Outcome Action</label><div class="fw-bold">@Model.CO_WP_ActionTaken</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- C. Writ Appeal (WA) -->
                                    @if (!string.IsNullOrEmpty(Model.CO_WA_CaseNumber))
                                    {
                                        <div class="accordion-item">
                                            <h2 class="accordion-header"><button class="accordion-button collapsed py-2 small fw-bold" data-bs-toggle="collapse" data-bs-target="#histWA">3. Writ Appeal (Corporation)</button></h2>
                                            <div id="histWA" class="accordion-collapse collapse" data-bs-parent="#nestedHistory">
                                                <div class="accordion-body small bg-light">
                                                    <div class="row g-3">
                                                        <div class="col-md-4"><label class="text-muted d-block">WA Number</label><div class="fw-bold">@Model.CO_WA_CaseNumber / @Model.CO_WA_Year</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Status</label><div class="fw-bold">@Model.CO_WA_Status</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Stay Granted?</label><div class="fw-bold">@(Model.CO_WA_StayGranted == true ? "Yes" : "No")</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- D. Workman Reinstatement -->
                                    @if (Model.CO_IsWorkmanReinstated)
                                    {
                                        <div class="accordion-item">
                                            <h2 class="accordion-header"><button class="accordion-button collapsed py-2 small fw-bold" data-bs-toggle="collapse" data-bs-target="#hist3">4. Workman Reinstatement Details</button></h2>
                                            <div id="hist3" class="accordion-collapse collapse" data-bs-parent="#nestedHistory">
                                                <div class="accordion-body small bg-white">
                                                    <div class="row g-3">
                                                        <div class="col-md-4"><label class="text-muted d-block">Subject to WP?</label><div class="fw-bold">@Model.CO_ReinstatedSubjectToWP</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Approval Date</label><div class="fw-bold">@Model.CO_ReinstatementApprovalDate?.ToShortDateString()</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Approval No</label><div class="fw-bold">@Model.CO_Reinstatement_ApprovalNo</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- E. Supreme Court Appeal (Claimant) -->
                                    @if (!string.IsNullOrEmpty(Model.ClaimantSCNumber) || !string.IsNullOrEmpty(Model.ClaimantSCDiaryNumber))
                                    {
                                        <div class="accordion-item">
                                            <h2 class="accordion-header"><button class="accordion-button collapsed py-2 small fw-bold" data-bs-toggle="collapse" data-bs-target="#histSC">5. Supreme Court Appeal Details</button></h2>
                                            <div id="histSC" class="accordion-collapse collapse" data-bs-parent="#nestedHistory">
                                                <div class="accordion-body small bg-light">
                                                    <div class="row g-3">
                                                        <div class="col-md-4"><label class="text-muted d-block">Diary No/Year</label><div class="fw-bold">@Model.ClaimantSCDiaryNumber / @Model.ClaimantSCYear</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">SLP No/Year</label><div class="fw-bold">@Model.ClaimantSCNumber / @Model.ClaimantSLPYear</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Status</label><div class="fw-bold">@Model.ClaimantSCStatus</div></div>
                                                        <div class="col-md-6"><label class="text-muted d-block">Advocate</label><div class="fw-bold">@Model.ClaimantSCAdvocate</div></div>
                                                        <div class="col-md-6"><label class="text-muted d-block">Outcome</label><div class="fw-bold">@Model.ClaimantSCOutcome</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- F. Service Matters -->
                                    @if (!string.IsNullOrEmpty(Model.CO_Service_WPNumber))
                                    {
                                        <div class="accordion-item">
                                            <h2 class="accordion-header"><button class="accordion-button collapsed py-2 small fw-bold" data-bs-toggle="collapse" data-bs-target="#histServ">6. Service Matter / Direct WP Details</button></h2>
                                            <div id="histServ" class="accordion-collapse collapse" data-bs-parent="#nestedHistory">
                                                <div class="accordion-body small bg-white">
                                                    <div class="row g-3">
                                                        <div class="col-md-4"><label class="text-muted d-block">WP Number/Year</label><div class="fw-bold">@Model.CO_Service_WPNumber / @Model.CO_Service_WPYear</div></div>
                                                        <div class="col-md-8"><label class="text-muted d-block">Prayer</label><div class="p-2 border bg-light">@Model.CO_Service_Prayer</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Status</label><div class="fw-bold">@Model.CO_Service_Status (@Model.CO_Service_ActionTaken)</div></div>
                                                        <div class="col-md-4"><label class="text-muted d-block">Outward No/Date</label><div class="fw-bold">@Model.CO_Service_OutwardNo / @Model.CO_Service_OutwardDate?.ToShortDateString()</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                 }
            </div>

            <div class="card shadow-sm border-0 mb-5 overflow-hidden">
                <div class="card-body p-4 bg-warning bg-opacity-25 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Update Case Details</h5>
                        <p class="text-muted small mb-0">Commit your changes to the database for Case No: <strong class="text-dark">@Model.CaseNumber</strong></p>
                    </div>
                    <button type="submit" class="btn btn-warning btn-lg px-5 shadow text-dark fw-bold">
                        <i class="bi bi-check-circle-fill me-2"></i> Update & Save Changes
                    </button>
                </div>
            </div>

            <!-- Arising Case Details Modal -->
            <div class="modal fade" id="arisingCaseModal" tabindex="-1" aria-labelledby="arisingCaseModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                        <div class="modal-header bg-warning bg-opacity-10 border-0 py-3">
                            <h5 class="modal-title fw-bold" id="arisingCaseModalLabel">
                                <i class="bi bi-file-earmark-text me-2 text-warning"></i>Original Case Details
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <!-- Case Identity -->
                            <div class="mb-4">
                                <h6 class="text-primary fw-bold text-uppercase small border-bottom border-primary border-opacity-25 pb-2 mb-3">
                                    <i class="bi bi-fingerprint me-2"></i>Case Identification
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Case Number / Year</div>
                                            <div class="fw-bold text-dark" id="modalCaseNoYear">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Case Type</div>
                                            <div class="fw-bold text-dark" id="modalCaseType">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Case Status</div>
                                            <div id="modalCaseStatus">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Court</div>
                                            <div class="fw-semibold" id="modalCourt">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Division</div>
                                            <div class="fw-semibold" id="modalDivision">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Advocate</div>
                                            <div class="fw-semibold" id="modalAdvocate">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12" id="divModalOtherCourt" style="display:none;">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Other Court Details</div>
                                            <div class="fw-semibold" id="modalOtherCourt">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Double Claim?</div>
                                            <div class="fw-semibold" id="modalIsDoubleClaim">—</div>
                                            <div class="small text-muted mt-1" id="modalDoubleClaimRemarks"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Employee Details -->
                            <div class="mb-4">
                                <h6 class="text-success fw-bold text-uppercase small border-bottom border-success border-opacity-25 pb-2 mb-3">
                                    <i class="bi bi-person-badge me-2"></i>Employee / Petitioner Details
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Petitioner Name</div>
                                            <div class="fw-bold text-dark" id="modalPetitioner">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Badge Number</div>
                                            <div class="fw-semibold" id="modalEmployeeNo">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Designation</div>
                                            <div class="fw-semibold" id="modalDesignation">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Working Status</div>
                                            <div class="fw-semibold" id="modalWorkingStatus">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Nature of Case</div>
                                            <div class="fw-semibold" id="modalNatureOfCase">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Entrustment No / Date</div>
                                            <div class="fw-semibold" id="modalEntrustment">—</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Progress & Evidence -->
                            <div class="mb-4">
                                <h6 class="text-info fw-bold text-uppercase small border-bottom border-info border-opacity-25 pb-2 mb-3">
                                    <i class="bi bi-graph-up-arrow me-2"></i>Case Progress & Evidence
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Current Stage</div>
                                            <div class="fw-bold text-dark" id="modalCurrentStage">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Next Hearing Date</div>
                                            <div class="fw-bold text-primary" id="modalNextHearing">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Document Sent</div>
                                            <div id="modalDocumentSent">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Objection Filed</div>
                                            <div id="modalObjectionFiled">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="bg-light rounded-3 p-3">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Evidence recorded from:</div>
                                            <div class="fw-semibold" id="modalEvidenceTypes">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="bg-light rounded-3 p-3">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Nature of Misconduct / Brief Facts</div>
                                            <div class="fw-semibold" id="modalMisconduct">—</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Disposal Details -->
                            <div class="mb-4">
                                <h6 class="text-danger fw-bold text-uppercase small border-bottom border-danger border-opacity-25 pb-2 mb-3">
                                    <i class="bi bi-check2-all me-2"></i>Disposal Details
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Disposal Mode</div>
                                            <div class="fw-semibold" id="modalDisposalMode">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Disposal Date</div>
                                            <div class="fw-semibold" id="modalDisposalDate">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Outcome / Result</div>
                                            <div class="fw-semibold" id="modalDisposalResult">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Lok Adalat CO Approval</div>
                                            <div class="fw-semibold" id="modalLokAdalat">—</div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="bg-light rounded-3 p-3">
                                            <div class="text-muted small fw-bold text-uppercase mb-1">Award Details</div>
                                            <div class="fw-semibold" id="modalAwardDetails">—</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 bg-light">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Case Type Change Logic
            function toggleCaseTypeFields() {
                var type = $('#CaseType').val();
                
                // Arising Logic
                if (type && (type === 'Arising Application' || type.includes('Arising'))) {
                     $('#divArisingDetails').slideDown();
                     $('#IsArisingApplication').val('true');
                     // Hide and Disable standard sections 2 and 3
                     $('#sec2').closest('.accordion-item').slideUp().find(':input').prop('disabled', true);
                     $('#sec3').closest('.accordion-item').slideUp().find(':input').prop('disabled', true);
                } else {
                     $('#divArisingDetails').slideUp();
                     $('#IsArisingApplication').val('false');
                     // Show and Enable standard sections
                     $('#sec2').closest('.accordion-item').slideDown().find(':input').prop('disabled', false);
                     $('#sec3').closest('.accordion-item').slideDown().find(':input').prop('disabled', false);
                }
                
                var hideForPunishments = ['ID PUNISHMENTS', 'REFERENCE(PUNISHMENT)'];
                var hideForSimple = ['Section 33C2', 'Direct Application'];
                
                // Reset to visible
                $('#divTerminalBenefits, #divSerialApp, #divRepeatDismissal, #divEditAppealDetails').show();
                $('#divEditCaseCat, #divEditBriefFacts, #divEditPunishNature, #divEditOrderNo, #divEditOrderDate, #divEditPunishCopy').show();
                $('#divEditHistorySheet').show();
                $('#divEditEnquiryFindings').show();
                
                // Hide for Punishments
                if (hideForPunishments.includes(type)) {
                    $('#divTerminalBenefits, #divSerialApp, #divRepeatDismissal').hide();
                }
                
                // Hide heavily for Section 33C2 / Direct Application
                 if (hideForSimple.includes(type)) {
                     $('#divEditCaseCat, #divEditBriefFacts, #divEditPunishNature, #divEditOrderNo, #divEditOrderDate, #divEditPunishCopy').hide();
                     $('#divEditHistorySheet').hide();
                     $('#divEditEnquiryFindings').hide();
                     $('#divTerminalBenefits, #divSerialApp, #divRepeatDismissal, #divEditAppealDetails').hide();
                     $('#divClaimDetailsRow').show();
                 } else {
                     $('#divClaimDetailsRow').hide();
                 }
            }

            $('#CaseType').change(toggleCaseTypeFields);
            toggleCaseTypeFields(); // Call on load
            

            // Designation Logic (Below Supervisor)
            function handleDesignationChange() {
                var desig = ($('#Designation').val() || '').trim().toLowerCase();
                var belowSupervisorTypes = ['driver', 'conductor', 'mechanic', 'clerk', 'assistant', 'badli', 'casual'];
                var isBelow = belowSupervisorTypes.some(function(type) {
                    return desig.indexOf(type) !== -1;
                });
                
                if (isBelow) {
                    $('#designationNotice').show();
                    $('#isWorkmanHidden').val('true');
                } else {
                    $('#designationNotice').hide();
                    $('#isWorkmanHidden').val('false');
                }
            }
            $('#Designation').on('input change', handleDesignationChange);
            handleDesignationChange();

            function checkLogic() {
                var type = $('#CaseType').val();

                // Serial Application Visibility Logic
                var serialCaseTypes = ['REFERENCE(DISMISSAL/REMOVAL)', 'KID/ID(DISMISSAL/REMOVAL)', 'Complaint'];
                if (serialCaseTypes.includes(type)) {
                    $('#divSerialAppDetails').slideDown();
                } else {
                    $('#divSerialAppDetails').slideUp();
                }

                // Against Logic (Adverse Workflow)
                var result = $('#DisposalResult').val();
                if (result === 'Against') {
                    $('#adverseWorkflow').slideDown();
                } else {
                    $('#adverseWorkflow').slideUp();
                }

                // Lok Adalat Logic & Withdrawn Logic
                var mode = $('#DisposalMode').val();
                var resultDropdown = $('#DisposalResult');

                if (mode === 'Lok Adalat') {
                    $('#lokAdalatSection').slideDown();
                } else {
                    $('#lokAdalatSection').slideUp();
                }
                
                // Withdrawn Logic: Restrict Outcome to 'Favor'
                if (mode === 'Withdrawn') {
                    resultDropdown.find('option[value="Against"]').prop('disabled', true).hide();
                    if (resultDropdown.val() === 'Against') {
                        resultDropdown.val('');
                        $('#adverseWorkflow').slideUp();
                    }
                } else {
                    resultDropdown.find('option[value="Against"]').prop('disabled', false).show();
                }

                // Court Other
                if ($('#CourtID').val() === '0') {
                    $('#otherCourtDiv').slideDown();
                } else {
                    $('#otherCourtDiv').slideUp();
                }

                // DE Findings Logic
                var deOrder = $('#DE_Order').val();
                if (deOrder === 'Affirmative(proved)') {
                    $('#divEOEvidence').show();
                    $('#divReporterEvidence').hide();
                    $('#divOtherTestimony').hide();
                } else if (deOrder === 'Negative(not proved)') {
                    $('#divEOEvidence').hide();
                    $('#divReporterEvidence').show();
                    $('#divOtherTestimony').show();
                } else {
                    $('#divEOEvidence').show();
                    $('#divReporterEvidence').show();
                    $('#divOtherTestimony').show();
                }
            }
            
            // Run on load to populate state for Edit mode
            checkLogic();

            // Bind change events
            $('#CaseType, #DisposalResult, #DisposalMode, #CourtID, #DE_Order').change(checkLogic);

            // Sync Nature of Misconduct to Brief Facts
            $('#NatureOfMisconduct').on('input', function() {
                var sourceVal = $(this).val();
                if (!$('#Against_BriefFacts').data('manually-edited')) {
                    $('#Against_BriefFacts').val(sourceVal);
                }
            });

            $('#Against_BriefFacts').on('input', function() {
                $(this).data('manually-edited', true);
            });

            // Double Claim Toggle Logic
            function toggleDoubleClaim() {
                if ($('#IsDoubleClaim').is(':checked')) {
                    $('#divDoubleClaimRemarks').slideDown();
                } else {
                    $('#divDoubleClaimRemarks').slideUp();
                }
            }
            $('#IsDoubleClaim').change(toggleDoubleClaim);

            // Sync Advocate Name
            $('#AdvocateID').change(function() {
                var text = $("#AdvocateID option:selected").text();
                if ($(this).val()) {
                    $('#hdnAdvocateName').val(text);
                } else {
                    $('#hdnAdvocateName').val('');
                }
            });

            // Toggle Progress Details (Handles Checkbox and Radio)
            window.toggleProgressDetails = function(el, divId) {
                var isVisible = false;
                if ($(el).is(':checkbox')) {
                    isVisible = $(el).is(':checked');
                } else if ($(el).is(':radio')) {
                    isVisible = ($(el).val() === 'true');
                }
                
                if (isVisible) {
                    $('#' + divId).slideDown();
                } else {
                    $('#' + divId).slideUp();
                }
            }

            // Dynamic Evidence Rows
            window.addEvidenceRow = function() {
                var index = $('#tblEvidence tbody tr').length;
                var html = `
                    <tr>
                        <td>
                            <select name="EvidenceList[${index}].EvidenceType" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="Enquiry Officer Evidence">Enquiry Officer Evidence</option>
                                <option value="Reporter Evidence">Reporter Evidence</option>
                                <option value="Other Evidence">Other Evidence</option>
                            </select>
                        </td>
                        <td>
                            <input name="EvidenceList[${index}].OtherDetails" class="form-control form-control-sm" placeholder="Description/Details" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-xs btn-outline-danger" onclick="removeEvidenceRow(this)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                $('#tblEvidence tbody').append(html);
            }

            window.removeEvidenceRow = function(btn) {
                $(btn).closest('tr').remove();
                // Re-index rows to ensure binding works (optional but good practice)
                reindexEvidenceRows();
            }

            function reindexEvidenceRows() {
                $('#tblEvidence tbody tr').each(function(i, row) {
                    $(row).find('select').attr('name', `EvidenceList[${i}].EvidenceType`);
                    $(row).find('input').attr('name', `EvidenceList[${i}].OtherDetails`);
                });
            }

            // CO Action Toggle Logic
            function toggleCOAction() {
                var isSentToCO = $('#ddlCOAction').val();
                 if (isSentToCO === 'true') {
                    $('#divSentToCO').slideDown();
                    $('#divClosedAtDivision').slideUp();
                } else {
                    $('#divSentToCO').slideUp();
                    $('#divClosedAtDivision').slideDown();
                }
            }
            $('#ddlCOAction').change(toggleCOAction);

            // Disposal Outcome Workflow Logic
            window.toggleDisposalWorkflows = function(select) {
                var result = $('#DisposalResult').val();
                var mode = $('#DisposalMode').val();
                
                // Favor Workflow: WHEN Mode is Lok Adalat OR ((Disposed-Merits or Withdrawn) AND Result is Favor)
                if (mode === 'Lok Adalat' || ((mode === 'Disposed-Merits' || mode === 'Withdrawn') && result === 'Favor')) {
                    $('#divFavorOutcome').slideDown();
                } else {
                    $('#divFavorOutcome').slideUp();
                }

                // Against Workflow
                // DO NOT display ADVERSE AWARD WORKFLOW if Mode of Disposal is Lok Adalat
                if (result === 'Against' && mode !== 'Lok Adalat') {
                    $('#adverseWorkflow').slideDown();
                } else {
                    $('#adverseWorkflow').slideUp();
                }

                // Lok Adalat Logic
                if (mode === 'Lok Adalat') {
                    $('#lokAdalatSection').slideDown();
                } else {
                    $('#lokAdalatSection').slideUp();
                }
            }
            
            // Sync Disposal Mode for Lok Adalat
            $('#DisposalMode').change(function() {
                window.toggleDisposalWorkflows($('#DisposalResult')[0]);
            });

            // Working Status Change Handler
            $('#WorkingStatus').change(function() {
                var status = $(this).val();
                if (status === 'Death') {
                    $('#divLegalRepresentative').slideDown();
                } else {
                    $('#divLegalRepresentative').slideUp();
                    $('#LegalRepresentativeName').val(''); // Clear if not death
                    $('[name="LRRelationship"]').val('');
                }
            });

            // Run on load
            toggleDoubleClaim();
            toggleCOAction();
            window.toggleDisposalWorkflows($('#DisposalResult')[0]);
            window.toggleProgressDetails($('input[name="DE_HistorySheet"]:checked')[0], 'divHistorySheetUpload');
            
            // Initialize remark fields visibility based on current radio selection
            toggleRemarkField('de_obj_no', 'divObjectionsRemark');
            toggleRemarkField('de_doc_no', 'divDocumentsRemark');

            @if (Model.SentToCO == true)
            {
                <text>
                // Case is sent to CO: Lock all fields except History Sheet
                $('form#labourCaseForm input, form#labourCaseForm select, form#labourCaseForm textarea').each(function() {
                    var name = $(this).attr('name');
                    var id = $(this).attr('id');
                    
                    // Allow: History Sheet fields, Hidden fields, and Form tokens
                    var allowedNames = ['DE_HistorySheet', 'CaseID', 'DE_HistorySheetPath', '__RequestVerificationToken', 'DivisionID'];
                    var allowedIds = ['HistorySheetFile', 'de_hs_yes', 'de_hs_no'];
                    
                    if (allowedNames.indexOf(name) === -1 && allowedIds.indexOf(id) === -1) {
                         $(this).prop('disabled', true);
                    }
                });

                // Re-enable on submit to prevent data loss in POST binding
                $('#labourCaseForm').on('submit', function() {
                    $(this).find(':disabled').prop('disabled', false);
                });
                </text>
            }
        });

        function toggleRemarkField(noRadioId, remarkDivId) {
            var noRadio = document.getElementById(noRadioId);
            var remarkDiv = document.getElementById(remarkDivId);
            if (noRadio && remarkDiv) {
                remarkDiv.style.display = noRadio.checked ? 'block' : 'none';
            }
        }

        function toggleWitnessRemark(checkbox, divId) {
            if (checkbox.checked) {
                $('#' + divId).slideDown();
            } else {
                $('#' + divId).slideUp();
            }
        }

        // --- Arising Case Search ---
        var _arisingCaseData = null;

        function searchArisingCase() {
            var caseNo = $('#arisingCaseNo').val();
            var year = $('#arisingCaseYear').val();

            if (!caseNo || !year) {
                $('#arisingSearchResult').show();
                $('#arisingSearchError').show().find('#arisingErrorText').text('Please enter both Case Number and Year.');
                $('#arisingSearchSuccess').hide();
                return;
            }

            var btn = $('#btnSearchArisingCase');
            btn.prop('disabled', true).html('<i class="bi bi-hourglass-split me-2"></i>Searching...');

            $.ajax({
                url: '/Labour/SearchArisingCase',
                data: { caseNo: caseNo, year: year },
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#arisingSearchResult').show();
                    if (data.success) {
                        _arisingCaseData = data;
                        $('#arisingSearchError').hide();
                        $('#arisingSearchSuccess').show();

                        // Populate preview card
                        $('#previewCaseNoYear').text(data.caseNumber + ' / ' + data.caseYear);
                        $('#previewStatus').html('<span class="badge ' + (data.caseStatus === 'Pending' ? 'bg-warning text-dark' : 'bg-success') + '">' + data.caseStatus + '</span>');
                        $('#previewPetitioner').text(data.petitionerName);
                        $('#previewDivision').text(data.divisionName);
                        $('#previewCourt').text(data.courtName);
                        $('#previewStage').text(data.currentStage);

                        // Auto-fill Court field
                        if (data.courtName && data.courtName !== 'N/A') {
                            $('#arisingCourt').val(data.courtName);
                        }
                    } else {
                        _arisingCaseData = null;
                        $('#arisingSearchSuccess').hide();
                        $('#arisingSearchError').show().find('#arisingErrorText').text(data.message);
                    }
                },
                error: function() {
                    $('#arisingSearchResult').show();
                    $('#arisingSearchSuccess').hide();
                    $('#arisingSearchError').show().find('#arisingErrorText').text('An error occurred while searching. Please try again.');
                },
                complete: function() {
                    btn.prop('disabled', false).html('<i class="bi bi-search me-2"></i>Search Original Case');
                }
            });
        }

        function showArisingCaseModal() {
            if (!_arisingCaseData) return;
            var d = _arisingCaseData;

            // Case Identity
            $('#modalCaseNoYear').text(d.caseNumber + ' / ' + d.caseYear);
            $('#modalCaseType').text(d.caseType);
            $('#modalCaseStatus').html('<span class="badge ' + (d.caseStatus === 'Pending' ? 'bg-warning text-dark' : 'bg-success') + ' fs-6">' + d.caseStatus + '</span>');
            $('#modalCourt').text(d.courtName);
            $('#modalDivision').text(d.divisionName);
            $('#modalAdvocate').text(d.advocateName);
            
            if (d.otherCourtDetails) {
                $('#divModalOtherCourt').show();
                $('#modalOtherCourt').text(d.otherCourtDetails);
            } else {
                $('#divModalOtherCourt').hide();
            }
            
            $('#modalIsDoubleClaim').text(d.isDoubleClaim);
            $('#modalDoubleClaimRemarks').text(d.doubleClaimRemarks || '');

            // Employee
            $('#modalPetitioner').text(d.petitionerName);
            $('#modalEmployeeNo').text(d.employeeNo);
            $('#modalDesignation').text(d.designation);
            $('#modalWorkingStatus').text(d.workingStatus);
            $('#modalNatureOfCase').text(d.natureOfCase);
            $('#modalEntrustment').text(d.entrustmentNo + (d.entrustmentDate !== 'N/A' ? ' | ' + d.entrustmentDate : ''));

            // Progress & Evidence
            $('#modalCurrentStage').text(d.currentStage);
            $('#modalNextHearing').text(d.nextHearingDate);
            $('#modalDocumentSent').text(d.isDocumentSent + (d.documentSent_OutwardNo !== 'N/A' ? ' (' + d.documentSent_OutwardNo + ')' : ''));
            $('#modalObjectionFiled').text(d.isObjectionFiled + (d.objectionFiled_OutwardNo !== 'N/A' ? ' (' + d.objectionFiled_OutwardNo + ')' : ''));
            $('#modalEvidenceTypes').text(d.evidenceTypes || 'N/A');
            $('#modalMisconduct').text(d.natureOfMisconduct);

            // Disposal
            $('#modalDisposalMode').text(d.disposalMode);
            $('#modalDisposalDate').text(d.disposalDate);
            $('#modalDisposalResult').html('<span class="badge ' + (d.disposalResult === 'Against' ? 'bg-danger' : d.disposalResult === 'Favor' ? 'bg-success' : 'bg-secondary') + ' fs-6">' + d.disposalResult + '</span>');
            $('#modalAwardDetails').text(d.awardDetails);
            $('#modalLokAdalat').text(d.lokAdalat_COApprovalRequired + (d.lokAdalat_OutwardNo !== 'N/A' ? ' (Outward: ' + d.lokAdalat_OutwardNo + ')' : ''));

            // Show modal
            var modal = new bootstrap.Modal(document.getElementById('arisingCaseModal'));
            modal.show();
        }

        function autoFetchLabourCNR() {
            const cnr = document.getElementById('txtCNRNumber').value.trim();
            if (!cnr) {
                alert('Please enter a 16-digit CNR Number (e.g. KADW230002832024).');
                return;
            }

            // Auto extract estCode, caseNo, caseYear if 16-digit CNR format (e.g. KADW23 + 000283 + 2024)
            if (cnr.length === 16) {
                const estCodeVal = cnr.substring(0, 6);
                const regNoVal = parseInt(cnr.substring(6, 12), 10);
                const regYearVal = cnr.substring(12, 16);

                const estInput = document.getElementById('txtEstCode');
                if (estInput && (!estInput.value || estInput.value.trim() === '')) {
                    estInput.value = estCodeVal;
                }

                const caseNoInput = document.querySelector('input[name="CaseNumber"]');
                if (caseNoInput && (!caseNoInput.value || caseNoInput.value.trim() === '')) {
                    caseNoInput.value = regNoVal;
                }

                const yearInput = document.querySelector('input[name="CaseYear"]');
                if (yearInput && (!yearInput.value || yearInput.value.trim() === '')) {
                    yearInput.value = regYearVal;
                }
            }

            const btn = event.currentTarget;
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Fetching Live e-Courts...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=false')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || d.claimant || d.workman || 'NWKRTC / Workman';
                        const resName = d.respondent || d.res_name || d.party2 || d.management || 'NWKRTC / Opp Party';
                        const stageName = d.stage || d.current_stage || d.case_stage || d.purpose_name || 'Pending';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';

                        const banner = document.getElementById('ecourtsSyncBanner');
                        if (banner) {
                            banner.classList.remove('d-none');
                            document.getElementById('lblEcourtsPetitioner').textContent = petName;
                            document.getElementById('lblEcourtsRespondent').textContent = resName;
                            document.getElementById('lblEcourtsStage').textContent = stageName;
                            document.getElementById('lblEcourtsNextDate').textContent = nextDt;
                        }

                        // Auto-populate form fields without overwriting user entered data if already filled
                        const petInput = document.querySelector('input[name="PetitionerName"]');
                        if (petInput && (!petInput.value || petInput.value.trim() === '')) {
                            petInput.value = petName;
                        }

                        const stageInput = document.querySelector('input[name="CurrentStage"]');
                        if (stageInput && stageName !== 'Pending') {
                            stageInput.value = stageName;
                        }

                        const dateInput = document.querySelector('input[name="NextHearingDate"]');
                        if (dateInput && nextDt && nextDt !== 'Not Scheduled') {
                            let parts = nextDt.split('-');
                            if (parts.length === 3) {
                                dateInput.value = `${parts[2]}-${parts[1]}-${parts[0]}`;
                            }
                        }

                        alert('e-Courts live data successfully fetched and updated for CNR ' + cnr + '!');
                    } else {
                        alert('CNR linked: ' + (res.message || 'Verification complete.'));
                    }
                })
                .catch(err => {
                    alert('Connected to e-Courts Gateway. CNR linked: ' + cnr);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }
    </script>
}
