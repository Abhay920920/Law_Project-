@model MVCCaseManagement.Models.LabourCase

@{
    bool isService = ViewBag.IsServiceMatter == true || Model.CaseType == "Service Matter" || (Model.ServiceID.HasValue && Model.ServiceID > 0 && Model.CaseID == 0);
    int backId = (Model.ServiceID.HasValue && Model.ServiceID > 0) ? Model.ServiceID.Value : Model.CaseID;
    ViewData["Title"] = "Dy. CLO Action - " + Model.CaseNumber;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-secondary mb-1"><i class="bi bi-shield-check me-2"></i>Dy. Chief Law Officer Action @(isService ? "(Service Matter)" : "(Labour)")</h3>
            <p class="text-secondary mb-0">Case No: <strong class="text-dark">@Model.CaseNumber (@Model.CaseYear)</strong></p>
        </div>
        @if (isService)
        {
            <a asp-action="ServiceMatterDetails" asp-route-id="@backId" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Back to Details
            </a>
        }
        else
        {
            <a asp-action="Details" asp-route-id="@Model.CaseID" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Back to Details
            </a>
        }
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="glass-card p-4 border-0 shadow-sm">
                <form asp-action="DyCLOAction" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CaseID" />
                    <input type="hidden" asp-for="ServiceID" />
                    <input type="hidden" asp-for="CaseType" />
                    <input type="hidden" name="isService" value="@(isService ? "true" : "false")" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Action Taken</label>
                        <select asp-for="ActionTaken_DyCLO" class="form-select form-select-lg border-primary border-opacity-25" required>
                            <option value="">-- Select Action --</option>
                            <option value="Approved" selected="@(Model.ActionTaken_DyCLO == "Approved")">Approved</option>
                            <option value="Rejected" selected="@(Model.ActionTaken_DyCLO == "Rejected")">Rejected</option>
                        </select>
                        <span asp-validation-for="ActionTaken_DyCLO" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Approval Date</label>
                        <input type="date" asp-for="ApprovalDate_DyCLO" class="form-control form-control-lg border-primary border-opacity-25" value="@((Model.ApprovalDate_DyCLO ?? DateTime.Now).ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="ApprovalDate_DyCLO" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Opinion</label>
                        <textarea asp-for="Opinion_DyCLO" class="form-control border-primary border-opacity-25" rows="5" placeholder="Enter Dy CLO opinion/remarks here...">@Model.Opinion_DyCLO</textarea>
                        <span asp-validation-for="Opinion_DyCLO" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            <i class="bi bi-check-circle me-2"></i>Submit Action
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 20px;
    }
    .form-control-lg, .form-select-lg {
        border-radius: 12px;
        font-size: 1rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
</style>
