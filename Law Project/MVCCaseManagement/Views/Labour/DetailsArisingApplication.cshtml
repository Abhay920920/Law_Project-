                                    <span class="badge bg-secondary text-white rounded-pill ms-1">WP @parentCaseObj!.CO_Claimant_CaseNumber</span>
                                </button>
                            </li>
                        }
                        @if (hasArisingSLP || hasParentSLP) {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small py-2 px-3 rounded-pill border" id="aa-tab-slp" data-bs-toggle="pill" data-bs-target="#aa-pane-slp" type="button" role="tab">
