                                <i class="bi bi-building me-1 text-primary"></i>Corporation WP
                                @if (hasArisingWP || hasParentWP) { <span class="badge bg-primary text-white rounded-pill ms-1">WP @(Model.CO_WP_CaseNumber ?? parentCaseObj?.CO_WP_CaseNumber ?? "—")</span> }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold small py-2 px-3 rounded-pill border" id="aa-tab-corp-wa" data-bs-toggle="pill" data-bs-target="#aa-pane-corp-wa" type="button" role="tab">
                                <i class="bi bi-diagram-2 me-1 text-danger"></i>Corporation WA
                                @if (hasArisingWA || hasParentWA) { <span class="badge bg-danger text-white rounded-pill ms-1">WA @(Model.CO_WA_CaseNumber ?? parentCaseObj?.CO_WA_CaseNumber ?? "—")</span> }
                            </button>
                        </li>
                        @if (hasParentClaimantWP) {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small py-2 px-3 rounded-pill border" id="aa-tab-claimant-wp" data-bs-toggle="pill" data-bs-target="#aa-pane-claimant-wp" type="button" role="tab">
