                </div>
            </div>

            <!-- Higher Courts & Appeals Details Card (WP / WA / Reinstatement / Further Appeal) -->
            @{
                LabourCase? parentCaseObj = (ViewBag.ParentCase as LabourCase) ?? (ViewBag.LinkedParentCase as LabourCase);

                bool hasArisingWP = !string.IsNullOrWhiteSpace(Model.CO_WP_CaseNumber) || (Model.CO_WP_CaseStatus_Option != null && Model.CO_WP_CaseStatus_Option.Contains("PENDING", StringComparison.OrdinalIgnoreCase));
                bool hasArisingWA = !string.IsNullOrWhiteSpace(Model.CO_WA_CaseNumber) || (Model.CO_WA_CaseStatus_Option != null && Model.CO_WA_CaseStatus_Option.Contains("PENDING", StringComparison.OrdinalIgnoreCase));
                bool hasArisingReinstatement = Model.CO_IsWorkmanReinstated || !string.IsNullOrWhiteSpace(Model.CO_ReinstatedSubjectToWP) || (Model.CO_ReinstatementApprovalIssued == true);
                bool hasArisingSLP = !string.IsNullOrWhiteSpace(Model.CO_FurtherAppeal_CaseNumber) || (Model.CO_FurtherAppeal_Status_Option != null && Model.CO_FurtherAppeal_Status_Option.Contains("PENDING", StringComparison.OrdinalIgnoreCase));

                bool hasParentWP = parentCaseObj != null && !string.IsNullOrWhiteSpace(parentCaseObj.CO_WP_CaseNumber);
                bool hasParentWA = parentCaseObj != null && !string.IsNullOrWhiteSpace(parentCaseObj.CO_WA_CaseNumber);
                bool hasParentServiceWP = parentCaseObj != null && !string.IsNullOrWhiteSpace(parentCaseObj.CO_Service_WPNumber);
                bool hasParentClaimantWP = parentCaseObj != null && !string.IsNullOrWhiteSpace(parentCaseObj.CO_Claimant_CaseNumber);
                bool hasParentSLP = parentCaseObj != null && !string.IsNullOrWhiteSpace(parentCaseObj.CO_FurtherAppeal_CaseNumber);

                int appealCount = (hasArisingWP ? 1 : 0) + (hasArisingWA ? 1 : 0) + (hasArisingReinstatement ? 1 : 0) + (hasArisingSLP ? 1 : 0)
                                  + (hasParentWP ? 1 : 0) + (hasParentWA ? 1 : 0) + (hasParentServiceWP ? 1 : 0) + (hasParentClaimantWP ? 1 : 0) + (hasParentSLP ? 1 : 0);
            }

            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-primary">
                <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-diagram-3-fill fs-5"></i></div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Higher Courts &amp; Appeals Details (WP / WA / Reinstatement / Further Appeal)</h6>
                            <small class="text-muted">High Court Writ Petitions, Writ Appeals &amp; Supreme Court Live e-Courts Tracking</small>
                        </div>
                    </div>
                    <span class="badge @(appealCount > 0 ? "bg-primary text-white" : "bg-light text-muted border") rounded-pill px-3 py-2 fw-bold">
                        @(appealCount > 0 ? $"{appealCount} Appeal Record(s)" : "No Appeals Recorded")
                    </span>
                </div>

                <!-- Appeal Tab Navigation -->
