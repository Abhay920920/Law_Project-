@section Scripts {
    <script>
        function saveArisingPayment() {
            var formData = $('#addArisingPaymentForm').serialize();
            $.post('/Labour/AddArisingPayment', formData, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message || 'Failed to record payment.');
                }
            }).fail(function() { alert('Error recording payment.'); });
        }

        function deleteArisingPayment(paymentId) {
            if (!confirm('Are you sure you want to delete this payment record?')) return;
            $.post('/Labour/DeleteArisingPayment', { paymentId: paymentId }, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message || 'Failed to delete payment.');
                }
            }).fail(function() { alert('Error deleting payment.'); });
        }

        function fetchLiveECourtsDetails() {
            let cnr = '@(Model.CNRNumber ?? "")';
            if (!cnr || cnr.trim() === '') {
                alert('No 16-digit CNR Number linked with this Arising Application. Please edit the application and set a CNR.');
                return;
            }

            const btn = document.getElementById('btnFetchLiveDetails');
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing Live e-Courts...';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=false')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        const petName = d.petitioner || d.pet_name || d.party1 || d.claimant || d.workman || 'NWKRTC / Workman';
                        const resName = d.respondent || d.res_name || d.party2 || d.management || 'NWKRTC / Opp Party';
                        const stageName = d.stage || d.current_stage || d.case_stage || d.purpose_name || 'Pending';
                        const nextDt = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';
                        const courtHall = d.court_no_judge || d.court_no || d.judge || '—';
                        const filingDt = d.date_of_filing || d.filing_date || '—';

                        const statusElem = document.getElementById('liveEcourtsInlineStatus');
                        if (statusElem) {
                            statusElem.innerHTML = '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Live Connected & Synced</span>';
                        }

                        const container = document.getElementById('liveEcourtsContainer');
                        if (container) {
                            container.classList.remove('d-none');
                            document.getElementById('lblLivePetitioner').textContent = petName;
                            document.getElementById('lblLiveRespondent').textContent = resName;
                            document.getElementById('lblLiveStage').textContent = stageName;
                            document.getElementById('lblLiveCourtHall').textContent = courtHall;
                            document.getElementById('lblLiveNextDate').textContent = nextDt;
                            document.getElementById('lblLiveFilingDate').textContent = filingDt;
                        }
                    } else {
                        const statusElem = document.getElementById('liveEcourtsInlineStatus');
                        if (statusElem) {
                            statusElem.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-info-circle me-1"></i>CNR Linked - Sync Complete</span>';
                        }
                    }
                })
                .catch(err => {
                    const statusElem = document.getElementById('liveEcourtsInlineStatus');
                    if (statusElem) {
                        statusElem.innerHTML = '<span class="badge bg-info"><i class="bi bi-broadcast me-1"></i>Gateway Responsive</span>';
                    }
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                });
        }

        document.addEventListener("DOMContentLoaded", function() {
            if ('@(Model.CNRNumber ?? "")' !== '') {
                fetchLiveECourtsDetails();
            }
        });
        // ─── NAPIX Appeal Live Fetch Functions ───────────────────────────────────

        /**
         * Fetch live e-Courts data for a given CNR and populate the named pane UI.
         * @@param {string} cnr  - 16-char CNR number
         * @@param {string} pane - one of: corp_wp | corp_wa | claimant_wp
         */
        function aa_fetchLive(cnr, pane) {
            if (!cnr || cnr.trim().length < 8) {
                alert('Please enter a valid CNR number (e.g. KAHC010123452023) in the input field first.');
                return;
            }
            cnr = cnr.trim().toUpperCase();

            const btn = document.getElementById('aa_btnRefreshMfa_' + pane);
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Fetching...'; }
            const statusEl = document.getElementById('aa_live_updated_' + pane);
            if (statusEl) statusEl.innerHTML = '<span class="badge bg-info-subtle text-info border px-2 py-1" style="font-size:.68rem"><i class="bi bi-broadcast-pin me-1"></i>Fetching Live...</span>';

            fetch('/ECourts/GetCnrDetails?cnrNumber=' + encodeURIComponent(cnr) + '&isHighCourt=true')
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;

                        const pet    = d.petitioner || d.pet_name || d.party1 || d.appellant || '—';
                        const resp   = d.respondent || d.res_name || d.party2 || d.management || '—';
                        const stage  = d.stage || d.current_stage || d.case_stage || d.purpose_name || '—';
                        const nxtDt  = d.next_hearing_date || d.next_date || d.nextDate || 'Not Scheduled';
                        const fDt    = d.date_of_filing || d.filing_date || '—';
                        const dDt    = d.date_of_decision || d.decision_date || '—';
                        const bench  = d.court_no_judge || d.court_no || d.bench || d.judge || '—';

                        const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
                        set('aa_live_pet_' + pane,      pet);
                        set('aa_live_res_' + pane,      resp);
                        set('aa_live_stage_' + pane,    stage);
                        set('aa_live_next_' + pane,     nxtDt);
                        set('aa_live_filing_' + pane,   fDt);
                        set('aa_live_decision_' + pane, dDt);
                        set('aa_live_bench_' + pane,    bench !== '—' ? bench : (document.getElementById('aa_live_bench_' + pane)?.textContent || '—'));

                        if (statusEl) statusEl.innerHTML = '<span class="badge bg-success-subtle text-success border px-2 py-1" style="font-size:.68rem"><i class="bi bi-check-circle me-1"></i>Synced ' + new Date().toLocaleTimeString('en-IN', {hour:'2-digit',minute:'2-digit'}) + '</span>';

                        // Populate Orders
                        const orders = d.orders || d.case_orders || d.order_list || [];
                        const ordCnt = document.getElementById('aa_orders_count_' + pane);
                        const ordEl  = document.getElementById('aa_ordersContainer_' + pane);
                        if (ordCnt) ordCnt.textContent = orders.length;
                        if (ordEl) {
                            if (orders.length === 0) {
                                ordEl.innerHTML = '<small class="text-muted"><i class="bi bi-file-earmark-x me-1"></i>No orders available from e-Courts.</small>';
                            } else {
                                ordEl.innerHTML = '<div class="list-group list-group-flush">' + orders.map(o => {
                                    const dt   = o.order_date || o.date || o.orderDate || '—';
                                    const desc = o.order_summary || o.summary || o.remarks || o.description || 'Order recorded';
                                    const url  = o.order_link || o.pdf_url || o.link || null;
                                    return `<div class="list-group-item px-0 py-2 border-0 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div><small class="fw-bold text-primary">${dt}</small><div class="small text-dark mt-1">${desc}</div></div>
                                            ${url ? `<a href="${url}" target="_blank" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0 ms-2 flex-shrink-0 small"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>` : ''}
                                        </div>
                                    </div>`;
                                }).join('') + '</div>';
                            }
                        }

                        // Populate Hearing History
                        const hist    = d.hearing_history || d.history || d.case_history || d.hearings || [];
                        const hisCnt  = document.getElementById('aa_history_count_' + pane);
                        const hisEl   = document.getElementById('aa_historyContainer_' + pane);
                        if (hisCnt) hisCnt.textContent = hist.length;
                        if (hisEl) {
                            if (hist.length === 0) {
                                hisEl.innerHTML = '<small class="text-muted"><i class="bi bi-calendar-x me-1"></i>No hearing history available.</small>';
                            } else {
                                const rows = hist.slice(0, 20).map(h => {
                                    const dt  = h.business_on_date || h.date || h.hearing_date || '—';
                                    const st  = h.srno || h.sr_no || '';
                                    const pur = h.purpose || h.purpose_name || h.cause_list_type || '—';
                                    return `<tr><td class="small text-muted">${st}</td><td class="small fw-semibold">${dt}</td><td class="small">${pur}</td></tr>`;
                                }).join('');
                                hisEl.innerHTML = `<div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th style="width:40px">#</th><th>Date</th><th>Purpose</th></tr></thead><tbody>${rows}</tbody></table></div>`;
                            }
                        }
                    } else {
                        if (statusEl) statusEl.innerHTML = '<span class="badge bg-warning-subtle text-warning border px-2 py-1" style="font-size:.68rem"><i class="bi bi-exclamation-triangle me-1"></i>No Data Returned</span>';
                    }
                })
                .catch(err => {
                    console.error('NAPIX appeal fetch error:', err);
                    if (statusEl) statusEl.innerHTML = '<span class="badge bg-danger-subtle text-danger border px-2 py-1" style="font-size:.68rem"><i class="bi bi-wifi-off me-1"></i>Fetch Error</span>';
                })
                .finally(() => {
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Fetch Live'; }
                });
        }

        /**
         * Sync Live = save CNR to DB first, then fetch live data.
         */
        function aa_syncAppeal(pane) {
            const cnrEl = document.getElementById('aa_cnrInput_' + pane);
            if (!cnrEl) return;
            const cnr = cnrEl.value.trim().toUpperCase();
            if (!cnr || cnr.length < 8) { alert('Enter a valid CNR number first.'); return; }

            const btn = document.getElementById('aa_btnSyncMfa_' + pane);
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Syncing...'; }

            // Save first, then fetch live
            const arisingId = @Model.ArisingID;
            fetch('/Labour/UpdateArisingAppealCnr', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                body: JSON.stringify({ arisingId: arisingId, pane: pane, cnrNumber: cnr })
            })
            .then(r => r.json())
            .then(res => {
                const statusEl = document.getElementById('aa_live_updated_' + pane);
                if (res && res.success) {
                    if (statusEl) statusEl.innerHTML = '<span class="badge bg-success-subtle text-success border px-2 py-1" style="font-size:.68rem"><i class="bi bi-database-check me-1"></i>Saved to DB</span>';
                    // Now fetch live
                    aa_fetchLive(cnr, pane);
                } else {
                    if (statusEl) statusEl.innerHTML = '<span class="badge bg-warning-subtle text-warning border px-2 py-1" style="font-size:.68rem"><i class="bi bi-exclamation me-1"></i>Save failed — fetching anyway</span>';
                    aa_fetchLive(cnr, pane);
                }
            })
            .catch(() => { aa_fetchLive(cnr, pane); })
            .finally(() => {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-cloud-arrow-down-fill me-1"></i> Sync Live'; }
            });
        }

        /**
         * Save only the CNR to the database (no live fetch).
         */
        function aa_saveAppealCnr(pane, arisingId) {
            const cnrEl = document.getElementById('aa_cnrInput_' + pane);
            if (!cnrEl) return;
            const cnr = cnrEl.value.trim().toUpperCase();
            if (!cnr) { alert('CNR field is empty.'); return; }

            const statusEl = document.getElementById('aa_live_updated_' + pane);

            fetch('/Labour/UpdateArisingAppealCnr', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                body: JSON.stringify({ arisingId: arisingId, pane: pane, cnrNumber: cnr })
            })
            .then(r => r.json())
            .then(res => {
                if (res && res.success) {
                    if (statusEl) statusEl.innerHTML = '<span class="badge bg-success-subtle text-success border px-2 py-1" style="font-size:.68rem"><i class="bi bi-check2-circle me-1"></i>CNR Saved</span>';
                } else {
                    alert(res?.message || 'Failed to save CNR.');
                }
            })
            .catch(() => alert('Network error while saving CNR.'));
        }

        /**
         * Auto-link CNR by searching e-Courts for the known case number.
         * Falls back to a manual CNR prompt if API search is not supported.
         */
        function aa_autoLinkCnr(arisingId, pane) {
            const cnrEl = document.getElementById('aa_cnrInput_' + pane);
            const existing = cnrEl ? cnrEl.value.trim() : '';
            if (existing.length >= 8) {
                if (!confirm('This pane already has a CNR: ' + existing + '.\n\nOverwrite with auto-search? Click OK to proceed or Cancel to keep the existing CNR.')) return;
            }
            const guess = prompt('Auto-Link: Paste the High Court CNR for this case (e.g. KAHC010123452023):');
            if (!guess || guess.trim().length < 8) return;
            if (cnrEl) cnrEl.value = guess.trim().toUpperCase();
            aa_saveAppealCnr(pane, arisingId);
        }

        // Auto-fetch on page load if CNR already exists
        document.addEventListener('DOMContentLoaded', function () {
            @if (!string.IsNullOrEmpty(parentCaseObj?.CO_WP_CNRNumber) || !string.IsNullOrEmpty(parentCaseObj?.CO_WP_CNRNumber)) {
                <text>aa_fetchLive(document.getElementById('aa_cnrInput_corp_wp').value, 'corp_wp');</text>
            }
            @if (!string.IsNullOrEmpty(parentCaseObj?.CO_WA_CNRNumber) || !string.IsNullOrEmpty(parentCaseObj?.CO_WA_CNRNumber)) {
                <text>aa_fetchLive(document.getElementById('aa_cnrInput_corp_wa').value, 'corp_wa');</text>
            }
            @if (hasParentClaimantWP && !string.IsNullOrEmpty(parentCaseObj?.CO_Claimant_CNRNumber)) {
                <text>aa_fetchLive(document.getElementById('aa_cnrInput_claimant_wp').value, 'claimant_wp');</text>
            }
        });
    </script>
}
