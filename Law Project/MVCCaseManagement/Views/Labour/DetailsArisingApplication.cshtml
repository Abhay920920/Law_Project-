@model MVCCaseManagement.Models.ArisingApplication

@{
    ViewData["Title"] = "Arising Application Details - " + Model.CaseNumber;
    ViewData["HidePageHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var divIdStr = User.FindFirst("DivisionID")?.Value;
    int sessDivId = Context.Session.GetInt32(MVCCaseManagement.Common.SessionKeys.DivisionID) ?? -1;
    bool isCO = (ViewBag.IsCentralOffice == true) || string.IsNullOrEmpty(divIdStr) || divIdStr == "0" || divIdStr == "5" || sessDivId == 0 || sessDivId == 5 || User.IsInRole("MD") || User.IsInRole("CLO") || User.IsInRole("CentralOffice") || User.IsInRole("CO") || User.IsInRole("Admin");
}

<div class="container-fluid fade-in py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("ArisingApplication", "Labour")">Arising Applications</a></li>
                    <li class="breadcrumb-item active">Application Details</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-diagram-3-fill text-warning me-2"></i>@Model.CaseNumber / @Model.CaseYear
            </h1>
            <small class="text-muted">Division: <strong>@Model.DivisionName</strong> | Court: <strong>@Model.CourtName</strong></small>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap d-print-none">
            @if (isCO || User.IsInRole("MD") || User.IsInRole("CLO") || User.IsInRole("Dy CLO") || User.IsInRole("DyCLO") || User.IsInRole("LO"))
            {
                if (User.IsInRole("LO"))
                {
                    <a href="@Url.Action("ArisingLOAction", "Labour", new { id = Model.ArisingID })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> ACTION
                    </a>
                }
                else if (User.IsInRole("Dy CLO") || User.IsInRole("DyCLO"))
                {
                    <a href="@Url.Action("ArisingDyCLOAction", "Labour", new { id = Model.ArisingID })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> ACTION
                    </a>
                }
                else if (User.IsInRole("CLO"))
                {
                    <a href="@Url.Action("ArisingCLOAction", "Labour", new { id = Model.ArisingID })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> ACTION
                    </a>
                }
                else if (User.IsInRole("MD"))
                {
                    <a href="@Url.Action("ArisingMDAction", "Labour", new { id = Model.ArisingID })" class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i> ACTION
                    </a>
                }
                else
                {
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-warning shadow-sm rounded-pill px-4 py-2 fw-bold dropdown-toggle d-inline-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shield-check me-2"></i> ACTION
                        </button>
                        <ul class="dropdown-menu shadow border-0 rounded-3">
                            <li><a class="dropdown-item py-2" href="@Url.Action("ArisingLOAction", "Labour", new { id = Model.ArisingID })"><i class="bi bi-person-badge text-info me-2"></i>Law Officer (LO) Action</a></li>
                            <li><a class="dropdown-item py-2" href="@Url.Action("ArisingDyCLOAction", "Labour", new { id = Model.ArisingID })"><i class="bi bi-person-check text-secondary me-2"></i>Dy. CLO Action</a></li>
                            <li><a class="dropdown-item py-2" href="@Url.Action("ArisingCLOAction", "Labour", new { id = Model.ArisingID })"><i class="bi bi-award text-primary me-2"></i>Chief Law Officer (CLO) Action</a></li>
                            <li><a class="dropdown-item py-2" href="@Url.Action("ArisingMDAction", "Labour", new { id = Model.ArisingID })"><i class="bi bi-check-circle text-success me-2"></i>Managing Director (MD) Action</a></li>
                        </ul>
                    </div>
                }
            }
            else if (Model.SentToCO != true)
            {
                <a href="@Url.Action("EditArisingApplication", "Labour", new { id = Model.ArisingID })" class="btn btn-primary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center">
                    <i class="bi bi-pencil-square me-2"></i> EDIT
                </a>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center" title="Forwarded to Central Office - Read Only">
                    <i class="bi bi-lock-fill me-1 text-secondary"></i> Forwarded to CO (Read-Only)
                </span>
            }
            <button type="button" class="btn btn-outline-primary shadow-sm rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#arisingFullDetailsModal">
                <i class="bi bi-info-circle me-2"></i> View More Details
            </button>
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
                <i class="bi bi-printer me-2"></i> Print
            </button>
        </div>
    </div>

    <!-- SUMMARY SECTION (4-Card Row) -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">Petitioner</small>
                    <div class="fw-bold text-truncate" title="@Model.PetitionerName">@Model.PetitionerName</div>
                    <div class="small text-muted"><i class="bi bi-hash me-1"></i>@(Model.EmployeeNo ?? "Arising Application")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 @(Model.DisposalResult == "Against" ? "bg-danger text-white" : (Model.CaseStatus == "Disposed" ? "bg-success text-white" : "bg-warning text-dark"))">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">Disposal / Result</small>
                    <div class="fw-bold">@(Model.CaseStatus == "Disposed" ? (string.IsNullOrEmpty(Model.DisposalResult) ? "Disposed" : Model.DisposalResult) : "Pending")</div>
                    @if (Model.DisposalDate.HasValue) { <div class="small">On: @Model.DisposalDate.Value.ToShortDateString()</div> }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            @{
                var coTitle = "Not Sent to CO";
                var coSubtext = "Local Division Unit";
                var coBgColor = "secondary";

                if (Model.SentToCO == true)
                {
                    coBgColor = "warning";
                    
                    if (!string.IsNullOrEmpty(Model.CO_ActionTaken))
                    {
                        coTitle = Model.CO_ActionTaken;
                    }
                    else if (Model.CO_FeasibilityReceived == true)
                    {
                        coTitle = "Feasibility Received";
                    }
                    else
                    {
                        coTitle = "Pending at CO";
                    }

                    if (!string.IsNullOrEmpty(Model.CO_ApprovalOutwardNo))
                    {
                        coSubtext = $"Outward: {Model.CO_ApprovalOutwardNo}";
                    }
                    else if (Model.CO_FeasibilityDate.HasValue)
                    {
                        coSubtext = $"Received: {Model.CO_FeasibilityDate.Value.ToString("dd MMM yyyy")}";
                    }
                    else
                    {
                        coSubtext = "Action Active";
                    }
                }
            }
            <div class="card border-0 shadow-sm h-100 bg-@coBgColor text-dark overflow-hidden position-relative">
                <div class="card-body p-3">
                    <small class="text-uppercase fw-bold xs d-block mb-1 opacity-75">Central Office Status</small>
                    <div class="fw-bold h6 mb-1 text-truncate" title="@coTitle">@coTitle</div>
                    <div class="small opacity-75 text-truncate">@coSubtext</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body p-3">
                    <small class="text-black text-uppercase fw-bold xs d-block mb-1">Advocate Assigned</small>
                    <div class="fw-bold text-truncate" title="@(Model.AdvocateName ?? Model.CO_WP_AdvocateName ?? "Not Assigned")">
                        @(Model.AdvocateName ?? Model.CO_WP_AdvocateName ?? "Not Assigned")
                    </div>
                    <div class="small">Entrustment: @(Model.EntrustmentNo ?? Model.CO_WP_EntrustmentNo ?? "-")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Official e-Courts Live Gateway Linkage & Real-Time Tracking -->
    <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-info bg-primary-subtle bg-opacity-10 d-print-none">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-primary">
                <i class="bi bi-broadcast me-2 fs-5 text-danger animate-pulse"></i>Official e-Courts Live Gateway API Linkage
            </h6>
            @if (!string.IsNullOrEmpty(Model.CNRNumber))
            {
                <span class="badge bg-success text-white rounded-pill px-3 py-1 font-monospace"><i class="bi bi-wifi me-1"></i>CNR Linked (@Model.CNRNumber)</span>
            }
            else
            {
                <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-exclamation-triangle me-1"></i>CNR Unlinked</span>
            }
        </div>
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">16-Digit CNR Number</small>
                    <div class="fw-bold font-monospace text-primary fs-6">
                        @(string.IsNullOrEmpty(Model.CNRNumber) ? "Not Linked" : Model.CNRNumber)
                    </div>
                    @if (!string.IsNullOrEmpty(Model.EstCode))
                    {
                        <small class="text-muted">Est Code: <strong>@Model.EstCode</strong></small>
                    }
                </div>
                <div class="col-md-5">
                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Live e-Courts Status</small>
                    <div id="liveEcourtsInlineStatus" class="fw-bold text-dark">
                        <span class="badge bg-light text-secondary border">Click 'Fetch Live Status' to load e-Courts details</span>
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    <button type="button" class="btn btn-primary shadow-sm fw-bold w-100" id="btnFetchLiveDetails" onclick="fetchLiveECourtsDetails()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Fetch Live Status
                    </button>
                </div>
            </div>

            <!-- Dynamic Live Data Panel -->
            <div id="liveEcourtsContainer" class="mt-3 p-3 bg-white rounded-3 border border-primary-subtle d-none">
                <div class="row g-3 text-dark">
                    <div class="col-md-6 border-end">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Petitioner vs Respondent (e-Courts Live)</small>
                        <div class="fw-bold text-primary" id="lblLivePetitioner">—</div>
                        <div class="small text-muted mb-1">vs</div>
                        <div class="fw-bold text-dark" id="lblLiveRespondent">—</div>
                    </div>
                    <div class="col-md-3 border-end">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Current Stage &amp; Purpose</small>
                        <div class="badge bg-warning text-dark fw-bold px-2 py-1 mb-2 d-inline-block" id="lblLiveStage">Pending</div>
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Court Hall / Bench</small>
                        <div class="fw-bold text-secondary small" id="lblLiveCourtHall">—</div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Next Hearing Date</small>
                        <div class="fw-bold text-danger fs-6 mb-2" id="lblLiveNextDate">Not Scheduled</div>
                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">First / Filing Date</small>
                        <div class="fw-bold text-dark small" id="lblLiveFilingDate">—</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column: Award & Progress Detail Cards -->
        <div class="col-lg-8">
            <!-- Linked Original / Primary Case Details Card -->
            @{
                var parentCaseModel = ViewBag.LinkedParentCase as MVCCaseManagement.Models.LabourCase;
            }
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-primary">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-link-45deg fs-5 me-2"></i>Linked Original / Primary Case Details
                    </h6>
                    @if (parentCaseModel != null)
                    {
                        <a href="@Url.Action("Details", "Labour", new { id = parentCaseModel.CaseID })" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Open Primary Case
                        </a>
                    }
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Original Case Number / Year</small>
                            <div class="fw-bold fs-6 text-dark">
                                @(parentCaseModel != null ? $"{parentCaseModel.CaseNumber} / {parentCaseModel.CaseYear}" : $"{Model.Parent_CaseNumber} / {Model.Parent_CaseYear}")
                            </div>
                            <small class="text-muted">Type: @(parentCaseModel?.CaseType ?? Model.Parent_CaseType ?? "Labour Case")</small>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Court Name</small>
                            <div class="fw-bold text-dark">@(parentCaseModel?.CourtName ?? Model.Parent_CourtName ?? "Labour Court")</div>
                            <small class="text-muted">Division: @(parentCaseModel?.DivisionName ?? Model.DivisionName)</small>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Overall Status & Outcome</small>
                            <div>
                                <span class="badge @(parentCaseModel?.CaseStatus == "Disposed" ? (parentCaseModel?.DisposalResult == "Against" ? "bg-danger" : "bg-success") : "bg-warning text-dark")">
                                    @(parentCaseModel?.CaseStatus ?? Model.Parent_CaseStatus ?? "Pending")
                                </span>
                                @if (parentCaseModel != null && !string.IsNullOrEmpty(parentCaseModel.DisposalResult))
                                {
                                    <span class="small text-muted ms-1">(@parentCaseModel.DisposalResult)</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (parentCaseModel != null && (!string.IsNullOrEmpty(parentCaseModel.AwardDetails) || !string.IsNullOrEmpty(parentCaseModel.FavorRemark)))
                    {
                        <div class="mt-3 p-3 bg-light rounded-3 border small">
                            <strong class="text-dark d-block mb-1"><i class="bi bi-file-text me-1"></i>Original Award Summary & Remarks:</strong>
                            <span class="text-muted">@(parentCaseModel.AwardDetails ?? parentCaseModel.FavorRemark)</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Central Office Official Action & Tracking Card -->
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-warning">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-shield-check text-warning me-2 fs-5"></i>Central Office Official Action &amp; Tracking
                    </h6>
                    @if (isCO)
                    {
                        <a href="@Url.Action("Action", "Labour", new { id = Model.ArisingID, isArising = true })" class="btn btn-sm btn-warning fw-bold rounded-pill px-3 shadow-sm">
                            <i class="bi bi-lightning-fill me-1"></i> Update Action
                        </a>
                    }
                    else if (Model.SentToCO)
                    {
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold">
                            <i class="bi bi-building-check me-1"></i> Sent to CO @(Model.CO_OutwardDate.HasValue ? $"({Model.CO_OutwardDate.Value.ToString("dd-MMM-yyyy")})" : "")
                        </span>
                    }
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Feasibility -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Feasibility &amp; Judgment Status</small>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="badge @(Model.CO_FeasibilityReceived == true ? "bg-success" : "bg-warning text-dark") me-2">
                                        @(Model.CO_FeasibilityReceived == true ? "Judgment Received" : "Pending Feasibility")
                                    </span>
                                    @if (Model.CO_FeasibilityDate.HasValue)
                                    {
                                        <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@Model.CO_FeasibilityDate.Value.ToString("dd MMM yyyy")</small>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(Model.CO_ActionTaken))
                                {
                                    <div class="mt-2 pt-2 border-top small">
                                        <strong class="text-dark">CO Action Taken:</strong>
                                        <span class="badge bg-primary ms-1">@Model.CO_ActionTaken</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- CO Approval & Closure -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem;">Approval &amp; Closure Details</small>
                                @if (!string.IsNullOrEmpty(Model.CO_ApprovalOutwardNo) || Model.CO_ApprovalDate.HasValue)
                                {
                                    <div class="fw-bold text-dark small">
                                        Outward No: <span class="text-primary">@(Model.CO_ApprovalOutwardNo ?? "-")</span>
                                    </div>
                                    <div class="small text-muted mb-1">
                                        Date: @(Model.CO_ApprovalDate?.ToString("dd MMM yyyy") ?? "-")
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small italic mb-1">No approval/closure outward generated yet</div>
                                }

                                @if (!string.IsNullOrEmpty(Model.CO_ClosedDocumentPath))
                                {
                                    <div class="mt-2">
                                        <a href="@Model.CO_ClosedDocumentPath" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> View Closed Supporting Document
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Remarks & Opinions -->
                        @if (!string.IsNullOrEmpty(Model.CO_Remarks) || !string.IsNullOrEmpty(Model.Opinion_CLO) || !string.IsNullOrEmpty(Model.Remarks))
                        {
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <small class="text-muted text-uppercase fw-bold d-block mb-2" style="font-size: 0.65rem;"><i class="bi bi-chat-left-text me-1"></i>Central Office &amp; Legal Remarks</small>
                                    @if (!string.IsNullOrEmpty(Model.CO_Remarks))
                                    {
                                        <div class="small mb-2">
                                            <strong class="text-dark">CO Remarks:</strong> <span class="text-muted">@Model.CO_Remarks</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Opinion_CLO))
                                    {
                                        <div class="small mb-2">
                                            <strong class="text-dark">CLO Opinion:</strong> <span class="text-muted">@Model.Opinion_CLO</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Remarks))
                                    {
                                        <div class="small">
                                            <strong class="text-dark">General Remarks:</strong> <span class="text-muted">@Model.Remarks</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Central Office Review & Legal Actions (LO, Dy CLO, CLO, MD) -->
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-warning">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="p-2 bg-warning-subtle text-warning-emphasis rounded-3 me-3">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Central Office Review &amp; Actions</h6>
                            <small class="text-muted">Multi-Level Legal Officers Review Hierarchy (LO &rarr; Dy. CLO &rarr; CLO &rarr; MD)</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- LO -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border-start border-4 border-info bg-light shadow-sm h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-info extra-small text-uppercase">
                                        <i class="bi bi-person-badge me-1"></i> Law Officer (LO)
                                    </span>
                                    @if (!string.IsNullOrEmpty(Model.ActionTaken_LO))
                                    {
                                        <span class="badge @(Model.ActionTaken_LO == "Approved" ? "bg-success" : "bg-danger")">@Model.ActionTaken_LO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pending</span>
                                    }
                                </div>
                                @if (Model.ApprovalDate_LO.HasValue)
                                {
                                    <div class="small text-muted mb-1"><i class="bi bi-calendar-check me-1"></i>Date: <strong>@(Model.ApprovalDate_LO?.ToString("dd-MM-yyyy"))</strong></div>
                                }
                                <div class="text-dark small white-space-pre-line">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_LO) ? "— Pending LO Legal Review —" : Model.Opinion_LO)
                                </div>
                            </div>
                        </div>

                        <!-- Dy CLO -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border-start border-4 border-secondary bg-light shadow-sm h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-secondary extra-small text-uppercase">
                                        <i class="bi bi-person-check me-1"></i> Dy. Chief Law Officer (Dy CLO)
                                    </span>
                                    @if (!string.IsNullOrEmpty(Model.ActionTaken_DyCLO))
                                    {
                                        <span class="badge @(Model.ActionTaken_DyCLO == "Approved" ? "bg-success" : "bg-danger")">@Model.ActionTaken_DyCLO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pending</span>
                                    }
                                </div>
                                @if (Model.ApprovalDate_DyCLO.HasValue)
                                {
                                    <div class="small text-muted mb-1"><i class="bi bi-calendar-check me-1"></i>Date: <strong>@(Model.ApprovalDate_DyCLO?.ToString("dd-MM-yyyy"))</strong></div>
                                }
                                <div class="text-dark small white-space-pre-line">
                                    @(string.IsNullOrWhiteSpace(Model.Opinion_DyCLO) ? "— Pending Dy CLO Legal Review —" : Model.Opinion_DyCLO)
                                </div>
                            </div>
                        </div>

                        <!-- CLO -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border-start border-4 border-primary bg-light shadow-sm h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
