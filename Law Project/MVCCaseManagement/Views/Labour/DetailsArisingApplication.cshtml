                        <div class="tab-pane fade" id="aa-pane-claimant-wp" role="tabpanel">
                            <div class="bg-light-subtle border-bottom px-3 py-2">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <div class="input-group input-group-sm flex-grow-1" style="min-width:280px;max-width:680px;">
                                        <span class="input-group-text bg-white text-muted fw-semibold"><i class="bi bi-upc-scan me-1 text-warning"></i> High Court CNR</span>
                                        <input type="text" id="aa_cnrInput_claimant_wp" class="form-control font-monospace fw-bold text-dark text-uppercase" value="@(parentCaseObj!.CO_Claimant_CNRNumber ?? "")" placeholder="e.g. KAHC010123452023" maxlength="16" />
                                        <button class="btn btn-warning text-dark btn-sm px-3 fw-bold" type="button" id="aa_btnSyncMfa_claimant_wp" onclick="aa_syncAppeal('claimant_wp')"><i class="bi bi-cloud-arrow-down-fill me-1"></i> Sync Live</button>
                                        <button class="btn btn-outline-success btn-sm px-2 fw-semibold" type="button" onclick="aa_saveAppealCnr('claimant_wp', @Model.ArisingID)"><i class="bi bi-check2"></i> Save</button>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <span id="aa_live_updated_claimant_wp" class="badge bg-secondary-subtle text-secondary border px-2 py-1" style="font-size:0.68rem;">@(string.IsNullOrEmpty(parentCaseObj!.CO_Claimant_CNRNumber) ? "Not Synced" : "Database Linked")</span>
                                        <button class="btn btn-sm btn-outline-warning text-dark fw-bold px-3" type="button" id="aa_btnRefreshMfa_claimant_wp" onclick="aa_fetchLive(document.getElementById('aa_cnrInput_claimant_wp').value,'claimant_wp')"><i class="bi bi-arrow-clockwise me-1"></i> Fetch Live</button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body bg-light p-3">
                                <div class="row g-3">
                                    <div class="col-6 col-md-3"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Claimant WP No &amp; Year</small><div class="fw-bold text-dark" id="aa_live_mfa_no_claimant_wp">WP @parentCaseObj!.CO_Claimant_CaseNumber / @(parentCaseObj.CO_Claimant_CaseYear?.ToString() ?? "—")</div></div>
                                    <div class="col-6 col-md-3"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">High Court Bench</small><div class="fw-bold text-dark" id="aa_live_bench_claimant_wp">High Court of Karnataka</div></div>
                                    <div class="col-6 col-md-3"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Next Hearing Date</small><div class="fw-bold text-primary" id="aa_live_next_claimant_wp">—</div></div>
                                    <div class="col-6 col-md-3"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Case Stage</small><div class="fw-bold text-dark" id="aa_live_stage_claimant_wp">—</div></div>
                                    <div class="col-12 col-md-6"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Petitioner / Claimant</small><div class="fw-semibold text-dark" id="aa_live_pet_claimant_wp">@(Model.PetitionerName ?? "—")</div></div>
                                    <div class="col-12 col-md-6"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Respondent</small><div class="fw-semibold text-dark" id="aa_live_res_claimant_wp">NWKRTC / @(Model.DivisionName ?? "—")</div></div>
                                </div>
                                <div class="border-top mt-3 pt-3">
                                    <ul class="nav nav-pills mb-2 gap-2" role="tablist">
                                        <li class="nav-item"><button class="nav-link active btn-sm py-1 px-3 fw-bold" data-bs-toggle="tab" data-bs-target="#aa_orders_claimant_wp" type="button"><i class="bi bi-file-earmark-pdf-fill me-1"></i>Orders <span class="badge bg-light text-danger ms-1" id="aa_orders_count_claimant_wp">0</span></button></li>
                                        <li class="nav-item"><button class="nav-link btn-sm py-1 px-3 fw-bold" data-bs-toggle="tab" data-bs-target="#aa_history_claimant_wp" type="button"><i class="bi bi-clock-history me-1"></i>Hearings <span class="badge bg-light text-dark ms-1" id="aa_history_count_claimant_wp">0</span></button></li>
                                    </ul>
                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="aa_orders_claimant_wp"><div id="aa_ordersContainer_claimant_wp"><small class="text-muted"><i class="bi bi-hourglass-split me-1"></i>Click Fetch Live to load orders.</small></div></div>
                                        <div class="tab-pane fade" id="aa_history_claimant_wp"><div id="aa_historyContainer_claimant_wp"><small class="text-muted"><i class="bi bi-hourglass-split me-1"></i>Click Fetch Live to load hearing history.</small></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- PANE 4: SLP -->
                    @if (hasArisingSLP || hasParentSLP) {
                        <div class="tab-pane fade" id="aa-pane-slp" role="tabpanel">
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    @if (hasArisingSLP) { <div class="col-md-6"><div class="p-3 bg-light rounded-4 border border-dark"><small class="fw-bold d-block mb-2" style="font-size:.65rem;color:#6f42c1;"><i class="bi bi-bank2 me-1"></i>ARISING SLP</small><div class="fw-bold fs-6">SLP/CA @Model.CO_FurtherAppeal_CaseNumber / @Model.CO_FurtherAppeal_Year</div>@if (!string.IsNullOrEmpty(Model.CO_FurtherAppeal_Status_Option)) { <span class="badge @(Model.CO_FurtherAppeal_Status_Option.Contains("PENDING") ? "bg-warning text-dark" : "bg-success") mt-1">@Model.CO_FurtherAppeal_Status_Option</span> }</div></div> }
                                    @if (hasParentSLP) { <div class="col-md-6"><div class="p-3 bg-light rounded-4 border border-secondary"><small class="fw-bold d-block mb-2" style="font-size:.65rem;color:#6f42c1;"><i class="bi bi-bank2 me-1"></i>PARENT CASE SLP</small><div class="fw-bold fs-6">SLP/CA @parentCaseObj!.CO_FurtherAppeal_CaseNumber / @parentCaseObj.CO_FurtherAppeal_Year</div>@if (!string.IsNullOrEmpty(parentCaseObj!.CO_FurtherAppeal_Status_Option)) { <span class="badge @(parentCaseObj.CO_FurtherAppeal_Status_Option.Contains("PENDING") ? "bg-warning text-dark" : "bg-success") mt-1">@parentCaseObj.CO_FurtherAppeal_Status_Option</span> }</div></div> }
                                </div>
                                <div class="alert py-2 px-3 mt-3 mb-0 small border-0 bg-info-subtle text-info-emphasis rounded-3"><i class="bi bi-info-circle-fill me-1"></i> SC / SLP live tracking via NAPIX is not available. Updates must be manually recorded.</div>
                            </div>
                        </div>
                    }

                    <!-- PANE 5: REINSTATEMENT -->
                    @if (hasArisingReinstatement) {
                        <div class="tab-pane fade" id="aa-pane-rein" role="tabpanel">
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-md-4"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Reinstated?</small><span class="badge @(Model.CO_IsWorkmanReinstated ? "bg-success" : "bg-secondary") fs-6 mt-1">@(Model.CO_IsWorkmanReinstated ? "YES — REINSTATED" : "PENDING")</span></div>
                                    @if (!string.IsNullOrEmpty(Model.CO_ReinstatedSubjectToWP)) { <div class="col-md-4"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Subject to WP</small><div class="fw-bold text-dark">@Model.CO_ReinstatedSubjectToWP</div></div> }
                                    @if (Model.CO_ReinstatementApprovalIssued == true || !string.IsNullOrEmpty(Model.CO_Reinstatement_ApprovalNo)) { <div class="col-md-4"><small class="text-muted text-uppercase fw-bold d-block" style="font-size:.63rem">Approval No</small><div class="fw-bold text-dark">@(Model.CO_Reinstatement_ApprovalNo ?? "—") @(Model.CO_ReinstatementApprovalDate.HasValue ? $"({Model.CO_ReinstatementApprovalDate.Value.ToString("dd-MMM-yyyy")})" : "")</div></div> }
                                </div>
                                @if (!string.IsNullOrEmpty(Model.CO_Reinstatement_ApprovalCopyPath)) { <div class="d-flex gap-2 mt-3 pt-2 border-top"><a href="@Model.CO_Reinstatement_ApprovalCopyPath" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold"><i class="bi bi-file-earmark-check me-1"></i> Approval Copy</a></div> }
                            </div>
                        </div>
                    }

                </div><!-- end tab-content -->
            </div><!-- end Higher Courts card -->

            <!-- Execution Petition (EP) Details Card -->
            @{
                var connectedEPs = ViewBag.ConnectedEPs as List<MVCCaseManagement.Models.LabourEPViewModel>;
            }
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden border-start border-4 border-info">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-info">
                        <i class="bi bi-file-earmark-medical-fill me-2 fs-5 text-info"></i>Execution Petition (EP) Details
                    </h6>
                    @if (connectedEPs != null && connectedEPs.Any())
                    {
                        <span class="badge bg-info text-white rounded-pill px-3 py-2 fw-bold">
                            @connectedEPs.Count EP Record(s) Linked
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border rounded-pill px-3 py-2 fw-bold">
                            No EP Recorded
                        </span>
                    }
                </div>
                <div class="card-body p-4">
                    @if (connectedEPs != null && connectedEPs.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var ep in connectedEPs)
                            {
                                <div class="p-3 bg-light rounded-4 border">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">
                                                <i class="bi bi-file-earmark-medical text-info me-2"></i>EP No: @(ep.EPNumber ?? "-") / @(ep.EPYear?.ToString() ?? "-")
                                            </h6>
                                            <span class="badge bg-info text-white rounded-pill px-3 py-1 me-2">
                                                @(ep.EPStatus ?? "Active EP")
                                            </span>
                                            @if (!string.IsNullOrEmpty(ep.ComplianceStatus))
                                            {
                                                <span class="badge bg-secondary text-white rounded-pill px-3 py-1">
                                                    Compliance: @ep.ComplianceStatus
                                                </span>
                                            }
                                        </div>
                                        <div>
                                            <a href="@Url.Action("Details", "LabourEP", new { id = ep.EPID })" class="btn btn-sm btn-info text-white rounded-pill px-4 fw-bold shadow-sm">
                                                <i class="bi bi-eye-fill me-1"></i> View Full EP Details
                                            </a>
                                        </div>
                                    </div>

                                    <div class="row g-3 mt-1 small text-dark">
                                        <div class="col-md-3">
                                            <span class="text-muted d-block text-uppercase fw-bold xs">Court</span>
                                            <strong class="text-dark">@(ep.EPCourt ?? "Labour Court")</strong>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="text-muted d-block text-uppercase fw-bold xs">Entrustment No &amp; Date</span>
                                            <strong class="text-dark">@(ep.EP_EntrustmentNo ?? "-")</strong>
                                            @if (ep.EP_EntrustmentDate.HasValue)
                                            {
                                                <span class="text-muted small">(@ep.EP_EntrustmentDate.Value.ToString("dd-MMM-yyyy"))</span>
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <span class="text-muted d-block text-uppercase fw-bold xs">Next Hearing Date</span>
                                            <strong class="text-primary">@(ep.NextHearingDate?.ToString("dd-MMM-yyyy") ?? "-")</strong>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="text-muted d-block text-uppercase fw-bold xs">Award &amp; Amount Paid</span>
                                            <div><strong class="text-dark">Award:</strong> ₹ @(ep.AwardAmount?.ToString("N2") ?? "0.00")</div>
                                            <div><strong class="text-success">Paid:</strong> ₹ @(ep.AmountPaid?.ToString("N2") ?? "0.00")</div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(ep.Remarks))
                                    {
                                        <div class="mt-2 pt-2 border-top small text-muted">
                                            <strong>Remarks:</strong> @ep.Remarks
                                        </div>
                                    }

                                    @if (ep.Payments != null && ep.Payments.Any())
                                    {
                                        <div class="mt-3 bg-white p-3 rounded-3 border">
                                            <small class="fw-bold text-success text-uppercase d-block mb-2"><i class="bi bi-cash-stack me-1"></i>EP Payments Recorded (@ep.Payments.Count)</small>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-borderless align-middle mb-0 extra-small">
                                                    <thead>
                                                        <tr class="text-muted border-bottom">
                                                            <th>Amount</th>
                                                            <th>Payment Date</th>
                                                            <th>Cheque No</th>
                                                            <th>Cheque Date</th>
                                                            <th>Remarks</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var pm in ep.Payments)
                                                        {
                                                            <tr>
                                                                <td class="fw-bold text-success">₹ @pm.Amount.ToString("N2")</td>
                                                                <td>@pm.PaymentDate.ToString("dd-MMM-yyyy")</td>
                                                                <td>@(pm.ChequeNumber ?? "-")</td>
                                                                <td>@(pm.ChequeDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                                                <td class="text-muted">@(pm.Remarks ?? "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span><i class="bi bi-info-circle me-1"></i> No Execution Petitions linked to this Arising Application yet.</span>
                            @if (parentCaseObj != null && parentCaseObj.CaseID > 0)
                            {
                                <a href="@Url.Action("Create", "LabourEP", new { caseId = parentCaseObj.CaseID })" class="btn btn-outline-info btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-plus-circle me-1"></i> Create EP Record
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Case Progress & Current Stage -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-activity me-2 text-primary"></i>Current Progress &amp; Hearing</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 border-end">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Next Hearing Date</label>
                            @if (Model.NextHearingDate.HasValue)
                            {
                                <div class="fs-4 fw-bold text-primary">@Model.NextHearingDate.Value.ToString("dd MMM yyyy")</div>
                            }
                            else
                            {
                                <div class="text-muted italic">No hearing scheduled</div>
                            }
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Current Stage</label>
                            <div class="fs-4 fw-bold text-dark">@(Model.CurrentStage ?? "Initial Stage")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certified Copy Timelines (If Adverse) -->
            @if (Model.DisposalResult == "Against")
            {
                <div class="card border-0 shadow-sm mb-4 border-start border-4 border-danger">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between">
                         <h6 class="mb-0 fw-bold text-danger"><i class="bi bi-clock-history me-2"></i>Certified Copy &amp; Timeline Details</h6>
                    </div>
                    <div class="card-body small">
                        <div class="row text-center g-0">
                            <div class="col">
                                <small class="d-block text-muted">Applied</small>
                                <span class="fw-bold">@Model.CC_AppliedDate?.ToShortDateString()</span>
                            </div>
                            <div class="col border-start">
                                <small class="d-block text-muted">Issued</small>
                                <span class="fw-bold">@Model.CC_IssuedDate?.ToShortDateString()</span>
                            </div>
                            <div class="col border-start">
                                <small class="d-block text-muted">Received</small>
                                <span class="fw-bold">@Model.CC_ReceivedDate?.ToShortDateString()</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CC_Remarks))
                        {
                            <div class="mt-3 p-2 bg-light rounded">
                                <strong>Remarks:</strong> @Model.CC_Remarks
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Column: Summary & Metadata -->
        <div class="col-lg-4">
            <!-- Documentation / Files -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                     <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-file-earmark-check me-2 text-success"></i>Files &amp; Documents</h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush small">
                        @if (!string.IsNullOrEmpty(Model.JudgmentCopyPath)) {
                            <a href="@Model.JudgmentCopyPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Judgment Copy
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.DE_HistorySheetPath)) {
                            <a href="@Model.DE_HistorySheetPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-person text-info me-2"></i>DE History Sheet
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.LokAdalatDocumentPath)) {
                            <a href="@Model.LokAdalatDocumentPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-check text-success me-2"></i>Lok Adalat Settlement
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CO_WP_JudgmentCopyPath)) {
                            <a href="@Model.CO_WP_JudgmentCopyPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-pdf text-primary me-2"></i>CO WP Judgment Copy
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CO_WP_StayOrderPath)) {
                            <a href="@Model.CO_WP_StayOrderPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-pdf text-warning me-2"></i>WP Stay Order Copy
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CO_WA_StayOrderPath)) {
                            <a href="@Model.CO_WA_StayOrderPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>WA Stay Order Copy
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CO_ClosedDocumentPath)) {
                            <a href="@Model.CO_ClosedDocumentPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-check text-secondary me-2"></i>CO Closed Document
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CO_Reinstatement_ApprovalCopyPath)) {
                            <a href="@Model.CO_Reinstatement_ApprovalCopyPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-text text-success me-2"></i>Reinstatement Approval Copy
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CO_Reinstatement_StayOrderPath)) {
                            <a href="@Model.CO_Reinstatement_StayOrderPath" target="_blank" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-file-earmark-pdf text-info me-2"></i>Reinstatement Stay Order
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Award Summary & Multiple Payments Card (Added below Files & Documents) -->
            <div class="card border-0 shadow-sm mb-4 border-start border-4 border-success">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-success">
                        <i class="bi bi-cash-stack fs-5 me-2"></i>Award Summary & Payments
                    </h6>
                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addArisingPaymentModal">
                        <i class="bi bi-plus-circle me-1"></i> Add Payment
                    </button>
                </div>
                <div class="card-body p-3">
                    @{
                        decimal awardAmt = Model.AwardAmount ?? 0;
                        decimal totalPaid = Model.Payments != null ? Model.Payments.Sum(p => p.Amount) : 0;
                        decimal balanceAmt = awardAmt - totalPaid;
                    }
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="row text-center g-2">
                            <div class="col-4 border-end">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Award Amount</small>
                                <span class="fw-bold text-dark fs-6">₹ @awardAmt.ToString("N2")</span>
                            </div>
                            <div class="col-4 border-end">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Total Paid</small>
                                <span class="fw-bold text-success fs-6">₹ @totalPaid.ToString("N2")</span>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Balance</small>
                                <span class="fw-bold @(balanceAmt <= 0 && awardAmt > 0 ? "text-success" : "text-danger") fs-6">₹ @balanceAmt.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark small mb-2"><i class="bi bi-clock-history me-1"></i>Payment History:</h6>
                    @if (Model.Payments != null && Model.Payments.Any())
                    {
                        <div class="table-responsive" style="max-height: 220px;">
                            <table class="table table-sm table-hover align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th class="text-end">Amount</th>
                                        <th>Cheque No / Date</th>
                                        <th>Remarks</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Payments)
                                    {
                                        <tr>
                                            <td>@p.PaymentDate.ToString("dd-MMM-yyyy")</td>
                                            <td class="text-end fw-bold text-success">₹ @p.Amount.ToString("N2")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(p.ChequeNumber))
                                                {
                                                    <span>@p.ChequeNumber @(p.ChequeDate.HasValue ? $"({p.ChequeDate.Value.ToString("dd/MM/yy")})" : "")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(p.Remarks))
                                                {
                                                    <span class="text-dark small">@p.Remarks</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 border-0" onclick="deleteArisingPayment(@p.PaymentID)" title="Delete Payment">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted italic small text-center py-2 bg-light rounded border">
                            No payment records added yet. Click <strong>+ Add Payment</strong> to record payments.
                        </div>
                    }
                </div>
            </div>

            <!-- Metadata Tracking -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body small p-3">
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted">Is Doc Sent?</span>
                        <span class="fw-bold @(Model.IsDocumentSent ? "text-success" : "text-muted")">@(Model.IsDocumentSent ? "YES" : "NO")</span>
                    </div>
                    @if (Model.IsDocumentSent) {
                        <div class="mb-2 ps-2 border-start">
                            <small class="text-muted d-block">Outward: @Model.DocumentSent_OutwardNo</small>
                            <small class="text-muted d-block">Date: @Model.DocumentSent_OutwardDate?.ToShortDateString()</small>
                        </div>
                    }
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted">Objection Filed?</span>
                        <span class="fw-bold @(Model.IsObjectionFiled ? "text-success" : "text-muted")">@(Model.IsObjectionFiled ? "YES" : "NO")</span>
                    </div>
                    <hr class="my-2"/>
                    <div class="mb-1 text-muted">Created: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    @if (Model.ModifiedDate.HasValue) {
                        <div class="text-muted">Modified: @Model.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- CASE NOTINGS SECTION (Central Office & Legal Officers only - Hidden for Division logins) -->
    @{
        var arDivId = User.FindFirst("DivisionID")?.Value;
        var arRoleUpper = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "").ToUpperInvariant();
        bool canViewArisingNotings = string.IsNullOrEmpty(arDivId) || arDivId == "0" || arDivId == "5"
            || arRoleUpper.Contains("MD") || arRoleUpper.Contains("CLO") || arRoleUpper.Contains("LO")
            || arRoleUpper.Contains("ADMIN") || arRoleUpper.Contains("CENTRAL")
            || isCO;
    }
    @if (canViewArisingNotings)
    {
        var arisingNotingVM = new MVCCaseManagement.Models.CaseNotingViewModel
        {
            CaseType = "ARISING",
            CaseID = Model.ArisingID,
            CaseNumberTitle = $"Arising App No. {Model.CaseNumber}/{Model.CaseYear}",
            Notings = (ViewBag.CaseNotings as List<MVCCaseManagement.Models.CaseNoting>) ?? new List<MVCCaseManagement.Models.CaseNoting>()
        };
        <partial name="_CaseNotingsSection" model="arisingNotingVM" />
    }
</div>

