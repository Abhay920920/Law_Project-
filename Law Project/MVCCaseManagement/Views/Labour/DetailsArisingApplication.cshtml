                                </button>
                            </li>
                        }
                        @if (hasArisingReinstatement) {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small py-2 px-3 rounded-pill border" id="aa-tab-rein" data-bs-toggle="pill" data-bs-target="#aa-pane-rein" type="button" role="tab">
                                    <i class="bi bi-person-check-fill me-1 text-success"></i>Reinstatement
                                    <span class="badge bg-success text-white rounded-pill ms-1">@(Model.CO_IsWorkmanReinstated ? "Reinstated" : "Pending")</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content">

