@model MVCCaseManagement.Models.MVCCaseViewModel
@{
    ViewData["Title"] = "Remand Back Case Entry";
    ViewData["HidePageHeader"] = true;
}

<div class="row justify-content-center">
    <div class="col-xl-11">
        <!-- Search Section -->
        <div class="card mb-4 shadow-sm border-0 bg-light">
             <div class="card-body p-4">
                 <h5 class="fw-bold text-primary mb-3">
                     <i class="bi bi-search me-2"></i> Find Original Case Record
                 </h5>
                 <div class="row g-3 align-items-end">
                     <div class="col-md-3">
                         <label class="form-label">MVC Number</label>
                         <input type="text" id="paramsMvcNo" class="form-control" placeholder="e.g. 123" />
                     </div>
                     <div class="col-md-2">
                         <label class="form-label">MVC Year</label>
                         <input type="number" id="paramsMvcYear" class="form-control" value="@DateTime.Now.Year" />
                     </div>
                     <div class="col-md-4">
                         <label class="form-label">MACT Court</label>
                         <select id="paramsMactId" class="form-select">
                             <option value="">-- Select MACT --</option>
                             @if (ViewBag.MACTs != null)
                             {
                                 foreach (var m in ViewBag.MACTs)
                                 {
                                     <option value="@m.MACTID">@m.MACTName</option>
                                 }
                             }
                         </select>
                     </div>
                     <div class="col-md-3">
                         <button type="button" class="btn btn-primary w-100" id="btnFetchDetails">
                             <i class="bi bi-eye me-2"></i> View Details
                         </button>
                     </div>
                 </div>
                 <div class="mt-2 text-danger small fw-bold" id="searchError" style="display:none;"></div>
             </div>
        </div>

        <!-- Case Entry Form (Hidden until Fetch) -->
        <div id="entryFormContainer" style="display:none;">
            <form asp-action="SaveRemindBack" method="post" id="caseEntryForm" enctype="multipart/form-data">
                <input type="hidden" asp-for="CaseID" id="CaseID" />
                <input type="hidden" asp-for="OriginalCaseID" id="OriginalCaseID" />
                <div class="d-flex align-items-center mb-4">
                    <div class="icon-box bg-success-subtle p-3 rounded-3 me-3">
                        <i class="bi bi-arrow-counterclockwise fs-2 text-success"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold text-dark">Remand Back Case Details</h3>
                        <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i> Full details fetched. Review and update before saving.</p>
                    </div>
                    <div class="ms-auto">
                        <button type="submit" class="btn btn-primary btn-lg shadow">
                            <i class="bi bi-cloud-upload me-2"></i> Confirm and Register Case
                        </button>
                    </div>
                </div>

                <!-- SECTION A: CASE IDENTIFICATION -->
                <div class="case-section-card silent-blue mb-4 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center">
                        <span class="official-badge-id me-2">SECTION A</span>
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-fingerprint me-2 text-primary"></i>CASE IDENTIFICATION</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <!-- eCourts NAPIX Gateway Auto-Linkage Box -->
                            <div class="col-12">
                                <div class="card bg-light border-primary shadow-sm p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-broadcast me-2"></i>eCourts NAPIX Live Gateway Auto-Linkage</h6>
                                        <span id="cnr-status-badge"></span>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label for="mvc-ecourts-state" class="form-label small font-weight-bold">State</label>
                                            <select id="mvc-ecourts-state" class="form-select form-select-sm" onchange="onMvcStateChange()">
                                                <option value="">Loading States...</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label for="mvc-ecourts-dist" class="form-label small font-weight-bold">District</label>
                                            <select id="mvc-ecourts-dist" class="form-select form-select-sm" onchange="onMvcDistChange()">
                                                <option value="">Select District</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label for="mvc-ecourts-est" class="form-label small font-weight-bold">eCourts Establishment</label>
                                            <select id="mvc-ecourts-est" class="form-select form-select-sm" asp-for="EstCode" onchange="onMvcEstChange()">
                                                <option value="">Select Establishment</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label for="mvc-ecourts-type" class="form-label small font-weight-bold">Case Type Code</label>
                                            <select id="mvc-ecourts-type" class="form-select form-select-sm" asp-for="CaseTypeCode" onchange="triggerMvcCnrDiscovery()">
                                                <option value="">Select Type Code</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mt-2">
                                            <label for="mvc-cnr-number" class="form-label small font-weight-bold">16-Digit CNR Number</label>
                                            <div class="input-group input-group-sm">
                                                <input asp-for="CNRNumber" id="mvc-cnr-number" class="form-control font-monospace" placeholder="16-Digit CNR (e.g. KADW220012342020)" oninput="onCnrInputChange(this.value)" onchange="onCnrInputChange(this.value)" />
                                                <button type="button" class="btn btn-primary" onclick="fetchAndRenderLiveCnrDetails($('#mvc-cnr-number').val())">
                                                    <i class="bi bi-cloud-arrow-down-fill me-1"></i> Fetch
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mt-2 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="triggerMvcCnrDiscovery()">
                                                <i class="bi bi-search"></i> Auto-Discover CNR from eCourts
                                            </button>
                                        </div>
                                        <div class="col-12 mt-3" id="ecourts-live-preview-card" style="display:none;"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DivisionID" class="form-label"></label>
                                <input type="hidden" asp-for="DivisionID" id="DivisionID" />
                                <input class="form-control" value="@ViewBag.UserDivisionName" readonly />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MVCNo" class="form-label"></label>
                                <input asp-for="MVCNo" class="form-control border-primary-subtle" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MVCYear" class="form-label"></label>
                                <input asp-for="MVCYear" class="form-control border-primary-subtle" type="number" required />
                            </div>
                            <div class="col-md-12">
                                <label asp-for="MACTID" class="form-label"></label>
                                <select asp-for="MACTID" id="MACTID" class="form-select border-primary-subtle" asp-items="@(new SelectList(ViewBag.MACTs, "MACTID", "MACTName"))" required>
                                    <option value="">-- Choose MACT Court --</option>
                                </select>
                            </div>
                            <div class="col-md-12 mb-2">
                                 <label class="form-label d-block fw-bold text-secondary small text-uppercase">Vehicle Type</label>
                                 <div class="form-check form-check-inline">
                                     <input class="form-check-input" type="radio" asp-for="VehicleType" value="Corporation" id="vtCorp">
                                     <label class="form-check-label" for="vtCorp">Corporation (NWKRTC)</label>
                                 </div>
                                 <div class="form-check form-check-inline">
                                     <input class="form-check-input" type="radio" asp-for="VehicleType" value="Private" id="vtPrivate">
                                     <label class="form-check-label" for="vtPrivate">Private / Hired / Other</label>
                                 </div>
                             </div>
                            <div class="col-md-6">
                                <label asp-for="VehicleNo" class="form-label"></label>
                                <input asp-for="VehicleNo" class="form-control" id="vehicleNoInput" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AccidentDate" class="form-label"></label>
                                <input asp-for="AccidentDate" class="form-control" type="date" />
                            </div>
                            <div class="col-md-12">
                                <label asp-for="CaseType" class="form-label fw-bold text-primary">Case Type</label>
                                <select asp-for="CaseType" class="form-select border-primary">
                                    <option value="Pending">Pending</option>
                                    <option value="Disposed">Disposed</option>
                                    <option value="DNP">DNP (Dismissed For Non-Prosecution)</option>
                                    <option value="Ex-parte">Ex-parte</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion official-accordion mb-4" id="optionalSections">
                    <!-- SECTION B: PETITIONER DETAILS -->
                    <div class="accordion-item silent-indigo shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#secB">
                                <span class="official-badge-id me-2">SECTION B</span>
                                <i class="bi bi-people-fill me-2 text-primary"></i>
                                <span>Petitioner Details</span>
                            </button>
                        </h2>
                        <div id="secB" class="accordion-collapse collapse show" data-bs-parent="#optionalSections">
                            <div class="accordion-body">
                                <div class="dynamic-table-container">
                                    <table class="table table-sm table-hover mb-0 dynamic-table" id="petitionersTable">
                                        <thead>
                                            <tr>
                                                <th>Petitioner Name</th>
                                                <th>Relationship</th>
                                                <th style="width: 50px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="3" class="p-2">
                                                    <button type="button" class="btn btn-sm btn-link text-decoration-none" id="btnAddPetitioner">
                                                        <i class="bi bi-person-plus-fill me-1"></i> Add Petitioner
                                                    </button>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION C: NATURE OF CLAIM -->
                    <div class="accordion-item silent-emerald shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#secC">
                                <span class="official-badge-id me-2">SECTION C</span>
                                <i class="bi bi-shield-exclamation me-2 text-primary"></i>
                                <span>Nature of Claim</span>
                            </button>
                        </h2>
                        <div id="secC" class="accordion-collapse collapse" data-bs-parent="#optionalSections">
                            <div class="accordion-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="ClaimType" class="form-label"></label>
                                        <select asp-for="ClaimType" class="form-select">
                                            <option value="">-- Choose Type --</option>
                                            <option value="Injury">Injury</option>
                                            <option value="Death">Death</option>
                                            <option value="Property Damage">Property Damage</option>
                                            <option value="Vehicle Damage">Vehicle Damage</option>
                                            <option value="Animal Injured">Animal Injured</option>
                                            <option value="Animal death">Animal death</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 d-flex align-items-end">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" asp-for="ThirdPartyFlag" id="ThirdPartyFlag">
                                            <label class="form-check-label" for="ThirdPartyFlag">Third Party Involved?</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION D: FINANCIAL & ADVOCATE DETAILS -->
                    <div class="accordion-item silent-amber shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#secD">
                                <span class="official-badge-id me-2">SECTION D</span>
                                <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                                <span>Financial & Advocate Details</span>
                            </button>
                        </h2>
                        <div id="secD" class="accordion-collapse collapse" data-bs-parent="#optionalSections">
                            <div class="accordion-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="ClaimAmount" class="form-label"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="ClaimAmount" class="form-control" type="number" placeholder="0.00" />
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <label asp-for="AdvocateName" class="form-label"></label>
                                        <div class="input-group">
                                            <select id="AdvocateSelect" class="form-select flex-grow-1">
                                                <option value="">-- Choose Advocate --</option>
                                            </select>
                                            <input type="text" id="AdvocateManualEntry" class="form-control" placeholder="Type Advocate Name" style="display:none; flex-grow: 2;" />
                                            <input type="hidden" asp-for="AdvocateName" id="AdvocateNameHidden" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="EntrustmentNo" class="form-label"></label>
                                        <input asp-for="EntrustmentNo" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="EntrustmentDate" class="form-label"></label>
                                        <input asp-for="EntrustmentDate" class="form-control" type="date" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION E: CASE LINKAGES -->
                    <div class="accordion-item silent-slate shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#secE">
                                <span class="official-badge-id me-2">SECTION E</span>
                                <i class="bi bi-link-45deg me-2 text-primary"></i>
                                <span>Case Linkages</span>
                            </button>
                        </h2>
                        <div id="secE" class="accordion-collapse collapse" data-bs-parent="#optionalSections">
                            <div class="accordion-body">
                                <div class="dynamic-table-container">
                                    <table class="table table-sm table-hover mb-0 dynamic-table" id="connectedCasesTable">
                                        <thead>
                                            <tr>
                                                <th>Connected MVC No</th>
                                                <th>Year</th>
                                                <th>MACT</th>
                                                <th>Double Claim?</th>
                                                <th style="width: 50px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="5" class="p-2">
                                                    <button type="button" class="btn btn-sm btn-link text-decoration-none" id="btnAddCase">
                                                        <i class="bi bi-plus-circle me-1"></i> Add Linked Case
                                                    </button>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION F: CASE PROGRESS -->
                    <div class="accordion-item disposal-gate shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#secF">
                                <span class="official-badge-id bg-danger text-white me-2">SECTION F</span>
                                <i class="bi bi-graph-up-arrow me-2 text-danger"></i>
                                <span class="text-danger fw-bold">Case Progress</span>
                            </button>
                        </h2>
                        <div id="secF" class="accordion-collapse collapse" data-bs-parent="#optionalSections">
                            <div class="accordion-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label d-block">Document Sent?</label>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" value="true" asp-for="IsDocumentSent" id="isDocSentYes">
                                            <label class="form-check-label" for="isDocSentYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" value="false" asp-for="IsDocumentSent" id="isDocSentNo">
                                            <label class="form-check-label" for="isDocSentNo">No</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8" id="documentDetails" style="display:none;">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label asp-for="DocumentOutwardNo" class="form-label"></label>
                                                <input asp-for="DocumentOutwardNo" class="form-control" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="DocumentOutwardDate" class="form-label"></label>
                                                <input asp-for="DocumentOutwardDate" class="form-control" type="date" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label d-block">Objection Filed?</label>
                                        <div class="form-check form-check-inline">
                                             <input class="form-check-input" type="radio" value="true" asp-for="IsObjectionFiled" id="isObjFiledYes">
                                             <label class="form-check-label" for="isObjFiledYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                             <input class="form-check-input" type="radio" value="false" asp-for="IsObjectionFiled" id="isObjFiledNo">
                                             <label class="form-check-label" for="isObjFiledNo">No</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8" id="objectionDateDiv" style="display:none;">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label asp-for="ObjectionOutwardNo" class="form-label fw-bold">Objection Outward Number</label>
                                                <input asp-for="ObjectionOutwardNo" class="form-control" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="ObjectionFiledDate" class="form-label fw-bold">Objection Filed Date</label>
                                                <input asp-for="ObjectionFiledDate" class="form-control" type="date" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Impleading Filed -->
                                    <div class="col-md-4">
                                        <label class="form-label d-block fw-bold">Impleading Filed?</label>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsImpleadingAppFiled" id="impleadYes">
                                            <label class="form-check-label" for="impleadYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsImpleadingAppFiled" id="impleadNo">
                                            <label class="form-check-label" for="impleadNo">No</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8" id="impleadReasonCol" style="display:none;">
                                        <label asp-for="AdverseAward.ImpleadingAppNotFiledReason" class="form-label fw-bold">Reason for not filing</label>
                                        <input asp-for="AdverseAward.ImpleadingAppNotFiledReason" class="form-control" placeholder="Provide reason..." />
                                    </div>

                                    <!-- Manner of Accident -->
                                    <div class="col-md-12">
                                        <label asp-for="AdverseAward.MannerOfAccident" class="form-label fw-bold">Manner of Accident (Claim/Award)</label>
                                        <textarea asp-for="AdverseAward.MannerOfAccident" class="form-control" rows="3" placeholder="Description as per claim petition or award..."></textarea>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="CurrentStage" class="form-label"></label>
                                        <input asp-for="CurrentStage" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NextHearingDate" class="form-label">Next Date of Hearing</label>
                                        <input asp-for="NextHearingDate" class="form-control" type="date" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION G: DISPOSAL STATUS & ADVERSE WORKFLOW -->
                    <div class="accordion-item silent-blue shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#secG">
                                <span class="official-badge-id me-2">SECTION G</span>
                                <i class="bi bi-shield-lock-fill me-2 text-primary"></i>
                                <span>Disposal Status & Adverse Award Workflow</span>
                            </button>
                        </h2>
                        <div id="secG" class="accordion-collapse collapse" data-bs-parent="#optionalSections">
                            <div class="accordion-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="DisposalStatus" class="form-label"></label>
                                        <select asp-for="DisposalStatus" class="form-select">
                                            <option value="">-- Choose Status --</option>
                                            <option value="Disposed">Disposed</option>
                                            <option value="DNP">DNP</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="DisposalResult" class="form-label"></label>
                                        <select asp-for="DisposalResult" class="form-select" id="disposalResultSelect">
                                            <option value="">-- Choose Result --</option>
                                            <option value="Favor">Favor</option>
                                            <option value="Against">Against</option>
                                        </select>
                                    </div>
                                    
                                    <div id="remarksContainer" style="display: none;" class="col-md-12">
                                        <div class="row g-3">
                                            <div class="col-md-8">
                                                <label asp-for="DisposalRemarks" class="form-label"></label>
                                                <textarea asp-for="DisposalRemarks" class="form-control" rows="2"></textarea>
                                            </div>
                                            <div class="col-md-4">
                                                <label asp-for="ClosureDate" class="form-label fw-bold">Closure Date</label>
                                                <input asp-for="ClosureDate" class="form-control" type="date" />
                                            </div>
                                        </div>
                                    </div>

                                    <div id="adverseWorkflowContainer" style="display: none;" class="col-md-12">
                                        <hr class="my-4" />
                                        <div class="alert alert-danger py-2 mb-4 d-flex align-items-center">
                                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                            <h5 class="mb-0">ADVERSE AWARD WORKFLOW (AGAINST CORPORATION)</h5>
                                        </div>
                                        
                                        <!-- B. WORK AFTER DISPOSAL -->
                                        <h6 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-wrench-adjustable me-2"></i>B. WORK AFTER DISPOSAL</h6>
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-12">
                                                <div class="row g-2 align-items-center">
                                                    <div class="col-md-4">
                                                        <label class="form-label d-block mb-0 fw-bold">Is Vehicle Insured?</label>
                                                        <div class="d-flex gap-3 mt-1">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="radio" value="true" asp-for="AdverseAward.IsBusInsured" id="isBusInsuredYes">
                                                                <label class="form-check-label" for="isBusInsuredYes">Yes</label>
                                                            </div>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="radio" value="false" asp-for="AdverseAward.IsBusInsured" id="isBusInsuredNo">
                                                                <label class="form-check-label" for="isBusInsuredNo">No</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-8" id="busInsuranceDetailsCol" style="display:none;">
                                                        <label asp-for="AdverseAward.BusInsuranceDetails" class="form-label small fw-bold">ST Bus Insurance Details</label>
