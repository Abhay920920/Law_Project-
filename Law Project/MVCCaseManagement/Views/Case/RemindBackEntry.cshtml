                                            </div>
                                            <div class="col-md-6 co-only" style="display:none;">
                                                <label asp-for="AdverseAward.OutwardNumber" class="form-label small fw-bold"></label>
                                                <input asp-for="AdverseAward.OutwardNumber" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-md-12">
                                                <label asp-for="AdverseAward.ClosureRemarks" class="form-label small fw-bold"></label>
                                                <textarea asp-for="AdverseAward.ClosureRemarks" class="form-control form-control-sm" rows="2"></textarea>
                                            </div>
                                            <div class="col-md-4">
                                                <label asp-for="AdverseAward.ClosureDate" class="form-label small fw-bold"></label>
                                                <input asp-for="AdverseAward.ClosureDate" class="form-control form-control-sm" type="date" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center py-4 mb-5">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow">
                        <i class="bi bi-check2-circle me-2"></i> Confirm and Register Case Entry
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .case-section-card { border-radius: 12px; border: none; }
    .card-header { border-bottom: 2px solid #f1f5f9; }
    .official-badge-id { background-color: #e2e8f0; color: #475569; font-weight: 800; padding: 4px 10px; border-radius: 6px; font-size: 11px; }
    .icon-box { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; }
</style>

@section Scripts {
    <script src="~/js/ecourts-cascade.js"></script>
    <script>
        let _latestLiveCnrData = null;

        window.onMvcStateChange = function() {
            const stateCode = $('#mvc-ecourts-state').val();
            if (stateCode) {
                ECourtsCascade.loadDistricts(stateCode, 'mvc-ecourts-dist');
            }
        };

        window.onMvcDistChange = function() {
            const stateCode = $('#mvc-ecourts-state').val();
            const distCode = $('#mvc-ecourts-dist').val();
            if (stateCode && distCode) {
                ECourtsCascade.loadCourtComplexes(stateCode, distCode, 'mvc-ecourts-est');
                ECourtsCascade.loadCaseTypes('', 'mvc-ecourts-type', false, stateCode, distCode);
            }
        };

        window.onMvcEstChange = function() {
            const estCode = $('#mvc-ecourts-est').val();
            const stateCode = $('#mvc-ecourts-state').val();
            const distCode = $('#mvc-ecourts-dist').val();
            if (estCode) {
                ECourtsCascade.loadCaseTypes(estCode, 'mvc-ecourts-type', false, stateCode, distCode);
                triggerMvcCnrDiscovery();
            }
        };

        window.onCnrInputChange = function(val) {
            const cleanCnr = (val || '').trim().toUpperCase();
            if (cleanCnr.length === 16) {
                fetchAndRenderLiveCnrDetails(cleanCnr);
            }
        };

        window.fetchAndRenderLiveCnrDetails = async function(cnr) {
            const cleanCnr = (cnr || '').trim().toUpperCase();
            const previewContainer = $('#ecourts-live-preview-card');
            const statusElem = document.getElementById('cnr-status-badge');

            if (cleanCnr.length !== 16) {
                previewContainer.html('<div class="alert alert-warning py-2 small mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Please enter a valid 16-digit CNR Number before fetching.</div>').slideDown();
                return;
            }

            if (statusElem) statusElem.innerHTML = '<span class="badge bg-info text-dark"><i class="bi bi-arrow-repeat"></i> Fetching eCourts Live Gateway Data...</span>';
            previewContainer.html('<div class="p-3 text-center text-muted"><div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>Connecting to Live eCourts NAPIX Gateway...</div>').slideDown();

            try {
                const res = await fetch(`/ECourts/GetCnrDetails?cnrNumber=${encodeURIComponent(cleanCnr)}`);
                const data = await res.json();
                if (data.success && data.data) {
                    _latestLiveCnrData = data;
                    const s = data.data;
                    if (statusElem) statusElem.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> eCourts Verified: ${cleanCnr}</span>`;

                    let html = `
                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                            <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                                <span class="fw-bold small"><i class="bi bi-building-check me-2"></i>Live eCourts Case Summary: ${cleanCnr}</span>
                                <span class="badge bg-light text-dark fw-bold font-monospace">${s.stage || 'ACTIVE'}</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2 mb-3">
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Court Establishment</small>
                                        <span class="fw-bold text-dark small">${s.establishment_name || s.court_no_judge || 'N/A'}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Case Number & Type</small>
                                        <span class="fw-bold text-dark small">${s.case_type || 'MVC'} ${s.case_number || ''}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Next Hearing Date</small>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">${s.next_hearing_date || 'Not Scheduled'}</span>
                                    </div>
                                    <div class="col-md-6 mt-2">
                                        <small class="text-muted d-block">Petitioner(s)</small>
                                        <span class="fw-semibold text-dark small">${s.petitioner || 'N/A'}</span>
                                    </div>
                                    <div class="col-md-6 mt-2">
                                        <small class="text-muted d-block">Respondent(s)</small>
                                        <span class="fw-semibold text-dark small">${s.respondent || 'N/A'}</span>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="$('#ecourts-live-preview-card').slideUp()">
                                        <i class="bi bi-x-circle me-1"></i> Close Preview
                                    </button>
                                    <button type="button" class="btn btn-sm btn-success fw-bold shadow-sm" onclick="autofillRemindBackFromECourts()">
                                        <i class="bi bi-magic me-1"></i> Autofill Form from eCourts
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    previewContainer.html(html).slideDown();
                } else {
                    if (statusElem) statusElem.innerHTML = `<span class="badge bg-warning text-dark"><i class="bi bi-info-circle"></i> CNR Not Found</span>`;
                    previewContainer.html(`<div class="alert alert-warning py-2 small mb-0"><i class="bi bi-exclamation-circle me-1"></i> ${data.message || 'No live data found on eCourts Gateway for this CNR.'}</div>`).slideDown();
                }
            } catch (err) {
                if (statusElem) statusElem.innerHTML = `<span class="badge bg-danger"><i class="bi bi-x-circle"></i> Gateway Offline</span>`;
                previewContainer.html('<div class="alert alert-danger py-2 small mb-0"><i class="bi bi-wifi-off me-1"></i> Unable to connect to eCourts Gateway. Please try again.</div>').slideDown();
            }
        };

        window.autofillRemindBackFromECourts = function() {
            if (!_latestLiveCnrData || !_latestLiveCnrData.data) return;
            const s = _latestLiveCnrData.data;

            if (s.case_number) {
                const match = s.case_number.match(/(\d+)\s*\/\s*(\d{4})/);
                if (match) {
                    $('#MVCNo').val(match[1]);
                    $('#MVCYear').val(match[2]);
                } else {
                    const digits = s.case_number.replace(/\D/g, '');
                    if (digits) $('#MVCNo').val(digits);
                }
            }

            if (s.stage) {
                $('#CurrentStage').val(s.stage);
            }
            if (s.next_hearing_date) {
                const dateParts = s.next_hearing_date.split('-');
                if (dateParts.length === 3) {
                    const yyyy = dateParts[2].length === 4 ? dateParts[2] : (dateParts[0].length === 4 ? dateParts[0] : '');
                    const mm = dateParts[1].padStart(2, '0');
                    const dd = dateParts[0].length <= 2 ? dateParts[0].padStart(2, '0') : dateParts[2].padStart(2, '0');
                    if (yyyy) $('#NextHearingDate').val(`${yyyy}-${mm}-${dd}`);
                }
            }

            if (s.petitioner) {
                const pName = s.petitioner.split(/\r?\n|,/)[0].trim();
                const firstPetInput = $('input[name^="Petitioners"][name$=".PetitionerName"]').first();
                if (firstPetInput.length) firstPetInput.val(pName);
                else addPetitionerRow(pName);
            }

            alert("Case details successfully updated from eCourts Live Gateway!");
        };

        window.triggerMvcCnrDiscovery = async function() {
            const cnrElem = document.getElementById('mvc-cnr-number');
            const cnrVal = cnrElem ? cnrElem.value.trim().toUpperCase() : '';
            const statusElem = document.getElementById('cnr-status-badge');

            if (cnrVal.length === 16) {
                fetchAndRenderLiveCnrDetails(cnrVal);
                return;
            }

            const estCode = $('#mvc-ecourts-est').val();
            const caseType = $('#mvc-ecourts-type').val() || '47';
            const regNo = $('#MVCNo').val();
            const regYear = $('#MVCYear').val();

            if (estCode && caseType && regNo && regYear) {
                if (statusElem) statusElem.innerHTML = '<span class="badge bg-info text-dark"><i class="bi bi-hourglass-split"></i> Auto-Discovering CNR on eCourts Gateway...</span>';
                ECourtsCascade.autoDiscoverCNR(estCode, caseType, regNo, regYear, 'mvc-cnr-number', 'cnr-status-badge', function(foundCnr) {
                    if (foundCnr) {
                        fetchAndRenderLiveCnrDetails(foundCnr);
                    }
                });
            }
        };

        let petIndex = 0;
        let caseIndex = 0;
        let counter = { 'pwList': 0, 'docList': 0, 'rwList': 0 };

        function addPetitionerRow(name = '', rel = '') {
            const row = `
                <tr>
                    <td><input name="Petitioners[${petIndex}].PetitionerName" class="form-control form-control-sm" value="${name}" required /></td>
                    <td>
                        <select name="Petitioners[${petIndex}].Relationship" class="form-select form-select-sm">
                            <option value="">-- Select --</option>
                            <option value="Self" ${rel==='Self'?'selected':''}>Self</option>
                            <option value="Father" ${rel==='Father'?'selected':''}>Father</option>
                            <option value="Mother" ${rel==='Mother'?'selected':''}>Mother</option>
                            <option value="Son" ${rel==='Son'?'selected':''}>Son</option>
                            <option value="Daughter" ${rel==='Daughter'?'selected':''}>Daughter</option>
                            <option value="Husband" ${rel==='Husband'?'selected':''}>Husband</option>
                            <option value="Wife" ${rel==='Wife'?'selected':''}>Wife</option>
                            <option value="Brother" ${rel==='Brother'?'selected':''}>Brother</option>
                            <option value="Sister" ${rel==='Sister'?'selected':''}>Sister</option>
                            <option value="Guardian" ${rel==='Guardian'?'selected':''}>Guardian</option>
                        </select>
                    </td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger border-0 remove-row"><i class="bi bi-trash"></i></button></td>
                </tr> `;
            $('#petitionersTable tbody').append(row);
            petIndex++;
        }

        function addConnectedRow(mvcNo = '', year = '', mact = '', isDouble = false) {
            const row = `
                <tr>
                    <td><input name="ConnectedCases[${caseIndex}].ConnectedMVCNo" class="form-control form-control-sm" value="${mvcNo}" required /></td>
                    <td><input name="ConnectedCases[${caseIndex}].ConnectedYear" class="form-control form-control-sm" type="number" value="${year}" required /></td>
                    <td><input name="ConnectedCases[${caseIndex}].MACT" class="form-control form-control-sm" value="${mact}" /></td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="ConnectedCases[${caseIndex}].IsDoubleClaim" value="true" ${isDouble?'checked':''} />
                    </td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger border-0 remove-row"><i class="bi bi-trash"></i></button></td>
                </tr> `;
            $('#connectedCasesTable tbody').append(row);
            caseIndex++;
        }

        function addDynamicInput(containerId, propertyPrefix, value = '') {
            const container = document.getElementById(containerId);
            const div = document.createElement('div');
            div.className = 'input-group input-group-sm mb-2';
            div.innerHTML = `
                <input name="${propertyPrefix}[${counter[containerId]}]" class="form-control" value="${value}" required />
                <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
            `;
            container.appendChild(div);
            counter[containerId]++;
        }

        function addDoctorInput(name = '', isTreated = false) {
            const container = document.getElementById('docList');
            const div = document.createElement('div');
            div.className = 'border p-2 mb-2 rounded bg-light';
            div.innerHTML = `
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <input name="AdverseAward.Doctors[${counter['docList']}].DoctorName" class="form-control form-control-sm" placeholder="Doctor Name" value="${name}" required />
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="AdverseAward.Doctors[${counter['docList']}].IsTreated" value="true" id="treatedYes_${counter['docList']}" ${isTreated ? 'checked' : ''}>
                                <label class="form-check-label small" for="treatedYes_${counter['docList']}">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="AdverseAward.Doctors[${counter['docList']}].IsTreated" value="false" id="treatedNo_${counter['docList']}" ${!isTreated ? 'checked' : ''}>
                                <label class="form-check-label small" for="treatedNo_${counter['docList']}">No</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.border').remove()"><i class="bi bi-x"></i></button>
                    </div>
                </div>
            `;
            container.appendChild(div);
            counter['docList']++;
        }

        function addRWInput(name = '', designation = '') {
            const container = document.getElementById('rwList');
            const showDesignation = $('#rwTypeSelect').val() === 'Others';
            const div = document.createElement('div');
            div.className = 'input-group input-group-sm mb-2';
            div.innerHTML = `
                <input name="AdverseAward.RWNames[${counter['rwList']}]" class="form-control" placeholder="Name" value="${name}" required />
                <div class="rw-designation-container" style="display: ${showDesignation ? 'block' : 'none'}; width: 40%">
                    <input name="AdverseAward.RWDesignations[${counter['rwList']}]" class="form-control" placeholder="Designation" value="${designation}" />
                </div>
                <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
            `;
            container.appendChild(div);
            counter['rwList']++;
        }

        $(document).ready(function() {
            // Toggles
            $('input[name="IsDocumentSent"]').change(function(){ $('#documentDetails').toggle($(this).val()==='true'); });
            $('input[name="IsObjectionFiled"]').change(function(){ $('#objectionDateDiv').toggle($(this).val()==='true'); });
            $('input[name="AdverseAward.IsBusInsured"]').change(function(){ $('#busInsuranceDetailsCol').toggle($(this).val()==='true'); });
            $('input[name="AdverseAward.ObjectionFiled"]').change(function(){ $('#advObjRemarksCol').toggle($(this).val()==='true'); });
            $('input[name="AdverseAward.DoubleClaimFlag"]').change(function(){ $('#dcDetailsCol').toggle($(this).val()==='true'); });
            
            $("#disposalResultSelect").change(function () {
                const val = $(this).val();
                $('#remarksContainer').toggle(val === "Favor");
                $('#adverseWorkflowContainer').toggle(val === "Against");
            });

            $("#forwardStatusSelect").change(function () {
                $('.co-only').toggle($(this).val() === "Sent to Central Office");
            });

            $("#punishmentStatusSelect").change(function(){ $('#punishmentDetailsCol').toggle($(this).val()==='Order Issued'); });

            $('input[name="IsMedicalExpensesPaid"]').change(function() {
                $('.medicalDetails').toggle($(this).val() === 'true');
            });
            $('input[name="IsARFAmountPaid"]').change(function() {
                $('.arfDetails').toggle($(this).val() === 'true');
            });

            $('#rwTypeSelect').change(function() {
                if ($(this).val() === 'Others') {
                    $('.rw-designation-container').show();
                } else {
                    $('.rw-designation-container').hide();
                    $('.rw-designation-container input').val('');
                }
            });

            $('input[name="AdverseAward.IsImpleadingAppFiled"]').change(function() {
                if ($(this).val() === 'false') $('#impleadReasonCol').slideDown();
                else $('#impleadReasonCol').slideUp();
            });

            // Calculation
            $("#AwardAmount, #LiabilityPercentage").on("input change", function(){
                const amt = parseFloat($("#AwardAmount").val()) || 0;
                const pct = parseFloat($("#LiabilityPercentage").val()) || 0;
                $("#LiableAmount").val(((amt * pct) / 100).toFixed(2));
            });

            // Load Advocates
            const divisionId = $("#DivisionID").val();
            if (divisionId) {
                $.get('/Case/GetAdvocates?divisionId=' + divisionId, function (data) {
                    const $dropdown = $("#AdvocateSelect");
                    $dropdown.empty().append('<option value="">-- Choose Advocate --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, Name) { $dropdown.append($('<option>', { value: Name, text: Name })); });
                    }
                    $dropdown.append('<option value="Others">Others</option>');
                });
            }

            $("#AdvocateSelect").change(function () {
                const val = $(this).val();
                if (val === "Others") { $("#AdvocateManualEntry").show(); $("#AdvocateNameHidden").val(''); }
                else { $("#AdvocateManualEntry").hide(); $("#AdvocateNameHidden").val(val); }
            });
            $("#AdvocateManualEntry").on("input", function () { $("#AdvocateNameHidden").val($(this).val()); });

            // Init eCourts cascade for Remand Back
            try {
                if (typeof ECourtsCascade !== 'undefined') {
                    ECourtsCascade.loadStates('mvc-ecourts-state', 'KA');
                    setTimeout(function() {
                        ECourtsCascade.loadDistricts('KA', 'mvc-ecourts-dist');
                    }, 400);
                }
            } catch (e) { }

            $('#btnAddPetitioner').click(() => addPetitionerRow());
            $('#btnAddCase').click(() => addConnectedRow());
            $(document).on('click', '.remove-row', function() { $(this).closest('tr').remove(); });

            // Fetch Logic
            $('#btnFetchDetails').click(function() {
                var mvcNo = $('#paramsMvcNo').val();
                var year = $('#paramsMvcYear').val();
                var mact = $('#paramsMactId').val();

                if(!mvcNo || !year || !mact) { $('#searchError').text('Please enter all fields.').show(); return; }
                $('#searchError').hide();

                $.ajax({
                    url: '/Case/GetCaseJson',
                    type: 'GET',
                    data: { mvcNo: mvcNo, mvcYear: year, mactId: mact },
                    success: function(response) {
                        if(response.success) {
                            var data = response.data;
                            
                            // Reset dynamic indices
                            petIndex = 0; caseIndex = 0; counter = { 'pwList': 0, 'docList': 0, 'rwList': 0 };
                            $('#petitionersTable tbody').empty();
                            $('#connectedCasesTable tbody').empty();
                            $('#pwList').empty(); $('#docList').empty(); $('#rwList').empty();

                            // Set IDs
                            $('#CaseID').val(0); // Set to 0 because we are creating a new entry in the Remand Back table
                            $('#OriginalCaseID').val(data.caseID);

                            // Section A
                            $('#MVCNo').val(data.mvcNo);
                            $('#MVCYear').val(data.mvcYear);
                            $('#MACTID').val(data.mactid);
                            $(`input[name="VehicleType"][value="${data.vehicleType}"]`).prop('checked', true);
                            $('#vehicleNoInput').val(data.vehicleNo);
                            if(data.accidentDate) $('#AccidentDate').val(data.accidentDate.split('T')[0]);
                            $('#CaseType').val(data.caseType || "Pending");

                            // eCourts CNR & Establishment
                            if (data.cnrNumber) {
                                $('#mvc-cnr-number').val(data.cnrNumber);
                                fetchAndRenderLiveCnrDetails(data.cnrNumber);
                            }
                            if (data.estCode) {
                                $('#mvc-ecourts-est').val(data.estCode);
                            }
                            if (data.caseTypeCode) {
                                $('#mvc-ecourts-type').val(data.caseTypeCode);
                            }

                            // Section B
                            if(data.petitioners && data.petitioners.length > 0) data.petitioners.forEach(p => addPetitionerRow(p.petitionerName, p.relationship));
                            else addPetitionerRow();

                            // Section C & D
                            $('#ClaimType').val(data.claimType);
                            $('#ThirdPartyFlag').prop('checked', data.thirdPartyFlag);
                            $('#ClaimAmount').val(data.claimAmount);
                            $('#EntrustmentNo').val(data.entrustmentNo);
                            if(data.entrustmentDate) $('#EntrustmentDate').val(data.entrustmentDate.split('T')[0]);
                            
                            if(data.advocateName) {
                                let found = false;
                                $("#AdvocateSelect option").each(function(){
                                    if($(this).val() === data.advocateName) { $("#AdvocateSelect").val(data.advocateName).trigger('change'); found = true; }
                                });
                                if(!found) { $("#AdvocateSelect").val("Others").trigger('change'); $("#AdvocateManualEntry").val(data.advocateName); $("#AdvocateNameHidden").val(data.advocateName); }
                            }

                            // Section E
                            if(data.connectedCases && data.connectedCases.length > 0) data.connectedCases.forEach(c => addConnectedRow(c.connectedMVCNo, c.connectedYear, c.mact, c.isDoubleClaim));

                            // Section F
                            $(`input[name="IsDocumentSent"][value="${data.isDocumentSent}"]`).prop('checked', true).trigger('change');
                            $('#DocumentOutwardNo').val(data.documentOutwardNo);
                            if(data.documentOutwardDate) $('#DocumentOutwardDate').val(data.documentOutwardDate.split('T')[0]);
                            
                            $(`input[name="IsObjectionFiled"][value="${data.isObjectionFiled}"]`).prop('checked', true).trigger('change');
                            $('#ObjectionOutwardNo').val(data.objectionOutwardNo);
                            if(data.objectionFiledDate) $('#ObjectionFiledDate').val(data.objectionFiledDate.split('T')[0]);
                            
                            $('#CurrentStage').val(data.currentStage);
                            if(data.nextHearingDate) $('#NextHearingDate').val(data.nextHearingDate.split('T')[0]);

                            // Section G
                            $('#DisposalStatus').val(data.disposalStatus);
                            $('#disposalResultSelect').val(data.disposalResult).trigger('change');
                            $('#DisposalRemarks').val(data.disposalRemarks);
                            if(data.closureDate) $('#ClosureDate').val(data.closureDate.split('T')[0]);

                            // Expand Accordion if Disposal Result is set
                            if(data.disposalResult) $('#secG').collapse('show');

                            // Adverse Award
                            if(data.adverseAward) {
                                let aa = data.adverseAward;
                                $(`input[name="AdverseAward.IsBusInsured"][value="${aa.isBusInsured}"]`).prop('checked', true).trigger('change');
                                $('#AdverseAward_BusInsuranceDetails').val(aa.busInsuranceDetails);
                                if(aa.claimPetitionDate) $('#AdverseAward_ClaimPetitionDate').val(aa.claimPetitionDate.split('T')[0]);
                                if(aa.awardDate) $('#AdverseAward_AwardDate').val(aa.awardDate.split('T')[0]);
                                $('#AdverseAward_MannerOfAccident').val(aa.mannerOfAccident);
                                
                                $(`input[name="AdverseAward.IsImpleadingAppFiled"][value="${aa.isImpleadingAppFiled}"]`).prop('checked', true).trigger('change');
                                $('#AdverseAward_ImpleadingAppNotFiledReason').val(aa.impleadingAppNotFiledReason);
                                
                                $(`input[name="AdverseAward.ObjectionFiled"][value="${aa.objectionFiled}"]`).prop('checked', true).trigger('change');
                                $('#AdverseAward_ObjectionRemarks').val(aa.objectionRemarks);

                                // PWs
                                if(aa.petitionerPWNames) aa.petitionerPWNames.forEach(v => addDynamicInput('pwList', 'AdverseAward.PetitionerPWNames', v));
                                if(aa.doctors) aa.doctors.forEach(d => addDoctorInput(d.doctorName, d.isTreated));
                                
                                $('#rwTypeSelect').val(aa.rwType).trigger('change');
                                if(aa.rwNames) aa.rwNames.forEach((v, i) => addRWInput(v, aa.rwDesignations ? aa.rwDesignations[i] : ''));

                                $('#AdverseAward_TR18Remarks').val(aa.tr18Remarks);
                                $(`input[name="AdverseAward.IsAllegedAccident"][value="${aa.isAllegedAccident}"]`).prop('checked', true);

                                $(`input[name="AdverseAward.DoubleClaimFlag"][value="${aa.doubleClaimFlag}"]`).prop('checked', true).trigger('change');
                                $('#AdverseAward_DoubleClaimDetails').val(aa.doubleClaimDetails);
                                $(`input[name="AdverseAward.SecurityRequired"][value="${aa.securityRequired}"]`).prop('checked', true);

                                // Dates
                                if(aa.disposedOnDate) $('#AdverseAward_DisposedOnDate').val(aa.disposedOnDate.split('T')[0]);
                                if(aa.copyAppliedDate) $('#AdverseAward_CopyAppliedDate').val(aa.copyAppliedDate.split('T')[0]);
                                if(aa.copyIssuedDate) $('#AdverseAward_CopyIssuedDate').val(aa.copyIssuedDate.split('T')[0]);
                                if(aa.copyReceivedDate) $('#AdverseAward_CopyReceivedDate').val(aa.copyReceivedDate.split('T')[0]);
                                $('#AdverseAward_CertifiedCopyRemarks').val(aa.certifiedCopyRemarks);

                                // Financials
                                $('#AwardAmount').val(aa.awardAmount);
                                $('#LiabilityPercentage').val(aa.liabilityPercentage).trigger('change');
                                $('#AdverseAward_InterestRate').val(aa.interestRate);
                                $('#AdverseAward_VictimAge').val(aa.victimAge);
                                $('#AdverseAward_Occupation').val(aa.occupation);
                                $('#AdverseAward_IncomeConsidered').val(aa.incomeConsidered);
                                $('#AdverseAward_FutureProspectus').val(aa.futureProspectus);
                                $('#injuryTypeSelect').val(aa.injuryType || "Death");
                                $('#AdverseAward_InjuryDetails').val(aa.injuryDetails);

                                // Punishments
                                $('#punishmentStatusSelect').val(aa.driverPunishmentStatus || "Pending").trigger('change');
                                $('#AdverseAward_PunishmentRemarks').val(aa.punishmentRemarks);
                                $('#AdverseAward_InterimCompAmount').val(aa.interimCompAmount);
                                $(`input[name="AdverseAward.InterimCompDeducted"][value="${aa.interimCompDeducted}"]`).prop('checked', true);

                                // Opinions
                                $('#AdverseAward_AdvocateOpinion').val(aa.advocateOpinion);
                                $('#AdverseAward_LOOpinion').val(aa.loOpinion);
                                $('#AdverseAward_DCOpinion').val(aa.dcOpinion);

                                // Closure
                                $('#forwardStatusSelect').val(aa.forwardingStatus || "Pending").trigger('change');
                                $('#AdverseAward_OutwardNumber').val(aa.outwardNumber);
                                $('#AdverseAward_ClosureRemarks').val(aa.closureRemarks);
                                if(aa.closureDate) $('#AdverseAward_ClosureDate').val(aa.closureDate.split('T')[0]);
                            }

                            $('#entryFormContainer').slideDown();
                            window.scrollTo({ top: $('#entryFormContainer').offset().top - 20, behavior: 'smooth' });
                        } else {
                            $('#searchError').text(response.message).show();
                            $('#entryFormContainer').hide();
                        }
                    },
                    error: function() { $('#searchError').text('Error fetching data.').show(); }
                });
            });

            $('#caseEntryForm').submit(function (e) {
                e.preventDefault();
                const form = $(this);
                const formData = new FormData(this);

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while saving.');
                    }
                });
            });
        });
    </script>
}
