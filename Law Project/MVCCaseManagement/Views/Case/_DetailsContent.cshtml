                                            <div class="fw-semibold">@tr18.HospitalName</div>
                                        </div>
                                        <div class="col-md-6">
                                             <label class="small text-muted fw-bold">Relief Details</label>
                                            <div class="fw-semibold">@tr18.ReliefDetails</div>
                                        </div>
