@model MVCCaseManagement.Models.MVCCaseViewModel
@using System.Security.Claims

@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var detailsDivIdString = User.FindFirst("DivisionID")?.Value;
    bool detailsIsCentralOffice = detailsDivIdString == "0" || string.IsNullOrEmpty(detailsDivIdString) || detailsDivIdString == "5";
    
    bool canUpdate = !detailsIsCentralOffice;
    if (!detailsIsCentralOffice && Model.ForwardingStatus == "Sent to Central Office")
    {
        canUpdate = false;
    }

    // APPEAL LOGIC
    bool isAuthorizedForAppeal = (role == "Admin" || detailsIsCentralOffice || role == "CLO" || role == "LO" || role == "Dy CLO" || role == "DyCLO" || role == "MD" || User.IsInRole("LO") || User.IsInRole("MD") || User.IsInRole("Dy CLO") || User.IsInRole("DyCLO"));
    bool hideActionBtn = ViewData["HideActionBtn"] as bool? ?? false;
    
    // Hide Action button if case is already "Closed" with approval details
    if (Model.LinkedAppeal != null && Model.LinkedAppeal.InitialAction == "Close" && 
        !string.IsNullOrEmpty(Model.LinkedAppeal.ApprovalOutwardNo) && 
        Model.LinkedAppeal.ApprovalDate.HasValue)
    {
        hideActionBtn = true;
    }

    string effectiveDisposalResult = !string.IsNullOrEmpty(Model.DisposalResult) 
        ? Model.DisposalResult 
        : (!string.IsNullOrEmpty(Model.LinkedAppeal?.ClaimantMVCCurrentStatus) 
            ? Model.LinkedAppeal.ClaimantMVCCurrentStatus 
            : (Model.DisposalStatus ?? ""));

    bool showActionBtn = !hideActionBtn && isAuthorizedForAppeal && 
        (Model.LinkedAppeal != null || Model.AdverseAward?.AwardAmount > 0 || string.Equals(Model.CurrentStage, "DISPOSED", StringComparison.OrdinalIgnoreCase) || string.Equals(Model.DisposalStatus, "Disposed", StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrEmpty(effectiveDisposalResult) && !string.Equals(effectiveDisposalResult, "Pending", StringComparison.OrdinalIgnoreCase)));
}

<div class="case-details-content">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom d-print-none">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="fw-bold text-primary mb-0"><i class="bi bi-file-earmark-text me-2"></i>@Model.MVCNo / @Model.MVCYear</h2>
                @if (Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true)
                {
                    <span class="badge bg-warning text-dark px-3 py-1 fs-6 shadow-sm border border-warning d-inline-flex align-items-center gap-1" title="Special Defense: Alleged Accident - Claim petition filed without any actual accident involving Corporation bus">
                        <i class="bi bi-shield-exclamation text-dark"></i> Alleged Accident (No Accident Occurred)
                    </span>
                }
                @if (!string.IsNullOrEmpty(effectiveDisposalResult))
                {
                    <span class="badge @(string.Equals(effectiveDisposalResult, "Against", StringComparison.OrdinalIgnoreCase) ? "bg-danger" : "bg-success") px-2 py-1 fs-6">
                        @effectiveDisposalResult
                    </span>
                }
                @if (Model.ThirdPartyFlag)
                {
                    <span class="badge bg-info text-white px-2 py-1 fs-6">
                        <i class="bi bi-person-badge me-1"></i>Third Party Case
                    </span>
                }
                @if (ViewBag.IsRemindBack == true || Model.CaseType == "RemindBack" || Model.OriginalCaseID.HasValue || Model.RemindBackID > 0)
                {
                    <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Remand Back Case
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.CNRNumber))
                {
                    <span class="badge bg-light text-dark border font-monospace fs-6 px-2 py-1">
                        <i class="bi bi-broadcast text-primary me-1"></i>@Model.CNRNumber
                    </span>
                }
            </div>
            <div class="small text-muted mt-1">
                Division: <strong class="text-dark">@Model.DivisionName</strong>
                @if (Model.AccidentDate.HasValue)
                {
                    <span>&nbsp;|&nbsp; Accident Date: <strong class="text-dark">@Model.AccidentDate.Value.ToString("dd-MM-yyyy")</strong></span>
                }
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center d-print-none">
            @if(canUpdate)
            {
                <a asp-controller="Case" asp-action="Edit" asp-route-id="@Model.CaseID" class="btn btn-primary shadow-sm px-3 rounded-pill fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i> Update
                </a>
            }
            @if(showActionBtn)
            {
                if (User.IsInRole("LO"))
                {
                    <a asp-controller="Appeal" asp-action="LOAction" asp-route-id="@Model.CaseID" class="btn btn-warning shadow-sm px-3 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> Action
                    </a>
                }
                else if (User.IsInRole("Dy CLO") || User.IsInRole("DyCLO"))
                {
                    <a asp-controller="Appeal" asp-action="DyCLOAction" asp-route-id="@Model.CaseID" class="btn btn-warning shadow-sm px-3 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> Action
                    </a>
                }
                else if (User.IsInRole("CLO"))
                {
                    var statusClean = (Model.LinkedAppeal?.InitialAction ?? "").Trim().ToUpper();
                    if (statusClean != "PENDING BEFORE COMPETENT AUTHORITY" && statusClean != "PENDING AT CA")
                    {
                        <a asp-controller="Appeal" asp-action="CLOAction" asp-route-id="@Model.CaseID" class="btn btn-warning shadow-sm px-3 rounded-pill fw-semibold">
                            <i class="bi bi-shield-check me-1"></i> Action
                        </a>
                    }
                }
                else if (User.IsInRole("MD"))
                {
                    <a asp-controller="Appeal" asp-action="MDAction" asp-route-id="@Model.CaseID" class="btn btn-warning shadow-sm px-3 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> Action
                    </a>
                }
                else
                {
                    <a asp-controller="Appeal" asp-action="Manage" asp-route-id="@Model.CaseID" class="btn btn-warning shadow-sm px-3 rounded-pill fw-semibold">
                        <i class="bi bi-hammer me-1"></i> Action
                    </a>
                }
            }
            @if(isAuthorizedForAppeal && Model.LinkedAppeal != null && (!string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantMFANumber) || !string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantMFAEntrustmentNo) || !string.IsNullOrEmpty(Model.LinkedAppeal.ClaimantMVCNumber)))
            {
                <a asp-controller="Appeal" asp-action="ManageClaimant" asp-route-id="@Model.CaseID" class="btn btn-outline-danger shadow-sm px-3 rounded-pill fw-semibold">
                    <i class="bi bi-person-lines-fill me-1"></i> Update Claimant Appeal
                </a>
            }
            <button type="button" class="btn btn-outline-primary shadow-sm px-3 rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#fullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-general-nav')).show(); }, 150);">
                <i class="bi bi-info-circle me-1"></i> View More Details
            </button>
            @if (canUpdate)
            {
                <button type="button" class="btn btn-outline-warning shadow-sm px-3 rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#transferCaseModal" id="btnOpenTransfer">
                    <i class="bi bi-arrow-left-right me-1"></i> Transfer Case
                </button>
            }
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm px-3 rounded-pill fw-semibold">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- TRANSFER NOTIFICATIONS -->
    @if (TempData["TransferSuccess"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-3 border-0 shadow-sm rounded-3 px-4 py-3 mb-4 d-print-none" id="transferSuccessAlert" role="alert" style="background:linear-gradient(135deg,#dcfce7,#bbf7d0);border-left:4px solid #16a34a !important;">
            <div class="flex-shrink-0 bg-success rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                <i class="bi bi-check-circle-fill text-white fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold text-success-emphasis">Transfer Successful</div>
                <div class="small text-success-emphasis">@TempData["TransferSuccess"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["TransferError"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-3 border-0 shadow-sm rounded-3 px-4 py-3 mb-4 d-print-none" id="transferErrorAlert" role="alert" style="background:linear-gradient(135deg,#fee2e2,#fecaca);border-left:4px solid #dc2626 !important;">
            <div class="flex-shrink-0 bg-danger rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                <i class="bi bi-exclamation-circle-fill text-white fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold text-danger-emphasis">Transfer Failed</div>
                <div class="small text-danger-emphasis">@TempData["TransferError"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ALLEGED ACCIDENT SPECIAL DEFENSE BANNER -->
    @if (Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true)
    {
        <div class="alert alert-warning border-start border-4 border-warning shadow-sm mb-4 rounded-3 d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between p-3 gap-3 d-print-none" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);">
            <div class="d-flex align-items-start align-items-md-center">
                <div class="bg-warning text-dark rounded-circle p-2 me-3 d-flex align-items-center justify-content-center shadow-xs flex-shrink-0" style="width: 44px; height: 44px;">
                    <i class="bi bi-shield-exclamation fs-4"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h6 class="mb-0 fw-bold text-dark text-uppercase">Special Defense: Alleged Accident Case</h6>
                        <span class="badge bg-dark text-warning" style="font-size: 0.68rem; letter-spacing: 0.04em;">NO ACCIDENT INVOLVEMENT</span>
                    </div>
                    <p class="mb-0 text-dark opacity-75 small mt-1">
                        This claim petition was filed without any actual accident having occurred with Corporation vehicle <strong>@(string.IsNullOrEmpty(Model.VehicleNo) ? "ST Vehicle" : Model.VehicleNo)</strong>.
                        The primary legal defense is non-involvement of the bus.
                        @if (Model.AdverseAward?.SecurityRequired == true)
                        {
                            <span class="fw-semibold text-dark"><i class="bi bi-shield-check text-primary ms-1"></i> Security investigation was conducted.</span>
                        }
                    </p>
                </div>
            </div>
            @if (Model.AdverseAward?.SecurityRequired == true && !string.IsNullOrEmpty(Model.AdverseAward?.SecurityUploadPath))
            {
                <a href="@Model.AdverseAward.SecurityUploadPath" target="_blank" class="btn btn-sm btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm flex-shrink-0 border border-dark border-opacity-25">
                    <i class="bi bi-file-earmark-pdf me-1"></i> View Investigation Report
                </a>
            }
        </div>
    }

    <!-- TR-18 EXTERNAL DATA SECTION -->
    @if (ViewBag.TR18Data != null)
{
    var tr18 = (MVCCaseManagement.Models.AccidentDetails)ViewBag.TR18Data;
    
    <!-- TR-18 Status Banner -->
    <div class="alert alert-soft-primary border-primary border-opacity-25 d-flex align-items-center justify-content-between p-3 mb-4 rounded-3 shadow-sm">
        <div class="d-flex align-items-center">
            <div class="bg-primary text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-shield-check fs-5"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-bold text-primary">NWKRTC FIR DETAILS</h6>
                <div class="small text-muted">Accident data synced from NWKRTC Accident Mgmt System</div>
            </div>
        </div>
        <button type="button" class="btn btn-primary btn-sm px-4 rounded-pill fw-semibold shadow-sm transition-all" data-bs-toggle="modal" data-bs-target="#tr18DetailsModal">
            <i class="bi bi-eye me-2"></i>View Full Report
        </button>
    </div>

    <!-- TR-18 Details Modal -->
    <div class="modal fade" id="tr18DetailsModal" tabindex="-1" aria-labelledby="tr18ModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-lock-fill fs-4 me-3"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0" id="tr18ModalLabel">Accident Report Details (TR-18)</h5>
                            <div class="small opacity-75">ID: @tr18.AccidentId | Date: @tr18.AccidentDateTime</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light p-0">
                    <div class="d-flex h-100">
                        <!-- Sidebar Navigation for Modal -->
                        <div class="nav flex-column nav-pills p-3 bg-white border-end" id="v-pills-tab" role="tablist" aria-orientation="vertical" style="width: 220px; min-width: 200px;">
                            <button class="nav-link active text-start mb-2 rounded-3" id="v-pills-general-tab" data-bs-toggle="pill" data-bs-target="#v-pills-general" type="button" role="tab" aria-selected="true"><i class="bi bi-info-circle me-2"></i>General Info</button>
                            <button class="nav-link text-start mb-2 rounded-3" id="v-pills-driver-tab" data-bs-toggle="pill" data-bs-target="#v-pills-driver" type="button" role="tab" aria-selected="false"><i class="bi bi-person-badge me-2"></i>Crew Details</button>
                            <button class="nav-link text-start mb-2 rounded-3" id="v-pills-vehicle-tab" data-bs-toggle="pill" data-bs-target="#v-pills-vehicle" type="button" role="tab" aria-selected="false"><i class="bi bi-bus-front me-2"></i>Vehicle & Route</button>
                            <button class="nav-link text-start mb-2 rounded-3" id="v-pills-casualties-tab" data-bs-toggle="pill" data-bs-target="#v-pills-casualties" type="button" role="tab" aria-selected="false"><i class="bi bi-heart-pulse me-2"></i>Casualties</button>
                            <button class="nav-link text-start mb-2 rounded-3" id="v-pills-media-tab" data-bs-toggle="pill" data-bs-target="#v-pills-media" type="button" role="tab" aria-selected="false"><i class="bi bi-collection-play me-2"></i>Media Evidence</button>
 
                        </div>
                        
                        <!-- Content Area -->
                        <div class="tab-content w-100 p-4" id="v-pills-tabContent">
                            
                            <!-- Tab 1: General Info -->
                            <div class="tab-pane fade show active" id="v-pills-general" role="tabpanel">
                                <h6 class="text-uppercase text-muted fw-bold small mb-3 border-bottom pb-2">Use Case Overview</h6>
                                <div class="row g-4 mb-4">
                                    <div class="col-md-4">
                                        <div class="card h-100 card-body border-0 shadow-sm bg-white rounded-3">
                                            <label class="small text-muted text-uppercase fw-bold">Report Type</label>
                                            <div class="fs-6 fw-bold text-dark">@tr18.ReportType</div>
                                            <div class="small text-muted">Nature: @tr18.NatureOfAccident</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card h-100 card-body border-0 shadow-sm bg-white rounded-3">
                                            <label class="small text-muted text-uppercase fw-bold">Location</label>
                                            <div class="fs-6 fw-bold text-dark">@tr18.Location</div>
                                            <div class="small text-muted">Type: @tr18.RoadType</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card h-100 card-body border-0 shadow-sm bg-white rounded-3">
                                            <label class="small text-muted text-uppercase fw-bold">Dates</label>
                                            <div class="small">Accident: <b>@tr18.AccidentDateTime</b></div>
                                            <div class="small">Reported: <b>@tr18.InfoDateTime</b></div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="card card-body border-0 shadow-sm bg-white rounded-3">
                                            <label class="small text-muted text-uppercase fw-bold mb-1">Brief Details</label>
                                            <p class="mb-0">@tr18.BriefDetails</p>
                                        </div>
                                    </div>
                                    
                                     <div class="col-md-6">
                                        <div class="card h-100 card-body border-0 shadow-sm bg-white rounded-3">
                                            <label class="small text-muted text-uppercase fw-bold">Inspecting Officer</label>
                                            <div class="fw-bold">@tr18.InspectingOfficer</div>
                                            <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@tr18.InspectingOfficerPhone</div>
                                             <div class="small text-muted mt-1">Person Mentioned: @tr18.PersonMentioned</div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="card h-100 card-body border-0 shadow-sm bg-white rounded-3">
                                            <label class="small text-muted text-uppercase fw-bold">Police Station</label>
