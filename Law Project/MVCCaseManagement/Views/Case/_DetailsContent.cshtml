        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .file-link-primary {
        color: #2563eb;
        background: #eff6ff;
        border-color: #bfdbfe;
    }

    .file-link-danger {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }

    .file-link-warning {
        color: #d97706;
        background: #fffbeb;
        border-color: #fde68a;
    }

    .file-link-success {
        color: #16a34a;
        background: #f0fdf4;
        border-color: #bbf7d0;
    }

    .file-link-info {
        color: #0891b2;
        background: #ecfeff;
        border-color: #a5f3fc;
    }

    /* Detail Table */
    .detail-table {
        font-size: 0.875rem;
    }

    .detail-table thead {
        background-color: #f8fafc;
    }

    .detail-table thead th {
        color: #64748b;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.75rem 1rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .detail-table tbody td {
        padding: 0.75rem 1rem;
        color: #475569;
        border-bottom: 1px solid #f1f5f9;
    }

    .detail-table tbody tr:last-child td {
        border-bottom: none;
    }

    .detail-table tbody tr:hover {
        background-color: #f8fafc;
    }

    /* Alert Overrides for Modal */
    #fullDetailsModal .alert {
        border-radius: 6px;
        font-size: 0.85rem;
    }

    #fullDetailsModal .alert-heading {
        font-size: 0.9rem;
    }

    /* Full Details Modal Tabs Styling */
    #fullDetailsTabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        background: #ffffff !important;
        padding: 0.5rem !important;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }
    #fullDetailsTabs .nav-item {
        flex: 1 1 auto;
    }
    #fullDetailsTabs .nav-link {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700 !important;
        font-size: 0.86rem !important;
