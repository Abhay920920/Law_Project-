                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Decision Date</small>
                    <div class="fw-semibold text-dark" id="live-decision-date">@(Model.ClosureDate.HasValue ? Model.ClosureDate.Value.ToString("dd-MM-yyyy") : "—")</div>
                </div>
                <div class="col-12 col-md-6">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Court Number &amp; Judge</small>
                    <div class="fw-semibold text-dark" id="live-court-judge" style="word-break: break-word;">
                        @{
                            var courtJudgeParts = new[] { Model.ECourtsCourtNo, Model.ECourtsJudge }.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
                            var courtJudgeDisplay = courtJudgeParts.Any() ? string.Join(" — ", courtJudgeParts) : (!string.IsNullOrWhiteSpace(Model.CourtHall) ? Model.CourtHall : (!string.IsNullOrWhiteSpace(Model.MACTName) ? Model.MACTName : "—"));
                        }
                        @courtJudgeDisplay
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.CNRNumber))
                {
                    <div class="col-12 col-md-6">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner</small>
                        <div class="fw-semibold text-dark" id="live-petitioner" style="word-break: break-word;" title="@(Model.Petitioners?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.PetitionerName))?.PetitionerName ?? "")">
                            @(Model.Petitioners?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.PetitionerName))?.PetitionerName ?? "Petitioner / Claimant")
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner Advocate</small>
                        <div class="fw-semibold text-dark" id="live-pet-adv" style="word-break: break-word;">@(!string.IsNullOrWhiteSpace(Model.AdvocateName) ? Model.AdvocateName : "—")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Respondent</small>
                        <div class="fw-semibold text-dark" id="live-respondent" style="word-break: break-word;">@(Model.Respondents?.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.RespondentName))?.RespondentName ?? (!string.IsNullOrEmpty(Model.DivisionName) ? Model.DivisionName : "NWKRTC"))</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Insurance / Extra Parties</small>
                        <div class="fw-semibold text-dark" id="live-extra-party" style="word-break: break-word;">—</div>
                    </div>

                    <div class="col-12 d-none" id="live-transfer-block">
                        <div class="alert alert-warning alert-sm py-2 px-3 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left-right text-warning fs-5"></i>
                            <div>
                                <div class="fw-bold small">Case Transferred from Establishment</div>
                                <div class="small" id="live-transfer-est">—</div>
                                <div class="small text-muted">Transfer Date: <span id="live-transfer-date">—</span>
                                &nbsp;|&nbsp; CNR: <span class="font-monospace" id="live-transfer-cino">—</span></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12 col-md-6">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner / Claimant</small>
                        <div class="fw-semibold text-dark" style="word-break: break-word;">
                            @(Model.Petitioners?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.PetitionerName))?.PetitionerName ?? "Petitioner / Claimant")
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Respondent / Division</small>
                        <div class="fw-semibold text-dark" style="word-break: break-word;">@(!string.IsNullOrEmpty(Model.DivisionName) ? Model.DivisionName : "KSRTC / BMTC")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">CNR Status</small>
                        <div><span class="badge bg-warning text-dark"><i class="bi bi-link-45deg me-1"></i>Unlinked</span></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Vehicle &amp; Accident Details</small>
                        <div class="fw-semibold text-secondary small">
                            Vehicle: @(!string.IsNullOrEmpty(Model.VehicleNo) ? Model.VehicleNo : "—")
                            @(Model.AccidentDate.HasValue ? (" | Date: " + Model.AccidentDate.Value.ToString("dd-MM-yyyy")) : "")
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CNRNumber))
                {
                    <div class="col-12 border-top mt-2 pt-3">
                        <ul class="nav nav-pills mb-3 gap-2" id="ecourtsTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active btn-sm py-1 px-3 fw-bold" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-pane" type="button" role="tab">
                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Court Orders &amp; Judgments 
                                    <span class="badge bg-light text-danger ms-1" id="orders-count-badge">0 Files Available</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm py-1 px-3 fw-bold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab">
                                    <i class="bi bi-clock-history me-1"></i> Case Hearing History 
                                    <span class="badge bg-light text-dark ms-1" id="history-count-badge">0 Hearings</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm py-1 px-3 fw-bold" id="ia-tab" data-bs-toggle="tab" data-bs-target="#ia-pane" type="button" role="tab">
                                    <i class="bi bi-file-earmark-text me-1"></i> IA Applications 
                                    <span class="badge bg-light text-primary ms-1" id="ia-count-badge">0 IAs</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm py-1 px-3 fw-bold" id="process-tab" data-bs-toggle="tab" data-bs-target="#process-pane" type="button" role="tab">
                                    <i class="bi bi-envelope-paper me-1"></i> Processes &amp; Notices 
                                    <span class="badge bg-light text-secondary ms-1" id="process-count-badge">0 Notices</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link btn-sm py-1 px-3 fw-bold" id="fulldata-tab" data-bs-toggle="tab" data-bs-target="#fulldata-pane" type="button" role="tab">
                                    <i class="bi bi-card-text me-1"></i> Full Case Details
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content" id="ecourtsTabContent">
                            <!-- Orders & Judgments Pane -->
                            <div class="tab-pane fade show active" id="orders-pane" role="tabpanel">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Official Court Orders &amp; Judgments verified by eCourts Gateway</small>
                                    @if (!string.IsNullOrEmpty(Model.CNRNumber))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill shadow-sm fw-semibold" id="btnRefreshOrdersTab" onclick="refreshCaseOrdersLive('@Model.CNRNumber', @Model.CaseID, this)" title="Refresh court orders, judgments & real-time documents">
                                                <i class="bi bi-arrow-clockwise me-1" id="iconRefreshOrdersTab"></i> Refresh Orders &amp; Judgments
                                            </button>
                                            <a href="/ECourts/DownloadAllOrdersZip?cnr=@Model.CNRNumber" class="btn btn-sm btn-outline-danger rounded-pill shadow-sm fw-semibold" title="Download all orders in a single ZIP">
                                                <i class="bi bi-file-earmark-zip-fill me-1"></i> Download All Orders (ZIP)
                                            </a>
                                        </div>
                                    }
                                </div>
                                <div id="live-orders-container">
                                    <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                        <i class="bi bi-file-earmark-pdf text-primary fs-5 d-block mb-1"></i>
                                        Click <strong>Refresh Orders &amp; Judgments</strong> to load verified court order copies.
                                    </div>
                                </div>
                            </div>
                            <!-- Hearing History Pane -->
                            <div class="tab-pane fade" id="history-pane" role="tabpanel">
                                <div id="live-history-container">
                                    <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                        <i class="bi bi-clock-history text-secondary fs-5 d-block mb-1"></i>
                                        Click <strong>Fetch Live Status</strong> to view the complete case hearing history.
                                    </div>
                                </div>
                            </div>
                            <!-- IA Applications Pane -->
                            <div class="tab-pane fade" id="ia-pane" role="tabpanel">
                                <div id="live-ia-container">
                                    <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                        <i class="bi bi-file-earmark-text text-secondary fs-5 d-block mb-1"></i>
                                        Click <strong>Fetch Live Status</strong> to view interim applications.
                                    </div>
                                </div>
                            </div>
                            <!-- Processes Pane -->
                            <div class="tab-pane fade" id="process-pane" role="tabpanel">
                                <div id="live-process-container">
                                    <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                        <i class="bi bi-envelope-paper text-secondary fs-5 d-block mb-1"></i>
                                        Click <strong>Fetch Live Status</strong> to view process notices.
                                    </div>
                                </div>
                            </div>
                            <!-- Full Case Details Pane -->
                            <div class="tab-pane fade" id="fulldata-pane" role="tabpanel">
                                <div id="live-fulldata-container">
                                    <div class="text-muted small py-4 text-center rounded border bg-white shadow-xs">
                                        <i class="bi bi-card-text text-secondary fs-5 d-block mb-1"></i>
                                        Click <strong>Fetch Live Status</strong> to view complete eCourts payload.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12 border-top mt-2 pt-3">
                        <div class="card border-primary border-opacity-25 bg-white shadow-sm rounded-3 p-4 text-center">
                            <div class="mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fs-6">
                                    <i class="bi bi-cloud-arrow-down-fill me-2"></i>Live e-Courts NAPIX Integration
                                </span>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Connect This Case to Live e-Courts Gateway</h5>
                            <p class="text-muted small mb-3 mx-auto" style="max-width: 620px;">
                                The 16-character CNR Number is not linked yet. Click below to automatically discover the CNR from e-Courts using Case Number <strong>MVC @Model.MVCNo / @Model.MVCYear</strong>, Police FIR, and Party names.
                            </p>
                            <div class="d-flex flex-column align-items-center gap-2">
                                <div class="d-flex gap-2">
                                    <button type="button" id="btn-autolink-cnr" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="autoLinkCnrInline(@Model.CaseID, 'MVC')">
                                        <i class="bi bi-search me-2"></i>Auto-Discover &amp; Link CNR
                                    </button>
                                    <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="openUpdateCnrModal()">
                                        <i class="bi bi-pencil-square me-2"></i>Enter CNR Manually
                                    </button>
                                </div>
                                <div id="autolink-status-msg" class="mt-1"></div>
                            </div>
                        </div>
                    </div>
                }
                <div class="col-12 border-top pt-2 d-flex justify-content-between align-items-center">
                    <div class="small text-muted" id="live-sync-msg">
                        @if (Model.LastNapixSyncAt.HasValue)
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Synced: @Model.LastNapixSyncAt.Value.ToString("dd MMM yyyy, hh:mm tt") (@(Model.LastNapixSyncStatus ?? "Success"))</span>
                        }
                        else
                        {
                            <span><i class="bi bi-arrow-repeat me-1"></i> Auto-synced with eCourts Gateway</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(Model.CNRNumber))
                        {
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill" onclick="triggerFetchCaseLiveStatus()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Live Status
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-info text-white rounded-pill shadow-sm" onclick="autoLinkCnrInline(@Model.CaseID, 'MVC')">
                                <i class="bi bi-link-45deg me-1"></i> Auto-Discover &amp; Link CNR
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill shadow-sm" onclick="openUpdateCnrModal()">
                                <i class="bi bi-pencil-square me-1"></i> Enter CNR
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




    <!-- 2. CENTRAL OFFICE TRACKING & APPEAL DETAILS (FULL WIDTH) -->
    @if (Model.LinkedAppeal != null || (Model.AdverseAward != null && Model.AdverseAward.IsEPFiled))
    {
        <div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-building me-2 fs-5"></i>
                    <h6 class="mb-0 fw-bold">Central Office Tracking &amp; Appeal Details</h6>
                </div>
                <span class="badge bg-primary px-3 py-1 font-monospace">Case ID: @Model.CaseID</span>
            </div>
            <div class="card-body p-3 p-md-4">
                @if (Model.LinkedAppeal != null)
                {
                    var appeal = Model.LinkedAppeal;

                    <!-- 2.1. Initial Action & Feasibility -->
                    @if (appeal.FeasibilityReceived || !string.IsNullOrEmpty(appeal.InitialAction) || !string.IsNullOrEmpty(appeal.ApprovalOutwardNo))
                    {
                        <div class="mb-4">
                            <h6 class="text-primary border-bottom pb-2 fw-bold small text-uppercase"><i class="bi bi-flag me-2"></i>Initial Action &amp; Feasibility</h6>
                            <div class="row g-3 small">
                                @if (appeal.FeasibilityReceived)
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Feasibility Received</span>
                                        <strong>Yes @(appeal.FeasibilityReceiptDate.HasValue ? "(" + appeal.FeasibilityReceiptDate.Value.ToString("dd-MM-yyyy") + ")" : "")</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.InitialAction) && appeal.InitialAction != "Select...")
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Initial Action</span>
                                        <strong class="text-primary">@appeal.InitialAction</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.ApprovalOutwardNo))
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Approval Outward No</span>
                                        <strong>@appeal.ApprovalOutwardNo</strong>
                                    </div>
                                }
                                @if (appeal.ApprovalDate.HasValue)
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Approval Date</span>
                                        <strong>@appeal.ApprovalDate?.ToString("dd-MM-yyyy")</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.InitialActionRemarks))
                                {
                                    <div class="col-12 mt-2">
                                        <div class="p-2 bg-light border-start border-3 border-primary rounded">
                                            <span class="text-muted d-block extra-small">Initial Action Remarks</span>
                                            <p class="mb-0 italic">@appeal.InitialActionRemarks</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 2.2. Corporation MFA High Court Details -->
                    @if (!string.IsNullOrEmpty(appeal.CorpMFANumber) || !string.IsNullOrEmpty(appeal.CorpMFAAdvocate) || !string.IsNullOrEmpty(appeal.CorpMFACNRNumber))
                    {
                        <div class="mb-4">
                            <h6 class="text-primary border-bottom pb-2 fw-bold small text-uppercase"><i class="bi bi-hammer me-2"></i>High Court Appeal (Corporation MFA Details)</h6>
                            <div class="row g-3 small">
                                @if (!string.IsNullOrEmpty(appeal.CorpMFANumber))
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">MFA Number / Year</span>
                                        <strong>MFA @appeal.CorpMFANumber / @appeal.CorpMFAYear</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.HighCourtBench))
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">High Court Bench</span>
                                        <strong>@(appeal.HighCourtBench == "Others" ? appeal.OtherHighCourtBench : appeal.HighCourtBench)</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.CorpMFACNRNumber))
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">High Court MFA CNR</span>
                                        <span class="fw-bold font-monospace text-primary">@appeal.CorpMFACNRNumber</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.CorpMFAStatus) && appeal.CorpMFAStatus != "Select...")
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">MFA Status</span>
                                        <span class="badge bg-info text-dark">@appeal.CorpMFAStatus</span>
                                        @(appeal.IsPendingForFiling ? " (Pending for Filing)" : "")
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.CorpMFAEntrustmentNo))
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Entrustment</span>
                                        <strong>@appeal.CorpMFAEntrustmentNo @(appeal.CorpMFAEntrustmentDate.HasValue ? "(" + appeal.CorpMFAEntrustmentDate.Value.ToString("dd-MM-yyyy") + ")" : "")</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.CorpMFAAdvocate))
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">MFA Advocate</span>
                                        <strong>@appeal.CorpMFAAdvocate</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(appeal.CorpMFAOutcome))
                                {
                                    <div class="col-12 col-md-6">
                                        <span class="text-muted d-block extra-small">Outcome / Action Taken</span>
                                        <strong>@appeal.CorpMFAOutcome</strong>
                                        @if (!string.IsNullOrEmpty(appeal.CorpMFAActionTaken) && appeal.CorpMFAActionTaken != "Select...")
                                        {
                                            <span class="ms-2 badge bg-secondary">Action: @appeal.CorpMFAActionTaken</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 2.3. SEPARATED ECOURTS NAPIX LIVE GATEWAY STATUS CARD (HIGH COURT MFA) -->
                    @if (!string.IsNullOrEmpty(appeal.CorpMFANumber) || !string.IsNullOrEmpty(appeal.CorpMFACNRNumber))
                    {
                        string detCnr = (appeal.CorpMFACNRNumber ?? "").Trim().ToUpperInvariant();
                        <div class="card border-primary shadow-sm mb-4 rounded-3 overflow-hidden d-print-none" id="corpEcourtsSection_@appeal.AppealID">
                            <div class="card-header bg-primary bg-opacity-10 border-primary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center py-2 px-3 gap-2"
                                 style="cursor: pointer;"
                                 data-bs-toggle="collapse"
                                 data-bs-target="#collapseCorpMfaNapix_@appeal.AppealID"
                                 aria-expanded="false"
                                 aria-controls="collapseCorpMfaNapix_@appeal.AppealID"
                                 title="Click anywhere on this header to show/hide High Court MFA NAPIX details">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-broadcast text-primary fs-5 me-2"></i>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="mb-0 fw-bold text-dark">High Court MFA — eCourts NAPIX Live Gateway Status</h6>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill extra-small px-2 py-0">
                                                <i class="bi bi-hand-index-thumb me-1"></i>Click to open
                                            </span>
                                        </div>
                                        <small class="text-muted extra-small">Live case tracking from Karnataka High Court (NAPIX / NJDG Services)</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                        @if (!string.IsNullOrEmpty(detCnr))
                                        {
                                            <span class="badge bg-primary font-monospace fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center text-nowrap" id="live_cnr_badge_@appeal.AppealID">
                                                <i class="bi bi-broadcast me-1"></i> CNR: @detCnr
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Copy CNR Number" onclick="navigator.clipboard.writeText('@detCnr'); alert('CNR Number copied to clipboard: @detCnr');">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2" id="live_cnr_badge_@appeal.AppealID">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> CNR Not Linked
                                            </span>
                                        }
                                        <button class="btn btn-sm btn-primary py-1 px-3 shadow-sm fw-bold" type="button" id="btnRefreshMfa_@appeal.AppealID" onclick="ensureMfaSectionOpen('@appeal.AppealID'); syncMfaDetails('@appeal.AppealID', false)">
                                            <i class="bi bi-arrow-repeat me-1"></i> Fetch Live Data
                                        </button>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary text-white rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseCorpMfaNapix_@appeal.AppealID"
                                            aria-expanded="false"
                                            aria-controls="collapseCorpMfaNapix_@appeal.AppealID"
                                            id="btnToggleCorpMfaNapix_@appeal.AppealID"
                                            onclick="event.stopPropagation();">
                                        <i class="bi bi-chevron-down" id="iconToggleCorpMfaNapix_@appeal.AppealID"></i>
                                        <span id="textToggleCorpMfaNapix_@appeal.AppealID">View NAPIX Details</span>
                                    </button>
                                </div>
                            </div>

                            <div class="collapse" id="collapseCorpMfaNapix_@appeal.AppealID">

                            <!-- Quick CNR Link / Sync Bar -->
                            <div class="bg-light-subtle border-bottom px-3 py-2">
                                <div class="row g-2 align-items-center">
                                    <div class="col-md-7 col-lg-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white text-muted fw-semibold">
                                                <i class="bi bi-upc-scan me-1 text-primary"></i> High Court CNR
                                            </span>
                                            <input type="text"
                                                   id="cnrInput_@appeal.AppealID"
                                                   class="form-control font-monospace fw-bold text-dark text-uppercase"
                                                   value="@detCnr"
                                                   placeholder="e.g. KAHC020060752019"
                                                   maxlength="20" />
                                            <button class="btn btn-primary btn-sm px-3 fw-bold"
                                                    type="button"
                                                    id="btnSyncMfa_@appeal.AppealID"
                                                    onclick="syncMfaDetails('@appeal.AppealID', false)">
                                                <i class="bi bi-cloud-arrow-down-fill me-1"></i> Sync Live
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-5 col-lg-6 text-md-end">
                                        <span id="live_updated_@appeal.AppealID" class="badge bg-secondary-subtle text-secondary border px-2 py-1 extra-small">
                                            @(string.IsNullOrEmpty(detCnr) ? "Not Synced" : "Database Synced")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Aligned Metadata Grid -->
                            <div class="card-body bg-light p-3" id="ecourtsLiveCard_@appeal.AppealID">
                                <div class="row g-3">
                                    <!-- Row 1: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">MFA Case No &amp; Year</small>
                                        <div class="fs-6 fw-bold text-dark" id="live_mfa_no_@appeal.AppealID">
                                            MFA @(string.IsNullOrEmpty(appeal.CorpMFANumber) ? "—" : appeal.CorpMFANumber) / @(appeal.CorpMFAYear?.ToString() ?? "—")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">High Court Bench</small>
                                        <div class="fw-bold text-dark" id="live_bench_@appeal.AppealID" style="word-break: break-word;">
                                            @(string.IsNullOrEmpty(appeal.HighCourtBench) ? "High Court of Karnataka" : (appeal.HighCourtBench == "Others" ? appeal.OtherHighCourtBench : appeal.HighCourtBench))
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Next Hearing Date</small>
                                        <div class="fw-bold text-primary fs-6" id="live_hearing_@appeal.AppealID">
                                            <i class="bi bi-calendar-event me-1"></i>@(appeal.CorpMFANextHearingDate?.ToString("dd-MM-yyyy") ?? "—")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Stage</small>
                                        <div id="live_stage_wrap_@appeal.AppealID">
                                            <span id="live_stage_@appeal.AppealID" class="badge bg-primary text-white shadow-sm px-2 py-1">
                                                @(string.IsNullOrEmpty(appeal.CorpMFAStage) ? "—" : appeal.CorpMFAStage)
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Row 2: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Status</small>
                                        <div class="fw-semibold text-dark" id="live_status_@appeal.AppealID">
                                            @(appeal.CorpMFAStatus ?? "Pending")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Filing Date</small>
                                        <div class="fw-semibold text-dark" id="live_filing_date_@appeal.AppealID">@(appeal.CorpMFAEntrustmentDate?.ToString("dd-MM-yyyy") ?? (appeal.CorpMFAYear.HasValue && appeal.CorpMFAYear > 1900 ? $"01-01-{appeal.CorpMFAYear}" : "—"))</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Registration Date</small>
                                        <div class="fw-semibold text-dark" id="live_reg_date_@appeal.AppealID">@(appeal.CorpMFAEntrustmentDate?.ToString("dd-MM-yyyy") ?? (appeal.CorpMFAYear.HasValue && appeal.CorpMFAYear > 1900 ? $"01-01-{appeal.CorpMFAYear}" : "—"))</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Decision Date</small>
                                        <div class="fw-semibold text-dark" id="live_decision_date_@appeal.AppealID">@(appeal.ClosureDate?.ToString("dd-MM-yyyy") ?? (string.Equals(appeal.CorpMFAStatus, "Disposed", StringComparison.OrdinalIgnoreCase) ? "Disposed" : "Pending"))</div>
                                    </div>

                                    <!-- Row 3: 2 columns -->
                                    <div class="col-12 col-md-6">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Coram / Bench (Hon'ble Judges)</small>
                                        <div class="fw-semibold text-dark" id="live_judge_@appeal.AppealID" style="word-break: break-word;">
                                            <span class="text-muted">Will sync via NAPIX gateway...</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Type &amp; Classification</small>
                                        <div class="fw-semibold text-dark" id="live_casetype_@appeal.AppealID" style="word-break: break-word;">
                                            MFA — Motor Vehicles Act U/S 173
                                        </div>
                                    </div>

                                    <!-- Row 4: 4 columns -->
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner / Appellant</small>
                                        <div class="fw-bold text-dark" id="live_petitioner_@appeal.AppealID" style="word-break: break-word;">
                                            The Managing Director, NWKRTC
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Petitioner Advocate</small>
                                        <div class="fw-semibold text-dark" id="live_pet_adv_@appeal.AppealID" style="word-break: break-word;">
                                            @(appeal.CorpMFAAdvocate ?? "—")
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Respondent / Opponent</small>
                                        <div class="fw-bold text-dark" id="live_respondent_@appeal.AppealID" style="word-break: break-word;">
                                            —
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Respondent Advocate</small>
                                        <div class="fw-semibold text-dark" id="live_res_adv_@appeal.AppealID" style="word-break: break-word;">
                                            —
                                        </div>
                                    </div>
                                </div>

                                <!-- Dossier Tabs Section -->
                                <div class="col-12 mt-3 pt-2 border-top">
                                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                                        <ul class="nav nav-pills dossier-tab-nav bg-light p-1 rounded-3 border mb-3 d-flex flex-wrap gap-1" role="tablist">
                                            <li class="nav-item">
                                                <button class="nav-link active fw-bold small py-2 px-3 rounded-2" data-bs-toggle="tab" data-bs-target="#tabHistory_@appeal.AppealID" type="button">
                                                    <i class="bi bi-clock-history me-1 text-primary"></i> Hearing History
                                                    <span class="badge bg-primary text-white rounded-pill ms-1" id="tabCountHistory_@appeal.AppealID">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 px-3 rounded-2" data-bs-toggle="tab" data-bs-target="#tabOrders_@appeal.AppealID" type="button">
                                                    <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> Orders &amp; Judgments
                                                    <span class="badge bg-danger text-white rounded-pill ms-1" id="tabCountOrders_@appeal.AppealID">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 px-3 rounded-2" data-bs-toggle="tab" data-bs-target="#tabIA_@appeal.AppealID" type="button">
                                                    <i class="bi bi-journal-text me-1 text-warning"></i> Interim Applications (I.A.)
                                                    <span class="badge bg-warning text-dark rounded-pill ms-1" id="tabCountIA_@appeal.AppealID">0</span>
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link fw-bold small py-2 px-3 rounded-2" data-bs-toggle="tab" data-bs-target="#tabParties_@appeal.AppealID" type="button">
                                                    <i class="bi bi-card-heading me-1 text-info"></i> Full Case Details
                                                </button>
                                            </li>
                                        </ul>

                                        <div class="tab-content">
                                            <!-- 1. Hearing History Tab -->
                                            <div class="tab-pane fade show active" id="tabHistory_@appeal.AppealID">
                                                <div class="table-responsive rounded-3 border" style="max-height: 420px; overflow-y: auto;">
                                                    <table class="table table-hover table-striped align-middle extra-small mb-0" style="min-width: 760px; width: 100%; table-layout: fixed;">
                                                        <thead class="table-dark small text-uppercase sticky-top" style="position: sticky; top: 0; z-index: 2;">
                                                            <tr>
                                                                <th class="text-center py-2 px-2" style="width:5%; white-space:nowrap;">#</th>
                                                                <th class="text-start py-2 ps-3 pe-2 text-nowrap" style="width:20%;"><i class="bi bi-calendar-event me-1"></i>Hearing Date</th>
                                                                <th class="text-start py-2 px-3" style="width:43%;"><i class="bi bi-bank2 me-1"></i>Bench / Coram</th>
                                                                <th class="text-center py-2 px-2" style="width:17%;"><i class="bi bi-bookmark-star me-1"></i>Purpose / Stage</th>
                                                                <th class="text-center py-2 px-2" style="width:15%; white-space:nowrap;"><i class="bi bi-gear me-1"></i>Action</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tbodyHistory_@appeal.AppealID">
                                                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1 text-primary"></i> No hearing history loaded yet. Click <strong>Fetch Live Data</strong> to sync e-Courts records.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 2. Orders & Judgments Tab -->
                                            <div class="tab-pane fade" id="tabOrders_@appeal.AppealID">
                                                <div class="table-responsive rounded-3 border" style="max-height: 420px; overflow-y: auto;">
                                                    <table class="table table-hover table-striped align-middle extra-small mb-0" style="min-width: 760px; width: 100%; table-layout: fixed;">
                                                        <thead class="table-dark small text-uppercase sticky-top" style="position: sticky; top: 0; z-index: 2;">
                                                            <tr>
                                                                <th class="text-center py-2 px-2" style="width:6%; white-space:nowrap;">#</th>
                                                                <th class="py-2 px-3 text-nowrap" style="width:18%;"><i class="bi bi-calendar-check me-1 text-danger"></i>Order Date</th>
                                                                <th class="py-2 px-3" style="width:34%;"><i class="bi bi-file-earmark-text me-1 text-info"></i>Order Type / Details</th>
                                                                <th class="py-2 px-3" style="width:22%;"><i class="bi bi-bank me-1 text-warning"></i>Bench / Coram</th>
                                                                <th class="py-2 px-3 text-end" style="width:20%;"><i class="bi bi-file-pdf me-1 text-danger"></i>Action / PDF</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tbodyOrders_@appeal.AppealID">
                                                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1 text-danger"></i> No orders/judgments loaded yet. Click <strong>Fetch Live Data</strong> to sync order documents.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 3. Interim Applications Tab -->
                                            <div class="tab-pane fade" id="tabIA_@appeal.AppealID">
                                                <div class="table-responsive rounded-3 border" style="max-height: 350px; overflow-y: auto;">
                                                    <table class="table table-sm table-hover align-middle extra-small mb-0" style="min-width: 600px;">
                                                        <thead class="bg-dark text-white sticky-top">
                                                            <tr>
                                                                <th class="py-2 px-3" style="width:40px;">#</th>
                                                                <th class="py-2 px-3" style="width:220px;"><i class="bi bi-file-earmark-diff me-1 text-warning"></i>IA Number &amp; Classification</th>
                                                                <th class="py-2 px-3"><i class="bi bi-person me-1"></i>Applicant Name</th>
                                                                <th class="py-2 px-3 text-nowrap" style="width:120px;"><i class="bi bi-calendar-event me-1"></i>Filing Date</th>
                                                                <th class="py-2 px-3 text-center" style="width:100px;"><i class="bi bi-flag me-1"></i>Status</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tbodyIA_@appeal.AppealID">
                                                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1 text-warning"></i> No interim applications loaded yet. Click <strong>Fetch Live Data</strong> to sync.</td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 4. Full Case Details Tab -->
                                            <div class="tab-pane fade" id="tabParties_@appeal.AppealID">
                                                <div class="row g-3 extra-small" id="detailsMeta_@appeal.AppealID">
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-primary border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-person-badge-fill text-primary me-1"></i> Petitioner / Appellant</div>
                                                            <div id="fullPetitioner_@appeal.AppealID" class="fw-bold text-dark fs-6 mb-1" style="word-break: break-word;">—</div>
                                                            <div class="extra-small text-muted"><i class="bi bi-person-gear me-1"></i>Advocate: <span id="fullPetAdv_@appeal.AppealID" class="fw-semibold text-dark">—</span></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-secondary border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-building-fill text-secondary me-1"></i> Respondent / Defendant</div>
                                                            <div id="fullRespondent_@appeal.AppealID" class="fw-bold text-dark fs-6 mb-1" style="word-break: break-word;">—</div>
                                                            <div class="extra-small text-muted"><i class="bi bi-person-gear me-1"></i>Advocate: <span id="fullResAdv_@appeal.AppealID" class="fw-semibold text-dark">—</span></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-info border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-bank2 text-info me-1"></i> Judicial Bench / Court</div>
                                                            <div id="fullCourt_@appeal.AppealID" class="fw-bold text-dark fs-6 mb-1" style="word-break: break-word;">—</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light border-start border-warning border-4 rounded-3 shadow-sm h-100">
                                                            <div class="text-muted extra-small text-uppercase fw-bold mb-1"><i class="bi bi-calendar-range-fill text-warning me-1"></i> Milestone Dates</div>
                                                            <div class="extra-small mb-1">Filing Date: <strong id="fullFilingDate_@appeal.AppealID" class="text-dark">@(appeal.CorpMFAEntrustmentDate?.ToString("dd-MM-yyyy") ?? "—")</strong></div>
                                                            <div class="extra-small mb-1">Registration Date: <strong id="fullRegDate_@appeal.AppealID" class="text-dark">@(appeal.CorpMFAEntrustmentDate?.ToString("dd-MM-yyyy") ?? (appeal.CorpMFAYear.HasValue && appeal.CorpMFAYear > 1900 ? $"01-01-{appeal.CorpMFAYear}" : "—"))</strong></div>
                                                            <div class="extra-small">Decision Date: <strong id="fullDisposalDate_@appeal.AppealID" class="text-dark">@(appeal.ClosureDate?.ToString("dd-MM-yyyy") ?? (string.Equals(appeal.CorpMFAStatus, "Disposed", StringComparison.OrdinalIgnoreCase) ? "Disposed" : "Pending"))</strong></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                    }

                    <!-- 2.4. Stay & Restoration -->
                    @if (appeal.StayGranted || appeal.RestorationFiled || !string.IsNullOrEmpty(appeal.RestorationStatus))
                    {
                        <div class="mb-4">
                            <h6 class="text-primary border-bottom pb-2 fw-bold small text-uppercase"><i class="bi bi-shield-lock me-2"></i>Stay &amp; Restoration</h6>
                            <div class="row g-3 small">
                                @if (appeal.StayGranted)
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Stay Granted</span>
                                        <strong class="text-success"><i class="bi bi-check-circle me-1"></i>Yes</strong>
                                    </div>
                                    @if (!string.IsNullOrEmpty(appeal.StayComplianceOutwardNo))
                                    {
                                        <div class="col-6 col-md-3">
                                            <span class="text-muted d-block extra-small">Stay Compliance No.</span>
                                            <strong>@appeal.StayComplianceOutwardNo</strong>
                                        </div>
                                    }
                                    @if (appeal.StayComplianceDate.HasValue)
                                    {
                                        <div class="col-6 col-md-3">
                                            <span class="text-muted d-block extra-small">Stay Compliance Date</span>
                                            <strong>@appeal.StayComplianceDate?.ToString("dd-MM-yyyy")</strong>
                                        </div>
                                    }
                                }
                                @if (appeal.RestorationFiled)
                                {
                                    <div class="col-6 col-md-3">
                                        <span class="text-muted d-block extra-small">Restoration Filed</span>
                                        <strong>Yes @(appeal.RestorationDate.HasValue ? "(" + appeal.RestorationDate?.ToString("dd-MM-yyyy") + ")" : "")</strong>
                                    </div>
                                    @if (!string.IsNullOrEmpty(appeal.RestorationStatus))
                                    {
                                        <div class="col-12 col-md-6">
                                            <span class="text-muted d-block extra-small">Restoration Status</span>
                                            <strong>@appeal.RestorationStatus</strong>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <!-- 2.5. Closure Details -->
                    @if (!string.IsNullOrEmpty(appeal.ClosureOutwardNo) || appeal.ClosureDate.HasValue)
                    {
                        <div class="mb-4">
                            <h6 class="text-primary border-bottom pb-2 fw-bold small text-uppercase"><i class="bi bi-check2-circle me-2"></i>Closure Details</h6>
                            <div class="row g-3 small">
                                @if (!string.IsNullOrEmpty(appeal.ClosureOutwardNo))
                                {
                                    <div class="col-6 col-md-4">
                                        <span class="text-muted d-block extra-small">Closure Outward No</span>
                                        <strong>@appeal.ClosureOutwardNo</strong>
                                    </div>
                                }
                                @if (appeal.ClosureDate.HasValue)
                                {
                                    <div class="col-6 col-md-4">
                                        <span class="text-muted d-block extra-small">Closure Date</span>
                                        <strong>@appeal.ClosureDate?.ToString("dd-MM-yyyy")</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 2.6. Claimant Appeal Workflow -->
                    @if (!string.IsNullOrEmpty(appeal.ClaimantMFANumber) || !string.IsNullOrEmpty(appeal.ClaimantMVCNumber) || !string.IsNullOrEmpty(appeal.ClaimantMFACNRNumber))
                    {
                        <div class="mb-4">
                            <h6 class="text-primary border-bottom pb-2 fw-bold small text-uppercase"><i class="bi bi-person-up me-2"></i>Claimant Appeal Workflow</h6>
                            <div class="row g-3 small">
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block extra-small">MFA Number &amp; Year</span>
                                    <strong>@appeal.ClaimantMFANumber @(appeal.ClaimantMFAYear.HasValue ? "/ " + appeal.ClaimantMFAYear : "")</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-muted d-block extra-small">High Court Bench</span>
