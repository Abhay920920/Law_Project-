                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size:.7rem">Case Status</small>
                    <div class="fw-semibold text-dark" id="live-case-status">@(!string.IsNullOrWhiteSpace(Model.CaseStatus) ? Model.CaseStatus : (Model.PendDispStatus == "D" ? "Disposed" : (Model.PendDispStatus == "P" ? "Pending" : "—")))</div>
