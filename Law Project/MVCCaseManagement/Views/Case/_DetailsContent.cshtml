    <style>
        .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
        .hover-scale:hover { transform: scale(1.05); }
        .transition-transform { transition: transform .3s ease; }
        .nav-pills .nav-link { color: #6c757d; font-weight: 500; }
        .nav-pills .nav-link.active { background-color: #e9ecef !important; color: #0d6efd !important; font-weight: 600; }
        .nav-pills .nav-link:hover:not(.active) { background-color: #f8f9fa; }
    </style>
}

    <!-- SUMMARY INFO SECTION -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
        <!-- 1. Accident & Vehicle Info -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100 @(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "bg-warning text-dark border-2 border-warning" : "bg-success text-white") rounded-3">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="@(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "text-dark text-opacity-75" : "text-white text-opacity-75") text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">Accident Info</span>
                            <i class="bi @(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "bi-shield-exclamation text-dark" : "bi-calendar2-check text-white text-opacity-75") fs-5"></i>
                        </div>
                        <div class="fs-5 fw-bold mb-1">
                            @(Model.AccidentDate?.ToString("dd-MM-yyyy") ?? "—")
                            @if (Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true)
                            {
                                <span class="badge bg-dark text-warning ms-1" style="font-size: 0.65rem;">ALLEGED ACCIDENT</span>
                            }
                        </div>
                        <div class="small fw-semibold @(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "text-dark" : "text-white text-opacity-90")">
                            <i class="bi bi-bus-front me-1"></i>Vehicle: <span class="badge @(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "bg-dark text-white" : "bg-white text-success") fw-bold font-monospace">@Model.VehicleNo</span>
                        </div>
                        @if (Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true)
                        {
                            <div class="extra-small mt-1 text-dark fw-bold">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>No actual accident occurred (Alleged)
                            </div>
                        }
                        @if (Model.OppositeVehicleNumbers != null && Model.OppositeVehicleNumbers.Count > 0)
                        {
                            <div class="extra-small mt-1 @(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "text-dark text-opacity-75" : "text-white text-opacity-75")">
                                Opp Vehicle(s): @string.Join(", ", Model.OppositeVehicleNumbers)
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PetitionFiledFor))
                    {
                        <div class="extra-small @(Model.IsAllegedAccident || Model.AdverseAward?.IsAllegedAccident == true ? "text-dark text-opacity-75 border-dark border-opacity-25" : "text-white text-opacity-75 border-white border-opacity-25") border-top pt-1 mt-2">
                            Petition: <strong>@Model.PetitionFiledFor</strong>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 2. Outcome & Award Summary -->
        <div class="col">
            @{
                bool isAgainst = string.Equals(effectiveDisposalResult, "Against", StringComparison.OrdinalIgnoreCase);
                bool isFavor = string.Equals(effectiveDisposalResult, "In Favor", StringComparison.OrdinalIgnoreCase) || string.Equals(effectiveDisposalResult, "Favor", StringComparison.OrdinalIgnoreCase);
                string outcomeBgClass = isAgainst ? "bg-danger text-white" : (isFavor ? "bg-success text-white" : "bg-primary text-white");
            }
            <div class="card border-0 shadow-sm h-100 @outcomeBgClass rounded-3">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white text-opacity-75 text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">Outcome & Award</span>
                            <i class="bi @(isAgainst ? "bi-exclamation-octagon-fill" : "bi-award-fill") text-white text-opacity-75 fs-5"></i>
                        </div>
                        <div class="fs-5 fw-bold mb-1">@(string.IsNullOrEmpty(effectiveDisposalResult) ? "Pending / Active" : effectiveDisposalResult)</div>
                        @if (Model.AdverseAward?.AwardAmount > 0)
                        {
                            <div class="fw-bold text-white fs-6">
                                ₹ @Model.AdverseAward.AwardAmount?.ToString("N2")
                                @if (Model.AdverseAward.InterestRate > 0)
                                {
                                    <span class="badge bg-white text-danger fw-bold ms-1" style="font-size:0.7rem">@Model.AdverseAward.InterestRate% p.a.</span>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-light text-danger fw-semibold px-2 py-0 mt-2 rounded-pill shadow-xs" data-bs-toggle="modal" data-bs-target="#fullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-award-nav')).show(); }, 150);" style="font-size: 0.75rem;">
                                <i class="bi bi-calculator me-1"></i>View Award Details
                            </button>
                        }
                        else if (isFavor)
                        {
                            <div class="small text-white text-opacity-90"><i class="bi bi-shield-check me-1"></i>Nil Liability / Dismissed</div>
                        }
                    </div>
                    @if (Model.ClaimAmount > 0)
                    {
                        <div class="extra-small text-white text-opacity-75 border-top border-white border-opacity-25 pt-1 mt-2">
                            Claimed: ₹ @Model.ClaimAmount?.ToString("N2")
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Central Office Action & Appeal -->
        <div class="col">
            @{
                // 1. Disposal check
                bool coIsCaseDisposed = string.Equals(Model.CurrentStage, "DISPOSED", StringComparison.OrdinalIgnoreCase) 
                                     || string.Equals(Model.DisposalStatus, "Disposed", StringComparison.OrdinalIgnoreCase) 
                                     || (!string.IsNullOrEmpty(effectiveDisposalResult) 
                                         && !string.Equals(effectiveDisposalResult, "Pending", StringComparison.OrdinalIgnoreCase) 
                                         && !string.Equals(effectiveDisposalResult, "Active", StringComparison.OrdinalIgnoreCase));

                bool coIsFavor = string.Equals(effectiveDisposalResult, "In Favor", StringComparison.OrdinalIgnoreCase) 
                              || string.Equals(effectiveDisposalResult, "Favor", StringComparison.OrdinalIgnoreCase);

                // 2. Forwarding / Referral to Central Office check
                string coForwardStatus = Model.ForwardingStatus ?? Model.AdverseAward?.ForwardingStatus ?? "";
                bool coIsSentToCO = string.Equals(coForwardStatus, "Sent to Central Office", StringComparison.OrdinalIgnoreCase)
                                 || string.Equals(coForwardStatus, "Sent to CO", StringComparison.OrdinalIgnoreCase)
                                 || (Model.LinkedAppeal != null && Model.LinkedAppeal.AppealID > 0);

                bool coIsClosedAtDivision = string.Equals(coForwardStatus, "Closed at Division", StringComparison.OrdinalIgnoreCase);

                // 3. Central Office Real-Time Action
                string coRawAction = Model.LinkedAppeal?.InitialAction?.Trim() ?? "";
                string coRoleAction = "";
                string coRoleName = "";
                if (!string.IsNullOrEmpty(Model.LinkedAppeal?.ActionTaken_MD))
                {
                    coRoleAction = Model.LinkedAppeal.ActionTaken_MD.Trim();
                    coRoleName = "MD";
                }
                else if (!string.IsNullOrEmpty(Model.LinkedAppeal?.ActionTaken_CLO))
                {
                    coRoleAction = Model.LinkedAppeal.ActionTaken_CLO.Trim();
                    coRoleName = "CLO";
                }
                else if (!string.IsNullOrEmpty(Model.LinkedAppeal?.ActionTaken_DyCLO))
                {
                    coRoleAction = Model.LinkedAppeal.ActionTaken_DyCLO.Trim();
                    coRoleName = "Dy CLO";
                }
                else if (!string.IsNullOrEmpty(Model.LinkedAppeal?.ActionTaken_LO))
                {
                    coRoleAction = Model.LinkedAppeal.ActionTaken_LO.Trim();
                    coRoleName = "LO";
                }

                string coEffectiveAction = !string.IsNullOrEmpty(coRoleAction) ? coRoleAction : coRawAction;
                bool coHasCorpMFA = !string.IsNullOrEmpty(Model.LinkedAppeal?.CorpMFANumber);
                bool coHasClaimantMFA = !string.IsNullOrEmpty(Model.LinkedAppeal?.ClaimantMFANumber);

                // 4. Determine Visual States
                string coCardBg;
                string coCardIcon;
                string coHeadline;
                string coBadgeClass;
                string coBadgeText;
                string coFooterText = "";
                bool coCanOpenTab = Model.LinkedAppeal != null || coIsSentToCO;

                if (!coIsCaseDisposed)
                {
                    // State 1: Lower court case is still pending in MACT
                    coCardBg = "bg-light text-dark border border-secondary border-opacity-25";
                    coCardIcon = "bi bi-hourglass-split text-secondary";
                    coHeadline = "No Action Taken";
                    coBadgeClass = "badge bg-secondary-subtle text-secondary border fw-bold";
                    coBadgeText = "Case Pending in MACT";
                    coFooterText = "Not yet eligible for CO action";
                }
                else if (coIsFavor && !coHasClaimantMFA)
                {
                    // State 2: Disposed in favor of Corporation
                    coCardBg = "bg-light text-dark border border-success border-opacity-25";
                    coCardIcon = "bi bi-shield-check text-success";
                    coHeadline = "No Action Taken";
                    coBadgeClass = "badge bg-success-subtle text-success border border-success-subtle fw-bold";
                    coBadgeText = "In Favor (No Appeal)";
                    coFooterText = "Nil liability / Claim dismissed";
                }
                else if (coIsClosedAtDivision)
                {
                    // State 3: Disposed and closed at division level
                    coCardBg = "bg-light text-dark border border-secondary border-opacity-25";
                    coCardIcon = "bi bi-building-lock text-secondary";
                    coHeadline = "Closed at Division";
                    coBadgeClass = "badge bg-secondary text-white fw-bold";
                    coBadgeText = "Retained at Division";
                    if (Model.AdverseAward?.ClosureDate.HasValue == true)
                    {
                        coFooterText = $"Closed: {Model.AdverseAward.ClosureDate.Value.ToString("dd-MM-yyyy")}";
                    }
                    else if (!string.IsNullOrEmpty(Model.AdverseAward?.OutwardNumber))
                    {
                        coFooterText = $"Outward: {Model.AdverseAward.OutwardNumber}";
                    }
                }
                else if (!coIsSentToCO && string.IsNullOrEmpty(coEffectiveAction) && !coHasCorpMFA && !coHasClaimantMFA)
                {
                    // State 4: Disposed against, but NOT yet forwarded to Central Office
                    coCardBg = "bg-light text-dark border border-warning border-opacity-25";
                    coCardIcon = "bi bi-send-x text-muted";
                    coHeadline = "No Action Taken";
                    coBadgeClass = "badge bg-secondary-subtle text-dark border fw-bold";
                    coBadgeText = "Not Sent to CO";
                    coFooterText = "Awaiting forwarding from division";
                }
                else
                {
                    // State 5: Case is Sent to CO / Under Review / Action Taken
                    bool isPendingDecision = string.IsNullOrEmpty(coEffectiveAction)
                                          || string.Equals(coEffectiveAction, "Pending", StringComparison.OrdinalIgnoreCase)
                                          || string.Equals(coEffectiveAction, "Pending Decision", StringComparison.OrdinalIgnoreCase)
                                          || string.Equals(coEffectiveAction, "Pending Review", StringComparison.OrdinalIgnoreCase)
                                          || string.Equals(coEffectiveAction, "Pending Before Competent Authority", StringComparison.OrdinalIgnoreCase)
                                          || string.Equals(coEffectiveAction, "Pending at CA", StringComparison.OrdinalIgnoreCase);

                    if (isPendingDecision && !coHasCorpMFA)
                    {
                        // Awaiting decision at Central Office
                        coCardBg = "bg-warning text-dark";
                        coCardIcon = "bi bi-clock-history text-dark text-opacity-75";
                        coHeadline = "Pending Review";
                        coBadgeClass = "badge bg-dark text-white fw-bold";
                        coBadgeText = !string.IsNullOrEmpty(coEffectiveAction) ? coEffectiveAction : "Pending with CO";

                        if (Model.LinkedAppeal?.FeasibilityReceiptDate.HasValue == true)
                        {
                            coFooterText = $"Feasibility: {Model.LinkedAppeal.FeasibilityReceiptDate.Value.ToString("dd-MM-yyyy")}";
                        }
                        else if (Model.AdverseAward?.OutwardDate.HasValue == true)
                        {
                            coFooterText = $"Forwarded: {Model.AdverseAward.OutwardDate.Value.ToString("dd-MM-yyyy")}";
                        }
                        else
                        {
                            coFooterText = "Under Central Office scrutiny";
                        }
                    }
                    else
                    {
                        // Real-time status updated by Central Office
                        bool isAppeal = coEffectiveAction.Contains("Appeal", StringComparison.OrdinalIgnoreCase) || coHasCorpMFA;
                        bool isClose = coEffectiveAction.Contains("Close", StringComparison.OrdinalIgnoreCase)
                                    || coEffectiveAction.Contains("Satisfy", StringComparison.OrdinalIgnoreCase)
                                    || coEffectiveAction.Contains("No Appeal", StringComparison.OrdinalIgnoreCase);
                        bool isCA = coEffectiveAction.Contains("Competent", StringComparison.OrdinalIgnoreCase);

                        if (isAppeal)
                        {
                            coCardBg = "bg-primary text-white";
                            coCardIcon = "bi bi-arrow-up-right-circle-fill text-white text-opacity-75";
                            coHeadline = coHasCorpMFA
                                ? $"MFA {Model.LinkedAppeal!.CorpMFANumber}/{Model.LinkedAppeal.CorpMFAYear}"
                                : (!string.IsNullOrEmpty(coRoleName) ? $"{coRoleName}: Appeal" : (coEffectiveAction.Length > 0 ? coEffectiveAction : "Appeal Proposed"));

                            coBadgeClass = "badge bg-white text-primary fw-bold";
                            coBadgeText = Model.LinkedAppeal?.CorpMFAStatus
                                       ?? Model.LinkedAppeal?.FinalComplianceStatus
                                       ?? (coHasCorpMFA ? "MFA Filed" : "Appeal Sanctioned");

                            if (Model.LinkedAppeal?.ApprovalDate.HasValue == true)
                            {
                                coFooterText = $"Approval: {Model.LinkedAppeal.ApprovalOutwardNo} ({Model.LinkedAppeal.ApprovalDate.Value.ToString("dd-MM-yyyy")})";
                            }
                            else if (Model.LinkedAppeal?.CorpMFAEntrustmentDate.HasValue == true)
                            {
                                coFooterText = $"Entrusted: {Model.LinkedAppeal.CorpMFAEntrustmentDate.Value.ToString("dd-MM-yyyy")}";
                            }
                        }
                        else if (isClose)
                        {
                            coCardBg = "bg-success text-white";
                            coCardIcon = "bi bi-check-circle-fill text-white text-opacity-75";
                            coHeadline = !string.IsNullOrEmpty(coRoleName) ? $"{coRoleName}: {coRoleAction}" : "Matter Closed";
                            coBadgeClass = "badge bg-white text-success fw-bold";
                            coBadgeText = Model.LinkedAppeal?.FinalComplianceStatus ?? "Closed / Satisfied";

                            if (Model.LinkedAppeal?.ApprovalDate.HasValue == true)
                            {
                                coFooterText = $"Approval: {Model.LinkedAppeal.ApprovalOutwardNo} ({Model.LinkedAppeal.ApprovalDate.Value.ToString("dd-MM-yyyy")})";
                            }
                            else if (Model.LinkedAppeal?.ClosureDate.HasValue == true)
                            {
                                coFooterText = $"Closed: {Model.LinkedAppeal.ClosureDate.Value.ToString("dd-MM-yyyy")}";
                            }
                        }
                        else if (isCA)
                        {
                            coCardBg = "bg-info text-white";
                            coCardIcon = "bi bi-person-badge-fill text-white text-opacity-75";
                            coHeadline = "Competent Authority";
                            coBadgeClass = "badge bg-white text-info fw-bold";
                            coBadgeText = "Pending at CA";
                            coFooterText = "Awaiting competent authority order";
                        }
                        else
                        {
                            coCardBg = "bg-dark text-white";
                            coCardIcon = "bi bi-shield-shaded text-white text-opacity-75";
                            coHeadline = !string.IsNullOrEmpty(coRoleName) ? $"{coRoleName}: {coRoleAction}" : coEffectiveAction;
                            coBadgeClass = "badge bg-white text-dark fw-bold";
                            coBadgeText = Model.LinkedAppeal?.FinalComplianceStatus ?? "Action Taken";

                            if (Model.LinkedAppeal?.ApprovalDate.HasValue == true)
                            {
                                coFooterText = $"Approval: {Model.LinkedAppeal.ApprovalOutwardNo} ({Model.LinkedAppeal.ApprovalDate.Value.ToString("dd-MM-yyyy")})";
                            }
                        }
                    }
                }

                bool isCoLightCard = coCardBg.Contains("bg-light");
                bool isCoWarningCard = coCardBg.Contains("bg-warning");
                string coLabelColor = isCoLightCard ? "text-secondary" : (isCoWarningCard ? "text-dark text-opacity-75" : "text-white text-opacity-75");
                string coHeadlineColor = (isCoLightCard || isCoWarningCard) ? "text-dark" : "text-white";
                string coStatusColor = isCoLightCard ? "text-muted" : (isCoWarningCard ? "text-dark text-opacity-90" : "text-white text-opacity-90");
            }

            <div class="card border-0 shadow-sm h-100 @coCardBg rounded-3">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="@coLabelColor text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">CO Action / Appeal</span>
                            <i class="@coCardIcon fs-5"></i>
                        </div>
                        <div class="fs-6 fw-bold mb-1 @coHeadlineColor text-truncate" title="@coHeadline">
                            @coHeadline
                        </div>
                        <div class="small fw-semibold @coStatusColor">
                            Status: <span class="@coBadgeClass">@coBadgeText</span>
                        </div>
                    </div>

                    @if (coCanOpenTab)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top @(isCoLightCard ? "border-secondary-subtle" : (isCoWarningCard ? "border-dark border-opacity-25" : "border-white border-opacity-25"))">
                            <span class="extra-small text-truncate @(isCoLightCard ? "text-muted" : (isCoWarningCard ? "text-dark text-opacity-75" : "text-white text-opacity-75"))" style="max-width: 75%;">
                                @(string.IsNullOrEmpty(coFooterText) ? "CO details recorded" : coFooterText)
                            </span>
                            <button type="button" class="btn btn-link p-0 @(isCoLightCard ? "text-primary" : (isCoWarningCard ? "text-dark" : "text-white")) text-decoration-none extra-small fw-bold" data-bs-toggle="modal" data-bs-target="#fullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-appeal-nav')).show(); }, 150);" title="View Central Office Details">
                                Details <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(coFooterText))
                    {
                        <div class="extra-small @(isCoLightCard ? "text-muted border-top pt-1 mt-2" : (isCoWarningCard ? "text-dark text-opacity-75 border-top border-dark border-opacity-25 pt-1 mt-2" : "text-white text-opacity-75 border-top border-white border-opacity-25 pt-1 mt-2"))">
                            <i class="bi bi-info-circle me-1"></i>@coFooterText
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. High Court MFA Status -->
        <div class="col">
            @{
                bool mfaHasCorp = !string.IsNullOrEmpty(Model.LinkedAppeal?.CorpMFANumber);
                bool mfaHasClaimant = !string.IsNullOrEmpty(Model.LinkedAppeal?.ClaimantMFANumber);
                bool mfaHasAny = mfaHasCorp || mfaHasClaimant;

                string mfaCardBg;
                string mfaCardIcon;
                string mfaHeadline;
                string mfaBadgeClass;
                string mfaBadgeText;
                string mfaFooterText = "";

                if (!mfaHasAny)
                {
                    // No MFA filed in High Court
                    mfaCardBg = "bg-light text-dark border border-secondary border-opacity-25";
                    mfaCardIcon = "bi bi-bank text-secondary";
                    mfaHeadline = "No MFA Filed";
                    mfaBadgeClass = "badge bg-secondary-subtle text-secondary border fw-bold";
                    mfaBadgeText = "Not in High Court";
                    mfaFooterText = "Lower court proceedings only";
                }
                else
                {
                    // High Court Appeal exists
                    mfaCardBg = "bg-info text-white";
                    mfaCardIcon = "bi bi-bank text-white text-opacity-75";

                    if (mfaHasCorp)
                    {
                        mfaHeadline = $"MFA {Model.LinkedAppeal!.CorpMFANumber} / {Model.LinkedAppeal.CorpMFAYear}";
                        mfaBadgeClass = "badge bg-white text-info fw-bold";
                        mfaBadgeText = $"Corp: {Model.LinkedAppeal.CorpMFAStatus ?? "Pending"}";

                        if (mfaHasClaimant)
                        {
                            mfaFooterText = $"Claimant: MFA {Model.LinkedAppeal.ClaimantMFANumber}/{Model.LinkedAppeal.ClaimantMFAYear}";
                        }
                        else if (!string.IsNullOrEmpty(Model.LinkedAppeal.HighCourtBench))
                        {
                            string benchName = Model.LinkedAppeal.HighCourtBench == "Others" ? (Model.LinkedAppeal.OtherHighCourtBench ?? "HC") : Model.LinkedAppeal.HighCourtBench;
                            mfaFooterText = $"Bench: {benchName}";
                        }
                        else if (Model.LinkedAppeal.CorpMFANextHearingDate.HasValue)
                        {
                            mfaFooterText = $"Next: {Model.LinkedAppeal.CorpMFANextHearingDate.Value.ToString("dd-MM-yyyy")}";
                        }
                    }
                    else
                    {
                        mfaHeadline = $"MFA {Model.LinkedAppeal!.ClaimantMFANumber} / {Model.LinkedAppeal.ClaimantMFAYear}";
                        mfaBadgeClass = "badge bg-white text-info fw-bold";
                        mfaBadgeText = $"Claimant: {Model.LinkedAppeal.ClaimantMFAStatus ?? "Pending"}";

                        if (!string.IsNullOrEmpty(Model.LinkedAppeal.HighCourtBench))
                        {
                            string benchName = Model.LinkedAppeal.HighCourtBench == "Others" ? (Model.LinkedAppeal.OtherHighCourtBench ?? "HC") : Model.LinkedAppeal.HighCourtBench;
                            mfaFooterText = $"Bench: {benchName}";
                        }
                        else if (Model.LinkedAppeal.ClaimantMFANextHearingDate.HasValue)
                        {
                            mfaFooterText = $"Next: {Model.LinkedAppeal.ClaimantMFANextHearingDate.Value.ToString("dd-MM-yyyy")}";
                        }
                    }
                }

                bool isMfaLightCard = mfaCardBg.Contains("bg-light");
                string mfaLabelColor = isMfaLightCard ? "text-secondary" : "text-white text-opacity-75";
                string mfaHeadlineColor = isMfaLightCard ? "text-dark" : "text-white";
                string mfaStatusColor = isMfaLightCard ? "text-muted" : "text-white text-opacity-90";
            }

            <div class="card border-0 shadow-sm h-100 @mfaCardBg rounded-3">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="@mfaLabelColor text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:0.5px;">High Court MFA Status</span>
                            <i class="@mfaCardIcon fs-5"></i>
                        </div>
                        <div class="fs-6 fw-bold mb-1 @mfaHeadlineColor text-truncate" title="@mfaHeadline">
                            @mfaHeadline
                        </div>
                        <div class="small fw-semibold @mfaStatusColor">
                            Status: <span class="@mfaBadgeClass">@mfaBadgeText</span>
                        </div>
                    </div>

                    @if (mfaHasAny)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-white border-opacity-25">
                            <span class="extra-small text-truncate text-white text-opacity-75" style="max-width: 75%;" title="@mfaFooterText">
                                @(string.IsNullOrEmpty(mfaFooterText) ? "High Court Appeal" : mfaFooterText)
                            </span>
                            <button type="button" class="btn btn-link p-0 text-white text-decoration-none extra-small fw-bold" data-bs-toggle="modal" data-bs-target="#fullDetailsModal" onclick="setTimeout(function(){ bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-appeal-nav')).show(); }, 150);" title="View High Court Appeal Details">
                                Details <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(mfaFooterText))
                    {
                        <div class="extra-small text-muted border-top pt-1 mt-2">
                            <i class="bi bi-info-circle me-1"></i>@mfaFooterText
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- PLEADINGS & TRIAL DEFENSE STATUS (MAIN PAGE) -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden" id="pleadingsDefenseStatusCard">
        <div class="card-header bg-white py-2 px-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-check text-primary fs-5 me-2"></i>
                <h6 class="mb-0 fw-bold text-dark">Pleadings &amp; Defense Status</h6>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-light text-dark border px-2 py-1 extra-small" id="badge-next-hearing-container">
                    <i class="bi bi-calendar-event text-primary me-1"></i>Next Hearing: <strong id="badge-next-hearing">@(Model.NextHearingDate.HasValue ? Model.NextHearingDate.Value.ToString("dd-MM-yyyy") : "—")</strong>
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 extra-small" id="badge-stage-container">
                    <i class="bi bi-diagram-3 me-1"></i>Stage: <span id="badge-current-stage">@(!string.IsNullOrEmpty(Model.CurrentStage) ? Model.CurrentStage : "—")</span>
                </span>
            </div>
        </div>
        <div class="card-body p-3 bg-light bg-opacity-25">
            <div class="row g-3">
                <!-- 1. Document Sent -->
                <div class="col-12 col-md-4">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Document Sent</span>
                                <i class="bi bi-send text-primary opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.IsDocumentSent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-check-circle me-1"></i>Yes
                                    </span>
                                    <div class="small mt-2 text-dark">
                                        <div><span class="text-muted">Outward No:</span> <strong class="font-monospace text-primary">@(string.IsNullOrEmpty(Model.DocumentOutwardNo) ? "—" : Model.DocumentOutwardNo)</strong></div>
                                        @if (Model.DocumentOutwardDate.HasValue)
                                        {
                                            <div class="text-muted extra-small mt-1"><i class="bi bi-calendar-date me-1"></i>Date: @Model.DocumentOutwardDate.Value.ToString("dd-MM-yyyy")</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fs-6">
                                        <i class="bi bi-x-circle me-1"></i>No
                                    </span>
                                    <div class="text-muted extra-small mt-2">Documents not yet dispatched</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Objection Filed -->
                <div class="col-12 col-md-4">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Objection Filed</span>
                                <i class="bi bi-shield-check text-primary opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.IsObjectionFiled || Model.AdverseAward?.ObjectionFiled == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-check2-circle me-1"></i>Yes, Filed
                                    </span>
                                    <div class="small mt-2 text-dark">
                                        @if (!string.IsNullOrEmpty(Model.ObjectionOutwardNo))
                                        {
                                            <div><span class="text-muted">Outward:</span> <strong class="font-monospace text-primary">@Model.ObjectionOutwardNo</strong></div>
                                        }
                                        @if (Model.ObjectionFiledDate.HasValue)
                                        {
                                            <div class="text-muted extra-small mt-1"><i class="bi bi-calendar-date me-1"></i>Date: @Model.ObjectionFiledDate.Value.ToString("dd-MM-yyyy")</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.AdverseAward?.ObjectionRemarks))
                                        {
                                            <div class="extra-small text-muted mt-2 fst-italic border-top pt-1">
                                                <i class="bi bi-chat-left-quote me-1"></i>@Model.AdverseAward.ObjectionRemarks
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-exclamation-circle me-1"></i>Not Filed
                                    </span>
                                    <div class="text-muted extra-small mt-2">Objection / Written statement pending</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Evidence Filed -->
                <div class="col-12 col-md-4">
                    <div class="p-3 bg-white rounded-3 border h-100 shadow-xs d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Evidence Filed</span>
                                <i class="bi bi-file-earmark-person text-primary opacity-75 fs-5"></i>
                            </div>
                            <div>
                                @if (Model.IsEvidenceFiled)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        <i class="bi bi-check2 me-1"></i>Yes, Filed
                                    </span>
                                    <div class="text-success extra-small mt-2">
                                        <i class="bi bi-check-all me-1"></i>Corporation evidence on record
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fs-6">
                                        <i class="bi bi-dash-circle me-1"></i>No
                                    </span>
                                    <div class="text-muted extra-small mt-2">Evidence affidavit not yet filed</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ECOURTS NAPIX LIVE GATEWAY STATUS CARD -->
    <div class="card border-info shadow-sm mb-4 rounded-3 overflow-hidden d-print-none" id="ecourtsNapixMainCard">
        <div class="card-header bg-info bg-opacity-10 border-info border-opacity-25 d-flex flex-wrap justify-content-between align-items-center py-2 px-3 gap-2"
             style="cursor: pointer;"
             data-bs-toggle="collapse"
             data-bs-target="#collapseCaseNapixSection"
             aria-expanded="false"
             aria-controls="collapseCaseNapixSection"
             id="headerCaseNapixSection"
             title="Click to expand/collapse live eCourts NAPIX details">
            <div class="d-flex align-items-center">
                <i class="bi bi-broadcast text-info fs-5 me-2"></i>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold text-dark">eCourts NAPIX Live Gateway Status (District Court / MACT)</h6>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill extra-small px-2 py-0">
                            <i class="bi bi-hand-index-thumb me-1"></i>Click to open
                        </span>
                    </div>
                    <small class="text-muted extra-small">Live case tracking from District Court / MACT (NAPIX / NJDG Services)</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div id="details-cnr-badge" class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                    @if (!string.IsNullOrEmpty(Model.CNRNumber))
                    {
                        <span class="badge bg-success font-monospace fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center text-nowrap">
                            <i class="bi bi-broadcast me-1"></i> CNR: @Model.CNRNumber
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Copy CNR Number" onclick="event.stopPropagation(); navigator.clipboard.writeText('@Model.CNRNumber'); alert('CNR Number copied to clipboard: @Model.CNRNumber');">
                            <i class="bi bi-clipboard"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                            <i class="bi bi-pencil-square me-1"></i>Update CNR
                        </button>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" id="btnRefreshCaseLive" onclick="event.stopPropagation(); triggerFetchCaseLiveStatus()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Fetch Live Status
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> CNR Not Linked
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="event.stopPropagation(); openUpdateCnrModal()">
                            <i class="bi bi-pencil-square me-1"></i>Update CNR
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-info text-white rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseCaseNapixSection"
                        aria-expanded="false"
                        aria-controls="collapseCaseNapixSection"
                        id="btnToggleCaseNapixSection"
                        onclick="event.stopPropagation();">
                    <i class="bi bi-chevron-down" id="iconToggleCaseNapix"></i>
                    <span id="textToggleCaseNapix">View NAPIX Details</span>
                </button>
            </div>
        </div>
        <div class="collapse" id="collapseCaseNapixSection">
            <div class="card-body bg-light p-3">
            <div class="row g-3">
