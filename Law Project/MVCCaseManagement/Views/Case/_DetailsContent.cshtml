<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">
                    <i class="bi bi-cash-stack me-2"></i>Add Advance Payment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paymentForm">
                    <input type="hidden" id="caseIdInput" value="@Model.CaseID" />
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label for="paymentAmount" class="form-label">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" class="form-control" id="paymentAmount" 
                                   step="0.01" min="0.01" required />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentType" class="form-label">Payment Type</label>
                        <select class="form-select" id="paymentType">
                            <option value="Interim">Interim Compensation</option>
                            <option value="Advance">Advance Payment</option>
                            <option value="Partial">Partial Settlement</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="chequeNumber" class="form-label">Cheque Number</label>
                        <input type="text" class="form-control" id="chequeNumber" maxlength="100" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="chequeDate" class="form-label">Cheque Date</label>
                        <input type="date" class="form-control" id="chequeDate" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentRemarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="paymentRemarks" rows="2" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSavePayment">
                    <i class="bi bi-check-circle me-1"></i>Save Payment
                </button>
            </div>
        </div>
    </div>
</div>

@if (canUpdate)
{
<!-- ================================================== -->
<!-- TRANSFER CASE MODAL                                 -->
<!-- ================================================== -->
<div class="modal fade" id="transferCaseModal" tabindex="-1" aria-labelledby="transferCaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="modal-header py-3 px-4" style="background:linear-gradient(135deg,#f59e0b,#d97706);">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-25 rounded-3 d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                        <i class="bi bi-arrow-left-right text-white fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="transferCaseModalLabel">Transfer Case</h5>
                        <div class="small text-white text-opacity-75">MVC @Model.MVCNo / @Model.MVCYear &mdash; @Model.DivisionName</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4">
                <div class="alert alert-warning border-0 rounded-3 py-2 px-3 small mb-4 d-flex align-items-center gap-2" style="background:#fffbeb;">
                    <i class="bi bi-info-circle-fill text-warning fs-5 flex-shrink-0"></i>
                    <span>This will move the case from <strong>@Model.DivisionName</strong> to the selected division. All case history is preserved.</span>
                </div>

                <form id="transferFromDetailsForm" asp-action="TransferFromDetails" asp-controller="Case" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="caseId" value="@Model.CaseID" />

                    <div class="mb-4">
                        <label for="toDivisionId" class="form-label fw-bold text-secondary small text-uppercase mb-2">
                            <i class="bi bi-building me-1"></i> Transfer To Division <span class="text-danger">*</span>
                        </label>
                        <select name="toDivisionId" id="toDivisionId" class="form-select form-select-lg rounded-3" required>
                            <option value="">— Select Target Division —</option>
                            @if (ViewBag.Divisions != null)
                            {
                                foreach (var div in (IEnumerable<MVCCaseManagement.Models.Division>)ViewBag.Divisions)
                                {
                                    if (div.DivisionID != Model.DivisionID)
                                    {
                                        <option value="@div.DivisionID">@div.DivisionNameEnglish</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="transferRemarks" class="form-label fw-bold text-secondary small text-uppercase mb-2">
                            <i class="bi bi-chat-left-text me-1"></i> Reason / Remarks
                        </label>
                        <textarea name="remarks" id="transferRemarks" class="form-control rounded-3" rows="3"
                                  placeholder="Enter reason for transfer (optional)..." maxlength="500"></textarea>
                        <div class="form-text">Optional. Max 500 characters.</div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light px-4 py-3 border-top d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-warning fw-bold rounded-pill px-4 shadow-sm" id="btnConfirmTransfer" onclick="submitTransferForm()">
                    <i class="bi bi-send-check me-2"></i> Confirm Transfer
                </button>
            </div>
        </div>
    </div>
</div>
}

<script>
// Safe bridge to ecourts-details.js fetchLiveMfaDetails
function syncMfaDetails(appealId, isAuto) {
    if (typeof fetchLiveMfaDetails === 'function') {
        fetchLiveMfaDetails(null, @Model.CaseID, appealId, isAuto);
    }
}

function submitTransferForm() {
    var select = document.getElementById('toDivisionId');
    if (!select || !select.value) {
        select.classList.add('is-invalid');
        select.focus();
        return;
    }
    select.classList.remove('is-invalid');

    var btn = document.getElementById('btnConfirmTransfer');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Transferring...';
    document.getElementById('transferFromDetailsForm').submit();
}

// Auto-dismiss transfer notifications after 6s
(function() {
    ['transferSuccessAlert','transferErrorAlert'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) {
            setTimeout(function() {
                var bsAlert = bootstrap.Alert.getOrCreateInstance(el);
                if (bsAlert) bsAlert.close();
            }, 6000);
        }
    });
})();
</script>
